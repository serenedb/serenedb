{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "env": {
    "CLANGD_FLAGS": "-j=8 --background-index-priority=background --pch-storage=disk"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git submodule status:*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:duckdb.org)"
    ]
  }
}
