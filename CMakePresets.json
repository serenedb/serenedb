{
  "version": 8,
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build_${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "SDB_UPDATE_SUBMODULES": "Off",
        "SDB_DEBUG_INFO": "FULL",
        "SDB_SANITIZE": "",
        "SDB_FAULT_INJECTION": "On",
        "SDB_GTEST": "On"
      }
    },
    {
      "name": "lldb",
      "binaryDir": "build",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SDB_STATIC": "Off",
        "SDB_DEV": "On",
        "SDB_ALLOC": "SYS"
      }
    },
    {
      "name": "clangd",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SDB_STATIC": "Off",
        "SDB_DEV": "On",
        "SDB_ALLOC": "JE",
        "SDB_JEMALLOC_PROF": "On"
      }
    },
    {
      "name": "asan",
      "binaryDir": "build_asan",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SDB_STATIC": "Off",
        "SDB_SANITIZE": "Address",
        "SDB_DEV": "On",
        "SDB_ALLOC": "SYS"
      }
    },
    {
      "name": "tsan",
      "binaryDir": "build_tsan",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SDB_STATIC": "Off",
        "SDB_SANITIZE": "Thread",
        "SDB_DEV": "On",
        "SDB_ALLOC": "SYS"
      }
    },
    {
      "name": "msan",
      "binaryDir": "build_msan",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SDB_STATIC": "Off",
        "SDB_SANITIZE": "MemoryWithOrigins",
        "SDB_DEV": "On",
        "SDB_ALLOC": "SYS"
      }
    },
    {
      "name": "bench",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SDB_STATIC": "On",
        "SDB_DEV": "Off",
        "SDB_FAULT_INJECTION": "Off",
        "SDB_GTEST": "Off",
        "SDB_ALLOC": "JE"
      }
    },
    {
      "name": "perf",
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SDB_STATIC": "On",
        "SDB_DEV": "Off",
        "SDB_FAULT_INJECTION": "Off",
        "SDB_GTEST": "Off",
        "SDB_ALLOC": "JE"
      }
    }
  ]
}
