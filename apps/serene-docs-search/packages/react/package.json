{
    "name": "@serenedb/docs-search-react",
    "version": "0.9.1",
    "description": "SereneDocsSearch — DocSearch-style docs search modal + headless hook, powered by SereneDB",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/serenedb/serenedb.git",
        "directory": "apps/serene-docs-search/packages/react"
    },
    "homepage": "https://github.com/serenedb/serenedb/tree/main/apps/serene-docs-search#readme",
    "bugs": {
        "url": "https://github.com/serenedb/serenedb/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build": "tsup && cp src/styles.css dist/styles.css",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@serenedb/docs-search-core": "0.9.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "jsdom": "^29.1.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
