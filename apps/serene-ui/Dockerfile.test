FROM public.ecr.aws/docker/library/node:22
ARG TEST_USER=1000:1000
ENV HOME=/home/tester
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /test-app

COPY --chown=${TEST_USER} . .
RUN mkdir -p "$HOME" "$PLAYWRIGHT_BROWSERS_PATH" && \
    chown "$TEST_USER" /test-app "$HOME" "$PLAYWRIGHT_BROWSERS_PATH"

USER ${TEST_USER}
RUN npm install --include=dev --legacy-peer-deps --no-package-lock

RUN npm run build

USER root
RUN ./node_modules/.bin/playwright install-deps
USER ${TEST_USER}
RUN npx playwright install

EXPOSE 3000
CMD ["npm", "run", "dev:backend"]
