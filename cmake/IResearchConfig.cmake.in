@PACKAGE_INIT@

if(CMAKE_VERSION VERSION_LESS "3.30")
    message(FATAL_ERROR "IResearch requires CMake 3.30 or newer")
endif()

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(
        FATAL_ERROR
        "IResearch requires Clang @IRESEARCH_CLANG_MAJOR@ and its bundled libc++ headers"
    )
endif()
string(
    REGEX MATCH "^[0-9]+"
    _iresearch_clang_major
    "${CMAKE_CXX_COMPILER_VERSION}"
)
if(NOT _iresearch_clang_major STREQUAL "@IRESEARCH_CLANG_MAJOR@")
    message(
        FATAL_ERROR
        "IResearch was built with Clang @IRESEARCH_CLANG_MAJOR@; use the same compiler major version"
    )
endif()

if(NOT TARGET iresearch::iresearch)
    set_and_check(
        IResearch_LIBRARY
        "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@IRESEARCH_LIBRARY_NAME@"
    )
    add_library(iresearch::iresearch STATIC IMPORTED)
    set_target_properties(
        iresearch::iresearch
        PROPERTIES
            IMPORTED_LOCATION "${IResearch_LIBRARY}"
            IMPORTED_LINK_INTERFACE_LANGUAGES CXX
            INTERFACE_COMPILE_FEATURES cxx_std_26
    )
    include("${CMAKE_CURRENT_LIST_DIR}/IResearchUsage.cmake")
endif()
check_required_components(IResearch)
