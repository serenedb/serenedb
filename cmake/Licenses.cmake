function(_sdb_licenses_items out)
    set(found "")
    foreach(item IN LISTS ARGN)
        if(item MATCHES "^::@")
            continue()
        endif()
        string(REPLACE "::" "\n" item "${item}")
        string(REGEX MATCHALL "[^:$<>,;]+" tokens "${item}")
        foreach(token IN LISTS tokens)
            string(REPLACE "\n" "::" token "${token}")
            list(APPEND found "${token}")
        endforeach()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(sdb_licenses)
    set(queue serened)
    set(dirs "")
    while(queue)
        list(POP_FRONT queue current)
        string(MAKE_C_IDENTIFIER "${current}" id)
        if(DEFINED _sdb_licenses_seen_${id})
            continue()
        endif()
        set(_sdb_licenses_seen_${id} TRUE)
        get_target_property(aliased ${current} ALIASED_TARGET)
        if(aliased)
            list(APPEND queue ${aliased})
            continue()
        endif()
        get_target_property(imported ${current} IMPORTED)
        set(links INTERFACE_LINK_LIBRARIES)
        set(includes INTERFACE_INCLUDE_DIRECTORIES)
        set(locations "")
        if(imported)
            get_target_property(configs ${current} IMPORTED_CONFIGURATIONS)
            set(locations IMPORTED_LOCATION)
            if(configs)
                foreach(config IN LISTS configs)
                    string(TOUPPER "${config}" config)
                    list(APPEND locations IMPORTED_LOCATION_${config})
                endforeach()
            endif()
        else()
            list(APPEND links LINK_LIBRARIES)
            list(APPEND includes INCLUDE_DIRECTORIES)
            get_target_property(source_dir ${current} SOURCE_DIR)
            get_target_property(sources ${current} SOURCES)
            if(NOT sources)
                set(sources "")
            endif()
            foreach(source IN LISTS sources)
                if(source MATCHES "^\\$<TARGET_OBJECTS:(.+)>$")
                    list(APPEND queue "${CMAKE_MATCH_1}")
                elseif(NOT source MATCHES "\\$<")
                    cmake_path(
                        ABSOLUTE_PATH source
                        BASE_DIRECTORY "${source_dir}"
                        NORMALIZE
                        OUTPUT_VARIABLE path
                    )
                    cmake_path(GET path PARENT_PATH directory)
                    list(APPEND dirs "${directory}")
                endif()
            endforeach()
        endif()
        foreach(property IN LISTS links)
            get_target_property(values ${current} ${property})
            if(NOT values)
                continue()
            endif()
            _sdb_licenses_items(items ${values})
            foreach(item IN LISTS items)
                if(TARGET "${item}")
                    list(APPEND queue "${item}")
                elseif(IS_ABSOLUTE "${item}")
                    cmake_path(GET item PARENT_PATH directory)
                    list(APPEND dirs "${directory}")
                endif()
            endforeach()
        endforeach()
        foreach(property IN LISTS includes)
            get_target_property(values ${current} ${property})
            if(NOT values)
                continue()
            endif()
            _sdb_licenses_items(items ${values})
            foreach(item IN LISTS items)
                if(IS_ABSOLUTE "${item}")
                    cmake_path(NORMAL_PATH item)
                    list(APPEND dirs "${item}")
                endif()
            endforeach()
        endforeach()
        foreach(property IN LISTS locations)
            get_target_property(location ${current} ${property})
            if(location)
                cmake_path(GET location PARENT_PATH directory)
                list(APPEND dirs "${directory}")
            endif()
        endforeach()
    endwhile()
    list(REMOVE_DUPLICATES dirs)
    list(SORT dirs)
    list(JOIN dirs "\n" text)
    set(linked ${serenedb_BINARY_DIR}/licenses/linked.txt)
    file(WRITE ${linked} "${text}\n")
    execute_process(
        COMMAND
            ${Python3_EXECUTABLE} ${serenedb_SOURCE_DIR}/scripts/licenses.py
            build --linked ${linked} --source-dir ${serenedb_SOURCE_DIR}
            --binary-dir ${serenedb_BINARY_DIR} --output
            ${serenedb_BINARY_DIR}/server/utils/credits.cpp
        RESULT_VARIABLE failed
        OUTPUT_VARIABLE read
        ERROR_VARIABLE messages
    )
    if(failed)
        message(FATAL_ERROR "${messages}")
    endif()
    if(messages)
        message(STATUS "${messages}")
    endif()
    string(STRIP "${read}" read)
    string(REPLACE "\n" ";" read "${read}")
    set_property(
        DIRECTORY ${serenedb_SOURCE_DIR}
        APPEND
        PROPERTY CMAKE_CONFIGURE_DEPENDS ${read}
    )
endfunction()
