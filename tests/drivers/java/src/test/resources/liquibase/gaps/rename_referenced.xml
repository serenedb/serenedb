<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="liquibase/gaps/rename_referenced.xml">

    <changeSet id="1" author="drivers">
        <createTable tableName="clan">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true"/>
            </column>
            <column name="founded" type="DATE"/>
        </createTable>
        <createTable tableName="member">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true"/>
            </column>
            <column name="clan_id" type="INTEGER">
                <constraints foreignKeyName="member_clan_fk" references="clan(id)"/>
            </column>
        </createTable>
        <renameColumn tableName="clan" oldColumnName="founded" newColumnName="founded_on" columnDataType="DATE"/>
    </changeSet>
</databaseChangeLog>
