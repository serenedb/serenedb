query
SELECT tab, field, attnotnull, full_type, "primary" IS NOT NULL AS is_primary
FROM (SELECT c.relname AS tab, a.attname AS field, a.attnotnull::int,
	format_type(a.atttypid, a.atttypmod) AS full_type, i.indrelid AS primary
FROM pg_class c
JOIN pg_attribute a ON a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped
LEFT JOIN pg_index i ON i.indrelid = c.oid AND i.indisprimary AND a.attnum = ANY(i.indkey)
WHERE c.relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = current_schema())
AND c.relkind IN ('r', 'm', 'v', 'f', 'p')
AND c.relispartition IS NOT TRUE
ORDER BY c.relname, a.attnum) q
ORDER BY tab::text COLLATE "C", field::text COLLATE "C"
----
tab	field	attnotnull	full_type	is_primary
customers	active	0	boolean	f
customers	created	0	timestamp with time zone	f
customers	email	1	text	f
customers	id	1	integer	t
customers	mood	0	mood	f
customers	name	1	text	f
order_items	line	1	integer	t
order_items	order_id	1	bigint	t
order_items	price	0	numeric(12,4)	f
order_items	qty	1	integer	f
order_items	sku	1	text	f
order_totals	customer_id	0	integer	f
order_totals	n	0	bigint	f
order_totals	total	0	numeric(38,2)	f
orders	amount	1	numeric(10,2)	f
orders	customer_id	1	integer	f
orders	id	1	bigint	t
orders	note	0	text	f
orders	status	0	text	f
orders	ticket	0	bigint	f


