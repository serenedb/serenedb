FROM (SELECT * FROM pg_partitioned_table WHERE partrelid = (SELECT oid FROM pg_class WHERE relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = current_schema()) AND relname = 'orders' AND relkind IN ('r', 'm', 'v', 'f', 'p'))) q
