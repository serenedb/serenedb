query
SELECT "Name", "Engine", "Data_length" >= 0 AS data_ok, "Index_length" >= 0 AS index_ok, "Comment", "Oid", "Rows" >= -1 AS rows_ok, "Auto_increment", dependent
FROM (SELECT
	relname AS "Name",
	CASE relkind WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized view' ELSE 'table' END AS "Engine",
	pg_table_size(c.oid) AS "Data_length",
	pg_indexes_size(c.oid) AS "Index_length",
	obj_description(c.oid, 'pg_class') AS "Comment",
	'' AS "Oid",
	reltuples AS "Rows",
	seq.last_value AS "Auto_increment",
	relispartition::int AS dependent
FROM pg_class c
LEFT JOIN (
	SELECT d.refobjid, max(s.last_value) AS last_value
	FROM pg_depend d
	JOIN pg_class sc ON sc.oid = d.objid AND sc.relkind = 'S' AND sc.relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = current_schema())
	JOIN pg_sequences s ON s.schemaname = current_schema() AND s.sequencename = sc.relname
	WHERE d.classid = 'pg_class'::regclass AND d.refclassid = 'pg_class'::regclass AND d.deptype IN ('a', 'i')
	GROUP BY d.refobjid
) seq ON seq.refobjid = c.oid
WHERE relkind IN ('r', 'm', 'v', 'f', 'p')
AND relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = current_schema())
ORDER BY relname) q
ORDER BY "Name"::text COLLATE "C"
----
Name	Engine	data_ok	index_ok	Comment	Oid	rows_ok	Auto_increment	dependent
customers	table	t	t	Customer master	(empty)	t	2	0
order_items	table	t	t	NULL	(empty)	t	NULL	0
order_totals	view	t	t	Totals per customer	(empty)	t	NULL	0
orders	table	t	t	NULL	(empty)	t	3	0


