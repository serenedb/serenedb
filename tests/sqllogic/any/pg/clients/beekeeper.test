query
SELECT indexname, index_order, indisunique, indisprimary, indnullsnotdistinct, index_column, ascending
FROM (SELECT (SELECT relname FROM pg_class c WHERE c.oid = i.indexrelid) as indexname,
       k.i AS index_order,
       i.indexrelid as id,
       i.indisunique,
       i.indisprimary,
       i.indnullsnotdistinct,
  coalesce(a.attname, pg_get_indexdef(i.indexrelid, k.i, false)) AS index_column,
  i.indoption[k.i - 1] = 0 AS ascending
FROM pg_index i
  CROSS JOIN LATERAL (SELECT unnest(i.indkey), generate_subscripts(i.indkey, 1) + 1) AS k(attnum, i)
  LEFT JOIN pg_attribute AS a
ON i.indrelid = a.attrelid AND k.attnum = a.attnum
  JOIN pg_class t on t.oid = i.indrelid
  JOIN pg_namespace c on c.oid = t.relnamespace
WHERE
  c.nspname = 'shop' AND
  t.relname = 'customers') q
ORDER BY indexname::text COLLATE "C", index_order
----
indexname	index_order	indisunique	indisprimary	indnullsnotdistinct	index_column	ascending
