statement ok
DROP ROLE IF EXISTS cq_beekeeper_reader


statement ok
CREATE ROLE cq_beekeeper_reader


statement ok
CREATE SCHEMA shop


statement ok
CREATE TYPE shop.mood AS ENUM ('sad', 'ok', 'happy')


statement ok
CREATE SEQUENCE shop.ticket_seq START 100 INCREMENT 5


statement ok
CREATE TABLE shop.customers (
  id serial PRIMARY KEY,
  email varchar(100) NOT NULL UNIQUE,
  name text NOT NULL,
  active boolean DEFAULT true,
  mood shop.mood DEFAULT 'ok',
  created timestamptz DEFAULT now()
)


statement ok
CREATE TABLE shop.orders (
  id bigserial PRIMARY KEY,
  customer_id integer NOT NULL REFERENCES shop.customers (id),
  amount numeric(10,2) NOT NULL DEFAULT 0 CHECK (amount >= 0),
  status varchar(20) DEFAULT 'new',
  note text,
  ticket bigint DEFAULT nextval('shop.ticket_seq'),
  CONSTRAINT orders_status_check CHECK (status IN ('new', 'paid', 'shipped'))
)


statement ok
CREATE TABLE shop.order_items (
  order_id bigint REFERENCES shop.orders (id),
  line integer,
  sku varchar(30) NOT NULL,
  qty integer NOT NULL CHECK (qty > 0),
  price numeric(12,4),
  PRIMARY KEY (order_id, line)
)


statement ok
CREATE INDEX orders_customer_idx ON shop.orders (customer_id)


statement ok
CREATE UNIQUE INDEX customers_name_email_idx ON shop.customers (name, email)


statement ok
CREATE VIEW shop.order_totals AS SELECT o.customer_id, sum(o.amount) AS total, count(*) AS n FROM shop.orders o GROUP BY o.customer_id


statement ok
CREATE FUNCTION shop.add_one(i integer) RETURNS integer LANGUAGE sql AS $$ SELECT i + 1 $$


