  JOIN pg_namespace n ON t.relnamespace = n.oid
  JOIN generate_subscripts(c.conkey, 1) pos ON true
  JOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = c.conkey[pos]
  JOIN pg_class tf ON c.confrelid = tf.oid
  JOIN pg_namespace nf ON tf.relnamespace = nf.oid
  JOIN pg_attribute af ON af.attrelid = tf.oid AND af.attnum = c.confkey[pos]
WHERE
  c.contype = 'f'
  AND nf.nspname = 'shop'
  AND tf.relname = 'orders'
ORDER BY
  c.conname,
  pos
----
constraint_name	from_column	from_schema	from_table	to_column	to_table	to_schema	update_rule	delete_rule	ordinal_position
order_items_order_id_fkey	order_id	shop	order_items	id	orders	shop	NO ACTION	NO ACTION	1


