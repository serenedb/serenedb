query
SELECT tabrelname, conname, contype::text, condeferrable, condeferred, convalidated, conkey, confkey, nullif(confupdtype::text, ' ') AS confupdtype, nullif(confdeltype::text, ' ') AS confdeltype, nullif(confmatchtype::text, ' ') AS confmatchtype,
  (SELECT nspname FROM pg_catalog.pg_namespace WHERE oid = refnamespace) AS refnamespace, description, consrc_copy
FROM (SELECT c.oid,c.*,t.relname as tabrelname,rt.relnamespace as refnamespace,d.description, case when c.contype='c' then "substring"(pg_get_constraintdef(c.oid), 7) else null end consrc_copy
FROM pg_catalog.pg_constraint c
INNER JOIN pg_catalog.pg_class t ON t.oid=c.conrelid
LEFT OUTER JOIN pg_catalog.pg_class rt ON rt.oid=c.confrelid
LEFT OUTER JOIN pg_catalog.pg_description d ON d.objoid=c.oid AND d.objsubid=0 AND d.classoid='pg_constraint'::regclass
WHERE t.relnamespace=(SELECT oid FROM pg_catalog.pg_namespace WHERE nspname = 'shop')
ORDER BY c.oid) q
ORDER BY tabrelname::text COLLATE "C", conname::text COLLATE "C"
