query
SELECT proc_name, aggkind::text, count(*) AS overloads
FROM (SELECT p.oid AS proc_oid,p.proname AS proc_name,a.*
FROM pg_catalog.pg_aggregate a,pg_catalog.pg_proc p
WHERE p.oid=a.aggfnoid AND p.pronamespace=(SELECT oid FROM pg_catalog.pg_namespace WHERE nspname = 'pg_catalog')
ORDER BY p.proname) q
WHERE proc_name IN ('array_agg', 'avg', 'count', 'max', 'string_agg', 'sum')
GROUP BY proc_name, aggkind::text
ORDER BY proc_name::text COLLATE "C"
----
proc_name	aggkind	overloads
array_agg	n	2
avg	n	7
count	n	2
max	n	24
string_agg	n	2
sum	n	8


