query
SELECT relname, attname, attnum, format_type(atttypid, atttypmod) AS type, attlen, attndims, attnotnull, atthasdef, attidentity::text, attgenerated::text,
  attislocal, attinhcount, attstorage::text, attcollation <> 0 AS collatable, def_value, description, objid
FROM (SELECT c.relname,a.*,pg_catalog.pg_get_expr(ad.adbin, ad.adrelid, true) as def_value,dsc.description,dep.objid
FROM pg_catalog.pg_attribute a
INNER JOIN pg_catalog.pg_class c ON (a.attrelid=c.oid)
LEFT OUTER JOIN pg_catalog.pg_attrdef ad ON (a.attrelid=ad.adrelid AND a.attnum = ad.adnum)
LEFT OUTER JOIN pg_catalog.pg_description dsc ON (c.oid=dsc.objoid AND a.attnum = dsc.objsubid)
LEFT OUTER JOIN pg_depend dep on dep.refobjid = a.attrelid AND dep.deptype = 'i' and dep.refobjsubid = a.attnum and dep.classid = dep.refclassid
WHERE NOT a.attisdropped AND c.relkind not in ('i','I','c') AND c.relnamespace=(SELECT oid FROM pg_catalog.pg_namespace WHERE nspname = 'shop')
ORDER BY a.attnum) q
WHERE attnum > 0
ORDER BY relname::text COLLATE "C", attnum
----
relname	attname	attnum	type	attlen	attndims	attnotnull	atthasdef	attidentity	attgenerated	attislocal	attinhcount	attstorage	collatable	def_value	description	objid
customers	id	1	integer	4	0	t	t	(empty)	(empty)	t	0	p	f	nextval('shop.customers_id_seq'::regclass)	NULL	NULL
customers	email	2	character varying(100)	-1	0	t	f	(empty)	(empty)	t	0	x	t	NULL	Login email	NULL
customers	name	3	text	-1	0	t	f	(empty)	(empty)	t	0	x	t	NULL	NULL	NULL
customers	active	4	boolean	1	0	f	t	(empty)	(empty)	t	0	p	f	true	NULL	NULL
customers	mood	5	shop.mood	4	0	f	t	(empty)	(empty)	t	0	p	f	'ok'::shop.mood	NULL	NULL
customers	created	6	timestamp with time zone	8	0	f	t	(empty)	(empty)	t	0	p	f	now()	NULL	NULL
customers_id_seq	last_value	1	bigint	8	0	t	f	(empty)	(empty)	t	0	p	f	NULL	NULL	NULL
customers_id_seq	log_cnt	2	bigint	8	0	t	f	(empty)	(empty)	t	0	p	f	NULL	NULL	NULL
customers_id_seq	is_called	3	boolean	1	0	t	f	(empty)	(empty)	t	0	p	f	NULL	NULL	NULL
