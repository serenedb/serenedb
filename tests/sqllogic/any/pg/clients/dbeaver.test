query
SELECT relname, attname, attnum, format_type(atttypid, atttypmod) AS type, attlen, attndims, attnotnull, atthasdef, attidentity::text, attgenerated::text,
  attislocal, attinhcount, attstorage::text, attcollation <> 0 AS collatable, def_value, description, objid
FROM (SELECT c.relname,a.*,pg_catalog.pg_get_expr(ad.adbin, ad.adrelid, true) as def_value,dsc.description,dep.objid
FROM pg_catalog.pg_attribute a
INNER JOIN pg_catalog.pg_class c ON (a.attrelid=c.oid)
LEFT OUTER JOIN pg_catalog.pg_attrdef ad ON (a.attrelid=ad.adrelid AND a.attnum = ad.adnum)
LEFT OUTER JOIN pg_catalog.pg_description dsc ON (c.oid=dsc.objoid AND a.attnum = dsc.objsubid)
LEFT OUTER JOIN pg_depend dep on dep.refobjid = a.attrelid AND dep.deptype = 'i' and dep.refobjsubid = a.attnum and dep.classid = dep.refclassid
WHERE NOT a.attisdropped AND c.relkind not in ('i','I','c') AND c.relnamespace=(SELECT oid FROM pg_catalog.pg_namespace WHERE nspname = 'shop')
ORDER BY a.attnum) q
WHERE attnum > 0
ORDER BY relname::text COLLATE "C", attnum
