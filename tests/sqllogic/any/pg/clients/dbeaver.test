query
SELECT typname, typtype::text, typcategory::text, relkind::text, base_type_name, description
FROM (SELECT t.oid,t.*,c.relkind,format_type(nullif(t.typbasetype, 0), t.typtypmod) as base_type_name, d.description
FROM pg_catalog.pg_type t
LEFT OUTER JOIN pg_catalog.pg_type et ON et.oid=t.typelem
LEFT OUTER JOIN pg_catalog.pg_class c ON c.oid=t.typrelid
LEFT OUTER JOIN pg_catalog.pg_description d ON t.oid=d.objoid
WHERE t.typname IS NOT NULL
AND (c.relkind IS NULL OR c.relkind = 'c') AND (et.typcategory IS NULL OR et.typcategory <> 'C')) q
WHERE typnamespace = (SELECT oid FROM pg_catalog.pg_namespace WHERE nspname = 'shop')
  OR typname IN ('bool', 'int4', 'int8', 'numeric', 'text', 'varchar', 'timestamptz', 'uuid', 'json', '_int4', '_text')
ORDER BY typname::text COLLATE "C"
----
typname	typtype	typcategory	relkind	base_type_name	description
_int4	b	A	NULL	NULL	NULL
_mood	b	A	NULL	NULL	NULL
_text	b	A	NULL	NULL	NULL
bool	b	B	NULL	NULL	boolean, format 't'/'f'
int4	b	N	NULL	NULL	-2 billion to 2 billion integer, 4-byte storage
int8	b	N	NULL	NULL	~18 digit integer, 8-byte storage
json	b	U	NULL	NULL	JSON stored as text
mood	e	E	NULL	NULL	Mood enum
numeric	b	N	NULL	NULL	'numeric(precision, scale)' arbitrary precision number
text	b	S	NULL	NULL	variable-length string, no limit specified
timestamptz	b	D	NULL	NULL	date and time with time zone
uuid	b	U	NULL	NULL	UUID
varchar	b	S	NULL	NULL	'varchar(length)' non-blank-padded string, variable storage length


