query
SELECT type::text, "table", "column", foreign_key_schema, foreign_key_table, foreign_key_column, has_auto_increment
FROM (SELECT
              con.contype AS type,
              rel.relname AS table,
              att.attname AS column,
              frel.relnamespace::regnamespace::text AS foreign_key_schema,
              frel.relname AS foreign_key_table,
              fatt.attname AS foreign_key_column,
              CASE
                 WHEN con.contype = 'p' THEN pg_get_serial_sequence(att.attrelid::regclass::text, att.attname) != ''
                 ELSE NULL
              END AS has_auto_increment
            FROM
              pg_constraint con
            LEFT JOIN pg_class rel ON con.conrelid = rel.oid
            LEFT JOIN pg_class frel ON con.confrelid = frel.oid
            LEFT JOIN pg_attribute att ON att.attrelid = con.conrelid AND att.attnum = con.conkey[1]
            LEFT JOIN pg_attribute fatt ON fatt.attrelid = con.confrelid AND fatt.attnum = con.confkey[1]
            WHERE con.connamespace IN ('shop'::regnamespace)
              AND array_length(con.conkey, 1) <= 1
              AND (con.confkey IS NULL OR array_length(con.confkey, 1) = 1)) q
ORDER BY "table"::text COLLATE "C", type::text COLLATE "C", "column"::text COLLATE "C"
----
type	table	column	foreign_key_schema	foreign_key_table	foreign_key_column	has_auto_increment
n	customers	email	NULL	NULL	NULL	NULL
n	customers	id	NULL	NULL	NULL	NULL
n	customers	name	NULL	NULL	NULL	NULL
p	customers	id	NULL	NULL	NULL	t
u	customers	email	NULL	NULL	NULL	NULL
c	order_items	qty	NULL	NULL	NULL	NULL
f	order_items	order_id	shop	orders	id	NULL
n	order_items	line	NULL	NULL	NULL	NULL
n	order_items	order_id	NULL	NULL	NULL	NULL
n	order_items	qty	NULL	NULL	NULL	NULL
n	order_items	sku	NULL	NULL	NULL	NULL
c	orders	amount	NULL	NULL	NULL	NULL
c	orders	status	NULL	NULL	NULL	NULL
f	orders	customer_id	shop	customers	id	NULL
n	orders	amount	NULL	NULL	NULL	NULL
n	orders	customer_id	NULL	NULL	NULL	NULL
n	orders	id	NULL	NULL	NULL	NULL
p	orders	id	NULL	NULL	NULL	t


