SELECT
   att.attname AS column,
   rel.relname AS table
FROM
   pg_attribute att
   LEFT JOIN pg_class rel ON att.attrelid = rel.oid
WHERE
   rel.relnamespace IN ('shop'::regnamespace)
   AND rel.relname = 'orders'
   AND att.attname = 'amount'
   AND rel.relkind = 'r'
   AND att.attnum > 0
   AND NOT att.attisdropped
----
column	table
amount	orders


query
SELECT
              att.attname AS column
            FROM
              pg_constraint con
            LEFT JOIN pg_class rel ON con.conrelid = rel.oid
            LEFT JOIN pg_attribute att ON att.attrelid = con.conrelid AND att.attnum = con.conkey[1]
            WHERE con.connamespace IN ('shop'::regnamespace)
              AND con.contype = 'p'
              AND array_length(con.conkey, 1) <= 1
              AND rel.relname = 'customers'
----
column
id


query
SELECT *
FROM (SELECT
              con.conname AS constraint_name,
              rel.relname AS table,
              att.attname AS column,
              frel.relnamespace::regnamespace::text AS foreign_key_schema,
              frel.relname AS foreign_key_table,
              fatt.attname AS foreign_key_column,
              CASE con.confupdtype
                 WHEN 'r' THEN
                    'RESTRICT'
                 WHEN 'c' THEN
                    'CASCADE'
                 WHEN 'n' THEN
                    'SET NULL'
                 WHEN 'd' THEN
                    'SET DEFAULT'
                 WHEN 'a' THEN
                    'NO ACTION'
                 ELSE
                    NULL
              END AS on_update,
              CASE con.confdeltype
                 WHEN 'r' THEN
                    'RESTRICT'
                 WHEN 'c' THEN
                    'CASCADE'
                 WHEN 'n' THEN
                    'SET NULL'
                 WHEN 'd' THEN
                    'SET DEFAULT'
                 WHEN 'a' THEN
                    'NO ACTION'
                 ELSE
                    NULL
              END AS on_delete
            FROM
              pg_constraint con
            LEFT JOIN pg_class rel ON con.conrelid = rel.oid
            LEFT JOIN pg_class frel ON con.confrelid = frel.oid
            LEFT JOIN pg_attribute att ON att.attrelid = con.conrelid AND att.attnum = con.conkey[1]
            LEFT JOIN pg_attribute fatt ON fatt.attrelid = con.confrelid AND fatt.attnum = con.confkey[1]
            WHERE con.connamespace IN ('shop'::regnamespace)
              AND array_length(con.conkey, 1) <= 1
              AND (con.confkey IS NULL OR array_length(con.confkey, 1) = 1)
              AND con.contype = 'f') q
ORDER BY constraint_name::text COLLATE "C"
----
constraint_name	table	column	foreign_key_schema	foreign_key_table	foreign_key_column	on_update	on_delete
order_items_order_id_fkey	order_items	order_id	shop	orders	id	NO ACTION	NO ACTION
orders_customer_id_fkey	orders	customer_id	shop	customers	id	NO ACTION	NO ACTION


