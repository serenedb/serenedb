sku	varchar	2	shop	order_items	f	NULL	t	NULL	f	f	f
qty	int4	3	shop	order_items	f	NULL	t	NULL	f	f	f
price	numeric	4	shop	order_items	f	NULL	f	NULL	f	f	t
customer_id	int4	0	shop	order_totals	f	NULL	f	NULL	f	f	t
total	numeric	1	shop	order_totals	f	NULL	f	NULL	f	f	t
n	int8	2	shop	order_totals	f	NULL	f	NULL	f	f	t
id	int8	0	shop	orders	t	NULL	f	nextval('shop.orders_id_seq'::regclass)	t	f	f
customer_id	int4	1	shop	orders	f	NULL	t	NULL	f	f	f
amount	numeric	2	shop	orders	f	NULL	f	0	f	f	f
status	varchar	3	shop	orders	f	NULL	f	'new'::character varying	f	f	t
note	text	4	shop	orders	f	NULL	f	NULL	f	f	t
ticket	int8	5	shop	orders	f	NULL	f	nextval('shop.ticket_seq'::regclass)	t	f	t


