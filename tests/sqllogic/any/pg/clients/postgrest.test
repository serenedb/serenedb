query
WITH
role_setting AS (
  SELECT setdatabase as database,
         unnest(setconfig) as setting
  FROM pg_catalog.pg_db_role_setting
  WHERE setrole = quote_ident(CURRENT_USER)::regrole::oid
    AND setdatabase IN (0, (SELECT oid FROM pg_catalog.pg_database WHERE datname = CURRENT_CATALOG))
),
kv_settings AS (
  SELECT database,
         substr(setting, 1, strpos(setting, '=') - 1) as k,
         substr(setting, strpos(setting, '=') + 1) as v
  FROM role_setting
)
SELECT DISTINCT ON (key)
       replace(k, 'pgrst.', '') AS key,
       v AS value
FROM kv_settings
WHERE k = ANY(ARRAY['pgrst.db_aggregates_enabled', 'pgrst.client_error_verbosity', 'pgrst.db_anon_role', 'pgrst.db_pre_config', 'pgrst.db_extra_search_path', 'pgrst.db_max_rows', 'pgrst.db_plan_enabled', 'pgrst.db_pre_request', 'pgrst.db_prepared_statements', 'pgrst.db_root_spec', 'pgrst.db_schemas', 'pgrst.db_tx_end', 'pgrst.db_hoisted_tx_settings', 'pgrst.jwt_aud', 'pgrst.jwt_role_claim_key', 'pgrst.jwt_secret', 'pgrst.jwt_secret_is_base64', 'pgrst.jwt_cache_max_entries', 'pgrst.openapi_mode', 'pgrst.openapi_security_active', 'pgrst.openapi_server_proxy_uri', 'pgrst.server_cors_allowed_origins', 'pgrst.server_trace_header', 'pgrst.server_timing_enabled', 'pgrst.url_use_legacy_target_names']) AND v IS NOT NULL
ORDER BY key, database DESC NULLS LAST
----
key	value
