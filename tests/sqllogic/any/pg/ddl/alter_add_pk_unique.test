# ALTER TABLE ADD PRIMARY KEY / ADD UNIQUE on a table. Both are backed by an
# index built over the existing rows, so both validate what is already there and
# reject duplicates afterwards; a primary key additionally implies NOT NULL.

statement ok
CREATE TABLE apk (a INTEGER, b INTEGER);


statement count 2
INSERT INTO apk VALUES (1, 10), (2, 20);


statement ok
ALTER TABLE apk ADD PRIMARY KEY (a);


# duplicate primary key is rejected
statement error
INSERT INTO apk VALUES (1, 99);


# a primary key implies NOT NULL
statement error
INSERT INTO apk VALUES (NULL, 99);


# a table may have only one primary key
statement error
ALTER TABLE apk ADD PRIMARY KEY (b);


# ADD [CONSTRAINT] UNIQUE is accepted and enforced from that point on.
statement ok
ALTER TABLE apk ADD CONSTRAINT u_b UNIQUE (b);


statement error
INSERT INTO apk VALUES (3, 10);


# a non-PK UNIQUE still admits NULL
statement count 1
INSERT INTO apk VALUES (3, NULL);


query
SELECT a, b FROM apk ORDER BY a;
----
a	b
1	10
2	20
3	NULL


statement ok
DROP TABLE apk;


# Existing-row validation: ADD PRIMARY KEY over duplicate data is rejected.
statement ok
CREATE TABLE adup (a INTEGER);


statement count 2
INSERT INTO adup VALUES (1), (1);


statement error
ALTER TABLE adup ADD PRIMARY KEY (a);


# and so is ADD UNIQUE over the same data
statement error
ALTER TABLE adup ADD UNIQUE (a);


statement ok
DROP TABLE adup;
