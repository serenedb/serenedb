statement ok
DROP SCHEMA atssd_from;


query
SELECT n.nspname, c.relname
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname IN ('atssd_from', 'atssd_to')
ORDER BY c.relname;
----
nspname	relname
atssd_to	ledger
atssd_to	ledger_id_seq


statement ok
DROP SCHEMA atssd_to CASCADE;


query
SELECT count(*) AS relations
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname IN ('atssd_from', 'atssd_to');
----
relations
0


