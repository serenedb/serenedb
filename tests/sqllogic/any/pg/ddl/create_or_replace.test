# CREATE OR REPLACE VIEW / FUNCTION / PROCEDURE with PostgreSQL semantics.
#
# A replace changes the definition of the existing object in place: the oid,
# owner, grants and comment stay, dependents keep working and read the new
# body. A view may only append columns at the end; renaming, dropping,
# reordering or retyping an existing column is refused and leaves the view
# as it was. A replace is transactional: ROLLBACK restores the old definition
# and other sessions see the new one only after COMMIT.
#
# PostgreSQL locks a view that is being replaced until the replacing
# transaction ends, so while a replace is open the other session only reads
# pg_class / pg_proc or calls functions; reading the view itself from the
# other session is serenedb-only (MVCC catalog, no lock).
#
# Every object is prefixed corpg_.

statement ok
CREATE TABLE corpg_t (a INT, b TEXT, c INT);


statement count 3
INSERT INTO corpg_t VALUES (1, 'x', 10), (2, 'y', 20), (3, 'z', 30);


# ── OR REPLACE VIEW: create, replace the body, append columns ──

statement ok
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b FROM corpg_t WHERE a = 1;


query
SELECT a, b FROM corpg_v;
----
a	b
1	x


statement ok
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b FROM corpg_t WHERE a >= 2;


query
SELECT a, b FROM corpg_v ORDER BY a;
----
a	b
2	y
3	z


# The replace kept one relation under the name.
query
SELECT relkind, count(*) AS n FROM pg_class WHERE relname = 'corpg_v' GROUP BY relkind;
----
relkind	n
v	1


statement ok
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b, c FROM corpg_t WHERE a >= 2;


query
SELECT * FROM corpg_v ORDER BY a;
----
a	b	c
2	y	20
3	z	30


statement ok
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b, c, a + c AS s, 'k' AS k FROM corpg_t WHERE a >= 2;


query
SELECT * FROM corpg_v WHERE false;
----
a	b	c	s	k


query
SELECT pg_typeof(a) AS ta, pg_typeof(b) AS tb, pg_typeof(s) AS ts FROM corpg_v LIMIT 1;
----
ta	tb	ts
integer	text	integer


# ── Refused view replaces: the column list may only grow at the end ──

statement error
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b, c, a + c AS s FROM corpg_t;
----
db error: ERROR: cannot drop columns from view


statement error
CREATE OR REPLACE VIEW corpg_v AS SELECT a FROM corpg_t;
----
db error: ERROR: cannot drop columns from view


skipif postgres
statement error
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b AS bb, c, a + c AS s, 'k' AS k FROM corpg_t;
----
db error: ERROR: cannot change name of view column "b" to "bb"


skipif serenedb
statement error
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b AS bb, c, a + c AS s, 'k' AS k FROM corpg_t;
----
db error: ERROR: cannot change name of view column "b" to "bb"
HINT: Use ALTER VIEW ... RENAME COLUMN ... to change name of view column instead.


