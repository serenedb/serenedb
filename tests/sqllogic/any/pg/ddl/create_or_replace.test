# A temporary view shadows a persistent one; a replace without TEMP targets
# the persistent view.
statement ok
CREATE VIEW corpg_shadow AS SELECT 'persistent' AS src;


statement ok
CREATE OR REPLACE TEMP VIEW corpg_shadow AS SELECT 'temp' AS src;


