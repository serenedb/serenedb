# ── The replaced view keeps its oid, comment, grants and owner ──

statement ok
CREATE TABLE corpg_ids AS SELECT 'view' AS kind, oid FROM pg_class WHERE relname = 'corpg_v';


statement ok
COMMENT ON VIEW corpg_v IS 'corpg view comment';


statement ok
COMMENT ON COLUMN corpg_v.b IS 'corpg column comment';


statement ok
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b, c, a + c AS s, 'k' AS k FROM corpg_t;


query
SELECT c.oid = i.oid AS same_oid, obj_description(c.oid, 'pg_class') AS cmt, col_description(c.oid, 2) AS col_cmt
FROM pg_class c JOIN corpg_ids i ON i.kind = 'view'
WHERE c.relname = 'corpg_v';
----
same_oid	cmt	col_cmt
t	corpg view comment	corpg column comment


