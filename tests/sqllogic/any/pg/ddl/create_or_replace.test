query
SELECT c.relname, pg_get_userbyid(c.relowner) AS owner
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = 'corpg_s' AND c.relname IN ('corpg_sv', 'corpg_mine')
ORDER BY c.relname;
----
relname	owner
corpg_mine	corpg_reader
corpg_sv	postgres


query
SELECT (SELECT src FROM corpg_s.corpg_sv) AS sv, (SELECT src FROM corpg_s.corpg_mine) AS mine;
----
sv	mine
via_path	by_superuser


