query
SELECT has_table_privilege('corpg_reader', 'corpg_v', 'SELECT') AS can_read;
----
can_read
t


# The reader holds no privilege on corpg_t: the definer view reads it as the
# view owner.
connection reader user=corpg_reader password=corpg_reader_pw
query
SELECT a, k FROM corpg_v ORDER BY a;
----
a	k
1	k2
2	k2
3	k2


# View options come from the replacing statement: security_invoker switches
# the base-table check to the reader, a replace without it switches it back.
statement ok
CREATE OR REPLACE VIEW corpg_v WITH (security_invoker = true) AS SELECT a, b, c, a + c AS s, 'k3' AS k FROM corpg_t;


