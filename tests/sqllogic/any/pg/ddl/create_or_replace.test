# A new body that does not bind or does not parse is refused.
statement error (?i)corpg_missing.* does not exist
CREATE OR REPLACE VIEW corpg_v AS SELECT a, b, c, a + c AS s, 'k' AS k, x FROM corpg_missing;


statement error syntax error at or near "SELEC"
CREATE OR REPLACE VIEW corpg_v AS SELEC a, b, c, a + c AS s, 'k' AS k FROM corpg_t;


statement error (?i)schema.*corpg_nosuch.* does not exist
