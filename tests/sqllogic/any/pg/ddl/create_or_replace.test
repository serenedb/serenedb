# OR REPLACE and IF NOT EXISTS do not combine.
skipif postgres
statement error
CREATE OR REPLACE VIEW IF NOT EXISTS corpg_v AS SELECT a, b, c, a + c AS s, 'k' AS k FROM corpg_t;
----
db error: ERROR: Cannot specify both OR REPLACE and IF NOT EXISTS within single create statement


skipif serenedb
statement error
CREATE OR REPLACE VIEW IF NOT EXISTS corpg_v AS SELECT a, b, c, a + c AS s, 'k' AS k FROM corpg_t;
----
db error: ERROR: syntax error at or near "NOT"


# A refused replace leaves the view as it was.
query
SELECT * FROM corpg_v ORDER BY a;
----
a	b	c	s	k
2	y	20	22	k
3	z	30	33	k


