# ── Quoted mixed-case names are separate objects ──

statement ok
CREATE OR REPLACE VIEW "CorPg_Mixed" AS SELECT 'quoted' AS src;


statement ok
CREATE OR REPLACE VIEW corpg_mixed AS SELECT 'plain' AS src;


query
SELECT (SELECT src FROM "CorPg_Mixed") AS q, (SELECT src FROM corpg_mixed) AS p;
----
q	p
quoted	plain


statement ok
CREATE OR REPLACE VIEW "CorPg_Mixed" AS SELECT 'quoted2' AS src;


# An unquoted name folds to lower case and replaces corpg_mixed.
statement ok
CREATE OR REPLACE VIEW CORPG_MIXED AS SELECT 'plain2' AS src;


query
SELECT (SELECT src FROM "CorPg_Mixed") AS q, (SELECT src FROM corpg_mixed) AS p;
----
q	p
quoted2	plain2


query
SELECT relname FROM pg_class WHERE lower(relname) = 'corpg_mixed' ORDER BY relname = 'corpg_mixed';
----
relname
CorPg_Mixed
corpg_mixed


statement ok
CREATE OR REPLACE VIEW "CorPg_Mixed" AS SELECT 'quoted3' AS src, 1 AS "Extra";


query
SELECT src, "Extra" FROM "CorPg_Mixed";
----
src	Extra
quoted3	1


# ── A renamed view is replaced under its new name ──

statement ok
CREATE VIEW corpg_rn AS SELECT 1 AS n;


statement ok
INSERT INTO corpg_ids SELECT 'renamed', oid FROM pg_class WHERE relname = 'corpg_rn';


statement ok
ALTER VIEW corpg_rn RENAME TO corpg_rn2;


statement ok
CREATE OR REPLACE VIEW corpg_rn2 AS SELECT 2 AS n;


# The old name is free again, so OR REPLACE creates a new view there.
statement ok
CREATE OR REPLACE VIEW corpg_rn AS SELECT 'fresh' AS s;


query
SELECT c.relname, c.oid = i.oid AS same_oid
FROM pg_class c JOIN corpg_ids i ON i.kind = 'renamed'
WHERE c.relname IN ('corpg_rn', 'corpg_rn2')
ORDER BY c.relname;
----
relname	same_oid
corpg_rn	f
corpg_rn2	t


query
SELECT (SELECT n FROM corpg_rn2) AS n, (SELECT s FROM corpg_rn) AS s;
----
n	s
2	fresh


# ── A replace that reads the view itself ──

# The name in the new body binds to the existing view, so the stored
# definition refers to itself and reading it fails.
statement ok
CREATE VIEW corpg_self AS SELECT 1 AS n;


statement ok
CREATE OR REPLACE VIEW corpg_self AS SELECT n + 1 AS n FROM corpg_self;


statement error infinite recursion detected
SELECT * FROM corpg_self;


statement ok
CREATE OR REPLACE VIEW corpg_self AS SELECT 3 AS n;


query
SELECT n FROM corpg_self;
----
n
3


# ── Schema-qualified names and the search path ──

statement ok
CREATE SCHEMA corpg_s;


statement ok
CREATE OR REPLACE VIEW corpg_s.corpg_sv AS SELECT 'schema' AS src;


statement ok
CREATE OR REPLACE VIEW corpg_sv AS SELECT 'public' AS src;


statement ok
CREATE OR REPLACE VIEW corpg_s.corpg_sv AS SELECT 'schema2' AS src;


query
SELECT (SELECT src FROM public.corpg_sv) AS p, (SELECT src FROM corpg_s.corpg_sv) AS s;
----
p	s
public	schema2


statement ok
CREATE VIEW corpg_pubonly AS SELECT 'pub' AS src;


statement ok
SET search_path = corpg_s, public;


# An unqualified replace targets the first schema of the path: it replaces
# corpg_s.corpg_sv and creates corpg_s.corpg_pubonly next to the public one.
statement ok
CREATE OR REPLACE VIEW corpg_sv AS SELECT 'via_path' AS src;


statement ok
CREATE OR REPLACE VIEW corpg_pubonly AS SELECT 'new' AS src;


statement ok
RESET search_path;


query
SELECT (SELECT src FROM public.corpg_sv) AS p, (SELECT src FROM corpg_s.corpg_sv) AS s;
----
p	s
public	via_path


query
SELECT n.nspname, (SELECT src FROM public.corpg_pubonly) AS p, (SELECT src FROM corpg_s.corpg_pubonly) AS s
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname = 'corpg_pubonly'
ORDER BY n.nspname;
----
nspname	p	s
corpg_s	pub	new
public	pub	new


statement ok
CREATE OR REPLACE VIEW corpg_s."CorPg_SQ" AS SELECT 1 AS n;


statement ok
CREATE OR REPLACE VIEW "corpg_s"."CorPg_SQ" AS SELECT 2 AS n;


query
SELECT n FROM corpg_s."CorPg_SQ";
----
n
2


