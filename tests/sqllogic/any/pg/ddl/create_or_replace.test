# A replace that reads a table created in the same transaction: ROLLBACK
# removes both, COMMIT keeps the view depending on the new table.
statement ok
BEGIN;


statement ok
CREATE TABLE corpg_e3 (a INT);


statement ok
INSERT INTO corpg_e3 VALUES (3);


statement ok
CREATE OR REPLACE VIEW corpg_ev AS SELECT a FROM corpg_e3;


query
SELECT a FROM corpg_ev;
----
a
3


statement ok
ROLLBACK;


query
SELECT a, (SELECT count(*) FROM pg_class WHERE relname = 'corpg_e3') AS e3 FROM corpg_ev;
----
a	e3
42	0


statement ok
BEGIN;


statement ok
CREATE TABLE corpg_e3 (a INT);


statement ok
INSERT INTO corpg_e3 VALUES (3);


statement ok
CREATE OR REPLACE VIEW corpg_ev AS SELECT a FROM corpg_e3;


