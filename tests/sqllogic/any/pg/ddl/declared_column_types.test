statement ok
INSERT INTO dct (jb, n, d) VALUES ('{"a": [1, 2]}', 12345678901234.123456789, 98765432109876543210.0123456789);


query
SELECT jb -> 'a' AS a, to_jsonb(1) AS one, to_jsonb('x'::text) AS x, to_jsonb('{"b": 2}'::json) ->> 'b' AS j FROM dct;
----
a	one	x	j
[1, 2]	1	"x"	2


skipif serenedb
query
SELECT n::text AS n, d::text AS d FROM dct;
----
n	d
12345678901234.123456789	98765432109876543210.0123456789


onlyif serenedb
query
SELECT n::text AS n, d::text AS d FROM dct;
----
n	d
12345678901234.1234567890	98765432109876543210.0123456789


