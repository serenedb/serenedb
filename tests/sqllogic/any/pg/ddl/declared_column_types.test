FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
WHERE c.relname IN ('beast_indexed_title', 'beast_indexed_code')
ORDER BY 1, 2;
----
relname	attname	type	atttypmod
beast_indexed_code	code	character(6)	10
beast_indexed_title	title	character varying(67)	71


