CREATE TABLE beast (channel varchar, title varchar(67), tagline character varying(76), bio text, code char(6), grade character, tier nchar(7), stats json, meta jsonb, views numeric, price numeric(7,6), prize decimal, tags varchar(67)[], metas jsonb[]);


query
SELECT column_name, data_type, udt_name, character_maximum_length, numeric_precision, numeric_scale
FROM information_schema.columns
WHERE table_name = 'beast'
ORDER BY ordinal_position;
----
column_name	data_type	udt_name	character_maximum_length	numeric_precision	numeric_scale
channel	character varying	varchar	NULL	NULL	NULL
title	character varying	varchar	67	NULL	NULL
tagline	character varying	varchar	76	NULL	NULL
bio	text	text	NULL	NULL	NULL
code	character	bpchar	6	NULL	NULL
grade	character	bpchar	1	NULL	NULL
tier	character	bpchar	7	NULL	NULL
stats	json	json	NULL	NULL	NULL
meta	jsonb	jsonb	NULL	NULL	NULL
views	numeric	numeric	NULL	NULL	NULL
price	numeric	numeric	NULL	7	6
prize	numeric	numeric	NULL	NULL	NULL
tags	ARRAY	_varchar	NULL	NULL	NULL
metas	ARRAY	_jsonb	NULL	NULL	NULL


query
SELECT attname, format_type(atttypid, atttypmod) AS type, atttypmod
FROM pg_attribute
WHERE attrelid = 'beast'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	atttypmod
channel	character varying	-1
title	character varying(67)	71
tagline	character varying(76)	80
bio	text	-1
code	character(6)	10
grade	character(1)	5
tier	character(7)	11
stats	json	-1
meta	jsonb	-1
views	numeric	-1
price	numeric(7,6)	458762
prize	numeric	-1
tags	character varying(67)[]	71
metas	jsonb[]	-1


