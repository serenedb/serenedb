query
SELECT attname, format_type(atttypid, atttypmod) AS type
FROM pg_attribute
WHERE attrelid = 'beast'::regclass AND attname IN ('six', 'bio', 'meta', 'channel')
ORDER BY attnum;
----
attname	type
channel	text
bio	character varying(67)
meta	json
six	character varying(6)


