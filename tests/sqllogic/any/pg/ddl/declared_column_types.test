INSERT INTO beast (meta, views, prize) VALUES ('{"mrbeast": [6, 7]}', 67676767676767.676767676, 67676767676767676767.6767676767);


query
SELECT meta -> 'mrbeast' AS six_seven, to_jsonb(67) AS sixty_seven, to_jsonb('mrbeast'::text) AS beast, to_jsonb('{"six": 7}'::json) ->> 'six' AS seven FROM beast;
----
six_seven	sixty_seven	beast	seven
[6, 7]	67	"mrbeast"	7


