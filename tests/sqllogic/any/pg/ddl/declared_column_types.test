statement ok
CREATE TABLE dct (v varchar, v10 varchar(10), cv character varying(20), t text, c5 char(5), c character, nc nchar(2), j json, jb jsonb, n numeric, n102 numeric(10,2), d decimal, va varchar(7)[], jba jsonb[]);


query
SELECT column_name, data_type, udt_name, character_maximum_length, numeric_precision, numeric_scale
FROM information_schema.columns
WHERE table_name = 'dct'
ORDER BY ordinal_position;
----
column_name	data_type	udt_name	character_maximum_length	numeric_precision	numeric_scale
v	character varying	varchar	NULL	NULL	NULL
v10	character varying	varchar	10	NULL	NULL
cv	character varying	varchar	20	NULL	NULL
t	text	text	NULL	NULL	NULL
c5	character	bpchar	5	NULL	NULL
c	character	bpchar	1	NULL	NULL
nc	character	bpchar	2	NULL	NULL
j	json	json	NULL	NULL	NULL
jb	jsonb	jsonb	NULL	NULL	NULL
n	numeric	numeric	NULL	NULL	NULL
n102	numeric	numeric	NULL	10	2
d	numeric	numeric	NULL	NULL	NULL
va	ARRAY	_varchar	NULL	NULL	NULL
jba	ARRAY	_jsonb	NULL	NULL	NULL


query
SELECT attname, format_type(atttypid, atttypmod) AS type, atttypmod
FROM pg_attribute
WHERE attrelid = 'dct'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	atttypmod
v	character varying	-1
v10	character varying(10)	14
cv	character varying(20)	24
t	text	-1
c5	character(5)	9
c	character(1)	5
nc	character(2)	6
j	json	-1
jb	jsonb	-1
n	numeric	-1
n102	numeric(10,2)	655366
d	numeric	-1
va	character varying(7)[]	11
jba	jsonb[]	-1


statement ok
ALTER TABLE dct ADD COLUMN added varchar(3);


statement ok
ALTER TABLE dct ALTER COLUMN t TYPE varchar(30);


statement ok
ALTER TABLE dct ALTER COLUMN jb TYPE json;


statement ok
ALTER TABLE dct ALTER COLUMN v TYPE text;


query
SELECT attname, format_type(atttypid, atttypmod) AS type
FROM pg_attribute
WHERE attrelid = 'dct'::regclass AND attname IN ('added', 't', 'jb', 'v')
ORDER BY attnum;
----
attname	type
v	text
t	character varying(30)
jb	json
added	character varying(3)


statement ok
CREATE TABLE dct_as AS SELECT v10, n FROM dct;


