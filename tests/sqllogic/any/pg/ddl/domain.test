# A domain over another domain.

statement ok
CREATE DOMAIN d_base AS int4;

statement ok
CREATE DOMAIN d_over AS d_base;

query
SELECT format_type(typbasetype, typtypmod) FROM pg_type WHERE typname = 'd_over';
----
format_type
d_base

# A domain over a type that does not exist is rejected.

statement error
CREATE DOMAIN d_missing AS no_such_type;

# A domain name that is already taken is rejected.

statement ok
CREATE DOMAIN d_dup AS int4;

statement error
CREATE DOMAIN d_dup AS int4;


# COLLATE is stored and drives comparisons; a base type without collations rejects it.

statement ok
CREATE DOMAIN d_coll AS text COLLATE "C";

query
SELECT typcollation::regcollation FROM pg_type WHERE typname = 'd_coll';
----
typcollation
"C"

query
SELECT 'a'::d_coll < 'B'::d_coll;
----
?column?
f

statement error
CREATE DOMAIN d_coll_int as INT4 COLLATE "C";

# DEFAULT fills an omitted column, must cast to the base type, and yields to a column default.

statement ok
CREATE DOMAIN d_def as INT4 DEFAULT 42;

query
SELECT typdefault FROM pg_type WHERE typname = 'd_def';
----
typdefault
42

statement ok
CREATE TABLE t_def_check (id int, v d_def);

statement ok
INSERT INTO t_def_check (id) VALUES (1);

query
SELECT v from t_def_check;
----
v
42

statement error
CREATE DOMAIN d_def_str AS INT4 DEFAULT 'abc';

statement ok
CREATE TABLE t_def_col (id INT, v d_def DEFAULT 7);

statement ok
INSERT INTO t_def_col (id) VALUES (1);

query
select v from t_def_col;
----
v
7

# NOT NULL rejects NULL on insert and on cast; NULL together with NOT NULL is rejected.

statement ok
CREATE DOMAIN d_nn as INT4 NOT NULL;


statement ok
CREATE TABLE t_nn_check (v d_nn);

statement error db error: ERROR: domain d_nn does not allow null values
INSERT INTO t_nn_check VALUES (NULL);

statement error
SELECT NULL::d_nn;

statement ok
CREATE DOMAIN d_null AS int4 NULL;

query
SELECT typnotnull FROM pg_type WHERE typname = 'd_null';
----
typnotnull
f

statement error
CREATE DOMAIN d_null AS int4 NULL NOT NULL;


# CHECK over VALUE rejects a row whose value violates it.

statement ok
CREATE DOMAIN email AS text
    CHECK (VALUE ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$');

statement ok
CREATE DOMAIN positive_money AS numeric(12,2)
    CHECK (VALUE > 0);

statement ok
CREATE DOMAIN postal_code AS char(6)
    CHECK (VALUE ~ '^\d{6}$');


statement ok
CREATE TABLE receipts (login email, amount positive_money, address postal_code);

statement error db error: ERROR: value for domain email violates check constraint "email_check"
INSERT INTO receipts VALUES (42, 60, 123456);

statement error db error: ERROR: value for domain positive_money violates check constraint "positive_money_check"
INSERT INTO receipts VALUES ('test@gmail.com', -60, 123456);

statement error db error: ERROR: value for domain postal_code violates check constraint "postal_code_check"
INSERT INTO receipts VALUES ('test@gmail.com', 60, 0);

statement ok
INSERT INTO receipts VALUES ('test@gmail.com', 60, 123456)


# Named and unnamed constraints, and every clause in one domain.

statement ok
CREATE DOMAIN d_cn AS INT4
    CONSTRAINT positive CHECK (VALUE > 0)
    CONSTRAINT must_have NOT NULL
    CHECK (VALUE < 100); 


query
SELECT conname FROM pg_constraint WHERE contypid = 'd_cn'::regtype ORDER BY conname;
----
conname
d_cn_check
must_have
positive

statement ok
CREATE DOMAIN d_full AS text COLLATE "C" DEFAULT 'x'
    CONSTRAINT nonempty
    NOT NULL
    CHECK(length(VALUE) > 0);

query
SELECT typcollation::regcollation, typdefault, typnotnull FROM pg_type WHERE typname = 'd_full';
----
typcollation	typdefault	typnotnull
"C"	'x'::text	t


# ALTER DOMAIN changes a domain that columns already use.

# SET DEFAULT applies to a table created before it; DROP DEFAULT removes it; a non-domain is rejected.

statement ok
CREATE DOMAIN d_sd AS INT4;

statement ok
CREATE TABLE t_sd(id int, v d_sd NOT NULL);

statement ok
ALTER DOMAIN d_sd SET DEFAULT 42;

statement ok
INSERT INTO t_sd (id) VALUES (1);

query
SELECT v FROM t_sd;
----
v
42

statement ok
ALTER DOMAIN d_sd DROP DEFAULT;

statement error
INSERT INTO t_sd (id) VALUES (1);

statement ok
CREATE TYPE e_not_dom AS ENUM ('a');

statement error
ALTER DOMAIN e_not_dom SET DEFAULT 'a';

# SET NOT NULL applies to a column created before it; DROP NOT NULL lifts it.

statement ok
CREATE DOMAIN d_snn AS INT4;

statement ok
CREATE TABLE t_snn (id int, v d_snn);

statement ok
ALTER DOMAIN d_snn SET NOT NULL;

statement error db error: ERROR: domain d_snn does not allow null values
INSERT INTO t_snn (id) VALUES (0);

statement ok
ALTER DOMAIN d_snn DROP NOT NULL;

statement ok
INSERT INTO t_snn (id) VALUES (0);

# ADD CONSTRAINT checks existing rows unless NOT VALID; a taken constraint name is rejected.

statement ok
CREATE DOMAIN email_add AS text CHECK (VALUE LIKE '%@%');

statement ok
CREATE TABLE t_email (e email_add);

statement ok
INSERT INTO t_email VALUES ('a@b.com');

statement error
ALTER DOMAIN email_add ADD CONSTRAINT c CHECK (length(VALUE) > 10);

statement ok
ALTER DOMAIN email_add ADD CONSTRAINT c CHECK (length(VALUE) > 10) NOT VALID;

statement error db error: ERROR: value for domain email_add violates check constraint "c"
INSERT INTO t_email VALUES ('b@a.com');

statement ok
CREATE DOMAIN d_add AS text
    CONSTRAINT nonempty
    NOT NULL
    CHECK(length(VALUE) > 0);

statement error
ALTER DOMAIN d_add ADD CONSTRAINT nonempty CHECK (VALUE LIKE '%@%');

# DROP CONSTRAINT, with IF EXISTS and CASCADE, keeps the columns and their data.

statement ok
CREATE DOMAIN d_drop AS text
    CONSTRAINT nonempty CHECK(length(VALUE) > 0);

statement error
ALTER DOMAIN d_drop DROP CONSTRAINT missed; 

statement ok
ALTER DOMAIN d_drop DROP CONSTRAINT IF EXISTS missed;

statement ok
ALTER DOMAIN d_drop DROP CONSTRAINT nonempty;

statement ok
CREATE TABLE t_drop (v d_drop);

statement ok
INSERT INTO t_drop VALUES ('');

statement ok
CREATE DOMAIN d_dc_cs AS int4 CONSTRAINT pos CHECK (VALUE > 0);

statement ok
CREATE TABLE t_dc_cs (id int, v d_dc_cs);

statement ok
INSERT INTO t_dc_cs VALUES (1, 5); 

statement ok
ALTER DOMAIN d_dc_cs DROP CONSTRAINT pos CASCADE; 

query
SELECT id, v FROM t_dc_cs;
----
id	v
1	5

# RENAME CONSTRAINT: the new name works, the old one is gone.

statement ok
CREATE DOMAIN d_rc AS int4 CONSTRAINT pos CHECK (VALUE > 0);

statement error
ALTER DOMAIN d_rc RENAME CONSTRAINT pos TO pos;

statement ok
ALTER DOMAIN d_rc RENAME CONSTRAINT pos TO positive;

statement error
ALTER DOMAIN d_rc DROP CONSTRAINT pos;

statement ok
ALTER DOMAIN d_rc DROP CONSTRAINT positive;

statement error
ALTER DOMAIN d_rc RENAME CONSTRAINT none TO pos;

# VALIDATE CONSTRAINT rejects existing violators and passes once they are fixed.

statement ok
CREATE DOMAIN positive_money_2 AS INT4 NOT NULL;

statement ok
CREATE TABLE t_money (amount positive_money_2);

statement ok
INSERT INTO t_money VALUES (-3);

statement ok
ALTER DOMAIN positive_money_2 ADD CONSTRAINT c CHECK (VALUE > 0) NOT VALID;

statement error
ALTER DOMAIN positive_money_2 VALIDATE CONSTRAINT c

statement ok
UPDATE t_money SET amount = 10;

statement ok
ALTER DOMAIN positive_money_2 VALIDATE CONSTRAINT c

# RENAME TO: the old name is gone, columns follow the new one.

statement ok
CREATE DOMAIN d_rn_old AS int4;

statement ok
ALTER DOMAIN d_rn_old RENAME TO d_rn_new;

statement error
SELECT 1::d_rn_old;

query
SELECT 1::d_rn_new;
----
d_rn_new
1

statement ok
CREATE DOMAIN d_rn_tab AS int4;

statement ok
CREATE TABLE t_rn (v d_rn_tab);

statement count 1
INSERT INTO t_rn VALUES (1);

statement ok
ALTER DOMAIN d_rn_tab RENAME TO d_rn_tab2;

query
SELECT pg_typeof(v) FROM t_rn;
----
pg_typeof
d_rn_tab2

# SET SCHEMA moves the domain; columns follow it.

statement ok
CREATE SCHEMA ds_ss;

statement ok
CREATE DOMAIN d_ss AS int4;

statement ok
CREATE TABLE t_ss (v d_ss);

statement count 1
INSERT INTO t_ss VALUES (1);

statement ok
ALTER DOMAIN d_ss SET SCHEMA ds_ss;

query
SELECT pg_typeof(v) FROM t_ss;
----
pg_typeof
ds_ss.d_ss

statement error
SELECT 1::public.d_ss;

# DROP DOMAIN: IF EXISTS, RESTRICT refuses while a column uses it, CASCADE drops that column.

statement error
DROP DOMAIN d_drp_none;

statement ok
DROP DOMAIN IF EXISTS d_drp_none;

statement ok
CREATE DOMAIN d_drp AS int4;

statement ok
CREATE TABLE t_drp (id int, v d_drp);

statement error
DROP DOMAIN d_drp RESTRICT;

query
SELECT * FROM t_drp;
----
id	v

query
SELECT 1::d_drp;
----
d_drp
1

statement ok
DROP DOMAIN d_drp CASCADE;

query
SELECT * FROM t_drp;
----
id

# A domain as a function parameter and result type is checked on both sides.

statement ok
CREATE DOMAIN d_fn AS int4 CHECK (VALUE > 0);

statement ok
CREATE FUNCTION f_dom_id(x d_fn) RETURNS d_fn LANGUAGE sql AS 'SELECT x';

query
SELECT f_dom_id(5);
----
f_dom_id
5

statement error
SELECT f_dom_id(-1);

statement ok
CREATE FUNCTION f_dom_bad() RETURNS d_fn LANGUAGE sql AS 'SELECT -1';

statement error
SELECT f_dom_bad();

# A domain is a pg_type row of type d over its base type, with NOT NULL in typnotnull.

statement ok
CREATE DOMAIN d_pgt AS int4 NOT NULL;

query
SELECT typtype, typbasetype::regtype, typnotnull FROM pg_type WHERE typname = 'd_pgt';
----
typtype	typbasetype	typnotnull
d	integer	t

# information_schema lists the domain, its constraints and the columns that use it.

statement ok
CREATE DOMAIN d_is AS int4 CONSTRAINT d_is_pos CHECK (VALUE > 0);

statement ok
CREATE TABLE t_is (v d_is);

query
SELECT domain_name, data_type FROM information_schema.domains WHERE domain_name = 'd_is';
----
domain_name	data_type
d_is	integer

query
SELECT constraint_name FROM information_schema.domain_constraints WHERE domain_name = 'd_is';
----
constraint_name
d_is_pos

query
SELECT table_name, column_name FROM information_schema.column_domain_usage WHERE domain_name = 'd_is';
----
table_name	column_name
t_is	v
