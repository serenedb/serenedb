statement ok
CREATE DOMAIN tmp_cat_e AS tmp_cat_enum;

statement ok
CREATE DOMAIN tmp_cat_over AS tmp_cat;

query
SELECT typname, typtype, typlen, typbyval, typalign, typstorage, typnotnull, typdefault, format_type(typbasetype, typtypmod) AS base FROM pg_type WHERE typname IN ('tmp_cat', 'tmp_cat_txt', 'tmp_cat_e', 'tmp_cat_over') ORDER BY typname;
----
typname	typtype	typlen	typbyval	typalign	typstorage	typnotnull	typdefault	base
tmp_cat	d	4	t	i	p	t	42	integer
tmp_cat_e	d	4	t	i	p	f	NULL	tmp_cat_enum
tmp_cat_over	d	4	t	i	p	f	42	tmp_cat
tmp_cat_txt	d	-1	f	i	x	f	NULL	text

query
SELECT typname, typoutput, typsend FROM pg_type WHERE typname IN ('tmp_cat', 'tmp_cat_txt', 'tmp_cat_over') ORDER BY typname;
----
typname	typoutput	typsend
tmp_cat	int4out	int4send
tmp_cat_over	int4out	int4send
tmp_cat_txt	textout	textsend

statement ok
CREATE TABLE tmp_cat_t (a tmp_cat, b tmp_cat_txt, c tmp_cat[], d tmp_cat_e, e tmp_cat_over);

query
SELECT attname, format_type(atttypid, atttypmod) AS t, attlen, attalign, attcollation::regcollation AS coll FROM pg_attribute WHERE attrelid = 'tmp_cat_t'::regclass AND attnum > 0 ORDER BY attnum;
----
attname	t	attlen	attalign	coll
a	tmp_cat	4	i	-
b	tmp_cat_txt	-1	i	"C"
c	tmp_cat[]	-1	i	-
d	tmp_cat_e	4	i	-
e	tmp_cat_over	4	i	-

query
SELECT pg_typeof(a) AS a, pg_typeof(b) AS b, pg_typeof(c) AS c, pg_typeof(d) AS d, pg_typeof(e) AS e FROM (SELECT 1::tmp_cat AS a, 'q'::tmp_cat_txt AS b, ARRAY[1]::tmp_cat[] AS c, 'x'::tmp_cat_e AS d, 2::tmp_cat_over AS e) s;
----
a	b	c	d	e
tmp_cat	tmp_cat_txt	tmp_cat[]	tmp_cat_e	tmp_cat_over
