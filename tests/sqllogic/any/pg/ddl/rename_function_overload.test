statement ok
CREATE FUNCTION rof_f(x INT) RETURNS INT LANGUAGE SQL AS 'SELECT x + 1';


statement ok
CREATE FUNCTION rof_f(x TEXT) RETURNS TEXT LANGUAGE SQL AS 'SELECT x || x';


statement error
ALTER FUNCTION rof_f RENAME TO rof_g;
----
db error: ERROR: function name "rof_f" is not unique
HINT: Specify the argument list to select the function unambiguously.


statement ok
CREATE TABLE rof_oids AS SELECT oid::regprocedure::text AS f, oid FROM pg_proc WHERE proname = 'rof_f';


statement ok
ALTER FUNCTION rof_f(integer) RENAME TO rof_g;


query
SELECT oid::regprocedure::text AS f FROM pg_proc WHERE proname IN ('rof_f', 'rof_g') ORDER BY 1;
----
f
rof_f(text)
rof_g(integer)


# PostgreSQL keeps the oid of a renamed overload; SereneDB gives an overload
# that moves to another name a new one.
onlyif postgres
query
SELECT o.f AS was, p.oid::regprocedure::text AS now FROM rof_oids o JOIN pg_proc p ON p.oid = o.oid ORDER BY 1;
----
was	now
rof_f(integer)	rof_g(integer)
rof_f(text)	rof_f(text)


skipif postgres
query
SELECT o.f AS was, p.oid::regprocedure::text AS now FROM rof_oids o JOIN pg_proc p ON p.oid = o.oid ORDER BY 1;
----
was	now
rof_f(text)	rof_f(text)


query
SELECT rof_g(1) AS g, rof_f('a') AS f;
----
g	f
2	aa


