statement ok
CREATE TABLE rrc_c (pid INT NOT NULL REFERENCES rrc_p (id), qx INT REFERENCES rrc_q (x), CHECK (pid > 0));


statement ok
ALTER TABLE rrc_p RENAME COLUMN id TO pid2;


query
SELECT conname, pg_get_constraintdef(oid) AS def FROM pg_constraint WHERE conrelid = 'rrc_c'::regclass AND contype IN ('f', 'c') ORDER BY conname;
