statement ok
CREATE TABLE beast_crew (id int, name text);


statement ok
INSERT INTO beast_crew VALUES (6, 'karl'), (7, 'chandler'), (67, 'nolan');


query
SELECT pg_typeof(ctid)::text AS ctid, pg_typeof(xmin)::text AS xmin, pg_typeof(xmax)::text AS xmax, pg_typeof(cmin)::text AS cmin, pg_typeof(cmax)::text AS cmax
FROM beast_crew
LIMIT 1;
----
ctid	xmin	xmax	cmin	cmax
tid	xid	xid	cid	cid


query
SELECT * FROM beast_crew ORDER BY id;
----
id	name
6	karl
7	chandler
67	nolan


query
SELECT count(DISTINCT ctid) AS rows, min(xmax::text) AS xmax, min(cmin::text) AS cmin, max(cmax::text) AS cmax FROM beast_crew;
----
rows	xmax	cmin	cmax
3	0	0	0


