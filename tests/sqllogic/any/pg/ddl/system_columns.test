CREATE TABLE beast_dup (n int);


statement ok
INSERT INTO beast_dup VALUES (6), (6), (7), (7), (7);


statement ok
DELETE FROM beast_dup x USING beast_dup y WHERE x.n = y.n AND x.ctid > y.ctid;


query
SELECT n FROM beast_dup ORDER BY n;
