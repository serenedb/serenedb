# geometry and geometry[] columns holding every OGC geometry type, stored and
# read back, unnested, indexed, aggregated and passed to spatial functions.
# Geometries are compared as hex WKB, which SereneDB and PostGIS render alike.

onlyif postgres
statement ok
CREATE EXTENSION IF NOT EXISTS postgis;

statement ok
CREATE TABLE geo_arrays_all_types (kind TEXT, g geometry, arr geometry[]);

statement ok
INSERT INTO geo_arrays_all_types VALUES
 ('point',      'POINT(1 2)'::geometry,                              ARRAY['POINT(1 2)'::geometry, 'POINT(3 4)'::geometry]),
 ('linestring', 'LINESTRING(0 0,1 1,2 2)'::geometry,                 ARRAY['LINESTRING(0 0,1 1)'::geometry]),
 ('polygon',    'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry,          ARRAY['POLYGON((0 0,1 0,1 1,0 0))'::geometry, 'POINT(9 9)'::geometry]),
 ('multipoint', 'MULTIPOINT(0 0,1 1)'::geometry,                     ARRAY[]::geometry[]),
 ('multiline',  'MULTILINESTRING((0 0,1 1),(2 2,3 3))'::geometry,    NULL),
 ('multipoly',  'MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((2 2,3 2,3 3,2 2)))'::geometry, ARRAY[NULL::geometry, 'POINT(5 5)'::geometry]),
 ('collection', 'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'::geometry, ARRAY['GEOMETRYCOLLECTION(POINT(1 2))'::geometry]);

