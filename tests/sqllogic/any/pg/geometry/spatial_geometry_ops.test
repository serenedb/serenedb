# PostGIS-compatible constructors, overlay operations and geometry editors.
# These return geometries, and WKT text rendering diverges (SereneDB emits
# POINT (1 1), PostGIS emits POINT(1 1)), so each result is compared with
# ST_Equals against an expected literal instead -- a boolean, which is portable.

onlyif postgres
statement ok
CREATE EXTENSION IF NOT EXISTS postgis;

query
SELECT ST_Equals(ST_Intersection('LINESTRING(0 0,4 0)'::geometry,'LINESTRING(2 0,6 0)'::geometry), 'LINESTRING(2 0,4 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Union('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry,'POLYGON((2 0,4 0,4 2,2 2,2 0))'::geometry), 'POLYGON((0 0,4 0,4 2,0 2,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Difference('POLYGON((0 0,4 0,4 2,0 2,0 0))'::geometry,'POLYGON((2 0,4 0,4 2,2 2,2 0))'::geometry), 'POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_SymDifference('LINESTRING(0 0,4 0)'::geometry,'LINESTRING(2 0,6 0)'::geometry), 'MULTILINESTRING((0 0,2 0),(4 0,6 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_ConvexHull('MULTIPOINT(0 0,4 0,4 4,0 4,2 2)'::geometry), 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Envelope('LINESTRING(0 0,2 2,4 4)'::geometry), 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Boundary('POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry), 'LINESTRING(0 0,4 0,4 4,0 4,0 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Centroid('POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry), 'POINT(2 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_ExteriorRing('POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry), 'LINESTRING(0 0,4 0,4 4,0 4,0 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_InteriorRingN('POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,4 2,4 4,2 4,2 2))'::geometry, 1), 'LINESTRING(2 2,4 2,4 4,2 4,2 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_StartPoint('LINESTRING(0 0,2 2,4 4)'::geometry), 'POINT(0 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_EndPoint('LINESTRING(0 0,2 2,4 4)'::geometry), 'POINT(4 4)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_PointN('LINESTRING(0 0,2 2,4 4)'::geometry, 2), 'POINT(2 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Reverse('LINESTRING(0 0,2 2,4 4)'::geometry), 'LINESTRING(4 4,2 2,0 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_MakeLine('POINT(0 0)'::geometry, 'POINT(1 1)'::geometry), 'LINESTRING(0 0,1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 4,0 0)'::geometry), 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_MakeEnvelope(0,0,4,4), 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Point(1,1), 'POINT(1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_MakePoint(1,1), 'POINT(1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Collect(ARRAY['POINT(0 0)'::geometry, 'POINT(1 1)'::geometry]), 'MULTIPOINT(0 0,1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Multi('POINT(1 1)'::geometry), 'MULTIPOINT(1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Simplify('LINESTRING(0 0,2 2,4 4)'::geometry, 1), 'LINESTRING(0 0,4 4)'::geometry) AS v;
----
v
t

query
SELECT ST_Intersects(ST_PointOnSurface('POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry), 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_ClosestPoint('LINESTRING(0 0,2 2,4 4)'::geometry, 'POINT(0 0)'::geometry), 'POINT(0 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_ShortestLine('POINT(0 0)'::geometry, 'POINT(0 2)'::geometry), 'LINESTRING(0 0,0 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Normalize('POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry), 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_FlipCoordinates('POINT(1 2)'::geometry), 'POINT(2 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Force2D('POINT Z(1 2 3)'::geometry), 'POINT(1 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_CollectionExtract('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,2 2))'::geometry, 1), 'MULTIPOINT(1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_RemoveRepeatedPoints('LINESTRING(0 0,0 0,2 2)'::geometry), 'LINESTRING(0 0,2 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_LineInterpolatePoint('LINESTRING(0 0,4 0)'::geometry, 0.5), 'POINT(2 0)'::geometry) AS v;
----
v
t

query
SELECT ST_Area(ST_Buffer('POINT(0 0)'::geometry, 1)) > 3.13 AND ST_Area(ST_Buffer('POINT(0 0)'::geometry, 1)) < 3.15 AS v;
----
v
f

query
SELECT ST_Equals(ST_TransScale('POINT(1 1)'::geometry, 1, 1, 2, 2), 'POINT(4 4)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Translate('POINT(0 0)'::geometry, 1, 1), 'POINT(1 1)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Scale('POINT(1 1)'::geometry, 2, 2), 'POINT(2 2)'::geometry) AS v;
----
v
t

query
SELECT ST_Equals(ST_Rotate('POINT(0 0)'::geometry, 1.5707963267948966), 'POINT(0 0)'::geometry) AS v;
