statement ok
CREATE FUNCTION ado_f() RETURNS INT LANGUAGE SQL AS 'SELECT 1';


statement ok
GRANT EXECUTE ON FUNCTION ado_f() TO ado_user;


query
SELECT array_to_string(proacl, ',') AS acl FROM pg_proc WHERE proname = 'ado_f';
----
acl
=X/postgres,postgres=X/postgres,ado_user=X/postgres


statement ok
CREATE TYPE ado_t AS ENUM ('a');


statement ok
GRANT USAGE ON TYPE ado_t TO ado_user;


query
