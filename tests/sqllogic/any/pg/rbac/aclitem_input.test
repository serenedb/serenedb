query
SELECT grantee, pg_get_userbyid(grantor) AS grantor, privilege_type, is_grantable
FROM aclexplode(ARRAY[makeaclitem(12345, 'postgres'::regrole, 'SELECT', true), '"aclin two"=U/postgres'::aclitem])
ORDER BY grantee, privilege_type
----
grantee	grantor	privilege_type	is_grantable
12345	postgres	SELECT	t
<slt:ignore>	postgres	USAGE	f

