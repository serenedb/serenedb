CREATE ROLE "aclin two"

query
SELECT x::aclitem::text AS acl
FROM (VALUES ('aclin_reader=r*w/postgres'), ('user aclin_reader=r/postgres'), ('group aclin_reader=a/postgres'),
  ('=r/postgres'), ('"aclin two"=U/postgres'), ('aclin_reader=/postgres'), ('  aclin_reader=r/postgres  '),
  ('aclin_reader=r'), ('aclin_reader=arwdDxtXUCTcsAm*/postgres')) v(x)
ORDER BY x COLLATE "C"
----
acl
aclin_reader=r/postgres
"aclin two"=U/postgres
=r/postgres
aclin_reader=/postgres
aclin_reader=arwdDxtXUCTcsAm*/postgres
aclin_reader=r/postgres
aclin_reader=r*w/postgres
aclin_reader=a/postgres
aclin_reader=r/postgres

