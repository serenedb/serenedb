query
SELECT pg_input_is_valid('aclin_reader=r/postgres', 'aclitem') AS valid,
  pg_input_is_valid('aclin_reader=rz/postgres', 'aclitem') AS invalid_mode,
  pg_input_is_valid('aclin_nosuch=r/postgres', 'aclitem') AS missing_role
