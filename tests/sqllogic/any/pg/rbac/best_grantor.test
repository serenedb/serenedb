query
SELECT pg_get_userbyid(a.grantor) AS grantor, a.privilege_type
FROM pg_class c, aclexplode(c.relacl) a
WHERE c.relname = 'bgr_t' AND a.grantee = (SELECT oid FROM pg_roles WHERE rolname = 'bgr_d')
ORDER BY 2;
----
grantor	privilege_type
bgr_b	INSERT
bgr_b	SELECT


