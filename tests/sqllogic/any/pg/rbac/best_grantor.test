query
SELECT 'table' AS level, pg_get_userbyid(a.grantor) AS grantor, a.privilege_type
FROM pg_class c, aclexplode(c.relacl) a
WHERE c.relname = 'bgr_t4' AND a.grantee = (SELECT oid FROM pg_roles WHERE rolname = 'bgr_rev_d')
UNION ALL
SELECT c.attname::text, pg_get_userbyid(a.grantor), a.privilege_type
FROM pg_attribute c, aclexplode(c.attacl) a
WHERE c.attrelid = 'bgr_t4'::regclass AND a.grantee = (SELECT oid FROM pg_roles WHERE rolname = 'bgr_rev_d')
ORDER BY 1, 3;
----
level	grantor	privilege_type


