statement ok
DROP ROLE IF EXISTS bg_user;


statement ok
CREATE ROLE bg_user;


query
SELECT has_function_privilege('bg_user', 'lower(text)', 'EXECUTE') AS function,
       has_type_privilege('bg_user', 'int4', 'USAGE') AS type,
       has_type_privilege('bg_user', 'int4[]', 'USAGE') AS array_type,
       has_language_privilege('bg_user', 'sql', 'USAGE') AS language,
       has_schema_privilege('bg_user', 'pg_catalog', 'USAGE') AS catalog_schema,
       has_schema_privilege('bg_user', 'information_schema', 'USAGE') AS info_schema,
       has_table_privilege('bg_user', 'pg_catalog.pg_class', 'SELECT') AS catalog_table,
       has_table_privilege('bg_user', 'pg_catalog.pg_authid', 'SELECT') AS superuser_catalog;
----
function	type	array_type	language	catalog_schema	info_schema	catalog_table	superuser_catalog
t	t	t	t	t	t	t	f


