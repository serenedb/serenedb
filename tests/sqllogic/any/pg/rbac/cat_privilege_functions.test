       has_column_privilege('pfn_indexed_b', 'b', 'SELECT') AS index_column,
       has_column_privilege('pfn_indexed_pkey', 'a', 'SELECT') AS key_column,
       has_column_privilege('pfn_composite', 'zip', 'SELECT') AS composite_column;
----
index_by_name	index_column	key_column	composite_column
f	t	t	t


