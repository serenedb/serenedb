query
SELECT c.relname,
       has_table_privilege(c.oid, 'SELECT') AS superuser,
       has_table_privilege('pfn_owner', c.oid, 'SELECT') AS owner,
       has_table_privilege('pfn_reader', c.oid, 'SELECT') AS reader,
       has_any_column_privilege('pfn_reader', c.oid, 'SELECT') AS reader_any_column,
       has_column_privilege('pfn_owner', c.oid, 1::smallint, 'SELECT') AS owner_column,
       has_column_privilege('pfn_reader', c.oid, 1::smallint, 'SELECT') AS reader_column,
       has_column_privilege(c.oid, 99::smallint, 'SELECT') AS missing_column
FROM pg_class c
WHERE c.relname IN ('pfn_indexed', 'pfn_indexed_pkey', 'pfn_indexed_b', 'pfn_composite')
ORDER BY c.relname;
----
relname	superuser	owner	reader	reader_any_column	owner_column	reader_column	missing_column
pfn_composite	t	f	f	f	f	f	NULL
pfn_indexed	t	t	t	t	t	t	NULL
pfn_indexed_b	t	t	f	f	t	f	NULL
pfn_indexed_pkey	t	t	f	f	t	f	NULL


