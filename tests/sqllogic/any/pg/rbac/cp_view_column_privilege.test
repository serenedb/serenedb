view_any	table_any	system_view_any	view_oid_any
t	f	t	t


query
SELECT has_column_privilege('cpv_support', 'cpv_lane_view', 'hero', 'SELECT') AS by_name,
       has_column_privilege('cpv_support', 'cpv_lane_view', 'hero', 'UPDATE') AS not_granted,
       has_column_privilege('cpv_support', 'cpv_lane_view', 2::int2, 'SELECT') AS by_attnum,
       has_column_privilege('cpv_lane_view'::regclass, 2::int2, 'SELECT') AS by_oid,
       has_column_privilege('cpv_lane_view'::regclass, 3::int2, 'SELECT') AS past_last,
       has_column_privilege('pg_catalog.pg_tables', 'tablename', 'SELECT') AS system_view;
