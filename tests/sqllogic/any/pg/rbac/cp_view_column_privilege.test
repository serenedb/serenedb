by_name	not_granted	by_attnum	by_oid	past_last	system_view
t	f	t	t	NULL	t


query
SELECT has_table_privilege(r.oid, 'cpv_lane_view', 'SELECT') AS view_by_role_oid,
       has_table_privilege(r.oid, 'cpv_lane', 'SELECT') AS table_by_role_oid
FROM pg_roles r WHERE r.rolname = 'cpv_support';
