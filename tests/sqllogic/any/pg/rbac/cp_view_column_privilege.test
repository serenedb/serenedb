CREATE VIEW cpv_lane_view AS SELECT id, hero FROM cpv_lane;


statement ok
CREATE ROLE cpv_support;


statement ok
GRANT SELECT ON cpv_lane_view TO cpv_support;


query
SELECT has_any_column_privilege('cpv_support', 'cpv_lane_view', 'SELECT') AS view_any,
       has_any_column_privilege('cpv_support', 'cpv_lane', 'SELECT') AS table_any,
       has_any_column_privilege('pg_catalog.pg_tables', 'SELECT') AS system_view_any,
       has_any_column_privilege('cpv_lane_view'::regclass, 'SELECT') AS view_oid_any;
