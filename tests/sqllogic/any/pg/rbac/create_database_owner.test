query
SELECT d.datname, r.rolname
FROM pg_database d JOIN pg_roles r ON r.oid = d.datdba
WHERE d.datname IN ('cdo_db', 'cdo_db_with')
ORDER BY d.datname;
----
datname	rolname
cdo_db	cdo_alice
cdo_db_with	cdo_alice


