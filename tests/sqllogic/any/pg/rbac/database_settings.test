query
SELECT coalesce(r.rolname, '-') AS role, s.setconfig
FROM pg_db_role_setting s
JOIN pg_database d ON d.oid = s.setdatabase
LEFT JOIN pg_roles r ON r.oid = s.setrole
WHERE d.datname = 'dbs_db'
ORDER BY role;
----
role	setconfig
-	{"search_path=dbs_s, public"}
dbs_other	{search_path=dbs_t}


