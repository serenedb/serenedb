query
SELECT s.setrole = 0 AS all_roles, array_to_string(s.setconfig, ',') AS config
FROM pg_db_role_setting s JOIN pg_database d ON d.oid = s.setdatabase
WHERE d.datname = 'drs_db'
ORDER BY s.setrole;
----
all_roles	config
t	extra_float_digits=2
f	extra_float_digits=3


