query
SELECT pg_describe_object('pg_default_acl'::regclass, oid, 0) AS object
FROM pg_default_acl WHERE defaclrole = 'dpd_kostya'::regrole
ORDER BY 1;
----
object
default privileges on new relations belonging to role dpd_kostya in schema dpd_mop
default privileges on new types belonging to role dpd_kostya


statement ok
CREATE TABLE dpd_kept AS
SELECT oid AS kept FROM pg_default_acl
WHERE defaclrole = 'dpd_kostya'::regrole AND defaclobjtype = 'T';


statement ok
DROP SCHEMA dpd_mop;


query
SELECT defaclobjtype, oid = (SELECT kept FROM dpd_kept) AS same_oid
FROM pg_default_acl WHERE defaclrole = 'dpd_kostya'::regrole
ORDER BY 1;
----
defaclobjtype	same_oid
T	t


