CREATE FUNCTION dcic_names() RETURNS text LANGUAGE sql SECURITY DEFINER
AS $$ WITH c AS NOT MATERIALIZED (SELECT n::regclass AS r FROM dcic_s.names)
  SELECT (SELECT r::text FROM c) || ' ' || (SELECT r::text FROM c) $$;


