statement ok
CREATE SCHEMA dnr_s AUTHORIZATION dnr_owner;


statement ok
CREATE TABLE dnr_s.t (a integer);


statement ok
ALTER TABLE dnr_s.t OWNER TO dnr_owner;


statement ok
CREATE FUNCTION dnr_cast() RETURNS text LANGUAGE sql SECURITY DEFINER AS $$ SELECT 'dnr_s.t'::regclass::text $$;


statement ok
ALTER FUNCTION dnr_cast() OWNER TO dnr_owner;


statement ok
CREATE FUNCTION dnr_lookup() RETURNS text LANGUAGE sql SECURITY DEFINER AS $$ SELECT to_regclass('dnr_s.t')::text $$;


statement ok
ALTER FUNCTION dnr_lookup() OWNER TO dnr_owner;


statement ok
CREATE FUNCTION dnr_privilege() RETURNS boolean LANGUAGE sql SECURITY DEFINER AS $$ SELECT has_table_privilege('dnr_s.t', 'SELECT') $$;


statement ok
ALTER FUNCTION dnr_privilege() OWNER TO dnr_owner;


statement ok
