statement ok
CREATE TABLE dpw_ledger (a integer);


statement ok
GRANT SELECT, INSERT, UPDATE, DELETE ON dpw_ledger TO dpw_owner;


statement ok
CREATE PROCEDURE dpw_put(x integer) LANGUAGE sql SECURITY DEFINER AS 'INSERT INTO dpw_ledger VALUES (x)';


statement ok
ALTER PROCEDURE dpw_put(integer) OWNER TO dpw_owner;


statement ok
CREATE PROCEDURE dpw_bump() LANGUAGE sql SECURITY DEFINER AS 'UPDATE dpw_ledger SET a = a + 10';


statement ok
ALTER PROCEDURE dpw_bump() OWNER TO dpw_owner;


statement ok
CREATE PROCEDURE dpw_clear() LANGUAGE sql SECURITY DEFINER AS 'DELETE FROM dpw_ledger WHERE a > 100';


statement ok
ALTER PROCEDURE dpw_clear() OWNER TO dpw_owner;


