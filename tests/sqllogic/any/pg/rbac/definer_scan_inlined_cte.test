statement ok
CREATE FUNCTION dsic_once() RETURNS bigint LANGUAGE sql SECURITY DEFINER
AS $$ SELECT count(*) FROM pg_class WHERE relname = 'dsic_t' $$;


statement ok
CREATE FUNCTION dsic_twice() RETURNS bigint LANGUAGE sql SECURITY DEFINER
AS $$ WITH c AS NOT MATERIALIZED (SELECT oid FROM pg_class WHERE relname = 'dsic_t')
  SELECT (SELECT count(*) FROM c) + (SELECT count(*) FROM c) $$;


statement ok
ALTER FUNCTION dsic_once() OWNER TO dsic_owner;


statement ok
ALTER FUNCTION dsic_twice() OWNER TO dsic_owner;


connection c_dsic user=dsic_caller password=dsic_pw
query
SELECT dsic_once() AS once, dsic_twice() AS twice;
----
once	twice
1	2


