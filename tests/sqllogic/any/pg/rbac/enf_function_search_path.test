CREATE FUNCTION public.efsp_outer() RETURNS text LANGUAGE SQL SET search_path = efsp_a AS 'SELECT public.efsp_floating()';


query
SELECT efsp_echo((SELECT v FROM t)) AS echoed, efsp_outer() AS nested;
----
echoed	nested
ab	a


query
SELECT v FROM efsp_echo_rows((SELECT v FROM t));
----
v
ab


