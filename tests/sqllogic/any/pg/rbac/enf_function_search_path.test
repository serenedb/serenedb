statement ok
SET search_path = efsp_a, public;


query
SELECT efsp_pinned() AS pinned, efsp_floating() AS floating, efsp_current() AS current;
----
pinned	floating	current
a	a	b


query
SELECT proname, proconfig FROM pg_proc
WHERE proname IN ('efsp_pinned', 'efsp_rows', 'efsp_floating', 'efsp_current')
ORDER BY proname;
----
proname	proconfig
efsp_current	{"search_path=efsp_b, public"}
efsp_floating	NULL
efsp_pinned	{search_path=efsp_a}
efsp_rows	{search_path=efsp_a}


query
SELECT pg_get_functiondef('public.efsp_current()'::regprocedure) AS def;
----
def
CREATE OR REPLACE FUNCTION public.efsp_current()\n RETURNS text\n LANGUAGE sql\n SET search_path TO 'efsp_b', 'public'\nAS $function$SELECT v FROM t$function$\n


