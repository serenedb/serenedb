statement ok
MERGE INTO emnc_ledger t USING (SELECT 1 AS id, 20 AS amount) s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET amount = s.amount;


statement ok
MERGE INTO emnc_ledger t USING (SELECT 2 AS id, 30 AS amount) s ON t.id = s.id
WHEN NOT MATCHED THEN INSERT (id, amount) VALUES (s.id, s.amount);


statement ok
