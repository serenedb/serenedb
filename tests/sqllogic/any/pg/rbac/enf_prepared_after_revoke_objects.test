statement ok
CREATE ROLE epo_vedernikoff LOGIN PASSWORD 'epo_pw';


statement ok
CREATE SEQUENCE epo_counter;


statement ok
CREATE FUNCTION epo_double(x integer) RETURNS integer LANGUAGE sql AS 'SELECT $1 * 2';


statement ok
REVOKE EXECUTE ON FUNCTION epo_double(integer) FROM PUBLIC;


statement ok
GRANT EXECUTE ON FUNCTION epo_double(integer) TO epo_vedernikoff;


statement ok
GRANT USAGE ON SEQUENCE epo_counter TO epo_vedernikoff;


connection c_epo user=epo_vedernikoff password=epo_pw
statement ok
