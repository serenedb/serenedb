statement ok
CREATE FUNCTION esen_hidden.esen_positive(x integer) RETURNS boolean LANGUAGE sql AS 'SELECT x > 0';


statement ok
GRANT USAGE ON SEQUENCE esen_hidden.esen_ids TO esen_vedernikoff;


statement ok
CREATE TABLE esen_with_default (id bigint DEFAULT nextval('esen_hidden.esen_ids'), a integer);


statement ok
CREATE TABLE esen_with_check (a integer CHECK (esen_hidden.esen_positive(a)));


statement ok
CREATE FUNCTION esen_hidden.esen_double(x integer) RETURNS integer LANGUAGE sql IMMUTABLE AS 'SELECT x * 2';


statement ok
CREATE TABLE esen_generated (a integer, b integer GENERATED ALWAYS AS (esen_hidden.esen_double(a)) STORED);


