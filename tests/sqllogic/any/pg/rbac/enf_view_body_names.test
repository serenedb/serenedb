statement ok
CREATE VIEW public.evbn_clickclack AS SELECT evbn_tag(a) AS tagged FROM evbn_iceberg;


statement ok
CREATE VIEW public.evbn_mop AS SELECT count(*) > 0 AS from_catalog FROM pg_roles WHERE rolname = current_user;


statement ok
CREATE VIEW public.evbn_lower AS SELECT lower('A') AS one, lower('A', 'B') AS two;


statement ok
CREATE VIEW public.evbn_quas_first AS SELECT (SELECT a FROM evbn_ved.evbn_iceberg) AS qualified, (SELECT a FROM evbn_iceberg) AS unqualified;


