query
SELECT c.relname, array_to_string(c.relacl, ',') AS acl
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = 'gaig_s' AND c.relkind = 'r'
ORDER BY c.relname;
----
relname	acl
gaig_mine	NULL
gaig_theirs	NULL


query
SELECT pg_get_function_identity_arguments(p.oid) AS args,
       array_to_string(p.proacl, ',') LIKE '%gaig_bob=X/gaig_alice%' AS granted
FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
WHERE n.nspname = 'gaig_s'
ORDER BY 1;
----
args	granted
integer	t
text	t


