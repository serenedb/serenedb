statement ok
ALTER DEFAULT PRIVILEGES FOR ROLE gl_group1, gl_group2 IN SCHEMA gl_s1, gl_s2 GRANT SELECT ON TABLES TO gl_alice, gl_bob;


query
SELECT d.defaclrole::regrole::text AS role, d.defaclnamespace::regnamespace::text AS nsp,
       array_to_string(d.defaclacl, ',') AS acl
FROM pg_default_acl d
WHERE d.defaclrole IN ('gl_group1'::regrole, 'gl_group2'::regrole)
ORDER BY 1, 2;
----
role	nsp	acl
gl_group1	gl_s1	gl_alice=r/gl_group1,gl_bob=r/gl_group1
gl_group1	gl_s2	gl_alice=r/gl_group1,gl_bob=r/gl_group1
gl_group2	gl_s1	gl_alice=r/gl_group2,gl_bob=r/gl_group2
gl_group2	gl_s2	gl_alice=r/gl_group2,gl_bob=r/gl_group2


