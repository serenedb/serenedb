       has_table_privilege('gl_alice', 'gl_t2', 'INSERT') AS a2,
       has_table_privilege('gl_bob', 'gl_t1', 'INSERT') AS b1,
       has_table_privilege('gl_bob', 'gl_t2', 'SELECT') AS b2;
