query
SELECT has_table_privilege('htp_rk_reader', 'htp_rk_view', 'SELECT') AS tbl_name,
       has_table_privilege(r.oid, 'htp_rk_view', 'SELECT') AS tbl_role_oid,
       has_any_column_privilege('htp_rk_reader', 'htp_rk_view', 'SELECT') AS any_col_name,
       has_column_privilege('htp_rk_reader', 'htp_rk_view', 'v', 'SELECT') AS col_name,
       has_column_privilege('htp_rk_reader', 'htp_rk_view', 2::int2, 'SELECT') AS col_attnum,
       has_column_privilege(r.oid, 'htp_rk_view'::regclass, 2::int2, 'SELECT') AS col_oid_attnum,
       has_column_privilege(r.oid, 'htp_rk_view'::regclass, 3::int2, 'SELECT') AS col_oid_no_attnum,
       has_column_privilege('htp_rk_reader', 'htp_rk_view', 'v', 'UPDATE') AS col_update
FROM pg_roles r WHERE r.rolname = 'htp_rk_reader';
----
tbl_name	tbl_role_oid	any_col_name	col_name	col_attnum	col_oid_attnum	col_oid_no_attnum	col_update
t	t	t	t	t	t	NULL	f


