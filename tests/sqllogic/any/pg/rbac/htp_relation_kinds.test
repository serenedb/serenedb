query
SELECT has_table_privilege('htp_rk_owner', 'htp_rk_seq', 'SELECT') AS own_sel,
       has_table_privilege('htp_rk_owner', 'htp_rk_seq', 'UPDATE') AS own_upd,
       has_table_privilege('htp_rk_owner', 'htp_rk_seq', 'INSERT') AS own_ins,
       has_table_privilege('htp_rk_reader', 'htp_rk_seq', 'SELECT') AS rd_sel,
       has_table_privilege('htp_rk_reader', 'htp_rk_seq', 'UPDATE') AS rd_upd,
       has_table_privilege('htp_rk_seq', 'INSERT') AS su_ins;
