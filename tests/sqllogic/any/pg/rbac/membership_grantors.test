query
SELECT r.rolname AS role, g.rolname AS grantor, a.admin_option, a.inherit_option, a.set_option
FROM pg_auth_members a
JOIN pg_roles r ON r.oid = a.roleid
JOIN pg_roles g ON g.oid = a.grantor
WHERE a.member = 'mgt_a2'::regrole AND r.rolname IN ('mgt_made', 'mgt_made2')
ORDER BY role, grantor;
----
role	grantor	admin_option	inherit_option	set_option
mgt_made	mgt_a2	f	t	t
mgt_made	postgres	t	f	f
mgt_made2	postgres	t	f	f


