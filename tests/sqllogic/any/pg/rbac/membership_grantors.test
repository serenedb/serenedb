query
SELECT g.rolname AS grantor, a.admin_option, a.inherit_option, a.set_option
FROM pg_auth_members a
JOIN pg_roles g ON g.oid = a.grantor
WHERE a.roleid = 'mgt_r'::regrole AND a.member = 'mgt_m'::regrole
ORDER BY grantor;
----
grantor	admin_option	inherit_option	set_option
mgt_a1	f	t	t
mgt_a2	f	t	t


