CREATE ROLE orki_runner;


statement ok
CREATE SCHEMA orki_s;


statement ok
CREATE FUNCTION orki_f(int) RETURNS int LANGUAGE sql AS 'SELECT $1';


statement ok
CREATE FUNCTION orki_f(text) RETURNS int LANGUAGE sql AS 'SELECT length($1)';


statement ok
CREATE FUNCTION orki_f(boolean) RETURNS int LANGUAGE sql AS 'SELECT 1';


statement ok
COMMENT ON FUNCTION orki_f(text) IS 'the text one';


statement ok
REVOKE EXECUTE ON FUNCTION orki_f(text) FROM PUBLIC;


statement ok
GRANT EXECUTE ON FUNCTION orki_f(text) TO orki_runner;


statement ok
CREATE TABLE orki_oids (name text, oid bigint);


statement ok
INSERT INTO orki_oids VALUES
  ('int', 'orki_f(int)'::regprocedure::oid),
  ('text', 'orki_f(text)'::regprocedure::oid),
  ('boolean', 'orki_f(boolean)'::regprocedure::oid);


statement ok
ALTER FUNCTION orki_f(text) RENAME TO orki_g;


query
SELECT 'orki_g(text)'::regprocedure::oid = oid AS kept FROM orki_oids WHERE name = 'text';
----
kept
t


query
SELECT obj_description('orki_g(text)'::regprocedure, 'pg_proc') AS comment;
----
comment
the text one


query
SELECT has_function_privilege('orki_runner', 'orki_g(text)', 'EXECUTE') AS runner,
       has_function_privilege('public', 'orki_g(text)', 'EXECUTE') AS anyone;
----
runner	anyone
t	f


