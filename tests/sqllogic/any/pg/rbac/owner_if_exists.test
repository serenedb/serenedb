# ALTER TABLE | VIEW | SEQUENCE IF EXISTS ... OWNER TO changes the owner of an existing relation and skips a missing one.

statement ok
CREATE ROLE oie_mop;


statement ok
CREATE TABLE oie_clickclack (id int);


statement ok
CREATE VIEW oie_view AS SELECT 1 AS one;


statement ok
CREATE SEQUENCE oie_seq;


statement ok
ALTER TABLE IF EXISTS oie_clickclack OWNER TO oie_mop;


statement ok
ALTER VIEW IF EXISTS oie_view OWNER TO oie_mop;


statement ok
ALTER SEQUENCE IF EXISTS oie_seq OWNER TO oie_mop;


query
SELECT relname, pg_get_userbyid(relowner) AS owner FROM pg_class
WHERE relname IN ('oie_clickclack', 'oie_view', 'oie_seq') ORDER BY relname;
----
relname	owner
oie_clickclack	oie_mop
oie_seq	oie_mop
oie_view	oie_mop


statement ok
ALTER TABLE IF EXISTS oie_missing OWNER TO oie_mop;


statement ok
ALTER VIEW IF EXISTS oie_missing OWNER TO oie_mop;


statement ok
ALTER SEQUENCE IF EXISTS oie_missing OWNER TO oie_mop;


onlyif postgres
statement error
ALTER TABLE oie_missing OWNER TO oie_mop;
----
db error: ERROR: relation "oie_missing" does not exist


skipif postgres
statement error
ALTER TABLE oie_missing OWNER TO oie_mop;
----
db error: ERROR: Table with name oie_missing does not exist!


statement ok
CREATE ROLE oie_heir;


statement ok
ALTER TABLE IF EXISTS oie_seq OWNER TO oie_heir;


query
SELECT pg_get_userbyid(relowner) AS owner FROM pg_class WHERE relname = 'oie_seq';
----
owner
oie_heir


statement error
ALTER SEQUENCE IF EXISTS oie_clickclack OWNER TO oie_heir;
----
db error: ERROR: "oie_clickclack" is not a sequence


statement error
ALTER VIEW IF EXISTS oie_seq OWNER TO oie_heir;
----
db error: ERROR: "oie_seq" is not a view


statement ok
DROP TABLE oie_clickclack;


statement ok
DROP VIEW oie_view;


statement ok
DROP SEQUENCE oie_seq;


statement ok
DROP ROLE oie_mop;


statement ok
DROP ROLE oie_heir;
