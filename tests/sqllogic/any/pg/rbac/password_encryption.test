password_encryption
scram-sha-256


statement ok
CREATE ROLE pwe_scram PASSWORD 'pwe_secret';


query
SELECT rolpassword LIKE 'SCRAM-SHA-256$4096:%' AS scram FROM pg_authid WHERE rolname = 'pwe_scram';
----
scram
t


statement ok
