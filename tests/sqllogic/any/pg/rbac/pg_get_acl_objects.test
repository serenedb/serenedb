statement ok
GRANT USAGE ON FOREIGN SERVER gao_srv TO gao_r;


query
SELECT array_to_string(pg_get_acl('pg_foreign_server'::regclass, oid, 0), ',') AS acl,
       pg_get_acl('pg_foreign_server'::regclass, oid, 0) IS NOT DISTINCT FROM srvacl AS same
FROM pg_foreign_server WHERE srvname = 'gao_srv';
----
acl	same
postgres=U/postgres,gao_r=U/postgres	t


