query
SELECT array_to_string(pg_get_acl('pg_database'::regclass, oid, 0), ',') AS acl,
       pg_get_acl('pg_database'::regclass, oid, 0) IS NOT DISTINCT FROM datacl AS same
FROM pg_database WHERE datname = 'gao_db';
----
acl	same
=Tc/postgres,postgres=CTc/postgres,gao_r=c/postgres	t


