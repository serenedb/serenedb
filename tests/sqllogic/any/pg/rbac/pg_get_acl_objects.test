query
SELECT array_to_string(pg_get_acl('pg_foreign_data_wrapper'::regclass, oid, 0), ',') AS acl,
       pg_get_acl('pg_foreign_data_wrapper'::regclass, oid, 0) IS NOT DISTINCT FROM fdwacl AS same
FROM pg_foreign_data_wrapper WHERE array_to_string(fdwacl, ',') LIKE '%gao_r=%';
----
acl	same
postgres=U/postgres,gao_r=U/postgres	t


query
SELECT pg_get_acl('pg_language'::regclass, oid, 0) IS NOT DISTINCT FROM lanacl AS same
FROM pg_language WHERE lanname = 'sql';
----
same
t


statement ok
CREATE VIEW gao_v AS SELECT 1 AS a, 2 AS b;


statement ok
GRANT SELECT (b) ON gao_v TO gao_r;


query
SELECT attname, array_to_string(pg_get_acl('pg_class'::regclass, attrelid, attnum), ',') AS acl,
       pg_get_acl('pg_class'::regclass, attrelid, attnum) IS NOT DISTINCT FROM attacl AS same
FROM pg_attribute WHERE attrelid = 'gao_v'::regclass AND attnum > 0 ORDER BY attnum;
----
attname	acl	same
a	NULL	t
b	gao_r=r/postgres	t


query
SELECT count(*) AS differing FROM pg_tablespace
WHERE pg_get_acl('pg_tablespace'::regclass, oid, 0) IS DISTINCT FROM spcacl;
----
differing
0


