query
SELECT pg_has_role(member, 'phr_ao_group', 'MEMBER') AS is_member
FROM (VALUES (1, 'phr_ao_member'), (2, 'phr_ao_member'), (3, 'phr_ao_group')) AS t(i, member) ORDER BY i;
