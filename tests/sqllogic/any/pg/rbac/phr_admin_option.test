DROP ROLE IF EXISTS phr_ao_group;


statement ok
CREATE ROLE phr_ao_group;


statement ok
CREATE ROLE phr_ao_member;


statement ok
GRANT phr_ao_group TO phr_ao_member WITH ADMIN OPTION;


query
SELECT pg_has_role('phr_ao_member', 'phr_ao_member', 'USAGE WITH ADMIN OPTION') AS self_admin,
       pg_has_role('phr_ao_member', 'phr_ao_member', 'MEMBER') AS self_member,
       pg_has_role('phr_ao_member', 'phr_ao_group', 'MEMBER WITH ADMIN OPTION') AS admin_of,
       pg_has_role('phr_ao_group', 'phr_ao_member', 'MEMBER WITH ADMIN OPTION') AS reversed_admin,
       pg_has_role('phr_ao_member', 'phr_ao_group', 'SET') AS can_set;
----
self_admin	self_member	admin_of	reversed_admin	can_set
