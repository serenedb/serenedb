query
SELECT has_table_privilege('prr_reader', 'prr_s.prr_t', 'SELECT') AS reader_select,
       has_table_privilege('prr_maint', 'prr_s.prr_t', 'MAINTAIN') AS maint_maintain;
----
reader_select	maint_maintain
t	f


statement ok
GRANT pg_maintain TO prr_maint;


query
