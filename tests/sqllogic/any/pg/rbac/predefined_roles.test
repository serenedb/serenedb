query
SELECT oid, rolname, rolsuper, rolcanlogin, rolinherit
FROM pg_roles
WHERE rolname IN ('pg_checkpoint', 'pg_create_subscription', 'pg_database_owner', 'pg_execute_server_program',
                  'pg_maintain', 'pg_monitor', 'pg_read_all_data', 'pg_read_all_settings', 'pg_read_all_stats',
                  'pg_read_server_files', 'pg_signal_autovacuum_worker', 'pg_signal_backend',
                  'pg_stat_scan_tables', 'pg_use_reserved_connections', 'pg_write_all_data',
                  'pg_write_server_files')
ORDER BY rolname;
----
oid	rolname	rolsuper	rolcanlogin	rolinherit
4544	pg_checkpoint	f	f	t
6304	pg_create_subscription	f	f	t
6171	pg_database_owner	f	f	t
4571	pg_execute_server_program	f	f	t
6337	pg_maintain	f	f	t
3373	pg_monitor	f	f	t
6181	pg_read_all_data	f	f	t
3374	pg_read_all_settings	f	f	t
3375	pg_read_all_stats	f	f	t
4569	pg_read_server_files	f	f	t
6392	pg_signal_autovacuum_worker	f	f	t
4200	pg_signal_backend	f	f	t
3377	pg_stat_scan_tables	f	f	t
4550	pg_use_reserved_connections	f	f	t
6182	pg_write_all_data	f	f	t
4570	pg_write_server_files	f	f	t


query
SELECT pg_has_role('pg_monitor', 'pg_read_all_settings', 'USAGE') AS settings,
       pg_has_role('pg_monitor', 'pg_read_all_stats', 'USAGE') AS stats,
       pg_has_role('pg_monitor', 'pg_stat_scan_tables', 'USAGE') AS scan,
       pg_has_role('pg_monitor', 'pg_read_all_data', 'USAGE') AS data;
----
settings	stats	scan	data
t	t	t	f


