query
SELECT has_table_privilege('prr_reader', 'prr_s.prr_t', 'SELECT') AS can_select,
       has_table_privilege('prr_reader', 'prr_s.prr_t', 'INSERT') AS can_insert,
       has_schema_privilege('prr_reader', 'prr_s', 'USAGE') AS can_use;
