query
SELECT c.relname::text AS relname, c.relowner::regrole::text AS owner
FROM pg_class c
WHERE c.relname IN ('rdo_t', 'rdo_t_a', 'rdo_v', 'rdo_seq', 'rdo_serial', 'rdo_serial_id_seq')
   OR (c.relname = 't2' AND c.relnamespace = 'rdo_s'::regnamespace)
ORDER BY 1;
----
relname	owner
rdo_seq	rdo_bob
rdo_serial	rdo_bob
rdo_serial_id_seq	rdo_bob
rdo_t	rdo_bob
rdo_t_a	rdo_bob
rdo_v	rdo_bob
t2	rdo_bob


