query
SELECT position('rdo_bob=U/postgres' IN (SELECT array_to_string(lanacl, ',') FROM pg_language WHERE lanname = 'sql')) > 0 AS language,
       position('rdo_bob=r/postgres' IN array_to_string(relacl, ',')) > 0 AS relation,
       has_schema_privilege('rdo_bob', 'information_schema', 'CREATE') AS schema,
       position('rdo_bob=X/postgres' IN (SELECT array_to_string(proacl, ',') FROM pg_proc WHERE oid = 'upper(text)'::regprocedure)) > 0 AS function,
       position('rdo_bob=U/postgres' IN (SELECT array_to_string(typacl, ',') FROM pg_type WHERE oid = 'integer'::regtype)) > 0 AS type
FROM pg_class WHERE oid = 'pg_catalog.pg_class'::regclass;
----
language	relation	schema	function	type
t	t	t	t	t


