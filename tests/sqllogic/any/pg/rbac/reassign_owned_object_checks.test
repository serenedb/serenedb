query
SELECT (SELECT pg_get_userbyid(nspowner) FROM pg_namespace WHERE nspname = 'rooc_moved') AS s,
       (SELECT pg_get_userbyid(proowner) FROM pg_proc WHERE proname = 'rooc_g') AS g;
----
s	g
rooc_new	rooc_new


