statement ok
CREATE TABLE rls_ag_loot (id int, owner text, squad text, amount int, weight int, note text, flag bool);


statement ok
INSERT INTO rls_ag_loot SELECT n, CASE n % 3 WHEN 0 THEN 'rls_ag_arelav' WHEN 1 THEN 'rls_ag_babsky' ELSE 'rls_ag_kostya' END, CASE n % 4 WHEN 0 THEN 'clickclack' WHEN 1 THEN 'deadinside' WHEN 2 THEN 'salam' ELSE 'skuf' END, (n * 7) % 50, CASE WHEN n % 5 = 0 THEN NULL ELSE n % 7 END, CASE WHEN n % 3 = 0 THEN ((n * 7) % 50)::text ELSE 'hidden' END, n % 2 = 0 FROM generate_series(1, 60) AS g(n);


statement ok
CREATE TABLE rls_ag_squads (member text, squad text);


statement ok
INSERT INTO rls_ag_squads VALUES ('rls_ag_arelav', 'clickclack'), ('rls_ag_arelav', 'salam'), ('rls_ag_babsky', 'deadinside'), ('rls_ag_kostya', 'skuf');


