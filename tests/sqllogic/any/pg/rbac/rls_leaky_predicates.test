SET ROLE rls_leak_arelav;


query
SELECT count(*) FROM rls_leak_vault WHERE note::int > 0;
----
count
2


query
SELECT count(*) FROM rls_leak_vault WHERE CASE WHEN secret = 42 THEN note::int ELSE 1 END = 1;
----
count
2


query
SELECT count(*) FROM rls_leak_vault WHERE secret + 1 > 0;
----
count
2


query
SELECT count(*) FROM rls_leak_vault v JOIN rls_leak_members m ON m.member = v.holder AND v.note::int > 0;
----
count
2


query
SELECT count(*) FROM rls_leak_members m WHERE EXISTS (SELECT 1 FROM rls_leak_vault v WHERE v.holder = m.member AND v.note::int > 0);
----
count
1


query
SELECT id, note::int AS n FROM rls_leak_vault ORDER BY id;
----
id	n
1	10
3	7


query
SELECT id FROM rls_leak_vault ORDER BY note::int DESC LIMIT 1;
----
id
1


query
SELECT count(*) FROM (SELECT * FROM rls_leak_vault) s WHERE s.note::int > 0;
----
count
2


query
SELECT max(note::int) FROM rls_leak_vault;
----
max
10


