query
SELECT id, (SELECT count(*) FROM rls_sc_audit a WHERE a.staff_id = s.id) AS events FROM rls_sc_staff s ORDER BY id;
----
id	events
3	1
5	1
7	0
9	1


query
SELECT (SELECT max(salary) FROM rls_sc_staff) AS top_salary, (SELECT count(*) FROM rls_sc_audit) AS events, (SELECT count(*) FROM rls_sc_plain) AS plain;
----
top_salary	events	plain
500	3	6


query
