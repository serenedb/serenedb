7
9


query
WITH s AS (SELECT id, boss FROM rls_sc_staff), a AS (SELECT staff_id FROM rls_sc_audit) SELECT s.id FROM s JOIN a ON a.staff_id = s.id ORDER BY s.id;
----
id
3
5
9


query
WITH s AS (SELECT id, salary FROM rls_sc_staff) SELECT x.id AS a, y.id AS b FROM s x JOIN s y ON y.salary > x.salary AND y.id < x.id ORDER BY a, b;
----
a	b
5	3
7	3
7	5
9	3
9	5
9	7


query
WITH RECURSIVE chain(id, depth) AS (SELECT id, 0 FROM rls_sc_staff WHERE name = 'arelav' UNION ALL SELECT s.id, c.depth + 1 FROM rls_sc_staff s JOIN chain c ON s.boss = c.id) SELECT id, depth FROM chain ORDER BY depth, id;
----
id	depth
3	0
5	1
7	2
9	3


query
WITH RECURSIVE up(id, boss, depth) AS (SELECT id, boss, 0 FROM rls_sc_staff WHERE name = 'intern' UNION ALL SELECT s.id, s.boss, u.depth + 1 FROM rls_sc_staff s JOIN up u ON s.id = u.boss) SELECT id, depth FROM up ORDER BY depth;
----
id	depth
9	0
7	1
5	2
3	3


query
WITH RECURSIVE counter(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM counter WHERE n < (SELECT count(*) FROM rls_sc_staff)) SELECT max(n) AS n FROM counter;
----
n
4


