query
SELECT m.squad, t.id, t.points FROM rls_tn_members m CROSS JOIN LATERAL (SELECT b.id, b.points FROM rls_tn_board b WHERE b.squad = m.squad ORDER BY b.points DESC, b.id LIMIT 1) t ORDER BY m.squad, m.member;
----
squad	id	points
clickclack	5	70
deadinside	9	70
salam	11	85
salam	11	85


