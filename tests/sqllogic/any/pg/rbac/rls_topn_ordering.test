CREATE TABLE rls_tn_big (id int, owner text, points int, tag text);


statement ok
INSERT INTO rls_tn_big SELECT n, CASE n % 3 WHEN 0 THEN 'rls_tn_arelav' WHEN 1 THEN 'rls_tn_babsky' ELSE 'rls_tn_kostya' END, (n * 37) % 101, CASE WHEN n % 3 = 0 THEN n::text ELSE 'hidden' || n::text END FROM generate_series(1, 300) AS g(n);


