CREATE VIEW rls_vm_invoker WITH (security_invoker = true) AS SELECT id, author, topic, stars, body FROM rls_vm_notes;


statement ok
CREATE VIEW rls_vm_filtered WITH (security_invoker = true) AS SELECT id, stars FROM rls_vm_notes WHERE stars >= 3;


statement ok
CREATE VIEW rls_vm_joined WITH (security_invoker = true) AS SELECT n.id, n.topic, t.tag FROM rls_vm_notes n JOIN rls_vm_tags t ON t.note_id = n.id;


statement ok
CREATE VIEW rls_vm_summary WITH (security_invoker = true) AS SELECT topic, count(*) AS n, max(stars) AS best FROM rls_vm_notes GROUP BY topic;


