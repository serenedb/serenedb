statement ok
DROP TABLE IF EXISTS rls_wf_scores;


statement ok
DROP ROLE IF EXISTS rls_wf_arelav;


statement ok
DROP ROLE IF EXISTS rls_wf_babsky;


statement ok
CREATE ROLE rls_wf_arelav;


statement ok
CREATE ROLE rls_wf_babsky;


statement ok
CREATE TABLE rls_wf_scores (id int, owner text, team text, round int, score int, note text);


statement ok
INSERT INTO rls_wf_scores SELECT n, CASE WHEN n % 2 = 0 THEN 'rls_wf_arelav' ELSE 'rls_wf_babsky' END, CASE n % 3 WHEN 0 THEN 'clickclack' WHEN 1 THEN 'deadinside' ELSE 'salam' END, (n - 1) / 6 + 1, (n * 13) % 40, CASE WHEN n % 2 = 0 THEN ((n * 13) % 40)::text ELSE 'hidden' END FROM generate_series(1, 24) AS g(n);


statement ok
GRANT SELECT ON rls_wf_scores TO rls_wf_arelav;


statement ok
GRANT SELECT ON rls_wf_scores TO rls_wf_babsky;


statement ok
ALTER TABLE rls_wf_scores ENABLE ROW LEVEL SECURITY;


statement ok
CREATE POLICY rls_wf_own ON rls_wf_scores FOR SELECT USING (owner = current_user);


statement ok
SET ROLE rls_wf_arelav;


