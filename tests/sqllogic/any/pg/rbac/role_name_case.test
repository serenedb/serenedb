rcase_bob	"Rcase_Bob"


query
SELECT 'rcase_bob'::regrole = (SELECT oid FROM pg_roles WHERE rolname = 'rcase_bob') AS lower_ok,
       '"Rcase_Bob"'::regrole = (SELECT oid FROM pg_roles WHERE rolname = 'Rcase_Bob') AS mixed_ok;
----
lower_ok	mixed_ok
t	t


query
SELECT pg_has_role('Rcase_Bob', 'rcase_bob', 'MEMBER') AS mixed_in_lower,
       pg_has_role('rcase_bob', 'Rcase_Bob', 'MEMBER') AS lower_in_mixed;
----
mixed_in_lower	lower_in_mixed
