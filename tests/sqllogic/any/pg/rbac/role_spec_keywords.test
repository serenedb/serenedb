mine
t


statement ok
GRANT SELECT ON rsk_t TO "CURRENT_USER", "session_user";


query
SELECT has_table_privilege('CURRENT_USER', 'rsk_t', 'SELECT') AS upper_name,
       has_table_privilege('session_user', 'rsk_t', 'SELECT') AS lower_name;
----
upper_name	lower_name
t	t


statement ok
GRANT rsk_member TO "CURRENT_USER";


statement ok
CREATE ROLE rsk_group;


statement ok
ALTER GROUP rsk_group ADD USER current_user, "session_user";


statement ok
CREATE ROLE rsk_in IN ROLE "CURRENT_USER" ROLE session_user;


query
SELECT r.rolname AS role, CASE WHEN m.rolname = current_user THEN 'me' ELSE m.rolname END AS member
FROM pg_auth_members a JOIN pg_roles r ON r.oid = a.roleid JOIN pg_roles m ON m.oid = a.member
WHERE r.rolname IN ('CURRENT_USER', 'rsk_group', 'rsk_in', 'rsk_member')
ORDER BY 1, 2;
----
role	member
CURRENT_USER	rsk_in
rsk_group	me
rsk_group	session_user
rsk_in	me
rsk_member	CURRENT_USER


