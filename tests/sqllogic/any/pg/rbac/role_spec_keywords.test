statement ok
ALTER ROLE "CURRENT_USER" IN DATABASE ${__DATABASE__} SET application_name = 'rsk_database';


query
SELECT rolname, rolcreatedb FROM pg_roles WHERE rolname IN ('CURRENT_USER', 'session_user') ORDER BY 1;
----
rolname	rolcreatedb
CURRENT_USER	t
session_user	f


query
SELECT s.setdatabase <> 0 AS in_database, s.setconfig
FROM pg_db_role_setting s JOIN pg_roles r ON r.oid = s.setrole
WHERE r.rolname = 'CURRENT_USER'
ORDER BY 1;
----
in_database	setconfig
f	{application_name=rsk_role}
t	{application_name=rsk_database}


statement ok
ALTER DEFAULT PRIVILEGES FOR ROLE "CURRENT_USER" GRANT SELECT ON TABLES TO rsk_member;


query
SELECT pg_get_userbyid(defaclrole) AS role, defaclobjtype AS type FROM pg_default_acl
WHERE defaclrole = (SELECT oid FROM pg_roles WHERE rolname = 'CURRENT_USER');
----
role	type
CURRENT_USER	r


