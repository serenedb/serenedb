statement ok
ALTER GROUP current_user ADD USER rsk_solo;


query
SELECT m.rolname AS member FROM pg_auth_members a JOIN pg_roles r ON r.oid = a.roleid JOIN pg_roles m ON m.oid = a.member
WHERE r.rolname = current_user AND m.rolname LIKE 'rsk%';
----
member
rsk_solo


