query
SELECT pg_has_role(session_user, 'rspec_bob', 'MEMBER') AS member,
       count(*) FILTER (WHERE m.oid = (SELECT oid FROM pg_roles WHERE rolname = session_user)) AS session_user_edges
FROM pg_auth_members a JOIN pg_roles r ON r.oid = a.roleid JOIN pg_roles m ON m.oid = a.member
WHERE r.rolname = 'rspec_bob';
----
member	session_user_edges
t	1


