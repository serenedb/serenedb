SET ROLE sdcs_caller;


statement ok
SET search_path = sdcs_priv, sdcs_open, public;


query
SELECT current_schema() AS top, public.sdcs_definer() AS definer, public.sdcs_definer_list() AS definer_list,
       public.sdcs_invoker() AS invoker, public.sdcs_fixed() AS fixed, public.sdcs_fixed_list() AS fixed_list;
----
top	definer	definer_list	invoker	fixed	fixed_list
sdcs_priv	sdcs_open	sdcs_open,public	sdcs_priv	sdcs_fixed	sdcs_fixed


query
SELECT public.sdcs_fixed_setting(k) AS settings, current_setting(k) AS session
FROM (VALUES ('search_path')) AS v(k);
----
settings	session
sdcs_fixed;sdcs_fixed	sdcs_priv, sdcs_open, public


