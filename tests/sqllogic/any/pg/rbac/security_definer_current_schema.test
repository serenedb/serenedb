CREATE FUNCTION public.sdcs_definer() RETURNS text LANGUAGE sql SECURITY DEFINER AS 'SELECT current_schema()::text';


statement ok
CREATE FUNCTION public.sdcs_definer_list() RETURNS text LANGUAGE sql SECURITY DEFINER AS 'SELECT array_to_string(current_schemas(false), '','')';


statement ok
CREATE FUNCTION public.sdcs_invoker() RETURNS text LANGUAGE sql AS 'SELECT current_schema()::text';


statement ok
CREATE FUNCTION public.sdcs_fixed() RETURNS text LANGUAGE sql SET search_path = sdcs_fixed AS 'SELECT current_schema()::text';


statement ok
CREATE FUNCTION public.sdcs_fixed_list() RETURNS text LANGUAGE sql SET search_path = sdcs_fixed AS 'SELECT array_to_string(current_schemas(false), '','')';


statement ok
CREATE FUNCTION public.sdcs_fixed_setting(name text) RETURNS text LANGUAGE sql SET search_path = sdcs_fixed AS 'SELECT current_setting(''search_path'') || '';'' || current_setting(name)';


