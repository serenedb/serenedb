CREATE FUNCTION sdl_s.listed_columns() RETURNS text LANGUAGE sql SECURITY DEFINER
AS 'SELECT string_agg(column_name::text, '','' ORDER BY column_name::text) FROM information_schema.columns WHERE table_name::text IN (''sdl_hidden'', ''sdl_shown'')';


statement ok
CREATE FUNCTION sdl_s.invoker_columns() RETURNS text LANGUAGE sql
AS 'SELECT string_agg(column_name::text, '','' ORDER BY column_name::text) FROM information_schema.columns WHERE table_name::text IN (''sdl_hidden'', ''sdl_shown'')';


