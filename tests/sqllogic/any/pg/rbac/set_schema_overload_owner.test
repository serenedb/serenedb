query
SELECT p.proname, n.nspname, r.rolname
FROM pg_proc p
JOIN pg_namespace n ON n.oid = p.pronamespace
JOIN pg_roles r ON r.oid = p.proowner
WHERE p.proname = 'f' AND n.nspname IN ('ssoo_src', 'ssoo_dst')
ORDER BY r.rolname;
----
proname	nspname	rolname
f	ssoo_src	ssoo_alice
f	ssoo_src	ssoo_bob


