statement ok
COMMENT ON DATABASE soc_db IS 'reporting';


statement ok
COMMENT ON ROLE soc_target IS 'a group';


query
SELECT shobj_description(oid, 'pg_database') AS description FROM pg_database WHERE datname = 'soc_db';
----
description
reporting


query
SELECT shobj_description(oid, 'pg_authid') AS description FROM pg_roles WHERE rolname = 'soc_target';
----
description
a group


query
SELECT shobj_description(oid, 'pg_database') IS NULL AS other_catalog FROM pg_roles WHERE rolname = 'soc_target';
----
other_catalog
t


query
SELECT d.description
FROM pg_shdescription d
JOIN pg_roles r ON r.oid = d.objoid
WHERE d.classoid = 'pg_authid'::regclass AND r.rolname = 'soc_target';
----
description
a group


connection c_owner user=soc_owner password=soc_pw
statement ok
