----
db error: ERROR: permission denied
DETAIL: The current user must have the CREATEROLE attribute.


connection c_admin user=soc_admin password=soc_pw
statement ok
COMMENT ON ROLE soc_target IS 'administered';


connection c_admin user=soc_admin password=soc_pw
statement error
