acl
postgres=UC/postgres,=U/postgres,ssg_reader=U/postgres


query
SELECT has_schema_privilege('ssg_reader', 'pg_catalog', 'USAGE') AS usage,
       has_schema_privilege('ssg_reader', 'pg_catalog', 'CREATE') AS create;
----
usage	create
t	f


query
SELECT refobjid::regrole::text AS role, deptype
FROM pg_shdepend
WHERE classid = 'pg_namespace'::regclass AND objid = (SELECT oid FROM pg_namespace WHERE nspname = 'pg_catalog')
  AND dbid = (SELECT oid FROM pg_database WHERE datname = current_database());
----
role	deptype
ssg_reader	a


