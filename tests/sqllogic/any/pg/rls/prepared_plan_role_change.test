# Oracle-verified against PostgreSQL 18.3: a prepared statement must not carry a
# row-level-security decision made for the role that prepared it. Both which
# policies apply (TO-role membership) and whether the role bypasses RLS at all are
# role-dependent, so a plan prepared by one role and executed by another must be
# re-evaluated.
#
# Regression: the decision was baked into the bound plan and the plan was reused
# across SET ROLE. Because a bypassing role's plan carries NO filter at all, two
# statements disabled RLS outright:
#     PREPARE q AS SELECT ...;   -- as the table owner: bypasses, no filter emitted
#     SET ROLE restricted;
#     EXECUTE q;                 -- ran the unfiltered plan -> every row visible
#
# Lore: the mop cannot inherit vedernikoff's view of the clickclack ledger just by
# reusing his prepared query.

statement ok
DROP TABLE IF EXISTS ppr_ledger;


statement ok
DROP ROLE IF EXISTS ppr_mop;


statement ok
CREATE TABLE ppr_ledger (owner text, v int);


statement ok
INSERT INTO ppr_ledger VALUES ('vedernikoff', 1), ('ppr_mop', 2), ('clickclack', 3);


statement ok
CREATE ROLE ppr_mop;


statement ok
GRANT SELECT ON ppr_ledger TO ppr_mop;


statement ok
ALTER TABLE ppr_ledger ENABLE ROW LEVEL SECURITY;


statement ok
CREATE POLICY p_self ON ppr_ledger FOR SELECT USING (owner = current_user);


# Prepared by the table owner, who bypasses RLS: this plan sees everything.
statement ok
PREPARE ppr_q AS SELECT owner FROM ppr_ledger ORDER BY owner;


query T
EXECUTE ppr_q;
----
owner
clickclack
ppr_mop
vedernikoff


# Executing the SAME prepared statement as a restricted role must re-evaluate RLS.
statement ok
SET ROLE ppr_mop;


query T
EXECUTE ppr_q;
----
owner
ppr_mop


# ...and back to the owner, the bypass applies again.
statement ok
RESET ROLE;


query T
EXECUTE ppr_q;
----
owner
clickclack
ppr_mop
vedernikoff


statement ok
DEALLOCATE ppr_q;


statement ok
DROP TABLE ppr_ledger;


statement ok
DROP ROLE ppr_mop;
