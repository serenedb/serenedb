# BIT wire round-trip.
#
# Regression for the binary (extended-protocol) bit wire format: PG sends the
# bits MSB-first, left-aligned, with trailing pad in the last byte. Sub-byte and
# multi-byte values must render identically in pg-wire-simple (text) and
# pg-wire-extended (binary), and identically on PostgreSQL and SereneDB.

# sub-byte (the failing case: BIT(3) '101' -> byte 0xA0)
query
SELECT '101'::BIT(3) AS b
----
b
101

# exactly one byte
query
SELECT '10110011'::BIT(8) AS b
----
b
10110011

# spans two bytes (exercises left-alignment across a byte boundary)
query
SELECT '1011001110'::BIT(10) AS b
----
b
1011001110

# odd two-byte width (11 bits, 5 trailing pad)
query
SELECT '11001010111'::BIT(11) AS b
----
b
11001010111

# all ones / all zeros at a sub-byte width
query
SELECT '111'::BIT(3) AS ones, '000'::BIT(3) AS zeros
----
ones	zeros
111	000


# stored round-trip (value flows through the result serializer per row)
statement ok
CREATE TABLE bit_rt (id INT PRIMARY KEY, b BIT(10))


statement count 3
INSERT INTO bit_rt VALUES
  (1, '0000000001'::BIT(10)),
  (2, '1011001110'::BIT(10)),
  (3, '1111111111'::BIT(10))


query
SELECT id, b FROM bit_rt ORDER BY id
----
id	b
1	0000000001
2	1011001110
3	1111111111


query
SELECT B'1010' # B'0110' AS bit_xor, 5 # 3 AS int_xor, (-1)::bigint # 1 AS bigint_xor,
       position(B'01' IN B'1010') AS pos, position(B'11' IN B'1010') AS pos_missing,
       position(B'011' IN B'0011') AS pos_overlap;
----
bit_xor	int_xor	bigint_xor	pos	pos_missing	pos_overlap
1100	6	-2	2	0	2


query
SELECT substring(B'101010' FROM 2 FOR 3) AS sub, substring(B'101010' FROM 3) AS sub_tail,
       substring(B'101010' FROM 0 FOR 3) AS sub_zero, substring(B'101010' FROM -2 FOR 4) AS sub_before;
----
sub	sub_tail	sub_zero	sub_before
010	1010	10	1


query
SELECT overlay(B'1010' PLACING B'11' FROM 2) AS ov, overlay(B'101010' PLACING B'0' FROM 2 FOR 3) AS ov_for,
       overlay(B'1010' PLACING B'11' FROM 4) AS ov_end, overlay(B'1010' PLACING B'11' FROM 3 FOR -1) AS ov_back,
       B'10' || B'011' AS cat, pg_typeof(B'10' || B'011') AS cat_type;
----
ov	ov_for	ov_end	ov_back	cat	cat_type
1110	1010	10111	1011010	10011	bit varying


statement error (cannot XOR bit strings of different sizes|Cannot XOR bit strings of different sizes)
SELECT B'10' # B'011';


statement error
SELECT substring(B'1010' FROM 1 FOR -1);
----
db error: ERROR: negative substring length not allowed


statement error
SELECT overlay(B'1010' PLACING B'11' FROM 0);
----
db error: ERROR: negative substring length not allowed
