query
SELECT
    overlay('\x0102030405'::bytea PLACING '\xff'::bytea FROM 2) AS replaced,
    overlay('\x0102030405'::bytea PLACING '\xffee'::bytea FROM 2 FOR 1) AS grown,
    overlay('\x0102030405'::bytea PLACING '\xff'::bytea FROM 2 FOR 0) AS inserted,
    overlay('\x0102030405'::bytea PLACING '\xff'::bytea FROM 9) AS appended,
    overlay('\x010203'::bytea PLACING '\xff'::bytea FROM 2 FOR -1) AS overlapping;
----
replaced	grown	inserted	appended	overlapping
\\x01ff030405	\\x01ffee030405	\\x01ff02030405	\\x0102030405ff	\\x01ff010203


statement error
