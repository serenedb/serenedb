query
SELECT bit_length('\x010203'::bytea) AS bits, bit_length(''::bytea) AS empty;
----
bits	empty
24	0


query
SELECT
    substring('\x0102030405'::bytea FROM 2 FOR 2) AS middle,
    substring('\x0102030405'::bytea FROM 2) AS rest,
    substring('\x0102030405'::bytea FROM 0 FOR 2) AS before_start,
    substring('\x0102030405'::bytea FROM -1 FOR 2) AS ends_at_start,
    substring('\x0102030405'::bytea FROM 9) AS past_end,
    substring('\x0102'::bytea FROM 2 FOR 2147483647) AS long_length;
----
middle	rest	before_start	ends_at_start	past_end	long_length
\\x0203	\\x02030405	\\x01	\\x	\\x	\\x02


query
SELECT
    substring('\x0102'::bytea FROM -5 FOR 2) AS ends_before_start,
    overlay('\x0102'::bytea PLACING '\xff'::bytea FROM 1 FOR NULL) AS null_length;
----
ends_before_start	null_length
\\x	NULL


