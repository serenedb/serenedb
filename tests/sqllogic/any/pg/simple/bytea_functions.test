query
SELECT
    ltrim('\x00000102'::bytea, '\x00'::bytea) AS left_trimmed,
    rtrim('\x01020000'::bytea, '\x00'::bytea) AS right_trimmed,
    btrim('\x00010200'::bytea, '\x00'::bytea) AS both_trimmed,
    ltrim('\x0000'::bytea, '\x00'::bytea) AS all_trimmed,
    rtrim('\x0102'::bytea, ''::bytea) AS empty_set;
----
left_trimmed	right_trimmed	both_trimmed	all_trimmed	empty_set
\\x0102	\\x0102	\\x0102	\\x	\\x0102


query
SELECT
    trim('\x00'::bytea FROM '\x00010200'::bytea) AS both_default,
    trim(BOTH '\x00'::bytea FROM '\x00010200'::bytea) AS both_trimmed,
    trim(LEADING '\x00'::bytea FROM '\x00010200'::bytea) AS leading_trimmed,
    trim(TRAILING '\x00'::bytea FROM '\x00010200'::bytea) AS trailing_trimmed;
----
both_default	both_trimmed	leading_trimmed	trailing_trimmed
\\x0102	\\x0102	\\x010200	\\x000102


query
SELECT
    substring(b FROM 2 FOR 2) AS middle,
    overlay(b PLACING '\xff'::bytea FROM 1) AS replaced,
    ltrim(b, '\x01'::bytea) AS trimmed,
    bit_length(b) AS bits
FROM (VALUES ('\x0102030405060708090a0b0c0d0e0f'::bytea), (NULL::bytea)) AS t(b)
ORDER BY bits;
----
middle	replaced	trimmed	bits
\\x0203	\\xff02030405060708090a0b0c0d0e0f	\\x02030405060708090a0b0c0d0e0f	120
NULL	NULL	NULL	NULL

query
SELECT '\x01'::bytea || 'abc' AS appended, 'abc' || '\x01'::bytea AS prepended,
       pg_typeof('\x01'::bytea || 'abc') AS t;
----
appended	prepended	t
\\x01616263	\\x61626301	bytea
