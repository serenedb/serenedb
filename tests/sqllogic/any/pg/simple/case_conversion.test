lowered
grüße aus köln


statement ok
CREATE TABLE case_mixed AS
SELECT g.i AS id, a.s || repeat(chr(65 + g.i % 26), g.i % 19) || ' ' || b.s || g.i AS s
FROM generate_series(1, 2000) AS g(i)
JOIN case_strings a ON a.id = 1 + g.i % 32
JOIN case_strings b ON b.id = 1 + (g.i * 7) % 32


query
SELECT md5(string_agg(lower(s), '|' ORDER BY id)) AS lowered, count(*) AS strings FROM case_mixed
----
lowered	strings
d85a6bd09255f0753f7b9cc67a4fc54f	2000


query
SELECT md5(string_agg(upper(s), '|' ORDER BY id)) AS uppered, count(*) AS strings FROM case_mixed WHERE strpos(s, 'ß') = 0
----
uppered	strings
f8d1512f8607973cc80c6d9187f38b25	1938


query
SELECT count(*) FILTER (WHERE s ILIKE '%köln%') AS koln,
       count(*) FILTER (WHERE s ILIKE '%МИР%') AS mir,
       count(*) FILTER (WHERE s ILIKE '%ÉCOLE%') AS ecole,
       count(*) FILTER (WHERE s ILIKE '%istanbul%') AS istanbul,
       count(*) FILTER (WHERE s ILIKE '%ｆｕｌｌ%') AS fullwidth,
       count(*) FILTER (WHERE s ILIKE '%σίσυφοσ%') AS sisyphus,
       count(*) FILTER (WHERE s ILIKE '%ⱦ%') AS t_stroke,
       count(*) FILTER (WHERE s ILIKE '%' || lower(substr(s, 3, 4)) || '%') AS own_substring
FROM case_mixed
----
koln	mir	ecole	istanbul	fullwidth	sisyphus	t_stroke	own_substring
62	126	126	125	126	125	312	2000
