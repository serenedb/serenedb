query
SELECT 'abc'::"char" AS first, ''::"char" AS empty, '\101'::"char" AS octal, '\0'::"char" AS short_escape;
----
first	empty	octal	short_escape
a	(empty)	A	\\


query
SELECT 'é'::"char" AS high, '\377'::"char" AS high_octal;
----
high	high_octal
\\303	\\377


query
SELECT 'abc'::"char"::text AS as_text, length('xyz'::"char"::text) AS len;
----
as_text	len
a	1


query
SELECT '\101'::text::"char" AS octal_text, 'é'::text::"char" AS high_text, ''::text::"char" AS empty_text, 65::"char" AS from_int, 'A'::"char"::int AS to_int, 'é'::"char"::int AS high_int;
----
octal_text	high_text	empty_text	from_int	to_int	high_int
A	\\303	(empty)	A	65	-61


statement error
SELECT 200::"char";
----
db error: ERROR: "char" out of range<slt:ignore>


query
SELECT 'b'::"char" > 'a'::"char" AS gt, ''::"char" < 'a'::"char" AS empty_first, '\303'::"char" = 'é'::"char" AS same_byte;
----
gt	empty_first	same_byte
t	t	t


statement ok
CREATE TABLE char_type_t (id INT, c "char");


statement ok
