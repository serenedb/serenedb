       set_masklen('10.0.0.0/8'::cidr, -1) AS full, pg_typeof(set_masklen('10.0.0.0/8'::cidr, 16))::text AS t
----
v4	v6	full	t
192.168.0.0/16	2001:db8::/32	10.0.0.0/32	cidr


