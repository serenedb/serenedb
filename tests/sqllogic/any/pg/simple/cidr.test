query
SELECT pg_typeof('10.0.0.0/8'::cidr) AS cidr_type,
       pg_typeof('portal_1'::refcursor) AS refcursor_type,
       'portal_1'::refcursor AS portal, 'portal_1'::refcursor::text AS portal_text
----
cidr_type	refcursor_type	portal	portal_text
cidr	refcursor	portal_1	portal_1


statement ok
DROP TABLE IF EXISTS cidr_refcursor


statement ok
CREATE TABLE cidr_refcursor (net cidr, cur refcursor)


statement ok
INSERT INTO cidr_refcursor VALUES ('10.0.0.0/8', 'c1'), ('2001:db8::/32', 'c2'), (NULL, NULL)


query
SELECT net, cur FROM cidr_refcursor ORDER BY net
----
net	cur
10.0.0.0/8	c1
2001:db8::/32	c2
NULL	NULL


query
SELECT attname, format_type(atttypid, atttypmod) AS type
FROM pg_attribute
WHERE attrelid = 'cidr_refcursor'::regclass AND attnum > 0
ORDER BY attnum
----
attname	type
net	cidr
cur	refcursor


statement ok
DROP TABLE cidr_refcursor


query
SELECT abbrev('10.1.0.0/16'::cidr) AS a, abbrev('192.168.0.0/24'::cidr) AS b,
       abbrev('10.0.0.0/8'::cidr) AS c, abbrev('0.0.0.0/0'::cidr) AS d,
       abbrev('172.16.0.0/12'::cidr) AS e, abbrev('10.1.2.3/32'::cidr) AS f,
       abbrev('192.168.1.128/25'::cidr) AS g
----
a	b	c	d	e	f	g
10.1/16	192.168.0/24	10/8	0/0	172.16/12	10.1.2.3/32	192.168.1.128/25


query
SELECT abbrev('2001:db8::/32'::cidr) AS a, abbrev('::/0'::cidr) AS b,
       abbrev('2001:db8:0:1::/64'::cidr) AS c, abbrev('::ffff:1.2.3.0/120'::cidr) AS d,
       abbrev('::1.2.3.4/128'::cidr) AS e, abbrev('fe80::/10'::cidr) AS f,
       abbrev('ff00::/8'::cidr) AS g
----
