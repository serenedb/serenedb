query
SELECT '10.0.0.0/8'::cidr AS v4, '10.1.2.3/32'::cidr AS host,
       '2001:db8::/32'::cidr AS v6, '::1/128'::cidr AS v6_host
----
v4	host	v6	v6_host
10.0.0.0/8	10.1.2.3/32	2001:db8::/32	::1/128


query
