CREATE TABLE cbb_dst (id INTEGER, b BYTEA);


statement count 4
COPY cbb_dst FROM '${__TEST_DIR__}/copy_binary_bytea.bin' (FORMAT binary);


query
SELECT id, octet_length(b) AS len, encode(b, 'hex') AS hex FROM cbb_dst ORDER BY id;
----
id	len	hex
1	1	41
2	20	000102030405060708090a0b0c0d0e0f10111213
3	0	(empty)
4	NULL	NULL


statement ok
CREATE TABLE cbb_many_src (id INTEGER, b BYTEA);


statement ok
INSERT INTO cbb_many_src SELECT i, decode(substr(repeat(md5(i::text), 7), 1, 2 * (i % 100 + 1)), 'hex') FROM generate_series(0, 19999) AS t(i);


statement count 20000
COPY cbb_many_src TO '${__TEST_DIR__}/copy_binary_bytea_many.bin' (FORMAT binary);


statement ok
CREATE TABLE cbb_many_dst (id INTEGER, b BYTEA);


statement count 20000
COPY cbb_many_dst FROM '${__TEST_DIR__}/copy_binary_bytea_many.bin' (FORMAT binary);


query
SELECT count(*) AS n, sum(octet_length(d.b)) AS bytes, count(*) FILTER (WHERE d.b IS DISTINCT FROM s.b) AS mismatched FROM cbb_many_src s JOIN cbb_many_dst d USING (id);
----
n	bytes	mismatched
20000	1010000	0


