CREATE TABLE cbb_src (id INTEGER, b BYTEA);


statement ok
INSERT INTO cbb_src VALUES (1, '\x41'::BYTEA), (2, '\x000102030405060708090a0b0c0d0e0f10111213'::BYTEA), (3, ''::BYTEA), (4, NULL);


