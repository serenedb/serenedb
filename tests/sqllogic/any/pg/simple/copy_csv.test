statement ok
INSERT INTO ccsv_src VALUES
  (1, true, 'plain', '{x,y}', '{"k": 1}', '2024-01-02', 1.5, 1.5),
  (2, false, 'with,comma', '{"a b","c,d",NULL}', '[1,"x"]', '2024-12-31', -2.25, -0.1),
  (3, NULL, 'quote"in', NULL, NULL, NULL, NULL, NULL),
  (4, true, '', '{}', 'null', '0001-01-01', 0, 1e20),
  (5, false, E'two\nlines', '{}', '"s"', '2024-02-29', 123.45, 'NaN'),
  (6, true, '\.', '{"\\"}', '{}', '2024-03-01', 1, 'Infinity');


