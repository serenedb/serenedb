control substitution on

statement ok
CREATE TABLE cdm (id INTEGER, b TEXT DEFAULT 'dflt', c INTEGER DEFAULT 7, d TEXT);


statement count 4
COPY (SELECT * FROM (VALUES ('1,D,D,x'), ('2,"D",3,y'), ('3,,D,D2'), ('4,x,,z')) v(l))
TO '${__TEST_DIR__}/cdm.csv' (FORMAT csv, DELIMITER E'\x02', QUOTE E'\x01');


statement count 4
COPY cdm FROM '${__TEST_DIR__}/cdm.csv' (FORMAT csv, DEFAULT 'D');


query
SELECT id, b, c, d FROM cdm ORDER BY id;
----
id	b	c	d
1	dflt	7	x
2	D	3	y
3	NULL	7	D2
4	x	NULL	z


statement count 2
COPY (SELECT * FROM (VALUES ('5	D	D	x'), ('6	\D	8	\N')) v(l))
TO '${__TEST_DIR__}/cdm.txt' (FORMAT csv, DELIMITER E'\x02', QUOTE E'\x01');


statement count 2
COPY cdm FROM '${__TEST_DIR__}/cdm.txt' (DEFAULT 'D');


query
SELECT id, b, c, d FROM cdm WHERE id > 4 ORDER BY id;
----
id	b	c	d
5	dflt	7	x
6	D	8	NULL


