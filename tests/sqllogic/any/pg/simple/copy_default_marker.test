statement count 130
COPY (SELECT CASE WHEN g <= 70 THEN 'x' ELSE (g + 100)::TEXT END || chr(9) || 'D' || chr(9) ||
             CASE WHEN g % 2 = 0 THEN 'D' ELSE '5' END || chr(9) || 'z' AS l
      FROM generate_series(1, 130) g)
TO '${__TEST_DIR__}/cdm_ignore.txt' (FORMAT csv, DELIMITER E'\x02', QUOTE E'\x01');


statement count 60
COPY cdm FROM '${__TEST_DIR__}/cdm_ignore.txt' (DEFAULT 'D', ON_ERROR IGNORE);


