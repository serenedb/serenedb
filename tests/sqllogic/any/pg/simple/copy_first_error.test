statement count 262144
COPY (
  SELECT CASE WHEN i = 65530 THEN 'xxxxxxx' ELSE lpad(i::text, 7, '0') END || ','
      || CASE WHEN i = 65540 THEN 'D' ELSE 'abcdefg' END
  FROM generate_series(0, 262143) AS s(i)
  ORDER BY i
) TO '${__TEST_DIR__}/cfe_ranges.csv' (FORMAT csv, DELIMITER E'\x02', QUOTE E'\x01');


statement count 262144
COPY (
  SELECT CASE WHEN i = 65530 THEN 'xxxxxxx' ELSE lpad(i::text, 7, '0') END || E'\t'
      || CASE WHEN i = 65540 THEN 'D' ELSE 'abcdefg' END
  FROM generate_series(0, 262143) AS s(i)
  ORDER BY i
) TO '${__TEST_DIR__}/cfe_ranges.txt' (FORMAT csv, DELIMITER E'\x02', QUOTE E'\x01');


