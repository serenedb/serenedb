CREATE TABLE ctb_many_src (id INTEGER, b BYTEA);


statement ok
INSERT INTO ctb_many_src SELECT i, decode(substr(repeat(md5(i::text), 7), 1, 2 * (i % 100 + 1)), 'hex') FROM generate_series(0, 19999) AS t(i);


statement count 20000
COPY ctb_many_src TO '${__TEST_DIR__}/copy_text_bytea_many.txt' (FORMAT text);


statement ok
CREATE TABLE ctb_many_dst (id INTEGER, b BYTEA);


statement count 20000
COPY ctb_many_dst FROM '${__TEST_DIR__}/copy_text_bytea_many.txt' (FORMAT text);


query
SELECT count(*) AS n, sum(octet_length(d.b)) AS bytes, count(*) FILTER (WHERE d.b IS DISTINCT FROM s.b) AS mismatched FROM ctb_many_src s JOIN ctb_many_dst d USING (id);
----
n	bytes	mismatched
20000	1010000	0


