CREATE TABLE ctb_many_text (id INTEGER, v VARCHAR);


statement ok
INSERT INTO ctb_many_text SELECT i, CASE WHEN i % 2 = 0 THEN repeat(chr((97 + i % 26)::int), i % 100 + 1) ELSE repeat(chr((97 + i % 26)::int), i % 50 + 1) || repeat('\001', i % 50 + 1) END FROM generate_series(0, 19999) AS t(i);


statement count 20000
COPY ctb_many_text TO '${__TEST_DIR__}/copy_text_bytea_many_text.txt' (FORMAT text);


statement ok
CREATE TABLE ctb_many_plain (id INTEGER, b BYTEA);


statement count 20000
COPY ctb_many_plain FROM '${__TEST_DIR__}/copy_text_bytea_many_text.txt' (FORMAT text);


query
SELECT count(*) AS n, sum(octet_length(p.b)) AS bytes, count(*) FILTER (WHERE p.b IS DISTINCT FROM t.v::bytea) AS mismatched FROM ctb_many_text t JOIN ctb_many_plain p USING (id);
----
n	bytes	mismatched
20000	1020000	0


