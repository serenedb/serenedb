control substitution on

statement ok
SET TimeZone = 'UTC';

statement ok
CREATE TABLE ctd
(
  id     INTEGER,
  i      INTEGER,
  n      NUMERIC(10, 2),
  f      FLOAT8,
  d      DATE,
  t      TIME,
  ttz    TIMETZ,
  ts     TIMESTAMP,
  tstz   TIMESTAMPTZ,
  u      UUID,
  s      TEXT,
  arr    INTEGER[],
  sarr   TEXT[],
  r      INT4RANGE,
  mac    MACADDR,
  ip     INET,
  ip6    INET,
  lsn    PG_LSN,
  pt     POINT,
  bx     BOX,
  m      MONEY,
  ctid_v TID,
  mr     INT4MULTIRANGE,
  iv     INTERVAL
);

statement ok
CREATE TABLE ctd_in AS SELECT * FROM ctd WHERE false;

statement ok
CREATE TABLE ctd_raw(line TEXT);

statement ok
INSERT INTO ctd VALUES (1, -5, -12.50, -1.5, '2024-01-15', '12:30:45',
  '12:30:45+05:30', '2024-01-15 12:00:00', '2024-01-15 12:00:00+00',
  'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 'a:b-c,d e{f}"g"(h)+N',
  ARRAY[-1, 2, NULL], ARRAY['x y', 'p"q', 'NULL', NULL], '[1,5)',
  '08:00:2b:01:02:03', '192.168.1.5/24', '2001:db8::1', '16/B374D848',
  '(1.5,-2)', '(3,4),(1,2)', '-1234.5', '(1,2)', '{[1,3),[5,7)}',
  '1 day 02:03:04');

statement ok
COPY ctd TO '${__TEST_DIR__}/ctd_colon.txt' (FORMAT text, DELIMITER ':');

statement ok
