query
SELECT count(*) AS different
FROM (
  SELECT id, i, n, f, d, t, ttz, ts, tstz, u, s, arr, sarr, r, mac, ip, ip6,
         lsn, pt::TEXT, bx::TEXT, m, ctid_v, mr, iv
  FROM ctd_in
  EXCEPT
  SELECT id, i, n, f, d, t, ttz, ts, tstz, u, s, arr, sarr, r, mac, ip, ip6,
         lsn, pt::TEXT, bx::TEXT, m, ctid_v, mr, iv
  FROM ctd
) diff;
----
different
0

statement ok
SET bytea_output = 'escape';

statement ok
CREATE VIEW ctd_more AS
SELECT '\x613a28bc2c'::BYTEA AS b,
       'NaN'::FLOAT8 AS nan, 'Infinity'::FLOAT4 AS inf,
       '-Infinity'::FLOAT8 AS ninf, '1e+20'::FLOAT8 AS big,
       '<(1,2),3>'::CIRCLE AS c, ARRAY[[1, -2], [3, NULL]] AS md,
       '[(1,2),(3,4)]'::PATH AS p, '{1,-2,3}'::LINE AS l;

statement ok
COPY (SELECT ROW(1, 'a b', NULL, ARRAY[1, 2]), * FROM ctd_more) TO '${__TEST_DIR__}/ctd_more_paren.txt' (FORMAT text, DELIMITER '(', NULL 'nul');

