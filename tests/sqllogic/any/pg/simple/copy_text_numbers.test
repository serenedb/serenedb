9223372036854775807


statement ok
CREATE TABLE ctn_float_lines (l TEXT);


statement ok
INSERT INTO ctn_float_lines VALUES ('0'), ('-0'), ('1.5'), ('-21168.23'), ('0.1'), ('123456789012345'), ('1234567890123456.7'), ('1e3'), ('.5'), ('5.'), (' 2.5 '), ('+3.25'), ('NaN'), ('-Infinity');


statement count 14
COPY ctn_float_lines TO '${__TEST_DIR__}/ctn_floats.txt' (FORMAT text);


statement ok
CREATE TABLE ctn_float8 (v DOUBLE PRECISION);


statement count 14
COPY ctn_float8 FROM '${__TEST_DIR__}/ctn_floats.txt' (FORMAT text);


query
SELECT v::text AS t FROM ctn_float8 WHERE v < 1e14 OR v = 'NaN' ORDER BY v, t;
----
t
-Infinity
-21168.23
-0
0
0.1
0.5
1.5
2.5
3.25
5
1000
NaN


query
SELECT count(*) FILTER (WHERE v = 123456789012345), count(*) FILTER (WHERE v = 1234567890123456.7::float8) FROM ctn_float8;
----
count	count
1	1
