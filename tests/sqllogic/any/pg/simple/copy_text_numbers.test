control substitution on

statement ok
CREATE TABLE ctn_lines (l TEXT);


statement ok
INSERT INTO ctn_lines VALUES ('0'), ('-0'), ('7'), ('-7'), ('+7'), ('007'), (' 42 '), ('32767'), ('-32768'), ('12345678');


statement count 10
COPY ctn_lines TO '${__TEST_DIR__}/ctn_ints.txt' (FORMAT text);


