statement count 3010
COPY (SELECT CASE WHEN g <= 3000 THEN 'bad' ELSE g::TEXT END FROM generate_series(1, 3010) g)
TO '${__TEST_DIR__}/cto_many.txt.gz' (FORMAT text);


statement count 10
COPY cto_many FROM '${__TEST_DIR__}/cto_many.txt.gz' (FORMAT text, ON_ERROR IGNORE);


query
SELECT count(*) AS n, min(a) AS lo, max(a) AS hi FROM cto_many;
