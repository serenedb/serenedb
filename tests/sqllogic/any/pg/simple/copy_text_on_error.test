statement count 2
COPY (SELECT * FROM (VALUES ('7', 'seven'), ('y', 'bad')) v(a, b))
TO '${__TEST_DIR__}/cto_header.txt' (FORMAT text, HEADER);


statement count 1
COPY cto_ints FROM '${__TEST_DIR__}/cto_header.txt' (FORMAT text, HEADER, ON_ERROR IGNORE, REJECT_LIMIT 1);


query
SELECT a, b FROM cto_ints WHERE a > 5;
----
a	b
7	seven


statement ok
CREATE TABLE cto_nest (id INTEGER, a INTEGER[], n INTEGER);


statement count 7
COPY (SELECT * FROM (VALUES
  ('1', '{1,2}', '10'),
  ('2', '{NULL,NULL}', 'bad'),
  ('3', '{8,9}', '30'),
  ('4', NULL, 'x'),
  ('5', '{5,NULL}', '50'),
  ('x', '{6}', '60'),
  ('7', '{7,z}', '70')) v(id, a, n))
TO '${__TEST_DIR__}/cto_nest.txt' (FORMAT text);


statement count 3
COPY cto_nest FROM '${__TEST_DIR__}/cto_nest.txt' (FORMAT text, ON_ERROR IGNORE);


query
SELECT id, a, n FROM cto_nest ORDER BY id;
----
id	a	n
1	{1,2}	10
3	{8,9}	30
5	{5,NULL}	50


statement ok
CREATE TABLE cto_many (a INTEGER);


statement count 3010
COPY (SELECT CASE WHEN g <= 3000 THEN 'bad' ELSE g::TEXT END FROM generate_series(1, 3010) g)
TO '${__TEST_DIR__}/cto_many.txt' (FORMAT text);


statement count 10
COPY cto_many FROM '${__TEST_DIR__}/cto_many.txt' (FORMAT text, ON_ERROR IGNORE, REJECT_LIMIT 3000);


statement error skipped more than REJECT_LIMIT \(2999\) rows due to data type incompatibility
