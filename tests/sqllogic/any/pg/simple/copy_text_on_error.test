control substitution on

statement ok
CREATE TABLE cto_ints (a INTEGER, b TEXT);


statement count 5
COPY (SELECT * FROM (VALUES ('1', 'one'), ('x', 'bad'), ('3', 'three'), ('4.5', 'bad'), ('5', 'five')) v(a, b))
TO '${__TEST_DIR__}/cto_mixed.txt' (FORMAT text);


statement count 3
COPY cto_ints FROM '${__TEST_DIR__}/cto_mixed.txt' (FORMAT text, ON_ERROR IGNORE);


query
SELECT a, b FROM cto_ints ORDER BY a;
----
a	b
1	one
3	three
5	five


statement count 3
COPY cto_ints FROM '${__TEST_DIR__}/cto_mixed.txt' (FORMAT text, ON_ERROR IGNORE, REJECT_LIMIT 2);


