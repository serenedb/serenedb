query
SELECT DATE '2015-05-19',
  DATE '1997-09-12'
----
date	date
2015-05-19	1997-09-12


query
SELECT TIMESTAMP '1999-12-31 23:59:59' as new_year,
  TIMESTAMP '2004-04-15 05:16:20'
----
new_year	timestamp
1999-12-31 23:59:59	2004-04-15 05:16:20


query
SELECT date_trunc('day', TIMESTAMP '2024-03-15 14:30:00');
----
date_trunc
2024-03-15 00:00:00


query
SELECT date_trunc('month', TIMESTAMP '2024-03-15 14:30:00');
----
date_trunc
2024-03-01 00:00:00


query
SELECT date_trunc('year', TIMESTAMP '2024-03-15 14:30:00');
----
date_trunc
2024-01-01 00:00:00


query
SELECT date_trunc('hour', TIMESTAMP '2024-03-15 14:30:45');
----
date_trunc
2024-03-15 14:00:00


statement ok
SET TimeZone = 'UTC'


skipif pg-wire-extended
query
SELECT DATE '0001-01-01' - 1 AS d1, DATE '0001-01-01' - 400 AS d2, TIMESTAMP '0001-01-01 00:00:00' - INTERVAL '1 day' AS ts,
       TIMESTAMPTZ '0001-01-01 00:00:00+00' - INTERVAL '1 day' AS tstz;
----
d1	d2	ts	tstz
0001-12-31 BC	0002-11-28 BC	0001-12-31 00:00:00 BC	0001-12-31 00:00:00+00 BC


skipif pg-wire-extended
query
SELECT ARRAY[DATE '0001-01-01' - 1, DATE '2020-01-01'] AS arr, ROW(DATE '0001-01-01' - 1, 1) AS rec,
       ARRAY[TIMESTAMP '0001-01-01 00:00:00' - INTERVAL '1 day'] AS ts_arr;
----
arr	rec	ts_arr
{"0001-12-31 BC",2020-01-01}	("0001-12-31 BC",1)	{"0001-12-31 00:00:00 BC"}


skipif pg-wire-extended
query
SELECT ARRAY[ROW(DATE '0001-01-01' - 1)] AS rec_arr, ROW(ARRAY[DATE '0001-01-01' - 1]) AS arr_rec;
----
rec_arr	arr_rec
{"(\\"0001-12-31 BC\\")"}	("{""0001-12-31 BC""}")


statement ok
RESET TimeZone
