# Tests for additional date/time functions


# make_date

query
SELECT make_date(2013, 7, 15);
----
make_date
2013-07-15


query
SELECT make_date(2000, 1, 1);
----
make_date
2000-01-01


# make_timestamp

query
SELECT make_timestamp(2013, 7, 15, 8, 15, 23.5);
----
make_timestamp
2013-07-15 08:15:23.5<slt:ignore>


query
SELECT make_timestamp(2000, 1, 1, 0, 0, 0);
----
make_timestamp
2000-01-01 00:00:00


# to_timestamp (from unix epoch)

query
SELECT to_timestamp(0);
----
to_timestamp
1970-01-01 00:00:00<slt:ignore>


query
SELECT to_timestamp(1284352323);
----
to_timestamp
2010-09-13 04:32:03<slt:ignore>


# isfinite

query
SELECT isfinite(date '2001-02-16');
----
isfinite
t


query
SELECT isfinite(timestamp '2001-02-16 12:00:00');
----
isfinite
t


# age

query
SELECT age(timestamp '2001-04-10', timestamp '1957-06-13');
----
age
43 years 9 mons 27 days


# date_bin

query
SELECT date_bin(interval '15 minutes', timestamp '2001-02-16 20:38:40', timestamp '2001-02-16 20:05:00');
----
date_bin
2001-02-16 20:35:00


query
SELECT date_bin(interval '1 hour', timestamp '2001-02-16 20:38:40', timestamp '2001-02-16 00:00:00');
----
date_bin
2001-02-16 20:00:00


statement error
SELECT date_bin(interval '1 hour', timestamp '2020-02-11', timestamp 'infinity');
----
db error: ERROR: origin out of range


# make_interval

query
SELECT make_interval(days => 10, hours => 3) AS a, make_interval(1, 2, 3, 4, 5, 6, 7.5) AS b, make_interval() AS c;
----
a	b	c
10 days 03:00:00	1 year 2 mons 25 days 05:06:07.5	00:00:00


# justify_days, justify_hours, justify_interval

query
SELECT justify_days(interval '35 days') AS a, justify_days(interval '-35 days') AS b,
       justify_days(interval '1 mon -40 days') AS c, justify_days(interval '-1 mon 40 days') AS d;
----
a	b	c	d
1 mon 5 days	-1 mons -5 days	-10 days	10 days


query
SELECT justify_hours(interval '27 hours') AS a, justify_hours(interval '-27 hours') AS b,
       justify_hours(interval '1 day -1 hour') AS c, justify_hours(interval '-1 day 1 hour') AS d;
----
a	b	c	d
1 day 03:00:00	-1 days -03:00:00	23:00:00	-23:00:00


query
SELECT justify_interval(interval '1 mon -1 hour') AS a, justify_interval(interval '-1 day 23 hours') AS b,
       justify_interval(interval '50 days 30 hours') AS c, justify_interval(interval '-1 mon 31 days -25 hours') AS d;
----
a	b	c	d
29 days 23:00:00	-01:00:00	1 mon 21 days 06:00:00	-01:00:00


query
SELECT justify_days(NULL::interval) IS NULL AS a, justify_hours(NULL::interval) IS NULL AS b,
       justify_interval(NULL::interval) IS NULL AS c;
----
a	b	c
t	t	t


statement error
SELECT justify_days(interval '2147483647 mons 30 days');
----
db error: ERROR: interval out of range


# clock_timestamp returns non-null

query
SELECT clock_timestamp() IS NOT NULL AS ok;
----
ok
t


# timeofday returns non-empty string

query
SELECT length(timeofday()) > 0 AS ok;
----
ok
t


# to_timestamp with negative epoch (pre-1970)

query
SELECT to_timestamp(-0.5);
----
to_timestamp
1969-12-31 23:59:59.5<slt:ignore>

query
SELECT to_timestamp(-86400.25);
----
to_timestamp
1969-12-30 23:59:59.75<slt:ignore>

query
SELECT to_timestamp(0.0);
----
to_timestamp
1970-01-01 00:00:00<slt:ignore>


# make_timestamp with fractional seconds

query
SELECT make_timestamp(2024, 1, 1, 0, 0, 1.5);
----
make_timestamp
2024-01-01 00:00:01.5<slt:ignore>

query
SELECT make_timestamp(1969, 12, 31, 23, 59, 59.5);
----
make_timestamp
1969-12-31 23:59:59.5<slt:ignore>

# make_timestamp with sec=60 (wraps to next minute)

query
SELECT make_timestamp(2024, 1, 1, 0, 0, 60);
----
make_timestamp
2024-01-01 00:01:00<slt:ignore>


# date_bin with pre-epoch timestamps

query
SELECT date_bin('1 hour'::interval, '1969-12-31 23:30:00'::timestamp, '1970-01-01 00:00:00'::timestamp);
----
date_bin
1969-12-31 23:00:00


# age with ts1 < ts2 (negative interval)

query
SELECT age('2000-01-15'::timestamp, '2001-03-20'::timestamp);
----
age
-1 years -2 mons -5 days

query
SELECT age('2020-06-15'::timestamp, '2020-06-10'::timestamp);
----
age
5 days

query
SELECT age('2020-01-01'::timestamp, '2020-01-01'::timestamp);
----
age
00:00:00
