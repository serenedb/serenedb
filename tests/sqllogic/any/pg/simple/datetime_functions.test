# date_subtract, statement_timestamp, extract, overlaps and the OVERLAPS
# predicate, and the timestamp and timestamptz function forms.

statement ok
SET TimeZone = 'UTC'


# date_subtract

query
SELECT date_subtract(TIMESTAMPTZ '2021-03-29 01:30:00+02', INTERVAL '1 day 1 hour') AS a,
       date_subtract(TIMESTAMP '2020-01-01 00:00:00', INTERVAL '1 day') AS b,
       date_subtract(DATE '2020-03-31', INTERVAL '1 month') AS c,
       pg_typeof(date_subtract(TIMESTAMP '2020-01-01 00:00:00', INTERVAL '1 day')) AS t;
----
a	b	c	t
2021-03-27 22:30:00+00	2019-12-31 00:00:00+00	2020-02-29 00:00:00+00	timestamp with time zone


query
SELECT date_subtract(TIMESTAMPTZ '2021-03-29 00:00:00+02', INTERVAL '1 day', 'Europe/Berlin') AS berlin,
       date_subtract(TIMESTAMPTZ '2021-03-29 00:00:00+02', INTERVAL '1 day', 'UTC') AS utc,
       date_subtract(TIMESTAMPTZ '2021-03-29 00:00:00+02', INTERVAL '24 hours', 'Europe/Berlin') AS hours,
       date_subtract(TIMESTAMPTZ '2021-03-31 12:00:00+00', INTERVAL '1 month', 'Asia/Tokyo') AS month_end;
----
berlin	utc	hours	month_end
2021-03-27 23:00:00+00	2021-03-27 22:00:00+00	2021-03-27 22:00:00+00	2021-02-28 12:00:00+00


query
SELECT date_subtract(NULL::timestamptz, INTERVAL '1 day') IS NULL AS a,
       date_subtract(TIMESTAMPTZ '2020-01-01 00:00:00+00', NULL) IS NULL AS b,
       date_subtract(TIMESTAMPTZ '2020-01-01 00:00:00+00', INTERVAL '1 day', NULL) IS NULL AS c,
       date_subtract(TIMESTAMPTZ 'infinity', INTERVAL '1 day') AS d,
       date_subtract(TIMESTAMPTZ '-infinity', INTERVAL '1 day', 'UTC') AS e;
----
a	b	c	d	e
t	t	t	infinity	-infinity


query
SELECT date_subtract(ts, INTERVAL '1 day', zone) AS result
FROM (VALUES (TIMESTAMPTZ '2021-03-29 00:00:00+02', 'Europe/Berlin'),
             (TIMESTAMPTZ '2021-03-29 00:00:00+02', 'UTC'),
             (TIMESTAMPTZ '2021-03-29 00:00:00+02', NULL)) AS t(ts, zone)
ORDER BY result NULLS LAST;
----
result
2021-03-27 22:00:00+00
2021-03-27 23:00:00+00
NULL


statement ok
SET TimeZone = 'Europe/Berlin'


query
SELECT date_subtract(TIMESTAMPTZ '2021-03-29 00:00:00', INTERVAL '1 day')::text AS day,
       date_subtract(TIMESTAMPTZ '2021-03-29 00:00:00', INTERVAL '24 hours')::text AS hours,
       date_subtract(TIMESTAMPTZ '2021-11-01 00:00:00', INTERVAL '1 month')::text AS month;
----
day	hours	month
2021-03-28 00:00:00+01	2021-03-27 23:00:00+01	2021-10-01 00:00:00+02


statement ok
SET TimeZone = 'UTC'


statement error (time zone "Mars/Olympus_Mons" not recognized|Unknown TimeZone 'Mars/Olympus_Mons')
SELECT date_subtract(TIMESTAMPTZ '2020-01-01 00:00:00+00', INTERVAL '1 day', 'Mars/Olympus_Mons');


# statement_timestamp

query
SELECT statement_timestamp() >= now() AS after_transaction_start,
       pg_typeof(statement_timestamp()) AS type;
----
after_transaction_start	type
t	timestamp with time zone


query
SELECT count(DISTINCT statement_timestamp()) AS distinct_values FROM generate_series(1, 1000);
----
distinct_values
1


statement ok
BEGIN


statement ok
CREATE TABLE datetime_functions_statement_start AS
SELECT statement_timestamp() AS statement_start, now() AS transaction_start;


statement ok
SELECT pg_sleep(0.01);


query
SELECT statement_timestamp() > statement_start AS later_statement,
       now() = transaction_start AS same_transaction,
       statement_timestamp() > now() AS after_transaction_start
FROM datetime_functions_statement_start;
----
later_statement	same_transaction	after_transaction_start
t	t	t


statement ok
COMMIT


statement ok
DROP TABLE datetime_functions_statement_start


# extract

query
SELECT pg_catalog.extract('year', TIMESTAMP '2020-05-06 10:11:12.345678') AS year,
       pg_catalog.extract('second', TIMESTAMP '2020-05-06 10:11:12.345678') AS second,
       pg_catalog.extract('millisecond', TIMESTAMP '2020-05-06 10:11:12.345678') AS millisecond,
       pg_catalog.extract('microseconds', TIMESTAMP '2020-05-06 10:11:12.345678') AS microseconds,
       pg_catalog.extract('epoch', TIMESTAMP '2020-05-06 10:11:12.345678') AS epoch,
       pg_typeof(pg_catalog.extract('year', TIMESTAMP '2020-05-06 10:11:12.345678')) AS type;
----
year	second	millisecond	microseconds	epoch	type
2020	12.345678	12345.678	12345678	1588759872.345678	numeric


query
SELECT pg_catalog.extract('century', TIMESTAMP '2021-01-03 04:05:06') AS century,
       pg_catalog.extract('decade', TIMESTAMP '2021-01-03 04:05:06') AS decade,
       pg_catalog.extract('millennium', TIMESTAMP '2021-01-03 04:05:06') AS millennium,
       pg_catalog.extract('quarter', TIMESTAMP '2021-01-03 04:05:06') AS quarter,
       pg_catalog.extract('month', TIMESTAMP '2021-01-03 04:05:06') AS month,
       pg_catalog.extract('day', TIMESTAMP '2021-01-03 04:05:06') AS day,
       pg_catalog.extract('hour', TIMESTAMP '2021-01-03 04:05:06') AS hour,
       pg_catalog.extract('minute', TIMESTAMP '2021-01-03 04:05:06') AS minute;
----
century	decade	millennium	quarter	month	day	hour	minute
21	202	3	1	1	3	4	5


query
SELECT pg_catalog.extract('week', TIMESTAMP '2021-01-03 04:05:06') AS week,
       pg_catalog.extract('isoyear', TIMESTAMP '2021-01-03 04:05:06') AS isoyear,
       pg_catalog.extract('dow', TIMESTAMP '2021-01-03 04:05:06') AS dow,
       pg_catalog.extract('isodow', TIMESTAMP '2021-01-03 04:05:06') AS isodow,
       pg_catalog.extract('doy', TIMESTAMP '2020-12-31 04:05:06') AS doy,
       pg_catalog.extract('julian', TIMESTAMP '2020-01-01 12:00:00') AS julian,
       pg_catalog.extract('julian', TIMESTAMP '2020-01-01 18:00:00.5') AS julian_fraction;
----
week	isoyear	dow	isodow	doy	julian	julian_fraction
53	2020	0	7	366	2458850.50000000000000000000	2458850.75000578703703703704


query
SELECT pg_catalog.extract('Y', TIMESTAMP '2021-01-03 04:05:06') AS y,
       pg_catalog.extract('MON', TIMESTAMP '2021-01-03 04:05:06') AS mon,
