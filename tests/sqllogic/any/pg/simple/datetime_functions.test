       pg_catalog.extract('m', TIMESTAMP '2021-01-03 04:05:06') AS m,
       pg_catalog.extract('mm', TIMESTAMP '2021-01-03 04:05:06') AS mm,
       pg_catalog.extract('s', TIMESTAMP '2021-01-03 04:05:06.5') AS s,
       pg_catalog.extract('msecs', TIMESTAMP '2021-01-03 04:05:06.5') AS msecs,
       pg_catalog.extract('Microseconds', TIMESTAMP '2021-01-03 04:05:06.5') AS microseconds,
       pg_catalog.extract('jd', TIMESTAMP '2021-01-03 06:00:00') AS jd;
