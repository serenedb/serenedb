# overlaps and OVERLAPS

query
SELECT (DATE '2020-01-01', DATE '2020-01-10') OVERLAPS (DATE '2020-01-05', DATE '2020-01-15') AS crossing,
       (DATE '2020-01-01', DATE '2020-01-05') OVERLAPS (DATE '2020-01-05', DATE '2020-01-15') AS touching,
       (DATE '2020-01-05', DATE '2020-01-01') OVERLAPS (DATE '2020-01-04', DATE '2020-01-15') AS reversed,
       ROW(DATE '2020-01-01', DATE '2020-01-10') OVERLAPS ROW(DATE '2020-01-05', DATE '2020-01-15') AS row_constructor;
----
crossing	touching	reversed	row_constructor
t	f	t	t


query
SELECT (TIMESTAMP '2020-01-01', NULL::timestamp) OVERLAPS (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02') AS same_start,
       (NULL::timestamp, NULL::timestamp) OVERLAPS (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02') AS both_null,
       (NULL::timestamp, TIMESTAMP '2020-01-05') OVERLAPS (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-10') AS null_start,
       (TIMESTAMP '2020-01-05', NULL::timestamp) OVERLAPS (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-10') AS null_end,
       (TIMESTAMP '2020-01-15', NULL::timestamp) OVERLAPS (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-10') AS null_end_after,
       (TIMESTAMP '2020-01-15', TIMESTAMP '2020-01-20') OVERLAPS (TIMESTAMP '2020-01-01', NULL::timestamp) AS other_null_end;
----
same_start	both_null	null_start	null_end	null_end_after	other_null_end
NULL	NULL	t	t	NULL	NULL


query
SELECT (TIME '10:00', TIME '12:00') OVERLAPS (TIME '11:00', TIME '13:00') AS time_overlap,
       (TIME '23:00', INTERVAL '2 hours') OVERLAPS (TIME '00:30', INTERVAL '10 minutes') AS time_wrap,
       (TIME '10:00', INTERVAL '1 hour') OVERLAPS (TIME '10:30', TIME '12:00') AS time_length,
       (TIMETZ '10:00:00+02', TIMETZ '12:00:00+02') OVERLAPS (TIMETZ '11:30:00+03', TIMETZ '13:00:00+03') AS timetz_overlap,
       (TIMETZ '10:00:00+02', TIMETZ '12:00:00+02') OVERLAPS (TIMETZ '13:00:00+03', TIMETZ '15:00:00+03') AS timetz_apart;
----
time_overlap	time_wrap	time_length	timetz_overlap	timetz_apart
t	f	t	t	t


query
SELECT (TIMESTAMP '2020-01-01', INTERVAL '1 day') OVERLAPS (TIMESTAMP '2020-01-01 12:00', INTERVAL '1 hour') AS lengths,
       (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02') OVERLAPS (TIMESTAMP '2020-01-02', INTERVAL '1 day') AS end_and_length,
       (TIMESTAMP '2020-01-01', INTERVAL '1 month') OVERLAPS (TIMESTAMP '2020-01-31', TIMESTAMP '2020-02-01') AS month_length,
       (TIMESTAMPTZ '2020-01-01 00:00:00+00', INTERVAL '1 day') OVERLAPS (TIMESTAMPTZ '2020-01-01 12:00:00+00', TIMESTAMPTZ '2020-01-03 00:00:00+00') AS timestamptz_length,
       (TIMESTAMPTZ '2020-01-01 00:00:00+00', TIMESTAMPTZ '2020-01-02 00:00:00+00') OVERLAPS (TIMESTAMPTZ '2020-01-01 23:00:00-01', INTERVAL '1 hour') AS timestamptz_offset;
----
lengths	end_and_length	month_length	timestamptz_length	timestamptz_offset
t	f	t	t	f


query
SELECT overlaps(TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-10', TIMESTAMP '2020-01-05', TIMESTAMP '2020-01-15') AS call,
       pg_catalog.overlaps(TIME '10:00', INTERVAL '1 hour', TIME '10:59', NULL::time) AS qualified_call,
       (DATE '2020-01-01', DATE '2020-01-10') OVERLAPS (DATE '2020-01-05', DATE '2020-01-15') = true AS compared,
       NOT (DATE '2020-01-01', DATE '2020-01-10') OVERLAPS (DATE '2020-01-11', DATE '2020-01-15') AS negated,
       pg_typeof((DATE '2020-01-01', DATE '2020-01-10') OVERLAPS (DATE '2020-01-05', DATE '2020-01-15')) AS type;
----
call	qualified_call	compared	negated	type
t	t	t	t	boolean


query
SELECT p.id, (p.s, p.e) OVERLAPS (q.s, q.e) AS overlaps
FROM (VALUES (1, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-03'),
             (2, TIMESTAMP '2020-01-05', NULL),
             (3, NULL, TIMESTAMP '2020-01-02'),
             (4, TIMESTAMP '2020-01-04', TIMESTAMP '2020-01-02')) AS p(id, s, e),
     (VALUES (TIMESTAMP '2020-01-02', TIMESTAMP '2020-01-06')) AS q(s, e)
ORDER BY p.id;
----
id	overlaps
1	t
2	t
3	NULL
4	t


