# timestamp and timestamptz

query
SELECT pg_catalog.timestamp(DATE '2020-01-01') AS from_date,
       pg_catalog.timestamp(DATE '2020-01-01', TIME '10:11:12.345678') AS from_date_time,
       pg_catalog.timestamp(TIMESTAMPTZ '2020-01-01 10:00:00+03') AS from_timestamptz,
       "timestamp"(DATE 'infinity') AS infinite;
----
from_date	from_date_time	from_timestamptz	infinite
2020-01-01 00:00:00	2020-01-01 10:11:12.345678	2020-01-01 07:00:00	infinity


query
SELECT pg_catalog.timestamp(TIMESTAMP '2020-01-01 10:11:12.345678', 3) AS three,
       pg_catalog.timestamp(TIMESTAMP '2020-01-01 10:11:12.995', 2) AS two_carry,
       pg_catalog.timestamp(TIMESTAMP '2020-01-01 10:11:12.345678', 0) AS zero,
       pg_catalog.timestamp(TIMESTAMP '2020-01-01 10:11:12.345678', 6) AS six,
       pg_catalog.timestamp(TIMESTAMP '2020-01-01 10:11:12.345678', -1) AS unconstrained,
       pg_catalog.timestamp(TIMESTAMP '2020-01-01 00:00:00.5', 0) AS after_2000,
       pg_catalog.timestamp(TIMESTAMP '1999-12-31 23:59:59.5', 0) AS before_2000,
       pg_catalog.timestamp(TIMESTAMP '1970-01-01 00:00:00.5', 0) AS epoch_half,
       pg_catalog.timestamp(TIMESTAMP 'infinity', 9) AS infinite;
----
three	two_carry	zero	six	unconstrained	after_2000	before_2000	epoch_half	infinite
2020-01-01 10:11:12.346	2020-01-01 10:11:13	2020-01-01 10:11:12	2020-01-01 10:11:12.345678	2020-01-01 10:11:12.345678	2020-01-01 00:00:01	1999-12-31 23:59:59	1970-01-01 00:00:00	infinity


query
SELECT timestamptz(DATE '2020-01-01') AS from_date,
       timestamptz(DATE '2020-01-01', TIME '10:11:12') AS from_date_time,
       timestamptz(DATE '2020-01-01', TIMETZ '10:11:12+05') AS from_date_timetz,
       timestamptz(TIMESTAMP '2020-01-01 10:11:12') AS from_timestamp,
       timestamptz(TIMESTAMPTZ '2020-01-01 10:11:12.987654+00', 3) AS precision,
       pg_typeof(timestamptz(DATE '2020-01-01')) AS type;
----
from_date	from_date_time	from_date_timetz	from_timestamp	precision	type
2020-01-01 00:00:00+00	2020-01-01 10:11:12+00	2020-01-01 05:11:12+00	2020-01-01 10:11:12+00	2020-01-01 10:11:12.988+00	timestamp with time zone


