CREATE TABLE div_zero (x float8, y float8, n numeric(10,2), i integer);


statement ok
INSERT INTO div_zero SELECT g, CASE WHEN g % 2 = 0 THEN NULL ELSE g END, g, CASE WHEN g % 2 = 0 THEN NULL ELSE g END FROM generate_series(1, 5000) g;


query
SELECT sum(x / y) AS f, sum(n / y) AS n, sum(i / i) AS i FROM div_zero;
----
f	n	i
2500	2500	2500


