statement ok
SET TimeZone = 'UTC';

query
SELECT id, pg_catalog.extract('year', d) AS year, pg_catalog.extract('decade', d) AS decade, pg_catalog.extract('century', d) AS century,
       pg_catalog.extract('millennium', d) AS millennium, pg_catalog.extract('isoyear', d) AS isoyear, pg_catalog.extract('isodow', d) AS isodow,
       pg_catalog.extract('dow', d) AS dow
FROM (VALUES (1, to_date('0001-01-01 BC', 'YYYY-MM-DD BC')), (2, to_date('0002-06-15 BC', 'YYYY-MM-DD BC')), (3, to_date('1001-03-10 BC', 'YYYY-MM-DD BC')),
             (4, DATE '2021-01-04'), (5, DATE '2000-12-31'), (6, DATE '0001-01-01')) v(id, d)
ORDER BY id;
----
id	year	decade	century	millennium	isoyear	isodow	dow
1	-1	0	-1	-1	-2	6	6
2	-2	-1	-1	-1	-2	2	2
3	-1001	-100	-11	-2	-1001	1	1
4	2021	202	21	3	2021	1	1
5	2000	200	20	2	2000	7	0
6	1	0	1	1	1	1	1

query
SELECT id, pg_catalog.extract('year', t) AS year, pg_catalog.extract('decade', t) AS decade, pg_catalog.extract('century', t) AS century,
       pg_catalog.extract('millennium', t) AS millennium, pg_catalog.extract('isoyear', t) AS isoyear, pg_catalog.extract('isodow', t) AS isodow
FROM (VALUES (1, to_timestamp('0001-01-01 12:00 BC', 'YYYY-MM-DD HH24:MI BC')::timestamp), (2, TIMESTAMP '2021-01-04 12:00:00')) v(id, t)
ORDER BY id;
----
id	year	decade	century	millennium	isoyear	isodow
1	-1	0	-1	-1	-2	6
2	2021	202	21	3	2021	1

query
SELECT pg_catalog.extract('millisecond', INTERVAL '1 minute 2.5 seconds') AS ms,
       pg_catalog.extract('minute', INTERVAL '1 hour 2 minutes') AS minute,
       pg_catalog.extract('decade', INTERVAL '25 years') AS decade,
       pg_catalog.extract('millennium', INTERVAL '2500 years') AS millennium,
       pg_catalog.extract('decade', INTERVAL '-25 years') AS neg_decade;
----
ms	minute	decade	millennium	neg_decade
2500.000	2	2	2	-2

query
SELECT u, pg_catalog.extract(u, DATE '2021-01-03')::float8 AS a FROM (VALUES ('year'), ('doy'), ('epoch')) v(u) ORDER BY u;
----
u	a
doy	3
epoch	1609632000
year	2021

query
SELECT u, pg_catalog.extract(u, TIME '10:11:12.5')::float8 AS a FROM (VALUES ('hour'), ('second'), ('epoch')) v(u) ORDER BY u;
----
u	a
epoch	36672.5
hour	10
second	12.5

query
SELECT u, pg_catalog.extract(u, TIMETZ '10:11:12.5+02')::float8 AS a FROM (VALUES ('hour'), ('timezone'), ('epoch')) v(u) ORDER BY u;
----
u	a
epoch	29472.5
hour	10
timezone	7200

query
SELECT u, pg_catalog.extract(u, TIMESTAMP '2021-01-03 10:11:12.5')::float8 AS a FROM (VALUES ('year'), ('millisecond'), ('epoch')) v(u) ORDER BY u;
----
u	a
epoch	1609668672.5
millisecond	12500
year	2021

query
SELECT u, pg_catalog.extract(u, TIMESTAMPTZ '2021-01-03 10:11:12.5+00')::float8 AS a FROM (VALUES ('year'), ('timezone'), ('epoch')) v(u) ORDER BY u;
----
u	a
epoch	1609668672.5
timezone	0
year	2021

query
SELECT u, pg_catalog.extract(u, INTERVAL '1 year 2 months 3 days 04:05:06.5')::float8 AS a FROM (VALUES ('year'), ('month'), ('epoch')) v(u) ORDER BY u;
----
u	a
epoch	37015506.5
month	2
year	1

query
SELECT pg_catalog.extract(NULL::text, DATE '2021-01-03') AS a,
       pg_catalog.extract(NULL::text, TIME '10:11:12') AS b,
       pg_catalog.extract(NULL::text, TIMETZ '10:11:12+02') AS c,
       pg_catalog.extract(NULL::text, TIMESTAMP '2021-01-03 10:11:12') AS d,
       pg_catalog.extract(NULL::text, TIMESTAMPTZ '2021-01-03 10:11:12+00') AS e,
       pg_catalog.extract(NULL::text, INTERVAL '1 day') AS f,
       pg_catalog.extract(NULLIF('year', 'year'), DATE '2021-01-03') AS g,
       pg_catalog.extract(NULLIF('hour', 'hour'), TIME '10:11:12') AS h,
       pg_catalog.extract(NULLIF('hour', 'hour'), TIMETZ '10:11:12+02') AS i,
       pg_catalog.extract(NULLIF('year', 'year'), TIMESTAMP '2021-01-03 10:11:12') AS j,
       pg_catalog.extract(NULLIF('year', 'year'), TIMESTAMPTZ '2021-01-03 10:11:12+00') AS k,
       pg_catalog.extract(NULLIF('year', 'year'), INTERVAL '1 day') AS l;
----
a	b	c	d	e	f	g	h	i	j	k	l
NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL

statement ok
PREPARE extract_unit(text) AS SELECT pg_catalog.extract($1, TIMESTAMP '2021-01-03 10:11:12.5') AS a;

query
EXECUTE extract_unit(NULL);
----
a
NULL

query
EXECUTE extract_unit('second');
----
a
12.500000

