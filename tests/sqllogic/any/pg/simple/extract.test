statement ok
SET TimeZone = 'America/New_York';

query
SELECT id, pg_catalog.extract('hour', t) AS h, pg_catalog.extract('timezone', t) AS tz
FROM (VALUES (1, TIMESTAMPTZ '1800-01-01 00:00:00.0005+00'), (2, TIMESTAMPTZ '2400-07-01 00:00:00+00')) v(id, t)
ORDER BY id;
----
id	h	tz
1	19	-17762
2	20	-14400

