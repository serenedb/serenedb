# A table alias on a function in FROM names the relation; whether it also renames the
# output column depends on the return type. PG renames only for base-type (SETOF <type>)
# returns, never for composite (RETURNS TABLE(...)) ones. Expectations below are from
# postgres 18.3.


# ── composite return: the alias names the relation only, columns keep their names ──

statement ok
CREATE FUNCTION tf_named() RETURNS TABLE(v INT) LANGUAGE sql AS $$ SELECT 7 $$;


query
SELECT v FROM tf_named() AS b;
----
v
7


query
SELECT b.v FROM tf_named() AS b;
----
v
7


query
SELECT * FROM tf_named() AS b;
----
v
7


statement ok
CREATE FUNCTION tf_named2() RETURNS TABLE(v INT, w INT) LANGUAGE sql AS $$ SELECT 1, 2 $$;


query
SELECT c.v, c.w FROM tf_named2() AS c;
----
v	w
1	2


# an explicit column list renames, for any return type

query
SELECT * FROM tf_named2() AS c(p, q);
----
p	q
1	2


# ── base-type return: the alias also names the single output column ──

statement ok
CREATE FUNCTION sf_setof() RETURNS SETOF INT LANGUAGE sql AS $$ SELECT 1 UNION ALL SELECT 2 $$;


# serenedb: a base-type function is bound as a scalar macro, so the alias resolves to the
# row instead of the column, and only the first row is produced.
skipif serenedb
query
SELECT a FROM sf_setof() AS a ORDER BY 1;
----
a
1
2


skipif serenedb
query
SELECT * FROM sf_setof() AS a ORDER BY 1;
----
a
1
2


statement ok
CREATE FUNCTION sc_scalar(i INT) RETURNS INT LANGUAGE sql AS $$ SELECT i + 1 $$;


skipif serenedb
query
SELECT x FROM sc_scalar(41) AS x;
----
x
42


# a set-returning function produces a result set, not just its first row

skipif serenedb
query
SELECT * FROM sf_setof() ORDER BY 1;
----
sf_setof
1
2


skipif serenedb
query
SELECT sf_setof() ORDER BY 1;
----
sf_setof
1
2


skipif serenedb
query
SELECT count(*) AS n FROM sf_setof();
----
n
2


skipif serenedb
query
SELECT s.i, f.a FROM (SELECT 1 AS i) s, LATERAL (SELECT * FROM sf_setof() AS a) f ORDER BY 2;
----
i	a
1	1
1	2


skipif serenedb
query
SELECT proretset FROM pg_proc WHERE proname = 'sf_setof';
----
proretset
t


# the declared column names of RETURNS TABLE hold for any body shape

statement ok
CREATE FUNCTION tf_union() RETURNS TABLE(a INT) LANGUAGE sql AS $$ SELECT 1 UNION ALL SELECT 2 $$;


skipif serenedb
query
SELECT a FROM tf_union() ORDER BY 1;
----
a
1
2


# SETOF is a return-type marker only; it is not a column type

skipif serenedb
statement error
CREATE TABLE bad_setof(c SETOF INT);
----
db error: ERROR: column "c" cannot be declared SETOF


# ROWS FROM zips several set-returning functions

skipif serenedb
query
SELECT * FROM ROWS FROM (generate_series(1, 2), generate_series(5, 6)) AS t(a, b) ORDER BY 1;
----
a	b
1	5
2	6


# ── built-in set-returning functions: the alias names the single column on both engines ──

query
SELECT g FROM generate_series(1, 3) AS g ORDER BY 1;
----
g
1
2
3


query
SELECT * FROM generate_series(1, 2) AS g ORDER BY 1;
----
g
1
2


query
SELECT u FROM unnest(ARRAY[7, 8]) AS u ORDER BY 1;
----
u
7
8
