query
SELECT pg_typeof(g)::text AS t, g FROM generate_series(1, 3) AS g ORDER BY g;
----
t	g
integer	1
integer	2
integer	3

query
SELECT pg_typeof(g)::text AS t, g FROM generate_series(10, 1, -4) AS g ORDER BY g;
----
t	g
integer	2
integer	6
integer	10

query
SELECT pg_typeof(g)::text AS t FROM generate_series(1, 3::bigint) AS g LIMIT 1;
----
t
bigint

query
SELECT g FROM generate_series(2147483645, 2147483647) AS g ORDER BY g;
----
g
2147483645
2147483646
2147483647

query
SELECT pg_typeof(generate_series(1, 2))::text AS t;
----
t
integer
integer
