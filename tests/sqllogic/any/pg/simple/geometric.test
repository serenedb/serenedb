query
SELECT point_add(point '(1,1)', point '(2,3)') AS a, point_eq(point '(1,1)', point '(1,1.0000001)') AS b,
       point_ne(point '(1,1)', point '(1,2)') AS c, line_eq(line '{1,-1,0}', line '{2,-2,0}') AS d,
       lseg_eq(lseg '[(0,0),(1,1)]', lseg '[(0,0),(1,1)]') AS e, lseg_ne(lseg '[(0,0),(1,1)]', lseg '[(0,0),(1,2)]') AS f,
       lseg_lt(lseg '[(0,0),(1,1)]', lseg '[(0,0),(2,2)]') AS g, lseg_ge(lseg '[(0,0),(1,1)]', lseg '[(5,5),(6,6)]') AS h,
       box_eq(box '(1,1),(0,0)', box '(2,1),(1,0)') AS i, box_lt(box '(1,1),(0,0)', box '(3,3),(0,0)') AS j,
       circle_eq(circle '<(0,0),1>', circle '<(5,5),1>') AS k, circle_ne(circle '<(0,0),1>', circle '<(0,0),2>') AS l,
       path_n_lt(path '[(0,0)]', path '[(0,0),(1,1)]') AS m, path_n_eq(path '[(0,0)]', path '((5,5))') AS n,
       dist_ps(point '(0,0)', lseg '[(1,0),(1,1)]') AS o, close_pb(point '(5,5)', box '(1,1),(0,0)') AS p,
       on_ppath(point '(1,0)', path '[(0,0),(2,0)]') AS q, path_contain_pt(path '[(0,0),(2,0)]', point '(1,0)') AS r,
       poly_npoints(polygon '((0,0),(1,1),(1,0))') AS s, circle_center(circle '<(1,2),3>') AS t;
----
a	b	c	d	e	f	g	h	i	j	k	l	m	n	o	p	q	r	s	t
(3,4)	t	t	t	t	t	t	t	t	t	t	t	t	t	1	(1,1)	t	t	3	(1,2)


query
SELECT ARRAY[point '(1,2)', NULL, point '(3,4)'] AS a, ARRAY[box '(1,1),(0,0)', box '(3,3),(2,2)'] AS b,
       ARRAY[circle '<(1,2),3>'] AS c, ARRAY[path '[(1,2),(3,4)]', path '((0,0),(1,1))'] AS d,
       ARRAY[line '{1,2,3}'] AS e, ARRAY[lseg '[(1,2),(3,4)]'] AS f, ARRAY[polygon '((0,0),(1,1),(1,0))'] AS g;
