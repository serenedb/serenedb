query
SELECT a.id AS a, string_agg(CASE WHEN a.g @> b.g THEN 't' ELSE 'f' END, '' ORDER BY b.id) AS contains,
       string_agg(CASE WHEN a.g && b.g THEN 't' ELSE 'f' END, '' ORDER BY b.id) AS overlaps,
       string_agg(CASE WHEN a.g ~= b.g THEN 't' ELSE 'f' END, '' ORDER BY b.id) AS same
FROM geo_shapes a, geo_shapes b GROUP BY a.id ORDER BY a.id;
