query
SELECT min(x) AS mn, max(x) AS mx FROM (VALUES ('10.0.0.5/8'::INET), ('10.0.0.1'::INET), ('10.0.0.0/16'::INET)) t(x);
----
mn	mx
10.0.0.5/8	10.0.0.1


query
