query
SELECT x FROM (VALUES ('10.0.0.5/8'::INET), ('10.0.0.1'::INET), ('10.0.0.0/16'::INET), ('10.0.0.0/8'::INET), ('::/0'::INET), ('::1'::INET), ('0.0.0.0/0'::INET), (NULL::INET)) t(x) ORDER BY x;
