query
SELECT '10.0.0.1'::INET > ANY (SELECT '10.0.0.5/8'::INET) AS gt_any, '10.0.0.0/16'::INET > ALL (SELECT x FROM (VALUES ('10.0.0.5/8'::INET), ('10.0.0.0/8'::INET)) t(x)) AS gt_all, '10.0.0.5/8'::INET >= ANY (SELECT '10.0.0.1'::INET) AS ge_any;
----
gt_any	gt_all	ge_any
t	t	f


query
SELECT a, a > ALL (SELECT b FROM (VALUES ('10.0.0.5/8'::INET), ('10.0.0.0/16'::INET)) t(b) WHERE b <> a) AS gt_all FROM (VALUES ('10.0.0.1'::INET), ('10.0.0.0/16'::INET), ('10.0.0.5/8'::INET)) s(a) ORDER BY a;
----
a	gt_all
10.0.0.5/8	f
10.0.0.0/16	t
10.0.0.1	t


query
SELECT x, row_number() OVER (ORDER BY x) AS rn FROM (VALUES ('10.0.0.1'::INET), ('10.0.0.5/8'::INET), ('10.0.0.0/16'::INET)) t(x) ORDER BY rn;
----
x	rn
10.0.0.5/8	1
10.0.0.0/16	2
10.0.0.1	3


query
SELECT a.x AS a, b.x AS b FROM (VALUES ('10.0.0.5/8'::INET)) a(x) JOIN (VALUES ('10.0.0.1'::INET), ('10.0.0.0/8'::INET)) b(x) ON a.x < b.x;
----
a	b
10.0.0.5/8	10.0.0.1


