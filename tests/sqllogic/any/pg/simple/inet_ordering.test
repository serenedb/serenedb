query
SELECT '10.0.0.5/8'::INET < '10.0.0.1/32'::INET AS lt_host_bits, '10.1.0.0/8'::INET < '10.0.0.0/16'::INET AS lt_mask, '10.0.0.5/8'::INET BETWEEN '10.0.0.0/8'::INET AND '10.0.0.0/16'::INET AS btw, '255.255.255.255'::INET < '::'::INET AS v4_before_v6;
