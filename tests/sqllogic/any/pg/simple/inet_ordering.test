CREATE TABLE inet_extremes(id INTEGER, ip INET);


statement ok
INSERT INTO inet_extremes VALUES (1, '10.0.0.5/8'), (2, '10.0.0.1'), (3, '10.0.0.0/16'), (4, NULL), (5, '::1'), (6, '2001:db8::/32');


query
SELECT family(ip) AS f, min(ip) AS mn, max(ip) AS mx, count(ip) AS n FROM inet_extremes GROUP BY family(ip) ORDER BY f NULLS LAST;
