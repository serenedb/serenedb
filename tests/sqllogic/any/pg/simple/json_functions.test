# json_each_text

query
SELECT n, key, value FROM json_each_text('{"a": 1, "b": "x\u0041", "c": null, "d": [1,  2], "e": {"f": "g"}, "a": true}') WITH ORDINALITY AS t(key, value, n) ORDER BY n;
----
n	key	value
1	a	1
2	b	xA
3	c	NULL
4	d	[1,  2]
5	e	{"f": "g"}
6	a	true


query
SELECT * FROM json_each_text('{"k": "v"}') AS e;
----
key	value
k	v


query
SELECT json_each_text('{"k": "v"}') AS kv;
----
kv
(k,v)


query
SELECT count(*) AS n FROM json_each_text('{}');
----
n
0


query
SELECT count(*) AS n FROM json_each_text(NULL);
----
n
0


statement error
