# json_array_elements

query
SELECT n, elem FROM json_array_elements('[1, "a", {"b": [2,  3]}, null, [1,  2 ] , true, "x\u0041"]') WITH ORDINALITY AS t(elem, n) ORDER BY n;
----
n	elem
1	1
2	"a"
3	{"b": [2,  3]}
4	null
5	[1,  2 ]
6	true
7	"x\\u0041"


query
SELECT * FROM json_array_elements('[{"a": 1}]') AS e;
----
value
{"a": 1}


query
SELECT d.id, e.n, e.elem FROM jsonfn_docs d, json_array_elements(d.doc) WITH ORDINALITY AS e(elem, n) ORDER BY d.id, e.n;
----
id	n	elem
1	1	10
1	2	"x"
1	3	{"a": 1}
4	1	null


query
SELECT json_array_elements('[2, 1]')::text AS e ORDER BY e;
----
e
1
2


query
SELECT count(*) AS n FROM json_array_elements(NULL);
----
n
0


query
SELECT count(*) AS n FROM json_array_elements('[]');
----
n
0


statement error
SELECT * FROM json_array_elements('{"a": 1}');
----
db error: ERROR: cannot call json_array_elements on a non-array


statement error
SELECT * FROM json_array_elements('1');
----
db error: ERROR: cannot call json_array_elements on a scalar


# json_array_elements_text

query
SELECT n, elem FROM json_array_elements_text('[1, "a\"b", {"c": [1,  2]}, null, "x\u0041", true]') WITH ORDINALITY AS t(elem, n) ORDER BY n;
----
n	elem
1	1
2	a"b
3	{"c": [1,  2]}
4	NULL
5	xA
6	true


query
SELECT * FROM json_array_elements_text('["q"]') AS e;
----
value
q


query
SELECT d.id, e.n, e.elem FROM jsonfn_docs d, json_array_elements_text(d.doc) WITH ORDINALITY AS e(elem, n) ORDER BY d.id, e.n;
----
id	n	elem
1	1	10
1	2	x
1	3	{"a": 1}
4	1	NULL


query
SELECT count(*) AS n FROM json_array_elements_text(NULL);
----
n
0


statement error
SELECT * FROM json_array_elements_text('{"a": 1}');
----
db error: ERROR: cannot call json_array_elements_text on a non-array


statement error
SELECT * FROM json_array_elements_text('"a"');
----
db error: ERROR: cannot call json_array_elements_text on a scalar


