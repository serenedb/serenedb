DETAIL: \u0000 cannot be converted to text.


# json_each_text

query
SELECT n, key, value FROM json_each_text('{"a": 1, "b": "x\u0041", "c": null, "d": [1,  2], "e": {"f": "g"}, "a": true}') WITH ORDINALITY AS t(key, value, n) ORDER BY n;
----
n	key	value
1	a	1
2	b	xA
3	c	NULL
4	d	[1,  2]
5	e	{"f": "g"}
6	a	true


query
SELECT * FROM json_each_text('{"k": "v"}') AS e;
----
key	value
k	v


query
SELECT count(*) AS n FROM json_each_text('{}');
----
n
0


query
SELECT count(*) AS n FROM json_each_text(NULL);
----
n
0


statement error
SELECT * FROM json_each_text('[1]');
----
db error: ERROR: cannot deconstruct an array as an object


statement error
SELECT * FROM json_each_text('1');
----
db error: ERROR: cannot deconstruct a scalar


# json_object_keys

query
SELECT n, k FROM json_object_keys('{"b": 1, "a": {"c": 2}, "b": 3, "x\u0041": 4}') WITH ORDINALITY AS t(k, n) ORDER BY n;
----
n	k
1	b
2	a
3	b
4	xA


query
