# JSON values converted to column types

statement ok
CREATE TYPE jsonfn_kinds AS (a int, b text, c text, d json, g boolean, h numeric(10,2), i int, j json, n text, missing text)


query
SELECT * FROM json_populate_record(NULL::jsonfn_kinds, '{"a": 1, "b": "x\u0041", "c": [1,  2], "d": {"e": "f"}, "g": true, "h": 1.5, "i": "2", "j": "q\u0041\"z", "n": null}');
----
a	b	c	d	g	h	i	j	n	missing
1	xA	[1,  2]	{"e": "f"}	t	1.50	2	"qA\\"z"	NULL	NULL


statement ok
DROP TYPE jsonfn_kinds


statement ok
CREATE TYPE jsonfn_upper AS ("A" int)


query
SELECT * FROM json_populate_record(NULL::jsonfn_upper, '{"a": 1, "A": 2}');
----
A
2


query
SELECT a FROM json_populate_record(NULL::jsonfn_pair, '{"a": 1, "A": 2}');
----
a
1


statement ok
DROP TYPE jsonfn_upper


statement ok
CREATE TYPE jsonfn_arrays AS (a int[], b int[], c int[], d text[][])


query
SELECT * FROM json_populate_record(NULL::jsonfn_arrays, '{"a": [1, 2, null], "b": "{3,4}", "c": [], "d": [["x", "y"]]}');
----
a	b	c	d
{1,2,NULL}	{3,4}	{}	{{x,y}}


statement error
SELECT * FROM json_populate_record(NULL::jsonfn_arrays, '{"a": 1}');
----
db error: ERROR: expected JSON array
HINT: See the value of key "a".


statement ok
DROP TYPE jsonfn_arrays


statement ok
CREATE TYPE jsonfn_nested AS (p jsonfn_pair, q jsonfn_pair)


query
SELECT * FROM json_populate_record(NULL::jsonfn_nested, '{"p": {"a": 1, "b": "x", "z": 0}, "q": "(2,y)"}');
----
p	q
(1,x)	(2,y)


statement error
SELECT * FROM json_populate_record(NULL::jsonfn_nested, '{"p": [1]}');
----
db error: ERROR: cannot call populate_composite on an array


statement ok
DROP TYPE jsonfn_nested


