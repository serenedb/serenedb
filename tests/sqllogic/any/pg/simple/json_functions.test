# json_to_record and column definition lists

query
SELECT * FROM json_to_record('{"a": 1, "b": "x\u0041", "c": [1,  2], "d": {"e": "f"}, "g": true, "h": 1.5, "i": "2", "j": "q\u0041\"z", "n": null}') AS t(a int, b text, c text, d json, g boolean, h numeric(10,2), i int, j json, n text, missing text);
----
a	b	c	d	g	h	i	j	n	missing
1	xA	[1,  2]	{"e": "f"}	t	1.50	2	"qA\\"z"	NULL	NULL


query
SELECT * FROM json_to_record('{"a": 1, "b": "x"}') AS (a int, b text);
----
a	b
1	x


query
SELECT t.b, t.a FROM json_to_record('{"a": 1, "b": "x"}') t(a int, b text);
----
b	a
x	1


query
SELECT json_to_record.a FROM json_to_record('{"a": 5}') AS (a int);
----
a
5


statement ok
