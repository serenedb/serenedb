query
SELECT * FROM json_populate_record(NULL::json_nested_docs, '{"a": [{"x": 1}, 2, "s", null, [1, 2]]}');
----
a
{"{\\"x\\": 1}",2,"\\"s\\"",NULL,"[1, 2]"}

query
SELECT * FROM json_populate_record(NULL::json_nested_pairs, '{"p": [{"a": 1, "b": "x"}, null, {"a": 2}]}');
----
p
{"(1,x)",NULL,"(2,)"}

query
SELECT * FROM json_populate_record(NULL::json_nested_outer, '{"o": {"q": {"a": 5, "b": "y"}, "w": {"k": [1]}}}');
----
o
("(5,y)","{""k"": [1]}")

query
SELECT count(*) AS n, sum(a) AS s FROM json_populate_recordset(NULL::json_nested_pair, (SELECT json_agg(json_build_object('a', i)) FROM generate_series(1, 3000) i));
----
n	s
3000	4501500

query
SELECT count(*) AS n FROM json_array_elements((SELECT json_agg(i) FROM generate_series(1, 3000) i));
----
n
3000

