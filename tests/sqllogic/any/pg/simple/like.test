SELECT (SELECT count(*) FROM ilike_ascii WHERE s ILIKE '%QUICK BROWN%') AS contains,
       (SELECT count(*) FROM ilike_ascii WHERE s ILIKE 'the quick%') AS prefix,
       (SELECT count(*) FROM ilike_ascii WHERE s ILIKE '%LAZY DOG 1__') AS suffix_underscore,
       (SELECT count(*) FROM ilike_ascii WHERE s ILIKE '%lazy%DOG%0') AS segments,
       (SELECT count(*) FROM ilike_ascii WHERE s ILIKE 'QUICK\_BROWN%') AS escaped,
       (SELECT count(*) FROM ilike_ascii WHERE s NOT ILIKE '%e%') AS not_e,
       (SELECT count(*) FROM ilike_ascii WHERE s ILIKE 'X') AS short
