CREATE TABLE ilike_mixed AS
SELECT i AS id,
       CASE i % 6
           WHEN 0 THEN 'kelvin ' || i
           WHEN 1 THEN chr(8490) || 'ELVIN ' || i
           WHEN 2 THEN 'B' || chr(304) || 'RNEN ' || i
           WHEN 3 THEN 'Äpfel und Birnen ' || i
           WHEN 4 THEN 'APFEL UND BIRNEN, an ASCII row longer than thirty-two bytes ' || i
       END AS s
FROM generate_series(1, 1200) AS g(i)


query
SELECT count(*) FILTER (WHERE s ILIKE '%kelvin%') AS kelvin,
       count(*) FILTER (WHERE s ILIKE 'KELVIN%') AS kelvin_prefix,
       count(*) FILTER (WHERE s ILIKE '%birnen%') AS birnen,
       count(*) FILTER (WHERE s ILIKE '%äpfel%') AS umlaut,
       count(*) FILTER (WHERE s ILIKE '%APFEL%') AS apfel,
       count(*) FILTER (WHERE s ILIKE '%thirty-two BYTES%') AS long_row,
       count(*) FILTER (WHERE s ILIKE 'b_rnen%') AS underscore,
       count(*) FILTER (WHERE s NOT ILIKE '%n%') AS not_n,
       count(*) FILTER (WHERE s ILIKE '%' || chr(8490) || '%') AS kelvin_sign,
       count(*) FILTER (WHERE s ILIKE '%1') AS suffix
FROM ilike_mixed
----
kelvin	kelvin_prefix	birnen	umlaut	apfel	long_row	underscore	not_n	kelvin_sign	suffix
400	400	600	200	200	200	200	0	400	80


query
SELECT count(*) FILTER (WHERE s ILIKE CASE id % 4 WHEN 0 THEN '%kelvin%' WHEN 1 THEN '%BIRNEN%' WHEN 2 THEN '%' || chr(304) || '%' ELSE 'äpfel%' END) AS per_row,
       count(*) FILTER (WHERE s NOT ILIKE CASE id % 4 WHEN 0 THEN '%kelvin%' WHEN 1 THEN '%BIRNEN%' WHEN 2 THEN '%' || chr(304) || '%' ELSE 'äpfel%' END) AS not_per_row
FROM ilike_mixed
----
per_row	not_per_row
600	400


