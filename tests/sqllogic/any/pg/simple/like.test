       count(*) FILTER (WHERE s ILIKE 'istanbul%') AS dotted_i,
       count(*) FILTER (WHERE s ILIKE 'kelvin%') AS kelvin,
       count(*) FILTER (WHERE s ILIKE '%BR_L_E%') AS underscores,
       count(*) FILTER (WHERE s ILIKE '_ duck%') AS duck,
       count(*) FILTER (WHERE s ILIKE '%k%') AS any_k,
       count(*) FILTER (WHERE s NOT ILIKE '%e%') AS no_e,
       count(*) FILTER (WHERE s ILIKE '%Ü%E%') AS unicode_pattern
FROM ilike_unicode
