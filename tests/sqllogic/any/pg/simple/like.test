statement ok
CREATE TABLE ilike_strs AS
SELECT i AS id,
       CASE i % 4
           WHEN 0 THEN 'The Quick Brown Fox ' || i
           WHEN 2 THEN 'the quick brown fox_' || i
           WHEN 3 THEN 'ÄPFEL UND BİRNEN ' || i
       END AS s
FROM generate_series(1, 2100) AS g(i)


statement ok
CREATE TABLE ilike_patterns AS
SELECT b.base * 10 + r.n AS id, b.base, b.p || repeat('%', r.n) AS p, b.e
FROM (VALUES (0, '%QUICK BROWN%', '\'), (1, '%fox\_%', '\'), (2, '%äpfel und birnen%', '\'), (3, 'THE QUICK BROWN FOX _1%', '\'), (4, '%foxX_%', 'X'), (5, '%FOX%', ''), (6, '%X%', 'x'), (7, NULL, '\'), (8, '%fox#_%', '#'), (9, '%fox_%', 'z')) AS b(base, p, e),
     generate_series(0, 9) AS r(n)


query
SELECT p.base,
       count(*) FILTER (WHERE s.s ILIKE p.p) AS ilike,
       count(*) FILTER (WHERE s.s NOT ILIKE p.p) AS not_ilike,
       count(*) FILTER (WHERE s.s ILIKE p.p ESCAPE p.e) AS ilike_escape,
       count(*) FILTER (WHERE s.s NOT ILIKE p.p ESCAPE p.e) AS not_ilike_escape
FROM ilike_strs AS s, ilike_patterns AS p
GROUP BY p.base
ORDER BY p.base
----
base	ilike	not_ilike	ilike_escape	not_ilike_escape
0	10500	5250	10500	5250
1	5250	10500	5250	10500
2	5250	10500	5250	10500
3	440	15310	440	15310
4	0	15750	5250	10500
5	10500	5250	10500	5250
6	10500	5250	10500	5250
7	0	0	0	0
8	0	15750	5250	10500
9	10500	5250	10500	5250


query
SELECT p.base,
       count(*) FILTER (WHERE s.s ILIKE p.p) AS ilike,
       count(*) FILTER (WHERE s.s ILIKE p.p ESCAPE p.e) AS ilike_escape
FROM ilike_strs AS s
JOIN ilike_patterns AS p ON p.id = s.id % 100
GROUP BY p.base
ORDER BY p.base
----
base	ilike	ilike_escape
0	105	105
1	63	63
2	42	42
3	2	2
4	0	42
5	105	105
6	105	105
7	0	0
8	0	42
9	105	105


