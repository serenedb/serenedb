       CASE i % 6
           WHEN 0 THEN 'Grüße aus Köln ' || i
           WHEN 1 THEN 'İstanbul ' || i
           WHEN 2 THEN chr(8490) || 'elvin ' || i
           WHEN 3 THEN 'crème brûlée ' || i
           WHEN 4 THEN '🦆 DUCK ' || i
       END AS s
FROM generate_series(1, 1200) AS g(i)


