CREATE TABLE ilike_bounds AS
SELECT i AS id, s
FROM (VALUES (1, 'a@b'), (2, 'A`B'), (3, 'z[y'), (4, 'Z{Y'),
             (5, repeat('-', 40) || 'A@B[Z' || repeat('-', 40)),
             (6, repeat('-', 40) || 'a`b{z' || repeat('-', 40))) AS t(i, s)


query
SELECT id,
       s ILIKE '%a@b%' AS at_sign,
       s ILIKE '%a`b%' AS backtick,
       s ILIKE '%z[y%' AS bracket,
       s ILIKE '%z{y%' AS brace,
       s ILIKE '%a@b[z%' AS long_at,
       s ILIKE '%A`B{Z%' AS long_backtick,
       s ILIKE '%@%' AS one_at
FROM ilike_bounds
ORDER BY id
----
id	at_sign	backtick	bracket	brace	long_at	long_backtick	one_at
1	t	f	f	f	f	f	t
2	f	t	f	f	f	f	f
3	f	f	t	f	f	f	f
4	f	f	f	t	f	f	f
5	t	f	f	f	t	f	t
6	f	t	f	f	f	t	f


query
SELECT count(*) FILTER (WHERE s ILIKE '%a@b%') AS at_sign,
       count(*) FILTER (WHERE s ILIKE '%a`b%') AS backtick,
       count(*) FILTER (WHERE s ILIKE '%z[y%') AS bracket,
       count(*) FILTER (WHERE s ILIKE '%z{y%') AS brace,
       count(*) FILTER (WHERE s ILIKE '%a@b[z%') AS long_at,
       count(*) FILTER (WHERE s ILIKE '%A`B{Z%') AS long_backtick,
       count(*) FILTER (WHERE s ILIKE '%`%') AS one_backtick
FROM ilike_bounds
----
at_sign	backtick	bracket	brace	long_at	long_backtick	one_backtick
2	2	1	1	1	1	2


