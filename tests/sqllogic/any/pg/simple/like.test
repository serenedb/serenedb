SELECT count(*) FILTER (WHERE s ILIKE '%QUICK BROWN%') AS contains,
       count(*) FILTER (WHERE s ILIKE 'the quick%') AS prefix,
       count(*) FILTER (WHERE s ILIKE '%LAZY DOG 1__') AS suffix_underscore,
       count(*) FILTER (WHERE s ILIKE '%lazy%DOG%0') AS segments,
       count(*) FILTER (WHERE s ILIKE 'QUICK\_BROWN%') AS escaped,
       count(*) FILTER (WHERE s ILIKE 'quick_brown%') AS underscore,
       count(*) FILTER (WHERE s ILIKE '%' || chr(8490) || 'elvin%') AS kelvin,
