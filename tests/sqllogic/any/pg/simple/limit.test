query
SELECT * FROM (VALUES (3), (2), (1)) t(x)
LIMIT 0;
----
x


query
SELECT * FROM (VALUES (3), (2), (1)) t(x)
OFFSET 0 LIMIT 0;
----
x


query
SELECT * FROM (VALUES (3), (2), (1)) t(x)
ORDER BY x
LIMIT 0;
----
x


query
SELECT * FROM (VALUES (3), (2), (1)) t(x)
ORDER BY x
OFFSET 0 LIMIT 0;
----
x


query
SELECT * FROM (VALUES (3), (2), (1)) t(x)
ORDER BY x
OFFSET 1 ROWS FETCH FIRST 1 ROW ONLY;
----
x
2


query
SELECT * FROM (VALUES (3), (2), (1)) t(x)
ORDER BY x
FETCH NEXT ROW ONLY;
----
x
1


statement ok
CREATE TABLE limit_nested (id INT, a INT[2]);


statement ok
INSERT INTO limit_nested VALUES (1, '{1,2}'), (2, '{2,3}'), (3, '{3,4}');


statement ok
PREPARE limit_nested_page(INT, INT) AS
SELECT a, ARRAY[id, id * 10] AS l FROM limit_nested ORDER BY id LIMIT $1 OFFSET $2;


query
EXECUTE limit_nested_page(2, 1);
----
a	l
{2,3}	{2,20}
{3,4}	{3,30}


query
SELECT a FROM limit_nested ORDER BY id LIMIT (SELECT 1);
----
a
{1,2}
