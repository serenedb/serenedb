query
SELECT * FROM
  generate_series(1, 5) as t1(x),
  generate_series(1, 5) as t2(x),
  generate_series(1, 5) as t3(x)
ORDER BY t1.x, t2.x, t3.x
LIMIT 5;
----
x	x	x
1	1	1
1	1	2
1	1	3
1	1	4
1	1	5


query
SELECT *
FROM
(
  SELECT *
  FROM
  (
    VALUES (1337), (228), (993), (111), (222), (333), (444)
  )
  LIMIT 3
) ORDER BY column1;
----
column1
228
993
1337


