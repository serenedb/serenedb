query
SELECT trunc('08:00:2b:01:02:03'::macaddr) AS trunc6,
       trunc('08:00:2b:01:02:03:04:05'::macaddr8) AS trunc8,
       macaddr8_set7bit('08:00:2b:01:02:03:04:05'::macaddr8) AS set7bit;
----
trunc6	trunc8	set7bit
08:00:2b:00:00:00	08:00:2b:00:00:00:00:00	0a:00:2b:01:02:03:04:05


query
SELECT ~'08:00:2b:01:02:03'::macaddr AS not6,
       '08:00:2b:01:02:03'::macaddr & 'ff:ff:ff:00:00:00'::macaddr AS and6,
       '08:00:2b:01:02:03'::macaddr | '00:00:00:ff:ff:ff'::macaddr AS or6,
       ~'08:00:2b:01:02:03:04:05'::macaddr8 AS not8;
----
not6	and6	or6	not8
f7:ff:d4:fe:fd:fc	08:00:2b:00:00:00	08:00:2b:ff:ff:ff	f7:ff:d4:fe:fd:fc:fb:fa


statement ok
CREATE TABLE mac_t (id INT, m macaddr, m8 macaddr8);


statement ok
INSERT INTO mac_t VALUES (1, '08:00:2b:01:02:03', '08:00:2b:01:02:03:04:05'), (2, '00:00:00:00:00:01', NULL), (3, NULL, '00:00:00:00:00:00:00:01'), (4, 'ff:ff:ff:ff:ff:ff', 'ff:ff:ff:ff:ff:ff:ff:ff');


query
SELECT id, m, m8 FROM mac_t ORDER BY m NULLS FIRST, id;
----
id	m	m8
3	NULL	00:00:00:00:00:00:00:01
2	00:00:00:00:00:01	NULL
1	08:00:2b:01:02:03	08:00:2b:01:02:03:04:05
4	ff:ff:ff:ff:ff:ff	ff:ff:ff:ff:ff:ff:ff:ff


query
SELECT id FROM mac_t WHERE m > '08:00:2b:00:00:00' AND m8 >= '08:00:2b:01:02:03:04:05' ORDER BY id;
----
id
1
4


query
SELECT m::text AS m_text, m8::text AS m8_text FROM mac_t WHERE id = 1;
----
m_text	m8_text
08:00:2b:01:02:03	08:00:2b:01:02:03:04:05


query
SELECT pg_typeof(m)::text AS m_type, pg_typeof(m8)::text AS m8_type FROM mac_t WHERE id = 1;
----
m_type	m8_type
macaddr	macaddr8


statement ok
COPY mac_t TO '${__TEST_DIR__}/mac_t.bin' (FORMAT binary);


