       '08:00:2b:ff:fe:01:02:03'::macaddr8::macaddr AS narrowed,
       macaddr8('08:00:2b:01:02:03'::macaddr) AS widened_fn,
       macaddr('08:00:2b:ff:fe:01:02:03'::macaddr8) AS narrowed_fn;
