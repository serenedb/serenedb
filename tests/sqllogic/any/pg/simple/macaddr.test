query
SELECT pg_input_is_valid('08:00:2b:01:02:0g', 'macaddr') AS a, pg_input_is_valid('08:00:2b:01:02: ', 'macaddr') AS b,
       pg_input_is_valid('08002b01020', 'macaddr') AS c, pg_input_is_valid('0xz8:00:2b:01:02:03', 'macaddr') AS d,
       pg_input_is_valid('08:00:2b:01:02:03:04:05:06', 'macaddr8') AS e, pg_input_is_valid('08:00:2b:01:02:0g', 'macaddr8') AS f,
       pg_input_is_valid('08:00:2b:01:02:03 x', 'macaddr8') AS g, pg_input_is_valid('08:00:2b:01:02:03:04:05 x', 'macaddr8') AS h,
       pg_input_is_valid('08:00:2b:01 02:03', 'macaddr8') AS i, pg_input_is_valid('   ', 'macaddr8') AS j;
----
a	b	c	d	e	f	g	h	i	j
f	f	t	f	f	f	f	f	f	f


query
SELECT '+8:0:2b:1:2:3'::macaddr AS a, '0x08:0X00:2b:01:02:03'::macaddr AS b, '08:00:2b:01:02:03  '::macaddr AS c,
       '  08:00:2b:01:02:03:04:05'::macaddr8 AS d, '08:00:2b:01:02:03  '::macaddr8 AS e,
       '08:00:2b:01:02:03:04:05 '::macaddr8 AS f;
