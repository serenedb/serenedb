control substitution on

query
SELECT '08:00:2b:01:02:03'::macaddr AS colon,
       '08-00-2b-01-02-03'::macaddr AS dash,
       '08002b:010203'::macaddr AS half_colon,
       '08002b-010203'::macaddr AS half_dash,
       '0800.2b01.0203'::macaddr AS dot,
       '0800-2b01-0203'::macaddr AS pair_dash,
       '08002b010203'::macaddr AS bare,
       ' 8:0:2B:1:2:3 '::macaddr AS short_upper;
----
colon	dash	half_colon	half_dash	dot	pair_dash	bare	short_upper
08:00:2b:01:02:03	08:00:2b:01:02:03	08:00:2b:01:02:03	08:00:2b:01:02:03	08:00:2b:01:02:03	08:00:2b:01:02:03	08:00:2b:01:02:03	08:00:2b:01:02:03


