# Degree trig functions

query
SELECT sind(30) + 0.01;
----
?column?
0.5<slt:ignore>


query
SELECT cosd(60);
----
cosd
0.5<slt:ignore>


query
SELECT tand(45) + 0.01;
----
?column?
1.<slt:ignore>


query
SELECT cotd(45) + 0.01;
----
?column?
1.<slt:ignore>


query
SELECT asind(0.5) + 0.01;
----
?column?
30.<slt:ignore>


query
SELECT acosd(0.5) + 0.01;
----
?column?
60.<slt:ignore>


query
SELECT atand(1);
----
atand
45


query
SELECT atan2d(1, 0);
----
atan2d
90


query
SELECT sind(30) AS s30, cosd(60) AS c60, tand(45) AS t45, cotd(45) AS ct45, sind(180) AS s180, cosd(90) AS c90, tand(90) AS t90, cotd(180) AS ct180, cotd(360) AS ct360, asind(0.5) AS as05, acosd(0.5) AS ac05;
----
s30	c60	t45	ct45	s180	c90	t90	ct180	ct360	as05	ac05
0.5	0.5	1	1	0	0	Infinity	-Infinity	Infinity	30	60


query
SELECT sind(-30) AS s, cosd(-120) AS c, tand(-45) AS t, asind(-0.5) AS a, acosd(-0.5) AS ac, atand(-1) AS at, atan2d(1, 1) AS at2;
----
s	c	t	a	ac	at	at2
-0.5	-0.5	-1	-30	120	-45	45


query
SELECT sind('NaN'::float8) AS s, acosd('NaN'::float8) AS a, atan2d('NaN'::float8, 1) AS t;
----
s	a	t
NaN	NaN	NaN


statement error
SELECT sind('Infinity'::float8);
----
db error: ERROR: input is out of range


statement error
SELECT asind(1.5);
----
db error: ERROR: input is out of range


