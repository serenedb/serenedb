# Tests for additional math functions


# Hyperbolic functions

query
SELECT cosh(0);
----
cosh
1


query
SELECT sinh(0);
----
sinh
0


query
SELECT tanh(0);
----
tanh
0


query
SELECT acosh(1);
----
acosh
0


query
SELECT asinh(0);
----
asinh
0


query
SELECT atanh(0);
----
atanh
0


# log10

query
SELECT log10(1000);
----
log10
3


query
