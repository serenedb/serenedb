SELECT 1000000::float4::text AS a, 999999::float4::text AS b, 123456789::float4::text AS c,
       1234567.5::float4::text AS d, 0.0001::float4::text AS e, 0.00009::float4::text AS f, 123456.5::float4::text AS g;
