query
SELECT width_bucket(5.35, 0.024, 10.06, 5) AS inside, width_bucket(-1, 0, 10, 5) AS below, width_bucket(10, 0, 10, 5) AS at_end,
       width_bucket(5, 10, 0, 5) AS descending, width_bucket(11, 10, 0, 5) AS above_descending,
       width_bucket(0, 10, 0, 5) AS at_descending_end, width_bucket(0.5e-30, -1, 1e-30, 10) AS rounds_to_last,
       width_bucket(1e308, -1e308, 1.5e308, 4) AS huge_bounds, width_bucket(-1e308, 1e308, -1.5e308, 4) AS huge_descending,
       width_bucket('infinity', 0, 10, 5) AS infinite_operand, width_bucket(5, 10, 0, 2147483647) AS wide;
----
