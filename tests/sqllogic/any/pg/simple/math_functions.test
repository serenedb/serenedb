query
SELECT random_normal(10, 0) AS fixed, random_normal() IS NOT NULL AS standard, random_normal(5) IS NOT NULL AS mean_only;
----
fixed	standard	mean_only
10	t	t


query
SELECT abs(avg(v)) < 0.05 AS centered, stddev(v) BETWEEN 0.95 AND 1.05 AS spread
FROM (SELECT random_normal() AS v FROM generate_series(1, 100000)) AS t;
----
centered	spread
t	t


query
SELECT count(DISTINCT random_normal(0, 1)) = 10 AS per_row FROM generate_series(1, 10);
----
per_row
t


statement ok
SELECT setseed(0.25);


statement ok
CREATE TABLE random_normal_first AS SELECT random_normal() AS v;


statement ok
SELECT setseed(0.25);


statement ok
CREATE TABLE random_normal_second AS SELECT random_normal() AS v;


query
SELECT (SELECT v FROM random_normal_first) = (SELECT v FROM random_normal_second) AS same;
----
same
t


statement ok
DROP TABLE random_normal_first;


statement ok
DROP TABLE random_normal_second;


query
SELECT 1e15::float8::text AS a, 999999999999999::float8::text AS b, 1234567890123456.7::float8::text AS c,
       0.0001::float8::text AS d, 0.00009::float8::text AS e, (-1e15)::float8::text AS f, 1e16::float8::text AS g,
       '-0'::float8::text AS h, 0.5::float8::text AS i, 'x' || 1e15::float8 AS j;
----
a	b	c	d	e	f	g	h	i	j
1e+15	999999999999999	1.2345678901234568e+15	0.0001	9e-05	-1e+15	1e+16	-0	0.5	x1e+15


