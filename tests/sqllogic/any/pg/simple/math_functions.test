# |/ and ||/

query
SELECT |/ 16.0 AS sqrt, |/ 2::float8 AS sqrt2, ||/ 8.0 AS cbrt, ||/ -8.0 AS cbrt_negative, ||/ 1000.0 AS cbrt_1000,
       pg_typeof(|/ 16) AS type;
----
sqrt	sqrt2	cbrt	cbrt_negative	cbrt_1000	type
4	1.4142135623730951	2	-2	10	double precision


