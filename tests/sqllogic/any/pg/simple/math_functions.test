query
SELECT width_bucket(5, ARRAY[1, 3, 7]) AS w, width_bucket(0, ARRAY[1, 3, 7]) AS w_low, width_bucket(7, ARRAY[1, 3, 7]) AS w_edge,
       width_bucket(5.5, ARRAY[1.0, 5.5]) AS w_num, width_bucket(DATE '2020-06-01', ARRAY[DATE '2020-01-01', DATE '2021-01-01']) AS w_date,
       width_bucket('m', ARRAY['a', 'n', 'z']) AS w_text;
----
w	w_low	w_edge	w_num	w_date	w_text
2	0	3	2	1	1


