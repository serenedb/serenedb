a	b	c
{"$1,234.50",$2.00,NULL}	("$1,234.50",-$2.00)	money


query
SELECT ARRAY[ROW('1234.5'::money)] AS a, ROW(ARRAY['1234.5'::money]) AS b, ARRAY[ROW('2'::money)] AS c, ROW(ARRAY['2'::money]) AS d;
