query
SELECT '12.345'::money AS a, '12.344'::money AS b, '-12.345'::money AS c, '(1.5)'::money AS d, '1,000'::money AS e,
       '$ 1'::money AS f, '- $1'::money AS g, '1-'::money AS h, ''::money AS i, '$'::money AS j, '1.2,3'::money AS k,
       ' 7 '::money AS l, '+5'::money AS m, '5+'::money AS n, '$5$'::money AS o, '0.005'::money AS p, '0.0049'::money AS q;
----
