query
SELECT '1.00'::money + '2.50'::money AS a, '1'::money - '2.5'::money AS b, '10'::money * 3 AS c, 3 * '10'::money AS d,
       '10'::money * 2::int2 AS e, 2::int2 * '10'::money AS f, '10'::money * 3000000::int8 AS g, '0.03'::money * 0.5::float8 AS h,
       '0.05'::money * 0.5::float8 AS i, '0.05'::money * 0.5::float4 AS j, 0.5::float8 * '0.03'::money AS k;
