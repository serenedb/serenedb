query
SELECT '1'::money < '2'::money AS a, '1'::money = '$1.00'::money AS b, '3'::money >= '2'::money AS c,
       '1'::money <> '1'::money AS d, '1'::money IN ('1', '2') AS e, coalesce(NULL::money, '0') AS f;
----
a	b	c	d	e	f
t	t	t	f	t	$0.00


query
SELECT cash_words('1234567.89'::money) AS a, cash_words('-0.01'::money) AS b, cash_words('100'::money) AS c,
       cash_words('110'::money) AS d, cash_words('1'::money) AS e, cash_words('0.99'::money) AS f;
----
a	b	c	d	e	f
One million two hundred thirty four thousand five hundred sixty seven dollars and eighty nine cents	Minus zero dollars and one cent	One hundred dollars and zero cents	One hundred and ten dollars and zero cents	One dollar and zero cents	Zero dollars and ninety nine cents


query
SELECT cash_words('21'::money) AS a, cash_words('120'::money) AS b, cash_words('999.5'::money) AS c,
       cash_words('1000'::money) AS d, cash_words('1000000'::money) AS e, cash_words('30.3'::money) AS f;
----
a	b	c	d	e	f
Twenty one dollars and zero cents	One hundred twenty dollars and zero cents	Nine hundred ninety nine dollars and fifty cents	One thousand  dollars and zero cents	One million  dollars and zero cents	Thirty dollars and thirty cents


