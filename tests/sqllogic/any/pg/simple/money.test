statement ok
CREATE TABLE money_t (id INT, m money);


statement ok
INSERT INTO money_t VALUES (1, '$1,234.50'), (2, 5), (3, 2.555), (4, NULL), (5, '-0.01');


query
SELECT id, m FROM money_t ORDER BY m NULLS FIRST, id;
----
id	m
4	NULL
5	-$0.01
3	$2.56
2	$5.00
1	$1,234.50


statement ok
UPDATE money_t SET m = m * 2 WHERE id = 2;


query
SELECT sum(m) AS s, min(m) AS mn, max(m) AS mx, count(m) AS c FROM money_t;
----
s	mn	mx	c
$1,247.05	-$0.01	$1,234.50	4


query
SELECT id FROM money_t WHERE m > '$5' ORDER BY id;
----
id
1
2


query
SELECT m::text AS t, pg_typeof(m) AS ty FROM money_t WHERE id = 1;
----
t	ty
$1,234.50	money


query
SELECT id, m / 3 AS third, m * 1.5 AS half_again FROM money_t WHERE m IS NOT NULL ORDER BY id;
----
id	third	half_again
1	$411.50	$1,851.75
2	$3.33	$15.00
3	$0.85	$3.84
5	$0.00	-$0.02


query
SELECT m, count(*) AS c FROM money_t GROUP BY m ORDER BY m NULLS LAST;
----
m	c
-$0.01	1
$2.56	1
$10.00	1
$1,234.50	1
NULL	1


statement ok
DROP TABLE money_t;


query
SELECT 2::int2 * '$1'::money AS a, 2 * '$1'::money AS b, 2::int8 * '$1'::money AS c, 1.5::float4 * '$1'::money AS d,
       1.5::float8 * '$1'::money AS e, '$1'::money / -1 AS f, '$1'::money / -1::int2 AS g, '$1'::money / -1::int8 AS h,
       sum('$1'::money) AS i
FROM generate_series(1, 3);
----
a	b	c	d	e	f	g	h	i
$2.00	$2.00	$2.00	$1.50	$1.50	-$1.00	-$1.00	-$1.00	$3.00


