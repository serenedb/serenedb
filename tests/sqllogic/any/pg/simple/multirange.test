query
SELECT range_agg(r) AS a, range_agg(r) FILTER (WHERE r IS NULL) IS NULL AS b,
       range_agg(r) FILTER (WHERE isempty(r)) AS c, range_intersect_agg(r) AS d
FROM (VALUES (int4range(1, 5)), (int4range(3, 8)), (int4range(10, 12)), (NULL), ('empty'::int4range)) t(r);
----
a	b	c	d
{[1,8),[10,12)}	t	{}	empty


query
SELECT range_intersect_agg(r) AS a, range_agg(m) AS b, range_intersect_agg(m) AS c
FROM (VALUES (int4range(1, 10), '{[1,3), [5,7)}'::int4multirange), (int4range(2, 8), '{[2,6)}'::int4multirange),
             (int4range(3, 12), '{[0,20)}'::int4multirange)) t(r, m);
