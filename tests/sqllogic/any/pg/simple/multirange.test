a	b	c
[3,8)	{[0,20)}	{[2,3),[5,6)}


query
SELECT g, range_agg(r) AS a, range_intersect_agg(r) AS b
FROM (VALUES (1, int4range(1, 5)), (1, int4range(5, 8)), (2, int4range(1, 3)), (2, int4range(2, 9)),
             (3, NULL::int4range)) t(g, r)
GROUP BY g ORDER BY g;
