query
SELECT bool_and(m = int4multirange(int4range(greatest(i - 40, 1), i + 1))) AS a, count(*) AS n
FROM (SELECT i, range_agg(int4range(i, i + 1)) OVER (ORDER BY i ROWS BETWEEN 40 PRECEDING AND CURRENT ROW) AS m
      FROM generate_series(1, 100) AS i) t;
----
a	n
t	100
