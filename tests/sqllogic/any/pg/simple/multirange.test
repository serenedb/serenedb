query
SELECT '{}'::int4multirange AS a, '{[1,3)}'::int4multirange AS b, '{[1,3), [5,7)}'::int4multirange AS c,
       '{[5,7),[1,3)}'::int4multirange AS d, '{[1,3),[2,6)}'::int4multirange AS e, '{[1,3),[3,5)}'::int4multirange AS f,
       '{empty}'::int4multirange AS g, '{[1,3),empty,[5,7)}'::int4multirange AS h,
       '  { [1,3) , (,2] }  '::int4multirange AS i, '{(,)}'::int4multirange AS j, '{[1,1)}'::int4multirange AS k,
       '{EMPTY, [2,4]}'::int4multirange AS l, '{["1","3")}'::int4multirange AS m, '{ }'::int4multirange AS n;
----
a	b	c	d	e	f	g	h	i	j	k	l	m	n
{}	{[1,3)}	{[1,3),[5,7)}	{[1,3),[5,7)}	{[1,6)}	{[1,5)}	{}	{[1,3),[5,7)}	{(,3)}	{(,)}	{}	{[2,5)}	{[1,3)}	{}


