query
SELECT pg_typeof(NULLIF(53, 1.5)) AS t, NULLIF(53, 1.5) / 2 = 26.5 AS d, pg_typeof(NULLIF(1.5, 53)) AS u,
       NULLIF(NULL::int, 1) AS n, pg_typeof(NULLIF('a'::text, 'a'::varchar)) AS s;
----
t	d	u	n	s
numeric	t	numeric	NULL	text


query
SELECT NULLIF(5, 5.5) / 2 > 2.4 AS promoted, pg_typeof(NULLIF('7', 7)) AS t, NULLIF(1, NULL::int) AS kept;
----
promoted	t	kept
t	integer	1


query
SELECT i, NULLIF(i % 3, 0) AS n, NULLIF((i % 3)::text, '1') AS s, NULLIF(ARRAY[i % 2], ARRAY[0]) AS a,
       NULLIF(ROW(i % 2, 'x'::text), ROW(0, 'x'::text)) IS NULL AS r, NULLIF(i, -1) AS kept, NULLIF(i % 1, 0) AS gone,
       NULLIF(2, i % 3) AS c, NULLIF(NULLIF(i, 1) % 3, 0) AS z, NULLIF(repeat('x', 12) || (i % 2)::text, repeat('x', 12) || '0') AS l
FROM generate_series(1, 6) AS g(i)
ORDER BY i
----
i	n	s	a	r	kept	gone	c	z	l
1	1	NULL	{1}	f	1	NULL	2	NULL	xxxxxxxxxxxx1
2	2	2	NULL	t	2	NULL	NULL	2	NULL
3	NULL	0	{1}	f	3	NULL	2	NULL	xxxxxxxxxxxx1
4	1	NULL	NULL	t	4	NULL	2	1	NULL
5	2	2	{1}	f	5	NULL	NULL	2	xxxxxxxxxxxx1
6	NULL	0	NULL	t	6	NULL	2	NULL	NULL


query
SELECT k, v, NULLIF(v, 2) AS n, v AS again
FROM (VALUES (1, 2), (2, NULL), (3, 3), (4, 2)) AS t(k, v)
ORDER BY k
----
k	v	n	again
1	2	NULL	2
2	NULL	NULL	NULL
3	3	3	3
4	2	NULL	2


query
SELECT count(NULLIF(i % 3, 0)) AS n, sum(NULLIF(i % 3, 0)) AS s,
       count(NULLIF(repeat('y', 12) || (i % 2)::text, repeat('y', 12) || '0')) AS l
FROM generate_series(1, 5000) AS g(i)
----
n	s	l
3334	5001	2500


statement ok
PREPARE nullif_param AS SELECT NULLIF($1, 5) AS n;


query
EXECUTE nullif_param(5);
----
n
NULL


query
EXECUTE nullif_param(6);
----
n
6


statement ok
DEALLOCATE nullif_param;
