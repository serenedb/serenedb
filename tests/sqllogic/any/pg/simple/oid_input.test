query
SELECT '-1'::oid AS a, '0x1F'::oid AS b, '010'::oid AS c, ' 12 '::oid AS d, '4294967295'::oid AS e, '-2147483648'::oid AS f;
----
a	b	c	d	e	f
4294967295	31	8	12	4294967295	2147483648


query
SELECT '{1,010,-1}'::oid[] AS oids, '{0/1,FF/0}'::pg_lsn[] AS lsns;
----
oids	lsns
{1,8,4294967295}	{0/1,FF/0}


