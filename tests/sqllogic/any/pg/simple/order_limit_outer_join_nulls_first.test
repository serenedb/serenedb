statement ok
CREATE TABLE oljnf_l AS SELECT i AS id, i AS c FROM generate_series(0, 199999) g(i)

statement ok
CREATE TABLE oljnf_r AS SELECT i * 20 AS id FROM generate_series(0, 9999) g(i)

query
SELECT l.c, count(*) FROM oljnf_l l FULL JOIN oljnf_r r ON l.id = r.id GROUP BY l.c ORDER BY l.c NULLS FIRST LIMIT 3
----
c	count
0	1
1	1
2	1

query
SELECT DISTINCT l.c FROM oljnf_l l FULL JOIN oljnf_r r ON l.id = r.id ORDER BY l.c NULLS FIRST LIMIT 3
----
c
0
1
2

query
SELECT l.c, count(*) FROM oljnf_l l RIGHT JOIN oljnf_r r ON l.id = r.id GROUP BY l.c ORDER BY l.c NULLS FIRST LIMIT 3
