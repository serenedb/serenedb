statement ok
SET TimeZone = 'UTC';

query
SELECT id, (s1, e1) OVERLAPS (s2, e2) AS o
FROM (VALUES (1, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-05', TIMESTAMP '2020-01-04', TIMESTAMP '2020-01-02'),
             (2, TIMESTAMP '2020-01-01', NULL, TIMESTAMP '2020-01-02', TIMESTAMP '2020-01-03'),
             (3, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02', TIMESTAMP '2020-01-03', NULL),
             (4, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02', TIMESTAMP '2020-01-01', NULL),
             (5, TIMESTAMP '2020-01-05', TIMESTAMP '2020-01-06', TIMESTAMP '2020-01-01', NULL),
             (6, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02', NULL, TIMESTAMP '2020-01-03'),
             (7, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-03', TIMESTAMP '2020-01-02', TIMESTAMP '2020-01-04'),
             (8, TIMESTAMP '2020-01-01', NULL, TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02')) v(id, s1, e1, s2, e2)
ORDER BY id;
----
id	o
1	t
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL
7	t
8	NULL

