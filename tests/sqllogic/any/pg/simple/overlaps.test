query
SELECT (TIME '01:00', INTERVAL '2 hours') OVERLAPS (TIME '02:00', INTERVAL '1 hour') AS a,
       (TIME '01:00', TIME '03:00') OVERLAPS (TIME '02:00', INTERVAL '1 hour') AS b,
       (TIME '01:00', INTERVAL '1 hour') OVERLAPS (TIME '01:30', TIME '04:00') AS c,
       (NULL::time, INTERVAL '1 hour') OVERLAPS (TIME '01:30', TIME '04:00') AS d,
       (TIME '01:00', NULL::interval) OVERLAPS (TIME '00:30', TIME '04:00') AS e;
----
a	b	c	d	e
t	t	t	NULL	t

query
SELECT (TIMESTAMP '2020-01-01', INTERVAL '2 days') OVERLAPS (TIMESTAMP '2020-01-02', INTERVAL '1 day') AS a,
       (TIMESTAMP '2020-01-01', INTERVAL '1 day') OVERLAPS (TIMESTAMP '2020-01-01 12:00', TIMESTAMP '2020-01-04') AS b,
       (NULL::timestamp, INTERVAL '1 day') OVERLAPS (TIMESTAMP '2020-01-01', INTERVAL '1 day') AS c,
       (DATE '2020-01-01', DATE '2020-01-05') OVERLAPS (DATE '2020-01-04', DATE '2020-01-02') AS d,
       (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02') OVERLAPS (TIMESTAMP '2020-01-01 12:00', INTERVAL '1 day') AS e,
       (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-02') OVERLAPS (TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-03') AS f;
----
a	b	c	d	e	f
t	t	NULL	t	t	t

query
SELECT (TIMESTAMPTZ '2020-01-01 00:00+00', INTERVAL '2 days') OVERLAPS (TIMESTAMPTZ '2020-01-02 00:00+00', INTERVAL '1 day') AS a,
       (TIMESTAMPTZ '2020-01-01 00:00+00', INTERVAL '1 day') OVERLAPS (TIMESTAMPTZ '2020-01-01 12:00+00', TIMESTAMPTZ '2020-01-04 00:00+00') AS b,
       (TIMESTAMPTZ '2020-01-01 00:00+00', TIMESTAMPTZ '2020-01-02 00:00+00') OVERLAPS (TIMESTAMPTZ '2020-01-01 12:00+00', INTERVAL '1 day') AS c,
       (NULL::timestamptz, INTERVAL '1 day') OVERLAPS (TIMESTAMPTZ '2020-01-01 00:00+00', INTERVAL '1 day') AS d;
----
a	b	c	d
t	t	t	NULL


