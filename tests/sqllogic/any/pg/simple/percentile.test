query
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY x), percentile_disc(0.5) WITHIN GROUP (ORDER BY x)
FROM (VALUES (1), (2), (3), (4)) t(x)
----
percentile_cont	percentile_disc
2.5	2


query
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY x) AS cont,
       pg_typeof(percentile_cont(0.5) WITHIN GROUP (ORDER BY x))::text AS cont_type,
       percentile_disc(0.5) WITHIN GROUP (ORDER BY x) AS disc,
       pg_typeof(percentile_disc(0.5) WITHIN GROUP (ORDER BY x))::text AS disc_type
FROM (VALUES (1.50), (2.25), (3.00)) t(x)
----
cont	cont_type	disc	disc_type
2.25	double precision	2.25	numeric


query
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY x) AS cont,
       pg_typeof(percentile_cont(0.5) WITHIN GROUP (ORDER BY x))::text AS cont_type
FROM (VALUES (0.1::real), (0.2::real)) t(x)
----
cont	cont_type
0.15000000223517418	double precision


query
SELECT g, percentile_cont(0.1) WITHIN GROUP (ORDER BY x) AS a, percentile_cont(0.3) WITHIN GROUP (ORDER BY x) AS b,
       percentile_cont(0.9) WITHIN GROUP (ORDER BY x) AS c
FROM (VALUES (1, 477 / 7.0::float8), (1, 73.0::float8), (2, 290 / 7.0::float8), (2, 210.0::float8)) t(g, x)
GROUP BY g
ORDER BY g
----
g	a	b	c
1	68.62857142857142	69.6	72.51428571428572
2	58.28571428571429	92	193.1428571428571


statement ok
CREATE TABLE pct_intervals (g int, x interval)


statement ok
INSERT INTO pct_intervals VALUES
  (1, '1 mon'), (1, '2 mons 3 days'),
  (2, '0 days'), (2, '60 days'),
  (3, '23 hours'), (3, '25 hours'),
  (4, '1 day'), (4, '2 days'), (4, '4 days')


query
SELECT g, percentile_cont(0.5) WITHIN GROUP (ORDER BY x),
       pg_typeof(percentile_cont(0.5) WITHIN GROUP (ORDER BY x))::text AS t,
       percentile_cont(ARRAY[0.25, 0.75]) WITHIN GROUP (ORDER BY x) AS quartiles,
       percentile_disc(0.5) WITHIN GROUP (ORDER BY x)
FROM pct_intervals
GROUP BY g
ORDER BY g
----
g	percentile_cont	t	quartiles	percentile_disc
1	1 mon 16 days 12:00:00	interval	{"1 mon 8 days 06:00:00","1 mon 24 days 18:00:00"}	1 mon
2	30 days	interval	{"15 days","45 days"}	00:00:00
3	24:00:00	interval	{23:30:00,24:30:00}	23:00:00
4	2 days	interval	{"1 day 12:00:00","3 days"}	2 days


query
SELECT percentile_cont(0.25) WITHIN GROUP (ORDER BY x DESC) AS cont,
       percentile_disc(0.25) WITHIN GROUP (ORDER BY x DESC) AS disc,
       percentile_cont(ARRAY[0.25, 0.5, 0.75]) WITHIN GROUP (ORDER BY x) AS cont_list,
       percentile_disc(ARRAY[0.25, 0.5, 0.75]) WITHIN GROUP (ORDER BY x) AS disc_list
FROM (VALUES (1), (2), (3), (4)) t(x)
----
cont	disc	cont_list	disc_list
3.25	4	{1.75,2.5,3.25}	{1,2,3}


query
SELECT percentile_disc(ARRAY[0.1, 0.9]) WITHIN GROUP (ORDER BY x) AS letters,
       percentile_disc(0.5) WITHIN GROUP (ORDER BY x DESC) AS last_letter
FROM (VALUES ('a'), ('b'), ('c')) t(x)
----
letters	last_letter
{a,c}	b


query
SELECT percentile_cont(NULL) WITHIN GROUP (ORDER BY x) AS cont,
       percentile_disc(NULL) WITHIN GROUP (ORDER BY x) AS disc,
       percentile_cont(ARRAY[0.25, NULL, 0.75]) WITHIN GROUP (ORDER BY x) AS cont_list,
       percentile_disc(ARRAY[NULL, 0.5]) WITHIN GROUP (ORDER BY x DESC) AS disc_list,
       percentile_cont(NULL::float8[]) WITHIN GROUP (ORDER BY x) AS null_list
FROM (VALUES (1), (2), (3), (4)) t(x)
----
cont	disc	cont_list	disc_list	null_list
NULL	NULL	{1.75,NULL,3.25}	{NULL,3}	NULL


query
SELECT g, percentile_cont(NULL) WITHIN GROUP (ORDER BY x) AS cont,
       percentile_cont(0.5) WITHIN GROUP (ORDER BY x) AS median
FROM (VALUES (1, 1), (1, 3), (2, 10)) t(g, x)
GROUP BY g
ORDER BY g
----
g	cont	median
1	NULL	2
2	NULL	10


query
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY x) AS cont,
       percentile_disc(0.5) WITHIN GROUP (ORDER BY x) AS disc,
       percentile_cont(ARRAY[0.5]) WITHIN GROUP (ORDER BY x) AS cont_list
FROM (VALUES (1)) t(x)
WHERE false
