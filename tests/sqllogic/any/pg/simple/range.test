statement ok
CREATE TABLE range_t (id INT, r int4range, d daterange);


statement ok
INSERT INTO range_t VALUES (1, '[1,5)', '[2020-01-01,2020-02-01)'), (2, 'empty', NULL), (3, NULL, '(,2020-01-01]'), (4, '[10,)', 'empty');


query
SELECT id, r, d FROM range_t ORDER BY id;
----
id	r	d
1	[1,5)	[2020-01-01,2020-02-01)
2	empty	NULL
3	NULL	(,2020-01-02)
4	[10,)	empty


query
SELECT id FROM range_t WHERE r @> 3 OR d @> '2019-06-01'::date ORDER BY id;
----
id
1
3


query
SELECT id FROM range_t ORDER BY r, id;
----
id
2
1
4
3


statement ok
DROP TABLE range_t;


