query
SELECT tsrange('2020-01-01', '2020-01-02') -|- tsrange('2020-01-02', '2020-01-03') AS a,
       tsrange('2020-01-01', '2020-01-02', '[]') -|- tsrange('2020-01-02', '2020-01-03') AS b,
       daterange('2020-01-01', '2020-01-02', '[]') -|- daterange('2020-01-03', '2020-01-05') AS c,
       tsrange('2020-01-01', '2020-01-05') * tsrange('2020-01-03', '2020-01-10') AS d,
       tsrange('2020-01-01', '2020-01-02', '(]') -|- tsrange('2020-01-02', '2020-01-03', '(]') AS e,
       daterange('2020-01-01', '2020-01-02') @> '2020-01-01'::date AS f;
----
a	b	c	d	e	f
t	f	t	["2020-01-03 00:00:00","2020-01-05 00:00:00")	t	t


