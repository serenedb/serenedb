query
SELECT int4range(1, 5) AS a, int4range(1, 5, '[]') AS b, int4range(NULL, 5) AS c, int4range(1, NULL, '()') AS d,
       int4range(NULL, NULL) AS e, int8range(1, 5, '(]') AS f, daterange('2020-01-01', '2020-01-03', '[]') AS g,
       tsrange('2020-01-01', '2020-01-02') AS h, int4range(3, 3) AS i;
----
a	b	c	d	e	f	g	h	i
[1,5)	[1,6)	(,5)	[2,)	(,)	[2,6)	[2020-01-01,2020-01-04)	["2020-01-01 00:00:00","2020-01-02 00:00:00")	empty


query
SELECT i, lower(r) AS lower, upper(r) AS upper, isempty(r) AS isempty, lower_inc(r) AS lower_inc, upper_inc(r) AS upper_inc,
       lower_inf(r) AS lower_inf, upper_inf(r) AS upper_inf
FROM (VALUES (1, '[1,5)'::int4range), (2, 'empty'::int4range), (3, '(,5]'::int4range), (4, '[3,)'::int4range)) t(i, r)
ORDER BY i;
----
i	lower	upper	isempty	lower_inc	upper_inc	lower_inf	upper_inf
1	1	5	f	t	f	f	f
2	NULL	NULL	t	f	f	f	f
3	NULL	6	f	f	f	t	f
4	3	NULL	f	t	f	f	t


query
SELECT lower(daterange('2020-01-01', '2020-01-03', '(]')) AS a, upper(tsrange('2020-01-01', NULL)) AS b,
       upper(daterange('2020-01-01', 'infinity')) AS c, upper_inf(daterange('2020-01-01', 'infinity')) AS d;
----
a	b	c	d
2020-01-02	NULL	infinity	f


query
SELECT int4range(1,5) @> 3 AS a, int4range(1,5) @> 5 AS b, 3 <@ int4range(1,5) AS c, int4range(1,10) @> int4range(2,3) AS d,
       int4range(2,3) <@ int4range(1,10) AS e, int4range(1,5) && int4range(4,8) AS f, int4range(1,5) && int4range(5,8) AS g,
       int4range(1,5) << int4range(5,8) AS h, int4range(5,8) >> int4range(1,5) AS i, int4range(1,5) &< int4range(2,6) AS j,
       int4range(1,5) &> int4range(0,6) AS k, int4range(1,5) -|- int4range(5,8) AS l, 'empty'::int4range @> 'empty'::int4range AS m,
       int4range(1,5) @> 'empty'::int4range AS n, 'empty'::int4range <@ int4range(1,5) AS o, 'empty'::int4range && int4range(1,5) AS p;
----
a	b	c	d	e	f	g	h	i	j	k	l	m	n	o	p
t	f	t	t	t	t	f	t	t	t	t	t	t	t	t	f


query
SELECT int4range(1,5) + int4range(5,8) AS a, int4range(1,5) + int4range(3,8) AS b, int4range(1,5) * int4range(3,8) AS c,
       int4range(1,5) * int4range(6,8) AS d, int4range(1,8) - int4range(5,9) AS e, int4range(1,8) - int4range(0,3) AS f,
       int4range(1,8) - int4range(10,20) AS g, int4range(1,8) - int4range(0,20) AS h, range_merge(int4range(1,3), int4range(6,8)) AS i,
       'empty'::int4range + int4range(1,2) AS j, int4range(NULL, 3) + int4range(2, NULL) AS k;
----
a	b	c	d	e	f	g	h	i	j	k
[1,8)	[1,8)	[3,5)	empty	[1,5)	[3,8)	[1,8)	empty	[1,8)	[1,2)	(,)


