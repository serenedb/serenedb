control substitution on

query
SELECT '[1,5)'::int4range AS a, '(1,5]'::int4range AS b, '[1,5]'::int4range AS c, '(1,5)'::int4range AS d,
       'empty'::int4range AS e, '(,5)'::int4range AS f, '[1,)'::int4range AS g, '(,)'::int4range AS h,
       '[,5]'::int4range AS i, '  [ 1, 5 )  '::int4range AS j, 'EMPTY'::int4range AS k, '(1,2)'::int4range AS l,
       '[3,3]'::int4range AS m, '[3,3)'::int4range AS n, '["1","5")'::int4range AS o;
----
a	b	c	d	e	f	g	h	i	j	k	l	m	n	o
[1,5)	[2,6)	[1,6)	[2,5)	empty	(,5)	[1,)	(,)	(,6)	[1,5)	empty	empty	[3,4)	empty	[1,5)


query
SELECT '[1,5)'::int8range AS a, '(,9223372036854775806]'::int8range AS b, '[2020-01-01,2020-01-05]'::daterange AS c,
       '(2020-01-01,infinity)'::daterange AS d, '[-infinity,2020-01-01)'::daterange AS e,
       '["2020-01-01 10:00","2020-01-01 12:00")'::tsrange AS f, '[2020-01-01,)'::tsrange AS g,
       '(2020-01-01,2020-01-02)'::daterange AS i;
----
a	b	c	d	e	f	g	i
[1,5)	(,9223372036854775807)	[2020-01-01,2020-01-06)	[2020-01-02,infinity)	[-infinity,2020-01-01)	["2020-01-01 10:00:00","2020-01-01 12:00:00")	["2020-01-01 00:00:00",)	empty


statement ok
SET TimeZone = 'UTC'


query
SELECT '["2020-01-01 10:00+02","2020-01-01 12:00+02")'::tstzrange AS a, tstzrange('2020-01-01 10:00+00', NULL) AS b,
       tstzrange('2020-01-01 10:00+00', '2020-01-01 10:00+00', '[]') AS c;
----
a	b	c
["2020-01-01 08:00:00+00","2020-01-01 10:00:00+00")	["2020-01-01 10:00:00+00",)	["2020-01-01 10:00:00+00","2020-01-01 10:00:00+00"]


statement ok
RESET TimeZone


