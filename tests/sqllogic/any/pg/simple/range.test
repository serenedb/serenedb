query
SELECT a.id, b.id AS other
FROM (VALUES (1, '[1,5)'::int4range), (2, '[4,8)'), (3, '[10,12)')) a(id, r)
JOIN (VALUES (10, '[1,4]'::int4range), (20, '[4,7]')) b(id, r) ON a.r = b.r
ORDER BY a.id, other;
----
id	other
1	10
2	20


query
SELECT '[1,5)'::int4range <= '[1,5)'::int4range AS a, '[1,5)'::int4range >= '[1,6)'::int4range AS b,
       int4range(NULL, 5) && int4range(4, NULL) AS c, int4range(NULL, 5) << int4range(5, NULL) AS d,
       int4range(NULL, NULL) @> int4range(NULL, 5) AS e, range_merge('empty'::int4range, int4range(1, 2)) AS f,
       int4range(1, 5) - 'empty'::int4range AS g, 'empty'::int4range - int4range(1, 5) AS h,
       int4range(1, 5) * 'empty'::int4range AS i, int4range(1, 5) -|- 'empty'::int4range AS j;
----
a	b	c	d	e	f	g	h	i	j
t	f	t	t	t	[1,2)	[1,5)	empty	empty	f


