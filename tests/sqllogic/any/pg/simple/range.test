query
SELECT '{"[1,3)","(5,7]",NULL,empty}'::int4range[] AS a, '{"[2020-01-01,2020-01-05)"}'::daterange[] AS b,
       ('{"[1,3)","(5,7]"}'::int4range[])[2] AS c, '{"[1,2]","(,)"}'::int8range[] AS d;
