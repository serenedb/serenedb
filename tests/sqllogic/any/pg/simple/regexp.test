# regexp_match: no capture groups — returns full match
query
SELECT regexp_match('foobarbequebaz', 'bar.*que');
----
regexp_match
{barbeque}


# regexp_match: capture groups — returns groups
query
SELECT regexp_match('foobarbequebaz', '(bar)(beque)');
----
regexp_match
{bar,beque}


# regexp_match: no match — returns NULL
query
SELECT regexp_match('foobarbequebaz', 'xyz');
----
regexp_match
NULL


# regexp_match: single capture group
query
SELECT regexp_match('abc01234xyz', '(\d+)');
----
regexp_match
{01234}


# regexp_match: subscript into result
query
SELECT (regexp_match('foobarbequebaz', '(bar)(beque)'))[1];
----
regexp_match
bar


query
SELECT (regexp_match('foobarbequebaz', '(bar)(beque)'))[2];
----
regexp_match
beque


# regexp_count: count matches
query
SELECT regexp_count('ABCABCAXYaxy', 'A.');
----
regexp_count
3


query
SELECT regexp_count('hello world', 'o');
----
regexp_count
2


query
SELECT regexp_count('hello', 'xyz');
----
regexp_count
0


# regexp_instr: position of first match (1-based)
query
SELECT regexp_instr('number of your street, town zip, FR', '[^,]+', 1, 2);
----
regexp_instr
23


query
SELECT regexp_instr('hello world', 'world');
----
regexp_instr
7


query
SELECT regexp_instr('hello', 'xyz');
----
regexp_instr
0


# regexp_substr: first matching substring
query
SELECT regexp_substr('number of your street, town zip, FR', '[^,]+');
----
regexp_substr
number of your street


query
SELECT regexp_substr('hello world', '\w+');
----
regexp_substr
hello


# regexp_substr: no match — returns NULL
query
SELECT regexp_substr('hello', 'xyz');
----
regexp_substr
NULL


# regexp_split_to_array
query
SELECT regexp_split_to_array('the quick brown fox', '\s+');
----
regexp_split_to_array
{the,quick,brown,fox}


query
SELECT regexp_split_to_array('one-two-three', '-');
----
regexp_split_to_array
{one,two,three}


# regexp_count with start position (3-arg)
query
SELECT regexp_count('123456789012', '\d\d\d', 2);
----
regexp_count
3


# regexp_substr with start position (3-arg)
query
SELECT regexp_substr('hello world hello', 'hello', 2);
----
regexp_substr
hello


# regexp_instr with UTF-8 multi-byte strings

query
SELECT regexp_instr('абвгд', 'вг');
----
regexp_instr
3

query
SELECT regexp_instr('hello мир world', 'мир');
----
regexp_instr
7


# regexp_instr4 with UTF-8 start position

query
SELECT regexp_instr('абвгд абвгд', 'абв', 3, 1);
----
regexp_instr
7


# regexp_count with UTF-8 start position

query
SELECT regexp_count('абв абв абв', 'абв', 5);
----
regexp_count
2


# regexp_substr with UTF-8 start position

query
SELECT regexp_substr('абв деф абв', 'абв', 2);
----
regexp_substr
абв


# empty-match advancement must step by 1 UTF-8 character, not 1 byte

# regexp_count with empty pattern on multi-byte UTF-8 string:
# An empty pattern matches before every character and after the last one,
# so the count should equal char_length + 1.
query
SELECT regexp_count('абв', '');
----
regexp_count
4


query
SELECT regexp_count('café', '');
----
regexp_count
5


# regexp_instr with empty pattern: Nth empty match on a UTF-8 string
# Empty pattern matches at positions 1, 2, 3, ... (before each character)
query
SELECT regexp_instr('абвгд', '', 1, 3);
----
regexp_instr
3


query
SELECT regexp_instr('абвгд', '', 1, 5);
----
regexp_instr
5

# regexp_count with empty pattern and UTF-8 start position
query
SELECT regexp_count('абвгд', '', 3);
----
regexp_count
4


# regexp_match over a column, with a constant pattern and a pattern per row
statement ok
CREATE TABLE regexp_match_rows (id INT PRIMARY KEY, txt VARCHAR, pat VARCHAR)


statement count 6
INSERT INTO regexp_match_rows VALUES
  (1, 'row 1 code 17', 'code (\d+)'),
  (2, 'row 2 code 29', '(\d+) code'),
  (3, 'no digits', 'code (\d+)'),
  (4, NULL, 'code (\d+)'),
  (5, 'row 5 code 42', NULL),
  (6, 'код 7 code 8', '(код) (\d)')


query
SELECT id, regexp_match(txt, 'code (\d+)') FROM regexp_match_rows ORDER BY id
----
id	regexp_match
1	{17}
2	{29}
3	NULL
4	NULL
5	{42}
6	{8}


query
SELECT id, regexp_match(txt, pat) FROM regexp_match_rows ORDER BY id
----
id	regexp_match
1	{17}
2	{2}
3	NULL
4	NULL
5	NULL
6	{код,7}


query
SELECT id, regexp_match(txt, NULL) FROM regexp_match_rows ORDER BY id
----
id	regexp_match
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL


query
SELECT count(*) FROM generate_series(1, 5000) AS g(i)
WHERE (regexp_match('item ' || i::text, 'item (\d+)'))[1] = i::text
----
count
5000


# an invalid constant pattern fails on the first row it is applied to
statement ok
CREATE TABLE regexp_match_empty (txt VARCHAR)


query
SELECT count(regexp_match(txt, '(')) FROM regexp_match_empty
----
count
0


statement error
SELECT regexp_match(txt, '(') FROM regexp_match_rows
----
db error: ERROR: invalid regular expression: <slt:ignore>
