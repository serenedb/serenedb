# Tests for pg_*_size functions


# Setup

statement ok
CREATE TABLE size_test (id INT PRIMARY KEY, data TEXT)


statement ok
INSERT INTO size_test VALUES (1, 'hello'), (2, 'world')


# pg_relation_size (regclass)

query
SELECT pg_relation_size('size_test') >= 0 AS ok;
----
ok
t


query
SELECT pg_relation_size('size_test', 'main') >= 0 AS ok;
----
ok
t


query
SELECT pg_relation_size('size_test', 'fsm') = 0 AS ok;
----
ok
t


query
SELECT pg_relation_size('size_test', 'vm') = 0 AS ok;
----
ok
t


query
SELECT pg_relation_size('size_test', 'init') = 0 AS ok;
----
ok
t


# pg_relation_size with explicit regclass cast

query
SELECT pg_relation_size('size_test'::regclass) >= 0 AS ok;
----
ok
t


query
SELECT pg_relation_size('size_test'::regclass, 'main') >= 0 AS ok;
----
ok
t


# pg_total_relation_size (regclass)

query
SELECT pg_total_relation_size('size_test') >= 0 AS ok;
----
ok
t


# pg_indexes_size (regclass)

query
SELECT pg_indexes_size('size_test') >= 0 AS ok;
----
ok
t


# pg_table_size (regclass)

query
SELECT pg_table_size('size_test') >= 0 AS ok;
----
ok
t


# pg_database_size (name)

query
SELECT pg_database_size(current_database()) >= 0 AS ok;
----
ok
t


# pg_database_size (oid)

query
SELECT pg_database_size(d.oid) >= 0 AS ok FROM pg_database d WHERE d.datname = current_database();
----
ok
t


statement error
SELECT pg_database_size(999999::oid);
----
db error: ERROR: database with OID 999999 does not exist


# Verify unknown->regclass implicit coercion (text->regclass is castcontext='i' in pg_cast.dat)

query
SELECT pg_relation_size('size_test'::text) >= 0 AS ok;
----
ok
t


# Verify unknown->name implicit coercion for pg_database_size

query
SELECT pg_database_size(current_database()::name) >= 0 AS ok;
----
ok
t


statement ok
CREATE INDEX size_test_data_idx ON size_test (data)


statement ok
CREATE SEQUENCE size_test_seq


statement ok
CREATE VIEW size_test_view AS SELECT id FROM size_test


query
SELECT c.relname, pg_relation_size(c.oid) > 0 AS own, pg_table_size(c.oid) > 0 AS tab,
  pg_indexes_size(c.oid) > 0 AS idx, pg_total_relation_size(c.oid) > 0 AS total
FROM pg_class c WHERE c.relname IN ('size_test', 'size_test_pkey', 'size_test_data_idx')
ORDER BY 1;
----
relname	own	tab	idx	total
size_test	t	t	t	t
size_test_data_idx	t	t	f	t
size_test_pkey	t	t	f	t


query
SELECT pg_relation_size(c.oid), pg_table_size(c.oid), pg_indexes_size(c.oid),
  pg_total_relation_size(c.oid)
FROM pg_class c WHERE c.relname = 'size_test_view';
----
pg_relation_size	pg_table_size	pg_indexes_size	pg_total_relation_size
0	0	0	0


query
SELECT pg_relation_size('size_test_seq'::regclass) >= 0 AS own,
  pg_indexes_size('size_test_seq'::regclass) AS idx;
----
own	idx
t	0


query
SELECT pg_relation_size('pg_catalog.pg_class'::regclass) >= 0 AS own,
  pg_total_relation_size('pg_catalog.pg_class'::regclass) >= 0 AS total;
----
own	total
t	t


query
SELECT pg_relation_size(4000000000), pg_table_size(4000000000),
  pg_indexes_size(4000000000), pg_total_relation_size(4000000000),
  pg_relation_size(4000000000, 'main');
----
pg_relation_size	pg_table_size	pg_indexes_size	pg_total_relation_size	pg_relation_size
NULL	NULL	NULL	NULL	NULL


statement ok
DROP VIEW size_test_view


statement ok
DROP SEQUENCE size_test_seq


# Cleanup

statement ok
DROP TABLE size_test
