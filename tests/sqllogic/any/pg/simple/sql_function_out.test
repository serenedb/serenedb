query
SELECT p.proname, p.prorettype::regtype::text AS rettype, p.proretset, p.pronargs, array_to_string(p.proallargtypes::regtype[], ',') AS alltypes, array_to_string(p.proargmodes, ',') AS modes, array_to_string(p.proargnames, ',') AS names, pg_get_function_arguments(p.oid) AS args, pg_get_function_result(p.oid) AS result FROM pg_proc p WHERE p.pronamespace = 'fno'::regnamespace AND p.proname <> 'unnamed' ORDER BY 1;
----
proname	rettype	proretset	pronargs	alltypes	modes	names	args	result
doubled	bigint	f	1	integer,bigint	i,o	a,b	a integer, OUT b bigint	bigint
pairs	record	t	1	integer,integer,text	i,o,o	a,x,y	a integer, OUT x integer, OUT y text	SETOF record
rec	record	f	1	integer,integer,integer	i,o,o	a,b,c	a integer, OUT b integer, OUT c integer	record
split	record	f	1	integer,integer,text	i,o,o	a,b,c	a integer, OUT b integer, OUT c text	record
swap	record	f	1	integer,text	b,o	a,b	INOUT a integer, OUT b text	record
upto	integer	t	1	integer,integer	i,o	a,n	a integer, OUT n integer	SETOF integer


