CREATE FUNCTION fnp.as_interval() RETURNS interval LANGUAGE sql AS 'SELECT ''01:02:03''::time';


query
SELECT fnp.doubled(21) AS a, fnp.plus_one(41) AS b, fnp.as_name()::text AS c, array_to_string(fnp.text_list(), ',') AS d, fnp.as_interval()::text AS e;
----
a	b	c	d	e
42	42	abc	1,2	01:02:03


