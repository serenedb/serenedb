CREATE FUNCTION fnp_twice_when(c boolean, x int) RETURNS int LANGUAGE sql RETURN CASE WHEN c THEN x + x ELSE 0 END;


query
SELECT i, fnp_twice_when(i > 0, 10 / i) AS a, fnp_twice_when(i > 0, fnp_twice_when(true, 10 / i)) AS b FROM generate_series(0, 2) t(i) ORDER BY i;
----
i	a	b
0	0	0
1	20	40
2	10	20


