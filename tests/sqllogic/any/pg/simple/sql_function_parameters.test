statement ok
CREATE FUNCTION fnp.count_named_below(v text) RETURNS bigint LANGUAGE sql AS 'SELECT count(*) FROM fnp.named_rows WHERE named_rows.v < $1';


statement ok
CREATE FUNCTION fnp.count_named_atomic(v text) RETURNS bigint LANGUAGE sql BEGIN ATOMIC SELECT count(*) FROM fnp.named_rows WHERE named_rows.v < $1; END;


query
SELECT fnp.count_named_below('c') AS a, fnp.count_named_atomic('b') AS b;
----
a	b
2	1


