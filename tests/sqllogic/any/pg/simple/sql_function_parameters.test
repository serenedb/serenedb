CREATE FUNCTION fnp_pair(x bigint, y bigint) RETURNS bigint LANGUAGE sql AS 'SELECT x + x + y FROM (VALUES (1)) v(c)';


query
SELECT i, fnp_max_below(i + 1) AS a, fnp_count_plus(i + 1) AS b, fnp_sum(i + 1) AS c, fnp_nested_sum(i + 1) AS d, fnp_grouped(i + 1) AS e, fnp_cte(i + 1) AS f FROM generate_series(0, 2) t(i) ORDER BY i;
----
i	a	b	c	d	e	f
0	1	2	3	3	3	2
1	3	3	6	6	6	4
2	5	4	9	9	9	6


query
SELECT (SELECT fnp_pair(i + 1, x) FROM (VALUES (2)) w(i)) AS a FROM (SELECT 5 AS x) t;
----
a
11


