CREATE FUNCTION fnr.too_big() RETURNS smallint LANGUAGE sql RETURN 100000;


query
SELECT pg_typeof(fnr.widened()) AS a, fnr.widened() AS b, pg_typeof(fnr.widened_select()) AS c, fnr.maybe(-1) IS NULL AS d, pg_typeof(fnr.maybe(1)) AS e;
----
a	b	c	d	e
bigint	1	bigint	t	bigint


query
SELECT fnr.as_text() AS a, pg_typeof(fnr.as_text()) AS b, fnr.as_varchar() AS c, fnr.rounded() AS d, fnr.as_real() AS e, pg_typeof(fnr.as_real()) AS f;
----
a	b	c	d	e	f
42	text	abcdef	5	1.5	real


query
SELECT pg_typeof(fnr.as_numeric(5)) AS a, fnr.keeps_scale() AS b, pg_typeof(fnr.keeps_scale()) AS c, fnr.as_date() AS d, pg_typeof(fnr.as_date()) AS e;
----
a	b	c	d	e
numeric	1.23456	numeric	2024-03-05	date


