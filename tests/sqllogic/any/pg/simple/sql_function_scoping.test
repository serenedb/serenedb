CREATE SEQUENCE sfs.seq;


statement ok
CREATE FUNCTION sfs.twice(x bigint) RETURNS bigint LANGUAGE sql AS 'SELECT x + x FROM (VALUES (1)) v(one)';


query
SELECT sfs.twice(nextval('sfs.seq')) AS v FROM generate_series(1, 3) ORDER BY v;
----
v
2
4
6


statement ok
CREATE FUNCTION sfs.next() RETURNS bigint LANGUAGE sql AS 'SELECT nextval(''sfs.seq'') FROM (VALUES (1)) v(one)';


query
SELECT count(DISTINCT sfs.next()) AS distinct_values FROM generate_series(1, 3);
----
distinct_values
3


