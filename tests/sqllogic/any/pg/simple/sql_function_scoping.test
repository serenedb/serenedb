CREATE FUNCTION sfs.strict_one(x int) RETURNS int LANGUAGE sql STRICT AS 'SELECT coalesce(x, 0) + 1';


statement ok
CREATE FUNCTION sfs.null_input(x int, y int) RETURNS int LANGUAGE sql RETURNS NULL ON NULL INPUT AS 'SELECT coalesce(x, 0) + coalesce(y, 0)';


statement ok
CREATE FUNCTION sfs.called(x int) RETURNS int LANGUAGE sql CALLED ON NULL INPUT AS 'SELECT coalesce(x, 0) + 1';


statement ok
CREATE FUNCTION sfs.strict_set(x int) RETURNS SETOF int LANGUAGE sql STRICT AS 'SELECT coalesce(x, 0) UNION ALL SELECT 7';


statement ok
CREATE FUNCTION sfs.strict_return(x int) RETURNS int LANGUAGE sql STRICT RETURN coalesce(x, 0) + 1;


query
SELECT
    sfs.strict_one(NULL) AS strict_null,
    sfs.strict_one(1) AS strict_one,
    sfs.null_input(1, NULL) AS null_input,
    sfs.called(NULL) AS called,
    sfs.strict_return(NULL) AS strict_return,
    (SELECT count(*) FROM sfs.strict_set(NULL)) AS set_null,
    (SELECT count(*) FROM sfs.strict_set(1)) AS set_one;
----
strict_null	strict_one	null_input	called	strict_return	set_null	set_one
NULL	2	NULL	1	NULL	0	2


query
SELECT x, sfs.strict_one(x) AS result FROM (VALUES (1), (NULL)) v(x) ORDER BY x NULLS LAST;
----
x	result
1	2
NULL	NULL


query
SELECT p.proname, p.proisstrict
FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
WHERE n.nspname = 'sfs' AND p.proname IN ('strict_one', 'null_input', 'called', 'strict_return')
ORDER BY p.proname;
----
proname	proisstrict
called	f
null_input	t
strict_one	t
strict_return	t


query
SELECT trim(regexp_replace(pg_get_functiondef('sfs.strict_one'::regproc), '[[:space:]]+', ' ', 'g')) AS definition;
----
definition
CREATE OR REPLACE FUNCTION sfs.strict_one(x integer) RETURNS integer LANGUAGE sql STRICT AS $function$SELECT coalesce(x, 0) + 1$function$


