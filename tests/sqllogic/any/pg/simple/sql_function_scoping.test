query
SELECT
    (SELECT array_agg(v ORDER BY v) FROM sfs.col(5) v) AS col,
    (SELECT array_agg(v ORDER BY v) FROM sfs.qualified(5) v) AS qualified,
    (SELECT array_agg(v ORDER BY v) FROM sfs.outer_level(5) v) AS outer_level,
    (SELECT array_agg(v ORDER BY v) FROM sfs.param(5) v) AS param;
----
col	qualified	outer_level	param
{10,20}	{6,7}	{10,20}	{15,25}


query
SELECT
    (SELECT array_agg(v) FROM sfs.order_alias(5) v) AS order_alias,
    (SELECT array_agg(v ORDER BY v) FROM sfs.where_param(1) v) AS where_one,
    (SELECT array_agg(v ORDER BY v) FROM sfs.where_param(0) v) AS where_zero,
    sfs.sum_col(5) AS sum_col,
    sfs.sum_param(5) AS sum_param,
    sfs.text_param('a') AS text_param;
----
order_alias	where_one	where_zero	sum_col	sum_param	text_param
{-2,-1}	{1,2}	NULL	30	10	10


