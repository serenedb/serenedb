# Tests for additional string functions


# starts_with

query
SELECT starts_with('alphabet', 'alph');
----
starts_with
t


query
SELECT starts_with('alphabet', 'xyz');
----
starts_with
f


query
SELECT starts_with('alphabet', '');
----
starts_with
t


query
SELECT starts_with('', '');
----
starts_with
t


# concat_ws

query
SELECT concat_ws(',', 'a', 'b', 'c');
----
concat_ws
a,b,c


query
SELECT concat_ws(',', 'a', NULL, 'c');
----
concat_ws
a,c


query
SELECT concat_ws(' - ', 'hello', 'world');
----
concat_ws
hello - world


# initcap

query
SELECT initcap('hi THOMAS');
----
initcap
Hi Thomas


query
SELECT initcap('hello world');
----
initcap
Hello World


# repeat

query
SELECT repeat('Pg', 4);
----
repeat
PgPgPgPg


query
SELECT repeat('abc', 0);
----
repeat
(empty)


# translate

query
SELECT translate('12345', '143', 'ax');
----
translate
a2x5


# ascii

query
SELECT ascii('x');
----
ascii
120


query
SELECT ascii('A');
----
ascii
65


# left

query
SELECT left('abcde', 2);
----
left
ab


query
SELECT left('abcde', 10);
----
left
abcde


# right

query
SELECT right('abcde', 2);
----
right
de


