SELECT right('abcde', 10);
----
right
abcde


# overlay

query
SELECT overlay('Txxxxas' placing 'hom' from 2 for 4);
----
overlay
Thomas


# md5

query
SELECT md5('abc');
----
md5
900150983cd24fb0d6963f7d28e17f72


query
SELECT md5('');
----
md5
d41d8cd98f00b204e9800998ecf8427e


# to_hex

query
SELECT to_hex(2147483647);
----
to_hex
7fffffff


query
SELECT to_hex(0);
----
to_hex
0


query
SELECT to_hex(1);
----
to_hex
1


query
SELECT to_hex(10);
----
to_hex
a


query
SELECT to_hex(100);
----
to_hex
64


query
SELECT to_hex(-1);
----
to_hex
ffffffff


query
SELECT to_hex(0::bigint);
----
to_hex
0


query
SELECT to_hex(1::bigint);
----
to_hex
1


query
SELECT to_hex(100::bigint);
----
to_hex
64


query
SELECT to_hex(-1::bigint);
----
to_hex
ffffffffffffffff


# bit_length

query
SELECT bit_length('jose');
----
bit_length
32


# octet_length

query
SELECT octet_length('jose');
----
octet_length
