# btrim

query
SELECT btrim('  xyz  '), btrim('xyxtrimyyx', 'xy'), btrim('', 'x'), btrim('abc', '');
----
btrim	btrim	btrim	btrim
xyz	trim	(empty)	abc


query
SELECT length(btrim(chr(160) || ' x ' || chr(160))), btrim('éaxé', 'é');
----
length	btrim
5	ax


query
SELECT btrim(NULL), btrim('x', NULL), btrim(NULL::bytea, '\x00'::bytea);
----
btrim	btrim	btrim
NULL	NULL	NULL


query
SELECT btrim('\x1234567890'::bytea, '\x9012'::bytea), btrim('\x0101'::bytea, '\x01'::bytea), btrim('\x01'::bytea, ''::bytea);
----
btrim	btrim	btrim
\\x345678	\\x	\\x01


# ltrim, rtrim and trim remove spaces only, and work on bytea

query
SELECT length(ltrim(chr(160) || ' x ')), length(rtrim(' x ' || chr(12288))), length(trim(chr(160) || ' x ' || chr(160))), '[' || trim(BOTH FROM '  x  ') || ']';
----
length	length	length	?column?
4	4	5	[x]


query
SELECT ltrim('\x010203'::bytea, '\x01'::bytea), rtrim('\x010203'::bytea, '\x03'::bytea), trim('\x03'::bytea FROM '\x030103'::bytea), trim(LEADING '\x00'::bytea FROM '\x000100'::bytea), pg_typeof(ltrim('\x01'::bytea, '\x01'::bytea));
----
ltrim	rtrim	btrim	ltrim	pg_typeof
\\x0203	\\x0102	\\x01	\\x0100	bytea


# LIKE on bytea

query
SELECT 'abc'::bytea LIKE 'a%'::bytea, 'abc'::bytea NOT LIKE 'a_c'::bytea, '\x41c3a9'::bytea LIKE 'A_'::bytea, '\x41c3a9'::bytea LIKE 'A__'::bytea, 'a%c'::bytea LIKE 'a\\%c'::bytea;
----
?column?	?column?	?column?	?column?	?column?
t	f	f	t	t


statement error (LIKE pattern must not end with escape character|escape)
SELECT 'ab'::bytea LIKE 'a\\'::bytea;


# casefold

query
SELECT casefold('PostgreSQL'), casefold('ÀÉÎ Straße'), casefold(''), casefold(NULL);
----
casefold	casefold	casefold	casefold
postgresql	àéî straße	(empty)	NULL


# convert

query
SELECT convert('text_in_utf8'::bytea, 'UTF8', 'LATIN1'), convert('\xc3a9'::bytea, 'UTF8', 'LATIN1'), convert('\xe9'::bytea, 'LATIN1', 'UTF8');
----
convert	convert	convert
\\x746578745f696e5f75746638	\\xe9	\\xc3a9


query
SELECT convert('\xc3a9'::bytea, 'utf-8', 'iso_8859_1'), convert('\xe9ff'::bytea, 'latin1', 'sql_ascii'), convert('\x61'::bytea, 'SQL_ASCII', 'UTF8'), convert(''::bytea, 'UTF8', 'WIN1252');
----
convert	convert	convert	convert
\\xe9	\\xe9ff	\\x61	\\x


query
SELECT convert(NULL, 'UTF8', 'LATIN1'), convert('\x61'::bytea, NULL, 'LATIN1'), convert('\x61'::bytea, 'UTF8', NULL);
----
convert	convert	convert
NULL	NULL	NULL


statement error
SELECT convert('\x61'::bytea, 'nope', 'UTF8');
----
db error: ERROR: invalid source encoding name "nope"


statement error
SELECT convert('\x61'::bytea, 'UTF8', 'nope');
----
db error: ERROR: invalid destination encoding name "nope"


statement error
SELECT convert('\xe282'::bytea, 'UTF8', 'LATIN1');
----
db error: ERROR: invalid byte sequence for encoding "UTF8": 0xe2 0x82


statement error
SELECT convert('\x61ff62'::bytea, 'UTF8', 'LATIN1');
----
db error: ERROR: invalid byte sequence for encoding "UTF8": 0xff


statement error
SELECT convert('\x6100'::bytea, 'LATIN1', 'UTF8');
----
db error: ERROR: invalid byte sequence for encoding "LATIN1": 0x00


statement error
SELECT convert('\x61e282ac'::bytea, 'UTF8', 'LATIN1');
----
db error: ERROR: character with byte sequence 0xe2 0x82 0xac in encoding "UTF8" has no equivalent in encoding "LATIN1"


statement error
SELECT convert('\xff'::bytea, 'SQL_ASCII', 'UTF8');
----
db error: ERROR: invalid byte sequence for encoding "UTF8": 0xff


query
SELECT convert_from('\xe4'::bytea, 'LATIN1'), convert_from('\x616263'::bytea, 'Unicode'), convert_to('é', 'LATIN1'), convert_to('abc', 'sql_ascii');
----
convert_from	convert_from	convert_to	convert_to
ä	abc	\\xe9	\\x616263


statement error
SELECT convert_from('\xc328'::bytea, 'UTF8');
----
db error: ERROR: invalid byte sequence for encoding "UTF8": 0xc3 0x28


statement error
SELECT convert_to('€', 'LATIN1');
----
db error: ERROR: character with byte sequence 0xe2 0x82 0xac in encoding "UTF8" has no equivalent in encoding "LATIN1"


statement error
SELECT convert_from('\x61'::bytea, 'nope');
----
db error: ERROR: invalid source encoding name "nope"


# crc32 / crc32c

query
SELECT crc32(''::bytea), crc32('The quick brown fox jumps over the lazy dog'::bytea), crc32('\x00ff'::bytea), crc32(NULL);
----
crc32	crc32	crc32	crc32
0	1095738169	1826356594	NULL


query
SELECT crc32c(''::bytea), crc32c('The quick brown fox jumps over the lazy dog'::bytea), crc32c('\x00ff'::bytea), crc32c(NULL);
----
crc32c	crc32c	crc32c	crc32c
0	576848900	1545348227	NULL


# is_normalized / normalize

query
SELECT is_normalized('a' || chr(776)), is_normalized(chr(228)), is_normalized('a' || chr(776), 'NFD'), is_normalized(chr(64257), 'nfkc'), is_normalized('', 'NFKD'), is_normalized(NULL);
----
is_normalized	is_normalized	is_normalized	is_normalized	is_normalized	is_normalized
f	t	t	f	t	NULL


query
SELECT normalize('a' || chr(776)) = chr(228), length(normalize(chr(228), NFD)), normalize(chr(64257) || 'x', NFKC), normalize(chr(64257) || 'x', NFKD), normalize(NULL);
----
?column?	length	normalize	normalize	normalize
t	2	fix	fix	NULL


statement error
SELECT is_normalized('abc', 'nfx');
----
db error: ERROR: invalid normalization form: nfx


# like / notlike

query
SELECT like('Serene', 'Ser%'), like('Serene_DB', 'Serene\_DB'), like('abc', 'a_'), notlike('Serene', 'Ser%'), notlike('abc', 'a_'), like(NULL, 'x'), notlike('x', NULL);
----
like	like	like	notlike	notlike	like	notlike
t	t	f	f	t	NULL	NULL


query
SELECT like('abc'::bytea, 'a%'::bytea), like('a_c'::bytea, 'a\\_c'::bytea), like('abc'::bytea, 'a\\_c'::bytea), notlike('abc'::bytea, 'b%'::bytea), like(NULL::bytea, 'a'::bytea);
----
like	like	like	notlike	like
t	t	f	t	NULL


query
SELECT like('Abc'::name, 'A%'), notlike('Abc'::name, 'A%');
----
like	notlike
t	f


# parse_ident

query
SELECT parse_ident('SomeSchema.SomeTable'), parse_ident('"SomeSchema".someTable'), parse_ident(' a . "b""c" . d '), parse_ident('ünï.x$1');
----
parse_ident	parse_ident	parse_ident	parse_ident
{someschema,sometable}	{SomeSchema,sometable}	{a,"b\\"c",d}	{ünï,x$1}



query
SELECT parse_ident('a.b junk', false), parse_ident('a(1)', false), parse_ident(NULL), parse_ident('a', NULL);
----
parse_ident	parse_ident	parse_ident	parse_ident
{a,b}	{a}	NULL	NULL


statement error
SELECT parse_ident('a.b junk');
----
db error: ERROR: string is not a valid identifier: "a.b junk"


statement error
SELECT parse_ident('a.');
----
db error: ERROR: string is not a valid identifier: "a."
DETAIL: No valid identifier after ".".


statement error
SELECT parse_ident('.a');
----
db error: ERROR: string is not a valid identifier: ".a"
DETAIL: No valid identifier before ".".


statement error
SELECT parse_ident('"a');
----
db error: ERROR: string is not a valid identifier: ""a"
DETAIL: String has unclosed double quotes.


statement error
SELECT parse_ident('""');
----
db error: ERROR: string is not a valid identifier: """"
DETAIL: Quoted identifier must not be empty.


statement error
SELECT parse_ident('');
----
db error: ERROR: string is not a valid identifier: ""


statement error
SELECT parse_ident('1a');
----
db error: ERROR: string is not a valid identifier: "1a"


# sha224 / sha384 / sha512

