SELECT id, substring(s from p) AS m
FROM (VALUES (1, 'abc', 'b'), (2, 'abc', '(c)'), (3, 'abc', 'x'), (4, NULL, 'a'), (5, 'abc', NULL)) t(id, s, p)
ORDER BY id
