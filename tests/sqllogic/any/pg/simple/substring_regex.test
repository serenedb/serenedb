query
SELECT substring('abc' from 'b.') AS a, substring('abc', 'b.') AS b, substring('ac' from 'a(b)?c') IS NULL AS c,
       substring('abc' from 'a(b)?c') AS d, substring('xyz' from 'a(b)?c') IS NULL AS e, substring('foobar' from 'o+') AS f,
       substring('héllo' from 'é.') AS j
----
a	b	c	d	e	f	j
bc	bc	t	b	t	oo	él


