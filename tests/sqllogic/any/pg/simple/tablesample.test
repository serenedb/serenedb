statement ok
CREATE TABLE tablesample_t AS SELECT i FROM generate_series(1, 1000) t(i)


query
SELECT count(*) AS n FROM tablesample_t TABLESAMPLE SYSTEM (100)
----
n
1000


query
SELECT count(*) AS n FROM tablesample_t TABLESAMPLE BERNOULLI (100)
----
n
1000


query
SELECT count(*) AS n FROM tablesample_t TABLESAMPLE BERNOULLI (0)
----
n
0


query
SELECT count(*) AS n FROM tablesample_t TABLESAMPLE SYSTEM (0) REPEATABLE (7)
----
n
0


query
SELECT count(*) BETWEEN 1 AND 999 AS partial FROM tablesample_t TABLESAMPLE BERNOULLI (50) REPEATABLE (7)
----
partial
t


statement ok
