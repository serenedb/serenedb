query
SELECT '(1,2)'::tid = '(1,2)'::tid AS eq, '(1,2)'::tid < '(1,3)'::tid AS lt, '(1,9)'::tid < '(2,0)'::tid AS block_first;
----
eq	lt	block_first
t	t	t


query
SELECT pg_input_is_valid('(1)', 'tid') AS a, pg_input_is_valid('((1,2)', 'tid') AS b,
       pg_input_is_valid('(99999999999999999999,1)', 'tid') AS c, pg_input_is_valid('(1,99999999999999999999)', 'tid') AS d,
       pg_input_is_valid('(1,2', 'tid') AS e, pg_input_is_valid('(1,2x)', 'tid') AS f, pg_input_is_valid('(1,-1)', 'tid') AS g,
       pg_input_is_valid('(1,  ', 'tid') AS h, pg_input_is_valid('(1', 'tid') AS i;
----
a	b	c	d	e	f	g	h	i
f	f	f	f	f	f	f	f	f


query
SELECT '(1,-0)'::tid AS a, '(+1,2)'::tid AS b, '(-0,3)'::tid AS c;
----
a	b	c
(1,0)	(1,2)	(0,3)


