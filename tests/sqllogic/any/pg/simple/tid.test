control substitution on

query
SELECT '(0,1)'::tid AS a, '(4294967295,65535)'::tid AS b, '(12,0)'::tid::text AS c;
----
a	b	c
(0,1)	(4294967295,65535)	(12,0)


query
SELECT '{"(1,2)","(3,4)"}'::tid[] AS tids, '{08:00:2b:01:02:03,08-00-2b-01-02-04}'::macaddr[] AS macs, '(,4)'::tid AS empty_block, '(-1,1)'::tid AS wrapped;
----
tids	macs	empty_block	wrapped
{"(1,2)","(3,4)"}	{08:00:2b:01:02:03,08:00:2b:01:02:04}	(0,4)	(4294967295,1)


query
SELECT ARRAY[ROW('(1,2)'::tid)] AS rec_arr, ROW(ARRAY['(1,2)'::tid]) AS arr_rec;
----
rec_arr	arr_rec
{"(\\"(1,2)\\")"}	("{""(1,2)""}")


