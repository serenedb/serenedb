query
SELECT to_char(TIMESTAMP '2024-03-05 14:07:09.123456', 'YYYY-MM-DD HH24:MI:SS') AS a, to_char(TIMESTAMP '2024-03-05 14:07:09.123456', 'YYYY-MM-DD"T"HH24:MI:SS.MS') AS b, to_char(TIMESTAMP '2024-03-05 14:07:09', 'HH12:MI AM') AS c, to_char(TIMESTAMP '2024-03-05 04:07:09', 'hh12 pm') AS d, to_char(TIMESTAMP '2024-03-05 00:30:00', 'HH12 A.M.') AS e;
----
a	b	c	d	e
2024-03-05 14:07:09	2024-03-05T14:07:09.123	02:07 PM	04 am	12 A.M.


query
SELECT '[' || to_char(TIMESTAMP '2024-03-05 14:07:09', 'Day, DD Month YYYY') || ']' AS a, '[' || to_char(TIMESTAMP '2024-03-05 14:07:09', 'FMDay, FMDD FMMonth YYYY') || ']' AS b, to_char(TIMESTAMP '2024-03-05 14:07:09', 'DY dy Dy MON mon Mon') AS c, '[' || to_char(TIMESTAMP '2024-03-05 14:07:09', 'DAY MONTH') || ']' AS d, to_char(TIMESTAMP '2024-03-05 14:07:09', 'FMday fmmonth') AS e;
----
a	b	c	d	e
[Tuesday  , 05 March     2024]	[Tuesday, 5 March 2024]	TUE tue Tue MAR mar Mar	[TUESDAY   MARCH    ]	tuesday march


query
SELECT to_char(TIMESTAMP '2024-03-05 14:07:09', 'Q') AS q, to_char(TIMESTAMP '2024-03-05', 'WW W') AS ww, to_char(DATE '2024-03-05', 'IW IYYY ID') AS iso, to_char(TIMESTAMP '2024-03-05', 'DDD D J') AS days, to_char(TIMESTAMP '2024-03-05', 'YY YYY Y,YYY CC') AS years, to_char(TIMESTAMP '2021-01-01', 'IYYY-IW-ID') AS iso_edge;
----
q	ww	iso	days	years	iso_edge
1	10 1	10 2024 2	065 3 2460375	24 024 2,024 21	2020-53-5


query
SELECT to_char(TIMESTAMP '2024-03-01', 'DDth') AS a, to_char(TIMESTAMP '2024-03-02', 'DDTH') AS b, to_char(TIMESTAMP '2024-03-03', 'FMDDth') AS c, to_char(TIMESTAMP '2024-03-11', 'DDth') AS d, to_char(TIMESTAMP '2024-03-22', 'FMDDth') AS e, to_char(TIMESTAMP '2024-03-05', 'FMMMth') AS f;
----
a	b	c	d	e	f
01st	02ND	3rd	11th	22nd	3rd


query
SELECT to_char(TIMESTAMP '2024-03-05 14:07:09.123456', 'MS US FF1 FF2 FF3 FF4 FF5 FF6') AS frac, to_char(TIMESTAMP '2024-03-05 14:07:09', 'SSSS SSSSS') AS secs, to_char(TIMESTAMP '2024-03-05 14:07:09', 'RM rm') AS roman_month, to_char(TIMESTAMP '2024-03-05 14:07:09', 'AD ad B.C. bc') AS era;
----
frac	secs	roman_month	era
123 123456 1 12 123 1234 12345 123456	50829 50829	III  iii 	AD ad A.D. ad


query
SELECT to_char(TIMESTAMP '2024-03-05 14:07:09', '"Year" YYYY "Q"Q \"quoted\"') AS lit, to_char(TIMESTAMP '2024-03-05 14:07:09', 'YYYY-MM-DD HH24:MI:SS FXYYYY') AS fx, to_char(DATE '2024-03-05', 'DD/MM/YYYY') AS d;
----
lit	fx	d
Year 2024 Q1 "1uote3"	2024-03-05 14:07:09 2024	05/03/2024


statement ok
SET TimeZone = 'UTC';


query
SELECT to_char(TIMESTAMPTZ '2024-03-05 14:07:09+00', 'YYYY-MM-DD HH24:MI:SS TZ OF') AS a, to_char(TIMESTAMPTZ '2024-03-05 14:07:09+00', 'tz TZH:TZM') AS b;
----
a	b
2024-03-05 14:07:09 UTC +00	utc +00:00


query
SELECT to_char(INTERVAL '1 day 02:03:04', 'DD HH24:MI:SS') AS a, to_char(INTERVAL '15 hours 2 minutes', 'HH24:MI') AS b, to_char(INTERVAL '2 years 3 months', 'YYYY MM') AS c, to_char(INTERVAL '40 hours', 'HH24') AS d, to_char(INTERVAL '-3 hours', 'HH24:MI') AS e;
----
a	b	c	d	e
01 02:03:04	15:02	0002 03	40	-03:00


query
SELECT to_char(NULL::timestamp, 'YYYY') IS NULL AS a, to_char(TIMESTAMP '2024-03-05', NULL) IS NULL AS b, to_char(TIMESTAMP '2024-03-05', '') AS c;
----
a	b	c
t	t	NULL


query
SELECT '[' || to_char(1234567.891, 'FM9,999,999.00') || ']' AS a, '[' || to_char(42, '00000') || ']' AS b, '[' || to_char(3.14159::float8, '9.999') || ']' AS c, '[' || to_char(-12.5, '999.9') || ']' AS d, '[' || to_char(-12.5, 'S999.9') || ']' AS e, '[' || to_char(-12.5, '999.9PR') || ']' AS f, '[' || to_char(12.5, '999.9MI') || ']' AS g, '[' || to_char(-12.5, '999.9MI') || ']' AS h;
----
a	b	c	d	e	f	g	h
[1,234,567.89]	[ 00042]	[ 3.142]	[ -12.5]	[ -12.5]	[ <12.5>]	[ 12.5 ]	[ 12.5-]


