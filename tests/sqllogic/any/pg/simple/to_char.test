SELECT '[' || to_char(1234, '99') || ']' AS overflow, '[' || to_char(0.5, '9.9') || ']' AS a, '[' || to_char(0.5, '0.9') || ']' AS b, '[' || to_char(0, '9') || ']' AS c, '[' || to_char(-0.1, 'FM9.9') || ']' AS d, '[' || to_char(1e20::float8, '9.99EEEE') || ']' AS e, '[' || to_char(123456789012345678::bigint, 'FM999999999999999999') || ']' AS f;
