query
SELECT to_char(INTERVAL '250 years', 'CC FMCC') AS a,
       to_char(INTERVAL '-250 years', 'CC FMCC') AS b,
       to_char(INTERVAL '10000 years', 'CC FMCC') AS c,
       to_char(INTERVAL '-10000 years', 'CC FMCC') AS d,
       to_char(INTERVAL '9999 years', 'CC') AS e;
