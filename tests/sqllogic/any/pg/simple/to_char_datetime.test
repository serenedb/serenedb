       to_char(INTERVAL '-1 year -2 months -3 days -04:05:06.789', 'YYYY Y,YYY YYY YY Y CC MM DD DDD HH HH12 HH24 MI SS MS US SSSS WW W J Q FMYYYY FMCC') AS b;
