query
SELECT to_char(INTERVAL '1 day', '') AS a,
       to_char(TIME '01:00', '') AS b,
       to_char(TIMESTAMPTZ '2020-01-01 00:00+00', '') AS c,
       to_char(TIMESTAMP 'infinity', 'YYYY') AS d,
       to_char(TIMESTAMPTZ '-infinity', 'YYYY') AS e,
       to_char(TIMESTAMPTZ 'infinity', '') AS f,
       to_char(TIMESTAMP '2020-01-01', '') AS g;
----
a	b	c	d	e	f	g
NULL	NULL	NULL	NULL	NULL	NULL	NULL

query
SELECT to_char(t, f) AS a
FROM (VALUES (TIMESTAMP '2020-01-02 03:04:05', 'YYYY'), (TIMESTAMP '2020-01-02 03:04:05', 'YYYY'), (TIMESTAMP '2021-01-02 03:04:05', 'MM/DD'), (TIMESTAMP '2022-01-02 03:04:05', 'HH24')) v(t, f)
ORDER BY a;
----
a
01/02
03
2020
2020

