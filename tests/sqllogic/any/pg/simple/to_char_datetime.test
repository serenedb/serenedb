a
0 00 000 0000 00000 000000  0 00 000 0000 00000 000000  000 000000
7 78 780 7800 78000 780000  7 78 780 7800 78000 780000  780 780000
7 78 789 7890 78901 789010  7 78 789 7890 78901 789010  789 789010

query
SELECT to_char(TIMESTAMP '2018-11-02 12:34:56', 'YYYY-MM-DD FX HH24:MI:SS') AS a,
       to_char(TIMESTAMP '2018-11-02 12:34:56', 'YYYYFM') AS b,
       to_char(TIMESTAMP '2018-11-02 12:34:56', 'YYYY "abc') AS c,
       to_char(TIMESTAMP '2018-11-02 12:34:56', 'YYYY "a\"b" \"MM\" DD') AS d,
       to_char(TIMESTAMP '2018-11-02', E'YYYY "x\\') AS e,
       to_char(TIMESTAMP '2018-11-02', 'YYYY\') AS f,
       to_char(TIMESTAMP '2018-11-02', 'YYYY\x') AS g,
       to_char(TIMESTAMP '2018-11-02', 'YYYY~MM' || chr(127) || 'DD é') AS h,
       to_char(TIMESTAMP '1997-02-10 17:32:01', E'"HH:MI:SS is" HH:MI:SS "\\"text between quote marks\\""') AS i,
       to_char(TIMESTAMP '1997-02-10 17:32:01', 'HH24--text--MI--text--SS') AS j;
----
a	b	c	d	e	f	g	h	i	j
2018-11-02  12:34:56	2018	2018 abc	2018 a"b "11" 02	2018 x\\	2018\\	2018\\x	2018~1102 é	HH:MI:SS is 05:32:01 "text between quote marks"	17--text--32--text--01

query
SELECT i, to_char(i * interval '1mon', 'rm') AS a, to_char(i * interval '1mon', 'RM') AS b, to_char(i * interval '1mon', 'FMRM') AS c, to_char(i * interval '1mon', 'Q') AS q
FROM generate_series(-13, 13) i ORDER BY i;
----
i	a	b	c	q
-13	xii 	XII 	XII	1
-12	i   	I   	I	(empty)
-11	ii  	II  	II	-3
-10	iii 	III 	III	-2
-9	iv  	IV  	IV	-2
-8	v   	V   	V	-2
-7	vi  	VI  	VI	-1
-6	vii 	VII 	VII	-1
-5	viii	VIII	VIII	-1
-4	ix  	IX  	IX	0
-3	x   	X   	X	0
-2	xi  	XI  	XI	0
-1	xii 	XII 	XII	1
0	(empty)	(empty)	(empty)	(empty)
1	i   	I   	I	1
2	ii  	II  	II	1
3	iii 	III 	III	1
4	iv  	IV  	IV	2
5	v   	V   	V	2
6	vi  	VI  	VI	2
7	vii 	VII 	VII	3
8	viii	VIII	VIII	3
9	ix  	IX  	IX	3
10	x   	X   	X	4
11	xi  	XI  	XI	4
12	xii 	XII 	XII	(empty)
13	i   	I   	I	1

