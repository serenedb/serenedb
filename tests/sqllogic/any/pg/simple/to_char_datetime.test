query
SELECT to_char(d, 'FF1 FF2 FF3 FF4 FF5 FF6  ff1 ff2 ff3 ff4 ff5 ff6  MS US') AS a
FROM (VALUES (TIMESTAMP '2018-11-02 12:34:56'), (TIMESTAMP '2018-11-02 12:34:56.78'), (TIMESTAMP '2018-11-02 12:34:56.78901')) v(d) ORDER BY d;
