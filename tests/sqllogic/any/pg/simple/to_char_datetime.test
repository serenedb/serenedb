query
WITH v(t) AS (VALUES (TIMESTAMP '1997-02-10 17:32:01'), (to_date('0097-02-16 BC', 'YYYY-MM-DD BC') + TIME '07:32:01'), (TIMESTAMP '2000-12-31 00:00:00'))
SELECT to_char(t, 'YYYY A.D. YYYY a.d. YYYY B.C. YYYY b.c. AD ad BC bc') AS a,
       to_char(t, 'HH:MI:SS A.M. a.m. P.M. p.m. AM am PM pm') AS b
FROM v ORDER BY t;
----
a	b
0097 B.C. 0097 b.c. 0097 B.C. 0097 b.c. BC bc BC bc	07:32:01 A.M. a.m. A.M. a.m. AM am AM am
1997 A.D. 1997 a.d. 1997 A.D. 1997 a.d. AD ad AD ad	05:32:01 P.M. p.m. P.M. p.m. PM pm PM pm
2000 A.D. 2000 a.d. 2000 A.D. 2000 a.d. AD ad AD ad	12:00:00 A.M. a.m. A.M. a.m. AM am AM am

