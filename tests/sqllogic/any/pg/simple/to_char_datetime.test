statement ok
SET TimeZone = 'UTC';

query
WITH v(t) AS (VALUES (TIMESTAMP '1997-02-10 17:32:01'), (to_date('0097-02-16 BC', 'YYYY-MM-DD BC') + TIME '07:32:01'), (TIMESTAMP '2000-12-31 00:00:00'), (TIMESTAMP '10000-01-01 12:00:00'))
SELECT to_char(t, 'DAY Day day DY Dy dy MONTH Month month RM rm MON Mon mon FMRM FMrm') AS a FROM v ORDER BY t;
----
a
TUESDAY   Tuesday   tuesday   TUE Tue tue FEBRUARY  February  february  II   ii   FEB Feb feb II ii
MONDAY    Monday    monday    MON Mon mon FEBRUARY  February  february  II   ii   FEB Feb feb II ii
SUNDAY    Sunday    sunday    SUN Sun sun DECEMBER  December  december  XII  xii  DEC Dec dec XII xii
SATURDAY  Saturday  saturday  SAT Sat sat JANUARY   January   january   I    i    JAN Jan jan I i

query
WITH v(t) AS (VALUES (TIMESTAMP '1997-02-10 17:32:01'), (to_date('0097-02-16 BC', 'YYYY-MM-DD BC') + TIME '07:32:01'), (TIMESTAMP '2000-12-31 00:00:00'), (TIMESTAMP '2024-12-30 00:00:00'), (TIMESTAMP '10000-01-01 12:00:00'))
SELECT to_char(t, 'Y,YYY YYYY YYY YY Y CC Q MM WW DDD DD D J IYYY IYY IY I IW IDDD ID') AS a,
       to_char(t, 'FMY,YYY FMYYYY FMYYY FMYY FMY FMCC FMQ FMMM FMWW FMDDD FMDD FMD FMJ FMIYYY FMIW FMIDDD FMID') AS b
FROM v ORDER BY t;
