SELECT to_char(t, 'YYYY-MM-DD HH24:MI:SS OF') AS a
FROM (VALUES (TIMESTAMPTZ '2021-03-28 00:30:00+00'), (TIMESTAMPTZ '2021-03-28 01:30:00+00'), (TIMESTAMPTZ '2021-10-31 00:30:00+00'), (TIMESTAMPTZ '2021-10-31 01:30:00+00')) v(t)
ORDER BY t;
----
a
2021-03-28 01:30:00 +01
2021-03-28 03:30:00 +02
2021-10-31 02:30:00 +02
2021-10-31 02:30:00 +01

