SELECT to_char(0, 'FM9.99') AS a, to_char(0.5, 'FM9.99') AS b, to_char(0.5, 'FM0.99') AS c, to_char(0, 'FM0.00') AS d, to_char(0::float8, 'FM9.99') AS e,
       to_char(0.5::float8, 'FM9.99') AS f, to_char(-0.5, 'FM9.99') AS g, to_char(0, '9.99') AS h, to_char(0.5, '9.99') AS i;
