SELECT id, to_char(n, '9.999EEEE') AS a, to_char(n, '99.9999999999999999999999999999999999EEEE') AS b, to_char(n::float4, '9.999EEEE') AS c
FROM (VALUES (1, 0::float8), (2, 1.5e-10), (3, -4.2e30), (4, 'NaN'), (5, 'Infinity'), (6, '-Infinity')) v(id, n) ORDER BY id;
----
id	a	b	c
1	 0.000e+00	 0.0000000000000000000000000000000000e+00	 0.000e+00
2	 1.500e-10	 1.4999999999999999900248106175413253e-10	 1.500e-10
3	-4.200e+30	-4.2000000000000000272204289802240000e+30	-4.200e+30
4	 #.#######	 ##.######################################	 #.#######
5	 #.#######	 ##.######################################	 #.#######
6	 #.#######	 ##.######################################	 #.#######

query
SELECT n, to_char(n, '9999V99') AS a, to_char(n, '9V9999999999') AS b, to_char(n, '9V99999999999999999999') AS c FROM (VALUES (12), (-12), (0)) v(n) ORDER BY n;
