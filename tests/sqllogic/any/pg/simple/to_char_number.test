query
SELECT to_char(1.5::float8, '9.' || repeat('9', 400) || 'EEEE') = ' 1.5' || repeat('0', 399) || 'e+00' AS a,
       to_char(7, '9.' || repeat('9', 400) || 'EEEE') = ' 7.' || repeat('0', 400) || 'e+00' AS b,
       to_char(7::float4, '9.' || repeat('9', 400) || 'EEEE') = ' 7.' || repeat('0', 400) || 'e+00' AS c,
       md5(to_char(5e-324::float8, '9.' || repeat('9', 400) || 'EEEE')) AS d;
----
a	b	c	d
t	t	t	53d93142ed729c57fb1d91c09377a234

query
SELECT to_char(1, '') AS a, to_char(1::int8, '') AS b, to_char(1.5::float8, '') AS c, to_char(1.5, '') AS d, to_char(1.5::float4, '') AS e;
----
a	b	c	d	e
(empty)	(empty)	(empty)	(empty)	(empty)

query
SELECT n, f, to_char(n, f) AS a FROM (VALUES (1, '999'), (1, '999'), (2, '0000'), (3, 'FM9th')) v(n, f) ORDER BY n, f;
----
n	f	a
1	999	   1
1	999	   1
2	0000	 0002
3	FM9th	3rd

