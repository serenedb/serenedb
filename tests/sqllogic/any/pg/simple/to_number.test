query
SELECT to_number('5 4', '9 9') AS a,
       to_number('5x4', '9x9') AS b,
       to_number('5é4', '9é9') AS c,
       to_number('5"4', '9\"9') AS d,
       to_number('12abc', '99"abc"') AS e,
       to_number('1,234', '9,999') AS f,
       to_number('1234', '9,999') AS g,
       to_number('1 234', '9G999') AS h,
       to_number('234', 'FM9,999') AS i,
       to_number('1,234', 'FM9,999') AS j;
----
a	b	c	d	e	f	g	h	i	j
54	54	54	54	12	1234	1234	1234	234	123

query
SELECT to_number('$1', 'L9') AS a,
       to_number('1', 'L9') AS b,
       to_number('€1', 'L9') AS c,
       to_number('$$1', 'LL9') AS d,
       to_number('12th', '99th') AS e,
       to_number('12', '99th') AS f,
       to_number('1st', '9TH') AS g,
       to_number('12é', '99th') AS h,
       to_number('1x2', '9th9') AS i;
----
a	b	c	d	e	f	g	h	i
1	1	1	1	12	12	1	12	12

query
SELECT to_number('1.5', '9.9') AS a,
       to_number('.5', '.9') AS b,
       to_number('1.', '9.') AS c,
       to_number('1.55', '9.9') AS d,
       to_number('1.5', '9D9') AS e,
       to_number('12', '0000') AS f,
       to_number('0012', '0000') AS g,
       to_number(' 12', '9999') AS h,
       to_number('1', '9V9') AS i,
       to_number('12', '9V9') AS j,
       to_number('123', '9V99') AS k;
----
a	b	c	d	e	f	g	h	i	j	k
1.5	0.5	1	1.5	1.5	12	12	12	0.10000000000000000	1.20000000000000000	1.230000000000000000

query
SELECT to_number('1', '') AS a, to_number('1', NULL) AS b, to_number(NULL, '9') AS c, to_number('1', NULL::text) AS d, to_number(NULL::text, '9.9') AS e, to_number('1x', '99PL') AS f,
       to_number('1', NULLIF('9', '9')) AS g, to_number(NULLIF('1', '1'), '9.9') AS h;
----
a	b	c	d	e	f	g	h
NULL	NULL	NULL	NULL	NULL	1	NULL	NULL

query
SELECT to_number(t, f)::float8 AS a FROM (VALUES ('12.5', '99.9'), ('12.5', '99.9'), ('7', '9'), ('XIV', 'RN')) v(t, f) ORDER BY a;
----
a
7
12.5
12.5
14

query
SELECT to_number(t, '9.99999')::float8 AS a FROM (VALUES ('1.23456'), ('2.5')) v(t) ORDER BY a;
----
a
1.23456
2.5

query
SELECT to_number(t, 'RN') AS a FROM (VALUES ('XIV'), ('MMXX')) v(t) ORDER BY a;
----
a
14
2020

query
SELECT to_number('5 ', '99') AS a,
       to_number('+5', '99') AS b,
       to_number('1.55', '99.9') AS c,
       to_number('1x', '99S') AS d,
       to_number('12', '99S') AS e,
       to_number('1+', '99PL') AS f,
       to_number('1-', '99MI') AS g,
       to_number('1x', '99MI') AS h,
       to_number('5x', '9MI') AS i,
       to_number('5+', '9MI') AS j,
       to_number('5-', '9PL') AS k;
----
a	b	c	d	e	f	g	h	i	j	k
5	5	1.5	1	12	1	-1	1	5	5	5

statement ok
PREPARE to_number_format(text) AS SELECT to_number('1.5', $1) AS a;

query
EXECUTE to_number_format('9.9');
----
a
1.5

query
EXECUTE to_number_format(NULL);
----
a
NULL

statement ok
PREPARE to_number_value(text) AS SELECT to_number($1, '9.99') AS a;

query
EXECUTE to_number_value('1.25');
----
a
1.25

query
EXECUTE to_number_value(NULL);
----
a
NULL

