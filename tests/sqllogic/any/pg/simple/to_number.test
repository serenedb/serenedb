query
SELECT to_number('-34,338,492', '99G999G999') AS a,
       to_number('-34,338,492.654,878', '99G999G999D999G999') AS b,
       to_number('<564646.654564>', '999999.999999PR') AS c,
       to_number('0.00001-', '9.999999S') AS d,
       to_number('5.01-', 'FM9.999999S') AS e,
       to_number('5.01-', 'FM9.999999MI') AS f,
       to_number('5 4 4 4 4 8 . 7 8', '9 9 9 9 9 9 . 9 9') AS g;
----
a	b	c	d	e	f	g
-34338492	-34338492.654878	-564646.654564	-0.00001	-5.01	-5.01	544448.78

query
SELECT to_number('.01', 'FM9.99') AS a,
       to_number('.0', '99999999.99999999') AS b,
       to_number('0', '99.99') AS c,
       to_number('.-01', 'S99.99') AS d,
       to_number('.01-', '99.99S') AS e,
       to_number(' . 0 1-', ' 9 9 . 9 9 S') AS f,
       to_number('34,50', '999,99') AS g,
       to_number('123,000', '999G') AS h,
       to_number('123456', '999G999') AS i;
----
a	b	c	d	e	f	g	h	i
0.01	0.0	0	-0.01	-0.01	-0.01	3450	123	123456

query
SELECT to_number('$1234.56', 'L9,999.99') AS a,
       to_number('$1234.56', 'L99,999.99') AS b,
       to_number('$1,234.56', 'L99,999.99') AS c,
       to_number('1234.56', 'L99,999.99') AS d,
       to_number('1,234.56', 'L99,999.99') AS e,
       to_number('42nd', '99th') AS f,
       to_number('123456', '99999V99') AS g;
----
a	b	c	d	e	f	g
1234.56	1234.56	1234.56	1234.56	1234.56	42	1234.560000000000000000

query
WITH rows AS (SELECT i, to_char(i, 'RN') AS roman FROM generate_series(1, 3999) AS i)
SELECT bool_and(to_number(roman, 'RN') = i) AS valid FROM rows;
----
valid
t

query
SELECT to_number('CvIiI', 'rn') AS a,
       to_number('MMXX  ', 'RN') AS b,
       to_number('  XIV', '  RN') AS c,
       to_number('  XIV  ', '  RN') AS d,
       to_number('M CC', 'RN') AS e,
       to_number('XIV', 'RN') AS f,
       to_number('xiv', 'rn') AS g,
       to_number('MMXX', 'FMRN') AS h;
