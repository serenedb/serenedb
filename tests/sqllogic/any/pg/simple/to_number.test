108	2020	14	14	1000	14	14	2020

query
SELECT to_number('+5', 'S9') AS a,
       to_number('5+', '9S') AS b,
       to_number('5-', '9S') AS c,
       to_number('+5', 'SG9') AS d,
       to_number('-5', 'SG9') AS e,
       to_number('5', 'SG9') AS f,
       to_number('-1.5', 'S9.9') AS g,
       to_number('1.5-', '9.9S') AS h,
       to_number('1-', '9S') AS i,
       to_number('1+', '9S') AS j,
       to_number('1x', '9S') AS k;
----
a	b	c	d	e	f	g	h	i	j	k
5	5	-5	5	-5	5	-1.5	-1.5	-1	1	1

query
