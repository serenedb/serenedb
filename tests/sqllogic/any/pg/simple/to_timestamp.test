statement ok
SET TimeZone = 'UTC';

query
SELECT to_timestamp('0097/Feb/16 --> 08:14:30', 'YYYY/Mon/DD --> HH:MI:SS') AS a,
       to_timestamp('97/2/16 8:14:30', 'FMYYYY/FMMM/FMDD FMHH:FMMI:FMSS') AS b,
       to_timestamp('2011$03!18 23_38_15', 'YYYY-MM-DD HH24:MI:SS') AS c,
       to_timestamp('1985 January 12', 'YYYY FMMonth DD') AS d,
       to_timestamp('1985 FMMonth 12', 'YYYY "FMMonth" DD') AS e,
       to_timestamp('1985 \ 12', 'YYYY \\ DD') AS f;
