statement ok
PREPARE untyped_upper AS SELECT upper($1) AS r;

statement ok
PREPARE untyped_lower AS SELECT lower($1) AS r;

query
SELECT name, array_to_string(parameter_types, ',') AS parameter_types, array_to_string(result_types, ',') AS result_types FROM pg_prepared_statements WHERE name LIKE 'untyped\_%' ORDER BY name;
----
name	parameter_types	result_types
untyped_lower	text	text
untyped_upper	text	text

query
EXECUTE untyped_upper('ab');
----
r
AB

query
EXECUTE untyped_lower('AB');
----
r
ab
