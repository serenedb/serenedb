query
SELECT ARRAY['1 2'::int2vector, '3'::int2vector, ''::int2vector] AS a, ROW(''::int2vector) AS b,
       ROW('3'::int2vector) AS c, ROW('1 2'::int2vector) AS d, ARRAY[ROW('3'::int2vector)] AS e,
       ARRAY[ROW('1 2'::int2vector)] AS f;
----
a	b	c	d	e	f
{"1 2",3,""}	("")	(3)	("1 2")	{(3)}	{"(\\"1 2\\")"}


query
SELECT ARRAY[ARRAY['1 2'::int2vector], ARRAY['3'::int2vector]] AS a, ROW(ARRAY['1 2'::int2vector]) AS b,
       ARRAY['1 2'::oidvector, '3'::oidvector] AS c;
----
a	b	c
{{"1 2"},{3}}	("{""1 2""}")	{"1 2",3}
