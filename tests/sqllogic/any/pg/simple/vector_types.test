query
SELECT '1 2 3'::int2vector AS v, '  1   2 '::int2vector AS spaced, ''::int2vector AS empty;
----
v	spaced	empty
1 2 3	1 2	(empty)


query
SELECT '23 25'::oidvector AS o, ''::oidvector AS empty;
----
o	empty
23 25	(empty)


