SELECT '<!DOCTYPE a><a xml:id="1a"/>'::xml AS a, xml_is_well_formed_document('<a xml:id="1a"/>') AS b,
       '<!DOCTYPE a [<!ATTLIST a xml:id CDATA #IMPLIED>]><a xml:id="x"/>'::xml AS c, '<p:a/>'::xml AS d,
       '<a xmlns:p=""/>'::xml AS e, '<a><b xml:id="x"/><c xml:id="x"/></a>'::xml AS f;
