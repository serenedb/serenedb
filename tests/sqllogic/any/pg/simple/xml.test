query
SELECT '<a>1</a>'::xml AS a, 'abc'::xml AS b, '<a/><b/>'::xml AS c, ''::xml AS d, '<?xml version="1.0"?><a/>'::xml AS e,
       '<?xml version="1.0" standalone="yes"?><a/>'::xml AS f;
----
a	b	c	d	e	f
<a>1</a>	abc	<a/><b/>	(empty)	<a/>	<?xml version="1.0" standalone="yes"?><a/>


query
SELECT '<?xml version="1.1"?><a/>'::xml AS a, '<?xml version = "1.0" ?>
<a/>'::xml AS b, '  <a/>'::xml AS c, '<?xml version="1.0"?><a/>'::xml::text AS d;
----
a	b	c	d
<?xml version="1.1"?><a/>	<a/>	  <a/>	<?xml version="1.0"?><a/>


statement error (invalid XML content)
SELECT '<a>'::xml;


statement error (invalid XML content)
SELECT '<a></b>'::xml;


statement error (invalid XML content)
SELECT '&'::xml;


statement error (invalid XML content)
SELECT '<'::name::xml;


query
SELECT '<a/>'::name::xml AS a, '<a/>'::xml::name AS b, '<a/>'::xml::varchar AS c, '<b/>'::varchar::xml AS d;
----
a	b	c	d
<a/>	<a/>	<a/>	<b/>


skipif serenedb # xml casts to json as a string
statement error
SELECT '<a/>'::xml::json;
----
db error: ERROR: cannot cast type xml to json<slt:ignore>


onlyif serenedb
query
SELECT '<a/>'::xml::json;
----
json
"<a/>"


query
SELECT to_json('<a b="1">text</a>'::xml) AS a, to_json(NULL::xml) AS b;
----
a	b
"<a b=\\"1\\">text</a>"	NULL


statement ok
SET xmloption = document


statement error (invalid XML document)
SELECT '<a/><b/>'::xml;


statement error (invalid XML document)
SELECT 'abc'::xml;


query
SELECT '<a/>'::xml AS a;
----
a
<a/>


statement ok
RESET xmloption


query
SELECT xmlcomment('hello') AS a, xmltext('<a>&b') AS b, xmltext('a"b''c\') AS d, xmlcomment('') AS e;
----
a	b	d	e
<!--hello-->	&lt;a&gt;&amp;b	a&quot;b'c\\	<!---->


statement error
SELECT xmlcomment('a--b');
----
db error: ERROR: invalid XML comment<slt:ignore>


statement error
SELECT xmlcomment('a-');
----
db error: ERROR: invalid XML comment<slt:ignore>


query
SELECT xpath('/a/b/text()', '<a><b>1</b><b>2</b></a>'::xml) AS a, xpath('//b', '<a><b>1</b></a>'::xml) AS b,
       xpath_exists('/a/c', '<a><b/></a>'::xml) AS c, xpath('count(//b)', '<a><b/><b/></a>'::xml) AS d;
----
a	b	c	d
{1,2}	{<b>1</b>}	f	{2}


query
SELECT xpath('/a/@x', '<a x="1&amp;2"/>'::xml) AS a, xpath('//text()', '<a>x&lt;y</a>'::xml) AS b, xpath('0.5', '<a/>'::xml) AS c,
       xpath('string(/a)', '<a>q&amp;</a>'::xml) AS d, xpath('1 = 1', '<a/>'::xml) AS e, xpath('1 div 0', '<a/>'::xml) AS f;
----
a	b	c	d	e	f
{1&amp;2}	{x&lt;y}	{0.5}	{q&amp;}	{true}	{Infinity}


query
SELECT xpath('/a/b', '<?xml version="1.0"?><a><b>1</b></a>'::xml) AS a, xpath_exists('/a/b', '<a><b/></a>'::xml) AS b,
       xpath('/a/b', '<a/>'::xml) AS c, xpath('/a', '<a/>'::xml, '{}') AS d;
----
a	b	c	d
{<b>1</b>}	t	{}	{<a/>}


query
SELECT xpath('/x:a', '<x:a xmlns:x="u"/>'::xml, ARRAY[ARRAY['x', 'u']]) AS a,
       xpath_exists('/x:a', '<x:a xmlns:x="u"/>'::xml, ARRAY[ARRAY['x', 'u']]) AS b,
       xpath('/my:a/text()', '<my:a xmlns:my="http://example.com">test</my:a>', ARRAY[ARRAY['my', 'http://example.com']]) AS c;
----
a	b	c
{"<x:a xmlns:x=\\"u\\"/>"}	t	{test}


statement error
SELECT xpath('/a', '<a/>'::xml, ARRAY[ARRAY['x', 'u', 'v']]);
----
db error: ERROR: invalid array for XML namespace mapping<slt:ignore>


statement error
SELECT xpath('/a[', '<a/>'::xml);
----
db error: ERROR: invalid XPath expression<slt:ignore>


statement error
SELECT xpath('', '<a/>'::xml);
----
db error: ERROR: empty XPath expression<slt:ignore>


statement error
SELECT xpath('/a', 'abc'::xml);
