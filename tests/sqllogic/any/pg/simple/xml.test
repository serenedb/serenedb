<!DOCTYPE a><a xml:id="1a"/>	t	<!DOCTYPE a [<!ATTLIST a xml:id CDATA #IMPLIED>]><a xml:id="x"/>	<p:a/>	<a xmlns:p=""/>	<a><b xml:id="x"/><c xml:id="x"/></a>


