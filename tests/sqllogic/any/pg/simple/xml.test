CREATE TABLE xml_args (id int, p text, x xml, ns text[][]);


statement ok
INSERT INTO xml_args VALUES (1, '/a', '<a/>', ARRAY[ARRAY['x', 'u']]), (2, NULL, '<a/>', ARRAY[ARRAY['x', 'u']]),
  (3, '/a', NULL, ARRAY[ARRAY['x', 'u']]), (4, '/a', '<a/>', NULL), (5, '/x:a', '<x:a xmlns:x="u"/>', ARRAY[ARRAY['x', 'u']]);


query
SELECT id, xpath(p, x, ns) AS a, xpath_exists(p, x, ns) AS b FROM xml_args ORDER BY id;
