query
SELECT xmlconcat('<?xml version="1.0" standalone="yes"?><a/>', '<?xml version="1.0" standalone="no"?><b/>') AS a,
       xmlconcat('<?xml version="1.0"?><a/>', '<?xml version="1.1"?><b/>') AS b,
       xmlconcat('<?xml version="1.0" standalone="yes"?><a/>', '<?xml version="1.1" standalone="yes"?><b/>') AS c,
       xmlconcat('<?xml version="1.0" standalone="no"?><a/>', '<?xml version="1.0" standalone="no"?><b/>') AS d;
----
a	b	c	d
<?xml version="1.0" standalone="no"?><a/><b/>	<a/><b/>	<?xml version="1.0" standalone="yes"?><a/><b/>	<?xml version="1.0" standalone="no"?><a/><b/>


