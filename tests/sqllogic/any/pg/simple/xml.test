db error: ERROR: could not parse XML document<slt:ignore>


query
SELECT xmlconcat('<a/>', '<b/>') AS a, xmlconcat('<?xml version="1.1"?><a/>', '<?xml version="1.1" standalone="no"?><b/>') AS b,
       xmlconcat('<?xml version="1.0" standalone="yes"?><a/>') AS c, xmlconcat('<?xml version="1.0"?><a/>')::text AS d,
       xmlconcat(NULL, '<b/>'::xml) AS e, xmlconcat(NULL::xml, NULL::xml) IS NULL AS f, xmlconcat('abc', '<b/>', 'x') AS g;
----
a	b	c	d	e	f	g
<a/><b/>	<?xml version="1.1"?><a/><b/>	<?xml version="1.0" standalone="yes"?><a/>	<a/>	<b/>	t	abc<b/>x


statement error (invalid XML content)
SELECT xmlconcat('<a>');


query
SELECT '<a/>'::xml IS DOCUMENT AS a, 'abc'::xml IS DOCUMENT AS b, '<a/><b/>'::xml IS NOT DOCUMENT AS c,
       NULL::xml IS DOCUMENT AS d, '<a/>' IS DOCUMENT AS e, NOT '<a/>'::xml IS DOCUMENT AS f,
       '<a/>'::xml IS DOCUMENT IS TRUE AS g, '<a/>'::xml IS NOT DOCUMENT AND TRUE AS h;
----
a	b	c	d	e	f	g	h
t	f	t	NULL	t	f	t	f


query
SELECT xmlagg(x) AS a FROM (VALUES ('<a/>'::xml), ('<b/>'::xml), (NULL)) t(x);
----
a
<a/><b/>


query
SELECT xmlagg(x ORDER BY y DESC) AS a FROM (VALUES ('<a/>'::xml, 1), ('<b/>'::xml, 2)) t(x, y);
----
a
<b/><a/>


query
SELECT xmlagg(x ORDER BY y) AS a
FROM (VALUES ('<?xml version="1.0" standalone="yes"?><a/>'::xml, 1), ('<?xml version="1.0" standalone="yes"?><b/>'::xml, 2)) t(x, y);
----
a
<?xml version="1.0" standalone="yes"?><a/><b/>


query
SELECT xmlagg(x ORDER BY y)::text AS a, xmlagg(z ORDER BY y) AS b
FROM (VALUES ('<?xml version="1.0"?><a/>'::xml, 1, '<a/>'::xml), ('<b/>'::xml, 2, '<?xml version="1.1"?><b/>'::xml)) t(x, y, z);
----
a	b
<a/><b/>	<a/><b/>


query
SELECT xmlagg(x) IS NULL AS a FROM (VALUES (NULL::xml)) t(x);
----
a
t


query
SELECT xmlagg(x ORDER BY y) AS a, xmlagg(x ORDER BY y) FILTER (WHERE y = 1) AS b
FROM (VALUES (''::xml, 1), ('<a/>'::xml, 2)) t(x, y);
----
a	b
<a/>	(empty)


query
SELECT a FROM (
  SELECT y, xmlagg(x) OVER (ORDER BY y ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS a
  FROM (SELECT y, CASE WHEN y < 40 THEN ''::xml ELSE '<a/>'::xml END AS x FROM generate_series(1, 42) AS g(y)) t
) w WHERE y = 42;
----
a
<a/><a/><a/>


query
SELECT pg_typeof('<a/>'::xml) AS a, '<a/>'::xml::varchar AS b, ('<a/>'::xml)::text || 'x' AS c,
       '<a/>'::text::xml AS d, CAST('<b/>' AS xml) AS e;
----
a	b	c	d	e
xml	<a/>	<a/>x	<a/>	<b/>


query
SELECT ARRAY['<a/>'::xml, '<b x="1"/>'::xml] AS a, ROW('<a x="1, 2"/>'::xml) AS b,
       ARRAY['<?xml version="1.0" standalone="yes"?><a/>'::xml] AS c;
----
a	b	c
{<a/>,"<b x=\\"1\\"/>"}	("<a x=""1, 2""/>")	{"<?xml version=\\"1.0\\" standalone=\\"yes\\"?><a/>"}


query
SELECT pg_input_is_valid('<a>', 'xml') AS a, pg_input_is_valid('<a/>', 'xml') AS b, xml_is_well_formed('<a>') AS c,
       xml_is_well_formed_document('<a/><b/>') AS d, xml_is_well_formed_content('<a/><b/>') AS e;
----
a	b	c	d	e
f	t	f	f	t


statement ok
CREATE TABLE xml_t (id INT, x xml);


statement ok
INSERT INTO xml_t VALUES (1, '<a>1</a>'), (2, 'text'), (3, NULL), (4, '<?xml version="1.0" standalone="no"?><b/>');


statement error (invalid XML content)
INSERT INTO xml_t VALUES (5, '<c>');


query
SELECT id, x FROM xml_t ORDER BY id;
----
id	x
1	<a>1</a>
2	text
3	NULL
4	<?xml version="1.0" standalone="no"?><b/>


query
SELECT id, x::text AS t FROM xml_t WHERE id = 4;
----
id	t
4	<?xml version="1.0" standalone="no"?><b/>


query
SELECT xmlagg(x ORDER BY id) AS a FROM xml_t;
----
a
<a>1</a>text<b/>


statement ok
DROP TABLE xml_t;


query
SELECT oid::int AS oid, proname, pg_get_function_identity_arguments(oid) AS args
FROM pg_proc WHERE proname IN ('xpath', 'xpath_exists', 'xmlagg', 'xmlcomment', 'xmltext') ORDER BY oid;
----
oid	proname	args
2895	xmlcomment	text
2901	xmlagg	xml
2931	xpath	text, xml, text[]
2932	xpath	text, xml
3049	xpath_exists	text, xml, text[]
3050	xpath_exists	text, xml
3813	xmltext	text
