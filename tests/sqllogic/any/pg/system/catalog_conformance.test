query
SELECT oid::regnamespace::text AS oid, nspname, pg_catalog.pg_get_userbyid(nspowner) AS nspowner,
  (SELECT string_agg(x::text, ',' ORDER BY x::text COLLATE "C") FROM unnest(nspacl) x) AS nspacl
FROM pg_catalog.pg_namespace
WHERE (oid IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) OR nspname IN ('pg_catalog', 'public', 'information_schema'))
  AND oid::regnamespace::text NOT IN ('public')
ORDER BY oid::regnamespace::text COLLATE "C"
----
oid	nspname	nspowner	nspacl
app	app	postgres	conf_reader=U/postgres,postgres=UC/postgres
information_schema	information_schema	postgres	=U/postgres,postgres=UC/postgres
pg_catalog	pg_catalog	postgres	=U/postgres,postgres=UC/postgres


