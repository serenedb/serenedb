query
SELECT oid::regclass::text AS oid, relname, relnamespace::regnamespace::text AS relnamespace,
  reltype::regtype::text AS reltype, reloftype::regtype::text AS reloftype,
  pg_catalog.pg_get_userbyid(relowner) AS relowner, CASE WHEN relkind IN ('i', 'I') THEN NULL ELSE relam END AS relam,
  reltablespace, relhasindex, relisshared, relpersistence, relkind, relnatts, relchecks, relhasrules, relhassubclass,
  relforcerowsecurity, relispopulated, relreplident, relispartition, relrewrite,
  (SELECT string_agg(x::text, ',' ORDER BY x::text COLLATE "C") FROM unnest(relacl) x) AS relacl, reloptions,
  pg_catalog.pg_get_expr(relpartbound, oid) AS relpartbound
FROM pg_catalog.pg_class
WHERE relnamespace IN ('pgonly'::regnamespace::oid)
  AND oid::regclass::text NOT IN ('pgonly.cascade_child', 'pgonly.cascade_child_pkey', 'pgonly.domain_tab',
    'pgonly.domain_tab_pkey', 'pgonly.identity_tab', 'pgonly.identity_tab_code_key', 'pgonly.identity_tab_id_seq',
    'pgonly.identity_tab_pkey', 'pgonly.json_tab', 'pgonly.json_tab_pkey')
ORDER BY oid::regclass::text COLLATE "C"
