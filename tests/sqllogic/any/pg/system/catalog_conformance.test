query
SELECT q.attname, q.format_type, q.attnotnull, q.atttypid, q.atttypmod, q.collname, q.comment, q.identity,
  q.attgenerated FROM (
SELECT a.attname, format_type(a.atttypid, a.atttypmod), pg_get_expr(d.adbin, d.adrelid), a.attnotnull, a.atttypid, a.atttypmod, c.collname, col_description(a.attrelid, a.attnum) AS comment, attidentity AS identity, attgenerated as attgenerated FROM pg_attribute a LEFT JOIN pg_attrdef d ON a.attrelid = d.adrelid AND a.attnum = d.adnum LEFT JOIN pg_type t ON a.atttypid = t.oid LEFT JOIN pg_collation c ON a.attcollation = c.oid AND a.attcollation <> t.typcollation WHERE a.attrelid = '"orders"'::regclass AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum
) q
WHERE q.attname NOT IN ('status')
ORDER BY q.attname::text COLLATE "C"
----
attname	format_type	attnotnull	atttypid	atttypmod	collname	comment	identity	attgenerated
amount	numeric(10,2)	t	1700	655366	NULL	Order amount	(empty)	(empty)
customer_id	integer	t	23	-1	NULL	NULL	(empty)	(empty)
id	bigint	t	20	-1	NULL	NULL	(empty)	(empty)
note	text	f	25	-1	NULL	NULL	(empty)	(empty)
ordered_on	date	f	1082	-1	NULL	NULL	(empty)	(empty)
ticket	bigint	f	20	-1	NULL	NULL	(empty)	(empty)


