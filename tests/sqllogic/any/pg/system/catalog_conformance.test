app	all_types	c_float4	real	f	4	-1	15	NULL	NULL	NULL	NULL	0	b
app	all_types	c_float8	double precision	f	8	-1	16	NULL	NULL	NULL	NULL	0	b
app	all_types	c_int2	smallint	f	2	-1	1	NULL	NULL	NULL	NULL	0	b
