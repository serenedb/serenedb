SELECT * FROM (
SELECT con.conname::text AS conname,
  CASE WHEN con.conrelid <> 0 THEN con.conrelid::regclass::text ELSE con.contypid::regtype::text END AS owner,
  pg_catalog.pg_get_constraintdef(con.oid) AS def, pg_catalog.pg_get_constraintdef(con.oid, true) AS def_pretty,
  pg_catalog.obj_description(con.oid, 'pg_constraint') AS description
FROM pg_catalog.pg_constraint con
WHERE con.connamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)
) q
WHERE (q.conname, q.owner) NOT IN (('order_items_qty_check', 'order_items'), ('orders_amount_check', 'orders'),
    ('orders_status_check', 'orders'), ('unique_tab_qty_check', 'app.unique_tab'))
ORDER BY q.conname::text COLLATE "C", q.owner::text COLLATE "C"
----
conname	owner	def	def_pretty	description
all_types_c_int8_not_null	app.all_types	NOT NULL c_int8	NOT NULL c_int8	NULL
all_types_c_text_not_null	app.all_types	NOT NULL c_text	NOT NULL c_text	NULL
all_types_pkey	app.all_types	PRIMARY KEY (c_int8)	PRIMARY KEY (c_int8)	NULL
child_tab_id_not_null	app.child_tab	NOT NULL id	NOT NULL id	NULL
child_tab_pkey	app.child_tab	PRIMARY KEY (id)	PRIMARY KEY (id)	NULL
child_tab_unique_id_fkey	app.child_tab	FOREIGN KEY (unique_id) REFERENCES app.unique_tab(id)	FOREIGN KEY (unique_id) REFERENCES app.unique_tab(id)	NULL
customers_email_key	customers	UNIQUE (email)	UNIQUE (email)	NULL
customers_email_not_null	customers	NOT NULL email	NOT NULL email	NULL
customers_id_not_null	customers	NOT NULL id	NOT NULL id	NULL
customers_name_not_null	customers	NOT NULL name	NOT NULL name	NULL
customers_pkey	customers	PRIMARY KEY (id)	PRIMARY KEY (id)	NULL
json_tab_id_not_null	app.json_tab	NOT NULL id	NOT NULL id	NULL
json_tab_pkey	app.json_tab	PRIMARY KEY (id)	PRIMARY KEY (id)	NULL
order_items_line_not_null	order_items	NOT NULL line	NOT NULL line	NULL
order_items_order_id_fkey	order_items	FOREIGN KEY (order_id) REFERENCES orders(id)	FOREIGN KEY (order_id) REFERENCES orders(id)	NULL
order_items_order_id_not_null	order_items	NOT NULL order_id	NOT NULL order_id	NULL
order_items_pkey	order_items	PRIMARY KEY (order_id, line)	PRIMARY KEY (order_id, line)	NULL
order_items_qty_not_null	order_items	NOT NULL qty	NOT NULL qty	NULL
order_items_sku_not_null	order_items	NOT NULL sku	NOT NULL sku	NULL
orders_amount_not_null	orders	NOT NULL amount	NOT NULL amount	NULL
orders_customer_id_fkey	orders	FOREIGN KEY (customer_id) REFERENCES customers(id)	FOREIGN KEY (customer_id) REFERENCES customers(id)	NULL
orders_customer_id_not_null	orders	NOT NULL customer_id	NOT NULL customer_id	NULL
orders_id_not_null	orders	NOT NULL id	NOT NULL id	NULL
orders_pkey	orders	PRIMARY KEY (id)	PRIMARY KEY (id)	NULL
unique_tab_code_key	app.unique_tab	UNIQUE (code)	UNIQUE (code)	NULL
unique_tab_id_not_null	app.unique_tab	NOT NULL id	NOT NULL id	NULL
unique_tab_pkey	app.unique_tab	PRIMARY KEY (id)	PRIMARY KEY (id)	NULL


