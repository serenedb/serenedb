skipif serenedb
query
SELECT q.oid::regtype::text AS oid, q.typname, q.typelem::regtype::text AS typelem, q.typdelim,
  (q.typinput)::text AS typinput, q.rngsubtype, q.typtype, q.typbasetype FROM (
SELECT t.oid, t.typname, t.typelem, t.typdelim, t.typinput, r.rngsubtype, t.typtype, t.typbasetype FROM pg_type as t LEFT JOIN pg_range as r ON oid = rngtypid WHERE t.typname IN ('int2', 'int4', 'int8', 'oid', 'float4', 'float8', 'numeric', 'bool', 'timestamp', 'timestamptz') OR t.typtype IN ('r', 'e', 'd') OR t.typinput = 'array_in(cstring,oid,integer)'::regprocedure OR t.typelem != 0
) q
WHERE q.typname IN ('_columns', '_geometry', '_union', '_variant', 'daterange', 'int4range', 'int8range', 'numrange',
    'tsrange', 'tstzrange')
ORDER BY q.typname::text COLLATE "C"
----
oid	typname	typelem	typdelim	typinput	rngsubtype	typtype	typbasetype
information_schema.columns[]	_columns	information_schema.columns	,	array_in	NULL	b	0
daterange	daterange	-	,	range_in	1082	r	0
int4range	int4range	-	,	range_in	23	r	0
int8range	int8range	-	,	range_in	20	r	0
numrange	numrange	-	,	range_in	1700	r	0
tsrange	tsrange	-	,	range_in	1114	r	0
tstzrange	tstzrange	-	,	range_in	1184	r	0


