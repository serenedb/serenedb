unique_tab_qty_check	app	c	f	f	t	t	app.unique_tab	-	-	t	-	_	_	_	t	0	f	f	{3}	NULL	NULL	NULL	NULL	NULL	NULL	((qty >= 1) AND (qty <= 100))


