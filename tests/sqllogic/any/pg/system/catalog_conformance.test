query
SELECT * FROM (
SELECT classid::regclass::text AS classid,
  CASE classid WHEN 'pg_class'::regclass::oid THEN objid::regclass::text WHEN 'pg_type'::regclass::oid THEN objid::regtype::text WHEN 'pg_proc'::regclass::oid THEN objid::regprocedure::text WHEN 'pg_namespace'::regclass::oid THEN objid::regnamespace::text WHEN 'pg_constraint'::regclass::oid THEN (SELECT x.conname::text || ' on ' || CASE WHEN x.conrelid <> 0 THEN x.conrelid::regclass::text ELSE x.contypid::regtype::text END FROM pg_catalog.pg_constraint x WHERE x.oid = objid) WHEN 'pg_attrdef'::regclass::oid THEN (SELECT x.adrelid::regclass::text || ' default ' || x.adnum::text FROM pg_catalog.pg_attrdef x WHERE x.oid = objid) WHEN 'pg_rewrite'::regclass::oid THEN (SELECT x.ev_class::regclass::text || ' rule ' || x.rulename::text FROM pg_catalog.pg_rewrite x WHERE x.oid = objid) WHEN 'pg_trigger'::regclass::oid THEN (SELECT CASE WHEN x.tgisinternal THEN 'internal trigger' ELSE x.tgname::text END || ' on ' || x.tgrelid::regclass::text FROM pg_catalog.pg_trigger x WHERE x.oid = objid) WHEN 'pg_policy'::regclass::oid THEN (SELECT x.polname::text || ' on ' || x.polrelid::regclass::text FROM pg_catalog.pg_policy x WHERE x.oid = objid) ELSE CASE WHEN objid < 16384 THEN objid::text ELSE 'user object' END END AS objid,
  objsubid, refclassid::regclass::text AS refclassid,
  CASE refclassid WHEN 'pg_class'::regclass::oid THEN refobjid::regclass::text WHEN 'pg_type'::regclass::oid THEN refobjid::regtype::text WHEN 'pg_proc'::regclass::oid THEN refobjid::regprocedure::text WHEN 'pg_namespace'::regclass::oid THEN refobjid::regnamespace::text WHEN 'pg_constraint'::regclass::oid THEN (SELECT x.conname::text || ' on ' || CASE WHEN x.conrelid <> 0 THEN x.conrelid::regclass::text ELSE x.contypid::regtype::text END FROM pg_catalog.pg_constraint x WHERE x.oid = refobjid) WHEN 'pg_attrdef'::regclass::oid THEN (SELECT x.adrelid::regclass::text || ' default ' || x.adnum::text FROM pg_catalog.pg_attrdef x WHERE x.oid = refobjid) WHEN 'pg_rewrite'::regclass::oid THEN (SELECT x.ev_class::regclass::text || ' rule ' || x.rulename::text FROM pg_catalog.pg_rewrite x WHERE x.oid = refobjid) WHEN 'pg_trigger'::regclass::oid THEN (SELECT CASE WHEN x.tgisinternal THEN 'internal trigger' ELSE x.tgname::text END || ' on ' || x.tgrelid::regclass::text FROM pg_catalog.pg_trigger x WHERE x.oid = refobjid) WHEN 'pg_policy'::regclass::oid THEN (SELECT x.polname::text || ' on ' || x.polrelid::regclass::text FROM pg_catalog.pg_policy x WHERE x.oid = refobjid) ELSE CASE WHEN refobjid < 16384 THEN refobjid::text ELSE 'user object' END END AS refobjid,
  refobjsubid, deptype
FROM pg_catalog.pg_depend
WHERE ((objid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_type WHERE typnamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_proc WHERE pronamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_constraint WHERE connamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_trigger WHERE tgrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) UNION ALL SELECT oid FROM pg_catalog.pg_policy WHERE polrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) UNION ALL SELECT 'pgonly'::regnamespace::oid) OR refobjid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_type WHERE typnamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_proc WHERE pronamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_constraint WHERE connamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_trigger WHERE tgrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) UNION ALL SELECT oid FROM pg_catalog.pg_policy WHERE polrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) UNION ALL SELECT 'pgonly'::regnamespace::oid)) AND NOT (classid = 'pg_class'::regclass::oid AND objid IN (SELECT reltoastrelid FROM pg_catalog.pg_class WHERE reltoastrelid <> 0)))
) q
WHERE ((q.classid, q.objid, (q.objsubid)::text, q.refclassid, q.refobjid) IN (
    ('pg_policy', 'parent_reader on pgonly.parent', '0', 'pg_class', 'pgonly.parent'))
  OR (q.classid, q.objid, (q.objsubid)::text, q.refclassid, q.refobjid, (q.refobjsubid)::text) IN (
    ('pg_class', 'pgonly.cascade_child', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_class', 'pgonly.cascade_child_pkey', '0', 'pg_constraint', 'cascade_child_pkey on pgonly.cascade_child', '0'),
    ('pg_class', 'pgonly.domain_tab', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_class', 'pgonly.domain_tab', '2', 'pg_type', 'pgonly.positive_int', '0'),
    ('pg_class', 'pgonly.domain_tab_pkey', '0', 'pg_constraint', 'domain_tab_pkey on pgonly.domain_tab', '0'),
    ('pg_class', 'pgonly.identity_tab', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_class', 'pgonly.identity_tab_code_key', '0', 'pg_constraint', 'identity_tab_code_key on pgonly.identity_tab', '0'),
    ('pg_class', 'pgonly.identity_tab_id_seq', '0', 'pg_class', 'pgonly.identity_tab', '1'),
    ('pg_class', 'pgonly.identity_tab_id_seq', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_class', 'pgonly.identity_tab_pkey', '0', 'pg_constraint', 'identity_tab_pkey on pgonly.identity_tab', '0'),
    ('pg_class', 'pgonly.json_tab', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_class', 'pgonly.json_tab_pkey', '0', 'pg_constraint', 'json_tab_pkey on pgonly.json_tab', '0'),
    ('pg_constraint', 'cascade_child_id_not_null on pgonly.cascade_child', '0', 'pg_class', 'pgonly.cascade_child', '1'),
    ('pg_constraint', 'cascade_child_parent_id_fkey on pgonly.cascade_child', '0', 'pg_class', 'pgonly.cascade_child', '2'),
    ('pg_constraint', 'cascade_child_parent_id_fkey on pgonly.cascade_child', '0', 'pg_class', 'pgonly.parent', '1'),
    ('pg_constraint', 'cascade_child_parent_id_fkey on pgonly.cascade_child', '0', 'pg_class', 'pgonly.parent_pkey', '0'),
    ('pg_constraint', 'cascade_child_pkey on pgonly.cascade_child', '0', 'pg_class', 'pgonly.cascade_child', '1'),
    ('pg_constraint', 'domain_tab_id_not_null on pgonly.domain_tab', '0', 'pg_class', 'pgonly.domain_tab', '1'),
    ('pg_constraint', 'domain_tab_pkey on pgonly.domain_tab', '0', 'pg_class', 'pgonly.domain_tab', '1'),
    ('pg_constraint', 'identity_tab_code_key on pgonly.identity_tab', '0', 'pg_class', 'pgonly.identity_tab', '2'),
    ('pg_constraint', 'identity_tab_id_not_null on pgonly.identity_tab', '0', 'pg_class', 'pgonly.identity_tab', '1'),
    ('pg_constraint', 'identity_tab_pkey on pgonly.identity_tab', '0', 'pg_class', 'pgonly.identity_tab', '1'),
    ('pg_constraint', 'identity_tab_qty_check on pgonly.identity_tab', '0', 'pg_class', 'pgonly.identity_tab', '3'),
    ('pg_constraint', 'json_tab_id_not_null on pgonly.json_tab', '0', 'pg_class', 'pgonly.json_tab', '1'),
    ('pg_constraint', 'json_tab_pkey on pgonly.json_tab', '0', 'pg_class', 'pgonly.json_tab', '1'),
    ('pg_constraint', 'positive_int_check on pgonly.positive_int', '0', 'pg_type', 'pgonly.positive_int', '0'),
    ('pg_proc', 'pgonly.touch()', '0', 'pg_language', '13647', '0'),
    ('pg_proc', 'pgonly.touch()', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_trigger', 'internal trigger on pgonly.cascade_child', '0', 'pg_constraint', 'cascade_child_parent_id_fkey on pgonly.cascade_child', '0'),
    ('pg_trigger', 'internal trigger on pgonly.parent', '0', 'pg_constraint', 'cascade_child_parent_id_fkey on pgonly.cascade_child', '0'),
    ('pg_trigger', 'parent_touch on pgonly.parent', '0', 'pg_class', 'pgonly.parent', '0'),
    ('pg_trigger', 'parent_touch on pgonly.parent', '0', 'pg_proc', 'pgonly.touch()', '0'),
    ('pg_type', 'pgonly.cascade_child', '0', 'pg_class', 'pgonly.cascade_child', '0'),
    ('pg_type', 'pgonly.cascade_child[]', '0', 'pg_type', 'pgonly.cascade_child', '0'),
    ('pg_type', 'pgonly.domain_tab', '0', 'pg_class', 'pgonly.domain_tab', '0'),
    ('pg_type', 'pgonly.domain_tab[]', '0', 'pg_type', 'pgonly.domain_tab', '0'),
    ('pg_type', 'pgonly.identity_tab', '0', 'pg_class', 'pgonly.identity_tab', '0'),
    ('pg_type', 'pgonly.identity_tab[]', '0', 'pg_type', 'pgonly.identity_tab', '0'),
    ('pg_type', 'pgonly.json_tab', '0', 'pg_class', 'pgonly.json_tab', '0'),
    ('pg_type', 'pgonly.json_tab[]', '0', 'pg_type', 'pgonly.json_tab', '0'),
    ('pg_type', 'pgonly.positive_int', '0', 'pg_namespace', 'pgonly', '0'),
    ('pg_type', 'pgonly.positive_int[]', '0', 'pg_type', 'pgonly.positive_int', '0')))
ORDER BY q.classid::text COLLATE "C", q.objid::text COLLATE "C", q.objsubid, q.refclassid::text COLLATE "C",
  q.refobjid::text COLLATE "C", q.refobjsubid
