  pg_catalog.has_column_privilege('conf_reader', 'public.orders', a.attname, 'SELECT') AS reader_select
FROM pg_catalog.pg_attribute a
WHERE a.attrelid = 'public.orders'::regclass AND a.attnum > 0 AND NOT a.attisdropped
  AND a.attname::text IN ('status', 'ticket')
ORDER BY a.attnum
----
