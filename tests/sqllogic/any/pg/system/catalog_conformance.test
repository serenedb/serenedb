customers_name_email_idx	f	t	f	t	CREATE UNIQUE INDEX customers_name_email_idx ON customers USING btree (name, email)	NULL	NULL	NULL	NULL	f	0
customers_pkey	t	t	f	t	CREATE UNIQUE INDEX customers_pkey ON customers USING btree (id)	PRIMARY KEY (id)	p	f	f	f	0


query
SELECT q.sametable, q.conname, q.condef, (q.ontable)::text AS ontable FROM (
SELECT true as sametable, conname,
  pg_catalog.pg_get_constraintdef(r.oid, true) as condef,
  conrelid::pg_catalog.regclass AS ontable
FROM pg_catalog.pg_constraint r
WHERE r.conrelid = 'public.customers'::regclass AND r.contype = 'f'
     AND conparentid = 0
ORDER BY conname
) q
----
sametable	conname	condef	ontable


query
SELECT q.conname, (q.ontable)::text AS ontable, q.condef FROM (
SELECT conname, conrelid::pg_catalog.regclass AS ontable,
       pg_catalog.pg_get_constraintdef(oid, true) AS condef
  FROM pg_catalog.pg_constraint c
 WHERE confrelid IN (SELECT pg_catalog.pg_partition_ancestors('public.customers'::regclass)
                     UNION ALL VALUES ('public.customers'::pg_catalog.regclass))
       AND contype = 'f' AND conparentid = 0
ORDER BY conname
) q
----
conname	ontable	condef
orders_customer_id_fkey	orders	FOREIGN KEY (customer_id) REFERENCES customers(id)


