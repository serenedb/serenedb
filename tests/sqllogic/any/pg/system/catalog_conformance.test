query
SELECT * FROM (
SELECT con.conname::text AS conname,
  CASE WHEN con.conrelid <> 0 THEN con.conrelid::regclass::text ELSE con.contypid::regtype::text END AS owner,
  pg_catalog.pg_get_constraintdef(con.oid) AS def, pg_catalog.pg_get_constraintdef(con.oid, true) AS def_pretty,
  pg_catalog.obj_description(con.oid, 'pg_constraint') AS description
FROM pg_catalog.pg_constraint con
WHERE con.connamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)
) q
WHERE (q.conname, q.owner) IN (('order_items_qty_check', 'order_items'), ('orders_amount_check', 'orders'),
    ('orders_status_check', 'orders'), ('unique_tab_qty_check', 'app.unique_tab'))
ORDER BY q.conname::text COLLATE "C", q.owner::text COLLATE "C"
----
conname	owner	def	def_pretty	description
order_items_qty_check	order_items	CHECK ((qty > 0))	CHECK (qty > 0)	NULL
orders_amount_check	orders	CHECK ((amount >= (0)::numeric))	CHECK (amount >= 0::numeric)	NULL
orders_status_check	orders	CHECK (((status)::text = ANY ((ARRAY['new'::character varying, 'paid'::character varying, 'shipped'::character varying])::text[])))	CHECK (status::text = ANY (ARRAY['new'::character varying, 'paid'::character varying, 'shipped'::character varying]::text[]))	NULL
unique_tab_qty_check	app.unique_tab	CHECK (((qty >= 1) AND (qty <= 100)))	CHECK (qty >= 1 AND qty <= 100)	NULL


