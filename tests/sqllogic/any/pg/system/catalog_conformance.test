orders_amount_check	public	c	f	f	t	t	orders	-	-	t	-	_	_	_	t	0	f	f	{3}	NULL	NULL	NULL	NULL	NULL	NULL	(amount >= (0)::numeric)
orders_customer_id_fkey	public	f	f	f	t	t	orders	-	customers_pkey	t	customers	a	a	s	t	0	t	f	{2}	{1}	96	96	96	NULL	NULL	NULL
