  (SELECT pg_catalog.pg_get_expr(p.polqual, p.polrelid) FROM pg_catalog.pg_policy p WHERE p.polrelid = 'pgonly.parent'::regclass) AS policy_qual,
  pg_catalog.obj_description('pgonly'::regnamespace, 'pg_namespace') AS schema_description,
  (SELECT pg_catalog.obj_description(c.oid, 'pg_constraint') FROM pg_catalog.pg_constraint c WHERE c.conrelid = 'pgonly.identity_tab'::regclass AND c.conname = 'identity_tab_qty_check') AS constraint_description
