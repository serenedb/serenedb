query
SELECT q.relname, q.indisprimary, q.indisunique, q.indisclustered, q.indisvalid,
  replace(q.pg_get_indexdef, ' USING secondary ', ' USING btree ') AS pg_get_indexdef, q.pg_get_constraintdef,
  q.contype, q.condeferrable, q.condeferred, q.indisreplident, q.reltablespace FROM (
SELECT c2.relname, i.indisprimary, i.indisunique, i.indisclustered, i.indisvalid, pg_catalog.pg_get_indexdef(i.indexrelid, 0, true),
  pg_catalog.pg_get_constraintdef(con.oid, true), contype, condeferrable, condeferred, i.indisreplident, c2.reltablespace
FROM pg_catalog.pg_class c, pg_catalog.pg_class c2, pg_catalog.pg_index i
  LEFT JOIN pg_catalog.pg_constraint con ON (conrelid = i.indrelid AND conindid = i.indexrelid AND contype IN ('p','u','x'))
WHERE c.oid = 'public.customers'::regclass AND c.oid = i.indrelid AND i.indexrelid = c2.oid
ORDER BY i.indisprimary DESC, c2.relname
) q
ORDER BY q.relname::text COLLATE "C"
----
relname	indisprimary	indisunique	indisclustered	indisvalid	pg_get_indexdef	pg_get_constraintdef	contype	condeferrable	condeferred	indisreplident	reltablespace
customers_email_key	f	t	f	t	CREATE UNIQUE INDEX customers_email_key ON customers USING btree (email)	UNIQUE (email)	u	f	f	f	0
customers_name_email_idx	f	t	f	t	CREATE UNIQUE INDEX customers_name_email_idx ON customers USING btree (name, email)	NULL	NULL	NULL	NULL	f	0
customers_pkey	t	t	f	t	CREATE UNIQUE INDEX customers_pkey ON customers USING btree (id)	PRIMARY KEY (id)	p	f	f	f	0


