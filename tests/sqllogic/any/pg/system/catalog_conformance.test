skipif serenedb
query
SELECT oid, typname, typnamespace::regnamespace::text AS typnamespace,
  pg_catalog.pg_get_userbyid(typowner) AS typowner, typlen, typbyval, typtype, typcategory, typispreferred,
  typisdefined, typdelim, typrelid::regclass::text AS typrelid, typsubscript::text AS typsubscript,
  typelem::regtype::text AS typelem, typarray::regtype::text AS typarray, typinput::text AS typinput,
  typoutput::text AS typoutput, typreceive::text AS typreceive, typsend::text AS typsend, typmodin::text AS typmodin,
  typmodout::text AS typmodout, typanalyze::text AS typanalyze, typalign, typstorage, typnotnull,
  typbasetype::regtype::text AS typbasetype, typtypmod, typndims, typcollation, typdefault,
  (SELECT string_agg(x::text, ',' ORDER BY x::text COLLATE "C") FROM unnest(typacl) x) AS typacl
FROM pg_catalog.pg_type
WHERE oid < 16384
  AND (oid)::text IN ('13382', '13383', '3615', '3645')
ORDER BY oid
----
oid	typname	typnamespace	typowner	typlen	typbyval	typtype	typcategory	typispreferred	typisdefined	typdelim	typrelid	typsubscript	typelem	typarray	typinput	typoutput	typreceive	typsend	typmodin	typmodout	typanalyze	typalign	typstorage	typnotnull	typbasetype	typtypmod	typndims	typcollation	typdefault	typacl
3615	tsquery	pg_catalog	postgres	-1	f	b	U	f	t	,	-	-	-	tsquery[]	tsqueryin	tsqueryout	tsqueryrecv	tsquerysend	-	-	-	i	p	f	-	-1	0	0	NULL	NULL
3645	_tsquery	pg_catalog	postgres	-1	f	b	A	f	t	,	-	array_subscript_handler	tsquery	-	array_in	array_out	array_recv	array_send	-	-	array_typanalyze	i	x	f	-	-1	0	0	NULL	NULL
13382	_columns	information_schema	postgres	-1	f	b	A	f	t	,	-	array_subscript_handler	information_schema.columns	-	array_in	array_out	array_recv	array_send	-	-	array_typanalyze	d	x	f	-	-1	0	0	NULL	NULL
13383	columns	information_schema	postgres	-1	f	c	C	f	t	,	information_schema.columns	-	-	information_schema.columns[]	record_in	record_out	record_recv	record_send	-	-	-	d	x	f	-	-1	0	0	NULL	NULL


