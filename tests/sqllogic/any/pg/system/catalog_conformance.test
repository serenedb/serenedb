name	oid	array_oid	regtype	delimiter
mood	app.mood	app.mood[]	app.mood	,


query
SELECT q.conname, q.valid FROM (
SELECT conname, pg_get_constraintdef(c.oid, true) AS constraintdef, c.convalidated AS valid FROM pg_constraint c JOIN pg_class t ON c.conrelid = t.oid JOIN pg_namespace n ON n.oid = c.connamespace WHERE c.contype = 'c' AND t.relname = 'orders' AND n.nspname = ANY (current_schemas(false))
) q
ORDER BY q.conname::text COLLATE "C"
----
conname	valid
orders_amount_check	t
orders_status_check	t


skipif serenedb
query
SELECT q.conname, q.constraintdef FROM (
SELECT conname, pg_get_constraintdef(c.oid, true) AS constraintdef, c.convalidated AS valid FROM pg_constraint c JOIN pg_class t ON c.conrelid = t.oid JOIN pg_namespace n ON n.oid = c.connamespace WHERE c.contype = 'c' AND t.relname = 'orders' AND n.nspname = ANY (current_schemas(false))
) q
ORDER BY q.conname::text COLLATE "C"
----
conname	constraintdef
orders_amount_check	CHECK (amount >= 0::numeric)
orders_status_check	CHECK (status::text = ANY (ARRAY['new'::character varying, 'paid'::character varying, 'shipped'::character varying]::text[]))


