  trim(regexp_replace(pg_catalog.pg_get_ruledef(r.oid), '[[:space:]]+', ' ', 'g')) AS def,
  trim(regexp_replace(pg_catalog.pg_get_ruledef(r.oid, true), '[[:space:]]+', ' ', 'g')) AS def_pretty
FROM pg_catalog.pg_rewrite r
WHERE r.ev_class IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid))
ORDER BY r.ev_class::regclass::text COLLATE "C", r.rulename::text COLLATE "C"
----
rel	rulename	def	def_pretty
active_customers	_RETURN	CREATE RULE "_RETURN" AS ON SELECT TO public.active_customers DO INSTEAD SELECT id, email, name FROM customers WHERE active;	CREATE RULE "_RETURN" AS ON SELECT TO active_customers DO INSTEAD SELECT id, email, name FROM customers WHERE active;
app.order_totals	_RETURN	CREATE RULE "_RETURN" AS ON SELECT TO app.order_totals DO INSTEAD SELECT customer_id, sum(amount) AS total, count(*) AS n FROM orders o GROUP BY customer_id;	CREATE RULE "_RETURN" AS ON SELECT TO app.order_totals DO INSTEAD SELECT customer_id, sum(amount) AS total, count(*) AS n FROM orders o GROUP BY customer_id;


