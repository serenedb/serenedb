query
SELECT q.oid::regtype::text AS oid, q.typarray::regtype::text AS typarray FROM (
select b.oid, b.typarray from pg_catalog.pg_type a left join pg_catalog.pg_type b on b.oid = a.typelem where a.typcategory = 'A' group by b.oid, b.typarray order by b.oid
) q
WHERE q.oid::regtype::text IN ('geometry', 'information_schema."columns"', 'information_schema.columns', 'union', 'variant')
ORDER BY q.oid::regtype::text COLLATE "C"
----
oid	typarray
information_schema.columns	information_schema.columns[]


onlyif serenedb
query
