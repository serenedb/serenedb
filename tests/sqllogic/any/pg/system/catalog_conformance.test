SELECT r.ev_class::regclass::text AS rel, r.rulename::text AS rulename
FROM pg_catalog.pg_rewrite r
WHERE r.ev_class IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid))
ORDER BY r.ev_class::regclass::text COLLATE "C", r.rulename::text COLLATE "C"
----
rel	rulename
active_customers	_RETURN
app.order_totals	_RETURN


