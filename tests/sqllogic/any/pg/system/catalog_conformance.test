query
SELECT oid::regprocedure::text AS oid, proname, pronamespace::regnamespace::text AS pronamespace,
  pg_catalog.pg_get_userbyid(proowner) AS proowner,
  (SELECT x.lanname::text FROM pg_catalog.pg_language x WHERE x.oid = prolang) AS prolang, procost, prorows,
  provariadic::regtype::text AS provariadic, prosupport::text AS prosupport, prokind, prosecdef, proleakproof,
  proisstrict, proretset, provolatile, proparallel, pronargs, pronargdefaults,
  prorettype::regtype::text AS prorettype,
  array_to_string(ARRAY(SELECT x::regtype::text FROM unnest(proargtypes::oid[]) x), ',') AS proargtypes,
  array_to_string(ARRAY(SELECT x::regtype::text FROM unnest(proallargtypes::oid[]) x), ',') AS proallargtypes,
  proargmodes, proargnames,
  array_to_string(ARRAY(SELECT x::regtype::text FROM unnest(protrftypes::oid[]) x), ',') AS protrftypes,
  trim(regexp_replace(prosrc, '[[:space:]]+', ' ', 'g')) AS prosrc, probin, proconfig,
  (SELECT string_agg(x::text, ',' ORDER BY x::text COLLATE "C") FROM unnest(proacl) x) AS proacl
FROM pg_catalog.pg_proc
WHERE pronamespace IN ('pgonly'::regnamespace::oid)
  AND oid::regprocedure::text NOT IN ('pgonly.touch()')
ORDER BY oid::regprocedure::text COLLATE "C"
----
oid	proname	pronamespace	proowner	prolang	procost	prorows	provariadic	prosupport	prokind	prosecdef	proleakproof	proisstrict	proretset	provolatile	proparallel	pronargs	pronargdefaults	prorettype	proargtypes	proallargtypes	proargmodes	proargnames	protrftypes	prosrc	probin	proconfig	proacl


