query
SELECT
  CASE WHEN specific_catalog::text = current_database() THEN 'db' ELSE specific_catalog::text END AS specific_catalog,
  specific_schema, regexp_replace(specific_name::text, '_[0-9]+$', '') AS specific_name,
  CASE WHEN routine_catalog::text = current_database() THEN 'db' ELSE routine_catalog::text END AS routine_catalog,
  routine_schema, routine_name, routine_type,
  CASE WHEN module_catalog::text = current_database() THEN 'db' ELSE module_catalog::text END AS module_catalog,
  module_schema, module_name,
  CASE WHEN udt_catalog::text = current_database() THEN 'db' ELSE udt_catalog::text END AS udt_catalog, udt_schema,
  udt_name, data_type, character_maximum_length, character_octet_length,
  CASE WHEN character_set_catalog::text = current_database() THEN 'db' ELSE character_set_catalog::text END AS character_set_catalog,
  character_set_schema, character_set_name,
  CASE WHEN collation_catalog::text = current_database() THEN 'db' ELSE collation_catalog::text END AS collation_catalog,
  collation_schema, collation_name, numeric_precision, numeric_precision_radix, numeric_scale, datetime_precision,
  interval_type, interval_precision,
  CASE WHEN type_udt_catalog::text = current_database() THEN 'db' ELSE type_udt_catalog::text END AS type_udt_catalog,
  type_udt_schema, type_udt_name,
  CASE WHEN scope_catalog::text = current_database() THEN 'db' ELSE scope_catalog::text END AS scope_catalog,
  scope_schema, scope_name, maximum_cardinality, dtd_identifier, routine_body, external_name, external_language,
  parameter_style, is_deterministic, sql_data_access, is_null_call, sql_path, schema_level_routine,
  max_dynamic_result_sets, is_user_defined_cast, is_implicitly_invocable, security_type,
  CASE WHEN to_sql_specific_catalog::text = current_database() THEN 'db' ELSE to_sql_specific_catalog::text END AS to_sql_specific_catalog,
  to_sql_specific_schema, regexp_replace(to_sql_specific_name::text, '_[0-9]+$', '') AS to_sql_specific_name,
  as_locator, created, last_altered, new_savepoint_level, is_udt_dependent, result_cast_from_data_type,
  result_cast_as_locator, result_cast_char_max_length, result_cast_char_octet_length,
  CASE WHEN result_cast_char_set_catalog::text = current_database() THEN 'db' ELSE result_cast_char_set_catalog::text END AS result_cast_char_set_catalog,
  result_cast_char_set_schema, result_cast_char_set_name,
  CASE WHEN result_cast_collation_catalog::text = current_database() THEN 'db' ELSE result_cast_collation_catalog::text END AS result_cast_collation_catalog,
  result_cast_collation_schema, result_cast_collation_name, result_cast_numeric_precision,
  result_cast_numeric_precision_radix, result_cast_numeric_scale, result_cast_datetime_precision,
  result_cast_interval_type, result_cast_interval_precision,
  CASE WHEN result_cast_type_udt_catalog::text = current_database() THEN 'db' ELSE result_cast_type_udt_catalog::text END AS result_cast_type_udt_catalog,
  result_cast_type_udt_schema, result_cast_type_udt_name,
  CASE WHEN result_cast_scope_catalog::text = current_database() THEN 'db' ELSE result_cast_scope_catalog::text END AS result_cast_scope_catalog,
  result_cast_scope_schema, result_cast_scope_name, result_cast_maximum_cardinality, result_cast_dtd_identifier
FROM information_schema.routines
WHERE routine_schema IN ('app', 'public')
----
specific_catalog	specific_schema	specific_name	routine_catalog	routine_schema	routine_name	routine_type	module_catalog	module_schema	module_name	udt_catalog	udt_schema	udt_name	data_type	character_maximum_length	character_octet_length	character_set_catalog	character_set_schema	character_set_name	collation_catalog	collation_schema	collation_name	numeric_precision	numeric_precision_radix	numeric_scale	datetime_precision	interval_type	interval_precision	type_udt_catalog	type_udt_schema	type_udt_name	scope_catalog	scope_schema	scope_name	maximum_cardinality	dtd_identifier	routine_body	external_name	external_language	parameter_style	is_deterministic	sql_data_access	is_null_call	sql_path	schema_level_routine	max_dynamic_result_sets	is_user_defined_cast	is_implicitly_invocable	security_type	to_sql_specific_catalog	to_sql_specific_schema	to_sql_specific_name	as_locator	created	last_altered	new_savepoint_level	is_udt_dependent	result_cast_from_data_type	result_cast_as_locator	result_cast_char_max_length	result_cast_char_octet_length	result_cast_char_set_catalog	result_cast_char_set_schema	result_cast_char_set_name	result_cast_collation_catalog	result_cast_collation_schema	result_cast_collation_name	result_cast_numeric_precision	result_cast_numeric_precision_radix	result_cast_numeric_scale	result_cast_datetime_precision	result_cast_interval_type	result_cast_interval_precision	result_cast_type_udt_catalog	result_cast_type_udt_schema	result_cast_type_udt_name	result_cast_scope_catalog	result_cast_scope_schema	result_cast_scope_name	result_cast_maximum_cardinality	result_cast_dtd_identifier
