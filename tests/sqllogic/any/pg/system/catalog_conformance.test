FROM pg_catalog.pg_attrdef
WHERE adrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid))
  AND (adrelid::regclass::text, (adnum)::text) NOT IN (('app.all_types', '8'), ('customers', '1'), ('customers', '5'),
    ('orders', '1'), ('orders', '4'), ('orders', '6'), ('orders', '7'))
ORDER BY adrelid::regclass::text COLLATE "C", adnum
