query
SELECT q.relname, q.indisprimary, q.indisunique, q.indisclustered, q.indisvalid,
  replace(q.pg_get_indexdef, ' USING secondary ', ' USING btree ') AS pg_get_indexdef, q.pg_get_constraintdef,
  q.contype, q.condeferrable, q.condeferred, q.indisreplident, q.reltablespace FROM (
SELECT c2.relname, i.indisprimary, i.indisunique, i.indisclustered, i.indisvalid, pg_catalog.pg_get_indexdef(i.indexrelid, 0, true),
  pg_catalog.pg_get_constraintdef(con.oid, true), contype, condeferrable, condeferred, i.indisreplident, c2.reltablespace
FROM pg_catalog.pg_class c, pg_catalog.pg_class c2, pg_catalog.pg_index i
  LEFT JOIN pg_catalog.pg_constraint con ON (conrelid = i.indrelid AND conindid = i.indexrelid AND contype IN ('p','u','x'))
WHERE c.oid = 'app.all_types'::regclass AND c.oid = i.indrelid AND i.indexrelid = c2.oid
ORDER BY i.indisprimary DESC, c2.relname
) q
ORDER BY q.relname::text COLLATE "C"
----
relname	indisprimary	indisunique	indisclustered	indisvalid	pg_get_indexdef	pg_get_constraintdef	contype	condeferrable	condeferred	indisreplident	reltablespace
all_types_pkey	t	t	f	t	CREATE UNIQUE INDEX all_types_pkey ON app.all_types USING btree (c_int8)	PRIMARY KEY (c_int8)	p	f	f	f	0
all_types_varchar_idx	f	f	f	t	CREATE INDEX all_types_varchar_idx ON app.all_types USING btree (c_varchar)	NULL	NULL	NULL	NULL	f	0


query
SELECT q.c1 AS polname, q.c2 AS polpermissive, q.c3 AS array_to_string, q.c4 AS pg_get_expr, q.c5 AS pg_get_expr,
  q.c6 AS cmd FROM (
SELECT pol.polname, pol.polpermissive,
  CASE WHEN pol.polroles = '{0}' THEN NULL ELSE pg_catalog.array_to_string(array(select rolname from pg_catalog.pg_roles where oid = any (pol.polroles) order by 1),',') END,
  pg_catalog.pg_get_expr(pol.polqual, pol.polrelid),
  pg_catalog.pg_get_expr(pol.polwithcheck, pol.polrelid),
  CASE pol.polcmd
    WHEN 'r' THEN 'SELECT'
    WHEN 'a' THEN 'INSERT'
    WHEN 'w' THEN 'UPDATE'
    WHEN 'd' THEN 'DELETE'
    END AS cmd
FROM pg_catalog.pg_policy pol
WHERE pol.polrelid = 'app.all_types'::regclass ORDER BY 1
) q(c1, c2, c3, c4, c5, c6)
----
polname	polpermissive	array_to_string	pg_get_expr	pg_get_expr	cmd


query
SELECT q.oid, (q.stxrelid)::text AS stxrelid, q.nsp, q.stxname, q.columns, q.ndist_enabled, q.deps_enabled,
  q.mcv_enabled, q.stxstattarget FROM (
SELECT oid, stxrelid::pg_catalog.regclass, stxnamespace::pg_catalog.regnamespace::pg_catalog.text AS nsp, stxname,
pg_catalog.pg_get_statisticsobjdef_columns(oid) AS columns,
  'd' = any(stxkind) AS ndist_enabled,
  'f' = any(stxkind) AS deps_enabled,
  'm' = any(stxkind) AS mcv_enabled,
stxstattarget
FROM pg_catalog.pg_statistic_ext
WHERE stxrelid = 'app.all_types'::regclass
ORDER BY nsp, stxname
) q
----
oid	stxrelid	nsp	stxname	columns	ndist_enabled	deps_enabled	mcv_enabled	stxstattarget


query
SELECT q.c1 AS pubname, q.c2 AS "?column?", q.c3 AS "?column?" FROM (
SELECT pubname
     , NULL
     , NULL
FROM pg_catalog.pg_publication p
     JOIN pg_catalog.pg_publication_namespace pn ON p.oid = pn.pnpubid
     JOIN pg_catalog.pg_class pc ON pc.relnamespace = pn.pnnspid
WHERE pc.oid ='app.all_types'::regclass and pg_catalog.pg_relation_is_publishable('app.all_types'::regclass)
UNION
SELECT pubname
     , pg_get_expr(pr.prqual, c.oid)
     , (CASE WHEN pr.prattrs IS NOT NULL THEN
         (SELECT string_agg(attname, ', ')
           FROM pg_catalog.generate_series(0, pg_catalog.array_upper(pr.prattrs::pg_catalog.int2[], 1)) s,
                pg_catalog.pg_attribute
          WHERE attrelid = pr.prrelid AND attnum = prattrs[s])
        ELSE NULL END) FROM pg_catalog.pg_publication p
     JOIN pg_catalog.pg_publication_rel pr ON p.oid = pr.prpubid
     JOIN pg_catalog.pg_class c ON c.oid = pr.prrelid
WHERE pr.prrelid = 'app.all_types'::regclass
UNION
SELECT pubname
     , NULL
     , NULL
FROM pg_catalog.pg_publication p
WHERE p.puballtables AND pg_catalog.pg_relation_is_publishable('app.all_types'::regclass)
ORDER BY 1
) q(c1, c2, c3)
----
pubname	?column?	?column?


query
SELECT (q.oid)::text AS oid FROM (
SELECT c.oid::pg_catalog.regclass
FROM pg_catalog.pg_class c, pg_catalog.pg_inherits i
WHERE c.oid = i.inhparent AND i.inhrelid = 'app.all_types'::regclass
  AND c.relkind != 'p' AND c.relkind != 'I'
ORDER BY inhseqno
) q
----
oid


query
SELECT (q.oid)::text AS oid, q.relkind, q.inhdetachpending, q.pg_get_expr FROM (
SELECT c.oid::pg_catalog.regclass, c.relkind, inhdetachpending, pg_catalog.pg_get_expr(c.relpartbound, c.oid)
FROM pg_catalog.pg_class c, pg_catalog.pg_inherits i
WHERE c.oid = i.inhrelid AND i.inhparent = 'app.all_types'::regclass
ORDER BY pg_catalog.pg_get_expr(c.relpartbound, c.oid) = 'DEFAULT', c.oid::pg_catalog.regclass::pg_catalog.text
) q
----
oid	relkind	inhdetachpending	pg_get_expr


query
SELECT q.oid::regclass::text AS oid, q.nspname, q.relname FROM (
SELECT c.oid,
  n.nspname,
  c.relname
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname OPERATOR(pg_catalog.~) '^(customers)$' COLLATE pg_catalog.default
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 2, 3
) q
----
oid	nspname	relname
customers	public	customers


query
SELECT q.relchecks, q.relkind, q.relhasindex, q.relhasrules, q.relhastriggers, q.relrowsecurity,
  q.relforcerowsecurity, q.relhasoids, q.relispartition, q."?column?", q.reltablespace, q.reloftype, q.relpersistence,
  q.relreplident, q.amname FROM (
SELECT c.relchecks, c.relkind, c.relhasindex, c.relhasrules, c.relhastriggers, c.relrowsecurity, c.relforcerowsecurity, false AS relhasoids, c.relispartition, '', c.reltablespace, CASE WHEN c.reloftype = 0 THEN '' ELSE c.reloftype::pg_catalog.regtype::pg_catalog.text END, c.relpersistence, c.relreplident, am.amname
FROM pg_catalog.pg_class c
 LEFT JOIN pg_catalog.pg_class tc ON (c.reltoastrelid = tc.oid)
LEFT JOIN pg_catalog.pg_am am ON (c.relam = am.oid)
WHERE c.oid = 'public.customers'::regclass
) q
----
relchecks	relkind	relhasindex	relhasrules	relhastriggers	relrowsecurity	relforcerowsecurity	relhasoids	relispartition	?column?	reltablespace	reloftype	relpersistence	relreplident	amname
0	r	t	f	t	f	f	f	f	(empty)	0	(empty)	p	d	heap


query
SELECT q.attname, q.format_type, q.pg_get_expr, q.attnotnull, q.attcollation, q.attidentity, q.attgenerated FROM (
SELECT a.attname,
  pg_catalog.format_type(a.atttypid, a.atttypmod),
  (SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true)
   FROM pg_catalog.pg_attrdef d
   WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum AND a.atthasdef),
  a.attnotnull,
  (SELECT c.collname FROM pg_catalog.pg_collation c, pg_catalog.pg_type t
   WHERE c.oid = a.attcollation AND t.oid = a.atttypid AND a.attcollation <> t.typcollation) AS attcollation,
  a.attidentity,
  a.attgenerated
FROM pg_catalog.pg_attribute a
WHERE a.attrelid = 'public.customers'::regclass AND a.attnum > 0 AND NOT a.attisdropped
ORDER BY a.attnum
) q
WHERE q.attname NOT IN ('email', 'id', 'mood')
ORDER BY q.attname::text COLLATE "C"
----
attname	format_type	pg_get_expr	attnotnull	attcollation	attidentity	attgenerated
active	boolean	true	f	NULL	(empty)	(empty)
created	timestamp with time zone	now()	f	NULL	(empty)	(empty)
home	app.address	NULL	f	NULL	(empty)	(empty)
name	text	NULL	t	NULL	(empty)	(empty)


