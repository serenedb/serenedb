    ('true', 'pg_policy', 'parent_reader on pgonly.parent', '0', 'pg_authid', 'conf_reader', 'r'))
ORDER BY q.dbid, q.classid::text COLLATE "C", q.objid::text COLLATE "C", q.objsubid, q.refclassid::text COLLATE "C",
  q.refobjid::text COLLATE "C", q.deptype::text COLLATE "C"
----
dbid	classid	objid	objsubid	refclassid	refobjid	deptype
t	pg_policy	parent_reader on pgonly.parent	0	pg_authid	conf_reader	r


onlyif serenedb
query
SELECT * FROM (
SELECT dbid = (SELECT x.oid FROM pg_catalog.pg_database x WHERE x.datname = current_database()) AS dbid,
  classid::regclass::text AS classid,
  CASE classid WHEN 'pg_class'::regclass::oid THEN objid::regclass::text WHEN 'pg_type'::regclass::oid THEN objid::regtype::text WHEN 'pg_proc'::regclass::oid THEN objid::regprocedure::text WHEN 'pg_namespace'::regclass::oid THEN objid::regnamespace::text WHEN 'pg_constraint'::regclass::oid THEN (SELECT x.conname::text || ' on ' || CASE WHEN x.conrelid <> 0 THEN x.conrelid::regclass::text ELSE x.contypid::regtype::text END FROM pg_catalog.pg_constraint x WHERE x.oid = objid) WHEN 'pg_attrdef'::regclass::oid THEN (SELECT x.adrelid::regclass::text || ' default ' || x.adnum::text FROM pg_catalog.pg_attrdef x WHERE x.oid = objid) WHEN 'pg_rewrite'::regclass::oid THEN (SELECT x.ev_class::regclass::text || ' rule ' || x.rulename::text FROM pg_catalog.pg_rewrite x WHERE x.oid = objid) WHEN 'pg_trigger'::regclass::oid THEN (SELECT CASE WHEN x.tgisinternal THEN 'internal trigger' ELSE x.tgname::text END || ' on ' || x.tgrelid::regclass::text FROM pg_catalog.pg_trigger x WHERE x.oid = objid) WHEN 'pg_policy'::regclass::oid THEN (SELECT x.polname::text || ' on ' || x.polrelid::regclass::text FROM pg_catalog.pg_policy x WHERE x.oid = objid) ELSE CASE WHEN objid < 16384 THEN objid::text ELSE 'user object' END END AS objid,
  objsubid, refclassid::regclass::text AS refclassid, pg_catalog.pg_get_userbyid(refobjid) AS refobjid, deptype
FROM pg_catalog.pg_shdepend
WHERE dbid IN (SELECT oid FROM pg_catalog.pg_database WHERE datname = current_database()) AND objid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_type WHERE typnamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_proc WHERE pronamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_constraint WHERE connamespace IN ('pgonly'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_trigger WHERE tgrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) UNION ALL SELECT oid FROM pg_catalog.pg_policy WHERE polrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) UNION ALL SELECT 'pgonly'::regnamespace::oid)
) q
WHERE ((q.dbid)::text, q.classid, q.objid, (q.objsubid)::text, q.refclassid, q.refobjid, (q.deptype)::text) IN (
    ('true', 'pg_policy', 'parent_reader on pgonly.parent', '0', 'pg_authid', 'conf_reader', 'r'))
ORDER BY q.dbid, q.classid::text COLLATE "C", q.objid::text COLLATE "C", q.objsubid, q.refclassid::text COLLATE "C",
  q.refobjid::text COLLATE "C", q.deptype::text COLLATE "C"
----
dbid	classid	objid	objsubid	refclassid	refobjid	deptype


query
SELECT tgrelid::regclass::text AS tgrelid, tgparentid, tgname, tgfoid::regproc::text AS tgfoid, tgtype, tgenabled,
  tgisinternal, tgconstrrelid::regclass::text AS tgconstrrelid, tgconstrindid::regclass::text AS tgconstrindid,
  tgconstraint, tgdeferrable, tginitdeferred, tgnargs, array_to_string(tgattr::int2[], ' ') AS tgattr,
  encode(tgargs, 'hex') AS tgargs, pg_catalog.pg_get_expr(tgqual, tgrelid) AS tgqual, tgoldtable, tgnewtable
FROM pg_catalog.pg_trigger
WHERE tgrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) AND NOT tgisinternal
  AND (tgrelid::regclass::text, tgname) NOT IN (('pgonly.parent', 'parent_touch'))
ORDER BY tgrelid::regclass::text COLLATE "C", tgname::text COLLATE "C"
