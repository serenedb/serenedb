SELECT attrelid::regclass::text AS attrelid, attname, atttypid::regtype::text AS atttypid, attlen, attnum, atttypmod,
  attndims, attbyval, attalign, attstorage, attcompression, attnotnull, atthasdef, atthasmissing, attidentity,
  attgenerated, attisdropped, attislocal, attinhcount, attcollation, attstattarget,
  (SELECT string_agg(x::text, ',' ORDER BY x::text COLLATE "C") FROM unnest(attacl) x) AS attacl, attoptions,
  attfdwoptions
FROM pg_catalog.pg_attribute
WHERE attrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('pgonly'::regnamespace::oid)) AND attnum > 0
  AND (attrelid::regclass::text IN ('pgonly.cascade_child', 'pgonly.domain_tab', 'pgonly.identity_tab',
    'pgonly.identity_tab_id_seq', 'pgonly.json_tab')
  OR (attrelid::regclass::text, (attnum)::text) IN (('pgonly.cascade_child_pkey', '1'), ('pgonly.domain_tab_pkey', '1'),
    ('pgonly.identity_tab_code_key', '1'), ('pgonly.identity_tab_pkey', '1'), ('pgonly.json_tab_pkey', '1')))
ORDER BY attrelid::regclass::text COLLATE "C", attnum
