SELECT CASE WHEN udt_catalog::text = current_database() THEN 'db' ELSE udt_catalog::text END AS udt_catalog,
  udt_schema, udt_name, attribute_name, ordinal_position, attribute_default, is_nullable,
  CASE WHEN character_set_catalog::text = current_database() THEN 'db' ELSE character_set_catalog::text END AS character_set_catalog,
  character_set_schema, character_set_name,
  CASE WHEN collation_catalog::text = current_database() THEN 'db' ELSE collation_catalog::text END AS collation_catalog,
  collation_schema, collation_name, numeric_precision, numeric_precision_radix, numeric_scale, datetime_precision,
  interval_type, interval_precision,
  CASE WHEN attribute_udt_catalog::text = current_database() THEN 'db' ELSE attribute_udt_catalog::text END AS attribute_udt_catalog,
  attribute_udt_schema,
  CASE WHEN scope_catalog::text = current_database() THEN 'db' ELSE scope_catalog::text END AS scope_catalog,
  scope_schema, scope_name, maximum_cardinality, dtd_identifier, is_derived_reference_attribute
FROM information_schema.attributes
WHERE udt_schema IN ('app', 'public')
ORDER BY udt_schema::text COLLATE "C", udt_name::text COLLATE "C", attribute_name::text COLLATE "C"
