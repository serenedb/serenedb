SELECT CASE WHEN table_catalog::text = current_database() THEN 'db' ELSE table_catalog::text END AS table_catalog,
  table_schema, table_name, table_type, self_referencing_column_name, reference_generation,
  CASE WHEN user_defined_type_catalog::text = current_database() THEN 'db' ELSE user_defined_type_catalog::text END AS user_defined_type_catalog,
  user_defined_type_schema, user_defined_type_name, is_insertable_into, is_typed, commit_action
