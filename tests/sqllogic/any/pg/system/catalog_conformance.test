app.order_totals	_RETURN	CREATE RULE "_RETURN" AS ON SELECT TO app.order_totals DO INSTEAD SELECT o.customer_id, sum(o.amount) AS total, count_star() AS n FROM orders AS o GROUP BY o.customer_id;	CREATE RULE "_RETURN" AS ON SELECT TO app.order_totals DO INSTEAD SELECT o.customer_id, sum(o.amount) AS total, count_star() AS n FROM orders AS o GROUP BY o.customer_id;


