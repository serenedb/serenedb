query
SELECT * FROM (
SELECT
  CASE classoid WHEN 'pg_class'::regclass::oid THEN objoid::regclass::text WHEN 'pg_type'::regclass::oid THEN objoid::regtype::text WHEN 'pg_proc'::regclass::oid THEN objoid::regprocedure::text WHEN 'pg_namespace'::regclass::oid THEN objoid::regnamespace::text WHEN 'pg_constraint'::regclass::oid THEN (SELECT x.conname::text || ' on ' || CASE WHEN x.conrelid <> 0 THEN x.conrelid::regclass::text ELSE x.contypid::regtype::text END FROM pg_catalog.pg_constraint x WHERE x.oid = objoid) WHEN 'pg_attrdef'::regclass::oid THEN (SELECT x.adrelid::regclass::text || ' default ' || x.adnum::text FROM pg_catalog.pg_attrdef x WHERE x.oid = objoid) WHEN 'pg_rewrite'::regclass::oid THEN (SELECT x.ev_class::regclass::text || ' rule ' || x.rulename::text FROM pg_catalog.pg_rewrite x WHERE x.oid = objoid) WHEN 'pg_trigger'::regclass::oid THEN (SELECT CASE WHEN x.tgisinternal THEN 'internal trigger' ELSE x.tgname::text END || ' on ' || x.tgrelid::regclass::text FROM pg_catalog.pg_trigger x WHERE x.oid = objoid) ELSE CASE WHEN objoid < 16384 THEN objoid::text ELSE 'user object' END END AS objoid,
  classoid::regclass::text AS classoid, objsubid, description
FROM pg_catalog.pg_description
WHERE objoid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_type WHERE typnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_proc WHERE pronamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_constraint WHERE connamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_attrdef WHERE adrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)) UNION ALL SELECT oid FROM pg_catalog.pg_rewrite WHERE ev_class IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)) UNION ALL SELECT 'app'::regnamespace::oid)
) q
ORDER BY q.objoid::text COLLATE "C", q.classoid::text COLLATE "C", q.objsubid
----
objoid	classoid	objsubid	description
active_customers	pg_class	0	Only active customers
app.add_one(integer)	pg_proc	0	Adds one
app.mood	pg_type	0	Mood enum
app.ticket_seq	pg_class	0	Ticket numbers
customers	pg_class	0	Customer master
customers	pg_class	2	Login email
orders	pg_class	3	Order amount
orders_customer_idx	pg_class	0	Orders by customer


query
SELECT * FROM (
SELECT classid::regclass::text AS classid,
  CASE classid WHEN 'pg_class'::regclass::oid THEN objid::regclass::text WHEN 'pg_type'::regclass::oid THEN objid::regtype::text WHEN 'pg_proc'::regclass::oid THEN objid::regprocedure::text WHEN 'pg_namespace'::regclass::oid THEN objid::regnamespace::text WHEN 'pg_constraint'::regclass::oid THEN (SELECT x.conname::text || ' on ' || CASE WHEN x.conrelid <> 0 THEN x.conrelid::regclass::text ELSE x.contypid::regtype::text END FROM pg_catalog.pg_constraint x WHERE x.oid = objid) WHEN 'pg_attrdef'::regclass::oid THEN (SELECT x.adrelid::regclass::text || ' default ' || x.adnum::text FROM pg_catalog.pg_attrdef x WHERE x.oid = objid) WHEN 'pg_rewrite'::regclass::oid THEN (SELECT x.ev_class::regclass::text || ' rule ' || x.rulename::text FROM pg_catalog.pg_rewrite x WHERE x.oid = objid) WHEN 'pg_trigger'::regclass::oid THEN (SELECT CASE WHEN x.tgisinternal THEN 'internal trigger' ELSE x.tgname::text END || ' on ' || x.tgrelid::regclass::text FROM pg_catalog.pg_trigger x WHERE x.oid = objid) ELSE CASE WHEN objid < 16384 THEN objid::text ELSE 'user object' END END AS objid,
  objsubid, refclassid::regclass::text AS refclassid,
  CASE refclassid WHEN 'pg_class'::regclass::oid THEN refobjid::regclass::text WHEN 'pg_type'::regclass::oid THEN refobjid::regtype::text WHEN 'pg_proc'::regclass::oid THEN refobjid::regprocedure::text WHEN 'pg_namespace'::regclass::oid THEN refobjid::regnamespace::text WHEN 'pg_constraint'::regclass::oid THEN (SELECT x.conname::text || ' on ' || CASE WHEN x.conrelid <> 0 THEN x.conrelid::regclass::text ELSE x.contypid::regtype::text END FROM pg_catalog.pg_constraint x WHERE x.oid = refobjid) WHEN 'pg_attrdef'::regclass::oid THEN (SELECT x.adrelid::regclass::text || ' default ' || x.adnum::text FROM pg_catalog.pg_attrdef x WHERE x.oid = refobjid) WHEN 'pg_rewrite'::regclass::oid THEN (SELECT x.ev_class::regclass::text || ' rule ' || x.rulename::text FROM pg_catalog.pg_rewrite x WHERE x.oid = refobjid) WHEN 'pg_trigger'::regclass::oid THEN (SELECT CASE WHEN x.tgisinternal THEN 'internal trigger' ELSE x.tgname::text END || ' on ' || x.tgrelid::regclass::text FROM pg_catalog.pg_trigger x WHERE x.oid = refobjid) ELSE CASE WHEN refobjid < 16384 THEN refobjid::text ELSE 'user object' END END AS refobjid,
  refobjsubid, deptype
FROM pg_catalog.pg_depend
WHERE ((objid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_type WHERE typnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_proc WHERE pronamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_constraint WHERE connamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_attrdef WHERE adrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)) UNION ALL SELECT oid FROM pg_catalog.pg_rewrite WHERE ev_class IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)) UNION ALL SELECT 'app'::regnamespace::oid) OR refobjid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_type WHERE typnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_proc WHERE pronamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_constraint WHERE connamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid) UNION ALL SELECT oid FROM pg_catalog.pg_attrdef WHERE adrelid IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)) UNION ALL SELECT oid FROM pg_catalog.pg_rewrite WHERE ev_class IN (SELECT oid FROM pg_catalog.pg_class WHERE relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)) UNION ALL SELECT 'app'::regnamespace::oid)) AND NOT (classid = 'pg_class'::regclass::oid AND objid IN (SELECT reltoastrelid FROM pg_catalog.pg_class WHERE reltoastrelid <> 0)))
) q
WHERE (q.classid, q.objid, (q.objsubid)::text, q.refclassid, q.refobjid, (q.refobjsubid)::text, (q.deptype)::text) NOT IN (
    ('pg_attrdef', 'customers default 5', '0', 'pg_type', 'app.mood', '0', 'n'),
    ('pg_trigger', 'internal trigger on app.child_tab', '0', 'pg_constraint', 'child_tab_unique_id_fkey on app.child_tab', '0', 'i'),
    ('pg_trigger', 'internal trigger on app.unique_tab', '0', 'pg_constraint', 'child_tab_unique_id_fkey on app.child_tab', '0', 'i'),
    ('pg_trigger', 'internal trigger on customers', '0', 'pg_constraint', 'orders_customer_id_fkey on orders', '0', 'i'),
    ('pg_trigger', 'internal trigger on order_items', '0', 'pg_constraint', 'order_items_order_id_fkey on order_items', '0', 'i'),
    ('pg_trigger', 'internal trigger on orders', '0', 'pg_constraint', 'order_items_order_id_fkey on order_items', '0', 'i'),
    ('pg_trigger', 'internal trigger on orders', '0', 'pg_constraint', 'orders_customer_id_fkey on orders', '0', 'i'))
ORDER BY q.classid::text COLLATE "C", q.objid::text COLLATE "C", q.objsubid, q.refclassid::text COLLATE "C",
  q.refobjid::text COLLATE "C", q.refobjsubid, q.deptype::text COLLATE "C"
