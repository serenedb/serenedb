query
SELECT c.relname::text AS rel, a.attname::text AS col, pg_catalog.format_type(a.atttypid, a.atttypmod) AS coltype,
  a.attnotnull AS not_null
FROM pg_catalog.pg_attribute a
JOIN pg_catalog.pg_class c ON c.oid = a.attrelid
WHERE c.relnamespace = 'pg_catalog'::regnamespace AND c.relname IN ('sdb_progress', 'sdb_metrics', 'sdb_settings')
  AND a.attnum > 0 AND NOT a.attisdropped
ORDER BY c.relname::text COLLATE "C", a.attnum
----
rel	col	coltype	not_null
sdb_metrics	metric	text	f
sdb_metrics	value	bigint	f
