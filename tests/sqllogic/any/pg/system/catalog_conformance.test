query
SELECT q.schemaname, q.tablename, q.indexname, q.tablespace,
  replace(q.indexdef, ' USING secondary ', ' USING btree ') AS indexdef FROM (
SELECT schemaname, tablename, indexname, tablespace, indexdef FROM pg_indexes WHERE schemaname IN ('public', 'app')
) q
WHERE q.indexname NOT IN ('orders_amount_desc_idx')
ORDER BY q.indexname::text COLLATE "C"
----
schemaname	tablename	indexname	tablespace	indexdef
app	all_types	all_types_pkey	NULL	CREATE UNIQUE INDEX all_types_pkey ON app.all_types USING btree (c_int8)
app	all_types	all_types_varchar_idx	NULL	CREATE INDEX all_types_varchar_idx ON app.all_types USING btree (c_varchar)
app	child_tab	child_tab_pkey	NULL	CREATE UNIQUE INDEX child_tab_pkey ON app.child_tab USING btree (id)
public	customers	customers_email_key	NULL	CREATE UNIQUE INDEX customers_email_key ON public.customers USING btree (email)
public	customers	customers_name_email_idx	NULL	CREATE UNIQUE INDEX customers_name_email_idx ON public.customers USING btree (name, email)
public	customers	customers_pkey	NULL	CREATE UNIQUE INDEX customers_pkey ON public.customers USING btree (id)
app	json_tab	json_tab_pkey	NULL	CREATE UNIQUE INDEX json_tab_pkey ON app.json_tab USING btree (id)
public	order_items	order_items_pkey	NULL	CREATE UNIQUE INDEX order_items_pkey ON public.order_items USING btree (order_id, line)
public	order_items	order_items_sku_idx	NULL	CREATE INDEX order_items_sku_idx ON public.order_items USING btree (sku)
