  CASE WHEN sequence_catalog::text = current_database() THEN 'db' ELSE sequence_catalog::text END AS sequence_catalog,
  sequence_schema, sequence_name, data_type, numeric_precision, numeric_precision_radix, numeric_scale, start_value,
  minimum_value, maximum_value, increment, cycle_option
FROM information_schema.sequences
WHERE sequence_schema IN ('app', 'public')
  AND (sequence_schema, sequence_name) IN (('public', 'customers_id_seq'))
ORDER BY sequence_schema::text COLLATE "C", sequence_name::text COLLATE "C"
----
sequence_catalog	sequence_schema	sequence_name	data_type	numeric_precision	numeric_precision_radix	numeric_scale	start_value	minimum_value	maximum_value	increment	cycle_option
db	public	customers_id_seq	bigint	64	2	0	1	1	2147483647	1	NO


