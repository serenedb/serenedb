statement ok
DROP ROLE IF EXISTS conf_reader


statement ok
CREATE ROLE conf_reader


statement ok
CREATE SCHEMA app


statement ok
CREATE TYPE app.mood AS ENUM ('sad', 'ok', 'happy')


statement ok
CREATE TYPE app.address AS (street text, city varchar(40), zip int4)


statement ok
CREATE SEQUENCE app.ticket_seq START 100 INCREMENT 5


statement ok
CREATE SEQUENCE plain_seq


statement ok
CREATE TABLE customers (
  id serial PRIMARY KEY,
  email varchar(50) NOT NULL UNIQUE,
  name text NOT NULL,
  active bool DEFAULT true,
  mood app.mood DEFAULT 'ok',
  home app.address,
  created timestamptz DEFAULT now()
)


statement ok
CREATE TABLE orders (
  id bigserial PRIMARY KEY,
  customer_id int4 NOT NULL REFERENCES customers (id),
  amount numeric(10,2) NOT NULL DEFAULT 0 CHECK (amount >= 0),
  status varchar(20) DEFAULT 'new',
  note text,
  ordered_on date DEFAULT current_date,
  ticket int8 DEFAULT nextval('app.ticket_seq'),
  CONSTRAINT orders_status_check CHECK (status IN ('new', 'paid', 'shipped'))
)


statement ok
CREATE TABLE order_items (
  order_id int8 REFERENCES orders (id),
  line int4,
  sku varchar(30) NOT NULL,
  qty int4 NOT NULL CHECK (qty > 0),
  price numeric(12,4),
  PRIMARY KEY (order_id, line)
)


statement ok
CREATE TABLE app.all_types (
  c_int2 int2,
  c_int4 int4,
  c_int8 int8 PRIMARY KEY,
  c_numeric numeric(10,2),
  c_numeric_plain numeric,
  c_varchar varchar(50),
  c_char char(3),
  c_text text NOT NULL DEFAULT 'x',
  c_bool bool,
  c_date date,
  c_time time,
  c_ts timestamp,
  c_tstz timestamptz,
  c_interval interval,
  c_float4 float4,
  c_float8 float8,
  c_uuid uuid,
  c_json json,
  c_bytea bytea,
  c_int_arr int4[],
  c_text_arr text[],
  c_mood app.mood
)


statement ok
CREATE TABLE app.json_tab (id int4 PRIMARY KEY, doc json)


statement ok
CREATE TABLE app.unique_tab (
  id int8 PRIMARY KEY,
  code varchar(10) UNIQUE,
  qty int4 CHECK (qty BETWEEN 1 AND 100)
)


statement ok
CREATE TABLE app.child_tab (id int4 PRIMARY KEY, unique_id int8 REFERENCES app.unique_tab (id))


statement ok
CREATE UNIQUE INDEX customers_name_email_idx ON customers (name, email)


statement ok
CREATE INDEX orders_customer_idx ON orders (customer_id)


statement ok
CREATE INDEX orders_amount_desc_idx ON orders (amount DESC)


statement ok
CREATE INDEX order_items_sku_idx ON order_items (sku)


statement ok
CREATE INDEX all_types_varchar_idx ON app.all_types (c_varchar)


statement ok
CREATE VIEW active_customers AS SELECT id, email, name FROM customers WHERE active


statement ok
CREATE VIEW app.order_totals AS SELECT o.customer_id, sum(o.amount) AS total, count(*) AS n FROM orders o GROUP BY o.customer_id


statement ok
CREATE FUNCTION app.add_one(i int4) RETURNS int4 LANGUAGE sql AS $$ SELECT i + 1 $$


statement ok
COMMENT ON TABLE customers IS 'Customer master'


statement ok
COMMENT ON COLUMN customers.email IS 'Login email'


statement ok
COMMENT ON COLUMN orders.amount IS 'Order amount'


statement ok
COMMENT ON VIEW active_customers IS 'Only active customers'


statement ok
COMMENT ON TYPE app.mood IS 'Mood enum'


statement ok
COMMENT ON INDEX orders_customer_idx IS 'Orders by customer'


statement ok
COMMENT ON SEQUENCE app.ticket_seq IS 'Ticket numbers'


statement ok
COMMENT ON FUNCTION app.add_one IS 'Adds one'


statement ok
GRANT USAGE ON SCHEMA app TO conf_reader


statement ok
GRANT SELECT ON customers TO conf_reader


statement ok
GRANT SELECT, INSERT ON orders TO conf_reader


statement ok
GRANT SELECT ON app.order_totals TO conf_reader


query
SELECT n.nspname::text AS nsp, c.relname::text AS rel, a.attname::text AS col,
  pg_catalog.format_type(a.atttypid, a.atttypmod) AS coltype, a.attnotnull AS not_null
FROM pg_catalog.pg_attribute a
JOIN pg_catalog.pg_class c ON c.oid = a.attrelid
JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname IN ('pg_catalog', 'information_schema') AND c.relkind IN ('r', 'v', 'm', 'p', 'f')
  AND a.attnum > 0 AND NOT a.attisdropped
  AND c.relname NOT IN ('sdb_progress', 'sdb_metrics', 'sdb_settings')
  AND (n.nspname::text, c.relname::text) NOT IN (('pg_catalog', 'pg_stat_progress_create_table_as'))
  AND (n.nspname::text, c.relname::text, a.attname::text) NOT IN (
    ('pg_catalog', 'pg_prepared_statements', 'parameter_types'),
    ('pg_catalog', 'pg_prepared_statements', 'result_types'),
    ('pg_catalog', 'pg_replication_origin_status', 'local_lsn'),
    ('pg_catalog', 'pg_replication_origin_status', 'remote_lsn'),
    ('pg_catalog', 'pg_replication_slots', 'confirmed_flush_lsn'),
    ('pg_catalog', 'pg_replication_slots', 'restart_lsn'), ('pg_catalog', 'pg_replication_slots', 'two_phase_at'),
    ('pg_catalog', 'pg_stat_activity', 'backend_xid'), ('pg_catalog', 'pg_stat_activity', 'backend_xmin'),
    ('pg_catalog', 'pg_stat_activity', 'client_addr'), ('pg_catalog', 'pg_stat_activity', 'datname'),
    ('pg_catalog', 'pg_stat_activity', 'usename'), ('pg_catalog', 'pg_stat_io', 'extend_bytes'),
    ('pg_catalog', 'pg_stat_io', 'read_bytes'), ('pg_catalog', 'pg_stat_io', 'write_bytes'),
    ('pg_catalog', 'pg_stat_progress_analyze', 'datname'), ('pg_catalog', 'pg_stat_progress_cluster', 'datname'),
    ('pg_catalog', 'pg_stat_progress_copy', 'datname'), ('pg_catalog', 'pg_stat_progress_create_index', 'datname'),
    ('pg_catalog', 'pg_stat_progress_vacuum', 'datname'), ('pg_catalog', 'pg_stat_replication', 'backend_xmin'),
    ('pg_catalog', 'pg_stat_replication', 'client_addr'), ('pg_catalog', 'pg_stat_replication', 'flush_lsn'),
    ('pg_catalog', 'pg_stat_replication', 'replay_lsn'), ('pg_catalog', 'pg_stat_replication', 'sent_lsn'),
    ('pg_catalog', 'pg_stat_replication', 'write_lsn'), ('pg_catalog', 'pg_stat_ssl', 'client_serial'),
    ('pg_catalog', 'pg_stat_subscription', 'latest_end_lsn'), ('pg_catalog', 'pg_stat_subscription', 'received_lsn'),
    ('pg_catalog', 'pg_stat_wal', 'wal_bytes'), ('pg_catalog', 'pg_stat_wal_receiver', 'flushed_lsn'),
    ('pg_catalog', 'pg_stat_wal_receiver', 'latest_end_lsn'),
    ('pg_catalog', 'pg_stat_wal_receiver', 'receive_start_lsn'), ('pg_catalog', 'pg_stat_wal_receiver', 'written_lsn'))
ORDER BY n.nspname::text COLLATE "C", c.relname::text COLLATE "C", a.attnum
