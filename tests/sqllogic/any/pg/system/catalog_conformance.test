query
SELECT conname, connamespace::regnamespace::text AS connamespace, contype, condeferrable, condeferred, conenforced,
  convalidated, conrelid::regclass::text AS conrelid, contypid::regtype::text AS contypid,
  conindid::regclass::text AS conindid, conparentid = 0 AS conparentid, confrelid::regclass::text AS confrelid,
  translate((confupdtype)::text, ' ', '_') AS confupdtype, translate((confdeltype)::text, ' ', '_') AS confdeltype,
  translate((confmatchtype)::text, ' ', '_') AS confmatchtype, conislocal, coninhcount, connoinherit, conperiod,
  conkey, confkey, array_to_string(conpfeqop::oid[], ' ') AS conpfeqop,
  array_to_string(conppeqop::oid[], ' ') AS conppeqop, array_to_string(conffeqop::oid[], ' ') AS conffeqop,
  confdelsetcols, array_to_string(conexclop::oid[], ' ') AS conexclop,
  pg_catalog.pg_get_expr(conbin, conrelid) AS conbin
FROM pg_catalog.pg_constraint
WHERE connamespace IN ('pgonly'::regnamespace::oid)
  AND (conname, conrelid::regclass::text, contypid::regtype::text) NOT IN (
    ('cascade_child_id_not_null', 'pgonly.cascade_child', '-'),
    ('cascade_child_parent_id_fkey', 'pgonly.cascade_child', '-'),
    ('cascade_child_pkey', 'pgonly.cascade_child', '-'), ('domain_tab_id_not_null', 'pgonly.domain_tab', '-'),
    ('domain_tab_pkey', 'pgonly.domain_tab', '-'), ('identity_tab_code_key', 'pgonly.identity_tab', '-'),
    ('identity_tab_id_not_null', 'pgonly.identity_tab', '-'), ('identity_tab_pkey', 'pgonly.identity_tab', '-'),
    ('identity_tab_qty_check', 'pgonly.identity_tab', '-'), ('json_tab_id_not_null', 'pgonly.json_tab', '-'),
    ('json_tab_pkey', 'pgonly.json_tab', '-'), ('positive_int_check', '-', 'pgonly.positive_int'))
ORDER BY conname::text COLLATE "C", conrelid::regclass::text COLLATE "C", contypid::regtype::text COLLATE "C"
----
conname	connamespace	contype	condeferrable	condeferred	conenforced	convalidated	conrelid	contypid	conindid	conparentid	confrelid	confupdtype	confdeltype	confmatchtype	conislocal	coninhcount	connoinherit	conperiod	conkey	confkey	conpfeqop	conppeqop	conffeqop	confdelsetcols	conexclop	conbin
parent_id_not_null	pgonly	n	f	f	t	t	pgonly.parent	-	-	t	-	_	_	_	t	0	f	f	{1}	NULL	NULL	NULL	NULL	NULL	NULL	NULL
parent_pkey	pgonly	p	f	f	t	t	pgonly.parent	-	pgonly.parent_pkey	t	-	_	_	_	t	0	t	f	{1}	NULL	NULL	NULL	NULL	NULL	NULL	NULL


