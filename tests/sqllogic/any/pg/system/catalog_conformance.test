query
SELECT c.oid::regclass::text AS index_name,
  (SELECT a.amname::text FROM pg_catalog.pg_am a WHERE a.oid = c.relam) AS amname
FROM pg_catalog.pg_class c
WHERE c.relkind IN ('i', 'I') AND c.relnamespace IN ('app'::regnamespace::oid, 'public'::regnamespace::oid)
  AND c.oid::regclass::text IN ('app.all_types_pkey', 'app.all_types_varchar_idx', 'app.child_tab_pkey',
    'app.json_tab_pkey', 'app.unique_tab_code_key', 'app.unique_tab_pkey', 'customers_email_key',
