CREATE FUNCTION cmf_add(a int, b text) RETURNS int AS $$ SELECT a $$ LANGUAGE sql


query
SELECT proname, oidvectortypes(proargtypes) AS argtypes,
  array_to_string(proallargtypes, ',') AS allargtypes,
  array_to_string(proargmodes, ',') AS argmodes,
  array_to_string(proargnames, ',') AS argnames
FROM pg_proc WHERE proname IN ('cmf_pairs', 'cmf_add') ORDER BY proname
----
proname	argtypes	allargtypes	argmodes	argnames
cmf_add	integer, text	NULL	NULL	a,b
cmf_pairs	integer	23,23,25	i,t,t	i,k,v


query
SELECT proname, proretset, prorows FROM pg_proc WHERE proname IN ('cmf_pairs', 'cmf_add') ORDER BY proname
----
proname	proretset	prorows
cmf_add	f	0
cmf_pairs	t	1000


statement ok
CREATE TABLE cmf_runes (id serial PRIMARY KEY, haste int DEFAULT NULL, regen int DEFAULT NULL::int, arcane text DEFAULT 'x', v int)


statement ok
CREATE INDEX cmf_runes_v ON cmf_runes (v)


query
SELECT a.attname, a.atthasdef,
  (SELECT count(*) FROM pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum) AS defaults,
  c.column_default IS NULL AS no_column_default
FROM pg_attribute a
JOIN information_schema.columns c ON c.table_name = 'cmf_runes' AND c.column_name = a.attname
WHERE a.attrelid = 'cmf_runes'::regclass AND a.attname IN ('haste', 'regen', 'arcane')
ORDER BY a.attnum
----
attname	atthasdef	defaults	no_column_default
haste	f	0	t
regen	f	0	t
arcane	t	1	f


query
SELECT pg_indexam_has_property(0, 'can_order') AS no_am,
  pg_indexam_has_property(c.relam, 'no_such_property') AS unknown_property,
  pg_indexam_has_property(c.relam, 'can_multi_col') AS can_multi_col,
  pg_indexam_has_property(c.relam, 'CAN_UNIQUE') AS can_unique,
  pg_index_has_property('cmf_runes'::regclass, 'clusterable') AS not_an_index,
  pg_index_has_property(c.oid, 'index_scan') AS index_scan,
  pg_index_column_has_property(c.oid, 2, 'orderable') AS past_last_column
FROM pg_class c WHERE c.relname = 'cmf_runes_v'
----
no_am	unknown_property	can_multi_col	can_unique	not_an_index	index_scan	past_last_column
NULL	NULL	t	t	NULL	t	NULL


