query
SELECT DISTINCT proname, provolatile FROM pg_proc
WHERE proname IN ('set_config', 'to_regclass', 'pg_get_viewdef', 'format_type', 'current_user', 'num_nulls',
  'width_bucket', 'pg_relation_size', 'pg_cancel_backend', 'pg_stat_get_numscans', 'pg_stat_get_xact_numscans',
  'pg_get_userbyid', 'has_table_privilege', '_pg_char_max_length', '_pg_index_position')
ORDER BY 1, 2
----
proname	provolatile
_pg_char_max_length	i
_pg_index_position	s
current_user	s
format_type	s
has_table_privilege	s
num_nulls	i
pg_cancel_backend	v
pg_get_userbyid	s
pg_get_viewdef	s
pg_relation_size	v
pg_stat_get_numscans	s
pg_stat_get_xact_numscans	v
set_config	v
to_regclass	s
width_bucket	i


statement ok
