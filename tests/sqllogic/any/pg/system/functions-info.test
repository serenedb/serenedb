# PG returns NULL for an OID that doesn't exist in the relevant catalog
# (pg_proc / pg_type / pg_class). The pg_*_is_visible predicates look the
# object up first and propagate NULL when nothing matches.
query
SELECT pg_function_is_visible(0);
----
pg_function_is_visible
NULL


