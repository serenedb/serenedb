# unnamed trailing function parameters use PG-style column1, column2 naming

query
SELECT format_type('varchar'::regtype, 4) AS varchar4, format_type('varchar'::regtype, 3) AS varchar3,
       format_type('varchar'::regtype, 0) AS varchar0, format_type('numeric'::regtype, 3) AS numeric3,
       format_type('bpchar'::regtype, 5) AS bpchar5, format_type('numeric'::regtype, 4) AS numeric4;
----
varchar4	varchar3	varchar0	numeric3	bpchar5	numeric4
character varying	character varying	character varying	numeric	character(1)	numeric(0,0)


statement ok
CREATE TABLE fi_serial_owner (id serial, v text);


statement ok
COMMENT ON TABLE fi_serial_owner IS 'owner comment';


query
SELECT pg_get_serial_sequence('FI_SERIAL_OWNER', 'id') AS folded,
       pg_get_serial_sequence('public.Fi_Serial_Owner', 'id') AS qualified,
       col_description('fi_serial_owner'::regclass, 0) AS table_comment;
----
folded	qualified	table_comment
public.fi_serial_owner_id_seq	public.fi_serial_owner_id_seq	owner comment


statement ok
DROP TABLE fi_serial_owner;


query
SELECT DISTINCT proname, provolatile
FROM pg_proc
WHERE proname IN ('current_user', 'format_type', 'now', 'pg_backend_pid', 'pg_cancel_backend', 'pg_get_viewdef', 'pg_relation_size', 'random', 'upper')
ORDER BY 1
----
proname	provolatile
current_user	s
format_type	s
now	s
pg_backend_pid	s
pg_cancel_backend	v
pg_get_viewdef	s
pg_relation_size	v
random	v
upper	i
