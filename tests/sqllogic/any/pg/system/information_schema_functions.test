statement ok
CREATE TABLE isf_collated (a text COLLATE "default", b text COLLATE "POSIX");


query
SELECT attname, attcollation FROM pg_attribute WHERE attrelid = 'isf_collated'::regclass AND attnum > 0 ORDER BY attnum;
----
attname	attcollation
a	100
b	951


