statement ok
DROP SCHEMA IF EXISTS ident_s CASCADE;


statement ok
DROP ROLE IF EXISTS ident_reader;


statement ok
CREATE ROLE ident_reader;


statement ok
CREATE SCHEMA ident_s;


statement ok
CREATE TABLE ident_s.t (id int PRIMARY KEY, v text DEFAULT 'x', CONSTRAINT v_check CHECK (v <> ''));


statement ok
CREATE INDEX t_v_idx ON ident_s.t (v);


statement ok
CREATE VIEW ident_s.w AS SELECT id FROM ident_s.t;


statement ok
CREATE SEQUENCE ident_s.seq;


statement ok
CREATE FUNCTION ident_s.f(a int) RETURNS int LANGUAGE sql AS 'SELECT a';


statement ok
CREATE TYPE ident_s.mood AS ENUM ('ok');


statement ok
CREATE TABLE ident_s."Mixed" ("Col" int);


statement ok
CREATE TYPE ident_s.pair AS (a int, b text);


statement ok
GRANT SELECT ON ident_s.t TO ident_reader;


statement ok
GRANT UPDATE (v) ON ident_s.t TO ident_reader;


query
SELECT pg_describe_object('pg_class'::regclass, 'pg_class'::regclass, 0) AS a, pg_describe_object('pg_class'::regclass, 'pg_class'::regclass, 2) AS b, pg_describe_object('pg_namespace'::regclass, 'pg_catalog'::regnamespace, 0) AS c, pg_describe_object('pg_type'::regclass, 'int4'::regtype, 0) AS d, pg_describe_object('pg_proc'::regclass, 'now'::regproc, 0) AS e;
----
a	b	c	d	e
table pg_class	column relname of table pg_class	schema pg_catalog	type integer	function now()


