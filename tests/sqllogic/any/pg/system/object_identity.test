query
SELECT (pg_identify_object('pg_database'::regclass, oid, 0)).type AS type,
       (pg_identify_object('pg_database'::regclass, oid, 0)).schema IS NULL AS no_schema,
       (pg_identify_object('pg_database'::regclass, oid, 0)).identity = quote_ident(datname) AS identity,
       pg_describe_object('pg_database'::regclass, oid, 0) = 'database ' || datname AS description
FROM pg_database WHERE datname = current_database();
----
type	no_schema	identity	description
database	t	t	t


query
SELECT (pg_identify_object('pg_collation'::regclass, oid, 0)).*, pg_describe_object('pg_collation'::regclass, oid, 0) AS description
FROM pg_collation WHERE collname IN ('C', 'default') ORDER BY collname;
----
type	schema	name	identity	description
collation	pg_catalog	"C"	pg_catalog."C"	collation "C"
collation	pg_catalog	"default"	pg_catalog."default"	collation "default"


