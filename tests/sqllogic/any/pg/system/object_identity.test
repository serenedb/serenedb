query
SELECT t, (pg_identify_object('pg_type'::regclass, t::regtype, 0)).*
FROM (VALUES (1, 'text[]'), (2, '"char"'), (3, 'numeric'), (4, 'integer[]'), (5, 'ident_s.mood[]')) v(i, t) ORDER BY i;
----
t	type	schema	name	identity
text[]	type	pg_catalog	_text	pg_catalog.text[]
"char"	type	pg_catalog	"char"	pg_catalog."char"
numeric	type	pg_catalog	"numeric"	numeric
integer[]	type	pg_catalog	_int4	integer[]
ident_s.mood[]	type	ident_s	_mood	ident_s.mood[]


