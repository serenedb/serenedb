query
SELECT pg_describe_object('pg_proc'::regclass, 'ident_s.f(int)'::regprocedure, 0) AS f, pg_describe_object('pg_type'::regclass, 'ident_s.mood'::regtype, 0) AS mood, pg_describe_object('pg_namespace'::regclass, 'ident_s'::regnamespace, 0) AS s, pg_describe_object('pg_constraint'::regclass, (SELECT oid FROM pg_constraint WHERE conname = 'v_check'), 0) AS chk, pg_describe_object('pg_attrdef'::regclass, (SELECT oid FROM pg_attrdef WHERE adrelid = 'ident_s.t'::regclass), 0) AS def, pg_describe_object('pg_authid'::regclass, 'ident_reader'::regrole, 0) AS role;
