query
SELECT c.relname AS sequence, a.attname AS column_name, d.refobjsubid, d.deptype
FROM pg_depend d
JOIN pg_class c ON c.oid = d.objid
JOIN pg_attribute a ON a.attrelid = d.refobjid AND a.attnum = d.refobjsubid
WHERE d.classid = 'pg_class'::regclass AND d.refclassid = 'pg_class'::regclass AND d.deptype = 'a' AND c.relkind = 'S'
  AND d.refobjid IN ('gss_t'::regclass, '"Gss Lookup"'::regclass, 'gss_dump'::regclass, 'gss_ren2'::regclass)
ORDER BY c.relname::text COLLATE "C"
----
sequence	column_name	refobjsubid	deptype
Gss Lookup_added_seq	added	3	a
Gss Lookup_id_seq	id	1	a
gss_dump_id_seq	id	1	a
gss_ren_id_seq	ident	2	a
gss_t_id_seq	id	1	a


query
SELECT attr.attname, nsp.nspname, seq.relname
FROM pg_class seq, pg_attribute attr, pg_depend dep, pg_constraint cons, pg_namespace nsp
WHERE seq.oid = dep.objid AND seq.relkind = 'S' AND attr.attrelid = dep.refobjid AND attr.attnum = dep.refobjsubid
  AND attr.attrelid = cons.conrelid AND attr.attnum = cons.conkey[1] AND seq.relnamespace = nsp.oid
  AND cons.contype = 'p' AND dep.classid = 'pg_class'::regclass AND dep.refobjid = '"gss_t"'::regclass
----
attname	nspname	relname
id	public	gss_t_id_seq


