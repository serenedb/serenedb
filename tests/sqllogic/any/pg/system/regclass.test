SET search_path = regclass_second, regclass_first


# Postgres resolves a name schema by schema, and every kind of relation --
# composite types and key indexes included -- shares one namespace per schema.
query
SELECT 'pair'::regclass = 'regclass_second.pair'::regclass AS type_first,
       pg_table_is_visible('regclass_first.pair'::regclass) AS table_visible
----
type_first	table_visible
t	f


query
SELECT 'parent_pkey'::regclass = 'regclass_second.parent_pkey'::regclass AS second_key,
       'regclass_first.parent_pkey'::regclass::text AS first_key,
       pg_table_is_visible('regclass_first.parent_pkey'::regclass) AS first_visible
----
second_key	first_key	first_visible
t	regclass_first.parent_pkey	f


query
