# regclass returns OID in binary protocol and our test runner can't
# resolve OIDs back to table names, so we only run with simple protocol

skipif pg-wire-extended
statement ok
CREATE TABLE regclass_test_table (id int, name text);


skipif pg-wire-extended
query
SELECT pg_typeof('regclass_test_table'::regclass);
----
pg_typeof
regclass


skipif pg-wire-extended
query
SELECT 'regclass_test_table'::regclass;
----
regclass
regclass_test_table


skipif pg-wire-extended
statement error
SELECT 'nonexistent_table'::regclass;


skipif pg-wire-extended
query
SELECT 'public.regclass_test_table'::regclass;
----
regclass
regclass_test_table


skipif pg-wire-extended
query
SELECT 'pg_type'::regclass;
----
regclass
pg_type


skipif pg-wire-extended
query
SELECT 'pg_catalog.pg_type'::regclass;
----
regclass
pg_type


skipif pg-wire-extended
query
SELECT 'pg_class'::regclass;
----
regclass
pg_class


skipif pg-wire-extended
query
SELECT 'regclass_test_table'::regclass <> 0::bigint;
----
?column?
t


skipif pg-wire-extended
statement ok
DROP TABLE regclass_test_table;


statement ok
CREATE TABLE public.pg_class (a int)


query
SELECT 'pg_class'::regclass::oid = 1259 AS cast_catalog, to_regclass('pg_class')::oid = 1259 AS to_reg_catalog, 'public.pg_class'::regclass::oid <> 1259 AS qualified_user
----
cast_catalog	to_reg_catalog	qualified_user
t	t	t


statement ok
SET search_path = public, pg_catalog


query
SELECT 'pg_class'::regclass::oid <> 1259 AS cast_user, to_regclass('pg_class')::oid <> 1259 AS to_reg_user
----
cast_user	to_reg_user
t	t


statement ok
RESET search_path


statement ok
DROP TABLE public.pg_class
