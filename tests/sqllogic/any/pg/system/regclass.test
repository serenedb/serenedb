query
SELECT c.relname,
       c.oid::regclass::text AS qualified,
       pg_table_is_visible(c.oid) AS visible
FROM pg_class c
WHERE c.relnamespace = 'public'::regnamespace
  AND c.relname IN ('regclass_temp_table', 'regclass_temp_seq', 'regclass_temp_view')
ORDER BY c.relname;
----
relname	qualified	visible
regclass_temp_seq	public.regclass_temp_seq	f
regclass_temp_table	public.regclass_temp_table	f
regclass_temp_view	public.regclass_temp_view	f


query
