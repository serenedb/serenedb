# regclass returns OID in binary protocol and our test runner can't
# resolve OIDs back to table names, so we only run with simple protocol

skipif pg-wire-extended
statement ok
CREATE TABLE regclass_test_table (id int, name text);


skipif pg-wire-extended
query
SELECT pg_typeof('regclass_test_table'::regclass);
----
pg_typeof
regclass


skipif pg-wire-extended
query
SELECT 'regclass_test_table'::regclass;
----
regclass
regclass_test_table


skipif pg-wire-extended
statement error
SELECT 'nonexistent_table'::regclass;


skipif pg-wire-extended
query
SELECT 'public.regclass_test_table'::regclass;
----
regclass
regclass_test_table


skipif pg-wire-extended
query
SELECT 'pg_type'::regclass;
----
regclass
pg_type


skipif pg-wire-extended
query
SELECT 'pg_catalog.pg_type'::regclass;
----
regclass
pg_type


skipif pg-wire-extended
query
SELECT 'pg_class'::regclass;
----
regclass
pg_class


skipif pg-wire-extended
query
SELECT 'regclass_test_table'::regclass <> 0::bigint;
----
?column?
t


skipif pg-wire-extended
statement ok
DROP TABLE regclass_test_table;


statement ok
CREATE TABLE public.pg_class (a int)


query
SELECT 'pg_class'::regclass::oid = 1259 AS cast_catalog, to_regclass('pg_class')::oid = 1259 AS to_reg_catalog, 'public.pg_class'::regclass::oid <> 1259 AS qualified_user
----
cast_catalog	to_reg_catalog	qualified_user
t	t	t


statement ok
SET search_path = public, pg_catalog


query
SELECT 'pg_class'::regclass::oid <> 1259 AS cast_user, to_regclass('pg_class')::oid <> 1259 AS to_reg_user
----
cast_user	to_reg_user
t	t


statement ok
RESET search_path


statement ok
DROP TABLE public.pg_class


statement ok
DROP SCHEMA IF EXISTS regclass_first CASCADE


statement ok
DROP SCHEMA IF EXISTS regclass_second CASCADE


statement ok
CREATE SCHEMA regclass_first


statement ok
CREATE SCHEMA regclass_second


statement ok
CREATE TABLE regclass_first.pair (a int)


statement ok
CREATE TYPE regclass_second.pair AS (a int, b int)


statement ok
CREATE TABLE regclass_first.parent (id int PRIMARY KEY)


statement ok
CREATE TABLE regclass_second.parent (id int PRIMARY KEY)


statement ok
CREATE SEQUENCE regclass_first.shared_name


statement ok
CREATE TABLE regclass_second.indexed (x int)


statement ok
CREATE INDEX shared_name ON regclass_second.indexed (x)


statement ok
CREATE TEMP TABLE regclass_temp (a int)


statement ok
SET search_path = regclass_second, regclass_first


# Postgres resolves a name schema by schema, and every kind of relation --
# composite types and key indexes included -- shares one namespace per schema.
query
SELECT 'pair'::regclass = 'regclass_second.pair'::regclass AS type_first,
       pg_table_is_visible('regclass_first.pair'::regclass) AS table_visible
----
type_first	table_visible
t	f


query
SELECT 'parent_pkey'::regclass = 'regclass_second.parent_pkey'::regclass AS second_key,
       'regclass_first.parent_pkey'::regclass::text AS first_key,
       pg_table_is_visible('regclass_first.parent_pkey'::regclass) AS first_visible
----
second_key	first_key	first_visible
t	regclass_first.parent_pkey	f


query
SELECT 'shared_name'::regclass = 'regclass_second.shared_name'::regclass AS index_first,
       pg_table_is_visible('regclass_first.shared_name'::regclass) AS sequence_visible
----
index_first	sequence_visible
t	f


query
SELECT to_regclass('regclass_temp') IS NOT NULL AS temp_found,
       to_regclass('duckdb_tables') IS NULL AS duckdb_view_hidden
----
temp_found	duckdb_view_hidden
t	t


statement ok
RESET search_path


statement ok
DROP SCHEMA regclass_first CASCADE


statement ok
DROP SCHEMA regclass_second CASCADE


statement ok
