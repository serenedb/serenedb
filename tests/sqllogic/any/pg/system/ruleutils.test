query
SELECT pg_get_viewdef('pg_catalog.pg_tables'::regclass) LIKE '%pg_class%' AS pg_tables,
       pg_get_viewdef('information_schema.tables'::regclass) LIKE '%pg_class%' AS info_tables,
       pg_get_viewdef('pg_tables') LIKE '%relkind%' AS by_name,
       pg_get_ruledef((SELECT oid FROM pg_rewrite WHERE ev_class = 'pg_catalog.pg_tables'::regclass))
         LIKE 'CREATE RULE "\_RETURN" AS%pg_tables%' AS ruledef;
----
pg_tables	info_tables	by_name	ruledef
t	t	t	t


