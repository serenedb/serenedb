statement ok
CREATE SCHEMA ru;


statement ok
CREATE TABLE ru.parent (id integer PRIMARY KEY, code text UNIQUE);


statement ok
CREATE TABLE ru.child (
  a integer NOT NULL,
  b integer,
  c text,
  CONSTRAINT child_pk PRIMARY KEY (a, b),
  CONSTRAINT child_uq UNIQUE (c),
  CONSTRAINT child_fk FOREIGN KEY (b) REFERENCES ru.parent (id)
);


statement ok
CREATE TABLE ru."Weird Tab" (id integer PRIMARY KEY, "Odd Col" integer UNIQUE);


statement ok
CREATE TABLE ru.weird_ref (x integer REFERENCES ru."Weird Tab" (id));


statement ok
CREATE INDEX odd_idx ON ru."Weird Tab" ("Odd Col", id);


query
SELECT conname, pg_get_constraintdef(oid) AS def, pg_get_constraintdef(oid, true) AS pretty
FROM pg_constraint WHERE connamespace = 'ru'::regnamespace ORDER BY conname;
----
conname	def	pretty
Weird Tab_Odd Col_key	UNIQUE ("Odd Col")	UNIQUE ("Odd Col")
Weird Tab_id_not_null	NOT NULL id	NOT NULL id
Weird Tab_pkey	PRIMARY KEY (id)	PRIMARY KEY (id)
child_a_not_null	NOT NULL a	NOT NULL a
child_b_not_null	NOT NULL b	NOT NULL b
child_fk	FOREIGN KEY (b) REFERENCES ru.parent(id)	FOREIGN KEY (b) REFERENCES ru.parent(id)
child_pk	PRIMARY KEY (a, b)	PRIMARY KEY (a, b)
child_uq	UNIQUE (c)	UNIQUE (c)
parent_code_key	UNIQUE (code)	UNIQUE (code)
parent_id_not_null	NOT NULL id	NOT NULL id
parent_pkey	PRIMARY KEY (id)	PRIMARY KEY (id)
weird_ref_x_fkey	FOREIGN KEY (x) REFERENCES ru."Weird Tab"(id)	FOREIGN KEY (x) REFERENCES ru."Weird Tab"(id)


