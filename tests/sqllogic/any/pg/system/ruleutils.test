query
SELECT c.relname, i.indexrelid::regclass::text AS idx
FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid
WHERE i.indrelid = 'ru.child'::regclass ORDER BY c.relname;
----
relname	idx
child_pk	ru.child_pk
child_uq	ru.child_uq


query
SELECT pg_get_indexdef('ru.child_pk'::regclass, 1, false) AS c1,
       pg_get_indexdef('ru.child_pk'::regclass, 2, true) AS c2,
       pg_get_indexdef('ru.child_pk'::regclass, 3, true) AS past_end,
       pg_get_indexdef('ru.odd_idx'::regclass, 1, false) AS odd1,
       pg_get_indexdef('ru.odd_idx'::regclass, 2, false) AS odd2;
----
c1	c2	past_end	odd1	odd2
a	b	(empty)	"Odd Col"	id


query
SELECT pg_get_indexdef('ru.child'::regclass) IS NULL AS on_table,
       pg_get_indexdef(0) IS NULL AS zero,
       pg_get_viewdef('ru.child'::regclass) IS NULL AS viewdef_of_table,
       pg_get_viewdef(0) IS NULL AS viewdef_zero,
       pg_get_constraintdef(0) IS NULL AS constraint_zero,
       pg_get_ruledef(0) IS NULL AS rule_zero,
       pg_get_triggerdef(0) IS NULL AS trigger_zero,
       pg_get_functiondef(0) IS NULL AS function_zero,
       pg_get_partkeydef('ru.child'::regclass) IS NULL AS partkey;
----
on_table	zero	viewdef_of_table	viewdef_zero	constraint_zero	rule_zero	trigger_zero	function_zero	partkey
t	t	t	t	t	t	t	t	t


