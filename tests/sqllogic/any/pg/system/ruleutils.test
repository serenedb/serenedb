CREATE FUNCTION ru.add1(x integer, y integer) RETURNS integer LANGUAGE sql AS 'SELECT x + y';


statement ok
CREATE FUNCTION ru.nonames(integer, text) RETURNS text LANGUAGE sql AS 'SELECT $2';


statement ok
CREATE FUNCTION ru.tf(n integer) RETURNS TABLE(i integer, s text) LANGUAGE sql AS 'SELECT n, ''x''';


statement ok
CREATE PROCEDURE ru.p(x integer) LANGUAGE sql AS 'SELECT 1';


query
SELECT proname, pg_get_function_arguments(oid) AS args,
       pg_get_function_identity_arguments(oid) AS identity,
       pg_get_function_result(oid) AS result,
       pg_get_function_arg_default(oid, 1) AS default1
FROM pg_proc WHERE pronamespace = 'ru'::regnamespace ORDER BY proname;
----
proname	args	identity	result	default1
add1	x integer, y integer	x integer, y integer	integer	NULL
nonames	integer, text	integer, text	text	NULL
p	IN x integer	IN x integer	NULL	NULL
tf	n integer	n integer	TABLE(i integer, s text)	NULL


query
SELECT proname, proargnames FROM pg_proc
WHERE pronamespace = 'ru'::regnamespace AND proname IN ('add1', 'nonames', 'p') ORDER BY proname;
----
proname	proargnames
add1	{x,y}
nonames	NULL
p	{x}


query
SELECT quote_ident('name') AS a, quote_ident('select') AS b, quote_ident('Mixed') AS c,
       quote_ident('1abc') AS d, quote_ident('a"b') AS e, format('%I.%I', 'text', 'order') AS f;
----
a	b	c	d	e	f
name	"select"	"Mixed"	"1abc"	"a""b"	text."order"


