query
SELECT pg_get_indexdef('ru.child'::regclass) IS NULL AS on_table,
       pg_get_indexdef(0) IS NULL AS zero,
       pg_get_viewdef('ru.child'::regclass) IS NULL AS viewdef_of_table,
       pg_get_viewdef(0) IS NULL AS viewdef_zero,
       pg_get_constraintdef(0) IS NULL AS constraint_zero,
       pg_get_ruledef(0) IS NULL AS rule_zero,
       pg_get_triggerdef(0) IS NULL AS trigger_zero,
       pg_get_functiondef(0) IS NULL AS function_zero,
       pg_get_partkeydef('ru.child'::regclass) IS NULL AS partkey;
