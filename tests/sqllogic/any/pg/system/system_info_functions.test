# pg_size_bytes

query
SELECT pg_size_bytes('1') AS a, pg_size_bytes('123bytes') AS b, pg_size_bytes('1kB') AS c,
       pg_size_bytes('1MB') AS d, pg_size_bytes(' 1 GB ') AS e, pg_size_bytes('1.5 GB ') AS f,
       pg_size_bytes('1TB') AS g, pg_size_bytes('3000 TB') AS h, pg_size_bytes('1e6 MB') AS i,
       pg_size_bytes('1 B') AS j, pg_size_bytes('1 kb') AS k, pg_size_bytes('1 PB') AS l;
----
a	b	c	d	e	f	g	h	i	j	k	l
1	123	1024	1048576	1073741824	1610612736	1099511627776	3298534883328000	1048576000000	1	1024	1125899906842624


query
SELECT pg_size_bytes('-1') AS a, pg_size_bytes('-.1') AS b, pg_size_bytes('-0.5') AS c,
       pg_size_bytes('0.5') AS d, pg_size_bytes('1.5 bytes') AS e, pg_size_bytes('-1.5 bytes') AS f,
       pg_size_bytes('1e-1 kB') AS g, pg_size_bytes('.5 kB') AS h, pg_size_bytes('5. kB') AS i,
       pg_size_bytes('+1kB') AS j, pg_size_bytes('1E3') AS k, pg_size_bytes('1e+2 MB') AS l;
----
a	b	c	d	e	f	g	h	i	j	k	l
-1	0	-1	1	2	-2	102	512	5120	1024	1000	104857600


query
SELECT pg_size_bytes('9223372036854775807') AS max, pg_size_bytes('-9223372036854775808') AS min,
       pg_size_bytes('8191 PB') AS pb,
       pg_size_bytes('0.0000000000000000000000000000000000000000000000000001 PB') AS tiny,
       pg_size_bytes('00000000000000000000000000000000000000000001.5 kB') AS zeros,
       pg_size_bytes(E'1\tkB') AS tab, pg_size_bytes(NULL) AS null_input;
----
max	min	pb	tiny	zeros	tab	null_input
9223372036854775807	-9223372036854775808	9222246136947933184	0	1536	1024	NULL


