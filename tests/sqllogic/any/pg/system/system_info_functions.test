# pg_sleep_for and pg_sleep_until

statement ok
CREATE TABLE sif_clock AS SELECT clock_timestamp() AS started;


statement ok
SELECT pg_sleep_for('100 milliseconds');


query
SELECT clock_timestamp() - started >= INTERVAL '100 milliseconds' AS slept FROM sif_clock;
----
slept
t


statement ok
UPDATE sif_clock SET started = clock_timestamp();


statement ok
SELECT pg_sleep_until(clock_timestamp() + INTERVAL '100 milliseconds');


query
SELECT clock_timestamp() - started >= INTERVAL '100 milliseconds' AS slept FROM sif_clock;
----
slept
t


query
SELECT count(*) AS calls FROM (SELECT pg_sleep_for(NULL), pg_sleep_until(NULL), pg_sleep_for('-1 second')) AS t;
----
calls
1


statement ok
DROP TABLE sif_clock;


