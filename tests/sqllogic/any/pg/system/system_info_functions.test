# makeaclitem

query
SELECT makeaclitem(12345, 0, 'SELECT', false)::text AS plain, makeaclitem(12345, 0, 'SELECT, INSERT', true)::text AS grantable,
       makeaclitem(0, 12345, 'usage', false)::text AS public,
       makeaclitem(12345, 12345, 'temp,temporary,connect,set,alter system,maintain', false)::text AS many,
       makeaclitem(12345, 12345, ' select , update ', false)::text AS spaced,
       makeaclitem(12345, 0, NULL, false)::text AS null_input;
----
plain	grantable	public	many	spaced	null_input
12345=r/0	12345=a*r*/0	=U/12345	12345=TcsAm/12345	12345=rw/12345	NULL


