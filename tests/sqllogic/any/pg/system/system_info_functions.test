# pg_get_function_sqlbody and pg_get_partition_constraintdef

statement ok
CREATE FUNCTION sif_body(a integer) RETURNS integer LANGUAGE sql AS 'SELECT a + 1';


query
SELECT pg_get_function_sqlbody('sif_body'::regproc) AS string_body, pg_get_function_sqlbody(0) AS missing,
       pg_get_function_sqlbody('lower(text)'::regprocedure) AS builtin;
----
string_body	missing	builtin
NULL	NULL	NULL


query
SELECT pg_get_partition_constraintdef('sif_keyed'::regclass) AS plain, pg_get_partition_constraintdef(0) AS missing;
----
plain	missing
NULL	NULL


statement ok
DROP FUNCTION sif_body;


# pg_column_size

query
SELECT pg_column_size(1) AS int4, pg_column_size(1::bigint) AS int8, pg_column_size(1::smallint) AS int2,
       pg_column_size(true) AS bool, pg_column_size(1.5::float8) AS float8, pg_column_size(1.5::float4) AS float4,
       pg_column_size(DATE '2024-01-01') AS date, pg_column_size(TIME '12:00') AS time,
       pg_column_size(TIMESTAMP '2024-01-01 12:00') AS ts, pg_column_size(INTERVAL '1 day') AS iv,
       pg_column_size('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid) AS uuid, pg_column_size(NULL::int) AS null_input;
----
int4	int8	int2	bool	float8	float4	date	time	ts	iv	uuid	null_input
4	8	2	1	8	4	4	8	8	16	16	NULL


query
SELECT pg_column_size('abc'::text) AS text, pg_column_size(''::text) AS empty, pg_column_size('abc'::varchar) AS varchar,
       pg_column_size('\x0102'::bytea) AS bytea, pg_column_size(repeat('x', 200)) AS long_text;
----
text	empty	varchar	bytea	long_text
7	4	7	6	204


query
SELECT pg_column_size(0::numeric) AS zero, pg_column_size(1::numeric) AS one, pg_column_size(1.00::numeric) AS one_scaled,
       pg_column_size(10000::numeric) AS ten_k, pg_column_size(12345::numeric) AS two_digits,
       pg_column_size(0.0001::numeric(10,4)) AS small, pg_column_size(0.00001::numeric(10,5)) AS smaller,
       pg_column_size(-1.5::numeric) AS negative, pg_column_size(123.45::numeric(10,2)) AS typed,
       pg_column_size(123456789.123::numeric) AS long_value;
----
zero	one	one_scaled	ten_k	two_digits	small	smaller	negative	typed	long_value
6	8	8	8	10	8	8	10	10	14


query
SELECT pg_column_size(ARRAY[1, 2, 3]) AS ints, pg_column_size(ARRAY[1, NULL, 3]) AS nulls,
       pg_column_size(ARRAY[1::bigint, 2]) AS bigints, pg_column_size(ARRAY['a', 'b']::text[]) AS texts,
       pg_column_size(ARRAY[[1, 2], [3, 4]]) AS matrix, pg_column_size(ARRAY[]::integer[]) AS empty;
----
ints	nulls	bigints	texts	matrix	empty
36	40	40	40	48	16


query
SELECT pg_column_size(ROW(1, 2)) AS ints, pg_column_size(ROW(1, NULL)) AS nulls,
       pg_column_size(ROW('abc', 1)) AS text_int, pg_column_size(ROW(1::bigint, 1)) AS wide_first,
       pg_column_size(ROW(1, 1::bigint)) AS wide_second, pg_column_size(ROW(true)) AS bool;
----
ints	nulls	text_int	wide_first	wide_second	bool
32	28	32	36	40	25


statement ok
INSERT INTO sif_plain VALUES (1, 'abc'), (2, repeat('x', 200));


query
SELECT id, pg_column_size(sif_plain) AS row_size FROM sif_plain ORDER BY id;
----
id	row_size
1	32
2	232


