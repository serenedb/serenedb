db error: ERROR: value overflows numeric format


# pg_tablespace_size

query
SELECT pg_tablespace_size('pg_default') >= pg_database_size(current_database()) AS by_name,
       pg_tablespace_size(1663::oid) >= pg_database_size(current_database()) AS by_oid,
       pg_tablespace_size('pg_global') >= 0 AS global, pg_tablespace_size(NULL::oid) AS null_input;
----
by_name	by_oid	global	null_input
t	t	t	NULL


statement error
SELECT pg_tablespace_size('sif_nosuch');
----
db error: ERROR: tablespace "sif_nosuch" does not exist


statement error
SELECT pg_tablespace_size(0::oid);
----
db error: ERROR: tablespace with OID 0 does not exist


# has_parameter_privilege

query
SELECT has_parameter_privilege('work_mem', 'SET') AS set, has_parameter_privilege('work_mem', 'ALTER SYSTEM') AS alter_system,
       has_parameter_privilege('sif_nosuch', 'SET') AS unknown, has_parameter_privilege('work_mem', 'set, alter system') AS both,
       has_parameter_privilege('work_mem', 'SET WITH GRANT OPTION') AS grantable,
       has_parameter_privilege(current_user, 'work_mem', 'SET') AS by_name,
       has_parameter_privilege((SELECT oid FROM pg_roles WHERE rolname = current_user), 'work_mem', 'SET') AS by_oid;
----
set	alter_system	unknown	both	grantable	by_name	by_oid
t	t	t	t	t	t	t


query
SELECT has_parameter_privilege('public', 'work_mem', 'SET') AS public,
       has_parameter_privilege('sif_role_${__DATABASE__}', 'work_mem', 'SET') AS role,
       has_parameter_privilege(0::oid, 'work_mem', 'SET') AS oid_zero,
       has_parameter_privilege(NULL, 'SET') AS null_parameter, has_parameter_privilege('work_mem', NULL) AS null_privilege;
----
public	role	oid_zero	null_parameter	null_privilege
f	f	f	NULL	NULL


statement error
SELECT has_parameter_privilege('work_mem', 'SELECT');
----
db error: ERROR: unrecognized privilege type: "SELECT"


statement error
SELECT has_parameter_privilege('sif_nosuch_role', 'work_mem', 'SET');
----
db error: ERROR: role "sif_nosuch_role" does not exist


# has_largeobject_privilege

query
SELECT has_largeobject_privilege(0, 'SELECT') AS missing, has_largeobject_privilege(12345, 'UPDATE') AS update,
       has_largeobject_privilege(current_user, 0, 'SELECT') AS by_name,
       has_largeobject_privilege((SELECT oid FROM pg_roles WHERE rolname = current_user), 0, 'SELECT WITH GRANT OPTION') AS by_oid;
----
missing	update	by_name	by_oid
NULL	NULL	NULL	NULL


statement error
SELECT has_largeobject_privilege(0, 'USAGE');
----
db error: ERROR: unrecognized privilege type: "USAGE"


statement error
SELECT has_largeobject_privilege('sif_nosuch_role', 0, 'SELECT');
----
db error: ERROR: role "sif_nosuch_role" does not exist


# makeaclitem

query
SELECT makeaclitem(12345, 0, 'SELECT', false)::text AS plain, makeaclitem(12345, 0, 'SELECT, INSERT', true)::text AS grantable,
       makeaclitem(0, 12345, 'usage', false)::text AS public,
       makeaclitem(12345, 12345, 'temp,temporary,connect,set,alter system,maintain', false)::text AS many,
       makeaclitem(12345, 12345, ' select , update ', false)::text AS spaced,
       makeaclitem(12345, 0, NULL, false)::text AS null_input;
----
plain	grantable	public	many	spaced	null_input
12345=r/0	12345=a*r*/0	=U/12345	12345=TcsAm/12345	12345=rw/12345	NULL


statement error
SELECT makeaclitem(12345, 0, 'ALL', false);
----
db error: ERROR: unrecognized privilege type: "ALL"


statement error
SELECT makeaclitem(12345, 0, 'SELECT WITH GRANT OPTION', false);
----
db error: ERROR: unrecognized privilege type: "SELECT WITH GRANT OPTION"


statement error
SELECT makeaclitem(12345, 0, '', false);
----
db error: ERROR: unrecognized privilege type: ""


# pg_get_function_sqlbody and pg_get_partition_constraintdef

statement ok
CREATE FUNCTION sif_body(a integer) RETURNS integer LANGUAGE sql AS 'SELECT a + 1';


query
SELECT pg_get_function_sqlbody('sif_body'::regproc) AS string_body, pg_get_function_sqlbody(0) AS missing,
       pg_get_function_sqlbody('lower(text)'::regprocedure) AS builtin;
----
string_body	missing	builtin
NULL	NULL	NULL


query
SELECT pg_get_partition_constraintdef('sif_keyed'::regclass) AS plain, pg_get_partition_constraintdef(0) AS missing;
----
plain	missing
NULL	NULL


statement ok
DROP FUNCTION sif_body;


