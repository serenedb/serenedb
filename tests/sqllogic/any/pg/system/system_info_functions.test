# System information and catalog functions

control substitution on

statement ok
CREATE ROLE sif_role_${__DATABASE__};


statement ok
CREATE TABLE sif_keyed (id integer PRIMARY KEY, v text);


statement ok
CREATE TABLE sif_plain (id integer, v text);


statement ok
CREATE VIEW sif_view AS SELECT 1 AS x;


statement ok
CREATE SEQUENCE sif_seq START 5 INCREMENT 2 MINVALUE 1 MAXVALUE 100 CACHE 3 CYCLE;


statement ok
CREATE SEQUENCE sif_seq_plain;


# pg_input_is_valid

query
SELECT pg_input_is_valid('42', 'integer') AS int_ok, pg_input_is_valid('42000000000', 'integer') AS int_range,
       pg_input_is_valid('abc', 'integer') AS int_bad, pg_input_is_valid('1.5', 'numeric') AS numeric_ok,
       pg_input_is_valid('12.34', 'numeric(3,2)') AS numeric_typmod, pg_input_is_valid('2024-01-01', 'date') AS date_ok,
       pg_input_is_valid('2024-13-01', 'date') AS date_bad, pg_input_is_valid('t', 'boolean') AS bool_ok,
       pg_input_is_valid('maybe', 'boolean') AS bool_bad, pg_input_is_valid('{1,2,3}', 'integer[]') AS array_ok,
       pg_input_is_valid('{1,x}', 'integer[]') AS array_bad;
----
int_ok	int_range	int_bad	numeric_ok	numeric_typmod	date_ok	date_bad	bool_ok	bool_bad	array_ok	array_bad
t	f	f	t	f	t	f	t	f	t	f


query
SELECT pg_input_is_valid('0/16B3748', 'pg_lsn') AS lsn_ok, pg_input_is_valid('xyz', 'pg_lsn') AS lsn_bad,
       pg_input_is_valid('10.0.0.0/8', 'cidr') AS cidr_ok, pg_input_is_valid('1.2.3.4/16', 'cidr') AS cidr_bad,
       pg_input_is_valid('\x0102', 'bytea') AS bytea_ok, pg_input_is_valid('\xzz', 'bytea') AS bytea_bad,
       pg_input_is_valid('pg_class', 'regclass') AS class_ok, pg_input_is_valid('sif_nosuch', 'regclass') AS class_bad,
       pg_input_is_valid('int4', 'regtype') AS type_ok, pg_input_is_valid('sif_nosuch', 'regtype') AS type_bad;
----
lsn_ok	lsn_bad	cidr_ok	cidr_bad	bytea_ok	bytea_bad	class_ok	class_bad	type_ok	type_bad
t	f	t	f	t	f	t	f	t	f


query
SELECT pg_input_is_valid(NULL, 'integer') AS null_text, pg_input_is_valid('1', NULL) AS null_type;
----
null_text	null_type
NULL	NULL


query
SELECT id, pg_input_is_valid(v, 'integer') AS valid
FROM (VALUES (1, '1'), (2, 'x'), (3, '-7'), (4, ''), (5, NULL)) AS t(id, v) ORDER BY id;
----
id	valid
1	t
2	f
3	t
4	f
5	NULL


statement error
SELECT pg_input_is_valid('1', 'sif_nosuch_type');
----
db error: ERROR: type "sif_nosuch_type" does not exist


# pg_input_error_info

query
SELECT * FROM pg_input_error_info('42', 'integer');
----
message	detail	hint	sql_error_code
NULL	NULL	NULL	NULL


query
SELECT message IS NOT NULL AS has_message, detail, hint, sql_error_code FROM pg_input_error_info('abc', 'integer');
----
has_message	detail	hint	sql_error_code
t	NULL	NULL	22P02


query
SELECT * FROM pg_input_error_info('1.2.3.4/16', 'cidr');
----
message	detail	hint	sql_error_code
invalid cidr value: "1.2.3.4/16"	Value has bits set to right of mask.	NULL	22P02


query
SELECT * FROM pg_input_error_info('xyz', 'pg_lsn');
----
message	detail	hint	sql_error_code
invalid input syntax for type pg_lsn: "xyz"	NULL	NULL	22P02


query
SELECT * FROM pg_input_error_info('\xzz', 'bytea');
----
message	detail	hint	sql_error_code
invalid hexadecimal digit: "z"	NULL	NULL	22023


query
SELECT * FROM pg_input_error_info('\x123', 'bytea');
----
message	detail	hint	sql_error_code
invalid hexadecimal data: odd number of digits	NULL	NULL	22023


query
SELECT * FROM pg_input_error_info('\', 'bytea');
----
message	detail	hint	sql_error_code
invalid input syntax for type bytea	NULL	NULL	22P02


query
SELECT * FROM pg_input_error_info('sif_nosuch', 'regclass');
----
message	detail	hint	sql_error_code
relation "sif_nosuch" does not exist	NULL	NULL	42P01


query
SELECT * FROM pg_input_error_info('sif_nosuch', 'regtype');
----
message	detail	hint	sql_error_code
type "sif_nosuch" does not exist	NULL	NULL	42704


query
SELECT * FROM pg_input_error_info('sif_nosuch', 'regrole');
----
message	detail	hint	sql_error_code
role "sif_nosuch" does not exist	NULL	NULL	42704


query
SELECT * FROM pg_input_error_info('sif_nosuch', 'regnamespace');
----
message	detail	hint	sql_error_code
schema "sif_nosuch" does not exist	NULL	NULL	3F000


query
SELECT (pg_input_error_info(NULL, 'integer')).message AS null_text,
       (pg_input_error_info('1', NULL)).message AS null_type;
----
null_text	null_type
NULL	NULL


# pg_sequence_parameters and pg_get_sequence_data

query
SELECT * FROM pg_sequence_parameters('sif_seq'::regclass);
----
start_value	minimum_value	maximum_value	increment	cycle_option	cache_size	data_type
5	1	100	2	t	3	20


query
SELECT start_value, minimum_value, maximum_value, increment, cycle_option, cache_size
FROM pg_sequence_parameters('sif_seq_plain'::regclass);
----
start_value	minimum_value	maximum_value	increment	cycle_option	cache_size
1	1	9223372036854775807	1	f	1


query
SELECT (pg_sequence_parameters(NULL)).start_value AS null_input;
----
null_input
NULL


statement error
SELECT * FROM pg_sequence_parameters(0);
----
db error: ERROR: relation with OID 0 does not exist


statement error
SELECT * FROM pg_sequence_parameters('sif_plain'::regclass);
----
db error: ERROR: cache lookup failed for sequence <slt:ignore>


query
SELECT * FROM pg_get_sequence_data('sif_seq');
----
last_value	is_called
5	f


statement ok
SELECT nextval('sif_seq');


query
SELECT last_value >= 5 AS advanced, is_called FROM pg_get_sequence_data('sif_seq');
----
advanced	is_called
t	t


statement ok
SELECT setval('sif_seq_plain', 42);


query
SELECT * FROM pg_get_sequence_data('sif_seq_plain');
----
last_value	is_called
42	t


query
SELECT pg_sequence_last_value('sif_seq_plain') AS last_value;
----
last_value
42


statement ok
SELECT setval('sif_seq_plain', 50, false);


query
SELECT * FROM pg_get_sequence_data('sif_seq_plain');
----
last_value	is_called
50	f


query
SELECT pg_sequence_last_value('sif_seq_plain') AS last_value;
----
last_value
NULL


query
SELECT nextval('sif_seq_plain') AS next;
----
next
50


query
SELECT is_called FROM pg_get_sequence_data('sif_seq_plain');
----
is_called
t


query
SELECT * FROM pg_get_sequence_data('sif_plain');
----
last_value	is_called
NULL	NULL


query
SELECT * FROM pg_get_sequence_data(0);
----
last_value	is_called
NULL	NULL


statement ok
SET ROLE sif_role_${__DATABASE__};


query
SELECT * FROM pg_get_sequence_data('sif_seq_plain');
----
last_value	is_called
NULL	NULL


query
SELECT pg_sequence_last_value('sif_seq_plain') AS last_value;
----
last_value
NULL


statement error
SELECT * FROM pg_sequence_parameters('sif_seq_plain'::regclass);
----
db error: ERROR: permission denied for sequence sif_seq_plain


statement ok
RESET ROLE;


# pg_size_bytes

query
SELECT pg_size_bytes('1') AS a, pg_size_bytes('123bytes') AS b, pg_size_bytes('1kB') AS c,
       pg_size_bytes('1MB') AS d, pg_size_bytes(' 1 GB ') AS e, pg_size_bytes('1.5 GB ') AS f,
       pg_size_bytes('1TB') AS g, pg_size_bytes('3000 TB') AS h, pg_size_bytes('1e6 MB') AS i,
       pg_size_bytes('1 B') AS j, pg_size_bytes('1 kb') AS k, pg_size_bytes('1 PB') AS l;
----
a	b	c	d	e	f	g	h	i	j	k	l
1	123	1024	1048576	1073741824	1610612736	1099511627776	3298534883328000	1048576000000	1	1024	1125899906842624


query
SELECT pg_size_bytes('-1') AS a, pg_size_bytes('-.1') AS b, pg_size_bytes('-0.5') AS c,
       pg_size_bytes('0.5') AS d, pg_size_bytes('1.5 bytes') AS e, pg_size_bytes('-1.5 bytes') AS f,
       pg_size_bytes('1e-1 kB') AS g, pg_size_bytes('.5 kB') AS h, pg_size_bytes('5. kB') AS i,
       pg_size_bytes('+1kB') AS j, pg_size_bytes('1E3') AS k, pg_size_bytes('1e+2 MB') AS l;
----
a	b	c	d	e	f	g	h	i	j	k	l
-1	0	-1	1	2	-2	102	512	5120	1024	1000	104857600


query
SELECT pg_size_bytes('9223372036854775807') AS max, pg_size_bytes('-9223372036854775808') AS min,
       pg_size_bytes('8191 PB') AS pb,
       pg_size_bytes('0.0000000000000000000000000000000000000000000000000001 PB') AS tiny,
       pg_size_bytes('00000000000000000000000000000000000000000001.5 kB') AS zeros,
       pg_size_bytes(E'1\tkB') AS tab, pg_size_bytes(NULL) AS null_input;
----
max	min	pb	tiny	zeros	tab	null_input
9223372036854775807	-9223372036854775808	9222246136947933184	0	1536	1024	NULL


statement error
SELECT pg_size_bytes('');
----
db error: ERROR: invalid size: ""


statement error
SELECT pg_size_bytes('kB');
----
db error: ERROR: invalid size: "kB"


statement error
SELECT pg_size_bytes('1 KiB');
