----
db error: ERROR: invalid size: "1e kB"
DETAIL: Invalid size unit: "e kB".
HINT: Valid units are "bytes", "B", "kB", "MB", "GB", "TB", and "PB".


statement error
SELECT pg_size_bytes('1e 5');
----
db error: ERROR: invalid input syntax for type numeric: "1e 5"


statement error
SELECT pg_size_bytes('8192 PB');
----
db error: ERROR: bigint out of range


statement error
SELECT pg_size_bytes('9223372036854775808');
----
db error: ERROR: bigint out of range


statement error
SELECT pg_size_bytes('1e1000000');
----
db error: ERROR: value overflows numeric format


statement error
SELECT pg_size_bytes('1e-20000');
