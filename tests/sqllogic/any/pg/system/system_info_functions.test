# pg_tablespace_databases

query
SELECT EXISTS (SELECT 1 FROM pg_tablespace_databases(1663) AS t(o)
               JOIN pg_database AS d ON d.oid = t.o
               WHERE d.datname = current_database()) AS current;
----
current
t


query
