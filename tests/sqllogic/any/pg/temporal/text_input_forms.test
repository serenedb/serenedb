control substitution on

statement ok
SET TIME ZONE 'UTC';


query
SELECT '2026-10-10 09:55:01.123 +00:00'::timestamptz::text AS spaced_offset,
       '2026-10-10 09:55:01 +02'::timestamptz::text AS spaced_hours,
       '2026-10-10 09:55:01 Z'::timestamptz::text AS spaced_z,
       '2004-02-01 +03'::timestamptz::text AS date_offset;
