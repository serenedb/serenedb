statement ok
CREATE TABLE text_input_src (b TEXT, d TEXT, t TEXT, ts TEXT);


statement ok
INSERT INTO text_input_src VALUES
  ('TRUE', '2004-02-01 00:00:00', '07:08:09+00', '2026-10-10 09:55:01.123 +00:00'),
  ('False', '20240102', '07:08:09', '2026-10-10 09:55:01 Z'),
  ('YES', '2004-02-01 +00', '07:08:09 +05', '2026-10-10 09:55:01'),
  ('n', '2004-02-01', '07:08:09', '2026-10-10 09:55:01+02'),
  (' on ', '2004-02-01', '07:08:09', '2004-02-01 +03');


statement ok
COPY text_input_src TO '${__TEST_DIR__}/text_input_forms.txt' (FORMAT text);


statement ok
CREATE TABLE text_input_dst (b BOOLEAN, d DATE, t TIME, ts TIMESTAMPTZ);


statement ok
COPY text_input_dst FROM '${__TEST_DIR__}/text_input_forms.txt' (FORMAT text);


query
SELECT b, d, t, ts::text AS ts FROM text_input_dst ORDER BY text_input_dst.ts, b;
