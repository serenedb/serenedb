spaced_offset	spaced_hours	spaced_z	date_offset
2026-10-10 09:55:01.123+00	2026-10-10 07:55:01+00	2026-10-10 09:55:01+00	2004-01-31 21:00:00+00


query
SELECT '2004-02-01 +00'::date AS date_zone, '2004-02-01 10:11:12'::date AS date_time, '20240102'::date AS basic;
----
date_zone	date_time	basic
2004-02-01	2004-02-01	2024-01-02


query
SELECT ' true '::bool AS spaced, 'TRUE'::bool AS upper_true, 'Fa'::bool AS prefix, 'YES'::bool AS yes,
       ' n '::bool AS n, 'of'::bool AS off_prefix, ' on '::bool AS on_spaced;
----
spaced	upper_true	prefix	yes	n	off_prefix	on_spaced
t	t	f	t	f	f	t


