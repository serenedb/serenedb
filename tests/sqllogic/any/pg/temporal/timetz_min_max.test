CREATE TABLE timetz_min_max (i INT, t TIMETZ)


statement ok
INSERT INTO timetz_min_max VALUES (1, '04:00:00-05'), (2, '06:00:00+00'), (3, '10:00:00+05')


query
SELECT min(t), max(t) FROM timetz_min_max
----
min	max
10:00:00+05	04:00:00-05


query
SELECT i, min(t) OVER () AS lo, max(t) OVER () AS hi FROM timetz_min_max ORDER BY i
----
i	lo	hi
1	10:00:00+05	04:00:00-05
2	10:00:00+05	04:00:00-05
3	10:00:00+05	04:00:00-05


statement ok
