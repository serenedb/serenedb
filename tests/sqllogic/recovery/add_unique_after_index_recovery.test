control substitution on


statement ok
CREATE TABLE auc_t (a INTEGER, b INTEGER, c TEXT);


statement ok
CREATE INDEX auc_a ON auc_t (a);


statement ok
CREATE INDEX auc_c ON auc_t USING inverted(c);


statement count 2
INSERT INTO auc_t VALUES (1, 1, 'x'), (2, 2, 'y');


statement ok
ALTER TABLE auc_t ADD CONSTRAINT auc_b_key UNIQUE (b);


statement ok
FORCE CHECKPOINT;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT indexname FROM pg_indexes WHERE tablename = 'auc_t' ORDER BY 1;
----
indexname
auc_a
auc_b_key
auc_c


connection after_crash
statement error
INSERT INTO auc_t VALUES (3, 1, 'z');
----
db error: ERROR: Duplicate key "b: 1" violates unique constraint.<slt:ignore>


connection after_crash
statement count 1
INSERT INTO auc_t VALUES (1, 3, 'z');


connection after_crash
query
SELECT b, c FROM auc_t WHERE a = 1 ORDER BY b;
----
b	c
1	x
3	z
