control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE SCHEMA acf_fs;


statement ok
RESET sdb_faults;


statement ok
CREATE FUNCTION acf_fs.acf_conv(x INT) RETURNS BIGINT LANGUAGE sql IMMUTABLE AS 'SELECT x * 10';


statement ok
CREATE FUNCTION acf_fs.acf_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


statement ok
CREATE TABLE public.acf_defaults (id INT PRIMARY KEY, a INT);


statement ok
INSERT INTO public.acf_defaults VALUES (1, 1);


statement ok
SET search_path = acf_fs, public;


statement ok
CREATE TABLE public.acf_retyped (id INT PRIMARY KEY, a INT);


statement ok
CREATE TABLE public.acf_checked (id INT PRIMARY KEY, a INT CHECK (acf_pos(a)), b INT, c INT);


statement ok
CREATE TABLE public.acf_shared (id INT PRIMARY KEY, a INT, b INT, CHECK (acf_pos(a) AND b > 0));


statement ok
INSERT INTO public.acf_retyped VALUES (1, 1), (2, 2);


statement ok
INSERT INTO public.acf_checked VALUES (1, 1, 1, 1);


statement ok
INSERT INTO public.acf_shared VALUES (1, 1, 1);


statement ok
ALTER TABLE public.acf_checked DROP COLUMN b;


statement ok
ALTER TABLE public.acf_checked ALTER COLUMN c TYPE BIGINT;


statement ok
ALTER TABLE public.acf_retyped ALTER COLUMN a TYPE BIGINT USING acf_conv(a);


statement ok
ALTER TABLE public.acf_shared DROP COLUMN b;


statement ok
ALTER TABLE public.acf_defaults ADD COLUMN d BIGINT DEFAULT acf_conv(7);


statement ok
CREATE TABLE public.acf_generated (id INT PRIMARY KEY, a INT,
  v BIGINT GENERATED ALWAYS AS (acf_conv(a)) VIRTUAL, s BIGINT GENERATED ALWAYS AS (acf_conv(a)) STORED);


statement ok
INSERT INTO public.acf_generated (id, a) VALUES (1, 1);


statement ok
ALTER TABLE public.acf_generated ADD COLUMN b INT;


statement ok
RESET search_path;


statement ok
CREATE DATABASE acf_app;


connection app database=acf_app
statement ok
CREATE FUNCTION acf_app_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


connection app database=acf_app
statement ok
CREATE FUNCTION acf_app_conv(x INT) RETURNS BIGINT LANGUAGE sql IMMUTABLE AS 'SELECT x * 10';


connection app database=acf_app
statement ok
CREATE TABLE acf_t (id INT PRIMARY KEY, a INT CHECK (acf_app_pos(a)), b INT, c INT);


connection app database=acf_app
statement ok
INSERT INTO acf_t VALUES (1, 1, 1, 1);


connection app database=acf_app
statement ok
ALTER TABLE acf_t DROP COLUMN b;


connection app database=acf_app
statement ok
ALTER TABLE acf_t ALTER COLUMN c TYPE BIGINT USING acf_app_conv(c);


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection restarted
