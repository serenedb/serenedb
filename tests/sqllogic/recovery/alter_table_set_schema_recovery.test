statement ok
CREATE TABLE mrbeast.subscribers (id SERIAL, name TEXT);


statement ok
ALTER TABLE mrbeast.subscribers SET SCHEMA feastables;


statement ok
CREATE VIEW mrbeast.trending AS SELECT 67 AS views;


statement ok
ALTER VIEW mrbeast.trending SET SCHEMA feastables;


statement ok
CREATE SEQUENCE mrbeast.prize_seq START 67;


statement ok
ALTER SEQUENCE mrbeast.prize_seq SET SCHEMA feastables;


statement ok
CREATE TYPE mrbeast.mood AS ENUM ('hyped', 'chill');


statement ok
ALTER TYPE mrbeast.mood SET SCHEMA feastables;


statement ok
CREATE FUNCTION mrbeast.six_seven() RETURNS int LANGUAGE sql AS 'SELECT 67';


statement ok
ALTER FUNCTION mrbeast.six_seven SET SCHEMA feastables;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
