statement ok
ALTER TABLE mrbeast.checkpointed SET SCHEMA feastables;


statement ok
FORCE CHECKPOINT;


statement ok
CREATE TABLE mrbeast.logged (id INT PRIMARY KEY, name TEXT);


statement ok
CREATE INDEX logged_name_idx ON mrbeast.logged (name);


statement ok
