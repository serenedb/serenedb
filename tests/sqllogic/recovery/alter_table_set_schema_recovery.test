table_schema	table_name
feastables	checkpointed
feastables	logged
feastables	subscribers
feastables	trending


connection after_crash
query
SELECT schemaname, sequencename
FROM pg_sequences
WHERE schemaname IN ('mrbeast', 'feastables')
ORDER BY sequencename;
----
schemaname	sequencename
feastables	prize_seq
feastables	subscribers_id_seq


connection after_crash
query
