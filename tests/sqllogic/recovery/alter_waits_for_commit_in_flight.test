# ALTER TABLE waits only for a commit of the table that is already being
# published: the committed row is part of the table the ALTER rewrites.

statement ok
CREATE TABLE awcif (a INT);

connection awcif_writer
statement ok
BEGIN;

connection awcif_writer
statement ok
INSERT INTO awcif VALUES (1);

statement ok
SET sdb_faults = 'search_commit_prepared';

connection awcif_writer
statement async ok
COMMIT;

statement ok retry 40 backoff 250ms
SET sdb_faults = '-search_commit_prepared:parked';

connection awcif_alter
statement async ok
ALTER TABLE awcif ADD COLUMN c INT DEFAULT 7;

query ok retry 40 backoff 250ms
SELECT count(*) AS altering FROM pg_stat_activity
WHERE query LIKE 'ALTER TABLE awcif%' AND state = 'active';
----
altering
1

statement ok
SET sdb_faults = 'search_commit_prepared:release';

wait

query
SELECT a, c FROM awcif;
----
a	c
1	7
