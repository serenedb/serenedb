control substitution on

statement ok
CREATE TABLE ann_old(pk INTEGER PRIMARY KEY, h FLOAT[4], v FLOAT[4]);

statement ok
CREATE INDEX ann_old_idx ON ann_old
  USING inverted(pk, h hnsw (metric = 'l2', quant = 'none'),
                 v ivf (metric = 'l2', quant = 'none'))
  WITH (compaction_interval = 0);

statement ok
SET sdb_faults = 'irs::OldAnnFormat';

statement ok
INSERT INTO ann_old SELECT i, [i::FLOAT, 0, 0, 0]::FLOAT[4],
  [i::FLOAT, 0, 0, 0]::FLOAT[4] FROM range(1, 51) t(i);

statement ok
VACUUM (REFRESH_TABLE) ann_old;

statement ok
SET sdb_faults = '-irs::OldAnnFormat';

statement ok
INSERT INTO ann_old SELECT i, [i::FLOAT, 0, 0, 0]::FLOAT[4],
  [i::FLOAT, 0, 0, 0]::FLOAT[4] FROM range(51, 101) t(i);

statement ok
VACUUM (REFRESH_TABLE) ann_old;

statement ok
SET sdb_faults = 'shutdown_on_packet';

statement error
SELECT 1;


