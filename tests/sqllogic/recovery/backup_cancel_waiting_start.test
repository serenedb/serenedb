control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE bcw_docs (id BIGINT PRIMARY KEY, body TEXT) WITH (storage = 'search');


statement ok
CREATE TABLE bcw_plain (id BIGINT);


statement ok
SET sdb_faults = 'pause_search_commit_before_irs';


connection parked
statement async ok
INSERT INTO bcw_docs VALUES (1, 'parked');


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_irs:parked';


connection starter
statement async error
SELECT pg_backup_start('bcw_cancel_me');
