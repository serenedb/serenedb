phase	backup_total	backup_streamed	tablespaces_total	tablespaces_streamed
waiting for in-flight commits	0	0	0	0


connection default
statement ok
SELECT pg_cancel_backend(pid) FROM pg_stat_progress_basebackup;


connection starter
statement error
