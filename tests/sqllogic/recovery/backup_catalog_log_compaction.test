connection default
query
SELECT
  live.size > (SELECT size FROM bclc_before) AS grew,
  link.size = live.size AS same_file
FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/catalog.wal') AS live,
  read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/backup/catalog.wal') AS link;
----
grew	same_file
t	t


connection default
statement ok
CREATE TEMP TABLE bclc_during AS
SELECT size FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/catalog.wal');


connection holder
query
SELECT starts_with(labelfile, 'START WAL LOCATION: ') AS label FROM pg_backup_stop();
----
label
t


connection default
statement ok
CREATE TABLE bclc_3 (x BIGINT);


connection default
query
SELECT size < (SELECT size FROM bclc_during) AS compacted
FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/catalog.wal');
----
compacted
t


