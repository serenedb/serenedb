connection default
statement ok
DROP TABLE bcmd_gone;


connection default
statement ok
DROP DATABASE bcmd_db;


connection default
statement ok
SELECT pg_sleep(1);


connection default
query
SELECT
  count(*) FILTER (WHERE file LIKE '%/engine_v1/' || db || '/' || gone || '/%') > 0 AS table_kept,
  count(*) FILTER (WHERE file LIKE '%/engine_v1/' || other || '/%') > 0 AS database_kept
FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/**'), bcmd_oids;
----
table_kept	database_kept
t	t


connection default
statement ok
ALTER TABLE bcmd_merge SET (compaction_interval = 100);


connection compactor
statement async ok
VACUUM (COMPACT_TABLE) bcmd_merge;


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS compacting FROM pg_stat_activity
WHERE query LIKE 'VACUUM (COMPACT_TABLE) bcmd_merge%' AND state = 'active';
----
compacting
1


connection default
statement ok
SELECT pg_sleep(1);


connection default
query
SELECT count(DISTINCT row_group_id) AS segments FROM pragma_storage_info('bcmd_merge') WHERE column_name = 'id';
----
segments
4


connection default
statement ok
CREATE TEMP TABLE bcmd_wal AS
SELECT max(size) AS size FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/data.db.wal'), bcmd_oids
WHERE filename LIKE '%/engine_v1/' || db || '/data.db.wal';


connection default
query
SELECT size > 0 AS has_wal FROM bcmd_wal;
----
has_wal
t


connection holder
query
SELECT starts_with(labelfile, 'START WAL LOCATION: ') AS label FROM pg_backup_stop();
----
label
t


wait


connection default
statement ok
FORCE CHECKPOINT;


connection default
query
SELECT coalesce(max(size), 0) < (SELECT size FROM bcmd_wal) AS checkpointed
FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/data.db.wal'), bcmd_oids
WHERE filename LIKE '%/engine_v1/' || db || '/data.db.wal';
----
checkpointed
t


connection default
query
SELECT count(DISTINCT row_group_id) < 4 AS merged FROM pragma_storage_info('bcmd_merge') WHERE column_name = 'id';
----
merged
t


connection default
query ok retry 40 backoff 250ms
SELECT
  count(*) FILTER (WHERE file LIKE '%/engine_v1/' || db || '/' || gone || '/%') AS table_files,
  count(*) FILTER (WHERE file LIKE '%/engine_v1/' || other || '/%') AS database_files
FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/**'), bcmd_oids;
