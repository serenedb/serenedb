control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE bcmd_docs (id BIGINT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO bcmd_docs SELECT i, 'first' FROM range(0, 100) r(i);


statement ok
VACUUM (REFRESH_TABLE) bcmd_docs;


statement ok
CREATE TABLE bcmd_merge (id BIGINT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO bcmd_merge SELECT i, 'fox dog' FROM range(0, 100) r(i);


statement ok
VACUUM (REFRESH_TABLE) bcmd_merge;


statement ok
INSERT INTO bcmd_merge SELECT i, 'fox dog' FROM range(100, 200) r(i);


statement ok
VACUUM (REFRESH_TABLE) bcmd_merge;


statement ok
INSERT INTO bcmd_merge SELECT i, 'fox dog' FROM range(200, 300) r(i);


statement ok
VACUUM (REFRESH_TABLE) bcmd_merge;


statement ok
INSERT INTO bcmd_merge SELECT i, 'fox dog' FROM range(300, 400) r(i);


statement ok
VACUUM (REFRESH_TABLE) bcmd_merge;


query
SELECT count(DISTINCT row_group_id) AS segments FROM pragma_storage_info('bcmd_merge') WHERE column_name = 'id';
----
segments
4


statement ok
CREATE TABLE bcmd_gone (id BIGINT PRIMARY KEY, body TEXT) WITH (storage = 'search');


statement ok
INSERT INTO bcmd_gone VALUES (1, 'gone');


statement ok
CREATE DATABASE bcmd_db;


statement ok
CREATE TABLE bcmd_db.public.t (x BIGINT);


statement ok
INSERT INTO bcmd_db.public.t VALUES (1);


statement ok
CHECKPOINT bcmd_db;


statement ok
CREATE TEMP TABLE bcmd_oids AS
SELECT
  (SELECT database_oid FROM duckdb_databases() WHERE database_name = current_database()) AS db,
  (SELECT database_oid FROM duckdb_databases() WHERE database_name = 'bcmd_db') AS other,
  'bcmd_gone'::regclass::oid AS gone,
  'bcmd_docs'::regclass::oid AS docs;


query
SELECT count(*) = 1 AS one_meta FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/*/segments_*'), bcmd_oids
WHERE file LIKE '%/engine_v1/' || db || '/' || docs || '/segments_%';
----
one_meta
t


connection holder
query
SELECT pg_backup_start('bcmd') IS NOT NULL AS started;
----
started
t


connection default
statement error
CHECKPOINT;
----
db error: ERROR: cannot checkpoint while a backup is in progress
HINT: Retry after pg_backup_stop().


connection default
statement error
FORCE CHECKPOINT;
----
db error: ERROR: cannot checkpoint while a backup is in progress
HINT: Retry after pg_backup_stop().


connection default
statement ok
INSERT INTO bcmd_docs SELECT i, 'during' FROM range(100, 200) r(i);


connection default
statement ok
VACUUM (REFRESH_TABLE) bcmd_docs;


connection default
query
SELECT count(*) AS metas FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/*/segments_*'), bcmd_oids
WHERE file LIKE '%/engine_v1/' || db || '/' || docs || '/segments_%';
