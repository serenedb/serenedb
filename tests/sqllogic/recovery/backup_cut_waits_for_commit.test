phase
waiting for in-flight commits


connection default
statement ok
SET sdb_faults = 'pause_commit_in_gate:release';


wait


statement ok
RESET sdb_faults;


connection starter
statement ok
CREATE TEMP TABLE bcut_label AS SELECT labelfile FROM pg_backup_stop();


connection starter
query
SELECT regexp_extract(labelfile, 'SERENEDB DATABASE: ' || d.database_oid || ' \d+ (\d+) ', 1)::BIGINT = w.size AS cut_after_commit
FROM bcut_label,
  (SELECT database_oid FROM duckdb_databases() WHERE database_name = current_database()) AS d,
  read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/data.db.wal') AS w
WHERE w.filename LIKE '%/engine_v1/' || d.database_oid || '/data.db.wal';
----
cut_after_commit
t


connection starter
query
SELECT count(*) AS n FROM bcut;
