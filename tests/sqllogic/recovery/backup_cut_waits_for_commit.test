control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE bcut (x BIGINT);


statement ok
INSERT INTO bcut VALUES (1);


statement ok
SET sdb_faults = 'pause_commit_in_gate';


connection committer
statement async ok
INSERT INTO bcut SELECT i FROM range(2, 1000) r(i);


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_commit_in_gate:parked';


connection starter
statement async ok
SELECT pg_backup_start('bcut');


connection default
query ok retry 40 backoff 250ms
SELECT phase FROM pg_stat_progress_basebackup;
