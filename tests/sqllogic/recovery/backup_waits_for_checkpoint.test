connection checkpointer
statement async ok
FORCE CHECKPOINT bwc_db;


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS checkpointing FROM pg_stat_activity
WHERE query LIKE 'FORCE CHECKPOINT bwc_db%' AND state = 'active';
