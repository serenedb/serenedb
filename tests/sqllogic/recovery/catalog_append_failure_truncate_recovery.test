control substitution on

statement ok
CREATE ROLE cwt_r1;


statement ok
CREATE ROLE cwt_r2;


statement ok
CREATE ROLE cwt_r3;


statement ok
SET sdb_faults = 'catalog_append_fails';


statement error
CREATE TABLE cwt_refused (a INTEGER);
