## A statement that creates a table registers the write on its database
## (JoinStoreTransaction -> MetaTransaction::ModifyDatabase with
## CREATE_CATALOG_ENTRY), and that registration is what makes duckdb refuse a
## concurrent non-force CHECKPOINT. Lose it and a checkpoint can run against a
## half-created relation.
##
## The row-write section below is the control: an open transaction that only
## writes rows does NOT block a checkpoint, so the refusal above is the DDL
## registration and not duckdb refusing every open transaction.

# --- DDL: an open CREATE blocks a non-force checkpoint ---

connection writer
statement ok
BEGIN;


connection writer
statement ok
CREATE TABLE cctr_lock_probe(id INTEGER PRIMARY KEY, body TEXT);


connection checkpointer
statement error
CHECKPOINT;
----
db error: ERROR: Cannot CHECKPOINT: there are other write transactions active. Try using FORCE CHECKPOINT to wait until all active transactions are finished


connection writer
statement ok
COMMIT;


connection checkpointer
statement ok
CHECKPOINT;


# --- control: rows alone do not ---

connection writer
statement ok
BEGIN;


connection writer
statement ok
INSERT INTO cctr_lock_probe VALUES (1, 'ok');


connection checkpointer
statement ok
CHECKPOINT;


connection writer
statement ok
COMMIT;


# The PK-index delete path, which fails "0 out of 1" when a create is stranded
# by an overlapping checkpoint.
connection writer
statement ok
DELETE FROM cctr_lock_probe WHERE id = 1;


connection writer
statement ok
DROP TABLE cctr_lock_probe;
