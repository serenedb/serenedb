control substitution on

statement ok
CREATE FUNCTION babsky() RETURNS INTEGER AS 'SELECT 322' LANGUAGE SQL;

statement ok
CREATE FUNCTION clickclack(x INTEGER) RETURNS INTEGER AS 'SELECT x * 2' LANGUAGE SQL;

statement ok
CREATE FUNCTION vedernikoff() RETURNS TABLE(name TEXT, score INTEGER) LANGUAGE SQL
BEGIN ATOMIC
  VALUES ('deadinside', 993), ('kostya', 322);
END;

statement ok
CREATE PROCEDURE pudge_hook(x INTEGER) LANGUAGE SQL AS 'SELECT x';

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT * FROM babsky();
----
babsky
322

connection after_crash
query
SELECT * FROM clickclack(5);
----
clickclack
10

connection after_crash
query
SELECT * FROM vedernikoff() ORDER BY score;
----
name	score
kostya	322
deadinside	993

connection after_crash
query
SELECT proname, prokind, prorettype::regtype::text AS ret, proretset,
       coalesce(pg_get_function_result(oid), 'NULL') AS result
FROM pg_proc
WHERE proname IN ('babsky', 'clickclack', 'vedernikoff', 'pudge_hook')
ORDER BY 1;
----
proname	prokind	ret	proretset	result
babsky	f	integer	f	integer
clickclack	f	integer	f	integer
pudge_hook	p	void	f	NULL
vedernikoff	f	record	t	TABLE(name text, score integer)

connection after_crash
statement ok
DROP PROCEDURE pudge_hook;

connection after_crash
statement ok
DROP FUNCTION babsky;

connection after_crash
statement ok
DROP FUNCTION clickclack;

connection after_crash
statement ok
DROP FUNCTION vedernikoff;
