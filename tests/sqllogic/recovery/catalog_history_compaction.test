control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE chc_sizes (phase TEXT, size BIGINT);


statement ok
CREATE TABLE chc_keep (id SERIAL PRIMARY KEY, v TEXT);


statement ok
CREATE VIEW chc_keep_v AS SELECT id, v FROM chc_keep;


statement ok
CREATE TABLE chc_audit (id INT);


statement ok
CREATE TABLE chc_fired (id INT);


statement ok
CREATE TRIGGER chc_fire AFTER INSERT ON chc_fired FOR EACH ROW INSERT INTO chc_audit VALUES (NEW.id);


statement ok
INSERT INTO chc_keep (v) SELECT 'a' FROM range(10);


statement ok
CHECKPOINT;


statement ok
INSERT INTO chc_sizes SELECT 'base', size FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/log/history');


statement ok
CREATE TABLE chc_stage_1 (a INT, b TEXT);


statement ok
CREATE INDEX chc_stage_1_idx ON chc_stage_1 (b);


statement ok
CREATE TRIGGER chc_stage_1_fire AFTER INSERT ON chc_stage_1 FOR EACH ROW INSERT INTO chc_audit VALUES (NEW.a);


statement ok
INSERT INTO chc_stage_1 VALUES (1, 'x');


statement ok
DROP TABLE chc_stage_1;


statement ok
CREATE TABLE chc_stage_2 (a INT, b TEXT);


