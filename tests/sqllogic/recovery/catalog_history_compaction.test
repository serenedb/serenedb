statement ok
INSERT INTO chc_sizes SELECT 'churn', size FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/log/history');


query
SELECT (SELECT size FROM chc_sizes WHERE phase = 'churn') - (SELECT size FROM chc_sizes WHERE phase = 'base') < 64 AS bounded;
----
bounded
t


statement ok
INSERT INTO chc_fired VALUES (1);


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, max(id) AS last FROM chc_keep;
----
n	last
100010	100010


connection after_crash
query
INSERT INTO chc_keep (v) VALUES ('c') RETURNING id > 100010 AS fresh;
----
fresh
t


