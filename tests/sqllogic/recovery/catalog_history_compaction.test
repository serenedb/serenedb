statement ok
CREATE SEQUENCE chc_db.public.s;


statement ok
DROP DATABASE chc_db;


statement ok
CREATE SECRET chc_secret (TYPE s3, KEY_ID 'k', SECRET 's');


statement ok
DROP SECRET chc_secret;


