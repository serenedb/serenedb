statement ok
CREATE TABLE chf_audit (id INT);


statement ok
CREATE TABLE chf_job_log (id INT);


statement ok
CREATE TRIGGER chf_fire AFTER INSERT ON chf_t FOR EACH ROW INSERT INTO chf_audit VALUES (NEW.id);


statement ok
CREATE SEQUENCE chf_seq;


statement ok
CREATE ROLE chf_role;


statement ok
CREATE VIEW chf_v AS SELECT id, v FROM chf_t;


statement ok
CREATE INDEX chf_idx ON chf_v USING inverted (v);


statement ok
CREATE JOB chf_job AFTER 1 HOUR SUSPENDED AS INSERT INTO chf_job_log VALUES (1);


