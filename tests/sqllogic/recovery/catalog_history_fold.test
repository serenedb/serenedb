INSERT INTO chf_sizes SELECT 'churn', value FROM sdb_metrics WHERE metric = 'catalog_history_bytes';


query
SELECT (SELECT size FROM chf_sizes WHERE phase = 'churn') - (SELECT size FROM chf_sizes WHERE phase = 'base') < 64 AS bounded;
----
bounded
t


statement ok
CREATE TABLE chf_expect AS
SELECT
  (SELECT array_to_string(reloptions, ',') FROM pg_class WHERE relname = 'chf_t') AS t_options,
  (SELECT array_to_string(reloptions, ',') FROM pg_class WHERE relname = 'chf_idx') AS idx_options,
  (SELECT string_agg(column_name || '=' || coalesce(column_default, '-') || '/' || is_nullable, ',' ORDER BY ordinal_position)
   FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'chf_t') AS columns,
  (SELECT tgenabled FROM pg_trigger WHERE tgname = 'chf_fire') AS trigger,
  (SELECT rolconnlimit FROM pg_roles WHERE rolname = 'chf_role') AS connlimit,
  (SELECT rolvaliduntil FROM pg_roles WHERE rolname = 'chf_role') AS valid_until,
  (SELECT rolcanlogin FROM pg_roles WHERE rolname = 'chf_role') AS login,
  (SELECT array_to_string(rolconfig, ',') FROM pg_roles WHERE rolname = 'chf_role') AS config,
  (SELECT schedule || '/' || suspended FROM sdb_jobs() WHERE job_name = 'chf_job') AS job,
  obj_description('chf_t'::regclass, 'pg_class') AS t_comment,
  col_description('chf_t'::regclass, 2) AS v_comment;


query
SELECT connlimit, login, t_comment, v_comment, t_options FROM chf_expect;
----
connlimit	login	t_comment	v_comment	t_options
1004	f	t1004	v1004	compaction_interval=1004


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT
  e.t_options IS NOT DISTINCT FROM s.t_options AS t_options,
  e.idx_options IS NOT DISTINCT FROM s.idx_options AS idx_options,
  e.columns IS NOT DISTINCT FROM s.columns AS columns,
  e.trigger IS NOT DISTINCT FROM s.trigger AS trigger,
  e.connlimit IS NOT DISTINCT FROM s.connlimit AS connlimit,
  e.valid_until IS NOT DISTINCT FROM s.valid_until AS valid_until,
  e.login IS NOT DISTINCT FROM s.login AS login,
  e.config IS NOT DISTINCT FROM s.config AS config,
  e.job IS NOT DISTINCT FROM s.job AS job,
  e.t_comment IS NOT DISTINCT FROM s.t_comment AS t_comment,
  e.v_comment IS NOT DISTINCT FROM s.v_comment AS v_comment
FROM chf_expect e, (SELECT
    (SELECT array_to_string(reloptions, ',') FROM pg_class WHERE relname = 'chf_t') AS t_options,
    (SELECT array_to_string(reloptions, ',') FROM pg_class WHERE relname = 'chf_idx') AS idx_options,
    (SELECT string_agg(column_name || '=' || coalesce(column_default, '-') || '/' || is_nullable, ',' ORDER BY ordinal_position)
     FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'chf_t') AS columns,
    (SELECT tgenabled FROM pg_trigger WHERE tgname = 'chf_fire') AS trigger,
    (SELECT rolconnlimit FROM pg_roles WHERE rolname = 'chf_role') AS connlimit,
    (SELECT rolvaliduntil FROM pg_roles WHERE rolname = 'chf_role') AS valid_until,
    (SELECT rolcanlogin FROM pg_roles WHERE rolname = 'chf_role') AS login,
    (SELECT array_to_string(rolconfig, ',') FROM pg_roles WHERE rolname = 'chf_role') AS config,
    (SELECT schedule || '/' || suspended FROM sdb_jobs() WHERE job_name = 'chf_job') AS job,
    obj_description('chf_t'::regclass, 'pg_class') AS t_comment,
    col_description('chf_t'::regclass, 2) AS v_comment) s;
----
t_options	idx_options	columns	trigger	connlimit	valid_until	login	config	job	t_comment	v_comment
t	t	t	t	t	t	t	t	t	t	t


connection after_crash
