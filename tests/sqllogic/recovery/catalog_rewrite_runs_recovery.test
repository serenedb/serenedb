statement ok
CREATE TEMP TABLE wal_size AS SELECT size AS grown FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/catalog.wal');


connection pudge
statement ok
BEGIN;


connection pudge
statement ok
