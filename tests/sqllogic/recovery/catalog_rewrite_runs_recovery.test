CREATE TABLE donsimon_first (x INT);


connection default
statement ok
SET sdb_faults = '-compact_inside_ddl';


connection default
query
SELECT size > (SELECT grown FROM wal_size) AS deferred FROM read_blob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/catalog.wal');
