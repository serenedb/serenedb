control substitution on

statement ok
CREATE TABLE crd_t (id INTEGER, v INTEGER);


statement ok
INSERT INTO crd_t VALUES (1, 1), (2, 2);


connection t1
statement ok
BEGIN;


connection t1
statement ok
DELETE FROM crd_t WHERE id = 1;


connection t1
statement ok
CREATE TABLE crd_ddl (a INTEGER);


connection t2
statement ok
ALTER TABLE crd_t ADD COLUMN c INTEGER;


connection t1
statement error another transaction has altered this table
COMMIT;


connection t2
query
SELECT (SELECT count(*) FROM crd_t) AS n, (SELECT count(*) FROM duckdb_tables() WHERE table_name = 'crd_ddl') AS t;
----
n	t
2	0


connection t2
statement ok
SET sdb_faults = 'crash_on_packet';


connection t2
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT (SELECT count(*) FROM crd_t) AS n, (SELECT count(*) FROM duckdb_tables() WHERE table_name = 'crd_ddl') AS t;
----
n	t
2	0
