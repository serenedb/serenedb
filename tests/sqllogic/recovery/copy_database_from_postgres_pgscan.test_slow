control substitution on

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS cdpga_${__DATABASE__} (TYPE postgres);

statement ok
CALL postgres_execute('cdpga_${__DATABASE__}', 'CREATE DATABASE cdpgdb_${__DATABASE__}', use_transaction := false);

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=cdpgdb_${__DATABASE__} user=${PGUSER}' AS cdpg_${__DATABASE__} (TYPE postgres);

statement ok
CREATE SCHEMA cdpg_${__DATABASE__}.cdpg_s;

statement ok
CALL postgres_execute('cdpg_${__DATABASE__}', 'CREATE TYPE cdpg_s.pair AS (x int, y text)');

statement ok
CALL postgres_execute('cdpg_${__DATABASE__}', 'CREATE TABLE cdpg_s.t1 (a int, b text)');

statement ok
CALL postgres_execute('cdpg_${__DATABASE__}', 'CREATE TABLE cdpg_s.t2 (id int, p cdpg_s.pair)');

statement ok
CALL postgres_execute('cdpg_${__DATABASE__}', 'INSERT INTO cdpg_s.t1 VALUES (1, ''one''), (2, ''two'')');

statement ok
CALL postgres_execute('cdpg_${__DATABASE__}', 'INSERT INTO cdpg_s.t2 VALUES (1, ROW(3, ''three''))');

statement ok
CALL pg_clear_cache();

query
SELECT type_name, internal FROM duckdb_types() WHERE database_name = 'cdpg_${__DATABASE__}' AND schema_name = 'cdpg_s' ORDER BY type_name;
----
type_name	internal
pair	f
t1	t
t2	t

statement ok
CREATE DATABASE cdpg_dst_${__DATABASE__};

statement ok
COPY FROM DATABASE cdpg_${__DATABASE__} TO cdpg_dst_${__DATABASE__} (SCHEMA);

query
SELECT schema_name FROM duckdb_schemas() WHERE database_name = 'cdpg_dst_${__DATABASE__}' AND schema_name = 'cdpg_s';
----
schema_name
cdpg_s

query
SELECT type_name FROM duckdb_types() WHERE database_name = 'cdpg_dst_${__DATABASE__}' AND schema_name = 'cdpg_s' ORDER BY type_name;
----
type_name
pair

query
SELECT table_name FROM duckdb_tables() WHERE database_name = 'cdpg_dst_${__DATABASE__}' AND schema_name = 'cdpg_s' ORDER BY table_name;
----
table_name
t1
t2

statement ok
DROP DATABASE cdpg_dst_${__DATABASE__};

statement ok
CREATE DATABASE cdpg_dst_${__DATABASE__};

statement ok
COPY FROM DATABASE cdpg_${__DATABASE__} TO cdpg_dst_${__DATABASE__};

query
SELECT a, b FROM cdpg_dst_${__DATABASE__}.cdpg_s.t1 ORDER BY a;
----
a	b
1	one
2	two

query
SELECT id, (p).x AS x, (p).y AS y FROM cdpg_dst_${__DATABASE__}.cdpg_s.t2;
----
id	x	y
1	3	three

statement ok
DROP DATABASE cdpg_dst_${__DATABASE__};

statement ok
DETACH cdpg_${__DATABASE__};

statement ok
CALL postgres_execute('cdpga_${__DATABASE__}', 'DROP DATABASE cdpgdb_${__DATABASE__}', use_transaction := false);

statement ok
DETACH cdpga_${__DATABASE__};
