control substitution on


statement ok
CREATE DATABASE opt_db WITH (BLOCK_SIZE = 16384, ROW_GROUP_SIZE = 1048576);


statement ok
CREATE DATABASE plain_db;


statement ok
SET threads = 1;


statement ok
CREATE TABLE opt_db.public.t AS SELECT i, 'row ' || i AS s FROM range(300000) r(i);


statement ok
CREATE TABLE plain_db.public.t AS SELECT i, 'row ' || i AS s FROM range(300000) r(i);


statement ok
CHECKPOINT opt_db;


statement ok
CHECKPOINT plain_db;


query
SELECT database_name, block_size FROM pragma_database_size()
  WHERE database_name IN ('opt_db', 'plain_db') ORDER BY 1;
----
database_name	block_size
opt_db	16384
plain_db	262144


query
SELECT (SELECT reloptions FROM opt_db.pg_catalog.pg_class WHERE relname = 't') AS opt_options,
       (SELECT reloptions FROM plain_db.pg_catalog.pg_class WHERE relname = 't') AS plain_options;
----
opt_options	plain_options
{row_group_size=1048576,block_size=16384}	NULL


query
SELECT (SELECT max(count) FROM pragma_storage_info('opt_db.public.t') WHERE column_name = 'i') AS opt_rows,
       (SELECT max(count) FROM pragma_storage_info('plain_db.public.t') WHERE column_name = 'i') AS plain_rows,
       (SELECT count(*) FROM pragma_storage_info('opt_db.public.t') WHERE column_name = 's' AND segment_type = 'VARCHAR')
         > 4 * (SELECT count(*) FROM pragma_storage_info('plain_db.public.t') WHERE column_name = 's' AND segment_type = 'VARCHAR') AS opt_cuts_text_finer;
----
opt_rows	plain_rows	opt_cuts_text_finer
300000	122880	t


statement error option "storage_version" not recognized
CREATE DATABASE bad_db WITH (STORAGE_VERSION = 'serenedb_v1');


statement error CREATE DATABASE option "row_group_size" must be a constant
CREATE DATABASE bad_db WITH (ROW_GROUP_SIZE = big);


statement error CREATE DATABASE option "row_group_size" needs a value
CREATE DATABASE bad_db WITH (ROW_GROUP_SIZE);


statement error invalid value for parameter "block_size": "1000" \(must be a power of two from 16384 to 262144\)
CREATE DATABASE bad_db WITH (BLOCK_SIZE = 1000);


statement error invalid value for parameter "row_group_size": "3000" \(must be a positive multiple of the vector size 2048\)
CREATE DATABASE bad_db WITH (ROW_GROUP_SIZE = 3000);


query
SELECT count(*) AS n FROM pg_database WHERE datname = 'bad_db';
----
n
0


statement ok
SET sdb_faults = 'shutdown_on_packet';


statement error connection closed
SELECT 1;


connection after_restart
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_restart
query
SELECT database_name, block_size FROM pragma_database_size()
  WHERE database_name IN ('opt_db', 'plain_db') ORDER BY 1;
----
database_name	block_size
opt_db	16384
plain_db	262144


connection after_restart
statement ok
CREATE TABLE opt_db.public.after AS SELECT i FROM range(300000) r(i);


connection after_restart
statement ok
CREATE TABLE plain_db.public.after AS SELECT i FROM range(300000) r(i);


connection after_restart
statement ok
CHECKPOINT opt_db;


connection after_restart
statement ok
CHECKPOINT plain_db;


connection after_restart
query
SELECT (SELECT reloptions FROM opt_db.pg_catalog.pg_class WHERE relname = 'after') AS opt_options,
       (SELECT reloptions FROM plain_db.pg_catalog.pg_class WHERE relname = 'after') AS plain_options,
       (SELECT count(*) FROM opt_db.public.t) AS opt_rows;
----
opt_options	plain_options	opt_rows
{row_group_size=1048576,block_size=16384}	NULL	300000
