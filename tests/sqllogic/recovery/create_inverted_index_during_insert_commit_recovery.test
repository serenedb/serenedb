4000	4000	800


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM goshandr_chat;
----
n
4000


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) goshandr_chat;


