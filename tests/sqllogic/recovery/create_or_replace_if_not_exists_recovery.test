# ----------------------------------------------------------------------
# 6. The replayed tail checkpointed: a checkpoint written right after
#    replay holds the replayed versions, not the ones they replaced.
# ----------------------------------------------------------------------

connection after_tail
statement ok
FORCE CHECKPOINT;


skipif pg-wire-extended
connection after_tail
statement ok
SET sdb_faults = 'crash_on_packet';


