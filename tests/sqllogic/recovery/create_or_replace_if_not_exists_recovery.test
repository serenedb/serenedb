coinr_trg_ev	coinr_trt3	DELETE
coinr_trg_ine	coinr_trt2	DELETE
coinr_trg_open	coinr_trt_open	DELETE
coinr_trg_rb	coinr_trt	INSERT


# ----------------------------------------------------------------------
# 5. Checkpoint plus WAL tail. Replaces committed after the checkpoint are
#    replayed on top of the checkpointed versions.
# ----------------------------------------------------------------------

connection after_checkpoint
statement ok
CREATE OR REPLACE VIEW coinr_c_v AS SELECT n * 100 AS n FROM coinr_base;


connection after_checkpoint
statement ok
CREATE VIEW IF NOT EXISTS coinr_c_v AS SELECT 0 AS n;


connection after_checkpoint
statement ok
CREATE OR REPLACE TABLE coinr_c_t (b TEXT);


connection after_checkpoint
statement ok
INSERT INTO coinr_c_t VALUES ('tail');


connection after_checkpoint
statement ok
CREATE OR REPLACE MACRO coinr_c_m(x) AS x + 100;


connection after_checkpoint
statement ok
CREATE OR REPLACE SEQUENCE coinr_c_s START 300 INCREMENT 3;


connection after_checkpoint
query
SELECT nextval('coinr_c_s') AS v;
----
v
300


connection after_checkpoint
statement ok
CREATE OR REPLACE TYPE coinr_c_ty AS ENUM ('t1');


connection after_checkpoint
statement ok
CREATE OR REPLACE TRIGGER coinr_c_trg AFTER DELETE ON coinr_c_trt FOR EACH ROW
  INSERT INTO coinr_audit VALUES ('c_v3', OLD.a);


# Skipped creates in the tail write nothing over the tail's replaces.
connection after_checkpoint
statement ok
CREATE MACRO IF NOT EXISTS coinr_c_m(x) AS x + 999;


connection after_checkpoint
statement ok
CREATE SEQUENCE IF NOT EXISTS coinr_c_s START 1;


connection after_checkpoint
statement ok
CREATE TYPE IF NOT EXISTS coinr_c_ty AS ENUM ('skipped');


connection after_checkpoint
statement ok
CREATE TABLE IF NOT EXISTS coinr_c_t (skipped INT);


connection after_checkpoint
statement ok
CREATE TRIGGER IF NOT EXISTS coinr_c_trg AFTER DELETE ON coinr_c_trt FOR EACH ROW
  INSERT INTO coinr_audit VALUES ('c_skipped', OLD.a);


connection after_checkpoint
statement ok
CREATE VIEW IF NOT EXISTS coinr_c_fresh_v AS SELECT 5 AS k;


connection after_checkpoint
statement ok
CREATE OR REPLACE FUNCTION coinr_pf(x INTEGER) RETURNS INTEGER AS 'SELECT x * 6' LANGUAGE SQL;


connection after_checkpoint
statement ok
BEGIN;


connection after_checkpoint
statement ok
CREATE OR REPLACE VIEW coinr_c_v_ine AS SELECT -1 AS n;


connection after_checkpoint
statement ok
ROLLBACK;


# A drop and a create of the same name in one transaction: the create wins.
connection after_checkpoint
statement ok
BEGIN;


connection after_checkpoint
statement ok
DROP TABLE coinr_c_t_ine;


connection after_checkpoint
statement ok
CREATE TABLE coinr_c_t_ine (z TEXT);


connection after_checkpoint
statement ok
INSERT INTO coinr_c_t_ine VALUES ('recreated');


connection after_checkpoint
statement ok
COMMIT;


# A replace followed by a drop in one transaction leaves nothing.
connection after_checkpoint
statement ok
CREATE MACRO coinr_c_m_gone(x) AS x;


connection after_checkpoint
statement ok
BEGIN;


connection after_checkpoint
statement ok
CREATE OR REPLACE MACRO coinr_c_m_gone(x) AS x + 1;


connection after_checkpoint
statement ok
DROP MACRO coinr_c_m_gone;


connection after_checkpoint
statement ok
COMMIT;


connection after_checkpoint
statement ok
CREATE OR REPLACE TABLE coinr_c_st (id INT, body TEXT) WITH (storage = 'search');


connection after_checkpoint
statement ok
INSERT INTO coinr_c_st VALUES (30, 'tail thirty');


connection after_checkpoint
statement ok
VACUUM (REFRESH_TABLE) coinr_c_st;


connection after_checkpoint
statement ok
INSERT INTO coinr_c_st VALUES (31, 'tail thirtyone');


skipif pg-wire-extended
connection after_checkpoint
statement ok
SET sdb_faults = 'crash_on_packet';


skipif pg-wire-extended
connection after_checkpoint
statement error connection closed
SELECT 1;


onlyif pg-wire-extended
connection after_checkpoint
statement error connection closed
SET sdb_faults = 'crash_on_packet';


# --- restart: checkpoint plus the replayed tail ---

connection after_tail
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT n FROM coinr_c_v ORDER BY n;
----
n
100
200
300


connection after_tail
query
WITH seq AS MATERIALIZED (SELECT nextval('coinr_c_s') AS n)
SELECT (SELECT sum(n) FROM coinr_c_v_ine) AS v_ine,
       (SELECT b FROM coinr_c_t) AS t,
       (SELECT z FROM coinr_c_t_ine) AS t_ine,
       coinr_c_m(1) AS m,
       (SELECT n > 300 AND (n - 300) % 3 = 0 FROM seq) AS s,
       array_to_string(enum_range(NULL::coinr_c_ty), ',') AS ty;
----
v_ine	t	t_ine	m	s	ty
6	tail	recreated	101	t	t1


connection after_tail
statement ok
CREATE TABLE coinr_c_s_seen AS SELECT currval('coinr_c_s') AS n;


connection after_tail
query
SELECT count(*) AS c FROM duckdb_functions() WHERE function_name = 'coinr_c_m_gone';
----
c
0


connection after_tail
query
SELECT coinr_pf(5) AS pf, (SELECT k FROM coinr_c_fresh_v) AS fresh,
       (SELECT count(*) FROM pg_proc WHERE proname = 'coinr_pf') AS pf_defs;
----
pf	fresh	pf_defs
30	5	1


connection after_tail
statement count 1
DELETE FROM coinr_c_trt WHERE a = 2;


connection after_tail
query
