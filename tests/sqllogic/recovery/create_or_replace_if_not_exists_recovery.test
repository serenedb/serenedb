# Trigger names are per table, as in PG: OR REPLACE on another table adds a
# second trigger, and a replace can switch a trigger from ROW to STATEMENT.
statement ok
CREATE TABLE coinr_tg_a (a INT);


statement ok
CREATE TABLE coinr_tg_b (a INT);


statement ok
CREATE TRIGGER coinr_tg AFTER INSERT ON coinr_tg_a FOR EACH ROW
  INSERT INTO coinr_fr_audit VALUES ('tg_a_row', NEW.a);


statement ok
CREATE OR REPLACE TRIGGER coinr_tg AFTER INSERT ON coinr_tg_b FOR EACH ROW
  INSERT INTO coinr_fr_audit VALUES ('tg_b_row', NEW.a);


statement ok
CREATE OR REPLACE TRIGGER coinr_tg AFTER INSERT ON coinr_tg_a FOR EACH STATEMENT
  INSERT INTO coinr_fr_audit VALUES ('tg_a_stmt', 0);


