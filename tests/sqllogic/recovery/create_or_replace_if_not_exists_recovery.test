control substitution on

# CREATE OR REPLACE and CREATE ... IF NOT EXISTS across a crash.
#
# A replace is the next version of the entry and a skipped IF NOT EXISTS is no
# version at all, so after a restart the catalog has to hold exactly what was
# committed: the replacing definition when the replace committed, the replaced
# one when it rolled back, failed to commit, or was still open at the crash,
# and the untouched original when IF NOT EXISTS skipped. Every kind is asserted
# once in memory and again after the restart.
#
# The restarts cover both ways the catalog comes back: WAL replay (sections 1
# to 3, and the tail in section 5) and a checkpoint (sections 4 and 6). The two
# commit crash windows sit in between: crash_before_commit loses a whole
# transaction of replaces, crash_after_commit keeps all of it.


statement ok
CREATE ROLE coinr_reader;


statement ok
CREATE TABLE coinr_base (n INT);


statement ok
INSERT INTO coinr_base VALUES (1), (2), (3);


# ----------------------------------------------------------------------
# 1. WAL replay. Views.
# ----------------------------------------------------------------------

# A committed replace keeps the view's oid, comment and grants, as in PG.
statement ok
CREATE VIEW coinr_v AS SELECT n FROM coinr_base;


statement ok
COMMENT ON VIEW coinr_v IS 'kept across replace';


statement ok
GRANT SELECT ON coinr_v TO coinr_reader;


statement ok
CREATE TABLE coinr_v_oid AS SELECT 'coinr_v'::regclass::oid AS o;


statement ok
CREATE OR REPLACE VIEW coinr_v AS SELECT n * 10 AS n, 'second' AS tag FROM coinr_base;


query
SELECT n, tag FROM coinr_v ORDER BY n;
----
n	tag
10	second
20	second
30	second


# A rolled-back replace is visible inside its transaction only.
statement ok
CREATE VIEW coinr_v_rb AS SELECT n FROM coinr_base;


statement ok
BEGIN;


statement ok
CREATE OR REPLACE VIEW coinr_v_rb AS SELECT n * 10 AS n FROM coinr_base;


query
SELECT sum(n) AS s FROM coinr_v_rb;
----
s
60


statement ok
ROLLBACK;


query
SELECT sum(n) AS s FROM coinr_v_rb;
----
s
6


# PG's view column rule refuses a replace that renames or retypes a column.
statement error
CREATE OR REPLACE VIEW coinr_v_rb AS SELECT n AS z FROM coinr_base;
----
db error: ERROR: cannot change name of view column "n" to "z"


statement error
CREATE OR REPLACE VIEW coinr_v_rb AS SELECT 'x' AS n FROM coinr_base;
----
db error: ERROR: cannot change data type of view column "n" from INTEGER to VARCHAR


# IF NOT EXISTS skips an existing view without touching its definition.
statement ok
CREATE VIEW coinr_v_ine AS SELECT n FROM coinr_base;


statement ok
CREATE VIEW IF NOT EXISTS coinr_v_ine AS SELECT n * 10 AS n, 'skipped' AS tag FROM coinr_base;


query
SELECT sum(n) AS s, count(*) AS c FROM coinr_v_ine;
----
s	c
6	3


# Created and replaced again inside one transaction: the last version commits.
statement ok
BEGIN;


statement ok
CREATE OR REPLACE VIEW coinr_v_twice AS SELECT n + 100 AS n FROM coinr_base;


statement ok
CREATE OR REPLACE VIEW coinr_v_twice AS SELECT n + 200 AS n FROM coinr_base;


statement ok
COMMIT;


# A view built on a replaced view reads the new definition.
statement ok
CREATE VIEW coinr_v_inner AS SELECT n FROM coinr_base;


statement ok
CREATE VIEW coinr_v_outer AS SELECT n + 1 AS m FROM coinr_v_inner;


statement ok
CREATE OR REPLACE VIEW coinr_v_inner AS SELECT n * 100 AS n FROM coinr_base;


query
SELECT m FROM coinr_v_outer ORDER BY m;
----
m
101
201
301


# Two writers replacing one view: the second is refused while the first holds
# its version, and only the first reaches the log.
statement ok
CREATE VIEW coinr_v_ww AS SELECT 1 AS k;


connection w1
statement ok
BEGIN;


connection w1
statement ok
CREATE OR REPLACE VIEW coinr_v_ww AS SELECT 2 AS k;


connection w2
statement error
CREATE OR REPLACE VIEW coinr_v_ww AS SELECT 3 AS k;
----
db error: ERROR: Catalog write-write conflict on alter with "coinr_v_ww"


connection w2
query
SELECT k FROM coinr_v_ww;
----
k
1


connection w1
statement ok
COMMIT;


query
SELECT k FROM coinr_v_ww;
----
k
2


