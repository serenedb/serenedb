control substitution on


statement ok
CREATE DATABASE dlc_db;


statement ok
CREATE TABLE dlc_db.public.st(id BIGINT PRIMARY KEY, v INTEGER)
  WITH (compaction_interval = 0);


statement ok
CREATE TABLE dlc_db.public.tt(id INTEGER, v INTEGER);


statement ok
CREATE INDEX tt_inv ON dlc_db.public.tt USING inverted(id, v);


statement ok
INSERT INTO dlc_db.public.tt VALUES (1, 10), (2, 20);


statement ok
CREATE VIEW dlc_db.public.tv AS SELECT id, v FROM dlc_db.public.tt;


statement ok
CREATE INDEX tv_inv ON dlc_db.public.tv USING inverted(id, v);


statement ok
INSERT INTO dlc_db.public.st VALUES (1, 10), (2, 20);


statement ok
VACUUM (FLUSH_ALL);


statement ok
CHECKPOINT dlc_db;


statement ok
CREATE TABLE dlc_oids AS
  SELECT 'db' AS name, oid FROM pg_database WHERE datname = 'dlc_db'
  UNION ALL
  SELECT table_name, table_oid FROM sdb_tables()
  WHERE database_name = 'dlc_db' AND table_name IN ('st', 'tt')
  UNION ALL
  SELECT index_name, index_oid FROM sdb_indexes()
  WHERE database_name = 'dlc_db' AND index_name IN ('tt_inv', 'tv_inv');


# The files in the store, and those the tables and indexes of this database
# own: the rest belong to another database or to no object at all.
statement ok
CREATE MACRO dlc_files() AS (
  SELECT count(*) FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/store/*'));


statement ok
CREATE MACRO dlc_owned() AS (
  SELECT coalesce(sum(value), 0) FROM sdb_metrics WHERE metric = 'num_files');


query
SELECT name, (SELECT coalesce(sum(value), 0) FROM dlc_db.pg_catalog.sdb_metrics m
              WHERE m.metric = 'num_files' AND m.relation_id = o.oid) > 0 AS stored
FROM dlc_oids o WHERE name <> 'db' ORDER BY name;
----
name	stored
st	t
tt	t
tt_inv	f
tv_inv	t


statement ok
SET sdb_faults = 'crash_on_drop';


statement error connection closed
DROP INDEX dlc_db.public.tt_inv;


connection after_index_drop
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS indexes FROM sdb_indexes() WHERE database_name = 'dlc_db';
----
indexes
1


connection after_index_drop
statement ok
SET sdb_faults = 'crash_on_drop';


connection after_index_drop
statement error connection closed
DROP TABLE dlc_db.public.st;


connection after_table_drop
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS tables FROM sdb_tables() WHERE database_name = 'dlc_db' AND table_name = 'st';
----
tables
0


connection after_table_drop
query
SELECT dlc_files() - dlc_owned()
       - (SELECT coalesce(sum(value), 0) FROM dlc_db.pg_catalog.sdb_metrics WHERE metric = 'num_files') AS leftover;
----
leftover
0


# A search table whose CREATE crashed before its commit: nothing owns what it
# wrote after the boot.
connection after_table_drop
statement ok
SET sdb_faults = 'crash_before_catalog_commit';


connection after_table_drop
statement error connection closed
CREATE TABLE dlc_db.public.lost(id BIGINT PRIMARY KEY, v INTEGER)
  WITH (compaction_interval = 0);


connection after_lost_create
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS tables FROM sdb_tables() WHERE database_name = 'dlc_db' AND table_name = 'lost';
----
tables
0


connection after_lost_create
query
SELECT dlc_files() - dlc_owned()
       - (SELECT coalesce(sum(value), 0) FROM dlc_db.pg_catalog.sdb_metrics WHERE metric = 'num_files') AS leftover;
----
leftover
0


# A DROP INDEX left open while the database is dropped: the database commits
# first, the index's transaction fails, and all the database's files go.
connection racer
statement ok
BEGIN;


connection racer
statement ok
DROP INDEX dlc_db.public.tv_inv;


connection dropper
statement ok
DROP DATABASE dlc_db;


# The racer still holds the database, so its files stay until it lets go.
connection dropper
query
SELECT dlc_files() - dlc_owned() > 0 AS held;
----
held
t


connection racer
statement error
COMMIT;
----
db error: ERROR: database "dlc_db" was dropped by another transaction


connection dropper
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT dlc_files() - dlc_owned() AS leftover;
----
leftover
0


# A committed DROP DATABASE cut off by a crash before its removal.
connection dropper
statement ok
CREATE DATABASE dlc_db2;


connection dropper
statement ok
CREATE TABLE dlc_db2.public.st(id BIGINT PRIMARY KEY, v INTEGER)
  WITH (compaction_interval = 0);


connection dropper
statement ok
INSERT INTO dlc_db2.public.st VALUES (1, 10);


connection dropper
statement ok
VACUUM (FLUSH_TABLE) dlc_db2.public.st;


connection dropper
query
SELECT dlc_files() - dlc_owned() > 0 AS stored;
----
stored
t


connection dropper
statement ok
SET sdb_faults = 'crash_on_drop';


connection dropper
statement error connection closed
DROP DATABASE dlc_db2;


connection after_database_drop
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS databases FROM pg_database WHERE datname = 'dlc_db2';
----
databases
0


connection after_database_drop
query
SELECT dlc_files() - dlc_owned() AS leftover;
----
leftover
0


connection after_database_drop
statement ok
DROP TABLE dlc_oids;
