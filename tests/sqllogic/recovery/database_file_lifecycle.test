control substitution on


statement ok
CREATE DATABASE dbfile_keep;


# CREATE DATABASE is the one statement whose entries do not all belong to the
# transaction that made them: the attach happens before the entry install can
# reach it, so the schemas it seeds -- public -- are written with a system
# transaction and are committed the moment they are made. Nothing hides them,
# and nothing has to: they live in the new attachment, and rolling back takes
# the whole attachment away with them.
statement ok
BEGIN;


statement ok
CREATE DATABASE dbfile_rolled;


# Inside the transaction the attachment is real and the database entry is in
# the set, so the schemas seeded on it have somewhere to be.
query
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'dbfile_rolled';
----
count
1


query
SELECT entry_type, name FROM sdb_catalog_sets() WHERE name = 'dbfile_rolled';
----
entry_type	name
Database	dbfile_rolled


statement ok
ROLLBACK;


query
SELECT count(*) FROM pg_database WHERE datname = 'dbfile_rolled';
----
count
0


# The attachment went with it, which is what makes the system-transaction
# schemas unreachable rather than merely invisible.
query
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'dbfile_rolled';
----
count
0


query
SELECT count(*) FROM sdb_catalog_sets() WHERE name = 'dbfile_rolled';
----
count
0


# The name is free again: nothing of the rolled back attempt is holding it.
statement ok
CREATE DATABASE dbfile_rolled;


statement ok
DROP DATABASE dbfile_rolled;


statement ok
SET sdb_faults = 'crash_after_catalog_before_data';


statement error connection closed
CREATE DATABASE dbfile_crashed;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;
----
?column?
1


connection after_crash
query
SELECT datname FROM pg_database WHERE datname LIKE 'dbfile_%' ORDER BY datname;
----
datname
dbfile_crashed
dbfile_keep


# The rolled back one did not come back with the boot either: the log never
# carried it, so there is no record to replay and no attachment to rebuild.
connection after_crash
query
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'dbfile_rolled';
----
count
0


connection after_crash
query
SELECT count(*) AS orphans FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/store/*/*')
WHERE regexp_extract(file, '/engine_v1/store/([0-9]+)/', 1)::BIGINT NOT IN (
  SELECT table_oid FROM duckdb_tables() UNION ALL SELECT index_oid FROM duckdb_indexes());
----
orphans
0


connection after_crash
statement ok
SET sdb_faults = 'crash_on_drop';


connection after_crash
statement error connection closed
DROP DATABASE dbfile_crashed;


connection after_drop_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT datname FROM pg_database WHERE datname LIKE 'dbfile_%' ORDER BY datname;
----
datname
dbfile_keep


connection after_drop_crash
query
SELECT count(*) AS orphans FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/store/*/*')
WHERE regexp_extract(file, '/engine_v1/store/([0-9]+)/', 1)::BIGINT NOT IN (
  SELECT table_oid FROM duckdb_tables() UNION ALL SELECT index_oid FROM duckdb_indexes());
----
orphans
0


connection after_drop_crash
statement ok
DROP DATABASE IF EXISTS dbfile_keep;
