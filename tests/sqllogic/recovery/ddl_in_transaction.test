# ----------------------------------------------------------------------
# DDL inside explicit transaction blocks, PostgreSQL 18 semantics: a
# transaction's catalog changes are visible to that transaction and to nobody
# else until it commits, and a ROLLBACK leaves no trace of them.
#
# Both relation shapes are asserted, because they used to fail differently
# under the old statement-committed DDL: a rolled-back facade table left a
# pg_class row naming a store table that had rolled back with the statement
# (`Table with name t<id> does not exist!` on any read), while a rolled-back
# search table left a readable, empty one -- it owns its storage and has no
# store table to be missing.
#
# Hosted under recovery/ because the cross-session assertions below need a
# server nobody else is creating objects on; that harness runs each file
# against its own serened instance.
# ----------------------------------------------------------------------


# ----------------------------------------------------------------------
# Facade table: ROLLBACK
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_t1(id INTEGER PRIMARY KEY, v INTEGER);


# The transaction sees its own DDL.
statement ok
INSERT INTO ddl_txn_t1 VALUES (1, 10);


query
SELECT count(*) AS n FROM ddl_txn_t1;
----
n
1


query
SELECT count(*) AS n FROM pg_class WHERE relname = 'ddl_txn_t1';
----
n
1


statement ok
ROLLBACK;


# Nothing survived: no relation, no rows, and no pg_class row.
query
SELECT count(*) AS n FROM pg_class WHERE relname = 'ddl_txn_t1';
----
n
0


statement error
SELECT count(*) FROM ddl_txn_t1;
----
db error: ERROR: Table with name ddl_txn_t1 does not exist!
<slt:ignore>


# ----------------------------------------------------------------------
# Facade table: COMMIT
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_t2(id INTEGER PRIMARY KEY, v INTEGER);


statement ok
INSERT INTO ddl_txn_t2 VALUES (1, 10);


statement ok
COMMIT;


query
SELECT id, v FROM ddl_txn_t2;
----
id	v
1	10


# ----------------------------------------------------------------------
# Search table: ROLLBACK. The shape that used to leave a readable, empty
# table behind rather than an unusable one.
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_s1(id INTEGER, body TEXT) WITH (storage = 'search');


statement ok
INSERT INTO ddl_txn_s1 VALUES (1, 'hello');


query
SELECT count(*) AS n FROM pg_class WHERE relname = 'ddl_txn_s1';
----
n
1


statement ok
ROLLBACK;


query
SELECT count(*) AS n FROM pg_class WHERE relname = 'ddl_txn_s1';
----
n
0


statement error
SELECT count(*) FROM ddl_txn_s1;
----
db error: ERROR: Table with name ddl_txn_s1 does not exist!
<slt:ignore>


# ----------------------------------------------------------------------
# Search table: COMMIT
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_s2(id INTEGER, body TEXT) WITH (storage = 'search');


statement ok
INSERT INTO ddl_txn_s2 VALUES (1, 'hello');


statement ok
COMMIT;


# The search leg is eventually consistent, so the definition is what this
# asserts; the rows are covered by the search suites.
query
SELECT count(*) AS n FROM pg_class WHERE relname = 'ddl_txn_s2';
----
n
1


# ----------------------------------------------------------------------
# An owned sequence created with its table resolves inside the transaction.
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_t3(id SERIAL, v TEXT);


statement ok
INSERT INTO ddl_txn_t3(v) VALUES ('a'), ('b');


statement ok
COMMIT;


query
SELECT id, v FROM ddl_txn_t3 ORDER BY id;
----
id	v
1	a
2	b


# ----------------------------------------------------------------------
# Create and cascade-drop inside one transaction: the dependency edge of an
# object this transaction created is its own to see.
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_t4(id INTEGER);


statement ok
CREATE VIEW ddl_txn_v4 AS SELECT id FROM ddl_txn_t4;


statement ok
DROP TABLE ddl_txn_t4 CASCADE;


statement ok
COMMIT;


query
SELECT count(*) AS n
FROM pg_class WHERE relname IN ('ddl_txn_t4', 'ddl_txn_v4');
----
n
0


# ----------------------------------------------------------------------
# Nobody else sees an uncommitted CREATE.
# ----------------------------------------------------------------------

statement ok
BEGIN;


statement ok
CREATE TABLE ddl_txn_vis(id INTEGER);


statement ok
INSERT INTO ddl_txn_vis VALUES (1);


connection observer
query
SELECT count(*) AS n FROM pg_class WHERE relname = 'ddl_txn_vis';
----
n
0


connection observer
statement error
SELECT count(*) FROM ddl_txn_vis;
----
db error: ERROR: Table with name ddl_txn_vis does not exist!
<slt:ignore>


statement ok
COMMIT;


connection observer
query
SELECT count(*) AS n FROM ddl_txn_vis;
----
n
1


# ----------------------------------------------------------------------
# Nobody else sees an uncommitted DROP, and ROLLBACK undoes it.
# ----------------------------------------------------------------------

statement ok
CREATE TABLE ddl_txn_drp(id INTEGER);


statement ok
INSERT INTO ddl_txn_drp VALUES (1);


statement ok
BEGIN;


statement ok
DROP TABLE ddl_txn_drp;


# Gone for this transaction ...
statement error
SELECT count(*) FROM ddl_txn_drp;
----
db error: ERROR: Table with name ddl_txn_drp does not exist!
<slt:ignore>


# ... and untouched for everybody else.
connection observer
query
SELECT count(*) AS n FROM ddl_txn_drp;
----
n
1


statement ok
ROLLBACK;


query
SELECT count(*) AS n FROM ddl_txn_drp;
----
n
1
