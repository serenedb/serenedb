control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE SCHEMA dm;


statement ok
CREATE ROLE dm_reader;


statement ok
CREATE TABLE dm.plain (a INT, b TEXT);


statement ok
CREATE TABLE dm.pk (id INT PRIMARY KEY, v TEXT);


statement ok
CREATE TABLE dm.uq (id INT, code TEXT UNIQUE);


statement ok
CREATE TABLE dm.parent (id INT PRIMARY KEY, name TEXT);


statement ok
CREATE TABLE dm.child (id INT PRIMARY KEY, parent_id INT REFERENCES dm.parent (id));


statement ok
CREATE TABLE dm.sec (a INT, b TEXT);


statement ok
CREATE INDEX dm_sec_a ON dm.sec (a);


statement ok
CREATE TABLE dm.inv (a INT, body TEXT);


statement ok
CREATE INDEX dm_inv_body ON dm.inv USING inverted (body);


statement ok
CREATE TABLE dm.ser (id SERIAL PRIMARY KEY, v TEXT);


statement ok
CREATE TABLE dm.st (id BIGINT PRIMARY KEY, body TEXT) WITH (storage = 'search');


statement ok
CREATE TABLE dm.st_inv (a INT, body TEXT) WITH (storage = 'search');


statement ok
CREATE INDEX dm_st_inv_body ON dm.st_inv USING inverted (body);


statement ok
CREATE TABLE IF NOT EXISTS dm.pk (other INT);


statement ok
CREATE INDEX IF NOT EXISTS dm_sec_a ON dm.sec (b);


statement ok
CREATE INDEX IF NOT EXISTS dm_inv_body ON dm.inv USING inverted (body);


