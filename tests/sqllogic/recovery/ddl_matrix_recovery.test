INSERT INTO dm.ser (v) VALUES ('s1'), ('s2'), ('s3');


statement ok
INSERT INTO dm.st VALUES (1, 'search one'), (2, 'search two');


statement ok
INSERT INTO dm.st_inv VALUES (1, 'indexed one'), (2, 'indexed two');


statement ok
ALTER TABLE dm.plain ADD COLUMN c INT DEFAULT 7;


statement ok
ALTER TABLE dm.plain RENAME COLUMN b TO b2;


statement ok
ALTER TABLE dm.plain ALTER COLUMN a TYPE BIGINT;


statement ok
ALTER TABLE dm.plain ALTER COLUMN a SET NOT NULL;


statement ok
COMMENT ON COLUMN dm.plain.b2 IS 'renamed';


statement ok
ALTER TABLE dm.plain RENAME TO plain2;


statement ok
ALTER TABLE dm.pk ADD CONSTRAINT pk_v_short CHECK (length(v) < 10);


statement ok
ALTER TABLE dm.pk ALTER COLUMN v SET DEFAULT 'dflt';


statement ok
ALTER TABLE dm.pk ADD COLUMN w INT;


statement ok
ALTER TABLE dm.pk DROP COLUMN w;


statement ok
COMMENT ON TABLE dm.uq IS 'unique codes';


statement ok
GRANT SELECT ON dm.uq TO dm_reader;


statement ok
TRUNCATE dm.parent CASCADE;


statement ok
INSERT INTO dm.parent VALUES (3, 'p3');


statement ok
INSERT INTO dm.child VALUES (30, 3);


statement ok
DROP INDEX IF EXISTS dm.dm_sec_missing;


statement ok
CREATE INDEX dm_sec_b ON dm.sec (b);


statement ok
ALTER INDEX dm.dm_inv_body SET (refresh_interval = 500);


statement ok
ALTER TABLE dm.inv RENAME COLUMN a TO a2;


statement ok
TRUNCATE dm.ser RESTART IDENTITY;


statement ok
INSERT INTO dm.ser (v) VALUES ('r1'), ('r2');


statement ok
ALTER TABLE dm.st ALTER COLUMN body SET DEFAULT 'none';


statement ok
COMMENT ON COLUMN dm.st.body IS 'search body';


statement ok
ALTER TABLE dm.st RENAME COLUMN body TO text_body;


statement ok
BEGIN;


statement ok
ALTER TABLE dm.uq ADD COLUMN extra TEXT DEFAULT 'e';


statement ok
ALTER TABLE dm.uq ALTER COLUMN extra DROP DEFAULT;


statement ok
CREATE INDEX dm_uq_extra ON dm.uq (extra);


statement ok
ALTER TABLE dm.sec RENAME TO sec2;


statement ok
REVOKE SELECT ON dm.uq FROM dm_reader;


statement ok
GRANT INSERT ON dm.uq TO dm_reader;


statement ok
