query
SELECT table_name, column_name, data_type, is_nullable, column_default FROM information_schema.columns
WHERE table_schema = 'dm' ORDER BY table_name, ordinal_position;
----
table_name	column_name	data_type	is_nullable	column_default
child	id	integer	NO	NULL
child	parent_id	integer	YES	NULL
inv	a2	integer	YES	NULL
inv	body	text	YES	NULL
parent	id	integer	NO	NULL
parent	name	text	YES	NULL
pk	id	integer	NO	NULL
pk	v	text	YES	'dflt'
plain2	a	bigint	NO	NULL
plain2	b2	text	YES	NULL
plain2	c	integer	YES	7
sec2	a	integer	YES	NULL
sec2	b	text	YES	NULL
ser	id	integer	NO	nextval('ser_id_seq')
ser	v	text	YES	NULL
st	id	bigint	NO	NULL
st	text_body	text	YES	'none'
st_inv	a	integer	NO	NULL
st_inv	body	text	YES	NULL
uq	id	integer	YES	NULL
uq	code	text	YES	NULL
uq	extra	text	YES	NULL


query
SELECT conrelid::regclass::text AS rel, conname, contype FROM pg_constraint
WHERE connamespace = 'dm'::regnamespace ORDER BY 1, 2;
----
rel	conname	contype
child	child_id_not_null	n
child	child_parent_id_fkey	f
child	child_pkey	p
parent	parent_id_not_null	n
parent	parent_pkey	p
pk	pk_id_not_null	n
pk	pk_pkey	p
pk	pk_v_short	c
plain2	plain2_a_not_null	n
ser	ser_id_not_null	n
ser	ser_pkey	p
st	st_id_not_null	n
st	st_pkey	p
st_inv	st_inv_a_not_null	n
uq	uq_code_key	u


query
SELECT index_name, table_name FROM duckdb_indexes() WHERE schema_name = 'dm' ORDER BY 1;
----
index_name	table_name
dm_inv_body	inv
dm_sec_a	sec2
dm_sec_b	sec2
dm_st_inv_body	st_inv
dm_uq_extra	uq


query
SELECT c.relname, d.objsubid, d.description FROM pg_description d JOIN pg_class c ON c.oid = d.objoid
WHERE c.relnamespace = 'dm'::regnamespace ORDER BY 1, 2;
----
relname	objsubid	description
plain2	2	renamed
st	2	search body
uq	0	unique codes


query
SELECT has_table_privilege('dm_reader', 'dm.uq', 'SELECT') AS sel, has_table_privilege('dm_reader', 'dm.uq', 'INSERT') AS ins;
----
sel	ins
f	t


query
SELECT (SELECT count(*) FROM dm.plain2) AS plain, (SELECT count(*) FROM dm.pk) AS pk, (SELECT count(*) FROM dm.uq) AS uq,
       (SELECT count(*) FROM dm.parent) AS parent, (SELECT count(*) FROM dm.child) AS child,
       (SELECT count(*) FROM dm.sec2) AS sec, (SELECT count(*) FROM dm.inv) AS inv, (SELECT count(*) FROM dm.ser) AS ser,
       (SELECT count(*) FROM dm.st) AS st, (SELECT count(*) FROM dm.st_inv) AS st_inv;
----
plain	pk	uq	parent	child	sec	inv	ser	st	st_inv
2	2	3	1	1	100	100	3	2	2


