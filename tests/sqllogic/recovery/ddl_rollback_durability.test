# ----------------------------------------------------------------------
# A crash inside the transaction, with no ROLLBACK to undo anything: the
# frame has to have never been appended, not merely withheld from the
# resident maps.
# ----------------------------------------------------------------------

connection after_crash
statement ok
CREATE SCHEMA rbd_crash_keep;


connection after_crash
statement ok
BEGIN;


connection after_crash
statement ok
CREATE SCHEMA rbd_crash_s;


connection after_crash
statement ok
CREATE VIEW rbd_crash_v AS SELECT 1 AS a;


connection after_crash
statement ok
CREATE ROLE rbd_crash_r;


connection after_crash
statement ok
SET sdb_faults = 'crash_on_packet';


connection after_crash
statement error connection closed
