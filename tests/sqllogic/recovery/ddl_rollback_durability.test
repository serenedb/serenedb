# Default privileges are role state, so a rolled-back ALTER DEFAULT
# PRIVILEGES must leave no row and the committed one exactly one.
connection after_crash
query
SELECT pg_get_userbyid(defaclrole) AS role, defaclobjtype AS objtype,
       array_to_string(defaclacl, '|') AS acl
FROM pg_default_acl
WHERE pg_get_userbyid(defaclrole) IN ('rbd_owner', 'rbd_grantee')
ORDER BY 1;
----
role	objtype	acl
rbd_owner	r	rbd_owner=arwdDxtm/rbd_owner|rbd_grantee=r/rbd_owner


