control substitution on

statement ok
CREATE TABLE beast_checkpointed (title varchar(67), code char(6), meta jsonb, views numeric, bio text, handle varchar(20) COLLATE "C", flags bit(6), seen timestamp(3));


statement ok
FORCE CHECKPOINT;


statement ok
CREATE TABLE beast_logged (title varchar(67), code char(6), meta jsonb, views numeric, bio text, handle varchar(20) COLLATE "C", flags bit(6), seen timestamp(3));


statement ok
ALTER TABLE beast_logged ALTER COLUMN bio TYPE varchar(76);


statement ok
ALTER TABLE beast_logged ADD COLUMN feastables jsonb;


statement ok
