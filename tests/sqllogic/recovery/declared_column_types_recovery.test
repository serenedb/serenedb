query
SELECT attname, format_type(atttypid, atttypmod) AS type
FROM pg_attribute
WHERE attrelid = 'dctr_logged'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type
v	character varying(10)
c	character(3)
j	jsonb
n	numeric
t	character varying(20)
added	jsonb
