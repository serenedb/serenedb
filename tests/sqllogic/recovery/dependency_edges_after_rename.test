control substitution on

# A dependency edge used to be re-derived at boot by resolving the dependent's
# stored SQL text by name. A rename moves that name, so every edge pointing at
# a renamed object came back missing: RESTRICT let the drop through and CASCADE
# left the dependent behind in pg_class. The resolution now travels with the
# definition, so boot installs ids instead of resolving names again.
#
# duckdb refuses to rename an object that something else depends on, so the
# renames here are the ones it allows: the dependent side of an edge, and a
# table whose only dependent is an index. Each pair has a control that is never
# renamed.

statement ok
CREATE SCHEMA dre;


# table <- view
statement ok
CREATE TABLE dre.t(a INTEGER);

statement ok
CREATE VIEW dre.v AS SELECT a FROM dre.t;

statement ok
CREATE TABLE dre.ct(a INTEGER);

statement ok
CREATE VIEW dre.cv AS SELECT a FROM dre.ct;


# The table cannot move while the view reads it.
statement error
ALTER TABLE dre.t RENAME TO t2;
----
db error: ERROR: Cannot alter entry "t" because there are entries that depend on it.<slt:ignore>


statement ok
ALTER VIEW dre.v RENAME TO v2;


# view <- view
statement ok
CREATE VIEW dre.vbase AS SELECT 1 AS x;

statement ok
CREATE VIEW dre.vtop AS SELECT x FROM dre.vbase;

statement error
ALTER VIEW dre.vbase RENAME TO vbase2;
----
db error: ERROR: Cannot alter entry "vbase" because there are entries that depend on it.<slt:ignore>


statement ok
ALTER VIEW dre.vtop RENAME TO vtop2;


# function <- view
statement ok
CREATE FUNCTION dre.f(i INTEGER) RETURNS INTEGER AS 'SELECT i + 1' LANGUAGE SQL;

statement ok
CREATE VIEW dre.fv AS SELECT dre.f(1) AS y;

statement error
ALTER FUNCTION dre.f RENAME TO f2;
----
db error: ERROR: Cannot alter entry "f" because there are entries that depend on it.<slt:ignore>


statement ok
ALTER VIEW dre.fv RENAME TO fv2;


# sequence <- column DEFAULT, where it is the dependent table that is renamed
statement ok
CREATE SEQUENCE dre.s;

statement ok
CREATE TABLE dre.st(a INTEGER DEFAULT nextval('dre.s'));

statement ok
ALTER TABLE dre.st RENAME TO st2;


# table <- index, where the table is renamed: an index reads its table by
# entry, so duckdb lets the rename through
statement ok
CREATE TABLE dre.it(a INTEGER);

statement ok
CREATE INDEX it_idx ON dre.it(a);

statement ok
ALTER TABLE dre.it RENAME TO it2;


# The edges hold before the restart -- they always did.
statement error
DROP TABLE dre.t;
----
db error: ERROR: Cannot drop entry "t" because there are entries that depend on it.
view "v2" depends on table "t".
Use DROP...CASCADE to drop all dependents.


statement error
DROP VIEW dre.vbase;
----
db error: ERROR: Cannot drop entry "vbase" because there are entries that depend on it.
view "vtop2" depends on view "vbase".
Use DROP...CASCADE to drop all dependents.


statement error
DROP FUNCTION dre.f;
----
db error: ERROR: Cannot drop entry "f" because there are entries that depend on it.
view "fv2" depends on macro function "f".
Use DROP...CASCADE to drop all dependents.


statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;


# Everything above, again, on a catalog that was rebuilt from the log.
connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM pg_class WHERE relname IN ('v2', 'cv', 'vtop2', 'fv2', 'st2');
----
count
5

connection after_crash
statement error
DROP TABLE dre.t;
----
db error: ERROR: Cannot drop entry "t" because there are entries that depend on it.
view "v2" depends on table "t".
Use DROP...CASCADE to drop all dependents.


# The control, which was never renamed and never lost its edge.
connection after_crash
statement error
DROP TABLE dre.ct;
----
db error: ERROR: Cannot drop entry "ct" because there are entries that depend on it.
view "cv" depends on table "ct".
Use DROP...CASCADE to drop all dependents.


connection after_crash
statement error
DROP VIEW dre.vbase;
----
db error: ERROR: Cannot drop entry "vbase" because there are entries that depend on it.
view "vtop2" depends on view "vbase".
Use DROP...CASCADE to drop all dependents.


connection after_crash
statement error
DROP FUNCTION dre.f;
----
db error: ERROR: Cannot drop entry "f" because there are entries that depend on it.
view "fv2" depends on macro function "f".
Use DROP...CASCADE to drop all dependents.


# The renamed table kept the edge to the sequence its DEFAULT reads.
connection after_crash
statement error
DROP SEQUENCE dre.s;
----
db error: ERROR: Cannot drop entry "s" because there are entries that depend on it.
table "st2" depends on sequence "s".
Use DROP...CASCADE to drop all dependents.


# The index still hangs off the renamed table, so the table's drop takes it and
# nothing is left behind.
connection after_crash
query ok
SELECT indexname FROM pg_indexes WHERE tablename = 'it2';
----
indexname
it_idx

connection after_crash
statement ok
DROP TABLE dre.it2;

connection after_crash
query ok
SELECT count(*) FROM pg_class WHERE relname = 'it_idx';
----
count
0


# CASCADE removes the dependent rather than leaving it dangling.
connection after_crash
statement ok
DROP TABLE dre.t CASCADE;

connection after_crash
query ok
SELECT count(*) FROM pg_class WHERE relname = 'v2';
----
count
0

connection after_crash
statement ok
DROP VIEW dre.vbase CASCADE;

connection after_crash
query ok
SELECT count(*) FROM pg_class WHERE relname = 'vtop2';
----
count
0

connection after_crash
statement ok
DROP FUNCTION dre.f CASCADE;

connection after_crash
query ok
SELECT count(*) FROM pg_class WHERE relname = 'fv2';
----
count
0

connection after_crash
statement ok
DROP SEQUENCE dre.s CASCADE;


connection after_crash
statement ok
CREATE SEQUENCE dre.gs;

connection after_crash
statement ok
SET sdb_faults = 'crash_after_search_commit';

connection after_crash
statement error connection closed
CREATE TABLE dre.gt(a INTEGER DEFAULT nextval('dre.gs'), b TEXT);

connection after_gap
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM pg_class WHERE relname = 'gt';
----
count
1

connection after_gap
statement ok
INSERT INTO dre.gt(b) VALUES ('one'), ('two');

connection after_gap
query ok
SELECT a, b FROM dre.gt ORDER BY a;
----
a	b
1	one
2	two

connection after_gap
statement error
DROP SEQUENCE dre.gs;
----
db error: ERROR: Cannot drop entry "gs" because there are entries that depend on it.
table "gt" depends on sequence "gs".
Use DROP...CASCADE to drop all dependents.



# A checkpoint rewrites the whole file from the catalog's own definitions, so
# the resolution recorded beside each one has to go out with it again.
connection after_gap
statement ok
CREATE TABLE dre.pt(a INTEGER);

connection after_gap
statement ok
CREATE VIEW dre.pv AS SELECT a FROM dre.pt;

connection after_gap
statement ok
ALTER VIEW dre.pv RENAME TO pv2;

connection after_gap
statement ok
CREATE TABLE dre.compact_trigger(x INTEGER);

connection after_gap
statement ok
CHECKPOINT;

connection after_gap
statement ok
SET sdb_faults = 'crash_on_packet';

connection after_gap
statement error connection closed
SELECT 1;


connection after_compact
statement error retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
DROP TABLE dre.pt;
----
db error: ERROR: Cannot drop entry "pt" because there are entries that depend on it.
view "pv2" depends on table "pt".
Use DROP...CASCADE to drop all dependents.


connection after_compact
statement ok
DROP SCHEMA dre CASCADE;
