# dict_fsst segment sizing: one long row in a column of short repeated values.
#
# A long row adds its own bytes and widens the length of every entry of its segment. The segment is
# not cut for it: a text segment is as long as its codec needs.
#
# Shape: 48,000 rows over 24,000 pseudo-random 6-char values (each twice, consecutively), then one
# 16,000-char pseudo-random printable row, then 2,000 more short rows. Default row groups (one row
# group), default block size. Deterministic: single source, ORDER BY.

control substitution on


statement ok
SET threads = 1;


statement ok
CREATE DATABASE dfel;


statement ok
SET force_compression='dict_fsst';


statement ok
CREATE TABLE dfel.t AS
  SELECT ord,
    CASE WHEN ord = 48000 THEN
      (SELECT string_agg(chr((32 + (hash(48000 * 16384 + i) % 95))::INTEGER), '' ORDER BY i) FROM range(16000) r(i))
    ELSE
      substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 0) % 62)::INTEGER, 1)
      || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 1) % 62)::INTEGER, 1)
      || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 2) % 62)::INTEGER, 1)
      || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 3) % 62)::INTEGER, 1)
      || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 4) % 62)::INTEGER, 1)
      || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 5) % 62)::INTEGER, 1)
    END AS s
  FROM range(50001) t(ord) ORDER BY ord;


statement ok
CHECKPOINT dfel;


# every row survived with its exact value
query
SELECT count(*) AS n, max(length(s)) AS max_len,
       bool_and(s = CASE WHEN ord = 48000 THEN
         (SELECT string_agg(chr((32 + (hash(48000 * 16384 + i) % 95))::INTEGER), '' ORDER BY i) FROM range(16000) r(i))
       ELSE
         substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 0) % 62)::INTEGER, 1)
         || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 1) % 62)::INTEGER, 1)
         || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 2) % 62)::INTEGER, 1)
         || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 3) % 62)::INTEGER, 1)
         || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 4) % 62)::INTEGER, 1)
         || substr('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', (1 + hash((ord // 2) * 6 + 5) % 62)::INTEGER, 1)
       END) AS rows_match
  FROM dfel.t;
----
n	max_len	rows_match
50001	16000	t


# dict_fsst took the column, and one segment holds every row, the long one included
query
SELECT (SELECT count(*) > 0 FROM pragma_storage_info('dfel.t', include_segment_info=true)
         WHERE column_name='s' AND compression='DICT_FSST') AS has_dict_fsst,
       (SELECT count FROM pragma_storage_info('dfel.t', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR' ORDER BY row_group_id, segment_id LIMIT 1) AS first_segment_rows;
----
has_dict_fsst	first_segment_rows
t	50001


statement ok
DROP TABLE dfel.t;


statement ok
DROP DATABASE dfel;
