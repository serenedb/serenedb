# dict_fsst segment sizing: a new dictionary entry that widens the code of every row.
#
# One new entry that takes the entry count across a code width boundary re-prices every row of its
# segment at once: here the 128th entry arrives at row 266,700 and takes the codes from 7 to 8 bits.
#
# Shape: 143 distinct 48-char values in runs of 2100 rows. ROW_GROUP_SIZE is raised so one row group
# holds the whole run; the 122,880-row default never reaches the bump.

control substitution on


statement ok
SET threads = 1;


statement ok
CREATE DATABASE dfeu WITH (ROW_GROUP_SIZE = 1048576);


statement ok
SET force_compression='dict_fsst';


statement ok
CREATE TABLE dfeu.t AS
  SELECT ord, 'k' || lpad((ord // 2100)::VARCHAR, 3, '0') || repeat('x', 36) || substr(md5((ord // 2100)::VARCHAR), 1, 8) AS s
  FROM range(300000) t(ord) ORDER BY ord;


statement ok
CHECKPOINT dfeu;


# every row survived with its exact value
query
SELECT count(*) AS n, count(DISTINCT s) AS dn,
       bool_and(s = 'k' || lpad((ord // 2100)::VARCHAR, 3, '0') || repeat('x', 36) || substr(md5((ord // 2100)::VARCHAR), 1, 8)) AS rows_match
  FROM dfeu.t;
----
n	dn	rows_match
300000	143	t


# the column landed in dict_fsst, and the width bump did not cut its segment
query
SELECT (SELECT count(*) > 0 FROM pragma_storage_info('dfeu.t', include_segment_info=true)
         WHERE column_name='s' AND compression='DICT_FSST') AS has_dict_fsst,
       (SELECT count(*) FROM pragma_storage_info('dfeu.t', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR') AS segments;
----
has_dict_fsst	segments
t	1


statement ok
DROP TABLE dfeu.t;


statement ok
DROP DATABASE dfeu;
