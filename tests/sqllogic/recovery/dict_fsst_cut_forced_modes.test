# Segment sizing of every text codec a column can name, on the shape that re-prices a layout.
#
# A named codec takes the codec decision away from the writer but NOT the sizing: a segment still has
# to stop adding rows where its layout ends, whatever the codec.
#
# Same data everywhere: an all-unique run that loses uniqueness near the end and carries one long row
# on the way, so every codec meets a dictionary that stops growing and a row that widens its lengths.
#
# Each table is CHECKPOINTed while its own codec is still in force -- compression is chosen when the
# segment is written, not when the rows are inserted, so a single checkpoint at the end would compress
# every table under whatever the setting happened to be last.

control substitution on


statement ok
SET threads = 1;


statement ok
CREATE DATABASE dfm;


statement ok
SET force_compression='dict_fsst';


statement ok
CREATE TABLE dfm.src AS
  SELECT ord,
         CASE WHEN ord = 32000 THEN repeat('L', 160)
              WHEN ord >= 33000 THEN 'c'||lpad('0',7,'0')||chr(31)||substr(md5('0'),1,12)
              ELSE 'c'||lpad((ord//8)::VARCHAR,7,'0')||chr(31)||substr(md5(ord::VARCHAR),1,12) END AS s
  FROM range(34600) t(ord) ORDER BY ord;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='dict_lz4';


statement ok
CREATE TABLE dfm.m_dict_lz4 AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='dict_fsst';


statement ok
CREATE TABLE dfm.m_dict_fsst AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='fsst';


statement ok
CREATE TABLE dfm.m_fsst AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='dict_fsst_plus';


statement ok
CREATE TABLE dfm.m_dict_fsst_plus AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='fsst_plus';


statement ok
CREATE TABLE dfm.m_fsst_plus AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


# the same codec over an all-unique column, where no value repeats
statement ok
CREATE TABLE dfm.m_fsst_plus_unique AS
  SELECT ord, 'c'||lpad((ord//8)::VARCHAR,7,'0')||chr(31)||substr(md5(ord::VARCHAR),1,12) AS s
  FROM range(34600) t(ord) ORDER BY ord;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='auto';


statement ok
CREATE TABLE dfm.m_auto AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='dict_zstd';


statement ok
CREATE TABLE dfm.m_dict_zstd AS SELECT * FROM dfm.src;


statement ok
CHECKPOINT dfm;


statement ok
SET force_compression='auto';


# every codec round-trips byte-exact against the source it was copied from
query
SELECT 'm_auto' AS mode, count(*) AS n, bool_and(c.s IS NOT DISTINCT FROM r.s) AS rows_match FROM dfm.m_auto c JOIN dfm.src r USING (ord)
UNION ALL SELECT 'm_dict_zstd', count(*), bool_and(c.s IS NOT DISTINCT FROM r.s) FROM dfm.m_dict_zstd c JOIN dfm.src r USING (ord)
UNION ALL SELECT 'm_dict_fsst', count(*), bool_and(c.s IS NOT DISTINCT FROM r.s) FROM dfm.m_dict_fsst c JOIN dfm.src r USING (ord)
UNION ALL SELECT 'm_dict_fsst_plus', count(*), bool_and(c.s IS NOT DISTINCT FROM r.s) FROM dfm.m_dict_fsst_plus c JOIN dfm.src r USING (ord)
UNION ALL SELECT 'm_dict_lz4', count(*), bool_and(c.s IS NOT DISTINCT FROM r.s) FROM dfm.m_dict_lz4 c JOIN dfm.src r USING (ord)
UNION ALL SELECT 'm_fsst', count(*), bool_and(c.s IS NOT DISTINCT FROM r.s) FROM dfm.m_fsst c JOIN dfm.src r USING (ord)
UNION ALL SELECT 'm_fsst_plus', count(*), bool_and(c.s IS NOT DISTINCT FROM r.s) FROM dfm.m_fsst_plus c JOIN dfm.src r USING (ord)
ORDER BY mode;
----
mode	n	rows_match
m_auto	34600	t
m_dict_fsst	34600	t
m_dict_fsst_plus	34600	t
m_dict_lz4	34600	t
m_dict_zstd	34600	t
m_fsst	34600	t
m_fsst_plus	34600	t


# the all-unique table also round-trips
query
SELECT count(*) AS n,
       bool_and(s = 'c'||lpad((ord//8)::VARCHAR,7,'0')||chr(31)||substr(md5(ord::VARCHAR),1,12)) AS rows_match
  FROM dfm.m_fsst_plus_unique;
----
n	rows_match
34600	t


# each codec actually took effect, so the round-trips above are not all testing the same layout
query
SELECT 'm_auto' AS tbl, string_agg(DISTINCT compression, ',' ORDER BY compression) AS codecs FROM pragma_storage_info('dfm.m_auto') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_dict_fsst', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_dict_fsst') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_dict_fsst_plus', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_dict_fsst_plus') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_dict_lz4', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_dict_lz4') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_dict_zstd', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_dict_zstd') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_fsst', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_fsst') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_fsst_plus', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_fsst_plus') WHERE column_name='s' AND segment_type='VARCHAR'
UNION ALL SELECT 'm_fsst_plus_unique', string_agg(DISTINCT compression, ',' ORDER BY compression) FROM pragma_storage_info('dfm.m_fsst_plus_unique') WHERE column_name='s' AND segment_type='VARCHAR'
ORDER BY tbl;
----
tbl	codecs
m_auto	FSST
m_dict_fsst	DICT_FSST
m_dict_fsst_plus	DICT_FSST_PLUS
m_dict_lz4	DICT_LZ4
m_dict_zstd	DICT_ZSTD
m_fsst	FSST
m_fsst_plus	FSST_PLUS
m_fsst_plus_unique	FSST_PLUS


statement ok
DROP DATABASE dfm;
