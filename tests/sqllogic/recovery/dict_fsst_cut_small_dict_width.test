# dict_fsst segment sizing: a code width bump in a segment with a small dictionary.
#
# A dictionary of a few short values takes a few bits per row, so its segment holds hundreds of
# thousands of rows. One NEW entry that takes the entry count across a code width boundary re-prices
# every one of those rows at once: here the 7 -> 8 bit bump arrives at ~292k rows.
#
# The shape: 127 distinct 4-char values cycling for 292k rows (width 7, dictionary complete and
# stable), then value #128 arrives and bumps the width, then a short mixed tail. ROW_GROUP_SIZE is
# raised so one row group can hold the whole run. The codec is forced: cycling values compress
# better row by row, which is what auto stores. Deterministic: single source, ORDER BY.

control substitution on


statement ok
SET threads = 1;


statement ok
CREATE DATABASE dfsw WITH (ROW_GROUP_SIZE = 1048576);


statement ok
SET force_compression='dict_fsst';


statement ok
CREATE TABLE dfsw.smallw AS
  SELECT ord, CASE WHEN ord < 292000 THEN 'w' || lpad((ord % 127)::VARCHAR, 3, '0')
                   ELSE 'w' || lpad((ord % 128)::VARCHAR, 3, '0') END AS s
  FROM range(300000) t(ord) ORDER BY ord;


statement ok
CHECKPOINT dfsw;


# every row survived with its exact value, and the late value #128 is really present
query
SELECT count(*) AS n,
       count(DISTINCT s) AS dn,
       bool_and(s = CASE WHEN ord < 292000 THEN 'w' || lpad((ord % 127)::VARCHAR, 3, '0')
                         ELSE 'w' || lpad((ord % 128)::VARCHAR, 3, '0') END) AS rows_match
  FROM dfsw.smallw;
----
n	dn	rows_match
300000	128	t


# the column landed in dict_fsst, and the width bump did not cut its segment
query
SELECT (SELECT count(*) > 0 FROM pragma_storage_info('dfsw.smallw', include_segment_info=true)
         WHERE column_name='s' AND compression='DICT_FSST') AS has_dict_fsst,
       (SELECT count(*) FROM pragma_storage_info('dfsw.smallw', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR') AS segments;
----
has_dict_fsst	segments
t	1


statement ok
SET force_compression='auto';


statement ok
DROP DATABASE dfsw;
