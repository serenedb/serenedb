# Text segment sizing on shared prefixes with unique tails, over many segments.
#
# The shape: a few hundred shared prefixes (i % 500) each carrying a unique tail, over 3M rows, so
# the column crosses dozens of segment boundaries. No forced codec: this is the default path of a
# SereneDB table.

control substitution on


statement ok
SET threads = 1;


statement ok
CREATE DATABASE dfo_own;


statement ok
CREATE TABLE dfo_own.grouped AS
  SELECT 'prefix_' || (i % 500)::VARCHAR || '_body_' || i::VARCHAR AS c FROM range(3000000) t(i);


statement ok
CHECKPOINT dfo_own;


# every row survived, and the bytes match the same expression recomputed from range()
query
SELECT count(*) AS n,
       (SELECT sum(hash(c)) FROM dfo_own.grouped)
         = (SELECT sum(hash('prefix_' || (i % 500)::VARCHAR || '_body_' || i::VARCHAR))
              FROM range(3000000) t(i)) AS bytes_match
  FROM dfo_own.grouped;
----
n	bytes_match
3000000	t


# the column is stored as fsst, over many segments
query
SELECT bool_and(compression = 'FSST') AS fsst, count(*) > 10 AS many_segments FROM pragma_storage_info('dfo_own.grouped', include_segment_info=true)
  WHERE column_name='c' AND segment_type='VARCHAR';
----
fsst	many_segments
t	t


# random access into the segments still reconstructs prefix + suffix correctly
query
SELECT c FROM dfo_own.grouped WHERE rowid IN (0, 499, 500, 1499999, 2999999) ORDER BY c;
----
c
prefix_0_body_0
prefix_0_body_500
prefix_499_body_1499999
prefix_499_body_2999999
prefix_499_body_499


statement ok
DROP TABLE dfo_own.grouped;


statement ok
DROP DATABASE dfo_own;
