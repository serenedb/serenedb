# Text segment sizing after a uniqueness flip at the very end of a column.
#
# The shape: all-unique strings whose ROW-order neighbours share a prefix (grouped keys with hash
# tails), then one duplicate at row 25000, which breaks all-unique. Found on the Highsail corpus;
# unlike the sibling tests this one needs only 25k rows.

control substitution on


statement ok
SET threads = 1;


statement ok
CREATE DATABASE dfr_own;


statement ok
CREATE OR REPLACE TABLE dfr_own.grouped AS
  SELECT CASE WHEN i = 25000
              THEN 'c' || lpad('0', 7, '0') || chr(31) || substr(md5('0'), 1, 12)
              ELSE 'c' || lpad((i // 8)::VARCHAR, 7, '0') || chr(31) || substr(md5(i::VARCHAR), 1, 12)
         END AS c
  FROM range(25001) t(i);


statement ok
CHECKPOINT dfr_own;


# every row survived, including exactly one duplicated string
query
SELECT count(*) AS n, count(DISTINCT c) AS dn,
       (SELECT sum(hash(c)) FROM dfr_own.grouped)
         = (SELECT sum(hash(CASE WHEN i = 25000
                                 THEN 'c' || lpad('0', 7, '0') || chr(31) || substr(md5('0'), 1, 12)
                                 ELSE 'c' || lpad((i // 8)::VARCHAR, 7, '0') || chr(31) || substr(md5(i::VARCHAR), 1, 12)
                            END))
              FROM range(25001) t(i)) AS bytes_match
  FROM dfr_own.grouped;
----
n	dn	bytes_match
25001	25000	t


# the column is stored with an fsst codec
query
SELECT bool_and(compression IN ('DICT_FSST', 'FSST')) AS fsst FROM pragma_storage_info('dfr_own.grouped', include_segment_info=true)
  WHERE column_name='c' AND segment_type='VARCHAR';
----
fsst
t


# the duplicate and its original read back identically
query
SELECT count(*) FROM dfr_own.grouped
  WHERE c = 'c' || lpad('0', 7, '0') || chr(31) || substr(md5('0'), 1, 12);
----
count
2


# both engines run against one server, so the alias must not outlive the file
statement ok
DROP DATABASE dfr_own;
