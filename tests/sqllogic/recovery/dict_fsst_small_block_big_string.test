control substitution on


statement ok
CREATE DATABASE dfsb WITH (BLOCK_SIZE = 16384);


statement ok
CREATE TABLE dfsb.big AS
  SELECT ord, coalesce(w.s, 'v' || ord::VARCHAR) AS s
  FROM range(2000) t(ord) LEFT JOIN (
    SELECT o AS ord, string_agg(chr((32 + (hash(o * 16384 + i) % 95))::INTEGER), '' ORDER BY i) AS s
    FROM range(7, 2000, 50) r(o), range(16200) c(i) GROUP BY o) w USING (ord)
  ORDER BY ord;


statement ok
CREATE TABLE dfsb.ctrl AS
  SELECT ord, coalesce(w.s, 'v' || ord::VARCHAR) AS s
  FROM range(2000) t(ord) LEFT JOIN (
    SELECT o AS ord, string_agg(chr((32 + (hash(o * 16384 + i) % 95))::INTEGER), '' ORDER BY i) AS s
    FROM range(7, 2000, 50) r(o), range(6000) c(i) GROUP BY o) w USING (ord)
  ORDER BY ord;


statement ok
CHECKPOINT dfsb;


# every row survived with its exact value
query
SELECT count(*) AS n,
       bool_and(t.s = coalesce(w.s, 'v' || t.ord::VARCHAR)) AS rows_match,
       max(length(t.s)) AS max_len
  FROM dfsb.big t LEFT JOIN (
    SELECT o AS ord, string_agg(chr((32 + (hash(o * 16384 + i) % 95))::INTEGER), '' ORDER BY i) AS s
    FROM range(7, 2000, 50) r(o), range(16200) c(i) GROUP BY o) w USING (ord);
----
n	rows_match	max_len
2000	t	16200


query
SELECT count(*) AS n,
       bool_and(t.s = coalesce(w.s, 'v' || t.ord::VARCHAR)) AS rows_match,
       max(length(t.s)) AS max_len
  FROM dfsb.ctrl t LEFT JOIN (
    SELECT o AS ord, string_agg(chr((32 + (hash(o * 16384 + i) % 95))::INTEGER), '' ORDER BY i) AS s
    FROM range(7, 2000, 50) r(o), range(6000) c(i) GROUP BY o) w USING (ord);
----
n	rows_match	max_len
2000	t	6000


query
SELECT (SELECT count(*) = 0 FROM pragma_storage_info('dfsb.big', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR' AND compression='DICT_FSST'
           AND split_part(segment_info, ':', 1) <> 'DICTIONARY') AS big_not_fsst,
       (SELECT count(*) > 0 FROM pragma_storage_info('dfsb.ctrl', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR' AND compression='DICT_FSST'
           AND split_part(segment_info, ':', 1) <> 'DICTIONARY') AS ctrl_fsst;
----
big_not_fsst	ctrl_fsst
t	t


statement ok
DROP TABLE dfsb.big;


statement ok
DROP TABLE dfsb.ctrl;


statement ok
DROP DATABASE dfsb;
