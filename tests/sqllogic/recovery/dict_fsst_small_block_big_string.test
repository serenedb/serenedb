control substitution on


statement ok
CREATE DATABASE dfsb WITH (BLOCK_SIZE = 16384);


statement ok
CREATE TABLE dfsb.big AS
  SELECT ord, CASE WHEN ord % 50 = 7
    THEN (SELECT string_agg(chr((32 + (hash(ord * 16384 + i) % 95))::INTEGER), '' ORDER BY i) FROM range(16200) r(i))
    ELSE 'v' || ord::VARCHAR END AS s
  FROM range(2000) t(ord) ORDER BY ord;


statement ok
CREATE TABLE dfsb.ctrl AS
  SELECT ord, CASE WHEN ord % 50 = 7
    THEN (SELECT string_agg(chr((32 + (hash(ord * 16384 + i) % 95))::INTEGER), '' ORDER BY i) FROM range(6000) r(i))
    ELSE 'v' || ord::VARCHAR END AS s
  FROM range(2000) t(ord) ORDER BY ord;


statement ok
CHECKPOINT dfsb;


# every row survived with its exact value
query
SELECT count(*) AS n,
       bool_and(s = CASE WHEN ord % 50 = 7
         THEN (SELECT string_agg(chr((32 + (hash(ord * 16384 + i) % 95))::INTEGER), '' ORDER BY i) FROM range(16200) r(i))
         ELSE 'v' || ord::VARCHAR END) AS rows_match,
       max(length(s)) AS max_len
  FROM dfsb.big;
----
n	rows_match	max_len
2000	t	16200


query
SELECT count(*) AS n,
       bool_and(s = CASE WHEN ord % 50 = 7
         THEN (SELECT string_agg(chr((32 + (hash(ord * 16384 + i) % 95))::INTEGER), '' ORDER BY i) FROM range(6000) r(i))
         ELSE 'v' || ord::VARCHAR END) AS rows_match,
       max(length(s)) AS max_len
  FROM dfsb.ctrl;
----
n	rows_match	max_len
2000	t	6000


query
SELECT (SELECT count(*) = 0 FROM pragma_storage_info('dfsb.big', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR' AND compression='DICT_FSST'
           AND split_part(segment_info, ':', 1) <> 'DICTIONARY') AS big_not_fsst,
       (SELECT count(*) > 0 FROM pragma_storage_info('dfsb.ctrl', include_segment_info=true)
         WHERE column_name='s' AND segment_type='VARCHAR' AND compression='DICT_FSST'
           AND split_part(segment_info, ':', 1) <> 'DICTIONARY') AS ctrl_fsst;
----
big_not_fsst	ctrl_fsst
t	t


statement ok
DROP TABLE dfsb.big;


statement ok
DROP TABLE dfsb.ctrl;


statement ok
DROP DATABASE dfsb;
