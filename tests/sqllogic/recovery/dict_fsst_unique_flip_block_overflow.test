# Text segment sizing: a long all-unique run, one longer string (a length width bump), then a run
# of duplicates, which is where a dictionary starts to pay.
#
# Deterministic: single row group, ORDER BY. 33000 unique 12-char md5 values, a 160-char row, 1600
# duplicates of one value.

control substitution on


statement ok
CREATE DATABASE dfu_own;


statement ok
CREATE TABLE dfu_own.flip AS
  SELECT s, ord FROM (
    SELECT i AS ord, substr(md5(i::VARCHAR), 1, 12) AS s FROM range(33000) t1(i)
    UNION ALL
    SELECT 33000 AS ord,
           substr(md5('b1')||md5('b2')||md5('b3')||md5('b4')||md5('b5')||md5('b6'), 1, 160) AS s
    UNION ALL
    SELECT 33001 + j AS ord, substr(md5('0'), 1, 12) AS s FROM range(1600) t2(j)
  ) ORDER BY ord;


statement ok
CHECKPOINT dfu_own;


# every row survived and every row still carries its exact original value
query
SELECT count(*) AS n,
       bool_and(s = CASE
           WHEN ord < 33000 THEN substr(md5(ord::VARCHAR), 1, 12)
           WHEN ord = 33000 THEN substr(md5('b1')||md5('b2')||md5('b3')||md5('b4')||md5('b5')||md5('b6'), 1, 160)
           ELSE substr(md5('0'), 1, 12) END) AS rows_match
  FROM dfu_own.flip;
----
n	rows_match
34601	t


# the column is stored with an fsst codec
query
SELECT bool_and(compression IN ('DICT_FSST', 'FSST')) AS fsst
  FROM pragma_storage_info('dfu_own.flip', include_segment_info=true)
  WHERE column_name = 's' AND segment_type = 'VARCHAR';
----
fsst
t


statement ok
DROP TABLE dfu_own.flip;


statement ok
DROP DATABASE dfu_own;
