statement ok
ALTER DOMAIN d_alt ADD CHECK (VALUE > 0) NOT VALID;

statement ok
ALTER DOMAIN d_alt RENAME CONSTRAINT d_alt_check TO d_alt_pos;

statement ok
ALTER DOMAIN d_alt ADD CHECK (VALUE < 100) NOT VALID;

statement ok
ALTER DOMAIN d_alt SET DEFAULT 7;

statement ok
SET sdb_faults = 'crash_on_packet';

query error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
