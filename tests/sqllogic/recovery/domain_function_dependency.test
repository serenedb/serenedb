control substitution on

statement ok
CREATE FUNCTION f_dfr_check(x int4) RETURNS boolean LANGUAGE sql AS 'SELECT x > 0';

statement ok
CREATE FUNCTION f_dfr_default() RETURNS int4 LANGUAGE sql AS 'SELECT 7';

statement ok
CREATE DOMAIN d_dfr AS int4;

statement ok
ALTER DOMAIN d_dfr ADD CONSTRAINT d_dfr_pos CHECK (f_dfr_check(VALUE)) NOT VALID;

statement ok
ALTER DOMAIN d_dfr SET DEFAULT f_dfr_default();

# An ALTER DOMAIN that leaves the domain with no dependencies replays from the log with none: the function
# it dropped is free after the restart, and the domain stays.

statement ok
CREATE FUNCTION f_dfr_dropped() RETURNS int4 LANGUAGE sql AS 'SELECT 9';

statement ok
CREATE DOMAIN d_dfr_dropped AS int4 DEFAULT f_dfr_dropped();

statement ok
ALTER DOMAIN d_dfr_dropped DROP DEFAULT;

statement ok
SET sdb_faults = 'crash_on_packet';

query error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;
----
?column?
1


connection after_crash
statement ok
DROP FUNCTION f_dfr_dropped();

connection after_crash
query
SELECT count(*) AS n FROM pg_type WHERE typname = 'd_dfr_dropped';
----
n
1


connection after_crash
statement error
DROP FUNCTION f_dfr_check(int4);

connection after_crash
statement error
DROP FUNCTION f_dfr_default();

connection after_crash
statement ok
ALTER DOMAIN d_dfr DROP DEFAULT;

connection after_crash
statement ok
CHECKPOINT;

connection after_crash
statement ok
SET sdb_faults = 'crash_on_packet';

connection after_crash
query error connection closed
SELECT 1;


connection after_checkpoint
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;
----
?column?
1


connection after_checkpoint
statement error
DROP FUNCTION f_dfr_check(int4);

connection after_checkpoint
statement ok
DROP FUNCTION f_dfr_default();

connection after_checkpoint
statement ok
ALTER DOMAIN d_dfr DROP CONSTRAINT d_dfr_pos;

connection after_checkpoint
statement ok
DROP FUNCTION f_dfr_check(int4);
