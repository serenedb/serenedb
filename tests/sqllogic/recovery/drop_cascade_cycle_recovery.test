control substitution on


# A view over a function, across a restart. The mutual cycle a replaced function
# body would build (the body reads the view that reads the function) cannot be
# built: a replace is a drop plus a create, so the new definition is refused for
# depending on the name it replaces. What this file asserts is that the one edge
# there is survives a checkpoint and a crash, and that the refused drop names it.


statement ok
CREATE TABLE kostya_t (n INT);


statement count 2
INSERT INTO kostya_t VALUES (1), (2);


statement ok
CREATE FUNCTION babsky_fn(x INT) AS x + 1;


statement ok
CREATE VIEW clickclack_v AS SELECT babsky_fn(n) AS c FROM kostya_t;


# The replaced body reads the view that reads this function.
statement error
CREATE OR REPLACE FUNCTION babsky_fn(x INT) AS (SELECT count(*)::INT FROM clickclack_v) + x;
----
db error: ERROR: CREATE OR REPLACE is not allowed to depend on itself<slt:ignore>


# The original definition is untouched by the refused statement.
query
SELECT c FROM clickclack_v ORDER BY c;
----
c
2
3


statement ok
CHECKPOINT;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_crash
query
SELECT c FROM clickclack_v ORDER BY c;
----
c
2
3


# The edge came back with them, and the refused drop names it once.
connection after_crash
statement error
DROP FUNCTION babsky_fn;
----
db error: ERROR: Cannot drop entry "babsky_fn" because there are entries that depend on it.
view "clickclack_v" depends on macro function "babsky_fn".
Use DROP...CASCADE to drop all dependents.


connection after_crash
statement ok
DROP FUNCTION babsky_fn CASCADE;


connection after_crash
statement error
SELECT * FROM clickclack_v;
----
db error: ERROR: Table with name clickclack_v does not exist!
Did you mean "<slt:ignore>"?


connection after_crash
statement ok
DROP TABLE kostya_t;
