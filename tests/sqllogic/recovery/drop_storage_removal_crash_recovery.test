# 4. A search table replaced by CREATE OR REPLACE TABLE.
# ----------------------------------------------------------------------

connection after_database
statement ok
CREATE TABLE dsr_r (id INT, body TEXT) WITH (storage = 'search');


connection after_database
statement ok
INSERT INTO dsr_r VALUES (1, 'old');


connection after_database
statement ok
VACUUM (REFRESH_TABLE) dsr_r;


connection after_database
statement ok
INSERT INTO dsr_oids SELECT 'dsr_r_old', table_oid FROM duckdb_tables()
WHERE database_name = current_database() AND table_name = 'dsr_r';


connection after_database
statement ok
SET sdb_faults = 'pause_removal_midway';


connection after_database
statement ok
BEGIN;


connection after_database
statement ok
CREATE OR REPLACE TABLE dsr_r (id INT, body TEXT, extra INT) WITH (storage = 'search');


connection after_database
statement ok
INSERT INTO dsr_r VALUES (2, 'new', 20);


connection after_database
statement ok
COMMIT;


connection after_database
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_removal_midway:parked';


skipif pg-wire-extended
connection after_database
statement ok
SET sdb_faults = 'crash_on_packet';


skipif pg-wire-extended
connection after_database
statement error connection closed
SELECT 1;


onlyif pg-wire-extended
connection after_database
statement error connection closed
SET sdb_faults = 'crash_on_packet';


# --- restart ---

connection after_replace
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id, body, extra FROM dsr_r ORDER BY id;
----
id	body	extra
2	new	20


connection after_replace
query
SELECT dsr_leftover('dsr_r_old') AS leftover;
----
leftover
0


connection after_replace
query
SELECT id, body FROM dsr_keep;
----
id	body
1	kept


