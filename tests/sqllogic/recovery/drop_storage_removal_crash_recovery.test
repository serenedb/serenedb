control substitution on

# A dropped search table, inverted index or database has its directory removed
# in the background after the commit. A crash in the middle of that removal
# must leave a data directory that boots without the dropped object and with
# everything else intact.
#
# The fault point stops a removal once it deleted one file of the directory, and
# parks it there; the crash comes while it is parked.


statement ok
CREATE TABLE dsr_keep (id INT PRIMARY KEY, body TEXT) WITH (storage = 'search');


statement ok
INSERT INTO dsr_keep VALUES (1, 'kept');


statement ok
VACUUM (REFRESH_TABLE) dsr_keep;


statement ok
CREATE TABLE dsr_oids (name TEXT, oid BIGINT);


statement ok
INSERT INTO dsr_oids SELECT 'db', oid FROM pg_database WHERE datname = current_database();


# The files left in the directory of a dropped object of this database, and of
# a dropped database.
statement ok
CREATE MACRO dsr_leftover(object) AS (
  SELECT count(*) FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/**')
  WHERE file LIKE '%/engine_v1/' || (SELECT oid FROM dsr_oids WHERE name = 'db') || '/'
                  || (SELECT oid FROM dsr_oids WHERE name = object) || '/%');


statement ok
CREATE MACRO dsr_database_leftover(object) AS (
  SELECT count(*) FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/**')
  WHERE file LIKE '%/engine_v1/' || (SELECT oid FROM dsr_oids WHERE name = object) || '/%');


# ----------------------------------------------------------------------
# 1. A search table.
# ----------------------------------------------------------------------

statement ok
CREATE TABLE dsr_s (id INT PRIMARY KEY, body TEXT) WITH (storage = 'search');


statement ok
INSERT INTO dsr_s VALUES (1, 'alpha'), (2, 'beta');


statement ok
VACUUM (REFRESH_TABLE) dsr_s;


statement ok
INSERT INTO dsr_oids SELECT table_name, table_oid FROM duckdb_tables()
WHERE database_name = current_database() AND table_name = 'dsr_s';


query
SELECT dsr_leftover('dsr_s') > 0 AS stored;
----
stored
t


statement ok
SET sdb_faults = 'pause_removal_midway';


statement ok
DROP TABLE dsr_s;


statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_removal_midway:parked';


# Under the extended protocol the Sync that follows the SET is already the
# next packet, so the SET itself is what the connection dies on.
skipif pg-wire-extended
statement ok
SET sdb_faults = 'crash_on_packet';


skipif pg-wire-extended
statement error connection closed
SELECT 1;


onlyif pg-wire-extended
statement error connection closed
SET sdb_faults = 'crash_on_packet';


# --- restart ---

connection after_table
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM pg_class WHERE relname = 'dsr_s';
----
n
0


connection after_table
query
SELECT dsr_leftover('dsr_s') AS leftover;
----
leftover
0


connection after_table
query
SELECT id, body FROM dsr_keep;
----
id	body
1	kept


# ----------------------------------------------------------------------
# 2. An inverted index on a table.
# ----------------------------------------------------------------------

connection after_table
statement ok
CREATE TABLE dsr_t (id INT, body TEXT);


connection after_table
statement ok
INSERT INTO dsr_t VALUES (1, 'alpha'), (2, 'beta');


connection after_table
statement ok
CREATE INDEX dsr_t_idx ON dsr_t USING inverted (body);


connection after_table
statement ok
VACUUM (REFRESH_TABLE) dsr_t;


connection after_table
statement ok
INSERT INTO dsr_oids SELECT index_name, index_oid FROM duckdb_indexes()
WHERE database_name = current_database() AND index_name = 'dsr_t_idx';


connection after_table
statement ok
SET sdb_faults = 'pause_removal_midway';


connection after_table
statement ok
DROP INDEX dsr_t_idx;


connection after_table
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_removal_midway:parked';


skipif pg-wire-extended
connection after_table
statement ok
SET sdb_faults = 'crash_on_packet';


skipif pg-wire-extended
connection after_table
statement error connection closed
SELECT 1;


onlyif pg-wire-extended
connection after_table
statement error connection closed
SET sdb_faults = 'crash_on_packet';


# --- restart ---

connection after_index
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM pg_class WHERE relname = 'dsr_t_idx';
----
n
0


connection after_index
query
SELECT dsr_leftover('dsr_t_idx') AS leftover;
----
leftover
0


connection after_index
query
SELECT id, body FROM dsr_t ORDER BY id;
----
id	body
1	alpha
2	beta


