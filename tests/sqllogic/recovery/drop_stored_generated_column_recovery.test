control substitution on

statement ok
CREATE TABLE melstroi_gen (a INT, s INT GENERATED ALWAYS AS (a * 3) STORED, b INT);


statement ok
INSERT INTO melstroi_gen (a, b) VALUES (1, 5), (2, 7);


statement ok
ALTER TABLE melstroi_gen DROP COLUMN s;


statement ok
INSERT INTO melstroi_gen (a, b) VALUES (3, 11);


statement ok
CREATE TABLE papich_gen (k INT, a INT, s INT GENERATED ALWAYS AS (a * 3) STORED, b INT);


statement ok
INSERT INTO papich_gen (k, a, b) VALUES (1, 1, 5), (2, 2, 7);


statement ok
ALTER TABLE papich_gen DROP COLUMN a CASCADE;


statement ok
CHECKPOINT;


statement ok
INSERT INTO melstroi_gen (a, b) VALUES (4, 13);


statement ok
