statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT string_agg(a || ':' || b, ',' ORDER BY a) AS melstroi FROM melstroi_gen;
----
melstroi
1:5,2:7,3:11,4:13


connection after_crash
query
SELECT string_agg(k || ':' || b, ',' ORDER BY k) AS papich FROM papich_gen;
----
papich
1:5,2:7,3:11


connection after_crash
statement ok
CHECKPOINT;


connection after_crash
query
SELECT (SELECT count(*) FROM melstroi_gen) AS melstroi, (SELECT sum(b) FROM papich_gen) AS papich;
----
melstroi	papich
4	23
