statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT d.used_blocks - b.used_blocks AS added
FROM pragma_database_size() d, rsp_baseline b
WHERE d.database_name = current_database();
----
added
0


connection after_crash
query
SELECT id, v FROM rsp_unindexed ORDER BY id;
----
id	v
1	1
2	2


