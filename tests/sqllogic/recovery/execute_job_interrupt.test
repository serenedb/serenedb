control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE eji_runs (step TEXT);


statement ok
CREATE JOB eji_slow EVERY 1 DAY SUSPENDED AS $$ SELECT pg_sleep(10); INSERT INTO eji_runs VALUES ('after the sleep') $$;


connection eji_stopped
statement async error connection closed
EXECUTE JOB eji_slow;


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS running FROM pg_stat_activity WHERE query LIKE 'EXECUTE JOB eji_slow%' AND state = 'active';
----
running
1


connection default
statement ok
SET sdb_faults = 'shutdown_on_packet';


connection default
statement error connection closed
SELECT 1;


wait


connection eji_after_restart
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS committed_after_shutdown FROM eji_runs;
----
committed_after_shutdown
0


connection eji_cancelled
statement async error
EXECUTE JOB eji_slow;
----
db error: ERROR: canceling statement due to user request


connection eji_after_restart
query ok retry 40 backoff 250ms
SELECT count(*) AS running FROM pg_stat_activity WHERE query LIKE 'EXECUTE JOB eji_slow%' AND state = 'active';
----
running
1


connection eji_after_restart
query
SELECT pg_cancel_backend(pid) AS cancelled FROM pg_stat_activity WHERE query LIKE 'EXECUTE JOB eji_slow%';
----
cancelled
t


wait


connection eji_timeout
statement ok
SET statement_timeout = '500ms';


connection eji_timeout
statement error
EXECUTE JOB eji_slow;
----
db error: ERROR: canceling statement due to statement timeout


connection eji_after_restart
query
SELECT count(*) AS committed_after_interrupts FROM eji_runs;
----
committed_after_interrupts
0


connection eji_after_restart
statement ok
CREATE TABLE eji_steps (step INT);


connection eji_after_restart
statement ok
CREATE JOB eji_two EVERY 1 DAY SUSPENDED AS $$ INSERT INTO eji_steps VALUES (1); INSERT INTO eji_steps VALUES (2) $$;


connection eji_after_restart
statement ok
SET sdb_faults = 'pause_job_after_statement';


connection eji_between
statement async error
EXECUTE JOB eji_two;
----
db error: ERROR: canceling statement due to user request


connection eji_after_restart
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_job_after_statement:parked';


connection eji_after_restart
query
SELECT pg_cancel_backend(pid) AS cancelled FROM pg_stat_activity WHERE query LIKE 'EXECUTE JOB eji_two%';
----
cancelled
t


connection eji_after_restart
statement ok
SET sdb_faults = 'pause_job_after_statement:release';


wait


connection eji_after_restart
statement ok
RESET sdb_faults;


connection eji_after_restart
query
SELECT step FROM eji_steps ORDER BY step;
----
step
1
