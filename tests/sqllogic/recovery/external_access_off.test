control substitution on


statement ok
CREATE TEXT SEARCH DICTIONARY en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE TABLESPACE sandboxed LOCATION '${__TEST_DIR__}/sandboxed';


statement ok
CREATE TABLE docs (id INTEGER PRIMARY KEY, body TEXT);


statement ok
CREATE INDEX docs_idx ON docs USING inverted(body en);


statement ok
CREATE TABLE notes (id INT, body TEXT) WITH (storage = 'search') TABLESPACE sandboxed;


statement ok
SET enable_external_access = false;


statement count 2
INSERT INTO docs VALUES (1, 'pudge goes mid'), (2, 'anchin reads manga');


statement ok
VACUUM (REFRESH_TABLE) docs;


query
SELECT id FROM docs_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id
1


statement count 1
INSERT INTO notes VALUES (1, 'pudge hooks the courier');


statement ok
VACUUM (REFRESH_TABLE) notes;


query
SELECT id FROM notes ORDER BY id;
----
id
1


statement ok
CREATE TABLE later (id INTEGER PRIMARY KEY, body TEXT);


statement ok
CREATE INDEX later_idx ON later USING inverted(body en);


statement count 1
INSERT INTO later VALUES (1, 'pudge');


statement ok
VACUUM (REFRESH_TABLE) later;


query
