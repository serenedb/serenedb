statement ok
CREATE DATABASE sandboxed_db;


system ok
pid=$(for p in $(pgrep -x serened); do if tr '\0' ' ' < /proc/$p/cmdline | grep -q -- "$SDB_DATADIR"; then echo $p; fi; done | head -1); port=$(tr '\0' '\n' < /proc/$pid/cmdline | grep -o 'postgres://[^,?/]*' | head -1 | sed 's/.*://'); PGPASSWORD=postgres psql -h 127.0.0.1 -p "$port" -U postgres -d sandboxed_db -XAtq -c 'CREATE TABLE t (a INT)' -c 'INSERT INTO t VALUES (1)' -c 'SELECT count(*) FROM t'
----
1


statement ok
DROP TABLE notes;


statement ok
DROP TABLESPACE sandboxed;


system ok
for i in $(seq 240); do [ -z "$(ls $__TEST_DIR__/sandboxed/engine_v1)" ] && break; sleep 0.25; done; ls $__TEST_DIR__/sandboxed/engine_v1 | wc -l
