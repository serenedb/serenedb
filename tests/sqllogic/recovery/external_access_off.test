statement ok
CREATE TEMPORARY TABLE temp_docs (id INTEGER PRIMARY KEY, body TEXT);


statement count 2
INSERT INTO temp_docs VALUES (1, 'pudge goes mid'), (2, 'anchin reads manga');


statement ok
CREATE INDEX temp_idx ON temp_docs USING inverted(body en);


statement count 1
