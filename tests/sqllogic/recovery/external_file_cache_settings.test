control substitution on

# The external file cache keeps its blocks within memory_limit: blocks of
# in-memory index files evicted by a lower limit spill to temporary files and
# read back the same, and RESET restores the limit.

statement ok
SET sdb_faults = 'IndexWriter::CompactOutOfMemory';


statement ok
CREATE TEMPORARY TABLE spilled (id INT, body TEXT);


statement ok
INSERT INTO spilled
SELECT i, concat_ws(' ', 'fox', md5(i::VARCHAR), md5((i + 1000000)::VARCHAR))
FROM range(200000) t(i);


statement ok
CREATE TEXT SEARCH DICTIONARY spill_words AS split_text(case := 'lower');


statement ok
CREATE INDEX spilled_body ON spilled USING inverted(body spill_words);


statement ok
SET GLOBAL memory_limit = '16MiB';


query
SELECT count(*) AS n FROM spilled_body WHERE body @@ 'fox';
----
n
200000


query
SELECT id FROM spilled_body WHERE body @@ '827ccb0eea8a706c4c34a16891f84e7b' ORDER BY id;
----
id
12345


query
SELECT id FROM spilled_body WHERE body @@ 'ab9e5c0524fcb4c72446a5e9c63e9791' ORDER BY id;
----
id
199999


query
SELECT count(*) FILTER (WHERE metric = 'block_cache_spilled_blocks' AND value > 0) AS spilled,
       count(*) FILTER (WHERE metric = 'block_cache_spill_reads' AND value > 0) AS read_back
FROM sdb_metrics;
----
spilled	read_back
1	1


statement ok
RESET sdb_faults;


statement ok
RESET GLOBAL memory_limit;


query
SELECT count(*) AS n FROM spilled_body WHERE body @@ 'fox';
----
n
200000


statement ok
DROP TABLE spilled;
