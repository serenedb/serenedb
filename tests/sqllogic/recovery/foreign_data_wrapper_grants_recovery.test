connection after_wal_replay
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT fdwname, fdwacl FROM pg_foreign_data_wrapper WHERE fdwacl IS NOT NULL ORDER BY fdwname;
