fdwname	fdwacl
clickhouse_fdw	{postgres=U/postgres,fwg_bob=U/postgres}
postgres_fdw	{postgres=U/postgres,fwg_alice=U*/postgres,fwg_bob=U/fwg_alice}


connection after_wal_replay
