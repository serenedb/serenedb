query
SELECT has_foreign_data_wrapper_privilege('fwg_bob', 'clickhouse_fdw', 'USAGE') AS ch,
       has_foreign_data_wrapper_privilege('fwg_bob', 'postgres_fdw', 'USAGE') AS pg,
       has_foreign_data_wrapper_privilege('fwg_bob', 'iceberg_fdw', 'USAGE') AS ice;
