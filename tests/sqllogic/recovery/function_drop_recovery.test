control substitution on


# Vedernikoff DROP TABLE CASCADE recovery on a SERIAL anchor while a
# cross-tree sibling table holds a DEFAULT pointing at the anchor's PK
# sequence. Crash mid-finalize, then verify the sibling survives and still
# draws from that sequence, which the drop left behind.

statement ok
CREATE TABLE vedernikoff_iceberg_owner (
  id SERIAL PRIMARY KEY,
  hero TEXT
);


statement count 3
INSERT INTO vedernikoff_iceberg_owner (hero) VALUES
  ('vedernikoff_alpha'), ('vedernikoff_bravo'), ('vedernikoff_charlie');


statement ok
CREATE TABLE vedernikoff_iceberg_proxy (
  id BIGINT DEFAULT nextval('vedernikoff_iceberg_owner_id_seq'),
  body TEXT
);


statement count 1
INSERT INTO vedernikoff_iceberg_proxy (body) VALUES ('pre_crash');


# Survivor with no relationship to the dropped graph.
statement ok
CREATE TABLE vedernikoff_solid_witness (id INT, body TEXT);


statement count 1
INSERT INTO vedernikoff_solid_witness VALUES (1, 'untouched');


statement ok
SET sdb_faults = 'crash_on_drop';


statement error connection closed
DROP TABLE vedernikoff_iceberg_owner CASCADE;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


# The table is gone, and its SERIAL sequence went with it: the sequence is owned
# by the table.
connection after_crash
query
SELECT relname FROM pg_class
  WHERE relname IN ('vedernikoff_iceberg_owner', 'vedernikoff_iceberg_owner_id_seq');
----
relname


# The proxy went with the CASCADE: its column DEFAULT reads the owner's sequence,
# the sequence is owned by the owner table, and a dependency on a sequence is
# recorded against the whole entry -- so the cascade reaches the table, not just
# the default.
connection after_crash
statement error
SELECT id, body FROM vedernikoff_iceberg_proxy;
----
db error: ERROR: Table with name vedernikoff_iceberg_proxy does not exist!
Did you mean "<slt:ignore>"?


# Survivor.
connection after_crash
query
SELECT id, body FROM vedernikoff_solid_witness;
----
id  body
1   untouched


connection after_crash
statement ok
DROP TABLE vedernikoff_solid_witness;
