statement ok
CREATE TABLE fopr_t (a INT, b INT, c INT, d INT, e INT, f INT);


connection after_crash
query
SELECT oid::regprocedure::text AS f, oid = 'fopr_t'::regclass::oid AS collides
FROM pg_proc
