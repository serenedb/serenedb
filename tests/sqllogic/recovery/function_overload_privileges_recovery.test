control substitution on

statement ok
CREATE ROLE fopr_a;


statement ok
CREATE ROLE fopr_b;


statement ok
CREATE ROLE fopr_c;


statement ok
CREATE FUNCTION fopr_f(x INT) RETURNS INT LANGUAGE SQL AS 'SELECT x';


statement ok
CREATE FUNCTION fopr_f(x TEXT) RETURNS TEXT LANGUAGE SQL AS 'SELECT x';


statement ok
CREATE FUNCTION fopr_f(x INT, y INT) RETURNS INT LANGUAGE SQL AS 'SELECT x + y';


statement ok
ALTER FUNCTION fopr_f(TEXT) OWNER TO fopr_a;


statement ok
REVOKE EXECUTE ON FUNCTION fopr_f(INT, INT) FROM PUBLIC;


statement ok
GRANT EXECUTE ON FUNCTION fopr_f(INT, INT) TO fopr_b;


query
SELECT oid::regprocedure::text AS f, proowner::regrole::text AS owner, array_to_string(proacl, ',') AS acl
FROM pg_proc
WHERE proname = 'fopr_f'
ORDER BY 1;
----
f	owner	acl
fopr_f(integer)	postgres	NULL
fopr_f(integer,integer)	postgres	postgres=X/postgres,fopr_b=X/postgres
fopr_f(text)	fopr_a	NULL


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_crash
