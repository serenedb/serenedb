connection after_checkpoint
query
SELECT o.f, p.oid::regprocedure::text AS now, p.proowner::regrole::text AS owner, array_to_string(p.proacl, ',') AS acl
FROM fopr_oids o
JOIN pg_proc p ON p.oid = o.oid
ORDER BY 1;
----
f	now	owner	acl
fopr_f(integer)	fopr_f(integer)	postgres	NULL
fopr_f(integer,integer)	fopr_f(integer,integer)	postgres	postgres=X/postgres,fopr_b=X/postgres
fopr_f(text)	fopr_f(text)	fopr_a	=X/fopr_a,fopr_a=X/fopr_a,fopr_c=X/fopr_a


