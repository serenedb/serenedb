current_user
hbr_kuzya

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS rules FROM pg_hba_file_rules;
----
rules
6

connection after_crash
query
SELECT current_setting('hba') = '# no rules yet' AS loaded;
----
loaded
t

connection c_after_crash user=hbr_kuzya password=kuzya_pw
query
SELECT current_user;
----
current_user
hbr_kuzya
