control substitution on

statement ok
CREATE ROLE hbr_kuzya LOGIN PASSWORD 'kuzya_pw';

statement ok
SET hba = 'host all all 0.0.0.0/0 reject';

connection c_rejected user=hbr_kuzya password=kuzya_pw
statement error
SELECT 1;
----
db error: FATAL: no pg_hba.conf entry for host, user "hbr_kuzya"<slt:ignore>


statement ok
RESET hba;

query
SELECT rule_number, type, database, user_name, address, auth_method
FROM pg_hba_file_rules ORDER BY rule_number;
----
rule_number	type	database	user_name	address	auth_method
1	local	{all}	{postgres}	(empty)	trust
2	host	{all}	{postgres}	127.0.0.1/32	trust
3	host	{all}	{postgres}	::1/128	trust
4	local	{all}	{all}	(empty)	scram-sha-256
5	host	{all}	{all}	0.0.0.0/0	scram-sha-256
6	host	{all}	{all}	::/0	scram-sha-256

connection c_after_reset user=hbr_kuzya password=kuzya_pw
query
SELECT current_user;
----
current_user
hbr_kuzya

statement ok
SET hba = 'host all all 0.0.0.0/0 reject';

statement ok
SET hba = '';

