control substitution on

statement ok
CREATE TABLE hgc (id INTEGER PRIMARY KEY, emb FLOAT[8])
  WITH (compaction_interval = 0);


statement ok
CREATE INDEX hgc_idx ON hgc
  USING inverted(id, emb hnsw (metric = 'l2', quant = 'none'));


statement ok
SET sdb_faults = 'irs::HnswRawGraph';


statement ok
INSERT INTO hgc SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8]
  FROM range(0, 1500) t(i);


statement ok
VACUUM (FLUSH_TABLE) hgc;


statement ok
RESET sdb_faults;


statement ok
INSERT INTO hgc SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8]
  FROM range(1500, 3000) t(i);


statement ok
VACUUM (FLUSH_TABLE) hgc;


query
SELECT metric, value FROM sdb_metrics
WHERE relation_id = 'hgc'::regclass::oid AND metric = 'num_segments';
