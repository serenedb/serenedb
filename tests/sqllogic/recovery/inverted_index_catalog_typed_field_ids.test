control substitution on


statement ok
CREATE TEXT SEARCH DICTIONARY typed_ids_keyword AS keyword() WITH (frequency);


statement ok
CREATE TABLE typed_ids_checkpointed (id INTEGER PRIMARY KEY, b BOOLEAN, n BIGINT, s VARCHAR, content JSON);


statement ok
CREATE TABLE typed_ids_logged (id INTEGER PRIMARY KEY, b BOOLEAN, n BIGINT, s VARCHAR, content JSON);


statement ok
INSERT INTO typed_ids_checkpointed VALUES
  (1, true, 10, 'apple', '{"val":42}'),
  (2, false, NULL, 'pear', '{"val":null}'),
  (3, NULL, 30, NULL, '{"other":1}'),
  (4, true, 40, 'apple', '{"val":8}');


statement ok
INSERT INTO typed_ids_logged SELECT * FROM typed_ids_checkpointed;


statement ok
SET sdb_faults = 'inverted_index_catalog_with_typed_field_ids';


statement ok
CREATE INDEX typed_ids_checkpointed_idx ON typed_ids_checkpointed
  USING inverted(id, b, n, s typed_ids_keyword, (content->'val') typed_ids_keyword);


statement ok
CHECKPOINT;


statement ok
CREATE INDEX typed_ids_logged_idx ON typed_ids_logged
  USING inverted(id, b, n, s typed_ids_keyword, (content->'val') typed_ids_keyword);


statement ok
RESET sdb_faults;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


