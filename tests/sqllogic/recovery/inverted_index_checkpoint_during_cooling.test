control substitution on

statement ok
CREATE DATABASE ckpt_cooling;


statement ok
CREATE TABLE ckpt_cooling.public.docs (id INTEGER, body TEXT);


statement ok
CREATE INDEX docs_idx ON ckpt_cooling.public.docs USING inverted (body)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO ckpt_cooling.public.docs SELECT i, 'base' FROM range(0, 1000) r(i);


statement ok
SET sdb_faults = 'pause_search_cooling';


connection reader
statement async ok
SELECT count(*) AS n FROM ckpt_cooling.public.docs_idx WHERE body @@ 'base';


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_cooling:parked';


connection checkpointer
statement async ok
CHECKPOINT ckpt_cooling;


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT ckpt_cooling%';
----
n
1


connection default
statement ok
SET sdb_faults = 'pause_search_cooling:release';


connection reader
wait


connection checkpointer
wait


connection default
query
SELECT count(*) AS n FROM ckpt_cooling.public.docs_idx WHERE body @@ 'base';
----
n
1000
