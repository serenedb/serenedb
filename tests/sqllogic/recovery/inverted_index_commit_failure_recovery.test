control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE commit_fail (id BIGINT, msg TEXT);


statement ok
CREATE INDEX commit_fail_idx ON commit_fail USING inverted (id, msg)
  WITH (refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO commit_fail SELECT i, 'm' || (i % 7) FROM range(500) t(i);


statement ok
VACUUM (REFRESH_TABLE) commit_fail;


statement ok
SET sdb_faults = 'IndexWriter::Transaction::Commit';


statement ok
INSERT INTO commit_fail SELECT i, 'late' FROM range(500, 600) t(i);


statement ok
SET sdb_faults = '-IndexWriter::Transaction::Commit';


statement ok
VACUUM (REFRESH_TABLE) commit_fail;


query
SELECT (SELECT count(*) FROM commit_fail) AS rows,
       (SELECT count(*) FROM commit_fail_idx) AS indexed;
----
rows	indexed
600	500


statement error
CHECKPOINT;
----
db error: ERROR: Checkpoint failed for database "<slt:ignore>". The database has been invalidated. Original error: inverted index <slt:ignore> is out of sync with its store table; refusing to checkpoint


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM commit_fail;
----
n
600


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) commit_fail;


connection after_crash
query
SELECT (SELECT count(*) FROM commit_fail_idx) AS total,
       (SELECT count(*) FROM commit_fail_idx WHERE msg @@ 'late') AS late;
----
total	late
600	100
