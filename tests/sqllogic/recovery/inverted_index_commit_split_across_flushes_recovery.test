control substitution on

statement ok
RESET sdb_faults;


statement ok
SET threads = 4;


statement ok
CREATE TABLE split_rows (id BIGINT, msg TEXT);


statement ok
CREATE INDEX split_rows_idx ON split_rows USING inverted (id, msg)
  WITH (refresh_interval = 20, compaction_interval = 0);


statement ok
SET sdb_faults = 'inverted_stage_slots_registered';


connection writer
statement ok
SET threads = 4;


connection writer
statement async ok
INSERT INTO split_rows SELECT i, 'm' || (i % 7) FROM range(40000) t(i);


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-inverted_stage_slots_registered:parked';


sleep 1s


connection default
statement ok
SET sdb_faults = 'pause_irs_commit_after_flush_switch';


connection default
statement ok
SET sdb_faults = 'inverted_stage_slots_registered:release';


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_irs_commit_after_flush_switch:parked';


wait


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM split_rows;
----
n
40000


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) split_rows;


connection after_crash
query
SELECT (SELECT count(*) FROM split_rows_idx) AS total,
       (SELECT count(*) FROM split_rows_idx WHERE msg @@ 'm3') AS three;
----
total	three
40000	5714
