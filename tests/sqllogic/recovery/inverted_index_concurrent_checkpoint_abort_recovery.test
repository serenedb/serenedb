control substitution on

statement ok
CREATE DATABASE melstroi;


statement ok
CREATE TABLE melstroi.public.pudge (id INTEGER, body TEXT);


statement ok
CREATE INDEX pudge_hook ON melstroi.public.pudge USING inverted (body);


statement ok
INSERT INTO melstroi.public.pudge SELECT i, 'base' FROM range(0, 1000) r(i);


statement ok
CHECKPOINT melstroi;


connection papich
statement ok
BEGIN;


connection papich
query
SELECT count(*) AS n FROM melstroi.public.pudge;
----
n
1000


connection default
statement ok
INSERT INTO melstroi.public.pudge VALUES (1000, 'base');


connection default
statement ok
SET debug_checkpoint_sleep_ms = 4000;


connection default
statement ok
SET debug_checkpoint_abort = 'before_header';


connection donsimon
statement async error Checkpoint aborted before header write
CHECKPOINT melstroi;


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT melstroi%';
----
n
1


connection goshandr
statement ok
DELETE FROM melstroi.public.pudge WHERE id < 50;


connection goshandr
statement ok
INSERT INTO melstroi.public.pudge SELECT i, 'during' FROM range(2000, 2100) r(i);


connection goshandr
statement ok
DELETE FROM melstroi.public.pudge WHERE id >= 2050;


connection goshandr
statement ok
VACUUM (REFRESH_TABLE) melstroi.public.pudge;


connection donsimon
wait


connection papich
statement ok
ROLLBACK;


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM melstroi.public.pudge;
----
n
1001


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) melstroi.public.pudge;


connection after_crash
query
SELECT (SELECT count(*) FROM melstroi.public.pudge_hook) AS docs, (SELECT count(*) FROM melstroi.public.pudge_hook WHERE body @@ 'during') AS during, (SELECT count(*) FROM melstroi.public.pudge_hook WHERE body @@ 'base') AS base;
----
docs	during	base
1001	50	951
