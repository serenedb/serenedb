control substitution on

onlyif serenedb
statement ok
CREATE TEXT SEARCH DICTIONARY rek_words AS split_text(case := 'lower') WITH (frequency);

onlyif serenedb
statement ok
CREATE TABLE rek(id INTEGER PRIMARY KEY, body TEXT, n INTEGER);

onlyif serenedb
statement ok
INSERT INTO rek VALUES (1, 'The Quick Brown Fox', 10), (2, 'quick fox brown', 20);

onlyif serenedb
statement ok
CREATE INDEX rek_idx ON rek USING inverted(
    id, (lower(body)) rek_words, (lower(body)) included(), (n + 1) included());

onlyif serenedb
statement ok
INSERT INTO rek VALUES (3, 'a QUICK BROWN dog', 30);

onlyif serenedb
statement ok
CREATE TABLE rekj(id INTEGER PRIMARY KEY, doc JSON);

onlyif serenedb
statement ok
INSERT INTO rekj VALUES (1, '{"t":"quick\nbrown fox"}'), (2, '{"t":"brown quick"}');

onlyif serenedb
statement ok
CREATE INDEX rekj_idx ON rekj USING inverted(
    id, (doc->'t') rek_words, (doc->'t') included());

onlyif serenedb
statement ok
INSERT INTO rekj VALUES (3, '{"t":"a \"Quick\"\tBrown dog"}');

onlyif serenedb
statement ok
SET sdb_faults = 'crash_on_packet';

onlyif serenedb
statement error connection closed
SELECT 1;


onlyif serenedb
connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM rek ORDER BY id;
----
id
1
2
3

onlyif serenedb
connection after_crash
statement ok
VACUUM (REFRESH_TABLE) rek;

onlyif serenedb
connection after_crash
query
SELECT id, lower(body) AS l, n + 1 AS m FROM rek_idx ORDER BY id;
----
id	l	m
1	the quick brown fox	11
2	quick fox brown	21
3	a quick brown dog	31

onlyif serenedb
connection after_crash
query
SELECT id FROM rek_idx WHERE lower(body) @@ ts_phrase('quick brown') ORDER BY id;
----
id
1
3

onlyif serenedb
connection after_crash
query
SELECT id FROM rek_idx WHERE lower(body) @@ 'fox' ORDER BY id;
----
id
1
2

onlyif serenedb
connection after_crash
statement ok
VACUUM (REFRESH_TABLE) rekj;

onlyif serenedb
connection after_crash
query
SELECT id FROM rekj_idx WHERE (doc->'t') @@ ts_phrase('quick brown') ORDER BY id;
----
id
1
3

onlyif serenedb
connection after_crash
query
SELECT id FROM rekj_idx
WHERE (doc->'t') @@ ts_phrase('quick brown') OR (doc->'t') @@ ts_phrase('lazy cat')
ORDER BY id;
----
id
1
3

onlyif serenedb
connection after_crash
statement ok
DROP TABLE rekj;

onlyif serenedb
connection after_crash
statement ok
DROP TABLE rek;

onlyif serenedb
connection after_crash
statement ok
DROP TEXT SEARCH DICTIONARY rek_words;
