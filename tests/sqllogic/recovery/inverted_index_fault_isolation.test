hash-threshold 100

statement ok
CREATE TEXT SEARCH DICTIONARY en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position)


statement ok
CREATE TABLE doc (
  pk INTEGER PRIMARY KEY,
  body VARCHAR,
  label VARCHAR,
  tag INTEGER,
  ext_only VARCHAR
) WITH (compaction_interval = 0)


statement ok
CREATE INDEX doc_idx ON doc USING inverted(pk, body en) INCLUDE (label, tag)


statement ok
INSERT INTO doc VALUES (1, 'alpha one', 'a', 100, 'x-one')


statement ok
INSERT INTO doc VALUES (2, 'alpha two', 'b', 200, 'x-two')


statement ok
INSERT INTO doc VALUES (3, 'beta three', 'c', 300, 'x-three')


query
SELECT label, tag FROM doc_idx
  WHERE body @@ ts_phrase('alpha')
  ORDER BY label;
----
label	tag
a	100
b	200


