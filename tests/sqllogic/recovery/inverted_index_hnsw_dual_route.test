statement ok
SET sdb_faults = 'irs::HnswReadsColumns';


statement ok
SET sdb_hnsw_column_filter = 'fold';


query
SELECT count(*) FROM (
  SELECT id FROM route_docs WHERE half = 0
    ORDER BY emb <-> route_vec(123456) LIMIT 5) t;
