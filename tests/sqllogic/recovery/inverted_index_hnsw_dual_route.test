db error: ERROR: intentional debug error


statement ok
SET sdb_faults = '-irs::HnswColumnsStalled';


query
SELECT count(*) FROM (
  SELECT id FROM route_docs WHERE far = 1
    ORDER BY emb <-> list_transform(range(16), j -> 0.0)::FLOAT[16] LIMIT 5) t;
