control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE mr_s (id INT PRIMARY KEY, body TEXT)
  WITH (compaction_interval = 100);

statement ok
CREATE INDEX mr_s_idx ON mr_s USING inverted (body);

statement ok
CREATE TABLE mr_t (id INT, body TEXT) WITH (compaction_interval = 100);

statement ok
CREATE INDEX mr_t_idx ON mr_t USING inverted (body);

statement ok
RESET sdb_faults;

statement ok
ALTER TABLE mr_s SET (compaction_interval = 0);

statement ok
ALTER TABLE mr_t SET (compaction_interval = 0);

statement ok
INSERT INTO mr_s SELECT i, 'fox' FROM generate_series(1, 10) s(i);

statement ok
VACUUM (FLUSH_TABLE) mr_s;

query
SELECT count(*) > 0 AS ok FROM mr_s WHERE body @@ 'fox';
----
ok
t

statement ok
INSERT INTO mr_s SELECT i, 'fox' FROM generate_series(11, 20) s(i);

statement ok
VACUUM (FLUSH_TABLE) mr_s;

query
SELECT count(*) > 0 AS ok FROM mr_s WHERE body @@ 'fox';
----
ok
t

statement ok
INSERT INTO mr_s SELECT i, 'fox' FROM generate_series(21, 30) s(i);

statement ok
VACUUM (FLUSH_TABLE) mr_s;

query
SELECT count(*) > 0 AS ok FROM mr_s WHERE body @@ 'fox';
----
ok
