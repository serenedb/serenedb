ok
t

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;
----
?column?
1

connection after_crash
query
SELECT relname, list_contains(reloptions, 'compaction_interval=0') AS compaction_off
FROM pg_class WHERE relname IN ('mr_s', 'mr_t') ORDER BY relname;
----
relname	compaction_off
mr_s	t
mr_t	t

connection after_crash
statement ok
INSERT INTO mr_s SELECT i, 'fox' FROM generate_series(31, 40) s(i);

connection after_crash
statement ok
INSERT INTO mr_t SELECT i, 'fox' FROM generate_series(31, 40) s(i);

connection after_crash
query
SELECT (SELECT count(*) FROM mr_s) AS s_rows, (SELECT count(*) FROM mr_t_idx) AS t_rows;
----
s_rows	t_rows
40	40

connection after_crash
sleep 2s

connection after_crash
query
SELECT
  (SELECT value FROM sdb_metrics WHERE metric = 'num_segments'
     AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'mr_s')) AS s_segments,
  (SELECT value FROM sdb_metrics WHERE metric = 'num_segments'
     AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'mr_t')) AS t_segments;
----
s_segments	t_segments
3	3

connection after_crash
statement ok
ALTER TABLE mr_s SET (compaction_interval = 100);

connection after_crash
statement ok
ALTER TABLE mr_t SET (compaction_interval = 100);

connection after_crash
query ok retry 60 backoff 200ms
SELECT
  (SELECT value FROM sdb_metrics WHERE metric = 'num_segments'
     AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'mr_s')) AS s_segments,
  (SELECT count(*) FROM mr_s) AS s_rows,
  (SELECT value FROM sdb_metrics WHERE metric = 'num_segments'
     AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'mr_t')) AS t_segments,
  (SELECT count(*) FROM mr_t_idx) AS t_rows;
----
s_segments	s_rows	t_segments	t_rows
1	40	1	40
