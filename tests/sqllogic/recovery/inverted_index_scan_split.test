# Deletes: the bulk column scan takes the live rows of each vector from the
# mask instead of falling back to a single whole-segment walk.
onlyif serenedb
statement ok
DELETE FROM sp WHERE id % 7 = 0


onlyif serenedb
statement ok
VACUUM (REFRESH_TABLE) sp


onlyif serenedb
statement ok
SET sdb_scan_split = 'never'


onlyif serenedb
query
SELECT count(*), sum(CASE WHEN id % 7 = 0 THEN 1 ELSE 0 END), min(id)
FROM sp_idx;
----
count	sum	min
261429	0	1


onlyif serenedb
query
SELECT count(*) FROM sp_idx WHERE body @@ 'dog';
----
count
87142


onlyif serenedb
statement ok
SET sdb_scan_split = 'always'


onlyif serenedb
query
SELECT count(*), sum(CASE WHEN id % 7 = 0 THEN 1 ELSE 0 END), min(id)
FROM sp_idx;
----
count	sum	min
261429	0	1


onlyif serenedb
query
SELECT count(*) FROM sp_idx WHERE body @@ 'dog';
----
count
87142


onlyif serenedb
statement ok
SET threads = 1


onlyif serenedb
query
SELECT count(*), sum(CASE WHEN id % 7 = 0 THEN 1 ELSE 0 END), min(id)
FROM sp_idx;
----
count	sum	min
261429	0	1


onlyif serenedb
statement ok
RESET sdb_scan_split


onlyif serenedb
statement ok
RESET threads
