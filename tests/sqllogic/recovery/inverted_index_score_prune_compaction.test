hash-threshold 100

# Score pruning needs a posting longer than one block (128 docs) to have any
# block to skip, and a parallel flush cuts one segment per thread. Pin the
# flush to a single segment per batch so the fixture's term length is what
# decides.
statement ok
SET threads = 1;


statement ok
CREATE TEXT SEARCH DICTIONARY en_prune AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE TABLE prune_cons (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX prune_cons_idx ON prune_cons USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


# Segment 1: 1000 rows.
statement ok
INSERT INTO prune_cons SELECT i, CASE i % 5
    WHEN 0 THEN 'fox quick brown'
    WHEN 1 THEN 'fox lazy dog'
    WHEN 2 THEN 'cat sleeping in box'
    WHEN 3 THEN 'rabbit and fox'
    ELSE        'rare_token bird sings'
  END
  FROM generate_series(1, 1000) AS s(i);


statement ok
VACUUM (REFRESH_TABLE) prune_cons;


# Segment 2: 1000 more rows under a disjoint pk range.
statement ok
INSERT INTO prune_cons SELECT i, CASE i % 5
    WHEN 0 THEN 'fox quick brown'
    WHEN 1 THEN 'fox lazy dog'
    WHEN 2 THEN 'cat sleeping in box'
    WHEN 3 THEN 'rabbit and fox'
    ELSE        'rare_token bird sings'
  END
  FROM generate_series(2000, 2999) AS s(i);


statement ok
VACUUM (REFRESH_TABLE) prune_cons;


# === Pre-merge sanity: pruning fires on the initial-flush segments. ===

statement ok
SET sdb_faults = 'irs::PruningIterator';


statement error db error: ERROR: intentional debug error
SELECT id FROM prune_cons_idx
WHERE body @@ ts_phrase('fox')
ORDER BY BM25(prune_cons_idx.tableoid) DESC LIMIT 3;


statement ok
SET sdb_faults = '-irs::PruningIterator';


# === Force compaction into one merged segment. ===

statement ok
VACUUM (COMPACT_TABLE) prune_cons;


# Correctness sanity: the merged segment returns the right docs.
query
SELECT COUNT(*) FROM (
  SELECT id FROM prune_cons_idx
  WHERE body @@ ts_phrase('fox')
  ORDER BY BM25(prune_cons_idx.tableoid) DESC LIMIT 100
) x;
----
count
100


# === Post-merge: did the merged segment write score bounds? ===
# If yes, the fault trips. If no, the query returns clean rows.

statement ok
SET sdb_faults = 'irs::PruningIterator';


statement error db error: ERROR: intentional debug error
SELECT id FROM prune_cons_idx
WHERE body @@ ts_phrase('fox')
ORDER BY BM25(prune_cons_idx.tableoid) DESC LIMIT 3;


statement ok
SET sdb_faults = '-irs::PruningIterator';
