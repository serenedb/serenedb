# A stream scan claims whole segments, so with fewer segments than workers the
# spare workers would idle and the largest segment would bound the scan. Instead
# a worker with no segment left to claim joins one that is still being drained
# and pulls batches from its cursor under the cursor's lock.
#
# Joining is what this covers: every batch must be handed to exactly one worker,
# so the row set cannot change with the number of workers. A joiner that pulled
# a batch twice, or dropped the one it was holding when the owner finished,
# shows up here as a changed count or checksum.
#
# `threads` is instance-wide, hence the recovery subtree. Four segments are kept
# (no COMPACT_TABLE) and they are deliberately uneven -- 90k, 20k, 8k, 2k --
# since an even split would hide the imbalance joining exists to absorb.

onlyif serenedb
statement ok
SET threads = 1


onlyif serenedb
statement ok
CREATE TEXT SEARCH DICTIONARY sc_en
  (template = 'delimiter', delimiter = ' ', frequency = true, position = true)


onlyif serenedb
statement ok
CREATE TABLE sc (id INT PRIMARY KEY, body TEXT, g INT, tag TEXT)


onlyif serenedb
statement ok
CREATE INDEX sc_idx ON sc USING inverted (id, body sc_en) INCLUDE (g, tag)
  WITH (refresh_interval = 0, compaction_interval = 0)


# Four refreshes of unequal size seal four segments of unequal size.
onlyif serenedb
statement ok
INSERT INTO sc SELECT i, CASE WHEN i % 3 = 0 THEN 'fox dog' ELSE 'fox' END,
       i % 997, 't' || (i % 31)
FROM range(90000) t(i)

onlyif serenedb
statement ok
VACUUM (REFRESH_TABLE) sc

onlyif serenedb
statement ok
INSERT INTO sc SELECT i, CASE WHEN i % 3 = 0 THEN 'fox dog' ELSE 'fox' END,
       i % 997, 't' || (i % 31)
FROM range(90000, 110000) t(i)

onlyif serenedb
statement ok
VACUUM (REFRESH_TABLE) sc

onlyif serenedb
statement ok
INSERT INTO sc SELECT i, CASE WHEN i % 3 = 0 THEN 'fox dog' ELSE 'fox' END,
       i % 997, 't' || (i % 31)
FROM range(110000, 118000) t(i)

onlyif serenedb
statement ok
VACUUM (REFRESH_TABLE) sc

onlyif serenedb
statement ok
INSERT INTO sc SELECT i, CASE WHEN i % 3 = 0 THEN 'fox dog' ELSE 'fox' END,
       i % 997, 't' || (i % 31)
FROM range(118000, 120000) t(i)

onlyif serenedb
statement ok
VACUUM (REFRESH_TABLE) sc


# One worker: no one can join, so this is the reference row set.

onlyif serenedb
query
SELECT count(*) AS n, sum(id)::BIGINT AS ids, sum(g)::BIGINT AS gs,
       sum(hash(tag))::HUGEINT AS tags
FROM sc_idx;
----
n	ids	gs	tags
120000	7199940000	59645340	1125555325021297682213777


onlyif serenedb
query
SELECT count(*) AS n, sum(id)::BIGINT AS ids
FROM sc_idx WHERE body @@ 'dog';
----
n	ids
40000	2399940000


# A filter on an INCLUDE-only column is verified per document, which a shared
# cursor cannot hand out, so this one keeps a segment per worker. It is here as
# the contrast: the same answer has to come back either way.
onlyif serenedb
query
SELECT count(*) AS n, sum(id)::BIGINT AS ids
FROM sc_idx WHERE g < 300;
----
n	ids
36300	2176892850


# Four segments against sixteen workers: twelve of them have nothing to claim
# and join a cursor instead, and the answers must not move a row.

onlyif serenedb
statement ok
SET threads = 16


onlyif serenedb
query
SELECT count(*) AS n, sum(id)::BIGINT AS ids, sum(g)::BIGINT AS gs,
       sum(hash(tag))::HUGEINT AS tags
FROM sc_idx;
----
n	ids	gs	tags
120000	7199940000	59645340	1125555325021297682213777


onlyif serenedb
query
SELECT count(*) AS n, sum(id)::BIGINT AS ids
FROM sc_idx WHERE body @@ 'dog';
----
n	ids
40000	2399940000


onlyif serenedb
query
SELECT count(*) AS n, sum(id)::BIGINT AS ids
FROM sc_idx WHERE g < 300;
----
n	ids
36300	2176892850


# A projection that needs the lookup source takes the same joined cursor, and
# the rows it materialises are the same ones.

onlyif serenedb
query
SELECT count(*) AS n, sum(length(body))::BIGINT AS body_len
FROM sc_idx WHERE body @@ 'fox';
----
n	body_len
120000	520000


onlyif serenedb
statement ok
SET threads = 1


onlyif serenedb
query
SELECT count(*) AS n, sum(length(body))::BIGINT AS body_len
FROM sc_idx WHERE body @@ 'fox';
----
n	body_len
120000	520000
