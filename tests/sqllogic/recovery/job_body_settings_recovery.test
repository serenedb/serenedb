control substitution on


statement ok
RESET sdb_faults;


statement ok
CREATE TABLE jbsr_log (via TEXT, v TEXT);


statement ok
CREATE TABLE "Jbsr_Q" (via TEXT);


statement ok
CREATE TABLE jbsr_q (via TEXT);


statement ok
CREATE JOB jbsr_checkpointed AFTER 1 HOUR AS 'INSERT INTO jbsr_log SELECT ''checkpointed'', (7 / 2)::TEXT; INSERT INTO Jbsr_Q VALUES (''checkpointed'');';


statement ok
CREATE JOB jbsr_parent AFTER 1 HOUR AS 'CREATE JOB jbsr_child AFTER 1 HOUR AS ''INSERT INTO jbsr_log SELECT ''''child'''', (7 / 2)::TEXT; INSERT INTO Jbsr_Q VALUES (''''child'''');''';



statement ok
FORCE CHECKPOINT;


statement ok
CREATE JOB jbsr_logged AFTER 1 HOUR AS 'INSERT INTO jbsr_log SELECT ''logged'', (7 / 2)::TEXT; INSERT INTO Jbsr_Q VALUES (''logged'');';


statement ok
CREATE JOB jbsr_parent_script AFTER 1 HOUR AS 'CREATE JOB jbsr_child_script AFTER 1 HOUR AS ''INSERT INTO jbsr_log SELECT ''''child script'''', (7 / 2)::TEXT; INSERT INTO Jbsr_Q VALUES (''''child script'''');''; SELECT 1;';


statement ok
SET integer_division = false;


statement ok
SET regex_match_operator_semantics = 'full';


statement ok
CREATE JOB jbsr_duckdb AFTER 1 HOUR AS 'INSERT INTO jbsr_log SELECT ''duckdb'', (7 / 2)::TEXT || '' '' || (''abc'' ~ ''b'')::TEXT; SELECT 1;';


statement ok
RESET integer_division;


statement ok
RESET regex_match_operator_semantics;


statement ok
SET sdb_faults = 'job_info_without_body_parser_options';


statement ok
CREATE JOB jbsr_older AFTER 1 HOUR AS 'INSERT INTO jbsr_log SELECT ''older'', (7 / 2)::TEXT; INSERT INTO Jbsr_Q VALUES (''older'');';


statement ok
RESET sdb_faults;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
