statement ok
CREATE TABLE jot_log (id INT);


statement ok
CREATE JOB jot_open AFTER 1 HOUR SUSPENDED
  AS $$BEGIN; SET LOCAL client_min_messages = 'warning'; INSERT INTO jot_log VALUES (1);$$;


statement ok
EXECUTE JOB jot_open;


