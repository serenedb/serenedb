statement ok
CREATE TABLE jsi_log (step INT);


statement ok
CREATE JOB jsi_dropped AFTER 1 HOUR AS 'INSERT INTO jsi_log VALUES (1); INSERT INTO jsi_log VALUES (2);';


statement ok
SET sdb_faults = 'pause_job_after_statement';


connection runner
statement async error canceling statement due to user request
EXECUTE JOB jsi_dropped;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_job_after_statement:parked';


connection default
statement ok
DROP JOB jsi_dropped;


connection default
statement ok
SET sdb_faults = 'pause_job_after_statement:release';


connection runner
wait


connection default
query
