control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE build_fail (id BIGINT, msg TEXT) WITH (compaction_interval = 0);


statement ok
INSERT INTO build_fail SELECT i, 'm' || (i % 7) FROM range(2000) t(i);


statement ok
CREATE VIEW build_fail_v AS SELECT id, msg FROM build_fail;


statement ok
SET sdb_faults = 'Search::FailOnCommit';


statement error
CREATE INDEX build_fail_idx ON build_fail_v USING inverted (id, msg);
----
db error: ERROR: debug failure point


statement ok
SET sdb_faults = '-Search::FailOnCommit';


statement ok
INSERT INTO build_fail VALUES (2000, 'after');


statement ok
CREATE INDEX build_fail_idx ON build_fail_v USING inverted (id, msg);


query
SELECT (SELECT count(*) FROM build_fail_idx) AS total,
       (SELECT count(*) FROM build_fail_idx WHERE msg @@ 'm3') AS three,
       (SELECT count(*) FROM build_fail_idx WHERE msg @@ 'after') AS after;
----
total	three	after
2001	286	1


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM build_fail;
----
n
2001


connection after_crash
statement ok
VACUUM (FLUSH_TABLE) build_fail;


connection after_crash
query
SELECT (SELECT count(*) FROM build_fail_idx) AS total,
       (SELECT count(*) FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid
        WHERE c.relname = 'build_fail_idx') AS indexes;
----
total	indexes
2001	1
