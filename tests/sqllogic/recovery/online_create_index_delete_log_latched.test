control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE latch_docs (id BIGINT, msg TEXT);


statement ok
INSERT INTO latch_docs SELECT i, 'm' || (i % 7) FROM range(5000) t(i);


statement ok
SET sdb_faults = 'pause_create_index_mid_build';


connection builder
statement async ok
CREATE INDEX latch_idx ON latch_docs USING inverted (id, msg)
  WITH (refresh_interval = 0, compaction_interval = 0);


connection default
query ok retry 40 backoff 250ms
SELECT count(*) FROM pg_stat_progress_create_index
WHERE relid = 'latch_docs'::regclass AND phase = 'building index';
----
count
1


connection default
statement ok
SET sdb_faults = 'inverted_delete_rows_logged';


connection deleter
statement async ok
DELETE FROM latch_docs WHERE id < 100;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-inverted_delete_rows_logged:parked';


connection default
statement ok
SET sdb_faults = 'create_index_delete_log_taken';


connection default
statement ok
SET sdb_faults = '-pause_create_index_mid_build';


connection default
statement ok retry 80 backoff 250ms
SET sdb_faults = '-create_index_delete_log_taken:parked';


connection default
statement ok
SET sdb_faults = 'inverted_delete_rows_logged:release';


connection default
statement ok
SET sdb_faults = 'create_index_delete_log_taken:release';


wait


connection default
statement ok
VACUUM (REFRESH_TABLE) latch_docs;


connection default
query
SELECT (SELECT count(*) FROM latch_idx) AS total,
       (SELECT count(*) FROM latch_idx WHERE id < 100) AS deleted;
----
total	deleted
4900	0


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM latch_docs;
----
n
4900


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) latch_docs;


connection after_crash
query
SELECT (SELECT count(*) FROM latch_idx) AS total,
       (SELECT count(*) FROM latch_idx WHERE id < 100) AS deleted;
----
total	deleted
4900	0
