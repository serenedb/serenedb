control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TABLE removal_fail (id BIGINT, msg TEXT);


statement ok
INSERT INTO removal_fail SELECT i, 'm' || (i % 7) FROM range(5000) t(i);


statement ok
SET sdb_faults = 'pause_create_index_mid_build';


connection builder
statement async error failed to commit a removal: out of memory
CREATE INDEX removal_fail_idx ON removal_fail USING inverted (id, msg)
  WITH (refresh_interval = 0, compaction_interval = 0);


connection default
query ok retry 40 backoff 250ms
SELECT count(*) FROM pg_stat_progress_create_index
WHERE relid = 'removal_fail'::regclass AND phase = 'building index';
----
count
1


connection default
statement ok retry 20 backoff 500ms
DELETE FROM removal_fail WHERE id < 100;


connection default
statement ok
SET sdb_faults = 'create_index_delete_log_taken';


connection default
statement ok
SET sdb_faults = '-pause_create_index_mid_build';


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-create_index_delete_log_taken:parked';


connection default
statement ok
SET sdb_faults = 'IndexWriter::Transaction::Commit';


connection default
statement ok
SET sdb_faults = 'create_index_delete_log_taken:release';


wait


connection default
statement ok
SET sdb_faults = '-IndexWriter::Transaction::Commit';


connection default
statement ok
CREATE INDEX removal_fail_idx ON removal_fail USING inverted (id, msg)
  WITH (refresh_interval = 0, compaction_interval = 0);


connection default
statement ok
VACUUM (REFRESH_TABLE) removal_fail;


connection default
query
SELECT (SELECT count(*) FROM removal_fail_idx) AS total,
       (SELECT count(*) FROM removal_fail_idx WHERE id < 100) AS deleted;
