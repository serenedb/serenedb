total	deleted
4900	0


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM removal_fail;
----
n
4900


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) removal_fail;


connection after_crash
query
SELECT (SELECT count(*) FROM removal_fail_idx) AS total,
       (SELECT count(*) FROM removal_fail_idx WHERE id < 100) AS deleted,
       (SELECT count(*) FROM pg_indexes WHERE tablename = 'removal_fail') AS indexes;
