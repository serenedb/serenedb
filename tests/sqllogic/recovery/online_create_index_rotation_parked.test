# An online inverted CREATE INDEX cuts its backfill into segments of
# segment_docs_max docs as it goes rather than once at the end:
# pause_create_index_mid_build parks each sink thread after a batch, and the
# finished index carries the several segments those cuts produced.
#
# The segment count is read after the build commits, not while it is parked:
# an uncommitted index belongs to the building transaction and PG 18 shows it
# to no other session, so sdb_metrics -- which resolves per-index rows through
# the reader's catalog snapshot -- has no row for it to report on. What the
# parked window can still be observed by is the live progress view, which is
# what gates the assertions below. Requires SDB_FAULT_INJECTION, like the rest
# of the recovery suite.


statement ok
RESET sdb_faults;


statement ok
CREATE TABLE oci_park(x bigint, label text);


statement ok
INSERT INTO oci_park SELECT g, repeat(md5(g::text), 4) FROM generate_series(1, 50000) g;


statement ok
SET sdb_faults = 'pause_create_index_mid_build';


connection builder
statement async ok
CREATE INDEX oci_park_idx ON oci_park USING inverted(label) WITH (segment_docs_max = 1000, compaction_interval = 3600000);


# The build has parked after a batch, which is the window the fault exists to
# hold open.
connection default
query ok retry 40 backoff 250ms
SELECT count(*) FROM pg_stat_progress_create_index
WHERE relid = 'oci_park'::regclass AND phase = 'building index';
----
count
1


statement ok
SET sdb_faults = '-pause_create_index_mid_build';


wait


query
SELECT count(*) FROM oci_park_idx;
----
count
50000


# Several segments, not one: the build cut a segment every segment_docs_max
# docs, and compaction is disabled for the run.
query
SELECT value::bigint > 1 AS rotated FROM sdb_metrics
WHERE metric = 'num_segments'
  AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'oci_park_idx');
----
rotated
t


statement ok
RESET sdb_faults;


statement ok
DROP TABLE oci_park CASCADE;
