control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE ocsq_other (x BIGINT, body TEXT);


statement ok
CREATE INDEX ocsq_other_idx ON ocsq_other USING inverted (body);


statement ok
CREATE TEXT SEARCH DICTIONARY ocsq_upper AS split_text_csv(',') | (lambda x: upper(x));


statement ok
CREATE TABLE ocsq (x BIGINT, body TEXT);


statement ok
INSERT INTO ocsq SELECT i, 'seed,' || i FROM range(5000) t(i);


connection writer
statement ok
BEGIN;


connection writer
statement ok
INSERT INTO ocsq VALUES (100001, 'late,fresh');


connection default
statement ok
SET sdb_faults = 'commit_feed_prepared';


connection writer
statement async ok
COMMIT;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-commit_feed_prepared:parked';


connection default
statement ok
SET sdb_faults = 'pause_create_index_mid_build';


connection builder
statement async ok
CREATE INDEX ocsq_idx ON ocsq USING inverted (body ocsq_upper);


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS building FROM pg_stat_progress_create_index
WHERE relid = 'ocsq'::regclass AND tuples_done > 0;
----
building
1


connection default
statement ok
SET sdb_faults = 'commit_feed_prepared:release';


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS committed FROM ocsq WHERE x = 100001;
----
committed
1


connection default
statement ok
SET sdb_faults = '-pause_create_index_mid_build';


wait


connection default
statement ok
VACUUM (REFRESH_TABLE) ocsq;


connection default
query
SELECT (SELECT count(*) FROM ocsq_idx) AS indexed,
       (SELECT count(*) FROM ocsq_idx WHERE body @@ 'fresh') AS fresh;
----
indexed	fresh
5001	1
