control substitution on

# A sequence a table owns -- a SERIAL's -- is read back from the record that
# created the table, not from a record of its own. The sequence is a relation of
# its schema like any other. It hangs off the table in the containment tree, so
# a boot that seeds the catalog sets from the schema's own children alone leaves
# it out of pg_class entirely, which no other test asserts.

statement ok
CREATE SCHEMA ows;

statement ok
CREATE TABLE ows.ser(id SERIAL, note TEXT);

statement ok
INSERT INTO ows.ser(note) VALUES ('a'), ('b');

# A search table owns no sequence: its rowid is the row's position.
statement ok
CREATE TABLE ows.st(a INTEGER, txt TEXT) WITH (storage = 'search');

statement ok
INSERT INTO ows.st VALUES (1, 'one');

# Rewrites both definitions, so the record each table comes back from is not the
# one that named its sequence.
statement ok
COMMENT ON TABLE ows.ser IS 'serial';

statement ok
COMMENT ON TABLE ows.st IS 'search';

query
SELECT relname, relkind FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname = 'ows'
WHERE relkind = 'S' ORDER BY relname;
----
relname	relkind
ser_id_seq	S


# The entries as the statements that created them left them, so the comparison
# after the restart is against what this session actually holds rather than a
# literal.
statement ok
CREATE TABLE ows.before(entry_type TEXT, name TEXT,
                        PRIMARY KEY (entry_type, name));

statement ok
INSERT INTO ows.before
SELECT entry_type, name FROM sdb_catalog_sets()
WHERE schema_name = 'ows' AND name NOT LIKE 'before%';

query
SELECT entry_type, name FROM ows.before
WHERE entry_type = 'Sequence' ORDER BY name;
----
entry_type	name
Sequence	ser_id_seq


statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM ows.ser;
----
count
2

# The owned sequence is back in the schema's relation namespace.
connection after_crash
query
SELECT relname, relkind FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname = 'ows'
WHERE relkind = 'S' ORDER BY relname;
----
relname	relkind
ser_id_seq	S


connection after_crash
query
SELECT b.entry_type, b.name,
       (SELECT count(*) FROM sdb_catalog_sets() s
        WHERE s.schema_name = 'ows' AND s.entry_type = b.entry_type
          AND s.name = b.name) AS after
FROM ows.before b ORDER BY 1, 2;
----
entry_type	name	after
Schema	ows	1
Sequence	ser_id_seq	1
Table	ser	1
Table	st	1


# The counter came back with it, so the next value is past every value handed
# out before the crash rather than a repeat of one.
connection after_crash
query
SELECT nextval('ows.ser_id_seq') > 2 AS moved_on;
----
moved_on
t


connection after_crash
statement ok
INSERT INTO ows.st VALUES (2, 'two');

connection after_crash
statement ok
VACUUM (REFRESH_TABLE) ows.st;

connection after_crash
query
SELECT count(*) AS rows, count(DISTINCT rowid) AS rowids FROM ows.st;
----
rows	rowids
2	2


connection after_crash
statement ok
INSERT INTO ows.ser(note) VALUES ('c');

connection after_crash
query
SELECT count(DISTINCT id) AS distinct_ids, count(*) AS rows FROM ows.ser;
----
distinct_ids	rows
3	3
