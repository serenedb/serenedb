# duckdb introspection works for every SereneDB relation kind: transactional
# (facade) tables, search tables, inverted-index and secondary-index
# FROM-index entries, and views -- via the table-function, PRAGMA, and CALL
# spellings of pragma_table_info / pragma_storage_info / pragma_database_size.

statement ok
CREATE TABLE pin_txn (i INTEGER PRIMARY KEY, s VARCHAR USING COMPRESSION zstd, j INTEGER);

statement ok
INSERT INTO pin_txn SELECT i, md5(i::VARCHAR), i * 2 FROM generate_series(0, 4999) t(i);

statement ok
CREATE TABLE pin_search (i INTEGER PRIMARY KEY, s VARCHAR, tags VARCHAR[], info STRUCT(a INTEGER, b VARCHAR), maybe INTEGER) WITH (storage = 'search');

statement ok
INSERT INTO pin_search SELECT i, 'v' || i, ['x', 'y'], {'a': i, 'b': 'w' || i}, CASE WHEN i % 2 = 0 THEN i ELSE NULL END FROM generate_series(0, 1999) t(i);

statement ok
CREATE INDEX pin_inv ON pin_txn USING inverted (s);

statement ok
CREATE INDEX pin_inc ON pin_txn USING inverted (s, j included());

statement ok
CREATE INDEX pin_sec ON pin_txn (j);

statement ok
CREATE VIEW pin_view AS SELECT i, s FROM pin_txn;


# --- pragma_table_info: every relation kind + both spellings ---------------

query
SELECT * FROM pragma_table_info('pin_txn');
----
cid	name	type	notnull	dflt_value	pk
0	i	INTEGER	t	NULL	t
1	s	VARCHAR	f	NULL	f
2	j	INTEGER	f	NULL	f


query
PRAGMA table_info('pin_search');
----
cid	name	type	notnull	dflt_value	pk
0	i	INTEGER	t	NULL	t
1	s	VARCHAR	f	NULL	f
2	tags	VARCHAR[]	f	NULL	f
3	info	STRUCT(a INTEGER, b VARCHAR)	f	NULL	f
4	maybe	INTEGER	f	NULL	f


# An index is readable as a relation through the replacement scan, but a pragma
# takes a name and resolves it in the catalog's table set, where an index is not:
# `duckdb_indexes()` is what describes an index.
query
SELECT count(*) FROM pin_inv;
----
count
5000


statement error
SELECT * FROM pragma_table_info('pin_inv');
----
db error: ERROR: Table with name pin_inv does not exist!<slt:ignore>


statement error
SELECT * FROM pragma_table_info('pin_sec');
----
db error: ERROR: Table with name pin_sec does not exist!<slt:ignore>


query
SELECT index_name, table_name FROM duckdb_indexes()
WHERE table_name = 'pin_txn' ORDER BY index_name;
----
index_name	table_name
pin_inc	pin_txn
pin_inv	pin_txn
pin_sec	pin_txn


query
SELECT * FROM pragma_table_info('pin_view');
----
cid	name	type	notnull	dflt_value	pk
0	i	INTEGER	f	NULL	f
1	s	VARCHAR	f	NULL	f


# --- pragma_storage_info: transactional facade table -----------------------

# CHECKPOINT compresses appended rows so the forced zstd column is observable.
statement ok
CHECKPOINT;

query
SELECT DISTINCT column_name, compression FROM pragma_storage_info('pin_txn') WHERE segment_type = 'VARCHAR';
----
column_name	compression
s	ZSTD


query
SELECT DISTINCT column_name FROM pragma_storage_info('pin_txn') ORDER BY 1;
----
column_name
i
j
s


# --- pragma_storage_info: search table --------------------------------------

# Flush the staged rows into iresearch segments deterministically.
statement ok
VACUUM (REFRESH_TABLE) pin_search;

# storage_info describes duckdb's row-group column segments. A search table keeps
# its columns in iresearch segments instead, so it reports none of those -- what
# it holds is described by the search catalog views.
query
SELECT count(*) FROM pragma_storage_info('pin_search');
----
count
0


# A search table without a declared PK stores a synthetic generated PK; it
# surfaces under the "rowid" virtual column with a NULL column_id.
statement ok
CREATE TABLE pin_nopk (s VARCHAR) WITH (storage = 'search');

statement ok
INSERT INTO pin_nopk VALUES ('a'), ('b');

statement ok
VACUUM (REFRESH_TABLE) pin_nopk;

query
SELECT count(*) FROM pragma_storage_info('pin_nopk');
----
count
0


# --- pragma_storage_info: FROM-index entries -------------------------------

statement ok
VACUUM (REFRESH_TABLE) pin_txn;

# storage_info resolves a name in the catalog's table set, so an index name is
# not a target for it.
statement error
SELECT * FROM pragma_storage_info('pin_inc');
----
db error: ERROR: Table with name pin_inc does not exist!<slt:ignore>


statement error
SELECT * FROM pragma_storage_info('pin_inv');
----
db error: ERROR: Table with name pin_inv does not exist!<slt:ignore>


statement error
SELECT * FROM pragma_storage_info('pin_sec');
----
db error: ERROR: Table with name pin_sec does not exist!<slt:ignore>


# Views have no storage.
statement error
PRAGMA storage_info('pin_view');
----
db error: ERROR: pin_view is not an table


# --- CALL spelling ----------------------------------------------------------

query
SELECT count(*) > 0 FROM (SELECT * FROM pragma_storage_info('pin_txn'));
----
?column?
t


# --- pragma_database_size ---------------------------------------------------

# One row per attached database. A database's rows live in its own file, so its
# size covers its own tables plus its search data and is non-zero here.
query
SELECT count(*) FROM pragma_database_size() WHERE database_name = current_database();
----
count
1


query
SELECT database_size <> '0 bytes', block_size > 0 FROM pragma_database_size() WHERE database_name = current_database();
----
?column?	?column?
t	t


statement ok
DROP TABLE pin_txn CASCADE;

statement ok
DROP TABLE pin_search;

statement ok
DROP TABLE pin_nopk;
