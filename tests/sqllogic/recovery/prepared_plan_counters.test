statement ok
CREATE TABLE ppc (id INT PRIMARY KEY, u INT UNIQUE, v INT);


statement ok
INSERT INTO ppc SELECT i, i + 1000, i % 10 FROM generate_series(1, 100) g(i);


statement ok
CREATE TABLE ppc_child (id INT PRIMARY KEY, parent INT REFERENCES ppc (id), w INT);


statement ok
INSERT INTO ppc_child SELECT i, i % 10 + 1, i FROM generate_series(1, 50) g(i);


statement ok
CREATE TABLE ppc_side (x INT);


statement ok
INSERT INTO ppc_side SELECT i FROM generate_series(1, 10) g(i);


statement ok
PREPARE ppc_scan AS SELECT count(*) AS n FROM ppc;


statement ok
PREPARE ppc_pk(INT) AS SELECT v FROM ppc WHERE id = $1;


statement ok
PREPARE ppc_uk(INT) AS SELECT v FROM ppc WHERE u = $1;


statement ok
PREPARE ppc_fk(INT) AS SELECT count(*) AS n FROM ppc_child WHERE parent = $1;


statement ok
PREPARE ppc_const(INT) AS SELECT $1 + 1 AS r;


statement ok
PREPARE ppc_mixed(INT) AS SELECT v AS r FROM ppc WHERE id = $1 UNION ALL SELECT x FROM ppc_side WHERE x > 100;


statement ok
PREPARE ppc_filter(INT) AS SELECT count(*) AS n FROM ppc WHERE v > $1;


statement ok
PREPARE ppc_filter_lit AS SELECT count(*) AS n FROM ppc WHERE v > 5;


statement ok
PREPARE ppc_now AS SELECT count(*) AS n FROM ppc WHERE now() IS NOT NULL;


