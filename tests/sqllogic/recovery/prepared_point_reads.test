CREATE TABLE ppr (id INT PRIMARY KEY, v INT);


statement ok
INSERT INTO ppr SELECT i, i FROM generate_series(1, 1000) g(i);


statement ok
PREPARE ppr_upd(INT, INT) AS UPDATE ppr SET v = v + $2 WHERE id = $1;


statement ok
EXECUTE ppr_upd(5, 10);


statement ok
EXECUTE ppr_upd(5, 10);


statement ok
INSERT INTO ppr VALUES (2000, 1);


statement ok
EXECUTE ppr_upd(2000, 5);


query
SELECT id, v FROM ppr WHERE id IN (5, 2000) ORDER BY id;
