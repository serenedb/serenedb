statement ok
CREATE TABLE ppr_side (x INT);


statement ok
INSERT INTO ppr_side SELECT i FROM generate_series(1, 500) g(i);


statement ok
PREPARE ppr_union(INT) AS SELECT v AS r FROM ppr WHERE id = $1 UNION ALL SELECT x FROM ppr_side WHERE x > 1000;


query ? rowsort
EXECUTE ppr_union(1);
----
r
1


statement ok
INSERT INTO ppr_side VALUES (2000);


query ? rowsort
EXECUTE ppr_union(1);
----
r
1
2000


statement ok
CREATE TABLE ppr_child (id INT PRIMARY KEY, parent INT REFERENCES ppr (id), v INT);


statement ok
INSERT INTO ppr_child SELECT i, i % 5 + 1, 0 FROM generate_series(1, 100) g(i);


statement ok
PREPARE ppr_child_upd(INT, INT) AS UPDATE ppr_child SET v = v + $2 WHERE parent = $1;


statement ok
EXECUTE ppr_child_upd(5, 10);


statement ok
INSERT INTO ppr_child VALUES (101, 5, 0);


statement ok
EXECUTE ppr_child_upd(5, 10);


query
SELECT count(*) AS n, sum(v) AS s FROM ppr_child WHERE parent = 5;
----
n	s
21	410


statement ok
PREPARE ppr_child_max(INT) AS SELECT max(v) AS m FROM ppr_child WHERE parent = $1;


query
EXECUTE ppr_child_max(5);
----
m
