statement ok
CREATE TABLE pro (id INT PRIMARY KEY, v INT);


statement ok
INSERT INTO pro SELECT i, i FROM generate_series(1, 100) g(i);


statement ok
CREATE TABLE pro_log (x INT);


statement ok
PREPARE pro_ins(INT) AS INSERT INTO pro_log VALUES ($1);


statement ok
PREPARE pro_scan AS SELECT count(*) AS n FROM pro;


statement ok
PREPARE pro_pk(INT) AS SELECT v FROM pro WHERE id = $1;


statement ok
PREPARE pro_const AS SELECT 1 AS r;


statement ok
EXECUTE pro_scan;


statement ok
EXECUTE pro_pk(1);


statement ok
EXECUTE pro_const;


statement ok
