control substitution on

statement ok
CREATE OR REPLACE SECRET rfs_${__DATABASE__} (
  TYPE s3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/${__DATABASE__}_rfs'
);


statement ok
SET GLOBAL s3_endpoint = '${MINIO_HOST}:${MINIO_PORT}';


statement ok
SET GLOBAL s3_url_style = 'path';


statement ok
SET GLOBAL s3_use_ssl = false;


statement ok
COPY (SELECT 'hunter2' AS top_secret) TO 's3://${MINIO_BUCKET}/${__DATABASE__}_rfs/private.csv' (HEADER);


query
SELECT strpos(content, 'hunter2') > 0 AS readable FROM read_text('s3://${MINIO_BUCKET}/${__DATABASE__}_rfs/private.csv');
----
readable
t


statement ok
CREATE ROLE rfs_reader LOGIN PASSWORD 'rfs_pw';


statement ok
GRANT pg_read_server_files TO rfs_reader;


connection c_reader user=rfs_reader password=rfs_pw
statement error
SELECT strpos(content, 'hunter2') > 0 AS readable FROM read_text('s3://${MINIO_BUCKET}/${__DATABASE__}_rfs/private.csv');
----
db error: ERROR: <slt:ignore>403<slt:ignore>


connection c_reader user=rfs_reader password=rfs_pw
statement error
SELECT "Columns" FROM sniff_csv('s3://${MINIO_BUCKET}/${__DATABASE__}_rfs/private.csv');
----
db error: ERROR: <slt:ignore>403<slt:ignore>


statement ok
CREATE VIEW rfs_view AS SELECT strpos(content, 'hunter2') > 0 AS readable FROM read_text('s3://${MINIO_BUCKET}/${__DATABASE__}_rfs/private.csv');


statement ok
GRANT SELECT ON rfs_view TO rfs_reader;


connection c_reader user=rfs_reader password=rfs_pw
query
SELECT readable FROM rfs_view;
----
readable
t


connection c_reader user=rfs_reader password=rfs_pw
statement error
SELECT v.readable, t.content FROM rfs_view v, read_text('s3://${MINIO_BUCKET}/${__DATABASE__}_rfs/private.csv') t;
----
db error: ERROR: <slt:ignore>403<slt:ignore>


statement ok
DROP VIEW rfs_view;


statement ok
DROP SECRET rfs_${__DATABASE__};


statement ok
DROP ROLE rfs_reader;
