control substitution on

statement ok
COPY (SELECT range AS src, range + 1 AS dst FROM range(100000)) TO '${__TEST_DIR__}/edges.parquet' (FORMAT PARQUET);


statement ok
SET GLOBAL threads = 1;


query
WITH RECURSIVE reach(n) AS (SELECT 0 UNION SELECT e.dst FROM reach JOIN '${__TEST_DIR__}/edges.parquet' e ON e.src = reach.n WHERE reach.n < 5) SELECT count(*) FROM reach;
----
count
6


