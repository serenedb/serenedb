control substitution on

statement ok
RESET sdb_faults;


statement ok
COPY (SELECT i AS id, 'doc ' || i AS body FROM range(5) t(i)) TO '${__TEST_DIR__}/rcp_1.parquet' (FORMAT parquet);


statement ok
CREATE TEXT SEARCH DICTIONARY rcp_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE VIEW rcp_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/rcp_*.parquet');


statement ok
CREATE INDEX rcp_idx ON rcp_v USING inverted(id, body rcp_en);


statement ok
COPY (SELECT i AS id, 'doc ' || i AS body FROM range(5, 8) t(i)) TO '${__TEST_DIR__}/rcp_2.parquet' (FORMAT parquet);


statement ok
SET sdb_faults = 'pause_reindex_before_pass';


connection rcp_cancelled
statement async error
SELECT * FROM sdb_reindex('rcp_idx');
----
db error: ERROR: canceling statement due to user request


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_reindex_before_pass:parked';


connection default
query
SELECT pg_cancel_backend(pid) AS cancelled FROM pg_stat_activity WHERE query LIKE 'SELECT * FROM sdb_reindex(%' AND pid <> pg_backend_pid();
----
cancelled
t


connection default
statement ok
SET sdb_faults = 'pause_reindex_before_pass:release';


wait


connection default
statement ok
RESET sdb_faults;


connection default
query
SELECT count(*) AS indexed FROM rcp_idx WHERE body @@ ts_phrase('doc');
----
indexed
5


connection default
statement ok
SELECT * FROM sdb_reindex('rcp_idx');


connection default
query
SELECT count(*) AS indexed FROM rcp_idx WHERE body @@ ts_phrase('doc');
----
indexed
8


connection default
statement ok
DROP INDEX rcp_idx;


connection default
statement ok
DROP VIEW rcp_v;
