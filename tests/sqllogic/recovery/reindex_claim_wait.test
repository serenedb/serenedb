control substitution on

statement ok
RESET sdb_faults;

statement ok
COPY (SELECT i AS id, 'doc ' || i AS body FROM range(5) t(i)) TO '${__TEST_DIR__}/rcw_1.parquet' (FORMAT parquet);

statement ok
CREATE TEXT SEARCH DICTIONARY rcw_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE VIEW rcw_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/rcw_*.parquet');

statement ok
CREATE INDEX rcw_idx ON rcw_v USING inverted(id, body rcw_en);

statement ok
SET sdb_faults = 'pause_reindex_claimed';

connection holder
statement async ok
SELECT * FROM serenedb_reindex('rcw_idx');

connection default
query ok retry 40 backoff 250ms
SELECT phase FROM pg_stat_progress_create_index WHERE command = 'REINDEX' AND index_relid = 'rcw_idx'::regclass;
----
phase
refreshing index

connection canceled
