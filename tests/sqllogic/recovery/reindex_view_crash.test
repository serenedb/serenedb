control substitution on

# REINDEX crash windows. The rebuild stages the full source UNCOMMITTED into
# the live index and its Finalize commits a remove-all below the staged
# batches, publishing old->new as one reader swap. A crash on either side
# must leave exactly one complete index:
#   - before the publish: nothing was committed, so boot serves the
#     pre-REINDEX content (staged segment files are unreferenced and swept
#     by the writer's own open-time cleanup).
#   - after the publish: the swap is durable; boot serves the rebuilt
#     content, the fully-masked old segments are already gone from the meta.
# The delta path has one window of its own (v1 contract: the removes are
# their own self-publishing query): a crash after the per-file scans but
# before the publish keeps the removes -- the rewritten file's old docs are
# durably gone -- while the staged inserts evaporate and the manifest stays
# put, so the re-run computes the identical diff and heals.

statement count 4
COPY (SELECT 1 AS id, 'pudge goes mid' AS body
      UNION ALL SELECT 2, 'anchin reads manga'
      UNION ALL SELECT 3, 'pudge plays again'
      UNION ALL SELECT 4, 'vedernikoff plans crash tests')
TO '${__TEST_DIR__}/reindex_crash.parquet' (FORMAT PARQUET);

statement ok
CREATE TEXT SEARCH DICTIONARY reindex_crash_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE VIEW reindex_crash_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/reindex_crash.parquet');

statement ok
CREATE INDEX reindex_crash_idx ON reindex_crash_v USING inverted(id, body reindex_crash_en);

query
SELECT count(*) FROM reindex_crash_idx WHERE body @@ ts_phrase('pudge');
----
count
2

# Crash BEFORE the publish: everything is staged, nothing is committed.

statement count 5
COPY (SELECT 10 AS id, 'pudge goes mid' AS body
      UNION ALL SELECT 11, 'pudge farms jungle'
      UNION ALL SELECT 12, 'anchin reads manga'
      UNION ALL SELECT 13, 'pudge plays again'
      UNION ALL SELECT 14, 'vedernikoff survives restarts')
TO '${__TEST_DIR__}/reindex_crash.parquet' (FORMAT PARQUET);

statement ok
SET sdb_faults = 'crash_before_rebuild_publish';

statement error connection closed
CALL serenedb_reindex('reindex_crash_idx');

# The old index survives with its pre-REINDEX content.
connection after_crash_before
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM reindex_crash_idx WHERE body @@ ts_phrase('pudge');
----
count
2

# Re-running the refresh completes the job.
connection after_crash_before
statement ok
CALL serenedb_reindex('reindex_crash_idx');

connection after_crash_before
query
SELECT count(*) FROM reindex_crash_idx WHERE body @@ ts_phrase('pudge');
----
count
3

# Crash AFTER the publish: the rebuilt content is durable across the restart.

connection after_crash_before
statement count 6
COPY (SELECT 20 AS id, 'pudge goes mid' AS body
      UNION ALL SELECT 21, 'pudge farms jungle'
      UNION ALL SELECT 22, 'pudge buys blink'
      UNION ALL SELECT 23, 'anchin reads manga'
      UNION ALL SELECT 24, 'pudge plays again'
      UNION ALL SELECT 25, 'vedernikoff approves the swap')
TO '${__TEST_DIR__}/reindex_crash.parquet' (FORMAT PARQUET);

connection after_crash_before
statement ok
SET sdb_faults = 'crash_after_rebuild_publish';

connection after_crash_before
statement error connection closed
REINDEX INDEX reindex_crash_idx;

connection after_crash_after
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM reindex_crash_idx WHERE body @@ ts_phrase('pudge');
----
count
4

# Still a perfectly normal index: refresh again through the statement form,
# query materialised columns.
connection after_crash_after
statement ok
REINDEX INDEX CONCURRENTLY reindex_crash_idx;

connection after_crash_after
query
SELECT id FROM reindex_crash_idx WHERE body @@ ts_phrase('blink') ORDER BY id;
----
id
22

connection after_crash_after
query
SELECT id FROM reindex_crash_idx WHERE body @@ ts_phrase('vedernikoff');
----
id
25

# Delta crash window: rewrite one glob file + add another, crash between the
# staged transactions and the publish.

connection after_crash_after
statement count 2
COPY (SELECT 30 AS id, 'pudge stacks camps' AS body
      UNION ALL SELECT 31, 'anchin skips episode')
TO '${__TEST_DIR__}/reindex_crash_glob_a.parquet' (FORMAT PARQUET);

connection after_crash_after
statement count 1
COPY (SELECT 32 AS id, 'vedernikoff guards ticks' AS body)
TO '${__TEST_DIR__}/reindex_crash_glob_a2.parquet' (FORMAT PARQUET);

connection after_crash_after
statement ok
CREATE VIEW reindex_crash_glob_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/reindex_crash_glob_*.parquet');

connection after_crash_after
statement ok
CREATE INDEX reindex_crash_glob_idx ON reindex_crash_glob_v USING inverted(id, body reindex_crash_en);

connection after_crash_after
query
SELECT count(*) FROM reindex_crash_glob_idx WHERE body @@ ts_phrase('pudge');
----
count
1

connection after_crash_after
statement count 3
COPY (SELECT 30 AS id, 'pudge stacks camps' AS body
      UNION ALL SELECT 33, 'pudge rotates mid'
      UNION ALL SELECT 34, 'anchin returns')
TO '${__TEST_DIR__}/reindex_crash_glob_a.parquet' (FORMAT PARQUET);

connection after_crash_after
statement count 1
COPY (SELECT 35 AS id, 'pudge buys blink' AS body)
TO '${__TEST_DIR__}/reindex_crash_glob_b.parquet' (FORMAT PARQUET);

connection after_crash_after
statement ok
SET sdb_faults = 'crash_before_delta_publish';

connection after_crash_after
statement error connection closed
CALL serenedb_reindex('reindex_crash_glob_idx');

# Nothing published before the crash: the pass is ONE transaction whose
# removes and batches commit together at Finalize, so the pre-delta state
# serves unchanged until the re-run.
connection after_delta_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM reindex_crash_glob_idx WHERE body @@ ts_phrase('pudge');
----
count
1

connection after_delta_crash
query
SELECT count(*) FROM reindex_crash_glob_idx;
----
count
3

connection after_delta_crash
query
SELECT id FROM reindex_crash_glob_idx WHERE body @@ ts_phrase('anchin');
----
id
31

# The re-run computes the identical diff and lands it.
connection after_delta_crash
query
SELECT * FROM serenedb_reindex('reindex_crash_glob_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	1	0	1

connection after_delta_crash
query
SELECT id FROM reindex_crash_glob_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id
30
33
35

connection after_delta_crash
query
SELECT count(*) FROM reindex_crash_glob_idx;
----
count
5
