statement ok
CREATE TABLE before_rename.c (id INT PRIMARY KEY, pid INT REFERENCES before_rename.p (id));


statement ok
CREATE SEQUENCE before_rename.q;


statement ok
CREATE TABLE before_rename.d (id BIGINT DEFAULT nextval('before_rename.q'), v INT);


statement ok
ALTER SCHEMA before_rename RENAME TO after_rename;


statement ok
INSERT INTO after_rename.p VALUES (1);


statement ok
