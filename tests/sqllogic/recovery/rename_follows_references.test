control substitution on

statement ok
CREATE SCHEMA moved;


statement ok
CREATE TABLE parent (id INT PRIMARY KEY, v TEXT);


statement ok
INSERT INTO parent VALUES (1, 'a');


statement ok
CREATE VIEW parent_ids AS SELECT id FROM parent;


statement ok
CREATE FUNCTION parent_count() RETURNS BIGINT AS $$ SELECT count(*) FROM parent $$ LANGUAGE sql;


statement ok
CREATE TABLE child (id INT PRIMARY KEY, pid INT REFERENCES parent (id));


statement ok
ALTER TABLE parent RENAME TO parent2;


statement ok
INSERT INTO child VALUES (1, 1);


statement error
INSERT INTO child VALUES (2, 5);
----
db error: ERROR: insert or update on table "child" violates foreign key constraint "child_pid_fkey"
DETAIL: Key (pid)=(5) is not present in table "parent2".


statement ok
ALTER TABLE parent2 SET SCHEMA moved;


statement ok
INSERT INTO child VALUES (3, 1);


statement error
INSERT INTO child VALUES (4, 5);
----
db error: ERROR: insert or update on table "child" violates foreign key constraint "child_pid_fkey"
DETAIL: Key (pid)=(5) is not present in table "parent2".


statement error
DELETE FROM moved.parent2;
----
db error: ERROR: update or delete on table "parent2" violates foreign key constraint "child_pid_fkey" on table "child"
DETAIL: Key (id)=(1) is still referenced from table "child".


query
SELECT id, parent_count() AS n FROM parent_ids;
----
id	n
1	1


query
SELECT pg_get_viewdef('parent_ids') AS view;
----
view
SELECT id FROM moved.parent2 AS parent;


query
SELECT pg_get_constraintdef(oid) AS fk FROM pg_constraint WHERE conname = 'child_pid_fkey';
----
fk
FOREIGN KEY (pid) REFERENCES moved.parent2(id)


