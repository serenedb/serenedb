query
SELECT table_name, column_default
FROM information_schema.columns
WHERE column_name = 'id' AND table_name IN ('numbered', 'd')
ORDER BY table_name;
----
table_name	column_default
d	nextval('after_rename.q')
numbered	nextval('moved.ids2')


query
SELECT conname, pg_get_constraintdef(oid) AS fk
FROM pg_constraint
WHERE contype = 'f'
ORDER BY conname;
----
conname	fk
c_pid_fkey	FOREIGN KEY (pid) REFERENCES after_rename.p(id)
child_pid_fkey	FOREIGN KEY (pid) REFERENCES moved.parent2(id)
tree_up_fkey	FOREIGN KEY (up) REFERENCES moved.tree2(id)


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
