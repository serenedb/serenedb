statement ok
INSERT INTO goshandr_bunker VALUES (1, 10);


statement ok
ALTER TABLE goshandr_bunker ADD COLUMN note TEXT DEFAULT 'kringe';


statement ok
ALTER TABLE goshandr_bunker RENAME TO goshandr_base;


statement ok
CREATE TABLE vjling_chat (id INT, b INT, n INT);


statement ok
