statement ok
CREATE INDEX donsimon_tilt_expr ON donsimon_tilt ((b * 2));


statement ok
INSERT INTO donsimon_tilt VALUES (1, 10, 0), (2, 20, 0);


statement ok
ALTER TABLE donsimon_tilt DROP COLUMN junk;


statement ok
ALTER TABLE donsimon_tilt RENAME TO donsimon_calm;


statement ok
