connection after_crash
query
SELECT (SELECT count(*) FROM pudge_rot WHERE rot @@ 'stinky') AS stinky, (SELECT count(*) FROM pudge_rot WHERE rot @@ 'clean') AS clean, (SELECT count(*) FROM pudge_rot WHERE rot @@ 'fresh') AS fresh;
----
stinky	clean	fresh
3	2	0
