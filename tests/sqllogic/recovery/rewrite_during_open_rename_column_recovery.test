connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM goshandr;
----
n
2


connection after_crash
query
SELECT attname FROM pg_attribute WHERE attrelid = 'goshandr'::regclass AND attnum > 0 ORDER BY attnum;
----
attname
id
stream


connection after_crash
statement ok
INSERT INTO goshandr VALUES (3, 'kringe');


connection after_crash
statement ok
VACUUM (REFRESH_TABLE) goshandr;


connection after_crash
query
SELECT (SELECT count(*) FROM goshandr_chat WHERE stream @@ 'kringe') AS kringe, (SELECT count(*) FROM goshandr_chat WHERE stream @@ 'baza') AS baza;
----
kringe	baza
2	1
