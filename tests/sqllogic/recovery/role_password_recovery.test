control substitution on

statement ok
SET password_encryption = 'md5';


statement ok
CREATE ROLE rpr_kept PASSWORD 'rpr_secret';


statement ok
CREATE ROLE rpr_md5 PASSWORD 'rpr_secret';


statement ok
ALTER ROLE rpr_md5 RENAME TO rpr_renamed;


statement ok
RESET password_encryption;


statement ok
CREATE ROLE rpr_empty PASSWORD 'rpr_secret';


statement ok
ALTER ROLE rpr_empty PASSWORD '';


query
SELECT rolname, rolpassword IS NULL AS cleared, rolpassword = 'md5' || md5('rpr_secret' || rolname) AS md5
FROM pg_authid
WHERE rolname IN ('rpr_empty', 'rpr_kept', 'rpr_renamed')
ORDER BY rolname;
----
rolname	cleared	md5
rpr_empty	t	NULL
rpr_kept	f	t
rpr_renamed	t	NULL


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_crash
query
SELECT rolname, rolpassword IS NULL AS cleared, rolpassword = 'md5' || md5('rpr_secret' || rolname) AS md5
FROM pg_authid
WHERE rolname IN ('rpr_empty', 'rpr_kept', 'rpr_renamed')
ORDER BY rolname;
----
rolname	cleared	md5
rpr_empty	t	NULL
rpr_kept	f	t
rpr_renamed	t	NULL
