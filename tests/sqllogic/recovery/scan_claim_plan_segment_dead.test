control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE TEXT SEARCH DICTIONARY cpd_words AS split_text(case := 'lower') WITH (frequency, norm);


statement ok
CREATE TABLE cpd (id BIGINT PRIMARY KEY, k INTEGER, v BIGINT, body TEXT);


statement ok
SET threads = 1


statement ok
INSERT INTO cpd SELECT i, CASE WHEN i < 20480 THEN i // 2048 ELSE 1000 + (i - 20480) // 2048 END, i,
  CASE WHEN i < 20480 THEN 'quick brown fox' ELSE 'lazy dog' END
FROM range(40960) t(i) ORDER BY i;


statement ok
CREATE INDEX cpd_idx ON cpd USING inverted (id, body cpd_words) INCLUDE (k, v)
  WITH (row_group_size = 2048, segment_docs_max = 20480, compaction_interval = 0);


query
SELECT max(value) FILTER (WHERE metric = 'num_segments') AS segments, max(value) FILTER (WHERE metric = 'num_docs') AS docs
FROM sdb_metrics WHERE relation_id = 'cpd_idx'::regclass;
----
segments	docs
2	40960


statement ok
SET threads = 4


statement ok
SET sdb_faults = 'classify_segments_keep_dead';


statement ok
SET enable_profiling = 'json'


statement ok
SET profiling_output = '${__TEST_DIR__}/cpd_dead.json'


query
SELECT count(*) AS n, sum(v) AS s FROM cpd_idx WHERE k = 3;
----
n	s
2048	14679040


statement ok
RESET enable_profiling


query
SELECT count(*) AS n, sum(v) AS s FROM cpd_idx WHERE k = 1005;
----
n	s
2048	65010688


query
SELECT count(*) AS n, bool_and(v BETWEEN 6144 AND 8191) AS k3
FROM (SELECT v FROM cpd_idx WHERE body @@ 'fox' AND k = 3 ORDER BY BM25(cpd_idx.tableoid) DESC LIMIT 5) t;
----
n	k3
5	t


query
SELECT list_sort(ts_dict_agg(body)) AS terms FROM cpd_idx WHERE k = 3;
----
terms
{brown,fox,quick}


