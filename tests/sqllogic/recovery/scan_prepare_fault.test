CREATE TABLE prepare_fault(id INTEGER PRIMARY KEY, x DOUBLE, y DOUBLE, tag INTEGER);

statement ok
INSERT INTO prepare_fault SELECT i, ((i * 48271) % 400009) / 400.009, ((i * 69621 + 7) % 400031) / 400.031, i % 7
 FROM range(400000) t(i);

statement ok
CREATE INDEX prepare_fault_idx ON prepare_fault USING inverted(id, tag, (curve(ROW(x, y))));

statement ok
