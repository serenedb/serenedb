control substitution on

statement ok
CREATE SCHEMA srd;


statement ok
CREATE TABLE srd.parent (id INT PRIMARY KEY, name TEXT);


statement ok
CREATE TABLE srd.child (id INT PRIMARY KEY, parent_id INT REFERENCES srd.parent (id));


statement ok
CREATE TABLE srd.docs (id SERIAL PRIMARY KEY, body TEXT);


statement ok
CREATE INDEX srd_docs_body ON srd.docs USING inverted (body);


statement ok
CREATE TABLE srd.st (id BIGINT PRIMARY KEY, body TEXT) WITH (storage = 'search');


statement ok
CREATE INDEX srd_st_body ON srd.st USING inverted (body);


statement ok
CREATE TABLE srd.st_numbered (body TEXT) WITH (storage = 'search');


