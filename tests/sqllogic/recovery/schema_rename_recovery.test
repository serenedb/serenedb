control substitution on

# ALTER SCHEMA RENAME is an ALTER record of the schema entry in the WAL, and
# every record written after it names the schema by its new name. Both must
# replay from the WAL alone, survive a checkpoint, and leave the contents
# reachable and writable under the new name.

statement ok
CREATE SCHEMA srr_a;

statement ok
CREATE TABLE srr_a.t (id SERIAL PRIMARY KEY, v INTEGER);

statement ok
CREATE INDEX srr_a_t_v ON srr_a.t (v);

statement ok
INSERT INTO srr_a.t (v) VALUES (1), (2);

statement ok
ALTER SCHEMA srr_a RENAME TO srr_b;

statement ok
INSERT INTO srr_b.t (v) VALUES (3);

statement ok
CREATE TABLE srr_b.after (a INTEGER);

# A rename that loses the write-write conflict, and a rename rolled back, both
# leave the children naming the schema as it is; the WAL written afterwards must
# replay.
connection s1
statement ok
BEGIN;

connection s1
statement ok
ALTER SCHEMA srr_b RENAME TO srr_x;

connection s2
statement error
ALTER SCHEMA srr_b RENAME TO srr_y;
----
db error: ERROR: Catalog write-write conflict on alter with "srr_b"


connection s1
statement ok
ROLLBACK;

connection s2
statement ok
INSERT INTO srr_b.after VALUES (1);

# Crash with the rename and the writes after it only in the WAL.
statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_wal_replay
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT nspname FROM pg_namespace WHERE nspname LIKE 'srr\_%' ORDER BY 1;
----
nspname
srr_b

connection after_wal_replay
query
SELECT id, v FROM srr_b.t ORDER BY id;
----
id	v
1	1
2	2
3	3

connection after_wal_replay
statement ok
INSERT INTO srr_b.t (v) VALUES (4);

connection after_wal_replay
query
SELECT max(id) AS id FROM srr_b.t;
----
id
4

connection after_wal_replay
query
SELECT id FROM srr_b.t WHERE v = 3;
----
id
3

connection after_wal_replay
query
SELECT table_name FROM information_schema.tables WHERE table_schema = 'srr_b' ORDER BY 1;
----
table_name
after
t

connection after_wal_replay
query
SELECT count(*) AS n FROM srr_b.after;
----
n
1

# Checkpoint, then crash: the renamed schema comes back from the database file.
connection after_wal_replay
statement ok
CHECKPOINT;

connection after_wal_replay
statement ok
SET sdb_faults = 'crash_on_packet';

connection after_wal_replay
statement error connection closed
SELECT 1;

connection after_checkpoint
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM srr_b.t;
----
n
4

connection after_checkpoint
statement ok
ALTER SCHEMA srr_b RENAME TO srr_c;

connection after_checkpoint
query
SELECT count(*) AS n FROM srr_c.t;
----
n
4

connection after_checkpoint
statement ok
DROP SCHEMA srr_c CASCADE;
