connection default
statement ok
SET sdb_faults = 'pause_search_compact_before_publish:release';


wait


connection default
query
SELECT origin, outcome, cardinality(inputs) AS inputs, input_docs, output_docs,
       prepare_ms > 0 AS prepared
FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'shrunk')
ORDER BY id;
----
origin	outcome	inputs	input_docs	output_docs	prepared
sql	merged	2	200	200	t


