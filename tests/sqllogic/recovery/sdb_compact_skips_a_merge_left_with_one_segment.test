statement ok
SET sdb_faults = 'pause_search_compact_before_publish';


connection compactor
query async
SELECT merge, outcome, len(inputs) AS inputs, input_docs, output_docs,
       output IS NOT NULL AS has_output, prepare_ms > 0 AS prepared,
       error
FROM sdb_compact('shrunk', mode := 'compact', target_segments := 2)
ORDER BY merge;
----
merge	outcome	inputs	input_docs	output_docs	has_output	prepared	error
1	merged	2	200	200	t	t	NULL
2	nothing	2	0	0	f	f	NULL


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_compact_before_publish:parked';


connection deleter
statement ok
DELETE FROM shrunk WHERE id > 300;


connection deleter
statement ok
VACUUM (REFRESH_TABLE) shrunk;


