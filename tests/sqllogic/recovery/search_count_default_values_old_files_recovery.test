control substitution on

# Search table files written before blocks recorded their counts of default
# values are still counted right after a restart: the fault point writes a
# table the way older releases did, next to one written with the counts.

statement ok
SET sdb_faults = 'irs::ColumnWithoutDefaultCounts';


statement ok
CREATE TABLE scdo_old WITH (storage = 'search') AS
SELECT i, i % 3 AS a, CASE WHEN i % 4 = 0 THEN '' ELSE 'v' || i END AS s
FROM range(10000) t(i);


statement ok
VACUUM (REFRESH_TABLE) scdo_old;


statement ok
RESET sdb_faults;


statement ok
CREATE TABLE scdo_new WITH (storage = 'search') AS
SELECT i, i % 3 AS a, CASE WHEN i % 4 = 0 THEN '' ELSE 'v' || i END AS s
FROM range(10000) t(i);


statement ok
VACUUM (REFRESH_TABLE) scdo_new;


statement ok
CHECKPOINT;


connection victim
statement ok
SET sdb_faults = 'shutdown_on_packet';


connection victim
statement error connection closed
SELECT 1;


connection after_restart
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT (SELECT count(*) FROM scdo_old WHERE a <> 0) AS old_a,
       (SELECT count(*) FROM scdo_new WHERE a <> 0) AS new_a;
----
old_a	new_a
6666	6666


connection after_restart
query
SELECT (SELECT count(*) FROM scdo_old WHERE s = '') AS old_s,
       (SELECT count(*) FROM scdo_new WHERE s = '') AS new_s;
----
old_s	new_s
2500	2500
