control substitution on


statement ok
CREATE TABLE sis (id INT, body TEXT) WITH (compaction_interval = 50);


statement ok
CREATE INDEX sis_idx ON sis USING inverted (id);


statement ok
INSERT INTO sis SELECT i, 'row ' || i FROM range(20000) t(i);


statement ok
INSERT INTO sis SELECT i, 'row ' || i FROM range(20000, 30000) t(i);


query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT (SELECT value FROM sdb_metrics WHERE metric = 'num_buffered_docs' AND relation_id = 'sis'::regclass) AS buffered,
       (SELECT value FROM sdb_metrics WHERE metric = 'num_segments' AND relation_id = 'sis'::regclass) AS segments,
       (SELECT value FROM sdb_metrics WHERE metric = 'catalog_wal_size_on_disk') < 4096 AS small_log;
----
buffered	segments	small_log
0	1	t


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_crash
query
SELECT count(*) AS n, sum(id) AS s FROM sis;
