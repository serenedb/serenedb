control substitution on

statement ok
CREATE TABLE lc (id BIGINT PRIMARY KEY, tag TEXT, payload TEXT)
  WITH (compaction_interval = 0);


statement ok
CREATE INDEX lc_tag ON lc USING inverted (tag);


statement ok
SET sdb_log_compression = false;


statement ok
INSERT INTO lc
SELECT i, 'plain' || (i % 10)::TEXT, repeat('x', (i % 50)::INTEGER)
FROM range(0, 2000) t(i);


statement ok
VACUUM (FLUSH_TABLE) lc;


statement ok
RESET sdb_log_compression;


statement ok
INSERT INTO lc
SELECT i, 'packed' || (i % 10)::TEXT, repeat('y', (i % 50)::INTEGER)
FROM range(2000, 4000) t(i);


statement ok
INSERT INTO lc VALUES (4000, 'single', 'z');


statement ok
UPDATE lc SET payload = 'updated' WHERE id % 100 = 7;


statement ok
DELETE FROM lc WHERE id % 100 = 9;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_log
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
