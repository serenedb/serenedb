query
SELECT
  t,
  count(*) AS n,
  count(*) FILTER (WHERE payload = 'old' || id::TEXT) AS old,
  count(*) FILTER (WHERE payload = 'own' || id::TEXT) AS own,
  count(*) FILTER (WHERE payload = 'updated' || id::TEXT) AS updated
FROM (SELECT 'on_off' AS t, * FROM on_off UNION ALL SELECT 'off_on', * FROM off_on)
GROUP BY t
ORDER BY t;
----
t	n	old	own	updated
off_on	2100	1800	90	210
on_off	2100	1800	90	210


