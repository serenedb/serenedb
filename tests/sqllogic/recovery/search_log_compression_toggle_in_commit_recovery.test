control substitution on

statement ok
CREATE TABLE on_off (id BIGINT PRIMARY KEY, payload TEXT)
  WITH (compaction_interval = 0);


statement ok
CREATE TABLE off_on (id BIGINT PRIMARY KEY, payload TEXT)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO on_off SELECT i, 'old' || i::TEXT FROM range(0, 1000) t(i);


statement ok
INSERT INTO off_on SELECT i, 'old' || i::TEXT FROM range(0, 1000) t(i);


statement ok
