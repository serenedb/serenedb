control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE SCHEMA stcf_fs;


statement ok
RESET sdb_faults;


statement ok
CREATE FUNCTION stcf_fs.stcf_conv(x INT) RETURNS BIGINT LANGUAGE sql IMMUTABLE AS 'SELECT x * 10';


statement ok
CREATE FUNCTION stcf_fs.stcf_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


statement ok
CREATE TABLE public.stcf_defaults (id INT PRIMARY KEY, a INT)
WITH (compaction_interval = 0);


statement ok
INSERT INTO public.stcf_defaults VALUES (1, 1);


statement ok
SET search_path = stcf_fs, public;


statement ok
CREATE TABLE public.stcf_retyped (id INT PRIMARY KEY, a INT)
WITH (compaction_interval = 0);


statement ok
CREATE TABLE public.stcf_checked (id INT PRIMARY KEY, a INT CHECK (stcf_pos(a)), b INT, c INT)
WITH (compaction_interval = 0);


statement ok
CREATE TABLE public.stcf_shared (id INT PRIMARY KEY, a INT, b INT, CHECK (stcf_pos(a) AND b > 0))
WITH (compaction_interval = 0);


statement ok
INSERT INTO public.stcf_retyped VALUES (1, 1), (2, 2);


statement ok
INSERT INTO public.stcf_checked VALUES (1, 1, 1, 1);


statement ok
INSERT INTO public.stcf_shared VALUES (1, 1, 1);


statement ok
ALTER TABLE public.stcf_checked DROP COLUMN b;


statement ok
ALTER TABLE public.stcf_checked ALTER COLUMN c TYPE BIGINT;


statement ok
ALTER TABLE public.stcf_retyped ALTER COLUMN a TYPE BIGINT USING stcf_conv(a);


statement ok
ALTER TABLE public.stcf_shared DROP COLUMN b;


statement ok
ALTER TABLE public.stcf_defaults ADD COLUMN d BIGINT DEFAULT stcf_conv(7);


statement ok
CREATE TABLE public.stcf_generated (id INT PRIMARY KEY, a INT, s BIGINT GENERATED ALWAYS AS (stcf_conv(a)) STORED)
WITH (compaction_interval = 0);


statement ok
INSERT INTO public.stcf_generated (id, a) VALUES (1, 1);


statement ok
ALTER TABLE public.stcf_generated ADD COLUMN b INT;


statement ok
RESET search_path;


statement ok
CREATE DATABASE stcf_app;


connection app database=stcf_app
statement ok
CREATE FUNCTION stcf_app_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


connection app database=stcf_app
statement ok
CREATE TABLE stcf_t (id INT PRIMARY KEY, a INT CHECK (stcf_app_pos(a)), b INT, c INT)
WITH (compaction_interval = 0);


connection app database=stcf_app
statement ok
INSERT INTO stcf_t VALUES (1, 1, 1, 1);


connection app database=stcf_app
statement ok
ALTER TABLE stcf_t DROP COLUMN b;


connection app database=stcf_app
statement ok
ALTER TABLE stcf_t ALTER COLUMN c TYPE BIGINT;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection restarted
