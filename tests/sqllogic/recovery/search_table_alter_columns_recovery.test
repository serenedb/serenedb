control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sacr (id INT, a INT, b TEXT)
WITH (compaction_interval = 0);


statement ok
RESET sdb_faults;


statement ok
INSERT INTO sacr VALUES (1, 10, 'one'), (2, 20, 'two');


statement ok
VACUUM (FLUSH_TABLE) sacr;


statement ok
CHECKPOINT;


statement ok
INSERT INTO sacr VALUES (3, 30, 'three');


statement ok
ALTER TABLE sacr ADD COLUMN c INT;


statement ok
INSERT INTO sacr VALUES (4, 40, 'four', 400);


statement ok
ALTER TABLE sacr DROP COLUMN a;


statement ok
INSERT INTO sacr VALUES (5, 'five', 500);


statement ok
ALTER TABLE sacr ADD COLUMN d TEXT DEFAULT 'x';


statement ok
ALTER TABLE sacr ALTER COLUMN c TYPE BIGINT;


statement ok
INSERT INTO sacr VALUES (6, 'six', 600, 'y');


statement ok
CREATE TABLE sacs (id SERIAL, v INT)
WITH (compaction_interval = 0);


statement ok
INSERT INTO sacs (v) VALUES (10), (20);


statement ok
ALTER TABLE sacs ALTER COLUMN id TYPE BIGINT;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection restarted
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection restarted
query
