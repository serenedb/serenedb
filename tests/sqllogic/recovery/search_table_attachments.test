control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TEXT SEARCH DICTIONARY sat_en AS split_text(case := 'lower')
WITH (frequency, position, norm);


statement ok
CREATE TABLE sat (id INT, n INT, body TEXT, tag TEXT)
WITH (compaction_interval = 0, compaction_floor_segment_bytes = 1, compaction_max_segments = 1000, row_group_size = 2048);


statement ok
CREATE INDEX sat_tag ON sat USING inverted (tag);


statement ok
INSERT INTO sat
SELECT i, i % 10, 'w' || (i % 7) || ' x' || i, 't' || (i % 3)
FROM generate_series(1, 3000) g(i);


statement ok
VACUUM (FLUSH_TABLE) sat;


statement ok
INSERT INTO sat
SELECT i, i % 10, 'w' || (i % 7) || ' x' || i, 't' || (i % 3)
FROM generate_series(3001, 5000) g(i);


statement ok
VACUUM (FLUSH_TABLE) sat;


statement ok
DELETE FROM sat WHERE id % 100 = 0;


statement ok
UPDATE sat SET n = n + 100 WHERE id % 250 = 1;


statement ok
SET VARIABLE sat_segments = (
  SELECT value
  FROM sdb_metrics
  WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'sat')
    AND metric = 'num_segments'
);


statement ok
SET VARIABLE sat_files = (
  SELECT value
  FROM sdb_metrics
  WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'sat')
    AND metric = 'num_files'
);


statement ok
ALTER TABLE sat ADD COLUMN c INT DEFAULT 42;


statement ok
ALTER TABLE sat ALTER COLUMN n TYPE BIGINT;


statement ok
CREATE INDEX sat_body ON sat USING inverted (body sat_en);


query
SELECT
  (
    SELECT value
    FROM sdb_metrics
    WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'sat')
      AND metric = 'num_segments'
  ) = getvariable('sat_segments') AS same_segments,
  (
    SELECT value
    FROM sdb_metrics
    WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'sat')
      AND metric = 'num_files'
  ) > getvariable('sat_files') AS more_files;
----
same_segments	more_files
t	t


query
SELECT count(*) AS rows, sum(c) AS c, sum(n) AS n, pg_typeof(sum(n)) AS t
FROM sat;
----
rows	c	n	t
4950	207900	24500	numeric


query
SELECT count(*) AS hits FROM sat WHERE body @@ 'w3';
----
hits
707


query
SELECT
  (SELECT count(*) FROM sat WHERE body @@ to_tsquery('w3 OR w4')) AS any_of,
  (SELECT count(*) FROM sat WHERE body @@ to_tsquery('w3 AND x3')) AS both,
  (SELECT count(*) FROM sat WHERE body @@ to_tsquery('w3 AND NOT x3')) AS but_not,
  (SELECT count(*) FROM sat WHERE body @@ 'w3' AND tag = 't0') AS mixed;
----
any_of	both	but_not	mixed
1414	1	706	236


query
SELECT id, n, c FROM sat WHERE body @@ 'x251';
----
id	n	c
251	101	42


statement ok
SET threads = 1;


query
SELECT count(*) AS hits FROM sat WHERE body @@ 'w3' AND NOT tag = 't0';
