statement ok
CREATE TABLE satt (id INT, body TEXT)
WITH (compaction_interval = 0, compaction_floor_segment_bytes = 1, compaction_max_segments = 1000);


statement ok
INSERT INTO satt
SELECT i, 'w' || (i % 7)
FROM generate_series(1, 3000) g(i);


statement ok
VACUUM (FLUSH_TABLE) satt;


statement ok
SET sdb_faults = 'pause_search_backfill_before_swap';


