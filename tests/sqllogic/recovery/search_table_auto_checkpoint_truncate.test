control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE act (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
SET GLOBAL checkpoint_threshold = '64KB';

statement ok
INSERT INTO act SELECT 1000 + j, repeat('p', 1000) FROM range(50) r(j);

statement ok
