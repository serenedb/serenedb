query
SELECT count(*) AS n, sum(id) AS s, min(id) AS lo, max(id) AS hi FROM act;
----
n	s	lo	hi
50	576250	11001	12049

statement ok
INSERT INTO act VALUES (20000, 'tail');

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
