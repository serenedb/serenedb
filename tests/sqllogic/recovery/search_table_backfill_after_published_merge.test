control substitution on


statement ok
RESET sdb_faults;


statement ok
CREATE TABLE bpm (id INT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
        compaction_max_segments = 2);


statement ok
INSERT INTO bpm SELECT i, 'fox dog' FROM generate_series(1, 100) s(i);


statement ok
VACUUM (REFRESH_TABLE) bpm;


statement ok
INSERT INTO bpm SELECT i, 'owl cat' FROM generate_series(101, 200) s(i);


statement ok
VACUUM (REFRESH_TABLE) bpm;


statement ok
SET sdb_faults = 'pause_merge_before_publish';


statement ok
ALTER TABLE bpm SET (compaction_interval = 100);


statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_merge_before_publish:parked';


statement ok
SET sdb_faults = 'pause_search_backfill_floor_pending';


connection builder
statement async ok
CREATE INDEX bpm_idx ON bpm USING inverted (body);


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_backfill_floor_pending:parked';


connection default
statement ok
SET sdb_faults = 'pause_merge_before_publish:release';


connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS merges FROM sdb_compact_history
WHERE relation_id = 'bpm'::regclass AND type = 'merge' AND outcome = 'merged';
----
merges
1


connection default
statement ok
SET sdb_faults = 'pause_search_backfill_floor_pending:release';


wait


connection default
query
SELECT count(*) AS n FROM bpm_idx WHERE body = 'fox dog';
----
n
100


connection default
query
SELECT count(*) AS n FROM bpm_idx WHERE body = 'owl cat';
----
n
100


connection default
statement ok
DROP TABLE bpm;
