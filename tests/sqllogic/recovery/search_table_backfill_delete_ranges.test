control substitution on

statement ok
RESET sdb_faults;

statement ok
CREATE TABLE bdr (id BIGINT, tag TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
        row_group_size = 8192);

statement ok
INSERT INTO bdr SELECT i, CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(0, 50000) r(i);

statement ok
VACUUM (REFRESH_TABLE) bdr;

statement ok
SET sdb_faults = 'pause_search_backfill_before_swap';

connection builder
statement async ok
CREATE INDEX bdr_idx ON bdr USING inverted (tag);

connection default
query ok retry 40 backoff 250ms
SELECT tuples_done FROM pg_stat_progress_create_index
WHERE relid = 'bdr'::regclass;
----
tuples_done
50000

connection default
statement ok
DELETE FROM bdr WHERE id < 20000 OR id % 1000 = 7;

connection default
statement ok
VACUUM (REFRESH_TABLE) bdr;

connection default
statement ok
SET sdb_faults = '-pause_search_backfill_before_swap';

wait

connection default
statement ok
VACUUM (REFRESH_TABLE) bdr;

connection default
query
SELECT count(*), min(id) FROM bdr;
----
count	min
29970	20000

connection default
query
SELECT count(*) AS hits FROM bdr WHERE tag @@ 'even';
----
hits
15000

connection default
query
SELECT count(*) AS hits FROM bdr WHERE tag @@ 'odd';
----
hits
14970
