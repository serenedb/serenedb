statement ok
RESET sdb_faults;

statement ok
CREATE TABLE biv (id BIGINT PRIMARY KEY, tag TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO biv SELECT i, 't' || (i % 5) FROM generate_series(1, 5000) g(i);

statement ok
VACUUM (REFRESH_TABLE) biv;

statement ok
SET sdb_faults = 'pause_search_backfill_before_swap';

connection builder
statement async ok
CREATE INDEX biv_idx ON biv USING inverted (tag);

connection default
query ok retry 40 backoff 250ms
