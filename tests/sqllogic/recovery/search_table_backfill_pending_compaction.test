control substitution on


statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE bpc (id INT, v INT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
RESET sdb_faults;


statement ok
INSERT INTO bpc SELECT i, i FROM range(0, 10) r(i);


statement ok
VACUUM (REFRESH_TABLE) bpc;


statement ok
INSERT INTO bpc SELECT i, i FROM range(10, 20) r(i);


statement ok
VACUUM (REFRESH_TABLE) bpc;


statement ok
INSERT INTO bpc SELECT i, i FROM range(20, 30) r(i);


statement ok
VACUUM (REFRESH_TABLE) bpc;


statement ok
INSERT INTO bpc SELECT i, i FROM range(30, 40) r(i);


statement ok
VACUUM (REFRESH_TABLE) bpc;


statement ok
SET sdb_faults = 'pause_irs_compaction_registered';


statement ok
ALTER TABLE bpc SET (compaction_interval = 10);


statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_irs_compaction_registered:parked';


statement ok
ALTER TABLE bpc SET (compaction_interval = 0);


statement ok
SET sdb_faults = 'pause_search_backfill_floor_retry';


connection alter
statement async ok
ALTER TABLE bpc ALTER COLUMN v TYPE BIGINT;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_backfill_floor_retry:parked';


connection default
statement ok
SET sdb_faults = 'pause_irs_compaction_registered:release';


connection default
statement ok
SET sdb_faults = 'pause_search_backfill_floor_retry:release';


wait


connection default
statement ok
VACUUM (REFRESH_TABLE) bpc;


connection default
query
SELECT count(*) AS n, sum(v) AS s, max(pg_typeof(v)::TEXT) AS t FROM bpc;
----
n	s	t
40	780	bigint
