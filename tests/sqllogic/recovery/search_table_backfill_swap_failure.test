# A CREATE INDEX on a table whose rebuilt segments fail to swap in fails with
# the reason, leaves the table as it was, and a second CREATE INDEX succeeds.
# Requires SDB_FAULT_INJECTION.

control substitution on

statement ok
RESET sdb_faults;


statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE bfs (id BIGINT PRIMARY KEY, tag TEXT)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO bfs VALUES (1, 'alpha'), (2, 'beta');

statement ok
VACUUM (FLUSH_TABLE) bfs;


statement ok
SET sdb_faults = 'search_replacement_swap_fails';


statement error
CREATE INDEX bfs_idx ON bfs USING inverted (tag);
----
db error: ERROR: index build: failed to swap in the rebuilt segments of table <slt:ignore>: intentional debug error


statement ok
RESET sdb_faults;


query
SELECT indexname FROM pg_indexes WHERE tablename = 'bfs' ORDER BY indexname;
----
indexname
bfs_pkey


query
SELECT id, tag FROM bfs ORDER BY id;
----
id	tag
1	alpha
2	beta


statement ok
INSERT INTO bfs VALUES (3, 'gamma');


statement ok
CREATE INDEX bfs_idx ON bfs USING inverted (tag);


query
SELECT id FROM bfs_idx WHERE tag @@ 'beta';
----
id
2


query
SELECT count(*) AS rows FROM bfs;
----
rows
3
