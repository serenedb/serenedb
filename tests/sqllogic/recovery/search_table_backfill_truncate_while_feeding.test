n
0

connection default
statement ok
SET sdb_faults = '-pause_search_backfill_fed';

wait

connection default
statement ok
VACUUM (REFRESH_TABLE) bff;

connection default
query
SELECT count(*) AS n FROM bff;
----
n
0

connection default
query
