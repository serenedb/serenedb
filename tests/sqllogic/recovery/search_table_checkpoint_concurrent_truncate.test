control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE cct (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE cct_rows (id INTEGER);

statement ok
INSERT INTO cct_rows VALUES (1);

statement ok
INSERT INTO cct VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (REFRESH_TABLE) cct;

connection reader
statement ok
BEGIN;

connection reader
query
SELECT count(*) AS n FROM cct_rows;
----
n
1

connection default
statement ok
SET debug_checkpoint_sleep_ms = 3000;

connection checkpointer
statement async ok
CHECKPOINT;

connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT%';
----
n
1

connection writer
statement ok
INSERT INTO cct VALUES (3, 'c');

connection writer
statement ok
TRUNCATE cct;

connection writer
statement ok
INSERT INTO cct VALUES (4, 'd');

connection writer
statement ok
BEGIN;

connection writer
statement ok
INSERT INTO cct VALUES (5, 'e');

connection writer
statement ok
COMMIT;

wait

connection reader
statement ok
COMMIT;

connection default
statement ok
SET debug_checkpoint_sleep_ms = 0;

connection writer
statement ok
INSERT INTO cct VALUES (6, 'f');

connection default
statement ok
SET sdb_faults = 'crash_on_packet';

connection default
statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM cct;
----
ids
4,5,6

connection after_crash
statement ok
INSERT INTO cct VALUES (7, 'g');

connection after_crash
statement ok
TRUNCATE cct;

connection after_crash
statement ok
INSERT INTO cct VALUES (8, 'h');

connection after_crash
statement ok
SET debug_checkpoint_abort = 'before_header';

connection after_crash
statement error
CHECKPOINT;
----
db error: ERROR: Checkpoint failed for database<slt:ignore>


connection after_crash
statement ok
SET sdb_faults = 'crash_on_packet';

connection after_crash
statement error connection closed
SELECT 1;

connection after_abort
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM cct;
----
ids
8
