control substitution on

statement ok
CREATE DATABASE st_ckpt_finish;


statement ok
CREATE TABLE st_ckpt_finish.public.docs (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO st_ckpt_finish.public.docs SELECT i, 'saved' FROM range(0, 1000) r(i);


statement ok
SET sdb_faults = 'crash_before_index_checkpoint_finish';


statement error connection closed
CHECKPOINT st_ckpt_finish;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(*) FILTER (WHERE body = 'saved') AS saved FROM st_ckpt_finish.public.docs;
----
n	saved
1000	1000
