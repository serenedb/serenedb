connection default
query
SELECT
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM cwi) AS cwi,
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM cwd) AS cwd,
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM cwt) AS cwt,
  (SELECT count(*) FROM cwb) AS cwb,
  (SELECT count(*) FROM cw1) AS cw1,
  (SELECT count(*) FROM cw2) AS cw2;
----
cwi	cwd	cwt	cwb	cw1	cw2
1,2,3	2	4	5002	0	0

connection default
statement ok
SET sdb_faults = 'crash_on_packet';

connection default
statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM cwi) AS cwi,
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM cwd) AS cwd,
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM cwt) AS cwt,
  (SELECT count(*) FROM cwb) AS cwb,
  (SELECT count(*) FROM cw1) AS cw1,
  (SELECT count(*) FROM cw2) AS cw2;
----
cwi	cwd	cwt	cwb	cw1	cw2
1,2,3	2	4	5002	0	0
