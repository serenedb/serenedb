n
1

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs:release';

wait

connection writer
statement ok
BEGIN;

connection writer
statement ok
INSERT INTO cwt VALUES (3, 'c');

connection writer
statement ok
TRUNCATE cwt;

connection writer
statement ok
INSERT INTO cwt VALUES (4, 'd');

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs';

connection writer
statement async ok
COMMIT;

connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_irs:parked';

connection checkpointer
statement async ok
CHECKPOINT;

sleep 1s

connection default
query
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT%';
