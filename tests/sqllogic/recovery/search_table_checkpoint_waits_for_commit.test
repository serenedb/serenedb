n
1

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs:release';

wait

connection writer
statement ok
SET threads = 1;

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs';

connection writer
statement async ok
INSERT INTO cwb SELECT 100 + i, 'v' || i || repeat('x', 200) FROM range(5000) t(i);

