control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE cwi (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE cwd (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE cwt (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE cwb (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, segment_memory_max = 2097152);

statement ok
CREATE TABLE cw1 (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE cw2 (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO cwi VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO cwd VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO cwt VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO cwb VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO cw1 VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO cw2 VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (REFRESH_TABLE) cwi;

statement ok
VACUUM (REFRESH_TABLE) cwd;

statement ok
VACUUM (REFRESH_TABLE) cwt;

statement ok
VACUUM (REFRESH_TABLE) cwb;

statement ok
VACUUM (REFRESH_TABLE) cw1;

statement ok
VACUUM (REFRESH_TABLE) cw2;

statement ok
SET sdb_faults = 'pause_search_commit_before_irs';

connection writer
statement async ok
INSERT INTO cwi VALUES (3, 'c');

connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_irs:parked';

connection checkpointer
statement async ok
CHECKPOINT;

sleep 1s

connection default
query
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT%';
----
n
1

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs:release';

wait

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs';

connection writer
statement async ok
DELETE FROM cwd WHERE id = 1;

connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_irs:parked';

connection checkpointer
statement async ok
CHECKPOINT;

sleep 1s

connection default
query
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT%';
