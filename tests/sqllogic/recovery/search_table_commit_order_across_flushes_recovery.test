control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE order_docs (id BIGINT, msg TEXT)
  WITH (storage = 'search', compaction_interval = 0);


statement ok
INSERT INTO order_docs SELECT i, 'm' || (i % 7) FROM range(100) t(i);


statement ok
CHECKPOINT;


statement ok
INSERT INTO order_docs VALUES (-1, 'm6');


statement ok
SET sdb_faults = 'search_commit_prepared';


connection writer
statement async ok
INSERT INTO order_docs VALUES (-2, 'm5');


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-search_commit_prepared:parked';


connection default
statement ok
SET sdb_faults = 'pause_search_cooling';


connection cooler
statement async ok
CHECKPOINT;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_cooling:parked';


connection other
statement ok
INSERT INTO order_docs VALUES (-3, 'm4');


connection default
statement ok
SET sdb_faults = 'search_commit_prepared:release';


connection writer
wait


connection default
statement ok
SET sdb_faults = 'pause_search_cooling:release';


wait


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(DISTINCT id) AS ids, min(id) AS lo, max(id) AS hi FROM order_docs;
----
n	ids	lo	hi
103	103	-3	99


connection after_crash
statement ok
INSERT INTO order_docs VALUES (-4, 'm3');


connection after_crash
statement ok
CHECKPOINT;


connection after_crash
statement ok
SET sdb_faults = 'crash_on_packet';


connection after_crash
statement error connection closed
SELECT 1;


connection after_second_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(DISTINCT id) AS ids, min(id) AS lo, max(id) AS hi FROM order_docs;
----
n	ids	lo	hi
104	104	-4	99
