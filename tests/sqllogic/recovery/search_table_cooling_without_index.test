CREATE TABLE cwi_plain (id INT, body TEXT)


statement ok
INSERT INTO cwi_plain SELECT i, 'fox' FROM generate_series(1, 100) s(i)


query
SELECT count(*) FROM cwi_plain;
----
count
100


query
SELECT metric, value FROM sdb_metrics
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'cwi_plain')
  AND metric IN ('num_buffered_docs', 'num_segments')
ORDER BY metric;
----
metric	value
num_buffered_docs	100
num_segments	0


