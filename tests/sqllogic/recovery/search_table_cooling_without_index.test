CREATE TABLE cwi_indexed (id INT, body TEXT)


statement ok
CREATE INDEX cwi_indexed_idx ON cwi_indexed USING inverted(body)


statement ok
INSERT INTO cwi_indexed SELECT i, 'fox' FROM generate_series(1, 100) s(i)


query
SELECT count(*) FROM cwi_indexed WHERE body @@ 'fox';
----
count
100


query
SELECT metric, value FROM sdb_metrics
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'cwi_indexed')
  AND metric IN ('num_buffered_docs', 'num_segments')
ORDER BY metric;
