control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE DATABASE xt_other;

statement ok
CREATE TABLE xt_local (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE xt_other.public.xt_remote (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
RESET sdb_faults;

statement ok
INSERT INTO xt_local VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO xt_other.public.xt_remote VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (REFRESH_TABLE) xt_local;

statement ok
VACUUM (REFRESH_TABLE) xt_other.public.xt_remote;

statement ok
SET sdb_faults = 'pause_search_commit_before_irs';

connection truncator
statement async error connection closed
TRUNCATE xt_local, xt_other.public.xt_remote;

connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_irs:parked';

connection checkpointer
statement ok
CHECKPOINT;

connection default
statement ok
SET sdb_faults = 'crash_on_packet';

connection default
statement error connection closed
SELECT 1;

wait

connection after_autocommit
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT (SELECT count(*) FROM xt_local) AS l, (SELECT count(*) FROM xt_other.public.xt_remote) AS r;
----
l	r
0	0

connection after_autocommit
statement ok
INSERT INTO xt_local VALUES (1, 'a'), (2, 'b');

connection after_autocommit
statement ok
INSERT INTO xt_other.public.xt_remote VALUES (1, 'a'), (2, 'b');

connection after_autocommit
statement ok
VACUUM (REFRESH_TABLE) xt_local;

connection after_autocommit
statement ok
VACUUM (REFRESH_TABLE) xt_other.public.xt_remote;

connection mixed
statement ok
BEGIN;

connection mixed
statement ok
TRUNCATE xt_local;

connection mixed
statement ok
INSERT INTO xt_other.public.xt_remote VALUES (3, 'c');

connection mixed
statement ok
INSERT INTO xt_local VALUES (4, 'd');

connection after_autocommit
statement ok
SET sdb_faults = 'pause_search_commit_before_delete_log';

connection mixed
statement async error connection closed
COMMIT;

connection after_autocommit
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_delete_log:parked';

connection after_autocommit
statement ok
SET sdb_faults = 'crash_on_packet';

connection after_autocommit
statement error connection closed
SELECT 1;

wait

connection after_mixed
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM xt_local) AS l,
  (SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM xt_other.public.xt_remote) AS r;
----
l	r
4	1,2,3
