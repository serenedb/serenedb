control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE mc (id BIGINT, v TEXT) WITH (compaction_interval = 0);


statement ok
INSERT INTO mc SELECT i, 'a' || i FROM generate_series(0, 999) g(i);


statement ok
CHECKPOINT;


statement ok
INSERT INTO mc SELECT i, 'b' || i FROM generate_series(1000, 1999) g(i);


statement ok
SET sdb_faults = 'pause_search_compact_before_publish';


connection compactor
statement async ok
VACUUM (COMPACT_TABLE) mc;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_compact_before_publish:parked';


connection deleter
statement ok
DELETE FROM mc WHERE id % 7 = 3;


connection default
statement ok
SET sdb_faults = 'pause_search_compact_before_publish:release';


wait


connection default
query
SELECT count(DISTINCT rowid >> 32) AS segments FROM mc;
----
segments
1


connection default
query
SELECT count(*) AS n, count(*) FILTER (WHERE id % 7 = 3) AS deleted FROM mc;
----
n	deleted
1714	0


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, sum(id) AS s FROM mc;
----
n	s
1714	1712857


connection after_crash
query
SELECT count(*) AS n, count(*) FILTER (WHERE id % 7 = 3) AS deleted FROM mc;
----
n	deleted
1714	0
