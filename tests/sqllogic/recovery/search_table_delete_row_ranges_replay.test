control substitution on

statement ok
SET threads = 1;

statement ok
CREATE TABLE rr (id BIGINT, body TEXT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
      row_group_size = 8192);

statement ok
INSERT INTO rr SELECT i, 'row ' || i FROM range(0, 100000) r(i);

statement ok
VACUUM (REFRESH_TABLE) rr;

statement ok
INSERT INTO rr SELECT i, 'row ' || i FROM range(100000, 200000) r(i);

statement ok
VACUUM (REFRESH_TABLE) rr;

statement ok
CHECKPOINT;

statement ok
SET sdb_faults = 'SearchRefreshTask::commitUnsafe';

statement ok
DELETE FROM rr WHERE id < 20000 OR (id < 90000 AND id % 1000 = 3);

statement ok
DELETE FROM rr WHERE id >= 90000 AND id < 130000;

statement ok
DELETE FROM rr WHERE id >= 180000 AND id % 997 = 0;

statement ok
SET sdb_faults = 'search_delete_wal_rowids';

statement ok
DELETE FROM rr WHERE id >= 150000 AND id < 155000;

statement ok
SET sdb_faults = 'crash_on_packet';

query error connection closed
SELECT 1;

connection after
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
VACUUM (REFRESH_TABLE) rr;

connection after
query
SELECT count(*) AS n, min(id) AS lo, max(id) AS hi FROM rr;
----
n	lo	hi
134910	20000	199999

connection after
query
SELECT count(*) AS n FROM rr
WHERE id < 20000 OR (id < 90000 AND id % 1000 = 3) OR (id >= 90000 AND id < 130000)
   OR (id >= 180000 AND id % 997 = 0) OR (id >= 150000 AND id < 155000);
----
n
0

connection after
query
SELECT count(*) FILTER (WHERE id >= 20000 AND id < 90000) AS singles_kept,
       count(*) FILTER (WHERE id >= 130000 AND id < 150000) AS untouched,
       count(*) FILTER (WHERE id >= 155000 AND id < 180000) AS after_legacy
FROM rr;
----
singles_kept	untouched	after_legacy
69930	20000	25000
