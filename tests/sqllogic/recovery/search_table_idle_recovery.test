control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE gc_active (a INTEGER, b TEXT) WITH (storage = 'search');

statement ok
RESET sdb_faults;

# Idle table: written + published once, then never touched again.
statement ok
CREATE TABLE gc_idle (a INTEGER, b TEXT) WITH (storage = 'search');

statement ok
INSERT INTO gc_idle VALUES (100, 'idle');

statement ok
VACUUM (REFRESH_TABLE) gc_idle;

statement ok
CREATE TABLE gc_fresh (a INTEGER, b TEXT) WITH (storage = 'search');

# Table with explicit (non-default) maintenance intervals: recovery must read
# the persisted intervals back off the deserialized catalog Table (no context).
statement ok
CREATE TABLE gc_tuned (a INTEGER, b TEXT)
  WITH (storage = 'search', refresh_interval = 300,
        compaction_interval = 6000, cleanup_interval_step = 2);

statement ok
INSERT INTO gc_tuned VALUES (42, 'tuned');

statement ok
VACUUM (REFRESH_TABLE) gc_tuned;

# Publish a baseline on the active table.
statement ok
INSERT INTO gc_active VALUES (1, 'one'), (2, 'two');

statement ok
VACUUM (REFRESH_TABLE) gc_active;

statement ok
SET sdb_faults = 'crash_after_commit';

statement error connection closed
INSERT INTO gc_active VALUES (3, 'three'), (4, 'four');

# --- restart ---
connection after
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT a, b FROM gc_active ORDER BY a;
----
a	b
1	one
2	two
3	three
4	four

# The idle table survived recovery untouched.
connection after
query
SELECT a, b FROM gc_idle ORDER BY a;
----
a	b
100	idle

# The tuned table (non-default persisted intervals) recovered intact -- proves
# the extra TableData fields round-trip through catalog (de)serialization.
connection after
query
SELECT a, b FROM gc_tuned ORDER BY a;
----
a	b
42	tuned

connection after
statement ok
DROP TABLE gc_tuned;

# The fresh, never-written table recovered as empty and is usable.
connection after
query
SELECT COUNT(*) AS n FROM gc_fresh;
----
n
0

connection after
statement ok
INSERT INTO gc_fresh VALUES (9, 'nine');

connection after
statement ok
VACUUM (REFRESH_TABLE) gc_fresh;

connection after
query
SELECT a, b FROM gc_fresh ORDER BY a;
----
a	b
9	nine

connection after
statement ok
INSERT INTO gc_idle VALUES (200, 'more');

connection after
statement ok
VACUUM (REFRESH_TABLE) gc_idle;

connection after
query
SELECT a, b FROM gc_idle ORDER BY a;
----
a	b
100	idle
200	more

connection after
statement ok
DROP TABLE gc_active;

connection after
statement ok
DROP TABLE gc_idle;

connection after
statement ok
DROP TABLE gc_fresh;
