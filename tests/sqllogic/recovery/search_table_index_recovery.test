control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sidx(id BIGINT PRIMARY KEY, tag TEXT)
  WITH (compaction_interval = 0);

statement ok
CREATE INDEX sidx_tag ON sidx USING inverted (tag);

statement ok
RESET sdb_faults;

# --- Fixture: a published baseline, durable in the iresearch index on disk. ---
statement ok
INSERT INTO sidx VALUES (1, 'red'), (2, 'blue');

statement ok
VACUUM (FLUSH_TABLE) sidx;

statement ok
SET sdb_faults = 'crash_after_commit';

statement error connection closed
INSERT INTO sidx VALUES (3, 'red'), (4, 'green');

# --- restart: reconnect once the runner brings the crashed instance back up.
# The first query retries until the restarted instance accepts connections; each
# post-restart query re-selects the connection so a stale handle is refreshed. --

# The storage-less index survived the restart.
connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT indexname FROM pg_indexes WHERE tablename = 'sidx' ORDER BY indexname;
----
indexname
sidx_pkey
sidx_tag

# The WAL-replayed row (3,'red') is re-indexed. A @@ predicate through the index
# scan is a term filter (the columnstore cannot evaluate @@), so matching both
# the published baseline row and the replayed row proves the replayed row's TERM
# was rebuilt, not just its stored value.
connection after_crash
query
SELECT id, tag FROM sidx_tag WHERE tag @@ 'red' ORDER BY id;
----
id	tag
1	red
3	red

# The bare table scan lowers a non-PK predicate through the rebuilt inverted
# index, the same term filter the index relation uses.
connection after_crash
query
EXPLAIN SELECT id FROM sidx WHERE tag = 'red';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────╮
│ Table: sidx            │
│ Index Filter:          │
│ ╭─ Term ─────────────╮ │
│ │ Field: tag(string) │ │
│ │ Value: red         │ │
│ ╰────────────────────╯ │
│ Projections: id        │
│ ~1 row                 │
╰────────────────────────╯
