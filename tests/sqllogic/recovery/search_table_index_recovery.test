# A user inverted index on a search table survives a crash + WAL replay: the
# index is storage-less (its terms live in the table's own iresearch store), so
# recovery must (a) rebuild the shard's merged index config at boot from the
# persisted index definition, and (b) re-index the WAL-replayed rows through
# that config. Rows fsynced to the WAL but never refresh-published exist ONLY in
# the WAL; after restart a predicate on the indexed column must still push down
# (no columnstore Column Filter) AND return those replayed rows -- which proves
# their terms were rebuilt, not just their stored values.

control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sidx(id BIGINT PRIMARY KEY, tag TEXT)
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX sidx_tag ON sidx USING inverted (tag);

statement ok
RESET sdb_faults;

# --- Fixture: a published baseline, durable in the iresearch index on disk. ---
statement ok
INSERT INTO sidx VALUES (1, 'red'), (2, 'blue');

statement ok
VACUUM (REFRESH_TABLE) sidx;

# Crash AFTER the WAL commit: (3,'red'),(4,'green') are fsynced into the WAL but
# never refresh-published, so they exist ONLY in the WAL; recovery must rebuild
# them into iresearch -- terms included.
statement ok
SET sdb_faults = 'crash_after_search_wal_commit';

statement error connection closed
INSERT INTO sidx VALUES (3, 'red'), (4, 'green');

# --- restart: reconnect once the runner brings the crashed instance back up.
# The first query retries until the restarted instance accepts connections; each
# post-restart query re-selects the connection so a stale handle is refreshed. --

# The storage-less index survived the restart.
connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT indexname FROM pg_indexes WHERE tablename = 'sidx' ORDER BY indexname;
----
indexname
sidx_pkey
sidx_tag

# The WAL-replayed row (3,'red') is re-indexed: an indexed-column predicate
# returns both the published baseline row and the replayed row.
connection after_crash
query
SELECT id, tag FROM sidx WHERE tag = 'red' ORDER BY id;
----
id	tag
1	red
3	red

# Pushdown still works after restart (config rebuilt at boot) -> the predicate is
# a term filter, not a columnstore Column Filter. Together with the row above,
# this proves the replayed row's term (not just its stored value) was rebuilt.
connection after_crash
query
EXPLAIN SELECT id FROM sidx WHERE tag = 'red';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─╮
│ Index: sidx      │
│ Lookup: search   │
│ Projections: id  │
│ ~1 row           │
╰──────────────────╯
