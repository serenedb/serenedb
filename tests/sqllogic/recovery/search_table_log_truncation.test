control substitution on

statement ok
RESET sdb_faults;

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE lt (id BIGINT, v TEXT) WITH (compaction_interval = 0);

statement ok
INSERT INTO lt SELECT i, 'bulk' FROM generate_series(1, 5000) g(i);

statement ok
INSERT INTO lt VALUES (100001, 'hot'), (100002, 'hot'), (100003, 'hot');

statement ok
DELETE FROM lt WHERE id % 10 = 0;

statement ok
CREATE TABLE lt_gone (id INT);

statement ok
INSERT INTO lt_gone VALUES (1);

statement ok
DROP TABLE lt_gone;

statement ok
CREATE TABLE lt_old (id INT);

statement ok
ALTER TABLE lt_old RENAME TO lt_new;

statement ok
