statement ok
SET sdb_faults = 'irs::MergeUnit';

statement ok
ALTER TABLE mf SET (compaction_interval = 100);

query ok retry 40 backoff 250ms
SELECT count(*) > 0 AS failed
FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'mf')
  AND type = 'merge' AND origin = 'background' AND outcome = 'failed';
----
failed
t

query
SELECT count(*) AS segments FROM sdb_segments('mf');
----
segments
4

query
SELECT value > 0 AS failed FROM sdb_metrics
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'mf')
  AND metric = 'num_failed_consolidations';
----
failed
t

statement ok
SET sdb_faults = '-irs::MergeUnit';

