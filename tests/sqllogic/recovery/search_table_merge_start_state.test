statement ok
CREATE TABLE mq_ids AS
SELECT merge_id FROM sdb_merges
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'mq');

statement ok
SET sdb_faults = '-pause_merge_unit';

query ok retry 40 backoff 250ms
SELECT origin, outcome, id = (SELECT merge_id FROM mq_ids) AS same_id
FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'mq');
----
origin	outcome	same_id
background	merged	t

