query ok retry 40 backoff 250ms
SELECT state, origin, started IS NOT NULL AS started, elapsed_ms >= 0 AS timed,
       cardinality(inputs) AS inputs, input_docs, estimated_bytes > 0 AS estimated
FROM sdb_merges
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'mq');
