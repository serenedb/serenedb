# Several inverted indexes on the same columns of one search table survive a
# crash with rows only in the WAL and a clean restart: every index answers from
# its own definition over every row.

control substitution on

statement ok
RESET sdb_faults;

statement ok
CREATE TEXT SEARCH DICTIONARY mr_en AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE MACRO mr_vec(i) AS
  list_transform(range(16),
                 j -> (sin(i * 0.0137 * (j % 5 + 1) + j * 0.71))::FLOAT)::FLOAT[16];

statement ok
CREATE TABLE mr_ref (id INTEGER PRIMARY KEY, body TEXT, emb FLOAT[16]);

statement ok
INSERT INTO mr_ref SELECT i, 'fox number ' || i, mr_vec(i) FROM range(1500) t(i);

statement ok
CREATE TABLE mr (id INTEGER PRIMARY KEY, body TEXT, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX mr_kw ON mr USING inverted (body);

statement ok
CREATE INDEX mr_txt ON mr USING inverted (id, body mr_en);

statement ok
CREATE INDEX mr_pq ON mr USING inverted (id, emb ivf (metric = 'l2', quant = 'pq', pq_m = 8));

statement ok
CREATE INDEX mr_hnsw ON mr USING inverted (id, emb hnsw (metric = 'l2'));

statement ok
CREATE INDEX mr_cos ON mr USING inverted (id, emb ivf (metric = 'cosine'));

statement ok
INSERT INTO mr SELECT * FROM mr_ref WHERE id < 1000;

statement ok
VACUUM (REFRESH_TABLE) mr;

statement ok
SET sdb_faults = 'crash_after_commit';

statement error connection closed
INSERT INTO mr SELECT * FROM mr_ref WHERE id >= 1000;

connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SET sdb_ivf_search_nprobe = 1000;

connection after_crash
statement ok
SET sdb_hnsw_ef_search = 2000;

connection after_crash
statement ok
SET sdb_ann_rescore_width = 100;

connection after_crash
query
SELECT (SELECT count(*) FROM mr) AS n,
       (SELECT count(*) FROM mr_kw WHERE body = 'fox number 1234') AS kw,
       (SELECT count(*) FROM mr_txt WHERE body @@ 'fox') AS txt;
----
n	kw	txt
1500	1	1500

connection after_crash
query
SELECT count(*) AS hits FROM (
  (SELECT id FROM mr_pq ORDER BY emb <-> mr_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM mr_ref ORDER BY emb <-> mr_vec(1234.5) LIMIT 10)) t;
----
hits
10

connection after_crash
query
SELECT count(*) AS hits FROM (
  (SELECT id FROM mr_hnsw ORDER BY emb <-> mr_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM mr_ref ORDER BY emb <-> mr_vec(1234.5) LIMIT 10)) t;
----
hits
10

connection after_crash
query
SELECT count(*) AS hits FROM (
  (SELECT id FROM mr_cos ORDER BY emb <=> mr_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM mr_ref ORDER BY emb <=> mr_vec(1234.5) LIMIT 10)) t;
----
hits
10

connection after_crash
statement ok
SET sdb_faults = 'shutdown_on_packet';

connection after_crash
statement error connection closed
SELECT 1;

connection after_restart
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SET sdb_ivf_search_nprobe = 1000;

connection after_restart
statement ok
SET sdb_hnsw_ef_search = 2000;

connection after_restart
statement ok
SET sdb_ann_rescore_width = 100;

connection after_restart
query
SELECT (SELECT count(*) FROM mr_kw WHERE body = 'fox number 77') AS kw,
       (SELECT count(*) FROM mr_txt WHERE body @@ 'number' AND id >= 1000) AS txt;
----
kw	txt
1	500

connection after_restart
query
SELECT count(*) AS hits FROM (
  (SELECT id FROM mr_pq ORDER BY emb <-> mr_vec(222.5) LIMIT 10)
  INTERSECT (SELECT id FROM mr_ref ORDER BY emb <-> mr_vec(222.5) LIMIT 10)) t;
----
hits
10

connection after_restart
query
SELECT count(*) AS hits FROM (
  (SELECT id FROM mr_hnsw ORDER BY emb <-> mr_vec(222.5) LIMIT 10)
  INTERSECT (SELECT id FROM mr_ref ORDER BY emb <-> mr_vec(222.5) LIMIT 10)) t;
----
hits
10

connection after_restart
query
SELECT count(*) AS hits FROM (
  (SELECT id FROM mr_cos ORDER BY emb <=> mr_vec(222.5) LIMIT 10)
  INTERSECT (SELECT id FROM mr_ref ORDER BY emb <=> mr_vec(222.5) LIMIT 10)) t;
----
hits
10
