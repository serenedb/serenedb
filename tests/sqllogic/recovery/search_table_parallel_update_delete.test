control substitution on

statement ok
SET threads = 4;


statement ok
SET GLOBAL checkpoint_threshold = '64KB';


statement ok
CREATE TABLE pud (a BIGINT, b TEXT)
  WITH (storage = 'search', compaction_interval = 0, refresh_interval = 0);


statement ok
CREATE TABLE pud_plain (a BIGINT, b TEXT);


statement ok
INSERT INTO pud SELECT i, 'seed' || i FROM range(0, 1000) t(i);


statement ok
VACUUM (REFRESH_TABLE) pud;


