statement error connection closed
UPDATE pud SET b = 'u5_' || a WHERE a < 100000;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
VACUUM (REFRESH_TABLE) pud;


connection after_crash
query
SELECT (SELECT count(*) FROM (SELECT a, b FROM pud EXCEPT ALL SELECT a, b FROM pud_plain)) AS only_search,
       (SELECT count(*) FROM (SELECT a, b FROM pud_plain EXCEPT ALL SELECT a, b FROM pud)) AS only_plain,
