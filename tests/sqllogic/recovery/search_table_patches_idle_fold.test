control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE pif (id BIGINT PRIMARY KEY, v INT);


statement ok
SET threads = 1;


statement ok
INSERT INTO pif SELECT i, 0 FROM range(10000) t(i);


statement ok
RESET threads;


statement ok
VACUUM (FLUSH_TABLE) pif;


query
SELECT count(DISTINCT rowid >> 32) AS segments FROM pif;
----
segments
1


statement ok
CREATE TEMP TABLE pif_oids AS SELECT 'pif'::regclass::oid AS tab;


statement ok
CREATE TEMP TABLE pif_files AS SELECT file FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/store/*/*.col'), pif_oids WHERE file LIKE '%/engine_v1/store/' || tab || '/%';


statement ok
UPDATE pif SET v = 1 WHERE id = 5;


query ok retry 60 backoff 500ms
SELECT count(*) > 0 AS folded FROM (SELECT file FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/store/*/*.col'), pif_oids WHERE file LIKE '%/engine_v1/store/' || tab || '/%' EXCEPT SELECT file FROM pif_files);
----
folded
t


query
SELECT v, count(*) AS n FROM pif GROUP BY v ORDER BY v;
----
v	n
0	9999
1	1


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT v, count(*) AS n FROM pif GROUP BY v ORDER BY v;
----
v	n
0	9999
1	1
