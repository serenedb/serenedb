control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE pmg (id BIGINT PRIMARY KEY, n BIGINT, body TEXT)
  WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
SET sdb_faults = 'pause_search_pieces_merged';


statement ok
INSERT INTO pmg
SELECT i, i * 7, CASE WHEN i % 5 = 1 THEN NULL ELSE 'body of the row number ' || i END
FROM generate_series(1, 300) s(i);


