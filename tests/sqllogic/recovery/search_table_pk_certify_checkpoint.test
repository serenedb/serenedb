control substitution on

# A keyed search table answers for its key against the part of the WAL its
# index has not published yet. A checkpoint moves that WAL under it: it closes
# the generation it retires and writes into the next one, and gives the closed
# file its retained name only when it finishes. A certification running in
# between has to find the retired generation where it still is, and to accept a
# live WAL one generation ahead of the database file.


statement ok
RESET sdb_faults;


statement ok
CREATE TABLE ckpt_pk(i INTEGER PRIMARY KEY, t TEXT);


statement ok
CREATE TABLE ckpt_rows(i INTEGER);


statement ok
SET sdb_faults = 'search_commit_prepared';


# Nothing holds key 9 when this one looks.
connection writer
statement async error
INSERT INTO ckpt_pk VALUES (9, 'parked');
----
db error: ERROR: duplicate key value violates the primary key of table "ckpt_pk"


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-search_commit_prepared:parked';


# Somebody takes it, and with no refresh the key lives only in the WAL.
connection other
statement ok
INSERT INTO ckpt_pk VALUES (9, 'winner');


# A checkpoint retires that WAL and takes the next generation for itself. The
# row below gives the generation it took a file of its own, so the pass under
# the commit lock has both to read.
connection default
statement ok
SET sdb_faults = 'pause_checkpoint';


connection checkpointer
statement async ok
CHECKPOINT;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_checkpoint:parked';


connection other
statement ok
INSERT INTO ckpt_rows VALUES (1);


connection default
query
SELECT count(*) AS n FROM pg_stat_activity
  WHERE state = 'active' AND query LIKE 'INSERT INTO ckpt_pk%';
----
n
1


connection default
statement ok
SET sdb_faults = 'search_commit_prepared:release';


# It answers for the key, and is done answering, while the checkpoint still
# holds the WAL it retired under the main name.
connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS n FROM pg_stat_activity
  WHERE state = 'active' AND query LIKE 'INSERT INTO ckpt_pk%';
----
n
0


connection default
statement ok
SET sdb_faults = 'pause_checkpoint:release';


wait


statement ok
RESET sdb_faults;


query
SELECT i, t FROM ckpt_pk ORDER BY i;
----
i	t
9	winner


# A failed checkpoint leaves that same window standing still: the WAL it
# retired keeps the main name and the WAL in use stays a generation ahead of
# the database file until the server restarts.


statement ok
CREATE DATABASE ckpt_fail;


statement ok
CREATE TABLE ckpt_fail.public.s(i INTEGER PRIMARY KEY, t TEXT);


statement ok
CREATE TABLE ckpt_fail.public.r(i INTEGER);


statement ok
INSERT INTO ckpt_fail.public.s VALUES (1, 'before');


statement ok
SET debug_checkpoint_abort = 'before_header_non_fatal';


statement error
CHECKPOINT ckpt_fail;
----
db error: ERROR: Checkpoint failed for database<slt:ignore>


statement ok
RESET debug_checkpoint_abort;


# Gives the generation the failed checkpoint took a file of its own.
statement ok
INSERT INTO ckpt_fail.public.r VALUES (1);


statement error
INSERT INTO ckpt_fail.public.s VALUES (1, 'after');
----
db error: ERROR: duplicate key value violates the primary key of table "s"


# A key of its own still goes in. What the table holds is not asked here: an
# index of a database whose checkpoint failed publishes nothing more until the
# server restarts and replays its WAL, which is what the backup driver test
# checks end to end.
statement ok
INSERT INTO ckpt_fail.public.s VALUES (2, 'after');
