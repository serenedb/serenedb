# Two committers racing on one primary key. The statement-end probe cannot
# settle this: both statements run before either commits, so each sees a table
# without the other's key and both are told to go ahead. What decides it is the
# pass under DuckDB's commit lock, which is serialized against every other
# committer on the database and still runs while the commit can be rolled back.
#
# `pause_search_commit_after_certify` parks a committer exactly between its two
# passes, which is the window the second pass answers for.

control substitution on

statement ok
CREATE DATABASE pkrace;


statement ok
CREATE TABLE pkrace.public.t (id BIGINT PRIMARY KEY, s TEXT)
  WITH (storage='search', refresh_interval=0, compaction_interval=0);


# A key that is already there, so the loser below cannot be mistaken for the
# statement-end probe working.
statement ok
INSERT INTO pkrace.public.t VALUES (0, 'base');


statement ok
SET sdb_faults = 'pause_search_commit_after_certify';


# Parks past its own pre-lock pass, which found key 1 free. The conflict is
# therefore raised at commit, not by the statement, and comes back wrapped as a
# commit failure -- sqlstate 40001 rather than 23505, which is what it is: the
# statement was admissible and a concurrent committer is what unmade it.
connection first
statement async error
INSERT INTO pkrace.public.t VALUES (1, 'first');
----
db error: ERROR: Failed to commit: Duplicate key on column "id" violates primary key constraint.


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_after_certify:parked';


# The park fires once, so this one runs straight through and commits key 1.
connection second
statement ok
INSERT INTO pkrace.public.t VALUES (1, 'second');


connection default
statement ok
SET sdb_faults = 'pause_search_commit_after_certify:release';


connection first
wait


# First committer wins. refresh_interval=0 keeps every commit above out of the
# reader, so the publish has to be asked for before the rows can be read back.
connection default
statement ok
VACUUM (REFRESH_TABLE) pkrace.public.t;


query
SELECT id, s FROM pkrace.public.t ORDER BY id;
----
id	s
0	base
1	second


# The loser's transaction is gone, not wedged: the same connection commits the
# key the winner did not take.
connection first
statement ok
INSERT INTO pkrace.public.t VALUES (2, 'after');


connection default
statement ok
VACUUM (REFRESH_TABLE) pkrace.public.t;


query
SELECT count(*) AS n FROM pkrace.public.t;
----
n
3


statement ok
RESET sdb_faults;


statement ok
DROP DATABASE pkrace;
