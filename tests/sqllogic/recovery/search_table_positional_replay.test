control substitution on

statement ok
RESET sdb_faults;

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE rp (id BIGINT, v TEXT) WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
CREATE TABLE rp_ref (id BIGINT, v TEXT);

statement ok
INSERT INTO rp SELECT i, 'a' FROM generate_series(0, 9999) g(i);

statement ok
INSERT INTO rp_ref SELECT i, 'a' FROM generate_series(0, 9999) g(i);

statement ok
VACUUM (REFRESH_TABLE) rp;

statement ok
INSERT INTO rp SELECT i, 'b' FROM generate_series(10000, 19999) g(i);

statement ok
INSERT INTO rp_ref SELECT i, 'b' FROM generate_series(10000, 19999) g(i);

statement ok
VACUUM (REFRESH_TABLE) rp;

statement ok
INSERT INTO rp SELECT i, 'c' FROM generate_series(20000, 29999) g(i);

statement ok
INSERT INTO rp_ref SELECT i, 'c' FROM generate_series(20000, 29999) g(i);

statement ok
VACUUM (REFRESH_TABLE) rp;

statement ok
BEGIN;

statement ok
DELETE FROM rp WHERE id BETWEEN 5000 AND 24999;

statement ok
DELETE FROM rp_ref WHERE id BETWEEN 5000 AND 24999;

statement ok
SET sdb_faults = 'crash_after_commit';

statement error connection closed
COMMIT;

connection after_long_run
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM rp;
----
n
10000

connection after_long_run
statement ok
VACUUM (REFRESH_TABLE) rp;

connection after_long_run
query
SELECT (SELECT count(*) FROM (SELECT id, v FROM rp EXCEPT ALL SELECT id, v FROM rp_ref)) + (SELECT count(*) FROM (SELECT id, v FROM rp_ref EXCEPT ALL SELECT id, v FROM rp)) AS diff;
----
diff
0

