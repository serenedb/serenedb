connection default
query
SELECT
  (SELECT count(*) FROM ras1) AS ras1,
  (SELECT count(*) FROM ras2) AS ras2,
  (SELECT count(*) FROM ras3) AS ras3,
  (SELECT count(*) FROM ras4) AS ras4;
----
ras1	ras2	ras3	ras4
2	2	2	2

connection default
statement ok
SET sdb_faults = 'crash_on_packet';

connection default
statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 'ras1' AS t, count(*) AS n, count(DISTINCT id) AS d, min(id) AS lo, max(id) AS hi FROM ras1
UNION ALL
SELECT 'ras2', count(*), count(DISTINCT id), min(id), max(id) FROM ras2
UNION ALL
SELECT 'ras3', count(*), count(DISTINCT id), min(id), max(id) FROM ras3
UNION ALL
SELECT 'ras4', count(*), count(DISTINCT id), min(id), max(id) FROM ras4
ORDER BY t;
----
t	n	d	lo	hi
ras1	5001	5001	7	14999
ras2	10001	10001	2	14999
ras3	5001	5001	3	14999
ras4	150000	150000	200000	449999

connection after_crash
statement ok
VACUUM (REFRESH_TABLE) ras1;

connection after_crash
statement ok
VACUUM (COMPACT_TABLE) ras2;

connection after_crash
query
SELECT 'ras1' AS t, count(*) AS n, min(id) AS lo, max(id) AS hi FROM ras1
UNION ALL
SELECT 'ras2', count(*), min(id), max(id) FROM ras2
ORDER BY t;
----
t	n	lo	hi
ras1	5001	7	14999
ras2	10001	2	14999
