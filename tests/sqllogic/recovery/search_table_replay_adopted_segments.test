control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE ras1 (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, segment_memory_max = 2097152);

statement ok
CREATE TABLE ras2 (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, segment_memory_max = 2097152);

statement ok
CREATE TABLE ras3 (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, segment_memory_max = 2097152);

statement ok
CREATE TABLE ras4 (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO ras1 VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO ras2 VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO ras3 VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO ras4 VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (REFRESH_TABLE) ras1;

statement ok
VACUUM (REFRESH_TABLE) ras2;

statement ok
VACUUM (REFRESH_TABLE) ras3;

statement ok
VACUUM (REFRESH_TABLE) ras4;

