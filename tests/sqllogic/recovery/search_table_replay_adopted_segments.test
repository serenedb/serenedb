connection default
statement ok
BEGIN;

connection default
statement ok
TRUNCATE ras4;

connection default
statement ok
INSERT INTO ras4 SELECT 200000 + i, 'q' || i FROM range(100000) t(i);

connection default
statement ok
COMMIT;

