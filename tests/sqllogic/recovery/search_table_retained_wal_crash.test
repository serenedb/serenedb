control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE DATABASE st_rcrash;


statement ok
CREATE TABLE st_rcrash.public.docs (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
CREATE TABLE st_rcrash.public.counts (id INTEGER);


statement ok
INSERT INTO st_rcrash.public.docs SELECT i, 'a' FROM range(0, 1000) r(i);


statement ok
INSERT INTO st_rcrash.public.counts VALUES (1);


statement ok
SET debug_checkpoint_abort = 'before_wal_finish';


statement error
CHECKPOINT st_rcrash;
----
db error: ERROR: Checkpoint failed for database<slt:ignore>


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_wal_finish
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(*) FILTER (WHERE body = 'a') AS a FROM st_rcrash.public.docs;
----
n	a
1000	1000


connection after_wal_finish
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM st_rcrash.public.counts;
----
ids
1


connection after_wal_finish
query
SELECT count(*) AS n FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/data.db.wal.retained.*');
----
n
0


connection after_wal_finish
statement ok
INSERT INTO st_rcrash.public.docs SELECT i, 'b' FROM range(1000, 1100) r(i);


connection after_wal_finish
statement ok
INSERT INTO st_rcrash.public.counts VALUES (2);


connection after_wal_finish
statement ok
CHECKPOINT st_rcrash;


connection after_wal_finish
statement ok
INSERT INTO st_rcrash.public.docs SELECT i, 'c' FROM range(1100, 1110) r(i);


connection after_wal_finish
statement ok
INSERT INTO st_rcrash.public.counts VALUES (3);


connection after_wal_finish
statement ok
SET debug_checkpoint_abort = 'before_header';


connection after_wal_finish
statement error
CHECKPOINT st_rcrash;
----
db error: ERROR: Checkpoint failed for database<slt:ignore>


connection after_wal_finish
statement ok
SET sdb_faults = 'crash_on_packet';


connection after_wal_finish
statement error connection closed
SELECT 1;


connection after_header
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(*) FILTER (WHERE body = 'b') AS b, count(*) FILTER (WHERE body = 'c') AS c FROM st_rcrash.public.docs;
----
n	b	c
1110	100	10


connection after_header
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM st_rcrash.public.counts;
----
ids
1,2,3


connection reader
statement ok
BEGIN;


connection reader
query
SELECT count(*) AS n FROM st_rcrash.public.counts;
----
n
3


connection after_header
statement ok
INSERT INTO st_rcrash.public.docs SELECT i, 'd' FROM range(2000, 2005) r(i);


connection after_header
statement ok
INSERT INTO st_rcrash.public.counts VALUES (4);


connection after_header
statement ok
SET debug_checkpoint_sleep_ms = 4000;


connection after_header
statement ok
SET debug_checkpoint_abort = 'before_moving_checkpoint_wal';


connection checkpointer
statement async error
CHECKPOINT st_rcrash;
----
db error: ERROR: Checkpoint failed for database<slt:ignore>


connection after_header
query ok retry 40 backoff 250ms
SELECT count(*) AS n FROM pg_stat_activity WHERE state = 'active' AND query LIKE 'CHECKPOINT st_rcrash%';
----
n
1


connection writer
statement ok
INSERT INTO st_rcrash.public.counts VALUES (5);


connection checkpointer
wait


connection reader
statement ok
ROLLBACK;


connection after_header
statement ok
SET sdb_faults = 'crash_on_packet';


connection after_header
statement error connection closed
SELECT 1;


connection after_move
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(*) FILTER (WHERE body = 'd') AS d FROM st_rcrash.public.docs;
----
n	d
1115	5


connection after_move
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM st_rcrash.public.counts;
