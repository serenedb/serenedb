ids
1,2,3,4,5


connection after_move
query
SELECT count(*) AS n FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v1/*/data.db.wal.retained.*');
----
n
0


connection after_move
statement ok
DROP DATABASE st_rcrash;
