statement ok
VACUUM (FLUSH_ALL);


statement ok
CHECKPOINT;


statement ok
SET VARIABLE rrs_own_dir = '${SDB_DATADIR}/engine_v1/store/' || (SELECT oid FROM pg_class WHERE relname = 'rrs_own') || '/*';


statement ok
CREATE TEMP TABLE rrs_own_files AS SELECT file FROM glob(getvariable('rrs_own_dir'));


statement ok
BEGIN;


statement ok
INSERT INTO rrs_own SELECT i, 'fox ' || i FROM range(1000, 6000) t(i);


query
