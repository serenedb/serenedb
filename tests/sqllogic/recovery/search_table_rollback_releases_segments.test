connection default
query ok retry 40 backoff 250ms
SELECT (SELECT value FROM sdb_metrics WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'rrs_re') AND metric = 'num_segments') AS segments, rrs_re_stale() > 0 AS held;
