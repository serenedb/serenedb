statement ok
CHECKPOINT;


statement ok
INSERT INTO rrs_re SELECT i, 'fox ' || i FROM range(2000, 3000) t(i);


statement ok
VACUUM (FLUSH_ALL);


statement ok
CHECKPOINT;


statement ok
SET VARIABLE rrs_re_dir = '${SDB_DATADIR}/engine_v1/store/' || (SELECT oid FROM pg_class WHERE relname = 'rrs_re') || '/*';


statement ok
CREATE MACRO rrs_re_stale() AS (
  (SELECT count(DISTINCT regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1))
   FROM glob(getvariable('rrs_re_dir'))
   WHERE regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1) <> '')
  - (SELECT value FROM sdb_metrics
     WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'rrs_re') AND metric = 'num_segments'));


query
SELECT rrs_re_stale() AS stale, (SELECT value FROM sdb_metrics WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'rrs_re') AND metric = 'num_segments') AS segments;
----
stale	segments
0	3


