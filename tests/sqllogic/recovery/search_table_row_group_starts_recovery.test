10000	0	9999	49995000


connection after_crash
query
SELECT k FROM rgs_far ORDER BY k LIMIT 2;
----
k
1
5


connection after_crash
statement ok
INSERT INTO rgs SELECT i FROM range(10000, 12000) t(i);


connection after_crash
statement ok
VACUUM (FLUSH_TABLE) rgs;


connection after_crash
statement ok
VACUUM (COMPACT_TABLE) rgs;


