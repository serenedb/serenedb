control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE rgs (k INT)
  WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
CREATE TABLE rgs_far (k INT)
  WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
SET threads = 1;


statement ok
INSERT INTO rgs SELECT i FROM range(0, 1000) t(i);


statement ok
VACUUM (FLUSH_TABLE) rgs;


statement ok
INSERT INTO rgs_far SELECT 5 + i FROM range(0, 1000) t(i);


statement ok
VACUUM (FLUSH_TABLE) rgs_far;


statement ok
INSERT INTO rgs SELECT i FROM range(1000, 3000) t(i);


statement ok
VACUUM (FLUSH_TABLE) rgs;


statement ok
INSERT INTO rgs_far
  SELECT CASE WHEN i < 2048 THEN 5 + i ELSE 100000 + i END
  FROM range(1000, 3000) t(i);


statement ok
VACUUM (FLUSH_TABLE) rgs_far;


statement ok
INSERT INTO rgs SELECT i FROM range(3000, 10000) t(i);


statement ok
INSERT INTO rgs_far
  SELECT CASE WHEN i = 3500 THEN 1 ELSE 100000 + i END
  FROM range(3000, 10000) t(i);


statement ok
RESET threads;


statement ok
VACUUM (FLUSH_TABLE) rgs;


statement ok
VACUUM (FLUSH_TABLE) rgs_far;


statement ok
SET sdb_faults = 'irs::ColWriterOmitsRowGroupStarts';


statement ok
VACUUM (COMPACT_TABLE) rgs;


statement ok
VACUUM (COMPACT_TABLE) rgs_far;


statement ok
RESET sdb_faults;


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_crash
query
EXPLAIN SELECT k FROM rgs ORDER BY k LIMIT 3 OFFSET 4100;
