statement ok
INSERT INTO sir VALUES (4, 'b'), (5, 'b'), (6, 'b')


statement ok
DELETE FROM sir WHERE v = 'b'


statement ok
SET sdb_faults = 'crash_on_packet'


statement error connection closed
SELECT 1;


connection after_first
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM sir;
----
n
3


