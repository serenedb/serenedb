connection after_crash
query
SELECT count(*) AS misplaced FROM (
  SELECT row_number() OVER (PARTITION BY sdb_row_position$ >> 32 ORDER BY sdb_row_position$) AS physical,
         row_number() OVER (PARTITION BY sdb_row_position$ >> 32 ORDER BY k DESC NULLS FIRST, sdb_row_position$) AS logical
  FROM srr) WHERE physical <> logical;
