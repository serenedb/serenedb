control substitution on

statement ok
CREATE TABLE srr (k INTEGER, v VARCHAR) SORTED BY (k DESC) WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO srr SELECT (i * 7) % 13, 'v' || i FROM range(200) t(i);

statement ok
VACUUM (REFRESH_TABLE) srr;

statement ok
CHECKPOINT;

statement ok
CREATE TABLE srr_log (a INTEGER, b TIMESTAMP) SORTED BY (a NULLS FIRST, b DESC NULLS LAST) WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO srr_log SELECT CASE WHEN i % 9 = 0 THEN NULL ELSE i % 4 END, TIMESTAMP '2026-01-01' + to_seconds(i) FROM range(300) t(i);

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;


