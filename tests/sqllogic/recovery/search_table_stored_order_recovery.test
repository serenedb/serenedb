control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE sor (id BIGINT, label TEXT) WITH (compaction_interval = 0);


statement ok
INSERT INTO sor VALUES (1, 'one');


statement ok
INSERT INTO sor VALUES (2, 'two');


statement ok
INSERT INTO sor VALUES (3, 'three');


statement ok
INSERT INTO sor VALUES (4, 'four');


statement ok
INSERT INTO sor VALUES (5, 'five');


statement ok
INSERT INTO sor VALUES (6, 'six');


statement ok
UPDATE sor SET label = 'two again' WHERE id = 2;


query
SELECT id, label FROM sor;
----
id	label
1	one
3	three
4	four
5	five
6	six
2	two again


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_crash
query
SELECT id, label FROM sor;
----
id	label
1	one
3	three
4	four
5	five
6	six
2	two again


connection after_crash
statement ok
VACUUM (FLUSH_TABLE) sor;


connection after_crash
statement ok
INSERT INTO sor VALUES (7, 'seven');


connection after_crash
statement ok
INSERT INTO sor VALUES (8, 'eight');


connection after_crash
query
SELECT id, label FROM sor;
----
id	label
1	one
3	three
4	four
5	five
6	six
2	two again
7	seven
8	eight


