control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE tai (id BIGINT, body TEXT)
  WITH (compaction_interval = 0);

statement ok
INSERT INTO tai VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (FLUSH_TABLE) tai;

statement ok
INSERT INTO tai VALUES (3, 'c');

statement ok
SET sdb_faults = 'pause_search_commit_before_build_truncate';

connection truncator
statement async error connection closed
TRUNCATE tai;

connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_build_truncate:parked';

connection default
statement ok
SET sdb_faults = 'pause_search_commit_after_irs';

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_build_truncate:release';

connection default
statement ok
VACUUM (FLUSH_TABLE) tai;

connection default
query
SELECT count(*) AS n FROM tai;
----
n
0

connection writer
statement async error connection closed
INSERT INTO tai VALUES (4, 'd');

connection default
query ok retry 40 backoff 250ms
SELECT count(*) AS n FROM tai;
----
n
1

connection default
statement ok
VACUUM (COMPACT_TABLE) tai;

connection default
statement ok
SET sdb_faults = 'crash_on_packet';

connection default
statement error connection closed
SELECT 1;

wait

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM tai;
----
n
1

connection after_crash
statement ok
INSERT INTO tai VALUES (5, 'e');

connection after_crash
statement ok
VACUUM (FLUSH_TABLE) tai;

connection after_crash
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM tai;
----
ids
4,5
