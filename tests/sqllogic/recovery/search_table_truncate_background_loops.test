control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE tbl (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 5, compaction_interval = 10);

statement ok
INSERT INTO tbl SELECT i, 'a' || i FROM range(1, 1001) t(i);

statement ok
INSERT INTO tbl SELECT i, 'b' || i FROM range(1001, 2001) t(i);

statement ok
TRUNCATE tbl;

statement ok
INSERT INTO tbl SELECT i, 'c' || i FROM range(2001, 3001) t(i);

statement ok
VACUUM (REFRESH_TABLE) tbl;

statement ok
DELETE FROM tbl WHERE id < 2500;

statement ok
VACUUM (REFRESH_TABLE) tbl;

query
SELECT count(*) AS n, min(id) AS lo, max(id) AS hi FROM tbl;
----
n	lo	hi
501	2500	3000

statement ok
BEGIN;

statement ok
INSERT INTO tbl SELECT i, 'd' || i FROM range(3001, 3101) t(i);

statement ok
TRUNCATE tbl;

statement ok
INSERT INTO tbl SELECT i, 'e' || i FROM range(3101, 3201) t(i);

statement ok
COMMIT;

statement ok
INSERT INTO tbl SELECT i, 'f' || i FROM range(3201, 4201) t(i);

statement ok
VACUUM (REFRESH_TABLE) tbl;

statement ok
DELETE FROM tbl WHERE id % 3 = 0;

statement ok
VACUUM (REFRESH_TABLE) tbl;

statement ok
UPDATE tbl SET body = 'u' WHERE id < 3200;

statement ok
VACUUM (REFRESH_TABLE) tbl;

query
SELECT count(*) AS n, count(DISTINCT id) AS d, min(id) AS lo, max(id) AS hi, count(*) FILTER (WHERE body = 'u') AS u FROM tbl;
----
n	d	lo	hi	u
733	733	3101	4199	66

statement ok
TRUNCATE tbl;

statement ok
INSERT INTO tbl SELECT 5000 + i, 'g' || i FROM range(100) t(i);

statement ok
BEGIN;

statement ok
INSERT INTO tbl SELECT 6000 + i, 'h' || i FROM range(10) t(i);

statement ok
COMMIT;

statement ok
VACUUM (REFRESH_TABLE) tbl;

query
SELECT count(*) AS n, sum(id) AS s FROM tbl;
----
n	s
110	564995

statement ok
TRUNCATE tbl;

statement ok
INSERT INTO tbl SELECT 5000 + i, 'g' || i FROM range(100) t(i);

statement ok
INSERT INTO tbl SELECT 6000 + i, 'h' || i FROM range(10) t(i);

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n, count(DISTINCT id) AS d, sum(id) AS s FROM tbl;
----
n	d	s
110	110	564995
