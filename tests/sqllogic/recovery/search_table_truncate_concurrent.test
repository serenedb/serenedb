control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;

statement ok
CREATE TABLE tcl (id BIGINT, body TEXT)
  WITH (compaction_interval = 0);

statement ok
INSERT INTO tcl VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (FLUSH_TABLE) tcl;

statement ok
SET sdb_faults = 'pause_search_commit_before_irs';

connection truncator
statement async ok
TRUNCATE tcl;

connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_commit_before_irs:parked';

connection other
statement error
DELETE FROM tcl WHERE id = 1;
----
db error: ERROR: could not serialize access due to concurrent update


connection other
statement error
TRUNCATE tcl;
----
db error: ERROR: could not serialize access due to concurrent update


connection writer
statement async ok
INSERT INTO tcl VALUES (3, 'c');

connection default
statement ok
SET sdb_faults = 'pause_search_commit_before_irs:release';

wait

connection writer
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM tcl;
----
ids
3

connection writer
statement ok
BEGIN;

connection writer
statement ok
INSERT INTO tcl VALUES (4, 'd');

connection other
statement ok
TRUNCATE tcl;

connection writer
statement ok
COMMIT;

connection writer
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM tcl;
----
ids
4

connection other
statement ok
BEGIN;

connection other
statement ok
TRUNCATE tcl;

connection other
statement ok
INSERT INTO tcl VALUES (5, 'e');

connection writer
statement ok
INSERT INTO tcl VALUES (6, 'f');

connection other
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM tcl;
----
ids
5

connection other
statement ok
COMMIT;

connection writer
statement ok
VACUUM (FLUSH_TABLE) tcl;

connection writer
query
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM tcl;
----
ids
5,6

connection other
statement ok
TRUNCATE tcl;

connection other
statement ok
INSERT INTO tcl VALUES (7, 'g');

connection default
statement ok
SET sdb_faults = 'crash_on_packet';

connection default
statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) AS ids FROM tcl;
----
ids
7
