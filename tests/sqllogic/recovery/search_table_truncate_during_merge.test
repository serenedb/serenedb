control substitution on

statement ok
CREATE TABLE tm (id INT PRIMARY KEY, body TEXT) WITH (storage = 'search', compaction_interval = 0, compaction_max_segments = 4);

statement ok
INSERT INTO tm SELECT i, 'fox dog' FROM generate_series(1, 100) s(i);

statement ok
VACUUM (REFRESH_TABLE) tm;

statement ok
INSERT INTO tm SELECT i, 'fox dog' FROM generate_series(101, 200) s(i);

statement ok
VACUUM (REFRESH_TABLE) tm;

statement ok
INSERT INTO tm SELECT i, 'fox dog' FROM generate_series(201, 300) s(i);

statement ok
VACUUM (REFRESH_TABLE) tm;

statement ok
INSERT INTO tm SELECT i, 'fox dog' FROM generate_series(301, 400) s(i);

statement ok
VACUUM (REFRESH_TABLE) tm;

statement ok
SET sdb_faults = 'pause_merge_unit';

statement ok
ALTER TABLE tm SET (compaction_interval = 100);

query ok retry 40 backoff 250ms
SELECT count(*) AS running FROM sdb_merges
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'tm') AND state = 'running';
----
running
1

statement ok
TRUNCATE tm;

statement ok
SET sdb_faults = '-pause_merge_unit';

query ok retry 40 backoff 250ms
SELECT value AS running FROM sdb_metrics WHERE metric = 'compaction_active';
----
running
0

statement ok
VACUUM (REFRESH_TABLE) tm;

query
SELECT count(*) AS n FROM tm;
----
n
0

query
SELECT count(*) AS segments FROM sdb_segments('tm');
----
segments
0

query
SELECT count(*) AS finished FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'tm')
  AND type = 'merge' AND origin = 'background' AND outcome IN ('cancelled', 'merged');
----
finished
1

statement ok
INSERT INTO tm VALUES (1, 'fox');

statement ok
VACUUM (REFRESH_TABLE) tm;

query
SELECT count(*) AS n, min(body) AS body FROM tm;
----
n	body
1	fox

statement ok
DROP TABLE tm;
