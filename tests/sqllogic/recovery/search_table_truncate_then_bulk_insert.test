control substitution on


statement ok
RESET sdb_faults;


statement ok
CREATE TABLE tbi_src AS SELECT i FROM range(0, 600000) r(i);


statement ok
CREATE TABLE tbi (id BIGINT, tag TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO tbi VALUES (-1, 'old');


statement ok
VACUUM (REFRESH_TABLE) tbi;


statement ok
BEGIN;


statement ok
TRUNCATE tbi;


statement ok
INSERT INTO tbi SELECT i, 'live' FROM tbi_src;


statement ok
COMMIT;


statement ok
VACUUM (REFRESH_TABLE) tbi;


query
SELECT count(*) AS n, count(*) FILTER (WHERE tag = 'live') AS live FROM tbi;
----
n	live
600000	600000


