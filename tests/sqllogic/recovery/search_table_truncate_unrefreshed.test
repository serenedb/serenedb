statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT
  (SELECT coalesce(string_agg(id::VARCHAR, ',' ORDER BY id), '-') FROM tu1) AS tu1,
  (SELECT coalesce(string_agg(id::VARCHAR, ',' ORDER BY id), '-') FROM tu2) AS tu2,
  (SELECT coalesce(string_agg(id::VARCHAR, ',' ORDER BY id), '-') FROM tu3) AS tu3,
  (SELECT coalesce(string_agg(id::VARCHAR, ',' ORDER BY id), '-') FROM tu4) AS tu4;
----
tu1	tu2	tu3	tu4
3	3	-	2
