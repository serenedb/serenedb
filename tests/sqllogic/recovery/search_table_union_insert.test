control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
COPY (SELECT i AS x, 'v' || i AS y FROM range(0, 60000) t(i))
  TO '${__TEST_DIR__}/union_src.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2000);

statement ok
RESET sdb_faults;

statement ok
CREATE TABLE u (x INTEGER, y TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
SET profiling_renderer_settings = {'deterministic': true};

query
EXPLAIN INSERT INTO u
  SELECT * FROM (VALUES (5, 'i5'), (7, 'i7')) v(x, y)
  UNION ALL
  SELECT x, y FROM read_parquet('${__TEST_DIR__}/union_src.parquet');
