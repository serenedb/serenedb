v	n
0	2598
1	200
2	200
3	1
8	1


connection default
statement ok
SET sdb_faults = 'crash_on_packet';


connection default
statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT v, count(*) AS n FROM pr GROUP BY v ORDER BY v;
----
v	n
0	2598
1	200
2	200
3	1
8	1


connection after_crash
query
SELECT id, v, s FROM pr WHERE id IN (2, 3, 7, 1002, 2002) ORDER BY id;
----
id	v	s
2	2	c2
3	3	a3
7	8	a7
1002	2	c1002
2002	0	d2002


connection after_crash
statement ok
CHECKPOINT;


connection after_crash
statement ok
UPDATE pr SET v = 4 WHERE id % 10 = 4;


connection after_crash
statement ok
SET sdb_faults = 'crash_on_packet';


connection after_crash
statement error connection closed
SELECT 1;


connection after_second
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
