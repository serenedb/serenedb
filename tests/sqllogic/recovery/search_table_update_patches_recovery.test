control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
RESET sdb_faults;


statement ok
CREATE TABLE pr (id BIGINT PRIMARY KEY, v INT, s TEXT) WITH (compaction_interval = 0);


statement ok
INSERT INTO pr SELECT i, 0, 'a' || i FROM generate_series(0, 999) g(i);


statement ok
CHECKPOINT;


statement ok
INSERT INTO pr SELECT i, 0, 'b' || i FROM generate_series(1000, 1999) g(i);


statement ok
VACUUM (FLUSH_TABLE) pr;


statement ok
UPDATE pr SET v = 1 WHERE id % 10 = 1;


statement ok
SET sdb_faults = 'pause_search_compact_before_publish';


connection compactor
statement async ok
VACUUM (COMPACT_TABLE) pr;


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_search_compact_before_publish:parked';


connection writer
statement ok
UPDATE pr SET v = 2, s = 'c' || id WHERE id % 10 = 2;


connection late
statement ok
BEGIN;


connection late
statement ok
UPDATE pr SET v = 3 WHERE id = 3;


connection default
statement ok
SET sdb_faults = 'pause_search_compact_before_publish:release';


wait


connection late
statement ok
COMMIT;


connection default
query
SELECT count(DISTINCT rowid >> 32) AS segments FROM pr;
----
segments
1


connection default
query
SELECT v, count(*) AS n FROM pr GROUP BY v ORDER BY v;
----
v	n
0	1599
1	200
2	200
3	1


connection default
statement ok
INSERT INTO pr SELECT i, 0, 'd' || i FROM generate_series(2000, 2999) g(i);


connection default
statement ok
VACUUM (FLUSH_TABLE) pr;


connection stale
statement ok
BEGIN;


connection stale
statement ok
UPDATE pr SET v = 9 WHERE id = 7;


connection default
statement ok
VACUUM (COMPACT_TABLE) pr;


connection default
statement ok
UPDATE pr SET v = 8 WHERE id = 7;


connection stale
statement error
COMMIT;
----
db error: ERROR: could not serialize access due to concurrent update


connection default
query
SELECT v, count(*) AS n FROM pr GROUP BY v ORDER BY v;
