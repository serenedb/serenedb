control substitution on


statement ok
CREATE TABLE sfd_rows (id BIGINT, body TEXT);


statement ok
INSERT INTO sfd_rows SELECT i, 'w' || i FROM range(0, 1000) t(i);


statement ok
VACUUM (FLUSH_TABLE) sfd_rows;


query
SELECT regexp_extract(file, '[.]([a-z]+)$', 1) AS kind, count(*) AS files
FROM glob('${SDB_DATADIR:-/nonexistent-datadir}/engine_v2/store/*')
GROUP BY ALL ORDER BY kind;
----
kind	files
col	1


statement ok
CREATE TABLE sfd_tags (id BIGINT, tag TEXT);


statement ok
CREATE INDEX sfd_tags_idx ON sfd_tags USING inverted (tag);


statement ok
INSERT INTO sfd_tags SELECT i, 'unique' || i FROM range(0, 1000) t(i);


statement ok
VACUUM (FLUSH_TABLE) sfd_tags;


query
