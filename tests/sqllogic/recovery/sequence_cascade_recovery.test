control substitution on


statement ok
CREATE TABLE iceberg_manifest (id SERIAL PRIMARY KEY, name TEXT);


statement count 2
INSERT INTO iceberg_manifest (name) VALUES ('a'), ('b');


statement ok
CREATE TABLE iceberg_partition (
  id BIGINT NOT NULL DEFAULT nextval('public.iceberg_manifest_id_seq'),
  payload TEXT
);


statement count 1
INSERT INTO iceberg_partition (payload) VALUES ('pre-crash');


query
SELECT id, payload FROM iceberg_partition ORDER BY id;
----
id	payload
3	pre-crash


statement ok
SET sdb_faults = 'crash_on_drop';


statement error connection closed
DROP TABLE iceberg_manifest CASCADE;


connection after_crash
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


# A SERIAL column's sequence is owned by its table, so the recovered drop takes
# the sequence with the table, and CASCADE takes the table that defaults to the
# sequence. Recovery applies the whole cascade, not half of it.
connection after_crash
query
SELECT count(*) FROM pg_class WHERE relname IN
  ('iceberg_manifest', 'iceberg_manifest_id_seq', 'iceberg_partition');
----
count
0


connection after_crash
statement error
SELECT id, payload FROM iceberg_partition ORDER BY id;
----
db error: ERROR: Table with name iceberg_partition does not exist!<slt:ignore>


# Every name the cascade took is free again, and the sequence comes back with
# the table.
connection after_crash
statement ok
CREATE TABLE iceberg_manifest (id SERIAL PRIMARY KEY, name TEXT);


connection after_crash
statement count 1
INSERT INTO iceberg_manifest (name) VALUES ('post-crash');


connection after_crash
query
SELECT id, name FROM iceberg_manifest;
----
id	name
1	post-crash


connection after_crash
statement ok
DROP TABLE iceberg_manifest CASCADE;
