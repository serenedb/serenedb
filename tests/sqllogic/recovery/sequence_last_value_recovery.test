control substitution on

statement ok
RESET sdb_faults;


statement ok
CREATE SEQUENCE slv_q START 100 INCREMENT 7;


query
SELECT nextval('slv_q') AS v FROM range(5);
----
v
100
107
114
121
128


statement ok
CREATE SEQUENCE slv_c START 2 INCREMENT -1 MINVALUE 1 MAXVALUE 3 CYCLE;


query
SELECT nextval('slv_c') AS v FROM range(4);
----
v
2
1
3
2


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;
----
?column?
1


connection after_crash
query
SELECT last_value >= 128 AS ahead, nextval('slv_q') = last_value + 7 AS follows FROM duckdb_sequences() WHERE sequence_name = 'slv_q';
----
ahead	follows
t	t


connection after_crash
query
SELECT last_value IS NOT NULL AS known FROM duckdb_sequences() WHERE sequence_name = 'slv_c';
----
known
t


connection after_crash
statement ok
CREATE SEQUENCE slv_k START 10;


connection after_crash
query
SELECT nextval('slv_k') AS v FROM range(3);
----
v
10
11
12


connection after_crash
statement ok
CHECKPOINT;


connection after_crash
statement ok
SET sdb_faults = 'crash_on_packet';


connection after_crash
statement error connection closed
SELECT 1;


connection after_second_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;
----
?column?
1


connection after_second_crash
query
SELECT last_value >= 12 AS ahead, nextval('slv_k') = last_value + 1 AS follows FROM duckdb_sequences() WHERE sequence_name = 'slv_k';
----
ahead	follows
t	t


connection after_second_crash
statement ok
DROP SEQUENCE slv_q;


connection after_second_crash
statement ok
DROP SEQUENCE slv_c;


connection after_second_crash
statement ok
DROP SEQUENCE slv_k;
