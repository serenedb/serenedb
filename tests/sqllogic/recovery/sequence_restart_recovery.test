control substitution on

statement ok
CREATE TABLE rr_events (id SERIAL PRIMARY KEY, v INT);


statement count 100
INSERT INTO rr_events (v) SELECT i FROM generate_series(1, 100) AS s(i);


statement ok
TRUNCATE rr_events RESTART IDENTITY;


statement count 3
INSERT INTO rr_events (v) VALUES (1), (2), (3);


statement ok
CREATE SEQUENCE rr_seq START 5;


query
