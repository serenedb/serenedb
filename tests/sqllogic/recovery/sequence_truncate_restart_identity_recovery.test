INSERT INTO stri_a (v) SELECT i FROM generate_series(1, 5) AS s(i);


connection after_crash
statement count 5
INSERT INTO stri_b (v) SELECT i FROM generate_series(1, 5) AS s(i);


connection after_crash
query
