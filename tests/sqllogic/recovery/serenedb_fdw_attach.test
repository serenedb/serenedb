connection restart
statement ok
SET sdb_faults = 'shutdown_on_packet';

connection restart
statement error
SELECT 1;


connection after_restart
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CHECKPOINT postgres;

system ok
rm -rf $__TEST_DIR__/sfa_recovered && mkdir $__TEST_DIR__/sfa_recovered && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfa_recovered/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfa_recovered/catalog.wal

connection after_restart
statement ok
