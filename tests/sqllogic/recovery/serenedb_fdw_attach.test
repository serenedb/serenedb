connection holder
statement ok
SELECT * FROM pg_backup_stop();

statement ok
CREATE SERVER sfa_new FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfa_new', database '${__DATABASE__}');

query
