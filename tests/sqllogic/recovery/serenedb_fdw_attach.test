control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sfa_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO sfa_docs VALUES (1, 'alpha');

statement ok
CHECKPOINT;

statement ok
INSERT INTO sfa_docs VALUES (2, 'beta');

connection holder
query
SELECT pg_backup_start('sfa_dirty') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfa_dirty && mkdir -p $__TEST_DIR__/sfa_dirty/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/wal $__TEST_DIR__/sfa_dirty/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/store $__TEST_DIR__/sfa_dirty/engine_v1/

connection holder
statement ok
SELECT * FROM pg_backup_stop();

statement ok
CREATE TABLE sfa_files AS
SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_dirty/**');

statement ok
CREATE SERVER sfa_dirty FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfa_dirty', database '${__DATABASE__}');

query
SELECT id, body FROM sfa_dirty.public.sfa_docs ORDER BY id;
----
id	body
1	alpha
2	beta

statement ok
DROP SERVER sfa_dirty;

query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_dirty/**')
   EXCEPT SELECT * FROM sfa_files)
  UNION ALL
  (SELECT * FROM sfa_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_dirty/**')));
----
changed
0


statement ok
ALTER TABLE sfa_docs ADD COLUMN extra INTEGER DEFAULT 7;

statement ok
INSERT INTO sfa_docs VALUES (3, 'gamma', 8);

statement ok
CREATE TABLE sfa_empty (a INTEGER);

statement ok
CREATE PERSISTENT SECRET sfa_secret (TYPE s3, KEY_ID 'k');

statement ok
SELECT pg_replication_origin_create('sfa_origin');

statement ok
SELECT pg_replication_origin_advance('sfa_origin', '0/10');

statement ok
CREATE ROLE sfa_role;

statement ok
ALTER ROLE sfa_role CREATEDB;

statement ok
CREATE DATABASE fdw_side;

statement ok
CREATE SEQUENCE fdw_side.public.s;

query
SELECT nextval('fdw_side.public.s') AS n;
----
n
1

