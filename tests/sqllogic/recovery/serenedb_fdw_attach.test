control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.sfa_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO postgres.public.sfa_docs VALUES (1, 'alpha');

statement ok
CHECKPOINT postgres;

statement ok
INSERT INTO postgres.public.sfa_docs VALUES (2, 'beta');

system ok
rm -rf $__TEST_DIR__/sfa_dirty && mkdir $__TEST_DIR__/sfa_dirty && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfa_dirty/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfa_dirty/catalog.wal

statement ok
CREATE TABLE sfa_files AS
SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_dirty/**');

statement ok
CREATE SERVER sfa_dirty FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfa_dirty/5');

query
SELECT id, body FROM sfa_dirty.public.sfa_docs ORDER BY id;
----
id	body
1	alpha
2	beta

statement ok
DROP SERVER sfa_dirty;

query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_dirty/**')
   EXCEPT SELECT * FROM sfa_files)
  UNION ALL
  (SELECT * FROM sfa_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_dirty/**')));
----
changed
0


statement ok
CHECKPOINT postgres;

statement ok
ALTER TABLE postgres.public.sfa_docs ADD COLUMN extra INTEGER DEFAULT 7;

statement ok
CHECKPOINT postgres;

system ok
rm -rf $__TEST_DIR__/sfa_new && mkdir $__TEST_DIR__/sfa_new && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfa_new/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfa_new/catalog.wal

statement ok
CREATE SERVER sfa_new FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfa_new/5');

query
SELECT id, body, extra FROM sfa_new.public.sfa_docs ORDER BY id;
----
id	body	extra
1	alpha	7
2	beta	7

statement ok
CREATE SERVER sfa_twice FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfa_new/5');

query
SELECT (SELECT count(*) FROM sfa_new.public.sfa_docs) AS first, (SELECT count(*) FROM sfa_twice.public.sfa_docs) AS second;
----
first	second
2	2

statement ok
DROP SERVER sfa_new;

query
SELECT count(*) AS n FROM sfa_twice.public.sfa_docs;
----
n
2

statement ok
DROP SERVER sfa_twice;

statement ok
ATTACH '${__TEST_DIR__}/sfa_new/5' AS sfa_session (TYPE serenedb, READ_ONLY);

connection sfa_other
query
SELECT count(*) AS n FROM sfa_session.public.sfa_docs;
----
n
2

statement ok
DETACH sfa_session;


statement ok
CREATE TABLE postgres.public.sfa_notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO postgres.public.sfa_notes SELECT i, 'note' FROM range(1, 4) t(i);

statement ok
VACUUM (REFRESH_TABLE) postgres.public.sfa_notes;

statement ok
INSERT INTO postgres.public.sfa_notes SELECT i, 'note' FROM range(4, 6) t(i);

statement ok
CHECKPOINT postgres;

query
SELECT count(*) AS n FROM postgres.public.sfa_notes;
----
n
3

