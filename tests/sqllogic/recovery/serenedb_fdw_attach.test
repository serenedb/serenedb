control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.sfa_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO postgres.public.sfa_docs VALUES (1, 'alpha');

statement ok
CHECKPOINT postgres;

statement ok
INSERT INTO postgres.public.sfa_docs VALUES (2, 'beta');

system ok
rm -rf $__TEST_DIR__/sfa_wal && mkdir $__TEST_DIR__/sfa_wal && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfa_wal/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfa_wal/catalog.wal

query
SELECT size > 0 AS has_entries FROM read_blob('${__TEST_DIR__}/sfa_wal/5/data.db.wal');
----
has_entries
t

statement ok
CREATE TABLE sfa_files AS
SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_wal/**');

statement ok
CREATE SERVER sfa_wal FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfa_wal/5');

query
SELECT id, body FROM sfa_wal.public.sfa_docs ORDER BY id;
----
id	body
1	alpha

statement ok
DROP SERVER sfa_wal;

query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_wal/**')
   EXCEPT SELECT * FROM sfa_files)
  UNION ALL
  (SELECT * FROM sfa_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfa_wal/**')));
----
changed
0


