n
0

statement ok
CREATE SERVER sfa_twice FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfa_new', database '${__DATABASE__}');

query
SELECT (SELECT count(*) FROM sfa_new.public.sfa_docs) AS first, (SELECT count(*) FROM sfa_twice.public.sfa_docs) AS second;
----
first	second
3	3

statement ok
DROP SERVER sfa_new;

query
SELECT count(*) AS n FROM sfa_twice.public.sfa_docs;
----
n
3

statement ok
DROP SERVER sfa_twice;

statement ok
ATTACH '${__TEST_DIR__}/sfa_new' AS sfa_session (TYPE serenedb, READ_ONLY, DATABASE '${__DATABASE__}');

connection sfa_other
query
SELECT count(*) AS n FROM sfa_session.public.sfa_docs;
----
n
3

statement ok
DETACH sfa_session;


