control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sfc_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO sfc_docs VALUES (1, 'alpha'), (2, 'beta');

connection holder
query
SELECT pg_backup_start('sfc') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfc_copy && mkdir -p $__TEST_DIR__/sfc_copy/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/wal $__TEST_DIR__/sfc_copy/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/store $__TEST_DIR__/sfc_copy/engine_v1/ && cp ${SDB_DATADIR}/PG_VERSION $__TEST_DIR__/sfc_copy/

connection holder
statement ok
SELECT * FROM pg_backup_stop();

system ok
rm -rf $__TEST_DIR__/sfc_gone $__TEST_DIR__/sfc_locked && cp -r $__TEST_DIR__/sfc_copy $__TEST_DIR__/sfc_gone && cp -r $__TEST_DIR__/sfc_copy $__TEST_DIR__/sfc_locked

statement ok
CREATE TABLE sfc_files AS
SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfc_copy/**');


connection crash_before
statement ok
SET sdb_faults = 'crash_before_commit';

connection crash_before
statement error
CREATE SERVER sfc_before FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfc_copy', database '${__DATABASE__}');


connection after_before
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM pg_foreign_server WHERE srvname = 'sfc_before';
----
n
0

connection after_before
query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name = 'sfc_before';
----
n
0


connection crash_after
statement ok
SET sdb_faults = 'crash_after_commit';

connection crash_after
statement error
CREATE SERVER sfc_after FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfc_copy', database '${__DATABASE__}');


connection after_after
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM sfc_after.public.sfc_docs;
----
n
2


connection drop_after
statement ok
SET sdb_faults = 'crash_after_commit';

connection drop_after
statement error
DROP SERVER sfc_after;


connection after_drop
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM pg_foreign_server WHERE srvname = 'sfc_after';
----
n
0

connection after_drop
query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfc_copy/**')
   EXCEPT SELECT * FROM sfc_files)
  UNION ALL
  (SELECT * FROM sfc_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfc_copy/**')));
----
changed
0


connection after_drop
statement ok
CREATE SERVER sfc_kept FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfc_copy', database '${__DATABASE__}');

connection after_drop
statement ok
CREATE SERVER sfc_gone FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfc_gone', database '${__DATABASE__}');

connection after_drop
statement ok
CREATE SERVER sfc_locked FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfc_locked', database '${__DATABASE__}');

system ok
rm -rf $__TEST_DIR__/sfc_gone && rm -f $__TEST_DIR__/sfc_locked.locked $__TEST_DIR__/sfc_locked.release

system async ok
flock -x $__TEST_DIR__/sfc_locked/PG_VERSION sh -c 'touch $__TEST_DIR__/sfc_locked.locked; while [ ! -f $__TEST_DIR__/sfc_locked.release ]; do sleep 0.05; done'

connection restart
statement ok
SET sdb_faults = 'shutdown_on_packet';

connection restart
statement error
SELECT 1;


connection after_restart
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM sfc_kept.public.sfc_docs;
----
n
2

system ok
test -f $__TEST_DIR__/sfc_locked.locked

connection after_restart
query
SELECT srvname FROM pg_foreign_server WHERE srvname LIKE 'sfc_%' ORDER BY srvname;
----
srvname
sfc_gone
sfc_kept
sfc_locked

connection after_restart
query
SELECT database_name FROM duckdb_databases() WHERE database_name LIKE 'sfc_%' ORDER BY database_name;
----
database_name
sfc_kept

connection after_restart
query
SELECT count(*) AS n FROM sfc_docs;
----
n
2

system ok
touch $__TEST_DIR__/sfc_locked.release

wait

connection after_restart
statement ok
DROP SERVER sfc_gone;

connection after_restart
statement ok
DROP SERVER sfc_locked;

connection after_restart
statement ok
CREATE SERVER sfc_locked FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfc_locked', database '${__DATABASE__}');

connection after_restart
query
SELECT count(*) AS n FROM sfc_locked.public.sfc_docs;
----
n
2

connection after_restart
statement ok
DROP SERVER sfc_locked;

connection after_restart
statement ok
DROP SERVER sfc_kept;
