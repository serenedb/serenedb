control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE DATABASE sfd_shop;

statement ok
CREATE TABLE sfd_shop.public.docs(id INTEGER PRIMARY KEY, body VARCHAR) WITH (compaction_interval = 0);

statement ok
CREATE INDEX docs_idx ON sfd_shop.public.docs USING inverted(id, body);

statement ok
ALTER TABLE sfd_shop.public.docs SET (compaction_interval = 600000);

statement ok
INSERT INTO sfd_shop.public.docs
SELECT i, CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(1, 101) t(i);

statement ok
CREATE TABLE sfd_shop.public.notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (compaction_interval = 0);

statement ok
CREATE INDEX notes_idx ON sfd_shop.public.notes USING inverted(body);

statement ok
INSERT INTO sfd_shop.public.notes SELECT i, 'note' || (i % 4) FROM range(1, 41) t(i);

statement ok
CREATE TABLE sfd_shop.public.gone(id INTEGER, body VARCHAR) WITH (compaction_interval = 0);

statement ok
CREATE INDEX gone_idx ON sfd_shop.public.gone USING inverted(body);

statement ok
INSERT INTO sfd_shop.public.gone VALUES (1, 'kept');

statement ok
CREATE INDEX gone_id_idx ON sfd_shop.public.gone USING inverted(id);

statement ok
CREATE TABLE sfd_shop.public.gone_notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (compaction_interval = 0);

statement ok
INSERT INTO sfd_shop.public.gone_notes VALUES (1, 'dropped');

statement ok
DROP INDEX sfd_shop.public.gone_idx;

statement ok
DROP INDEX sfd_shop.public.gone_id_idx;

statement ok
DROP TABLE sfd_shop.public.gone_notes;

statement ok
ALTER TABLE sfd_shop.public.gone RENAME TO gone_renamed;

statement ok
CREATE TABLE docs(id INTEGER);

statement ok
INSERT INTO docs VALUES (7);

statement ok
CREATE DATABASE sfd_again;

statement ok
CREATE TABLE sfd_again.public.t AS SELECT 1 AS v;

statement ok
DROP DATABASE sfd_again;

statement ok
CREATE DATABASE sfd_again;

statement ok
CREATE TABLE sfd_again.public.t AS SELECT 2 AS v;

statement ok
COPY (SELECT oid FROM pg_database WHERE datname = 'sfd_shop') TO '${__TEST_DIR__}/sfd_shop.oid' (FORMAT csv, HEADER false);

statement ok
COPY (SELECT table_oid FROM duckdb_tables() WHERE database_name = 'sfd_shop' AND table_name = 'notes') TO '${__TEST_DIR__}/sfd_notes.oid' (FORMAT csv, HEADER false);

connection holder
query
SELECT pg_backup_start('sfd') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfd_copy && mkdir -p $__TEST_DIR__/sfd_copy/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/log $__TEST_DIR__/sfd_copy/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/[0-9]* $__TEST_DIR__/sfd_copy/engine_v1/

connection holder
statement ok
SELECT * FROM pg_backup_stop();

statement ok
CREATE SERVER sfd_snap FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfd_copy', database 'sfd_shop');

query
SELECT count(*) AS n, sum(id) AS s FROM sfd_snap.public.docs;
----
n	s
100	5050

query
SELECT count(*) AS n FROM sfd_snap.public.docs_idx WHERE body @@ 'even';
----
n
50

query
SELECT id FROM sfd_snap.public.docs_idx WHERE body @@ 'even' ORDER BY id LIMIT 3;
----
id
2
4
6

query
SELECT count(*) AS n FROM sfd_snap.public.notes;
----
n
40

query
SELECT id FROM sfd_snap.public.notes WHERE body @@ 'note1' ORDER BY id LIMIT 3;
----
id
1
5
9

query
SELECT count(*) AS n FROM sfd_snap.public.gone_renamed;
----
n
1

query
SELECT
  (SELECT count(*) FROM duckdb_indexes() WHERE database_name = 'sfd_snap' AND index_name IN ('gone_idx', 'gone_id_idx')) AS indexes,
  (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'sfd_snap' AND table_name IN ('gone', 'gone_notes')) AS tables;
----
indexes	tables
0	0

query
SELECT reloptions FROM sfd_snap.pg_catalog.pg_class WHERE relname = 'docs';
----
reloptions
{compaction_interval=600000}

statement ok
CREATE SERVER sfd_again_snap FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfd_copy', database 'sfd_again');

query
SELECT v FROM sfd_again_snap.public.t;
----
v
2

statement ok
DROP SERVER sfd_snap;

statement ok
DROP SERVER sfd_again_snap;

system ok
rm -rf $__TEST_DIR__/sfd_torn && cp -r $__TEST_DIR__/sfd_copy $__TEST_DIR__/sfd_torn && rm -rf $__TEST_DIR__/sfd_torn/engine_v1/$(cat $__TEST_DIR__/sfd_shop.oid)/$(cat $__TEST_DIR__/sfd_notes.oid)

statement error
CREATE SERVER sfd_torn FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfd_torn', database 'sfd_shop');
----
db error: ERROR: the directory "<slt:ignore>" of notes (oid <slt:ignore>) is missing


query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name IN ('sfd_snap', 'sfd_again_snap', 'sfd_torn');
