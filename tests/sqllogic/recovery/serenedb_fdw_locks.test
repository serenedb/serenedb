control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.sfl_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO postgres.public.sfl_docs VALUES (1, 'alpha'), (2, 'beta');

statement ok
CHECKPOINT postgres;

system ok
rm -rf $__TEST_DIR__/sfl_copy && mkdir $__TEST_DIR__/sfl_copy && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfl_copy/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfl_copy/catalog.wal


system ok
rm -f $__TEST_DIR__/sfl_owner.locked $__TEST_DIR__/sfl_owner.release

system async ok
python3 -c "import fcntl,os,sys,time; f=open(sys.argv[1],'r+b'); fcntl.lockf(f,fcntl.LOCK_EX); open(sys.argv[2],'w').close(); [time.sleep(0.05) for _ in iter(lambda: os.path.exists(sys.argv[3]),True)]" $__TEST_DIR__/sfl_copy/5/data.db $__TEST_DIR__/sfl_owner.locked $__TEST_DIR__/sfl_owner.release

system ok
for i in $(seq 1 400); do [ -f $__TEST_DIR__/sfl_owner.locked ] && exit 0; sleep 0.05; done; exit 1

statement error
CREATE SERVER sfl_owned FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfl_copy/5');
----
db error: ERROR: Could not set lock on file "<slt:ignore>": Conflicting lock is held in <slt:ignore>


query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name = 'sfl_owned';
----
n
0

system ok
touch $__TEST_DIR__/sfl_owner.release

wait


system ok
rm -f $__TEST_DIR__/sfl_log.locked $__TEST_DIR__/sfl_log.release

system async ok
python3 -c "import fcntl,os,sys,time; f=open(sys.argv[1],'r+b'); fcntl.lockf(f,fcntl.LOCK_EX); open(sys.argv[2],'w').close(); [time.sleep(0.05) for _ in iter(lambda: os.path.exists(sys.argv[3]),True)]" $__TEST_DIR__/sfl_copy/catalog.wal $__TEST_DIR__/sfl_log.locked $__TEST_DIR__/sfl_log.release

system ok
for i in $(seq 1 400); do [ -f $__TEST_DIR__/sfl_log.locked ] && exit 0; sleep 0.05; done; exit 1

statement error
CREATE SERVER sfl_logged FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfl_copy/5');
----
db error: ERROR: Could not set lock on file "<slt:ignore>/catalog.wal": Conflicting lock is held in <slt:ignore>


system ok
python3 -c "import fcntl,struct,sys; f=open(sys.argv[1],'rb'); l=fcntl.fcntl(f,fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_WRLCK,0,0,0,0)); sys.exit(0 if struct.unpack('hhqqi',l)[0]==fcntl.F_UNLCK else 1)" $__TEST_DIR__/sfl_copy/5/data.db

system ok
touch $__TEST_DIR__/sfl_log.release

wait


