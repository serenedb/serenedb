python3 -c "import fcntl,os,sys,time; f=open(sys.argv[1],'r+b'); fcntl.lockf(f,fcntl.LOCK_EX); open(sys.argv[2],'w').close(); [time.sleep(0.05) for _ in iter(lambda: os.path.exists(sys.argv[3]),True)]" $__TEST_DIR__/sfl_live/LOCK $__TEST_DIR__/sfl_live.locked $__TEST_DIR__/sfl_live.release

