control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sfl_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO sfl_docs VALUES (1, 'alpha'), (2, 'beta');

connection holder
query
SELECT pg_backup_start('sfl') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfl_copy && mkdir -p $__TEST_DIR__/sfl_copy/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/wal $__TEST_DIR__/sfl_copy/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/store $__TEST_DIR__/sfl_copy/engine_v1/ && cp ${SDB_DATADIR}/PG_VERSION $__TEST_DIR__/sfl_copy/

connection holder
statement ok
SELECT * FROM pg_backup_stop();


system ok
rm -f $__TEST_DIR__/sfl_owner.locked $__TEST_DIR__/sfl_owner.release

system async ok
flock -x $__TEST_DIR__/sfl_copy/PG_VERSION sh -c 'touch $__TEST_DIR__/sfl_owner.locked; while [ ! -f $__TEST_DIR__/sfl_owner.release ]; do sleep 0.05; done'

system ok
for i in $(seq 1 400); do [ -f $__TEST_DIR__/sfl_owner.locked ] && exit 0; sleep 0.05; done; exit 1

statement error
CREATE SERVER sfl_owned FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_copy', database '${__DATABASE__}');
----
db error: ERROR: could not attach "<slt:ignore>": the data directory is in use: '<slt:ignore>' is locked by a running server; stop it first


query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name = 'sfl_owned';
----
n
0

system ok
touch $__TEST_DIR__/sfl_owner.release

wait


statement ok
CREATE SERVER sfl_copy FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_copy', database '${__DATABASE__}');

system ok
! flock -n -x $__TEST_DIR__/sfl_copy/PG_VERSION true

system ok
timeout 60 $SERENED $__TEST_DIR__/sfl_copy --listen='postgres://127.0.0.1:0' > $__TEST_DIR__/sfl_start.log 2>&1; [ $? -ne 0 ] && grep -q "is locked by a running server or a read-only attachment" $__TEST_DIR__/sfl_start.log

query
SELECT count(*) AS n FROM sfl_copy.public.sfl_docs;
----
n
2

statement ok
DROP SERVER sfl_copy;

system ok
flock -n -x $__TEST_DIR__/sfl_copy/PG_VERSION true


system ok
rm -rf $__TEST_DIR__/sfl_link && ln -s $__TEST_DIR__/sfl_copy $__TEST_DIR__/sfl_link

statement ok
CREATE SERVER sfl_first FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_copy', database '${__DATABASE__}');

statement ok
CREATE SERVER sfl_second FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_link', database '${__DATABASE__}');

query
SELECT (SELECT count(*) FROM sfl_first.public.sfl_docs) AS first, (SELECT count(*) FROM sfl_second.public.sfl_docs) AS second;
----
first	second
2	2

system ok
flock -n -s $__TEST_DIR__/sfl_copy/PG_VERSION true

statement ok
DROP SERVER sfl_first;

system ok
! flock -n -x $__TEST_DIR__/sfl_copy/PG_VERSION true

query
SELECT count(*) AS n FROM sfl_second.public.sfl_docs;
----
n
2

statement ok
DROP SERVER sfl_second;

system ok
flock -n -x $__TEST_DIR__/sfl_copy/PG_VERSION true

query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name LIKE 'sfl_%';
----
n
0
