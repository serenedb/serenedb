rm -rf $__TEST_DIR__/sfl_live && mkdir -p $__TEST_DIR__/sfl_live/engine_v1 && cp -r $__TEST_DIR__/sfl_copy/5 $__TEST_DIR__/sfl_live/engine_v1/5 && cp $__TEST_DIR__/sfl_copy/catalog.wal $__TEST_DIR__/sfl_live/engine_v1/catalog.wal && echo 1 > $__TEST_DIR__/sfl_live/LOCK && rm -f $__TEST_DIR__/sfl_live.locked $__TEST_DIR__/sfl_live.release

