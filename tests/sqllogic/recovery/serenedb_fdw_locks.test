----
db error: ERROR: Could not set lock on file "<slt:ignore>": <slt:ignore>


system ok
python3 -c "import fcntl,struct,sys; f=open(sys.argv[1],'rb'); l=fcntl.fcntl(f,fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_WRLCK,0,0,0,0)); sys.exit(0 if struct.unpack('hhqqi',l)[0]!=fcntl.F_UNLCK else 1)" ${SDB_DATADIR}/engine_v1/5/data.db

statement ok
