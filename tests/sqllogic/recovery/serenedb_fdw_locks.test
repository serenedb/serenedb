control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sfl_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO sfl_docs VALUES (1, 'alpha'), (2, 'beta');

connection holder
query
SELECT pg_backup_start('sfl') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfl_copy && mkdir -p $__TEST_DIR__/sfl_copy/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/wal $__TEST_DIR__/sfl_copy/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/store $__TEST_DIR__/sfl_copy/engine_v1/

connection holder
statement ok
SELECT * FROM pg_backup_stop();


system ok
rm -f $__TEST_DIR__/sfl_owner.locked $__TEST_DIR__/sfl_owner.release

system async ok
python3 -c "import fcntl,glob,os,sys,time; f=open(sorted(glob.glob(sys.argv[1]))[0],'r+b'); fcntl.lockf(f,fcntl.LOCK_EX); open(sys.argv[2],'w').close(); [time.sleep(0.05) for _ in iter(lambda: os.path.exists(sys.argv[3]),True)]" "$__TEST_DIR__/sfl_copy/engine_v1/wal/*.log" $__TEST_DIR__/sfl_owner.locked $__TEST_DIR__/sfl_owner.release

system ok
for i in $(seq 1 400); do [ -f $__TEST_DIR__/sfl_owner.locked ] && exit 0; sleep 0.05; done; exit 1

statement error
CREATE SERVER sfl_owned FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_copy', database '${__DATABASE__}');
----
db error: ERROR: Could not set lock on file "<slt:ignore>": Conflicting lock is held in <slt:ignore>


query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name = 'sfl_owned';
----
n
0

system ok
touch $__TEST_DIR__/sfl_owner.release

wait


statement ok
CREATE SERVER sfl_copy FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_copy', database '${__DATABASE__}');

system ok
python3 -c "import fcntl,glob,struct,sys; sys.exit(0 if all(struct.unpack('hhqqi',fcntl.fcntl(open(p,'rb'),fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_WRLCK,0,0,0,0)))[0]!=fcntl.F_UNLCK for p in glob.glob(sys.argv[1])) else 1)" "$__TEST_DIR__/sfl_copy/engine_v1/wal/*.log"

system ok
timeout 60 $SERENED $__TEST_DIR__/sfl_copy --listen='postgres://127.0.0.1:0' > $__TEST_DIR__/sfl_start.log 2>&1; [ $? -ne 0 ] && grep -q "Could not set lock" $__TEST_DIR__/sfl_start.log

query
SELECT count(*) AS n FROM sfl_copy.public.sfl_docs;
----
n
2

statement ok
DROP SERVER sfl_copy;

system ok
python3 -c "import fcntl,glob,struct,sys; sys.exit(0 if all(struct.unpack('hhqqi',fcntl.fcntl(open(p,'rb'),fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_WRLCK,0,0,0,0)))[0]==fcntl.F_UNLCK for p in glob.glob(sys.argv[1])) else 1)" "$__TEST_DIR__/sfl_copy/engine_v1/wal/*.log"


system ok
rm -rf $__TEST_DIR__/sfl_link && ln -s $__TEST_DIR__/sfl_copy $__TEST_DIR__/sfl_link

statement ok
CREATE SERVER sfl_first FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_copy', database '${__DATABASE__}');

statement ok
CREATE SERVER sfl_second FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfl_link', database '${__DATABASE__}');

query
SELECT (SELECT count(*) FROM sfl_first.public.sfl_docs) AS first, (SELECT count(*) FROM sfl_second.public.sfl_docs) AS second;
----
first	second
2	2

system ok
python3 -c "import fcntl,glob,struct,sys; sys.exit(0 if all(struct.unpack('hhqqi',fcntl.fcntl(open(p,'rb'),fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_RDLCK,0,0,0,0)))[0]==fcntl.F_UNLCK for p in glob.glob(sys.argv[1])) else 1)" "$__TEST_DIR__/sfl_copy/engine_v1/wal/*.log"

statement ok
DROP SERVER sfl_first;

system ok
python3 -c "import fcntl,glob,struct,sys; sys.exit(0 if all(struct.unpack('hhqqi',fcntl.fcntl(open(p,'rb'),fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_WRLCK,0,0,0,0)))[0]!=fcntl.F_UNLCK for p in glob.glob(sys.argv[1])) else 1)" "$__TEST_DIR__/sfl_copy/engine_v1/wal/*.log"

query
SELECT count(*) AS n FROM sfl_second.public.sfl_docs;
----
n
2

statement ok
DROP SERVER sfl_second;

system ok
python3 -c "import fcntl,glob,struct,sys; sys.exit(0 if all(struct.unpack('hhqqi',fcntl.fcntl(open(p,'rb'),fcntl.F_GETLK,struct.pack('hhqqi',fcntl.F_WRLCK,0,0,0,0)))[0]==fcntl.F_UNLCK for p in glob.glob(sys.argv[1])) else 1)" "$__TEST_DIR__/sfl_copy/engine_v1/wal/*.log"

query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name LIKE 'sfl_%';
----
n
0
