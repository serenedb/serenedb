control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.sfp_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
CREATE INDEX sfp_docs_idx ON postgres.public.sfp_docs USING inverted(id, body)
  WITH (refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO postgres.public.sfp_docs VALUES (1, 'alpha'), (2, 'beta');

statement ok
CHECKPOINT postgres;

system ok
rm -rf $__TEST_DIR__/sfp_snap && mkdir $__TEST_DIR__/sfp_snap && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfp_snap/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfp_snap/catalog.wal

statement ok
CREATE SERVER sfp_snap FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfp_snap/5');

statement ok
CREATE ROLE sfp_reader LOGIN PASSWORD 'sfp_pw';


connection sfp_reader user=sfp_reader password=sfp_pw
statement error
SELECT count(*) FROM sfp_snap.public.sfp_docs;
----
db error: ERROR: permission denied for foreign server sfp_snap


connection default
statement ok
GRANT USAGE ON FOREIGN SERVER sfp_snap TO sfp_reader;

connection sfp_reader user=sfp_reader password=sfp_pw
query
SELECT count(*) AS n FROM sfp_snap.public.sfp_docs;
----
n
2

connection sfp_reader user=sfp_reader password=sfp_pw
query
SELECT id FROM sfp_snap.public.sfp_docs_idx WHERE body @@ 'beta';
----
id
2

connection default
statement ok
REVOKE USAGE ON FOREIGN SERVER sfp_snap FROM sfp_reader;

connection sfp_reader user=sfp_reader password=sfp_pw
statement error
SELECT count(*) FROM sfp_snap.public.sfp_docs;
----
db error: ERROR: permission denied for foreign server sfp_snap


connection default
statement ok
DROP SERVER sfp_snap;

connection default
statement ok
DROP ROLE sfp_reader;
