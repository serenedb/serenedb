control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE sfr_docs(id INTEGER PRIMARY KEY, body VARCHAR) WITH (compaction_interval = 0);

statement ok
CREATE INDEX sfr_docs_idx ON sfr_docs USING inverted(id, body);

statement ok
INSERT INTO sfr_docs
SELECT i, CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(1, 101) t(i);

statement ok
CREATE TABLE sfr_notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (compaction_interval = 0);

statement ok
CREATE INDEX sfr_notes_idx ON sfr_notes USING inverted(body);

statement ok
INSERT INTO sfr_notes SELECT i, 'note' || (i % 4) FROM range(1, 41) t(i);

statement ok
CHECKPOINT;

statement ok
INSERT INTO sfr_notes VALUES (100, 'note1');

statement ok
CREATE VIEW sfr_even AS SELECT id FROM sfr_docs WHERE id % 2 = 0;

statement ok
CREATE TABLE sfr_base(id INTEGER PRIMARY KEY, label TEXT, score INTEGER);

statement ok
INSERT INTO sfr_base VALUES (1, 'alpha', 30), (2, 'beta', 25), (3, 'gamma', 30);

statement ok
CREATE VIEW sfr_base_v AS SELECT * FROM sfr_base;

statement ok
CREATE INDEX sfr_base_v_inv ON sfr_base_v
  USING inverted(score, id included(), label included());

connection holder
query
SELECT pg_backup_start('sfr') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfr_snap && mkdir -p $__TEST_DIR__/sfr_snap/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/wal $__TEST_DIR__/sfr_snap/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/store $__TEST_DIR__/sfr_snap/engine_v1/ && cp ${SDB_DATADIR}/PG_VERSION $__TEST_DIR__/sfr_snap/

connection holder
statement ok
SELECT * FROM pg_backup_stop();

statement ok
CREATE TABLE sfr_files AS
SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfr_snap/**');

statement ok
CREATE SERVER sfr_snap FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfr_snap', database '${__DATABASE__}');

query
SELECT type, readonly FROM duckdb_databases() WHERE database_name = 'sfr_snap';
----
type	readonly
serenedb	t

query
SELECT count(*) AS n, sum(id) AS s FROM sfr_snap.public.sfr_docs;
----
n	s
100	5050

query
SELECT count(*) AS n FROM sfr_snap.public.sfr_docs_idx WHERE body @@ 'even';
----
n
50

query
SELECT id FROM sfr_snap.public.sfr_docs_idx WHERE body @@ 'even' ORDER BY id LIMIT 3;
----
id
2
4
6

query
SELECT count(*) AS n FROM sfr_snap.public.sfr_notes;
----
n
41

query
SELECT id FROM sfr_snap.public.sfr_notes WHERE body @@ 'note1' ORDER BY id DESC LIMIT 3;
----
id
100
37
33

query
SELECT count(*) AS n FROM sfr_snap.public.sfr_even;
----
n
50

query
SELECT id, label FROM sfr_snap.public.sfr_base_v_inv ORDER BY id;
----
id	label
1	alpha
2	beta
3	gamma

query
SELECT id, label FROM sfr_snap.public.sfr_base_v_inv WHERE score = 30 ORDER BY id;
----
id	label
1	alpha
3	gamma

statement ok
USE sfr_snap;

query
SELECT schema_name, entry_type, name FROM sdb_catalog_sets() WHERE name LIKE 'sfr_base%' ORDER BY name;
----
schema_name	entry_type	name
public	Table	sfr_base
public	View	sfr_base_v
public	Index	sfr_base_v_inv

statement ok
USE ${__DATABASE__};


statement ok
INSERT INTO sfr_docs VALUES (1000, 'even');

statement ok
INSERT INTO sfr_notes VALUES (1000, 'note1');

statement ok
CHECKPOINT;

statement ok
INSERT INTO sfr_docs VALUES (1002, 'even');

query
SELECT (SELECT count(*) FROM sfr_even) AS live_even,
       (SELECT count(*) FROM sfr_snap.public.sfr_even) AS snap_even,
       (SELECT count(*) FROM sfr_docs_idx WHERE body @@ 'even') AS live_docs,
       (SELECT count(*) FROM sfr_snap.public.sfr_docs_idx WHERE body @@ 'even') AS snap_docs,
       (SELECT count(*) FROM sfr_notes WHERE body @@ 'note1') AS live_notes,
       (SELECT count(*) FROM sfr_snap.public.sfr_notes WHERE body @@ 'note1') AS snap_notes;
----
live_even	snap_even	live_docs	snap_docs	live_notes	snap_notes
52	50	52	50	12	11

query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfr_snap/**')
   EXCEPT SELECT * FROM sfr_files)
  UNION ALL
  (SELECT * FROM sfr_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfr_snap/**')));
----
changed
0


statement ok
SET sdb_faults = 'shutdown_on_packet';

statement error
SELECT 1;


connection after_restart
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) AS n FROM sfr_snap.public.sfr_docs_idx WHERE body @@ 'even';
----
n
50

connection after_restart
query
SELECT count(*) AS n FROM sfr_snap.public.sfr_notes;
----
n
41

connection after_restart
query
SELECT id, label FROM sfr_snap.public.sfr_base_v_inv WHERE score = 30 ORDER BY id;
----
id	label
1	alpha
3	gamma

connection after_restart
query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfr_snap/**')
   EXCEPT SELECT * FROM sfr_files)
  UNION ALL
  (SELECT * FROM sfr_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/sfr_snap/**')));
----
changed
0

connection after_restart
statement ok
DROP SERVER sfr_snap;

connection after_restart
query
SELECT count(*) AS n FROM duckdb_databases() WHERE database_name = 'sfr_snap';
----
n
0

connection after_restart
query
SELECT count(*) AS n FROM sfr_files
WHERE filename NOT IN (SELECT filename FROM read_blob('${__TEST_DIR__}/sfr_snap/**'));
----
n
0

connection after_restart
statement ok
CREATE SERVER sfr_again FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sfr_snap', database '${__DATABASE__}');

connection after_restart
query
SELECT count(*) AS n FROM sfr_again.public.sfr_docs;
----
n
100

connection after_restart
statement ok
DROP SERVER sfr_again;
