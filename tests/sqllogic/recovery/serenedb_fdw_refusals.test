control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.sfx_docs(id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
CREATE INDEX sfx_docs_idx ON postgres.public.sfx_docs USING inverted(id, body)
  WITH (refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO postgres.public.sfx_docs VALUES (1, 'alpha'), (2, 'beta');

statement ok
CREATE TABLE postgres.public.sfx_notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO postgres.public.sfx_notes VALUES (1, 'gamma');

statement ok
VACUUM (REFRESH_TABLE) postgres.public.sfx_notes;

statement ok
CREATE SEQUENCE postgres.public.sfx_seq;

statement count 2
COPY (SELECT 1 AS id, 'alpha' AS body UNION ALL SELECT 2, 'beta')
TO '${__TEST_DIR__}/sfx_src.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW postgres.public.sfx_view AS SELECT * FROM read_parquet('${__TEST_DIR__}/sfx_src.parquet');

statement ok
CREATE INDEX sfx_view_idx ON postgres.public.sfx_view USING inverted(id, body);

statement ok
CHECKPOINT postgres;

system ok
rm -rf $__TEST_DIR__/sfx_snap && mkdir $__TEST_DIR__/sfx_snap && cp -r ${SDB_DATADIR}/engine_v1/5 $__TEST_DIR__/sfx_snap/5 && cp ${SDB_DATADIR}/engine_v1/catalog.wal $__TEST_DIR__/sfx_snap/catalog.wal

statement ok
CREATE SERVER sfx_snap FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfx_snap/5');


