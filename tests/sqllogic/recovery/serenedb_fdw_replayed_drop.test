control substitution on

# A read-only attach replays the log of the directory it opens, drops included.
# A drop replayed there leaves the files of the dropped table and inverted
# index where they are: the attach changes nothing it reads.

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.frd_docs(id INTEGER PRIMARY KEY, body VARCHAR)
  WITH (compaction_interval = 0);

statement ok
INSERT INTO postgres.public.frd_docs VALUES (1, 'alpha');

statement ok
CREATE TABLE postgres.public.frd_plain(id INTEGER, body VARCHAR)
  WITH (compaction_interval = 0);

statement ok
INSERT INTO postgres.public.frd_plain VALUES (1, 'alpha'), (2, 'beta');

statement count 2
COPY (SELECT 1 AS id, 'alpha' AS body UNION ALL SELECT 2, 'beta')
TO '${__TEST_DIR__}/frd_src.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW postgres.public.frd_view AS SELECT * FROM read_parquet('${__TEST_DIR__}/frd_src.parquet');

statement ok
CREATE INDEX frd_view_idx ON postgres.public.frd_view USING inverted (id, body);

statement ok
VACUUM (FLUSH_TABLE) postgres.public.frd_docs;

statement ok
VACUUM (FLUSH_TABLE) postgres.public.frd_plain;

statement ok
CHECKPOINT;

system ok
rm -rf $__TEST_DIR__/frd && mkdir -p $__TEST_DIR__/frd/engine_v2 && cp -r ${SDB_DATADIR}/engine_v2/store $__TEST_DIR__/frd/engine_v2/ && cp ${SDB_DATADIR}/PG_VERSION $__TEST_DIR__/frd/

statement ok
DROP TABLE postgres.public.frd_docs;

statement ok
DROP INDEX postgres.public.frd_view_idx;

system ok
cp -r ${SDB_DATADIR}/engine_v2/wal $__TEST_DIR__/frd/engine_v2/

statement ok
CREATE TABLE frd_files AS
SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/frd/**');

query
SELECT count(*) > 2 AS stored FROM frd_files;
----
stored
t

statement ok
CREATE SERVER frd FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/frd');

query
SELECT id, body FROM frd.public.frd_plain ORDER BY id;
----
id	body
1	alpha
2	beta

query
SELECT count(*) AS n FROM sdb_tables() WHERE database_name = 'frd' AND table_name = 'frd_docs';
----
n
0

statement ok
DROP SERVER frd;

query
SELECT count(*) AS changed FROM (
  (SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/frd/**')
   EXCEPT SELECT * FROM frd_files)
  UNION ALL
  (SELECT * FROM frd_files
   EXCEPT SELECT filename, size, last_modified FROM read_blob('${__TEST_DIR__}/frd/**')));
----
changed
0
