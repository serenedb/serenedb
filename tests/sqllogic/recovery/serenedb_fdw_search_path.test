control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE postgres.public.sfsp_docs(id INTEGER PRIMARY KEY, body VARCHAR) WITH (compaction_interval = 0);

statement ok
CREATE INDEX sfsp_docs_idx ON postgres.public.sfsp_docs USING inverted(id, body);

statement ok
INSERT INTO postgres.public.sfsp_docs VALUES (1, 'alpha'), (2, 'beta');

connection holder
query
SELECT pg_backup_start('sfsp') IS NOT NULL AS started;
----
started
t

system ok
rm -rf $__TEST_DIR__/sfsp_snap && mkdir -p $__TEST_DIR__/sfsp_snap/engine_v1 && cp -r ${SDB_DATADIR}/engine_v1/wal $__TEST_DIR__/sfsp_snap/engine_v1/ && cp -r ${SDB_DATADIR}/engine_v1/store $__TEST_DIR__/sfsp_snap/engine_v1/

connection holder
statement ok
SELECT * FROM pg_backup_stop();

connection default

statement ok
CREATE SCHEMA sfsp_s;

statement ok
CREATE TABLE sfsp_s.sfsp_t(v INTEGER);

statement ok
INSERT INTO sfsp_s.sfsp_t VALUES (42);

statement ok
SET search_path = sfsp_s, public;

statement ok
CREATE SERVER sfsp_snap FOREIGN DATA WRAPPER serenedb_fdw OPTIONS (path '${__TEST_DIR__}/sfsp_snap');

query
SHOW search_path;
----
search_path
sfsp_s, public

query
SELECT v FROM sfsp_t;
----
v
42

statement ok
ATTACH '${__TEST_DIR__}/sfsp_snap' AS sfsp_session (TYPE serenedb, READ_ONLY);

query
SHOW search_path;
----
search_path
sfsp_s, public

statement ok
DETACH sfsp_session;

connection restart
statement ok
SET sdb_faults = 'shutdown_on_packet';

connection restart
statement error
SELECT 1;


connection after_restart
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SET search_path = sfsp_s, public;

connection after_restart
query
SELECT id FROM sfsp_snap.public.sfsp_docs_idx WHERE body @@ 'beta';
----
id
2

connection after_restart
query
SHOW search_path;
----
search_path
sfsp_s, public

connection after_restart
statement ok
DROP SERVER sfsp_snap;
