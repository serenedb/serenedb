control substitution on

# A copy of a data directory holds no files of the tablespaces. A database with
# a table or an inverted index placed in a tablespace refuses a read-only
# attach, and a database created in a tablespace attaches once the files of
# its objects are copied beside the others.

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLESPACE sft_space LOCATION '${__TEST_DIR__}/sft_space';

statement ok
CREATE DATABASE sft_tables;

statement ok
CREATE TABLE sft_tables.public.notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (compaction_interval = 0) TABLESPACE sft_space;

statement ok
INSERT INTO sft_tables.public.notes VALUES (1, 'placed');

statement ok
VACUUM (FLUSH_TABLE) sft_tables.public.notes;

statement ok
CREATE DATABASE sft_indexes;

statement count 1
COPY (SELECT 1 AS id, 'placed' AS body) TO '${__TEST_DIR__}/sft_docs.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW sft_indexes.public.docs AS SELECT * FROM read_parquet('${__TEST_DIR__}/sft_docs.parquet');

statement ok
CREATE INDEX docs_idx ON sft_indexes.public.docs USING inverted(id, body) TABLESPACE sft_space;

statement ok
CREATE DATABASE sft_placed TABLESPACE sft_space;

statement ok
CREATE TABLE sft_placed.public.notes(id BIGINT PRIMARY KEY, body TEXT)
  WITH (compaction_interval = 0);

statement ok
INSERT INTO sft_placed.public.notes VALUES (1, 'beside');

statement ok
VACUUM (FLUSH_TABLE) sft_placed.public.notes;

statement ok
CHECKPOINT;

system ok
rm -rf $__TEST_DIR__/sft_snap && mkdir -p $__TEST_DIR__/sft_snap && cp -r ${SDB_DATADIR}/snapshot ${SDB_DATADIR}/logs ${SDB_DATADIR}/segments ${SDB_DATADIR}/PG_VERSION $__TEST_DIR__/sft_snap/

statement error
CREATE SERVER sft_tables_snap FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sft_snap', database 'sft_tables');
----
db error: ERROR: cannot attach "<slt:ignore>" read-only: table "notes" is placed in a tablespace


statement error
CREATE SERVER sft_indexes_snap FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sft_snap', database 'sft_indexes');
----
db error: ERROR: cannot attach "<slt:ignore>" read-only: inverted index "docs_idx" is placed in a tablespace


system ok
cp -r $__TEST_DIR__/sft_space/segments/. $__TEST_DIR__/sft_snap/segments/

statement ok
CREATE SERVER sft_placed_snap FOREIGN DATA WRAPPER serenedb_fdw
  OPTIONS (path '${__TEST_DIR__}/sft_snap', database 'sft_placed');

query
SELECT id, body FROM sft_placed_snap.public.notes;
----
id	body
1	beside

statement ok
DROP SERVER sft_placed_snap;

query
SELECT count(*) AS n FROM sdb_databases() WHERE database_name IN ('sft_tables_snap', 'sft_indexes_snap', 'sft_placed_snap');
----
n
0
