# A throw anywhere in a session on the duck worker reaches the client as a
# FATAL and closes that connection. The session reports the error at its one
# boundary and its scope guard stops the transport on every exit. Before, a
# throw in the startup burst or at ReadyForQuery skipped the stop, nothing
# closed the socket, and the client waited forever.
#
# Failure points are process-global, so this lives in the recovery tree, where
# each test has a server of its own.

statement ok
SET sdb_faults = 'startup_burst_throw';

connection broken_startup
statement error
SELECT 1;
----
db error: FATAL: intentional debug error


connection default
statement ok
SET sdb_faults = '-startup_burst_throw';


connection default
statement error
SET sdb_faults = 'ready_for_query_throw';
----
db error: FATAL: intentional debug error


connection disarm
statement ok
SET sdb_faults = '-ready_for_query_throw';


connection healthy
query
SELECT 1 AS ok;
----
ok
1
