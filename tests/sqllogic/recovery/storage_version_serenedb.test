control substitution on


statement ok
CREATE DATABASE sv_db;


query
SELECT tags::VARCHAR LIKE '%serenedb_v1%' AS tagged
  FROM duckdb_databases(include_hidden := true) WHERE database_name = 'sv_db';
----
tagged
t


statement ok
CREATE TABLE sv_db.t AS SELECT i, 'row_' || i::VARCHAR AS s FROM range(20000) t(i);


statement ok
CHECKPOINT sv_db;


statement error a SereneDB storage version is for SereneDB databases, a DuckDB database takes a DuckDB storage version
ATTACH '${__TEST_DIR__}/sv_v1.db' AS sv_ver1 (TYPE duckdb, STORAGE_VERSION 'serenedb_v1');


statement error a SereneDB storage version is for SereneDB databases, a DuckDB database takes a DuckDB storage version
ATTACH '${__TEST_DIR__}/sv_latest.db' AS sv_verl (TYPE duckdb, STORAGE_VERSION 'serenedb_latest');


statement ok
ATTACH '${__TEST_DIR__}/sv_native.db' AS sv_nat (TYPE duckdb, STORAGE_VERSION 'v2.0.0');


statement ok
CREATE TABLE sv_nat.t AS SELECT 42 AS x;


statement ok
CHECKPOINT sv_nat;


statement ok
DETACH sv_nat;


statement error a SereneDB storage version is for SereneDB databases, a DuckDB database takes a DuckDB storage version
ATTACH '${__TEST_DIR__}/sv_native.db' AS sv_raised (TYPE duckdb, STORAGE_VERSION 'serenedb_v1');


statement error a SereneDB database is created with CREATE DATABASE
ATTACH '${__TEST_DIR__}/sv_native.db' AS sv_owned (TYPE serenedb);


statement ok
ATTACH '${__TEST_DIR__}/sv_native.db' AS sv_nat_again (TYPE duckdb);


query
SELECT tags::VARCHAR LIKE '%v2.0.0%' AS untouched, (SELECT x FROM sv_nat_again.t) AS x
  FROM duckdb_databases(include_hidden := true) WHERE database_name = 'sv_nat_again';
----
untouched	x
t	42


statement ok
DETACH sv_nat_again;


statement ok
SET sdb_faults = 'shutdown_on_packet';


statement error connection closed
SELECT 1;


connection after_restart
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_restart
query
SELECT count(*) AS n, sum(i) AS sum_i, max(length(s)) AS max_len FROM sv_db.t;
----
n	sum_i	max_len
20000	199990000	9


connection after_restart
query
SELECT tags::VARCHAR LIKE '%serenedb_v1%' AS kept_version
  FROM duckdb_databases(include_hidden := true) WHERE database_name = 'sv_db';
----
kept_version
t
