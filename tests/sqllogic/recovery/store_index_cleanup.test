# An index -- secondary or inverted -- is a relation of its own and the rows it
# covers belong to the table it hangs off. Creating one, dropping one, failing
# to create one, and dropping the table must all leave nothing behind: no index
# naming a relation that is gone, and no index the relation namespace does not
# know about.
#
# The probes ask for hidden objects because an index does not enumerate as a
# user relation.

# --- secondary index ---
statement ok
CREATE TABLE sic_sec (a INT, b INT);


statement ok
INSERT INTO sic_sec VALUES (1, 10), (2, 20);


statement ok
CREATE INDEX sic_sec_idx ON sic_sec (a);


query
SELECT schema_name, index_name, is_unique FROM duckdb_indexes(include_hidden := true)
WHERE table_name = 'sic_sec';
----
schema_name	index_name	is_unique
public	sic_sec_idx	f


statement ok
DROP INDEX sic_sec_idx;


query
SELECT count(*) AS n FROM duckdb_indexes(include_hidden := true)
WHERE table_name = 'sic_sec';
----
n
0


# --- inverted index ---
statement ok
CREATE TEXT SEARCH DICTIONARY sic_kw (template = 'keyword');


statement ok
CREATE TABLE sic_inv (pk INT, txt TEXT);


statement ok
INSERT INTO sic_inv VALUES (1, 'hello world'), (2, 'foo bar');


statement ok
CREATE INDEX sic_inv_idx ON sic_inv USING inverted (txt sic_kw);


# An inverted index has no ART of its own -- it is injected into the table's
# live index list -- but it is a relation like any other index.
query
SELECT
  (SELECT count(*) FROM pg_class WHERE relname = 'sic_inv_idx' AND relkind = 'i') AS relation,
  (SELECT count(*) FROM duckdb_indexes(include_hidden := true)
   WHERE table_name = 'sic_inv') AS listed;
----
relation	listed
1	1


statement ok
DROP INDEX sic_inv_idx;


query
SELECT
  (SELECT count(*) FROM pg_class WHERE relname = 'sic_inv_idx' AND relkind = 'i') AS relation,
  (SELECT count(*) FROM duckdb_indexes(include_hidden := true)
   WHERE table_name = 'sic_inv') AS listed;
----
relation	listed
0	0


# --- a failed CREATE UNIQUE INDEX leaves nothing behind ---
statement ok
CREATE TABLE sic_dup (a INT);


statement ok
INSERT INTO sic_dup VALUES (1), (1);


statement error
CREATE UNIQUE INDEX sic_dup_idx ON sic_dup (a);


query
SELECT count(*) AS n FROM duckdb_indexes(include_hidden := true)
WHERE table_name = 'sic_dup';
----
n
0


# --- DROP TABLE removes the table and every index on it ---
statement ok
CREATE INDEX sic_inv_idx2 ON sic_inv USING inverted (txt sic_kw);


statement ok
DROP TABLE sic_inv;


query
SELECT count(*) AS n FROM duckdb_indexes(include_hidden := true)
WHERE table_name NOT IN (SELECT relname FROM pg_class WHERE relkind = 'r');
----
n
0


query
SELECT count(*) AS n FROM duckdb_indexes(include_hidden := true)
WHERE index_name NOT IN (SELECT relname FROM pg_class WHERE relkind = 'i');
----
n
0


statement ok
DROP TABLE sic_sec;


statement ok
DROP TABLE sic_dup;


statement ok
DROP TEXT SEARCH DICTIONARY sic_kw;
