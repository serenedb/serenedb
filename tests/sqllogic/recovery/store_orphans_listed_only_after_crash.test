       (SELECT count(DISTINCT regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1)) FROM glob(getvariable('slc_dir') || '/*') WHERE regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1) NOT IN ('', '00000000ffffffff')) AS segments;
