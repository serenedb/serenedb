query ok retry 40 backoff 250ms
SELECT (SELECT value FROM sdb_metrics WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'slc') AND metric = 'num_segments') AS segments,
       (SELECT count(DISTINCT regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1)) FROM glob(getvariable('slc_dir') || '/*') WHERE regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1) <> '') AS on_disk;
