statement ok
INSERT INTO slc SELECT i, 'fox ' || i FROM range(1000, 2000) t(i);


statement ok
VACUUM (FLUSH_ALL);


statement ok
CHECKPOINT;


statement ok
CREATE MACRO slc_ids() AS (
  SELECT list_sort(list(DISTINCT regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1)))
  FROM glob('${SDB_DATADIR}/engine_v2/store/*')
  WHERE regexp_extract(file, '/([0-9a-f]{16})\.[^/]*$', 1) <> '');


connection pin
statement ok
BEGIN;


connection pin
query
SELECT count(*) AS n FROM slc;
----
n
2000


statement ok
VACUUM (COMPACT_TABLE) slc;


query ok retry 40 backoff 250ms
SELECT (SELECT value FROM sdb_metrics WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'slc') AND metric = 'num_segments') AS segments,
       len(slc_ids()) AS on_disk;
----
segments	on_disk
1	3


statement ok
COPY (SELECT 1 AS x) TO '${SDB_DATADIR}/engine_v2/store/00000000ffffffff.col' (FORMAT csv);


statement ok
COPY (SELECT 1 AS x) TO '${SDB_DATADIR}/engine_v2/store/notes.csv' (FORMAT csv);


statement ok
SET sdb_faults = 'shutdown_on_packet';


statement error connection closed
SELECT 1;


connection after_clean
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT 1;


connection after_clean
query
SELECT list_contains(slc_ids(), '00000000ffffffff') AS planted,
       (SELECT count(*) FROM glob('${SDB_DATADIR}/engine_v2/store/notes.csv')) AS unrelated,
       len(list_filter(slc_ids(), lambda id: id <> '00000000ffffffff')) AS segments;
----
planted	unrelated	segments
t	1	1


connection after_clean
query
SELECT count(*) AS n, count(*) FILTER (WHERE body = 'fox 1500') AS hit FROM slc;
----
n	hit
2000	1


