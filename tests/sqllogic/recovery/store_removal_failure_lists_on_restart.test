statement ok
VACUUM (FLUSH_ALL);


statement ok
CHECKPOINT;


statement ok
CREATE TABLE srf_files AS SELECT file FROM glob('${SDB_DATADIR}/engine_v2/store/*');


statement ok
CREATE TABLE srf_keep (id INT PRIMARY KEY, body TEXT);


statement ok
INSERT INTO srf_keep VALUES (1, 'kept');


statement ok
VACUUM (FLUSH_ALL);


statement ok
CHECKPOINT;


query
SELECT count(*) > 0 AS present FROM glob('${SDB_DATADIR}/engine_v2/store/*')
WHERE file IN (SELECT file FROM srf_files);
