control substitution on

onlyif serenedb
statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS rsf_${__DATABASE__} (TYPE postgres);

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name = ''rsub_sf_missing''');

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'DROP PUBLICATION IF EXISTS rsub_sf_pub');

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'DROP TABLE IF EXISTS rsub_sf_rows');

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'CREATE TABLE rsub_sf_rows (id integer PRIMARY KEY)');

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'CREATE PUBLICATION rsub_sf_pub FOR TABLE rsub_sf_rows');

onlyif serenedb
statement ok
CREATE TABLE rsub_sf_rows (id INTEGER PRIMARY KEY);

onlyif serenedb
statement ok
SET sdb_faults = 'subscription_disable_after_failed_start';

onlyif serenedb
statement ok
CREATE SUBSCRIPTION rsub_sf CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' PUBLICATION rsub_sf_pub WITH (create_slot = false, slot_name = 'rsub_sf_missing', copy_data = false);

onlyif serenedb
query ok retry 120 backoff 250ms
SELECT subenabled FROM pg_subscription WHERE subname = 'rsub_sf';
----
subenabled
f

onlyif serenedb
statement ok
SET sdb_faults = '-subscription_disable_after_failed_start';

onlyif serenedb
query
SELECT apply_error_count, sync_error_count FROM pg_stat_subscription_stats WHERE subname = 'rsub_sf';
----
apply_error_count	sync_error_count
0	0

onlyif serenedb
statement ok
ALTER SUBSCRIPTION rsub_sf SET (slot_name = NONE);

onlyif serenedb
statement ok
DROP SUBSCRIPTION rsub_sf;

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'DROP PUBLICATION rsub_sf_pub');

onlyif serenedb
statement ok
CALL postgres_execute('rsf_${__DATABASE__}', 'DROP TABLE rsub_sf_rows');
