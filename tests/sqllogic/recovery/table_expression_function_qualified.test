CREATE FUNCTION tefq_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


statement ok
CREATE DATABASE tefq_db;


statement ok
CREATE TABLE tefq_db.public.tefq_t (id INT, a INT CHECK (tefq_pos(a)), b INT);


statement ok
INSERT INTO tefq_db.public.tefq_t VALUES (1, 1, 1);


statement ok
ALTER TABLE tefq_db.public.tefq_t DROP COLUMN b;


statement ok
CREATE SCHEMA tefq_fs;


statement ok
CREATE FUNCTION tefq_fs.tefq_seven() RETURNS INT LANGUAGE sql IMMUTABLE AS 'SELECT 7';


statement ok
CREATE TABLE tefq_st (id INT, s STRUCT(a INT));


statement ok
INSERT INTO tefq_st VALUES (1, {'a': 1});


statement ok
SET search_path = tefq_fs, public;


statement ok
ALTER TABLE public.tefq_st ADD COLUMN s.k INT DEFAULT tefq_seven();


statement ok
RESET search_path;


