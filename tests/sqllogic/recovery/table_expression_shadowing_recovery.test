control substitution on

statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TABLE tesr_u (s TEXT);


statement ok
RESET sdb_faults;


statement ok
CREATE UNIQUE INDEX tesr_u_lower ON tesr_u ((lower(s)));


statement ok
INSERT INTO tesr_u VALUES ('ABC');


statement ok
CREATE TABLE tesr_p (s TEXT);


statement ok
CREATE UNIQUE INDEX tesr_p_lower ON tesr_p ((lower(s)));


statement ok
INSERT INTO tesr_p VALUES ('ABC');


statement ok
CREATE SCHEMA tesr_app;


statement ok
CREATE FUNCTION tesr_app.lower(x TEXT) RETURNS TEXT LANGUAGE sql IMMUTABLE AS 'SELECT ''zzz'' || x';


statement ok
CREATE SCHEMA tesr_n1;


statement ok
CREATE SCHEMA tesr_n1.tesr_n2;


statement ok
CREATE TABLE tesr_n1.tesr_n2.tesr_u (s TEXT);


statement ok
CREATE UNIQUE INDEX tesr_nu_lower ON tesr_n1.tesr_n2.tesr_u ((lower(s)));


statement ok
INSERT INTO tesr_n1.tesr_n2.tesr_u VALUES ('ABC');


statement ok
CREATE SCHEMA tesr_n2;


statement ok
CREATE FUNCTION tesr_n2.lower(x TEXT) RETURNS TEXT LANGUAGE sql IMMUTABLE AS 'SELECT x';


statement ok
CREATE SCHEMA tesr_ix;


statement ok
CREATE TABLE tesr_ix.tesr_u (s TEXT);


statement ok
CREATE UNIQUE INDEX tesr_iu_lower ON tesr_ix.tesr_u ((lower(s)));


statement ok
INSERT INTO tesr_ix.tesr_u VALUES ('ABC');


statement ok
CREATE FUNCTION tesr_ix.lower(x TEXT) RETURNS TEXT LANGUAGE sql IMMUTABLE AS 'SELECT x';


statement ok
CREATE DATABASE tesr_xdb;


statement ok
CREATE FUNCTION public.tesr_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


statement ok
CREATE TABLE tesr_xdb.public.tesr_xt (a INT CHECK (public.tesr_pos(a)));


statement ok
ALTER TABLE tesr_xdb.public.tesr_xt ADD COLUMN b INT;


statement ok
CREATE FUNCTION tesr_app.tesr_ispos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


statement ok
SET search_path = tesr_app, public;


statement ok
CREATE TABLE public.tesr_mt (c INT CHECK (c.tesr_ispos()));


statement ok
ALTER TABLE public.tesr_mt ADD COLUMN b INT;


statement ok
RESET search_path;


statement ok
CREATE SCHEMA tesr_own;


statement ok
CREATE FUNCTION tesr_own.lower(x TEXT) RETURNS TEXT LANGUAGE sql IMMUTABLE AS 'SELECT ''own''';


statement ok
SET search_path = tesr_own, public;


statement ok
CREATE TABLE tesr_own.tesr_dc (s TEXT CHECK (lower(s) = 'own'), d TEXT DEFAULT lower('ABC'));


statement ok
RESET search_path;


statement ok
INSERT INTO tesr_own.tesr_dc (s) VALUES ('ABC');


statement ok
CREATE SCHEMA tesr_sq;


statement ok
CREATE SEQUENCE tesr_sq.tesr_seq;


statement ok
SET search_path = tesr_sq, public;


statement ok
CREATE TABLE public.tesr_nv (id INT, n BIGINT DEFAULT nextval('tesr_seq'));


statement ok
RESET search_path;


statement ok
INSERT INTO public.tesr_nv (id) VALUES (1);


statement ok
CREATE SCHEMA tesr_sn1;


statement ok
CREATE SCHEMA tesr_sn1.tesr_sn2;


statement ok
CREATE TABLE tesr_sn1.tesr_sn2.tesr_ser (id SERIAL, a INT);


statement ok
INSERT INTO tesr_sn1.tesr_sn2.tesr_ser (a) VALUES (1);


statement ok
SET sdb_faults = 'crash_on_packet';


statement error connection closed
SELECT 1;


connection with_macro
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
CREATE TEMPORARY MACRO lower(x) AS 'zzz' || x;


