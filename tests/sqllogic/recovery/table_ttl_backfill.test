control substitution on

statement ok
RESET sdb_faults;

statement ok
CREATE TABLE tbf (ts TIMESTAMP NOT NULL, tag TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
        ttl = '1 day', ttl_column = 'ts');

statement ok
INSERT INTO tbf VALUES (TIMESTAMP '2000-01-01 00:00:00', 'expired'), (TIMESTAMP '2200-01-01 00:00:00', 'kept');

statement ok
VACUUM (REFRESH_TABLE) tbf;

statement ok
SET sdb_faults = 'pause_search_backfill_before_swap';

connection builder
statement async ok
CREATE INDEX tbf_idx ON tbf USING inverted (tag);

connection default
query ok retry 40 backoff 250ms
SELECT tuples_done FROM pg_stat_progress_create_index
WHERE relid = 'tbf'::regclass;
----
tuples_done
2

connection default
statement ok
EXECUTE JOB tbf_ttl;

connection default
statement ok
VACUUM (REFRESH_TABLE) tbf;

connection default
statement ok
SET sdb_faults = '-pause_search_backfill_before_swap';

wait

connection default
statement ok
VACUUM (REFRESH_TABLE) tbf;

connection default
query
SELECT tag FROM tbf ORDER BY tag;
----
tag
kept

connection default
query
SELECT count(*) AS hits FROM tbf WHERE tag @@ 'expired';
----
hits
0
