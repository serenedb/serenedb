control substitution on

# A tablespace and the objects placed in it are settled the way any catalog
# object and its dependents are: of a placement and a DROP TABLESPACE, the one
# that commits second fails. A dropped object keeps its files until the
# transactions that began before the drop end, and the location of a dropped
# tablespace can be used again at once.

statement ok
RESET sdb_faults;


statement ok
CREATE TEXT SEARCH DICTIONARY race_english AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false);


statement ok
CREATE TABLESPACE contested LOCATION '${__TEST_DIR__}/contested';


statement ok
CREATE TABLESPACE leaving LOCATION '${__TEST_DIR__}/leaving';


statement ok
SET sdb_faults = 'pause_tablespace_drop';


connection dropper
statement async error
DROP TABLESPACE contested;
----
db error: ERROR: Failed to commit: Could not commit DROP of "contested" because a dependency was created after the transaction started


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_tablespace_drop:parked';


connection default
statement ok
CREATE TABLE placed (id INT, body TEXT) TABLESPACE contested;


connection default
statement ok
SET sdb_faults = 'pause_tablespace_drop:release';


connection dropper
wait


connection default
query
SELECT c.relname, t.spcname FROM pg_class c JOIN pg_tablespace t ON t.oid = c.reltablespace
WHERE c.relname = 'placed';
----
relname	spcname
placed	contested


connection default
statement error
DROP TABLESPACE contested;
----
db error: ERROR: tablespace "contested" is not empty


connection default
statement ok
SET sdb_faults = 'pause_tablespace_drop';


connection dropper
statement async error
DROP TABLESPACE leaving;
----
db error: ERROR: Failed to commit: Could not commit DROP of "leaving" because a dependency was created after the transaction started


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_tablespace_drop:parked';


connection default
statement ok
CREATE DATABASE late_db TABLESPACE leaving;


connection default
statement ok
SET sdb_faults = 'pause_tablespace_drop:release';


connection dropper
wait


connection default
query
SELECT d.datname, t.spcname FROM pg_database d JOIN pg_tablespace t ON t.oid = d.dattablespace
WHERE d.datname = 'late_db';
----
datname	spcname
late_db	leaving


connection default
statement ok
DROP DATABASE late_db;


connection default
statement count 1
COPY (SELECT 1 AS id, 'red fox' AS body) TO '${__TEST_DIR__}/race_notes.parquet' (FORMAT PARQUET);


connection default
statement ok
CREATE VIEW notes AS SELECT * FROM read_parquet('${__TEST_DIR__}/race_notes.parquet');


connection default
statement ok
SET sdb_faults = 'pause_tablespace_drop';


connection dropper
statement async error
DROP TABLESPACE leaving;
----
db error: ERROR: Failed to commit: Could not commit DROP of "leaving" because a dependency was created after the transaction started


connection default
statement ok retry 40 backoff 250ms
SET sdb_faults = '-pause_tablespace_drop:parked';


connection default
statement ok
CREATE INDEX notes_idx ON notes USING inverted(id, body race_english) TABLESPACE leaving;


connection default
statement ok
SET sdb_faults = 'pause_tablespace_drop:release';


connection dropper
wait


connection default
query
SELECT id FROM notes_idx WHERE body @@ ts_phrase('fox') ORDER BY id;
----
id
1


connection default
statement ok
DROP INDEX notes_idx;


connection placer
statement ok
BEGIN;


connection placer
statement ok
CREATE TABLE late (id INT, body TEXT) TABLESPACE leaving;


connection placer
statement ok
INSERT INTO late VALUES (1, 'never committed');


connection default
statement ok
DROP TABLESPACE leaving;


connection placer
statement error
COMMIT;
----
db error: ERROR: Failed to commit: Could not commit creation of dependency, subject "leaving" has been deleted


connection default
query
SELECT count(*) AS left FROM pg_tablespace WHERE spcname = 'leaving';
----
left
0


connection default
query
SELECT count(*) AS tables FROM pg_class WHERE relname = 'late';
----
tables
0


connection default
query ok retry 240 backoff 250ms
SELECT count(*) AS files_left FROM glob('${__TEST_DIR__}/leaving/**');
----
files_left
0


