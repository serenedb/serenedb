connection default
statement ok
CREATE TABLESPACE held_once_more LOCATION '${__TEST_DIR__}/held';


connection default
statement ok
CREATE TABLE held_rows (id INT, body TEXT) TABLESPACE held_once_more;


connection default
statement ok
INSERT INTO held_rows VALUES (1, 'placed after two drops');


connection default
statement ok
VACUUM (FLUSH_TABLE) held_rows;


connection default
query
SELECT count(*) > 0 AND count(*) = (SELECT value FROM sdb_metrics WHERE metric = 'num_files'
                                    AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'held_rows')) AS only_held_rows,
       (SELECT body FROM held_rows) AS body
FROM glob('${__TEST_DIR__}/held/segments/*');
----
only_held_rows	body
t	placed after two drops


connection default
statement ok
DROP TABLE held_rows;


connection default
statement ok
DROP TABLESPACE held_once_more;


connection holder
statement ok
BEGIN;


connection holder
query
SELECT count(*) AS tablespaces FROM pg_tablespace WHERE oid < 16384;
