control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vkhl FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vkhl_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vkhl.${__DATABASE__};

statement ok
CREATE TABLE vkhl.${__DATABASE__}.docs (id INTEGER, body TEXT, emb FLOAT[]);

statement count 4617
INSERT INTO vkhl.${__DATABASE__}.docs
SELECT s,
       'doc ' || s || CASE s % 4 WHEN 0 THEN ' red fox' WHEN 1 THEN ' blue cat' WHEN 2 THEN ' green bird' ELSE ' yellow dog' END,
       [sin(s * 0.1 + i * 0.01)::FLOAT FOR i IN range(3072)]
FROM generate_series(1, 4617) t(s);

statement ok
CREATE VIEW vkhl_v AS SELECT id, body, emb::FLOAT[3072] AS emb FROM vkhl.${__DATABASE__}.docs;

statement ok
CREATE INDEX vkhl_idx ON vkhl_v USING inverted(id, body vkhl_en, emb ivf (metric = 'l2')) WITH (reindex_interval=200, compaction_interval=0);

query
SELECT count(*) FROM vkhl_idx WHERE body @@ ts_phrase('fox');
----
count
1154

query
SELECT id FROM vkhl_idx ORDER BY emb <-> [sin(7 * 0.1 + i * 0.01)::FLOAT FOR i IN range(3072)]::FLOAT[3072] LIMIT 1;
----
id
7

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM vkhl_idx WHERE body @@ ts_phrase('fox');
----
count
1154

connection after_crash
query
SELECT id FROM vkhl_idx WHERE body @@ ts_phrase('fox') ORDER BY bm25(tableoid) DESC, id LIMIT 3;
----
id
4
8
12

connection after_crash
query
SELECT id FROM vkhl_idx ORDER BY emb <-> [sin(7 * 0.1 + i * 0.01)::FLOAT FOR i IN range(3072)]::FLOAT[3072] LIMIT 1;
