control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vkh FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vkh_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vkh.${__DATABASE__};

statement ok
CREATE TABLE vkh.${__DATABASE__}.docs (id INTEGER, body TEXT, emb FLOAT[]);

statement count 4617
INSERT INTO vkh.${__DATABASE__}.docs
SELECT s,
       'doc ' || s || CASE s % 4 WHEN 0 THEN ' red fox' WHEN 1 THEN ' blue cat' WHEN 2 THEN ' green bird' ELSE ' yellow dog' END,
       [sin(s * 0.1 + i * 0.01)::FLOAT FOR i IN range(3072)]
FROM generate_series(1, 4617) t(s);

statement ok
CREATE VIEW vkh_v AS SELECT id, body, emb::FLOAT[3072] AS emb FROM vkh.${__DATABASE__}.docs;

statement ok
CREATE INDEX vkh_idx ON vkh_v USING inverted(id, body vkh_en, emb ivf (metric = 'l2')) WITH (compaction_interval=0);

query
SELECT count(*) FROM vkh_idx WHERE body @@ ts_phrase('fox');
----
count
1154

query
SELECT id FROM vkh_idx WHERE body @@ ts_phrase('fox') ORDER BY id LIMIT 3;
----
id
4
8
12

query
SELECT id FROM vkh_idx WHERE body @@ ts_phrase('fox') ORDER BY bm25(tableoid) DESC, id LIMIT 3;
----
id
4
8
12

query
SELECT id FROM vkh_idx ORDER BY emb <-> [sin(7 * 0.1 + i * 0.01)::FLOAT FOR i IN range(3072)]::FLOAT[3072] LIMIT 1;
----
id
7

query
SELECT body FROM vkh_idx WHERE id = 4617;
----
body
doc 4617 blue cat

statement ok
