id
1498
1499
1500
1501
1502

connection after_crash
query
SELECT body FROM vibk_idx WHERE id = 4500;
----
body
doc 4500 marker

connection after_crash
query
SELECT body FROM vibk_idx WHERE id = 1;
----
body
doc 1 filler

connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, body FROM vibk_idx EXCEPT SELECT id, body FROM vibk.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, body FROM vibk.${__DATABASE__}.t EXCEPT SELECT id, body FROM vibk_idx)
);
----
count
0

