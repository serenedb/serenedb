control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vibk FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vibk_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA vibk.${__DATABASE__};

statement ok
CREATE TABLE vibk.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 1500
INSERT INTO vibk.${__DATABASE__}.t SELECT i::INTEGER, 'doc ' || i || CASE WHEN i % 100 = 0 THEN ' marker' ELSE ' filler' END FROM range(1, 1501) r(i);

statement count 1500
INSERT INTO vibk.${__DATABASE__}.t SELECT i::INTEGER, 'doc ' || i || CASE WHEN i % 100 = 0 THEN ' marker' ELSE ' filler' END FROM range(1501, 3001) r(i);

statement count 1500
INSERT INTO vibk.${__DATABASE__}.t SELECT i::INTEGER, 'doc ' || i || CASE WHEN i % 100 = 0 THEN ' marker' ELSE ' filler' END FROM range(3001, 4501) r(i);

statement ok
CREATE VIEW vibk_v AS SELECT * FROM vibk.${__DATABASE__}.t;

statement ok
CREATE INDEX vibk_idx ON vibk_v USING inverted(id, body vibk_en) WITH (compaction_interval=0);

query
SELECT count(*) FROM vibk_idx WHERE body @@ ts_phrase('marker');
----
count
45

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM vibk_idx;
----
count
4500

connection after_crash
query
SELECT count(*) FROM vibk_idx WHERE body @@ ts_phrase('marker');
----
count
45

connection after_crash
query
SELECT id FROM vibk_idx WHERE body @@ ts_phrase('marker') ORDER BY id LIMIT 3;
----
id
100
200
300

connection after_crash
query
SELECT id FROM vibk_idx WHERE id BETWEEN 1498 AND 1502 ORDER BY id;
