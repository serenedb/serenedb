control substitution on

statement ok
RESET sdb_faults;


statement ok
COPY (SELECT i AS id, 'doc ' || i AS body FROM range(3) t(i)) TO '${__TEST_DIR__}/vicf_1.parquet' (FORMAT parquet);


statement ok
CREATE VIEW vicf_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/vicf_*.parquet');


statement ok
SET sdb_faults = 'Search::FailOnCommit';


statement error
CREATE INDEX vicf_idx ON vicf_v USING inverted(id) INCLUDE(body)
  WITH (reindex_interval = 0, compaction_interval = 0);
