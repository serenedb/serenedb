control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vicc FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vicc_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA vicc.${__DATABASE__};

statement ok
CREATE TABLE vicc.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO vicc.${__DATABASE__}.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW vicc_v AS SELECT * FROM vicc.${__DATABASE__}.t;

statement ok
SET sdb_faults = 'crash_before_finish_creation';

statement error connection closed
CREATE INDEX vicc_idx ON vicc_v USING inverted(id, body vicc_en);

