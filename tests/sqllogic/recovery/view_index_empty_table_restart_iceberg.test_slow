control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vetr FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vetr_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vetr.${__DATABASE__};

statement ok
CREATE TABLE vetr.${__DATABASE__}.t (id INTEGER, body TEXT);

statement ok
CREATE VIEW vetr_v AS SELECT * FROM vetr.${__DATABASE__}.t;

statement ok
CREATE INDEX vetr_idx ON vetr_v USING inverted(id, body vetr_en) WITH (compaction_interval=0);

query
SELECT count(*) FROM vetr_idx;
----
count
0

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM vetr_idx;
----
count
0

connection after_crash
query
SELECT * FROM serenedb_reindex('vetr_idx');
