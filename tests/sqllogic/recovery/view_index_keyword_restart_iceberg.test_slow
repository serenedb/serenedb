up_to_date	0	0	0	0

connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, body FROM vikr_idx EXCEPT SELECT id, body FROM vikr.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, body FROM vikr.${__DATABASE__}.t EXCEPT SELECT id, body FROM vikr_idx)
