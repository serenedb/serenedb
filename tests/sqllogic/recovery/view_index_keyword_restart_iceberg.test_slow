control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vikr FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vikr_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vikr.${__DATABASE__};

statement ok
CREATE TABLE vikr.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO vikr.${__DATABASE__}.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW vikr_v AS SELECT * FROM vikr.${__DATABASE__}.t;

statement ok
CREATE INDEX vikr_idx ON vikr_v USING inverted(id, body vikr_en) WITH (compaction_interval=0);

statement count 1
INSERT INTO vikr.${__DATABASE__}.t VALUES (4, 'after the restart too');

statement ok
REINDEX INDEX vikr_idx;

query
SELECT id FROM vikr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM vikr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

connection after_crash
query
SELECT body FROM vikr_idx WHERE id = 4;
----
body
after the restart too

connection after_crash
statement count 1
INSERT INTO vikr.${__DATABASE__}.t VALUES (5, 'restart number five');

connection after_crash
statement ok
REINDEX INDEX vikr_idx;

connection after_crash
