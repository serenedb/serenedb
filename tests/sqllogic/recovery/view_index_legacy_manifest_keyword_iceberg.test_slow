control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vilk FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vilk_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA vilk.${__DATABASE__};

statement ok
CREATE TABLE vilk.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO vilk.${__DATABASE__}.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW vilk_v AS SELECT * FROM vilk.${__DATABASE__}.t;

statement ok
SET sdb_faults = 'manifest_version_only';

statement ok
CREATE INDEX vilk_idx ON vilk_v USING inverted(id, body vilk_en);

query
SELECT id FROM vilk_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT count(*) FROM vilk_idx;
----
count
3

connection after_crash
statement ok
REINDEX INDEX vilk_idx;

connection after_crash
query
SELECT id FROM vilk_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

connection after_crash
query
SELECT body FROM vilk_idx WHERE id = 1;
----
body
pudge goes mid

connection after_crash
query
SELECT * FROM serenedb_reindex('vilk_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
statement count 1
INSERT INTO vilk.${__DATABASE__}.t VALUES (4, 'after the restart too');

connection after_crash
statement ok
REINDEX INDEX vilk_idx;

connection after_crash
query
SELECT id FROM vilk_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

connection after_crash
statement ok
DROP INDEX vilk_idx;

connection after_crash
statement ok
DROP VIEW vilk_v;

connection after_crash
statement ok
DROP TABLE vilk.${__DATABASE__}.t;

connection after_crash
statement ok
DROP SCHEMA vilk.${__DATABASE__};

connection after_crash
statement ok
DROP SERVER vilk;
