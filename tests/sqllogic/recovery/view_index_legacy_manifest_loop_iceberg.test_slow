control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vilp FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vilp_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA vilp.${__DATABASE__};

statement ok
CREATE TABLE vilp.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO vilp.${__DATABASE__}.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW vilp_v AS SELECT * FROM vilp.${__DATABASE__}.t;

statement ok
SET sdb_faults = 'manifest_version_only';

statement ok
CREATE INDEX vilp_idx ON vilp_v USING inverted(id, body vilp_en) WITH (reindex_interval=200);

query
SELECT id FROM vilp_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM vilp_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

connection after_crash
query
SELECT body FROM vilp_idx WHERE id = 1;
----
body
pudge goes mid

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT * FROM serenedb_reindex('vilp_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
statement count 1
INSERT INTO vilp.${__DATABASE__}.t VALUES (4, 'after the restart too');

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM vilp_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

connection after_crash
statement ok
ALTER INDEX vilp_idx SET (reindex_interval=0);

connection after_crash
statement ok
DROP INDEX vilp_idx;

connection after_crash
statement ok
DROP VIEW vilp_v;

connection after_crash
statement ok
DROP TABLE vilp.${__DATABASE__}.t;

connection after_crash
statement ok
DROP SCHEMA vilp.${__DATABASE__};

connection after_crash
statement ok
DROP SERVER vilp;
