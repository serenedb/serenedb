connection after_crash
statement count 1
UPDATE vimf.${__DATABASE__}.t SET body = 'pudge file three prime' WHERE id = 3;

connection after_crash
query
SELECT action FROM serenedb_reindex('vimf_idx');
----
action
delta

connection after_crash
query
SELECT id, body FROM vimf_idx WHERE body @@ ts_phrase('prime');
----
id	body
3	pudge file three prime

connection after_crash
query
SELECT body FROM vimf_idx WHERE id = 3;
----
body
pudge file three prime

connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, body FROM vimf_idx EXCEPT SELECT id, body FROM vimf.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, body FROM vimf.${__DATABASE__}.t EXCEPT SELECT id, body FROM vimf_idx)
);
----
count
0

connection after_crash
statement ok
DROP INDEX vimf_idx;

connection after_crash
statement ok
DROP VIEW vimf_v;

connection after_crash
statement ok
DROP TABLE vimf.${__DATABASE__}.t;

connection after_crash
statement ok
DROP SCHEMA vimf.${__DATABASE__};

connection after_crash
statement ok
DROP SERVER vimf;
