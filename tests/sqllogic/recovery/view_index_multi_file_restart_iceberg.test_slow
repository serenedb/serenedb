control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vimf FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vimf_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vimf.${__DATABASE__};

statement ok
CREATE TABLE vimf.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 1
INSERT INTO vimf.${__DATABASE__}.t VALUES (1, 'pudge file one');

statement count 1
INSERT INTO vimf.${__DATABASE__}.t VALUES (2, 'pudge file two');

statement count 1
INSERT INTO vimf.${__DATABASE__}.t VALUES (3, 'pudge file three');

statement ok
CREATE VIEW vimf_v AS SELECT * FROM vimf.${__DATABASE__}.t;

statement ok
CREATE INDEX vimf_idx ON vimf_v USING inverted(id, body vimf_en) WITH (compaction_interval=0);

statement count 1
INSERT INTO vimf.${__DATABASE__}.t VALUES (4, 'pudge file four');

query
SELECT * FROM serenedb_reindex('vimf_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

statement count 1
INSERT INTO vimf.${__DATABASE__}.t VALUES (5, 'pudge file five');

query
SELECT * FROM serenedb_reindex('vimf_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

query
SELECT id FROM vimf_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id
1
2
3
4
5

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM vimf_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id
1
2
3
4
5

connection after_crash
query
SELECT body FROM vimf_idx WHERE id = 1;
----
body
pudge file one

connection after_crash
query
SELECT body FROM vimf_idx WHERE id = 5;
----
body
pudge file five

connection after_crash
query
SELECT id, body FROM vimf_idx WHERE body @@ ts_phrase('three');
----
id	body
3	pudge file three

connection after_crash
query
SELECT * FROM serenedb_reindex('vimf_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
statement count 1
INSERT INTO vimf.${__DATABASE__}.t VALUES (6, 'pudge file six');

connection after_crash
query
SELECT * FROM serenedb_reindex('vimf_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

connection after_crash
query
SELECT id FROM vimf_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id
1
2
3
4
5
6

connection after_crash
statement count 1
DELETE FROM vimf.${__DATABASE__}.t WHERE id = 1;

connection after_crash
query
