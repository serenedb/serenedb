SELECT count(*) FROM (
  (SELECT id, body FROM vipr_idx EXCEPT SELECT id, body FROM vipr.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, body FROM vipr.${__DATABASE__}.t EXCEPT SELECT id, body FROM vipr_idx)
