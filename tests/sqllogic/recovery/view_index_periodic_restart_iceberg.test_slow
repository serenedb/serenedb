control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vipr FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS}, max_table_staleness '10 minutes');

statement ok
CREATE TEXT SEARCH DICTIONARY vipr_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vipr.${__DATABASE__};

statement ok
CREATE TABLE vipr.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO vipr.${__DATABASE__}.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW vipr_v AS SELECT * FROM vipr.${__DATABASE__}.t;

statement ok
CREATE INDEX vipr_idx ON vipr_v USING inverted(id, body vipr_en) WITH (reindex_interval=200);

query
SELECT id FROM vipr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM vipr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

connection after_crash
query
SELECT body FROM vipr_idx WHERE id = 1;
----
body
pudge goes mid

