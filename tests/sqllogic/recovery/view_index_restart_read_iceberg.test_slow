control substitution on

statement ok
CREATE OR REPLACE PERSISTENT SECRET virr_s3 (
  TYPE S3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/warehouse/virr/'
);

statement ok
SET s3_use_ssl=false;

statement ok
CREATE SERVER virr FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (
  warehouse '${ICEBERG_WAREHOUSE}',
  endpoint '${ICEBERG_REST_URL}',
  authorization_type 'none'
);

statement ok
CREATE TEXT SEARCH DICTIONARY virr_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA virr.virr;

statement ok
CREATE TABLE virr.virr.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO virr.virr.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW virr_v AS SELECT * FROM virr.virr.t;

statement ok
CREATE INDEX virr_idx ON virr_v USING inverted(id, body virr_en);

query
SELECT id FROM virr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM virr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

connection after_crash
query
SELECT body FROM virr_idx WHERE id = 1;
----
body
pudge goes mid

connection after_crash
query
SELECT * FROM serenedb_reindex('virr_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
statement count 1
INSERT INTO virr.virr.t VALUES (4, 'after the restart too');

connection after_crash
query
SELECT * FROM serenedb_reindex('virr_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

connection after_crash
query
SELECT id FROM virr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

connection after_crash
statement ok
DROP INDEX virr_idx;

connection after_crash
statement ok
DROP VIEW virr_v;

connection after_crash
statement ok
DROP TABLE virr.virr.t;

connection after_crash
statement ok
DROP SCHEMA virr.virr;

connection after_crash
statement ok
DROP SERVER virr;

connection after_crash
statement ok
DROP PERSISTENT SECRET virr_s3;
