control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER visr FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY visr_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA visr.${__DATABASE__};

statement ok
CREATE TABLE visr.${__DATABASE__}.t (id INTEGER, body TEXT);

statement count 3
INSERT INTO visr.${__DATABASE__}.t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW visr_v AS SELECT * FROM visr.${__DATABASE__}.t;

statement ok
CREATE INDEX visr_idx ON visr_v USING inverted(id, body visr_en) WITH (compaction_interval=0);

query
SELECT id FROM visr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

statement ok
SET sdb_faults = 'shutdown_on_packet';

statement error connection closed
SELECT 1;

connection after_shutdown
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM visr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

connection after_shutdown
query
SELECT body FROM visr_idx WHERE id = 1;
----
body
pudge goes mid

connection after_shutdown
query
SELECT * FROM serenedb_reindex('visr_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_shutdown
statement count 1
INSERT INTO visr.${__DATABASE__}.t VALUES (4, 'after the restart too');

connection after_shutdown
query
SELECT * FROM serenedb_reindex('visr_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

connection after_shutdown
query
SELECT id FROM visr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

connection after_shutdown
statement ok
SET sdb_faults = 'crash_on_packet';

connection after_shutdown
statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id FROM visr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3
4

connection after_crash
query
SELECT id, body FROM visr_idx ORDER BY id;
----
id	body
1	pudge goes mid
2	arrives before the restart
3	lands after the restart
4	after the restart too

connection after_crash
query
SELECT body FROM visr_idx WHERE id = 4;
----
body
after the restart too

connection after_crash
query
SELECT * FROM serenedb_reindex('visr_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, body FROM visr_idx EXCEPT SELECT id, body FROM visr.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, body FROM visr.${__DATABASE__}.t EXCEPT SELECT id, body FROM visr_idx)
);
----
count
0

connection after_crash
statement ok
DROP INDEX visr_idx;

connection after_crash
statement ok
DROP VIEW visr_v;

connection after_crash
statement ok
DROP TABLE visr.${__DATABASE__}.t;

connection after_crash
statement ok
DROP SCHEMA visr.${__DATABASE__};

connection after_crash
statement ok
DROP SERVER visr;
