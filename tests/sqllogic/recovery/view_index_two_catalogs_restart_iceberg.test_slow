control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER vtcr_a FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE SERVER vtcr_b FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vtcr_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA vtcr_a.${__DATABASE__}_a;

statement ok
CREATE SCHEMA vtcr_b.${__DATABASE__}_b;

statement ok
CREATE TABLE vtcr_a.${__DATABASE__}_a.docs (id INTEGER, body TEXT);

statement ok
CREATE TABLE vtcr_b.${__DATABASE__}_b.docs (id INTEGER, body TEXT);

statement count 2
INSERT INTO vtcr_a.${__DATABASE__}_a.docs VALUES (1, 'pudge in catalog a'), (2, 'anchin in catalog a');

statement count 2
INSERT INTO vtcr_b.${__DATABASE__}_b.docs VALUES (1, 'pudge in catalog b'), (3, 'techies in catalog b');

statement ok
CREATE VIEW vtcr_a_v AS SELECT * FROM vtcr_a.${__DATABASE__}_a.docs;

statement ok
CREATE VIEW vtcr_b_v AS SELECT * FROM vtcr_b.${__DATABASE__}_b.docs;

statement ok
CREATE INDEX vtcr_a_idx ON vtcr_a_v USING inverted(id, body vtcr_en) WITH (compaction_interval=0);

statement ok
CREATE INDEX vtcr_b_idx ON vtcr_b_v USING inverted(id, body vtcr_en) WITH (compaction_interval=0);

query
SELECT body FROM vtcr_a_idx WHERE id = 1;
----
body
pudge in catalog a

query
SELECT body FROM vtcr_b_idx WHERE id = 1;
----
body
pudge in catalog b

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;

connection after_crash
query ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
SELECT id, body FROM vtcr_a_idx WHERE body @@ ts_phrase('pudge');
----
id	body
1	pudge in catalog a

connection after_crash
query
SELECT id, body FROM vtcr_b_idx WHERE body @@ ts_phrase('pudge');
----
id	body
1	pudge in catalog b

connection after_crash
query
SELECT body FROM vtcr_a_idx WHERE id = 2;
----
body
anchin in catalog a

connection after_crash
query
SELECT body FROM vtcr_b_idx WHERE id = 3;
----
body
techies in catalog b

connection after_crash
query
SELECT count(*) FROM vtcr_a_idx WHERE body @@ ts_phrase('techies');
----
count
0

connection after_crash
query
SELECT * FROM serenedb_reindex('vtcr_a_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
query
SELECT * FROM serenedb_reindex('vtcr_b_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
statement count 1
INSERT INTO vtcr_b.${__DATABASE__}_b.docs VALUES (4, 'mines in catalog b');

connection after_crash
query
SELECT * FROM serenedb_reindex('vtcr_a_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

connection after_crash
query
SELECT * FROM serenedb_reindex('vtcr_b_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

connection after_crash
query
SELECT id FROM vtcr_b_idx WHERE body @@ ts_phrase('catalog') ORDER BY id;
----
id
1
3
4

connection after_crash
query
SELECT id FROM vtcr_a_idx WHERE body @@ ts_phrase('catalog') ORDER BY id;
----
id
1
2

connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, body FROM vtcr_a_idx EXCEPT SELECT id, body FROM vtcr_a.${__DATABASE__}_a.docs)
  UNION ALL
  (SELECT id, body FROM vtcr_a.${__DATABASE__}_a.docs EXCEPT SELECT id, body FROM vtcr_a_idx)
  UNION ALL
  (SELECT id, body FROM vtcr_b_idx EXCEPT SELECT id, body FROM vtcr_b.${__DATABASE__}_b.docs)
  UNION ALL
  (SELECT id, body FROM vtcr_b.${__DATABASE__}_b.docs EXCEPT SELECT id, body FROM vtcr_b_idx)
);
----
count
0

connection after_crash
statement ok
DROP INDEX vtcr_a_idx;

connection after_crash
statement ok
DROP INDEX vtcr_b_idx;

connection after_crash
statement ok
DROP VIEW vtcr_a_v;

connection after_crash
statement ok
DROP VIEW vtcr_b_v;

connection after_crash
statement ok
DROP TABLE vtcr_a.${__DATABASE__}_a.docs;

connection after_crash
statement ok
DROP TABLE vtcr_b.${__DATABASE__}_b.docs;

connection after_crash
statement ok
DROP SCHEMA vtcr_a.${__DATABASE__}_a;

connection after_crash
statement ok
DROP SCHEMA vtcr_b.${__DATABASE__}_b;

connection after_crash
statement ok
DROP SERVER vtcr_a;

connection after_crash
statement ok
DROP SERVER vtcr_b;
