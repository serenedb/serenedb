  (SELECT id, title, body FROM vitv_idx_a EXCEPT SELECT id, title, body FROM vitv.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, title, body FROM vitv.${__DATABASE__}.t EXCEPT SELECT id, title, body FROM vitv_idx_a)
);
