connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, ts, score, flag, tag, body FROM vtyr_idx EXCEPT SELECT id, ts, score, flag, tag, body FROM vtyr.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, ts, score, flag, tag, body FROM vtyr.${__DATABASE__}.t EXCEPT SELECT id, ts, score, flag, tag, body FROM vtyr_idx)
);
