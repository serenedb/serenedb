secrets
0

connection after_crash
query
SELECT count(*) FROM (
  (SELECT id, body FROM vivc_idx EXCEPT SELECT id, body FROM vivc.${__DATABASE__}.t)
  UNION ALL
  (SELECT id, body FROM vivc.${__DATABASE__}.t EXCEPT SELECT id, body FROM vivc_idx)
);
----
count
0

connection after_crash
