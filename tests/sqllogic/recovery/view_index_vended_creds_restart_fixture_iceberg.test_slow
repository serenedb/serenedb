id
2
3
4

connection reader user=postgres
query
SELECT id, body FROM vivc_idx WHERE id = 4;
----
id	body
4	after the restart too

connection reader user=postgres
query
SELECT count(*) AS secrets FROM duckdb_secrets() WHERE contains(name, '__internal_ic_');
