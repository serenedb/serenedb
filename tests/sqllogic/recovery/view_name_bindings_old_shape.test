control substitution on

statement ok
CREATE SCHEMA vnbo_quas;


statement ok
CREATE TABLE public.vnbo_iceberg AS SELECT 1 AS a;


statement ok
CREATE TABLE vnbo_quas.vnbo_elsewhere AS SELECT 2 AS a;


statement ok
SET search_path = vnbo_quas, public;


statement ok
SET sdb_faults = 'view_without_name_bindings';


statement ok
CREATE VIEW public.vnbo_clickclack AS SELECT (SELECT a FROM vnbo_iceberg) AS own_schema, lower('A') AS builtin;


statement ok
CREATE VIEW public.vnbo_mop AS SELECT a FROM vnbo_elsewhere;


statement ok
RESET sdb_faults;


statement ok
SET sdb_faults = 'crash_on_packet';


