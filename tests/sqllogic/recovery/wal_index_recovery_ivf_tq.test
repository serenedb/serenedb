control substitution on

# WAL recovery for TurboQuant-quantized IVF vector columns.
#
# Same flow as wal_index_recovery_ivf, but the index uses quant='tq': the
# vectors live in the cs for exact rerank, with per-cluster rotated,
# centroid-relative codes plus an exact residual norm in the postings .pay.
# TurboQuant needs no training pass, so the whole quantizer is rebuilt from
# {nb_bits, d} alone -- this test pins that a segment produced by recovery
# carries a stats blob the reader accepts, and that the re-encoded codes
# score correctly.
#
# Pre-crash row goes through a normal commit so the on-disk .cs is the
# reference. Post-crash rows land in the storage WAL only -- we freeze
# SearchRefreshTask::commitUnsafe before INSERTing them so the iresearch trx
# never gets to flush.

statement ok
CREATE TABLE wal_tq_t(pk INTEGER PRIMARY KEY, emb FLOAT[3]);

statement ok
INSERT INTO wal_tq_t VALUES (1, [1.0, 0.0, 0.0]::FLOAT[3]);

statement ok
CREATE INDEX wal_tq_idx ON wal_tq_t
  USING inverted(emb ivf (metric = 'l2', quant = 'tq', nb_bits = 5));

statement ok
VACUUM (REFRESH_TABLE) wal_tq_t;

# Pre-crash row reads from the on-disk .cs + TurboQuant codes.
query
SELECT pk FROM wal_tq_idx ORDER BY emb <-> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 1;
----
pk
1

# Freeze iresearch commits BEFORE the second batch lands. The next two
# rows reach storage (and its WAL) but the iresearch trx is never
# committed -- their vectors only exist as WAL bytes when we crash.
statement ok
SET sdb_faults = 'SearchRefreshTask::commitUnsafe';

statement ok
INSERT INTO wal_tq_t VALUES (2, [0.0, 1.0, 0.0]::FLOAT[3]),
                            (3, [0.0, 0.0, 1.0]::FLOAT[3]);

statement ok
SET sdb_faults = 'crash_on_packet';

statement error connection closed
SELECT 1;


# --- server restarts here ---

connection wal_after
statement ok retry $RETRY_ATTEMPTS backoff $BACKOFF_DURATION
VACUUM (REFRESH_TABLE) wal_tq_t;

# Pre-crash row still queryable.
connection wal_after
query
SELECT pk FROM wal_tq_idx ORDER BY emb <-> [1.0, 0.0, 0.0]::FLOAT[3] LIMIT 1;
----
pk
1

# Post-crash vectors must have round-tripped through recovery and been
# re-quantized -- ANN nearest neighbour to the second vector returns pk=2,
# third returns pk=3.
connection wal_after
query
SELECT pk FROM wal_tq_idx ORDER BY emb <-> [0.0, 1.0, 0.0]::FLOAT[3] LIMIT 1;
----
pk
2

connection wal_after
query
SELECT pk FROM wal_tq_idx ORDER BY emb <-> [0.0, 0.0, 1.0]::FLOAT[3] LIMIT 1;
----
pk
3

# All three rows visible.
connection wal_after
query
SELECT COUNT(*) AS n FROM wal_tq_idx;
----
n
3
