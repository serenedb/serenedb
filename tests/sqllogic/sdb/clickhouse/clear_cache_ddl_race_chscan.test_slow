control substitution on


statement ok
ATTACH 'host=${CHHOST} port=${CHPORT} database=default' AS chcr (TYPE clickhouse);


statement ok
CREATE TABLE chcr.default.ccr_t (id BIGINT, a0 VARCHAR);


connection ddl
statement async ok
CREATE OR REPLACE TABLE chcr.default.ccr_t (id BIGINT, a1 VARCHAR);


connection clear
statement async ok
SELECT count(*) FROM clickhouse_clear_cache();


connection clear
statement async ok
EXPLAIN SELECT * FROM chcr.default.ccr_t;


wait


