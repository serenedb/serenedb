control substitution on

hash-threshold 100

statement ok
SET late_materialization_lookup_max_rows = 10000;

query
SELECT count(*) AS n FROM clickhouse_execute('host=${CHHOST} port=${CHPORT}', 'DROP TABLE IF EXISTS default.lj_${__DATABASE__}');
----
n
1

query
SELECT count(*) AS n FROM clickhouse_execute('host=${CHHOST} port=${CHPORT} database=default',
  'CREATE TABLE default.lj_${__DATABASE__} (id Int64, title String, body String, n Int32) ENGINE = MergeTree ORDER BY id');
----
n
1

query
SELECT count(*) AS n FROM clickhouse_execute('host=${CHHOST} port=${CHPORT}',
  'INSERT INTO default.lj_${__DATABASE__} SELECT number + 1, ''title-'' || toString(number + 1) || ''-long-enough-to-not-inline'', if((number + 1) % 3 = 0, ''red fox pad'', ''blue cat pad'') || toString(number + 1), toInt32((number + 1) * 10) FROM numbers(3000)');
----
n
1

statement ok
ATTACH 'host=${CHHOST} port=${CHPORT} database=default' AS ljch_${__DATABASE__} (TYPE clickhouse);

statement ok
CREATE TEXT SEARCH DICTIONARY ljch_words AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);

statement ok
CREATE VIEW ljch_v AS SELECT * FROM ljch_${__DATABASE__}.default.lj_${__DATABASE__};

statement ok
CREATE INDEX ljch_idx ON ljch_v USING inverted (body ljch_words, n) INCLUDE (n);

query
EXPLAIN SELECT title, n FROM ljch_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(ljch_idx.tableoid) ASC LIMIT 5;
----
QUERY PLAN
╭─ LOOKUP_JOIN ───────────────────────────────────────────╮
│ Key: id                                                 │
│ ~5 rows                                                 │
╰────────────────────────────┬────────────────────────────╯
                             ├──────────────────────────────────────────╮
╭─ LOOKUP_JOIN ──────────────┴────────────────────────────╮  ╭─ INDEX_SOURCE ─────╮
│ Key: iresearch_pk                                       │  │ Projections: title │
│ ~5 rows                                                 │  │ ~5 rows            │
╰────────────────────────────┬────────────────────────────╯  ╰────────────────────╯
                             ├─────────────────────────────────────────╮
╭─ TOP_N ────────────────────┴────────────────────────────╮  ╭─ IRESEARCH_SCAN ─╮
│ Top: 5                                                  │  │ Index: ljch_idx  │
│ Order By: #0 ASC                                        │  │ Projections: n,  │
│ ~5 rows                                                 │  │              pk  │
╰────────────────────────────┬────────────────────────────╯  │ ~5 rows          │
╭─ IRESEARCH_SCAN ───────────┴────────────────────────────╮  ╰──────────────────╯
│ Index: ljch_idx                                         │
│ Index Filter:                                           │
│ ╭─ Term ──────────────╮                                 │
│ │ Field: body(string) │                                 │
│ │ Value: fox          │                                 │
│ ╰─────────────────────╯                                 │
│ Column Filter:                                          │
│ optional: Dynamic Filter (sdb_inverted_index_score < ?) │
│ Score: bm25(k1=1.2, b=0.75)                             │
│ Projections: sdb_inverted_index_score, iresearch_pk     │
│ ~600 rows                                               │
╰─────────────────────────────────────────────────────────╯

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || n // 10 || '-long-enough-to-not-inline' AND body = 'red fox pad' || n // 10)
FROM (SELECT title, body, n FROM ljch_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(ljch_idx.tableoid) ASC LIMIT 5);
----
count	count
5	5

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || n // 10 || '-long-enough-to-not-inline')
FROM (SELECT title, n FROM ljch_idx LIMIT 2500 OFFSET 7);
----
count	count
2500	2500

query
SELECT title, n FROM ljch_idx WHERE body @@ ts_phrase('fox') ORDER BY n DESC LIMIT 3;
----
title	n
title-3000-long-enough-to-not-inline	30000
title-2997-long-enough-to-not-inline	29970
title-2994-long-enough-to-not-inline	29940

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || n // 10 || '-long-enough-to-not-inline' AND body = 'red fox pad' || n // 10)
FROM (SELECT title, body, n FROM ljch_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(ljch_idx.tableoid) DESC LIMIT 10);
----
count	count
10	10

statement ok
DETACH ljch_${__DATABASE__};

query
SELECT count(*) AS n FROM clickhouse_execute('host=${CHHOST} port=${CHPORT}', 'DROP TABLE default.lj_${__DATABASE__}');
----
n
1
