query
SELECT
  typeof(ai_classify_labels(NULL, ['a', 'b'])) AS l,
  typeof(ai_classify(NULL, [{label: 'a', description: 'first'}, {label: 'b', description: NULL}])) AS d,
  typeof(ai_score(NULL, 'helpful')) AS s,
  typeof(ai_rerank('query', NULL)) AS r,
  ai_classify_labels(NULL, ['a', 'b']) IS NULL AS ln,
