statement ok
CREATE TABLE ai_rows (id INTEGER, body VARCHAR);

statement ok
INSERT INTO ai_rows VALUES (1, 'a'), (2, NULL), (3, 'c');

query
SELECT
  count(*) FILTER (WHERE g IS NULL) AS g_null,
  count(*) FILTER (WHERE e IS NULL) AS e_null,
  count(*) FILTER (WHERE j IS NULL) AS j_null
FROM (
  SELECT ai_generate(body) AS g, ai_embed(body, 'm') AS e, prompt_jev(body, 'q') AS j
  FROM ai_rows
) t;
----
g_null	e_null	j_null
3	3	3

