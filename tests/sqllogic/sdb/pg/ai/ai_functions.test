query
SELECT
  typeof(ai_agg(body, 'q')) AS a,
  ai_agg(body, 'q') IS NULL AS an,
  ai_summarize_agg(body) IS NULL AS sn
FROM ai_rows
WHERE id > 10;
----
a	an	sn
VARCHAR	t	t

statement error ai_agg: "instruction" must not be NULL or empty
SELECT ai_agg(body, NULL) FROM ai_rows;

statement error ai_summarize_agg: "max_context_chars" must be a positive integer
SELECT ai_summarize_agg(body, max_context_chars := 0) FROM ai_rows;

statement error ai_classify_labels: "categories" must not be empty
SELECT ai_classify_labels('x', []);

