control substitution on

hash-threshold 100

# read_json over every transform target type, plain and complex, with an
# all-NULL row and boundary values. Each type id in JSONTransform::Transform
# reaches a different helper (numerical / decimal / from-string / to-string /
# to-json / struct / list / map / array / union), so the coverage is per-type
# rather than per-value.

statement ok
CREATE TABLE jsont_src (
    id INTEGER,
    body VARCHAR,
    c_bool BOOLEAN,
    c_i8 TINYINT,
    c_i16 SMALLINT,
    c_i32 INTEGER,
    c_i64 BIGINT,
    c_i128 HUGEINT,
    c_u8 UTINYINT,
    c_u16 USMALLINT,
    c_u32 UINTEGER,
    c_u64 UBIGINT,
    c_f32 FLOAT,
    c_f64 DOUBLE,
    c_dec16 DECIMAL(4,2),
    c_dec32 DECIMAL(9,3),
    c_dec64 DECIMAL(18,4),
    c_dec128 DECIMAL(38,5),
    c_varchar VARCHAR,
    c_blob BLOB,
    c_date DATE,
    c_time TIME,
    c_ts TIMESTAMP,
    c_ival INTERVAL,
    c_uuid UUID,
    c_list INTEGER[],
    c_list_list INTEGER[][],
    c_struct STRUCT(a INTEGER, b VARCHAR),
    c_nested STRUCT(p STRUCT(q INTEGER, r INTEGER[])),
    c_map MAP(VARCHAR, INTEGER),
    c_array DOUBLE[3],
    c_los STRUCT(x INTEGER, y VARCHAR)[],
    c_json JSON,
    c_union UNION(num INTEGER, str VARCHAR),
    c_u128 UHUGEINT
);

# Row 1 typical, row 2 boundary/empty, row 3 all-NULL, row 4 NULLs nested
# inside the complex values. The decimal values are exactly representable in
# binary so they survive the JSON-number (double) round trip.
statement ok
INSERT INTO jsont_src VALUES
(1, 'pudge alpha', true, -8, 300, 70000, 5000000000,
 170141183460469231731687303715884105727, 250, 65000, 4000000000, 18446744073709551615,
 1.5, -2.25, 12.25, 12345.625, 1234567890.0625, 1024.03125,
 'héllo "x"', '\x0001ff'::BLOB, DATE '2024-02-29', TIME '13:45:06.123456',
 TIMESTAMP '2024-02-29 13:45:06.123456', INTERVAL '1 year 2 months 3 days 04:05:06',
 '123e4567-e89b-12d3-a456-426614174000'::UUID,
 [1,2,3], [[1,2],[3]], {'a': 1, 'b': 'x'}, {'p': {'q': 7, 'r': [1,2]}},
 MAP {'k1': 10, 'k2': 20}, [1.5,2.5,3.5], [{'x':1,'y':'a'},{'x':2,'y':'b'}],
 '{"nested":{"deep":[1,2]}}', union_value(num := 42), 340282366920938463463374607431768211455),
(2, 'manga beta', false, 127, -32768, -2147483648, -9223372036854775808,
 -170141183460469231731687303715884105728, 0, 0, 0, 0,
 -0.5, 1e100, -12.25, -0.001, -0.0001, -0.00001,
 '', '\x'::BLOB, DATE '1970-01-01', TIME '00:00:00',
 TIMESTAMP '1970-01-01 00:00:00', INTERVAL '-5 days',
 '00000000-0000-0000-0000-000000000000'::UUID,
 [], [[]], {'a': -1, 'b': ''}, {'p': {'q': -7, 'r': []}},
 MAP {}, [0.0,-0.0,0.5], [], '[]', union_value(str := 'tag'), 0),
(3, 'pudge gamma', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
 NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
 NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
(4, 'pudge delta', true, 1, 1, 1, 1, 1, 1, 1, 1, 1,
 0.25, 3.5, 0.01, 0.001, 0.0001, 0.00001,
 'quo"te and\backslash', '\x41'::BLOB, DATE '9999-12-31', TIME '23:59:59.999999',
 TIMESTAMP '9999-12-31 23:59:59.999999', INTERVAL '00:00:00.000001',
 'ffffffff-ffff-ffff-ffff-ffffffffffff'::UUID,
 [NULL, 4], [[NULL],[5,6]], {'a': NULL, 'b': 'z'}, {'p': {'q': NULL, 'r': [NULL]}},
 MAP {'only': NULL}, [NULL, 1.0, NULL], [{'x':NULL,'y':NULL}], '{"k":null}',
 union_value(num := NULL), 1);

statement ok
COPY jsont_src TO '${__TEST_DIR__}/jsont.jsonl' (FORMAT json);

# Explicit `columns` pins the transform target type per column, so DATE /
# TIME / TIMESTAMP / INTERVAL / UUID take the plain from-string path rather
# than the auto-detected date-format path exercised at the end of this file.
statement ok
CREATE VIEW jsont_v AS SELECT * FROM read_json('${__TEST_DIR__}/jsont.jsonl', columns={
    id: 'INTEGER', body: 'VARCHAR', c_bool: 'BOOLEAN', c_i8: 'TINYINT', c_i16: 'SMALLINT',
    c_i32: 'INTEGER', c_i64: 'BIGINT', c_i128: 'HUGEINT', c_u8: 'UTINYINT', c_u16: 'USMALLINT',
    c_u32: 'UINTEGER', c_u64: 'UBIGINT', c_f32: 'FLOAT', c_f64: 'DOUBLE',
    c_dec16: 'DECIMAL(4,2)', c_dec32: 'DECIMAL(9,3)', c_dec64: 'DECIMAL(18,4)',
    c_dec128: 'DECIMAL(38,5)', c_varchar: 'VARCHAR', c_blob: 'BLOB', c_date: 'DATE',
    c_time: 'TIME', c_ts: 'TIMESTAMP', c_ival: 'INTERVAL', c_uuid: 'UUID',
    c_list: 'INTEGER[]', c_list_list: 'INTEGER[][]', c_struct: 'STRUCT(a INTEGER, b VARCHAR)',
    c_nested: 'STRUCT(p STRUCT(q INTEGER, r INTEGER[]))', c_map: 'MAP(VARCHAR, INTEGER)',
    c_array: 'DOUBLE[3]', c_los: 'STRUCT(x INTEGER, y VARCHAR)[]', c_json: 'JSON',
    c_union: 'UNION(num INTEGER, str VARCHAR)', c_u128: 'UHUGEINT'});


# ============================================================================
# Signed integers and BOOLEAN -- TransformNumerical.
# ============================================================================

query
SELECT id, c_bool, c_i8, c_i16, c_i32, c_i64, c_i128::VARCHAR AS c_i128 FROM jsont_v ORDER BY id;
----
id	c_bool	c_i8	c_i16	c_i32	c_i64	c_i128
1	t	-8	300	70000	5000000000	170141183460469231731687303715884105727
2	f	127	-32768	-2147483648	-9223372036854775808	-170141183460469231731687303715884105728
3	NULL	NULL	NULL	NULL	NULL	NULL
4	t	1	1	1	1	1


# ============================================================================
# Unsigned integers -- yyjson keeps UINT and SINT distinct, so the full
# UBIGINT range must survive.
# ============================================================================

query
SELECT id, c_u8, c_u16, c_u32, c_u64, c_u128::VARCHAR AS c_u128 FROM jsont_v ORDER BY id;
----
id	c_u8	c_u16	c_u32	c_u64	c_u128
1	250	65000	4000000000	18446744073709551615	340282366920938463463374607431768211455
2	0	0	0	0	0
3	NULL	NULL	NULL	NULL	NULL
4	1	1	1	1	1


# ============================================================================
# Floats and the four DECIMAL physical widths (int16/int32/int64/int128).
# ============================================================================

query
SELECT id, c_f32, c_f64::VARCHAR AS c_f64, c_dec16, c_dec32, c_dec64, c_dec128 FROM jsont_v ORDER BY id;
----
id	c_f32	c_f64	c_dec16	c_dec32	c_dec64	c_dec128
1	1.5	-2.25	12.25	12345.625	1234567890.0625	1024.03125
2	-0.5	1e+100	-12.25	-0.001	-0.0001	-0.00001
3	NULL	NULL	NULL	NULL	NULL	NULL
4	0.25	3.5	0.01	0.001	0.0001	0.00001


# ============================================================================
# Strings, temporal types and UUID. BLOB has no JSON representation: COPY
# writes the escaped text and reading it back yields those bytes, not the
# original three.
# ============================================================================

query
SELECT id, c_varchar, c_blob, c_date, c_time, c_ts, c_ival, c_uuid FROM jsont_v ORDER BY id;
----
id	c_varchar	c_blob	c_date	c_time	c_ts	c_ival	c_uuid
1	héllo "x"	\\x5c7830305c7830315c784646	2024-02-29	13:45:06.123456	2024-02-29 13:45:06.123456	1 year 2 mons 3 days 04:05:06	123e4567-e89b-12d3-a456-426614174000
2	(empty)	\\x	1970-01-01	00:00:00	1970-01-01 00:00:00	-5 days	00000000-0000-0000-0000-000000000000
3	NULL	NULL	NULL	NULL	NULL	NULL	NULL
4	quo"te and\\backslash	\\x41	9999-12-31	23:59:59.999999	9999-12-31 23:59:59.999999	00:00:00.000001	ffffffff-ffff-ffff-ffff-ffffffffffff


# ============================================================================
# LIST, nested LIST and STRUCT -- including empty children and NULLs nested
# one and two levels down.
# ============================================================================

query
SELECT id, c_list, c_list_list::VARCHAR AS c_list_list, c_struct, c_nested FROM jsont_v ORDER BY id;
----
id	c_list	c_list_list	c_struct	c_nested
1	{1,2,3}	[[1, 2], [3]]	(1,x)	("(7,""{1,2}"")")
2	{}	[[]]	(-1,"")	("(-7,{})")
3	NULL	NULL	NULL	NULL
4	{NULL,4}	[[NULL], [5, 6]]	(,z)	("(,{NULL})")


# ============================================================================
# MAP, fixed-size ARRAY, LIST of STRUCT, JSON and UNION.
# ============================================================================

query
SELECT id, c_map, c_array, c_los, c_json, c_union FROM jsont_v ORDER BY id;
----
id	c_map	c_array	c_los	c_json	c_union
1	{"(k1,10)","(k2,20)"}	{1.5,2.5,3.5}	{"(1,a)","(2,b)"}	{"nested":{"deep":[1,2]}}	42
2	{}	{0,0,0.5}	{}	[]	tag
3	NULL	NULL	NULL	NULL	NULL
4	{"(only,)"}	{NULL,1,NULL}	{"(,)"}	{"k":null}	NULL


# ============================================================================
# Projecting a subset of a STRUCT's children prunes the rest.
# ============================================================================

query
SELECT id, (c_struct).b, (c_nested).p.r FROM jsont_v ORDER BY id;
----
id	b	r
1	x	{1,2}
2	(empty)	{}
3	NULL	NULL
4	z	{NULL}


# ============================================================================
# Numbers carried as JSON strings: TransformNumerical and TransformDecimal
# both accept YYJSON_TYPE_STR. The DECIMAL(18,4) value below keeps full
# precision this way, which the JSON-number (double) path cannot.
# ============================================================================

statement ok
COPY (SELECT '42'::VARCHAR AS s_i32, '9223372036854775807'::VARCHAR AS s_i64,
             '1234567890123.4567'::VARCHAR AS s_dec, 'true'::VARCHAR AS s_bool)
TO '${__TEST_DIR__}/jsont_str.jsonl' (FORMAT json);

query
SELECT * FROM read_json('${__TEST_DIR__}/jsont_str.jsonl', columns={
    s_i32: 'INTEGER', s_i64: 'BIGINT', s_dec: 'DECIMAL(18,4)', s_bool: 'BOOLEAN'});
----
s_i32	s_i64	s_dec	s_bool
42	9223372036854775807	1234567890123.4567	t


# ============================================================================
# Auto-detection instead of explicit columns: DATE/TIMESTAMP go through the
# sampled date-format path, and an object with consistent keys is inferred as
# a STRUCT rather than a MAP.
# ============================================================================

query
SELECT id, c_date, c_ts, c_list, c_struct, c_map FROM read_json('${__TEST_DIR__}/jsont.jsonl') ORDER BY id;
----
id	c_date	c_ts	c_list	c_struct	c_map
1	2024-02-29	2024-02-29 13:45:06.123456	{1,2,3}	(1,x)	(10,20,)
2	1970-01-01	1970-01-01 00:00:00	{}	(-1,"")	(,,)
3	NULL	NULL	NULL	NULL	NULL
4	9999-12-31	9999-12-31 23:59:59.999999	{NULL,4}	(,z)	(,,)
