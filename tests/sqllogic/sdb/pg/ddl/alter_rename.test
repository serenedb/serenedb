# A column a dependent view reads can be renamed; the view follows. A function
# an index expression calls can't be renamed: the expression names it.
statement ok
CREATE TABLE arc(a INT, b INT, c INT);


statement ok
CREATE VIEW arc_v AS SELECT a FROM arc;


statement ok
ALTER TABLE arc RENAME COLUMN b TO b2;


statement ok
ALTER TABLE arc ALTER COLUMN c TYPE BIGINT;


statement ok
ALTER TABLE arc RENAME COLUMN a TO a2;


statement ok
INSERT INTO arc VALUES (1, 2, 3);


query
SELECT * FROM arc_v;
----
a
1


statement ok
