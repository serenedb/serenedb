# A column no dependent view or table function reads can be renamed or
# retyped; one they read is refused with the dependents listed. A function an
# index expression calls can't be renamed: the expression names it.
statement ok
CREATE TABLE arc(a INT, b INT, c INT);


statement ok
CREATE VIEW arc_v AS SELECT a FROM arc;


statement ok
ALTER TABLE arc RENAME COLUMN b TO b2;


statement ok
ALTER TABLE arc ALTER COLUMN c TYPE BIGINT;


statement error
ALTER TABLE arc RENAME COLUMN a TO a2;
----
db error: ERROR: Cannot alter entry "arc" because there are entries that depend on it.
view "arc_v" depends on table "arc".
Drop the dependent entries first and recreate them after the change.


statement ok
CREATE MACRO arc_f(x) AS x + 1;


statement ok
CREATE TABLE arc_ft(a INT);


statement ok
CREATE INDEX arc_ft_idx ON arc_ft ((arc_f(a)));


statement error
ALTER FUNCTION arc_f RENAME TO arc_f2;
----
db error: ERROR: Cannot alter entry "arc_f" because there are entries that depend on it.
index "arc_ft_idx" depends on macro function "arc_f".
Drop the dependent entries first and recreate them after the change.


statement ok
DROP TABLE arc_ft;


statement ok
DROP MACRO arc_f;


statement ok
DROP VIEW arc_v;


