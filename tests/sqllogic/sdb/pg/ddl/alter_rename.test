# pudge is a table that pudge_view depends on. PostgreSQL refuses ALTER INDEX
# on a table (relation "pudge" does not exist); here the rename is refused
# because a view depends on the table. Either way it does not happen.
statement error
ALTER INDEX pudge RENAME TO pudge_tmp;
----
db error: ERROR: Cannot alter entry "pudge" because there are entries that depend on it.
table macro function "clickclack" depends on table "pudge".
view "pudge_view" depends on table "pudge".
Drop the dependent entries first and recreate them after the change.




statement ok
ALTER FUNCTION clickclack RENAME TO clickclack_renamed;


statement error
SELECT * FROM clickclack();
----
db error: ERROR: Table Function with name clickclack does not exist!
Did you mean "<slt:ignore>"?


query
SELECT * FROM clickclack_renamed();
----
a	b

statement ok
ALTER FUNCTION clickclack_renamed RENAME TO clickclack;

query
SELECT * FROM clickclack();
----
a	b


