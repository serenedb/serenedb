# ALTER TABLE on a view reaches CatalogEntry::AlterEntry's default, which has no
# column or constraint alters; PG 18 renames a view's column here.
statement error
ALTER TABLE pudge_view RENAME COLUMN a TO a_renamed;
----
db error: ERROR: Unsupported alter type for catalog entry!


statement error
ALTER TABLE pudge_view RENAME CONSTRAINT foo TO bar;
----
db error: ERROR: Unsupported alter type for catalog entry!


