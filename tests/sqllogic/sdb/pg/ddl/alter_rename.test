statement ok
ALTER INDEX deadinside_renamed RENAME TO deadinside;


# pudge is a table that pudge_view depends on. PostgreSQL refuses ALTER INDEX
# on a table (relation "pudge" does not exist); here the rename is refused
# because a view depends on the table. Either way it does not happen.
statement error
ALTER INDEX pudge RENAME TO pudge_tmp;
----
db error: ERROR: Cannot alter entry "pudge" because there are entries that depend on it.




