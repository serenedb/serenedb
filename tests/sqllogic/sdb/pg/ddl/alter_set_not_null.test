statement ok
CREATE TABLE pudge(a integer, b integer);

statement ok
INSERT INTO pudge VALUES (1, 1);

# SET NOT NULL is mirrored to the store column, which then rejects nulls.
statement ok
ALTER TABLE pudge ALTER COLUMN b SET NOT NULL;

statement error
INSERT INTO pudge VALUES (2, NULL);

query
SELECT * FROM pudge ORDER BY a;
----
a	b
1	1

# SET NOT NULL on an already-not-null column is a no-op.
statement ok
ALTER TABLE pudge ALTER COLUMN b SET NOT NULL;

# DROP NOT NULL lifts the constraint and nulls are allowed again.
statement ok
ALTER TABLE pudge ALTER COLUMN b DROP NOT NULL;

statement ok
INSERT INTO pudge VALUES (3, NULL);

query
SELECT * FROM pudge ORDER BY a;
----
a	b
1	1
3	NULL

statement ok
DROP TABLE pudge;


# SET NOT NULL fails if the column already contains nulls, and says so the way
# the same violation is reported for an INSERT -- the rows are checked by the
# store, but the error is the statement's own.
statement ok
CREATE TABLE invoker(a integer, b integer);

statement ok
INSERT INTO invoker VALUES (1, NULL);

statement error
ALTER TABLE invoker ALTER COLUMN b SET NOT NULL;
----
db error: ERROR: NOT NULL constraint failed: "invoker".b


statement ok
ALTER TABLE invoker RENAME COLUMN b TO renamed;

statement error
ALTER TABLE invoker ALTER COLUMN renamed SET NOT NULL;
----
db error: ERROR: NOT NULL constraint failed: "invoker".renamed


# ADD CONSTRAINT over rows that violate it reports the constraint as written,
# not the bound expression it is checked with.
statement error
ALTER TABLE invoker ADD CONSTRAINT ck CHECK (a > 99);
----
db error: ERROR: CHECK constraint failed on table "invoker" with expression CHECK(CAST((#0 > CAST(99 AS INTEGER)) AS INTEGER))


statement ok
DROP TABLE invoker;


# SET / DROP NOT NULL on a missing column reports the column, not a crash.
statement ok
CREATE TABLE tinker(a integer);

statement error
ALTER TABLE tinker ALTER COLUMN nope SET NOT NULL;
----
db error: ERROR: Table "tinker" does not have a column with name "nope"

Did you mean: "a"


statement error
ALTER TABLE tinker ALTER COLUMN nope DROP NOT NULL;
----
db error: ERROR: Table "tinker" does not have a column with name "nope"

Did you mean: "a"


statement ok
DROP TABLE tinker;


# An index or a view over the table does not block NOT NULL or constraint
# changes; only ADD PRIMARY KEY still needs the indexes dropped first.
statement ok
CREATE TABLE lina(a integer, b integer, c text);


statement ok
CREATE INDEX lina_a ON lina(a);


statement ok
CREATE INDEX lina_c ON lina USING inverted(c);


statement ok
CREATE VIEW lina_v AS SELECT a, b FROM lina;


statement ok
INSERT INTO lina VALUES (1, 1, 'x');


statement ok
ALTER TABLE lina ALTER COLUMN b SET NOT NULL;


statement error
INSERT INTO lina VALUES (2, NULL, 'y');


statement ok
ALTER TABLE lina ALTER COLUMN b DROP NOT NULL;


statement ok
ALTER TABLE lina ADD CONSTRAINT lina_ck CHECK (a > 0);


statement error
INSERT INTO lina VALUES (0, 2, 'y');


statement ok
ALTER TABLE lina ADD CONSTRAINT lina_b_key UNIQUE (b);


statement error
INSERT INTO lina VALUES (3, 1, 'y');


statement error
ALTER TABLE lina ADD PRIMARY KEY (a);
----
db error: ERROR: Cannot alter entry "lina" because there are entries that depend on it.
index "lina_a" depends on table "lina".
index "lina_c" depends on table "lina".
Drop the dependent entries first and recreate them after the change.


statement ok
INSERT INTO lina VALUES (4, NULL, 'z');


query
SELECT * FROM lina_v ORDER BY a;
----
a	b
1	1
4	NULL


statement ok
DROP TABLE lina CASCADE;
