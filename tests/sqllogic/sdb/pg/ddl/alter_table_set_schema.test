statement ok
CREATE SCHEMA atsd_a;


statement ok
CREATE SCHEMA atsd_b;


statement ok
CREATE TEXT SEARCH DICTIONARY atsd_dict AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE TABLE atsd_a.docs (id INTEGER PRIMARY KEY, body TEXT);


statement ok
CREATE INDEX atsd_docs_idx ON atsd_a.docs USING inverted (body atsd_dict);


statement ok
INSERT INTO atsd_a.docs VALUES (1, 'alpha bravo'), (2, 'charlie delta');


statement ok
VACUUM (REFRESH_TABLE) atsd_a.docs;


statement ok
ALTER TABLE atsd_a.docs SET SCHEMA atsd_b;


query
SELECT schemaname, tablename, indexname FROM pg_indexes WHERE indexname = 'atsd_docs_idx';
----
schemaname	tablename	indexname
atsd_b	docs	atsd_docs_idx


query
SELECT id FROM atsd_b.atsd_docs_idx WHERE body @@ ts_phrase('charlie');
----
id
2


statement ok
INSERT INTO atsd_b.docs VALUES (3, 'charlie echo');


statement ok
VACUUM (REFRESH_TABLE) atsd_b.docs;


query
SELECT id FROM atsd_b.atsd_docs_idx WHERE body @@ ts_phrase('charlie') ORDER BY id;
----
id
2
3


