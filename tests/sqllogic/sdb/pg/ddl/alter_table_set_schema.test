CREATE SCHEMA feastables;


statement ok
CREATE TEXT SEARCH DICTIONARY beast_dict AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE TABLE mrbeast.videos (id INTEGER PRIMARY KEY, title TEXT);


statement ok
CREATE INDEX videos_idx ON mrbeast.videos USING inverted (title beast_dict);


statement ok
