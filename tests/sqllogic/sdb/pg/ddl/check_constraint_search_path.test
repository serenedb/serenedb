# The constraint scan re-binds every CHECK from whatever path the reader has;
# it has to resolve age_ok through the table's own schema. Scoped to this
# database: the scan walks every attachment on the shared server.
query
SELECT count(*) FROM duckdb_constraints()
WHERE constraint_type = 'CHECK' AND database_name = current_database();
