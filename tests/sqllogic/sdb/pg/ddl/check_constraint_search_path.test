CREATE TABLE guard.people (age INT CHECK (age_ok(age)));


statement ok
RESET search_path;


# A same-named function in the session's path must not capture the CHECK: the
# constraint was written in guard and resolves there, not in the reader's path.
statement ok
CREATE FUNCTION age_ok(x INT) AS x < 0;


