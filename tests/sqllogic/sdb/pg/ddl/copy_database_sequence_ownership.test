query
SELECT relname, pg_get_userbyid(relowner) AS owner FROM pg_class WHERE relname LIKE 'cdso_%' ORDER BY relname;
----
relname	owner
cdso_owned	postgres
cdso_owner	postgres
cdso_serial	postgres
cdso_serial_id_seq	postgres


query
