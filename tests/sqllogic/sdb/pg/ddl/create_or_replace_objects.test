# CREATE OR REPLACE across every object kind serenedb accepts it for.
#
# PostgreSQL has OR REPLACE only for views, functions and triggers; tables,
# sequences, types, macros, secrets and schemas follow duckdb, where a replace
# is a DROP of the old entry plus a CREATE of the new one in the same
# transaction. That drop is RESTRICT: anything that depends on the old entry
# refuses the replace and leaves it untouched. What the old entry owned (its
# rows, indexes, triggers and comments) goes with it; its privileges are
# carried onto the new entry.
#
# The replace is transactional: a ROLLBACK brings back the old definition and
# the old data, and another connection keeps seeing the old entry until the
# COMMIT. A second writer of the same name is refused with a write-write
# conflict instead of waiting on a lock, and a dependent that another
# transaction hangs off the old entry makes whichever side commits last fail.
#
# TEXT SEARCH DICTIONARY has no OR REPLACE form, as in PostgreSQL.


# Roles and secrets outlive the per-file database.
statement ok
DROP ROLE IF EXISTS coro_reader;


statement ok
DROP SECRET IF EXISTS coro_sec;


# --- OR REPLACE TABLE: what goes with the old table -------------------------

statement ok
CREATE TABLE coro_audit (tag TEXT, a INT);


statement ok
CREATE ROLE coro_reader;


statement ok
CREATE TABLE coro_t (id INT, v TEXT);


statement count 2
INSERT INTO coro_t VALUES (1, 'a'), (2, 'b');


statement ok
CREATE INDEX coro_t_idx ON coro_t (id);


statement ok
COMMENT ON TABLE coro_t IS 'old table';


statement ok
COMMENT ON COLUMN coro_t.v IS 'old column';


statement ok
GRANT SELECT ON coro_t TO coro_reader;


statement ok
CREATE TRIGGER coro_t_trg AFTER INSERT ON coro_t FOR EACH STATEMENT
  INSERT INTO coro_audit VALUES ('coro_t_trg', 0);


statement ok
CREATE OR REPLACE TABLE coro_t (k INT, w TEXT, extra DOUBLE);


# New shape, no rows.
query
SELECT column_name, data_type FROM information_schema.columns
WHERE table_name = 'coro_t' ORDER BY ordinal_position;
----
column_name	data_type
k	integer
w	text
extra	double precision


query
SELECT count(*) AS n FROM coro_t;
----
n
0


# One relation under the name, and the index went with the old table.
query
SELECT relname, relkind FROM pg_class WHERE relname LIKE 'coro_t%' ORDER BY relname;
----
relname	relkind
coro_t	r


query
SELECT count(*) AS n FROM pg_indexes WHERE tablename = 'coro_t';
----
n
0


query
SELECT count(*) AS n FROM duckdb_triggers()
WHERE table_name = 'coro_t' AND database_name = current_database();
----
n
0


# The comments were the old table's; the grant is carried over.
query
SELECT comment IS NULL OR comment = '' AS no_comment FROM duckdb_tables()
WHERE table_name = 'coro_t' AND database_name = current_database();
----
no_comment
t


query
SELECT count(*) AS n FROM duckdb_columns()
WHERE table_name = 'coro_t' AND database_name = current_database()
  AND comment IS NOT NULL AND comment <> '';
----
n
0


query
SELECT has_table_privilege('coro_reader', 'coro_t', 'SELECT') AS kept_grant;
----
kept_grant
t


# The dropped trigger does not fire any more.
statement count 1
INSERT INTO coro_t VALUES (7, 'x', 1.5);


query
SELECT count(*) AS n FROM coro_audit;
----
n
0


