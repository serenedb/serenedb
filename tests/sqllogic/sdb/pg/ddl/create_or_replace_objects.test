table "coro_def" depends on sequence "coro_def_seq".
Use DROP...CASCADE to drop all dependents.


statement ok
CREATE OR REPLACE TABLE coro_def (id INT, v TEXT);


statement ok
DROP SEQUENCE coro_def_seq;


statement ok
DROP TABLE coro_def;


# A SERIAL column owns its sequence: the replace drops the old one and the
# new column counts from 1 again, with exactly one sequence left behind.
statement ok
