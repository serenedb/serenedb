# A view may be replaced by one that reads itself, as PostgreSQL allows; it
# only fails when it is read.
statement ok
CREATE OR REPLACE VIEW coro_vv AS SELECT a, b FROM coro_vv;


statement error
SELECT * FROM coro_vv;
----
db error: ERROR: infinite recursion detected: attempting to recursively bind view "coro_vv"


statement ok
DROP VIEW coro_vv;


statement ok
DROP TABLE coro_vt;


# --- OR REPLACE SCHEMA ------------------------------------------------------

# An empty schema is replaced; one with objects in it refuses.
statement ok
CREATE TABLE coro_sch.coro_in_sch (a INT);


statement count 1
INSERT INTO coro_sch.coro_in_sch VALUES (1);


statement error
CREATE OR REPLACE SCHEMA coro_sch;
----
db error: ERROR: Cannot drop entry "coro_sch" because there are entries that depend on it.
table "coro_in_sch" depends on schema "coro_sch".
Use DROP...CASCADE to drop all dependents.


query
SELECT a FROM coro_sch.coro_in_sch;
----
a
1


# Emptied and replaced inside a transaction that is rolled back, the schema
# has its table and rows back and nothing created in the replacement.
