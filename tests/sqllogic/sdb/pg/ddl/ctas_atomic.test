# CREATE TABLE AS reads and writes on the transaction that issued it, the way
# PostgreSQL's does: its SELECT sees that transaction's own uncommitted writes,
# and the rows it lands are readable before the COMMIT. The table is
# transactional too -- a CTAS inside a transaction block disappears with a
# ROLLBACK, rows and relation together.

statement ok
CREATE TABLE vedernikoff_src (id INTEGER, v TEXT);

statement ok
INSERT INTO vedernikoff_src VALUES (1, 'a'), (2, 'b'), (3, 'c');


# CTAS observes the issuing transaction's open writes.
statement ok
BEGIN;

statement ok
INSERT INTO vedernikoff_src VALUES (99, 'z');

statement ok
CREATE TABLE clickclack_iso AS SELECT * FROM vedernikoff_src;

# And what it landed is readable straight away, still inside the transaction.
query
SELECT count(*) FROM clickclack_iso;
----
count
4

statement ok
COMMIT;

query
SELECT count(*) FROM vedernikoff_src;
----
count
4

query
SELECT count(*) FROM clickclack_iso ORDER BY 1;
----
count
4

query
SELECT id FROM clickclack_iso WHERE id = 99;
----
id
99


# The table is transactional (PG 18): a CTAS inside a transaction block is
# undone by the ROLLBACK, table and rows together.
statement ok
BEGIN;

statement ok
CREATE TABLE babsky_rb AS SELECT * FROM vedernikoff_src WHERE id < 10;

statement ok
ROLLBACK;

query
SELECT count(*) AS n FROM pg_class WHERE relname = 'babsky_rb';
----
n
0

statement error
SELECT count(*) FROM babsky_rb;
----
db error: ERROR: Table with name babsky_rb does not exist!
<slt:ignore>


# Committed, it behaves like any other table.
statement ok
BEGIN;

statement ok
CREATE TABLE babsky_rb AS SELECT * FROM vedernikoff_src WHERE id < 10;

statement ok
COMMIT;

query
SELECT count(*) FROM babsky_rb;
----
count
3


# The new table is a normal table: DML works on it (rowid-keyed).
statement ok
INSERT INTO clickclack_iso VALUES (4, 'd');

statement ok
UPDATE clickclack_iso SET v = 'X' WHERE id = 1;

statement ok
DELETE FROM clickclack_iso WHERE id = 2;

query
SELECT id, v FROM clickclack_iso ORDER BY id;
----
id	v
1	X
3	c
4	d
99	z


statement ok
DROP TABLE vedernikoff_src;

statement ok
DROP TABLE clickclack_iso;

statement ok
DROP TABLE babsky_rb;
