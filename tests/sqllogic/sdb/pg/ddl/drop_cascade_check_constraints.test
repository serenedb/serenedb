# Vedernikoff CHECK constraint cascade scenarios. SDB-specific: relies on
# our CREATE FUNCTION ... AS expr syntax for CHECK predicates.

# --- 1. Single function used by CHECK on five sibling tables -------------

statement ok
CREATE FUNCTION vedernikoff_iceberg_within_bounds(x INT)
  AS x BETWEEN 0 AND 1000;


statement ok
CREATE TABLE vedernikoff_iceberg_t1 (
  v INT, CONSTRAINT ck_t1 CHECK (vedernikoff_iceberg_within_bounds(v))
);


statement ok
CREATE TABLE vedernikoff_iceberg_t2 (
  v INT, CONSTRAINT ck_t2 CHECK (vedernikoff_iceberg_within_bounds(v))
);


statement ok
CREATE TABLE vedernikoff_iceberg_t3 (
  v INT, CONSTRAINT ck_t3 CHECK (vedernikoff_iceberg_within_bounds(v))
);


statement ok
CREATE TABLE vedernikoff_iceberg_t4 (
  v INT, CONSTRAINT ck_t4 CHECK (vedernikoff_iceberg_within_bounds(v))
);


statement ok
CREATE TABLE vedernikoff_iceberg_t5 (
  v INT, CONSTRAINT ck_t5 CHECK (vedernikoff_iceberg_within_bounds(v))
);


statement error
INSERT INTO vedernikoff_iceberg_t1 VALUES (5000);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_iceberg_t1 with expression CHECK(vedernikoff_iceberg_within_bounds(v))


statement error
INSERT INTO vedernikoff_iceberg_t2 VALUES (-5);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_iceberg_t2 with expression CHECK(vedernikoff_iceberg_within_bounds(v))


statement error
INSERT INTO vedernikoff_iceberg_t3 VALUES (100000);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_iceberg_t3 with expression CHECK(vedernikoff_iceberg_within_bounds(v))


statement error
INSERT INTO vedernikoff_iceberg_t4 VALUES (-99);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_iceberg_t4 with expression CHECK(vedernikoff_iceberg_within_bounds(v))


statement error
INSERT INTO vedernikoff_iceberg_t5 VALUES (9999);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_iceberg_t5 with expression CHECK(vedernikoff_iceberg_within_bounds(v))


statement error
DROP FUNCTION vedernikoff_iceberg_within_bounds(INT);
----
db error: ERROR: Cannot drop entry "vedernikoff_iceberg_within_bounds" because there are entries that depend on it.<slt:ignore>



statement ok
DROP FUNCTION vedernikoff_iceberg_within_bounds(INT) CASCADE;


# The CHECK makes each table depend on the function, so all five go with it.
query
SELECT count(*) FROM information_schema.tables WHERE table_name IN (
  'vedernikoff_iceberg_t1', 'vedernikoff_iceberg_t2', 'vedernikoff_iceberg_t3',
  'vedernikoff_iceberg_t4', 'vedernikoff_iceberg_t5');
----
count
0


# --- 2. Sequence in CHECK + DEFAULT on the same table --------------------

statement ok
CREATE SEQUENCE vedernikoff_solid_payday_seq;


statement ok
CREATE TABLE vedernikoff_solid_payments (
  id INT DEFAULT nextval('vedernikoff_solid_payday_seq'),
  amount INT,
  CONSTRAINT cap CHECK (amount < (nextval('vedernikoff_solid_payday_seq') * 1000 + 10000))
);


statement count 1
INSERT INTO vedernikoff_solid_payments (amount) VALUES (500);


statement error
DROP SEQUENCE vedernikoff_solid_payday_seq;
----
db error: ERROR: Cannot drop entry "vedernikoff_solid_payday_seq" because there are entries that depend on it.<slt:ignore>



statement ok
DROP SEQUENCE vedernikoff_solid_payday_seq CASCADE;


# The DEFAULT and the CHECK both point at the sequence: the table goes.
query error
SELECT id, amount FROM vedernikoff_solid_payments ORDER BY id;
----
db error: ERROR: Table with name vedernikoff_solid_payments does not exist!
Did you mean "<slt:ignore>"?



# --- 3. Multiple functions in one CHECK constraint -----------------------

statement ok
CREATE FUNCTION vedernikoff_mop_is_positive(x INT) AS x > 0;


statement ok
CREATE FUNCTION vedernikoff_mop_is_small(x INT) AS x < 1000;


statement ok
CREATE TABLE vedernikoff_mop_data (
  v INT,
  CONSTRAINT ck CHECK (
    vedernikoff_mop_is_positive(v) AND vedernikoff_mop_is_small(v)
  )
);


statement count 1
INSERT INTO vedernikoff_mop_data VALUES (500);


statement error
INSERT INTO vedernikoff_mop_data VALUES (-1);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_mop_data with expression CHECK((vedernikoff_mop_is_positive(v) AND vedernikoff_mop_is_small(v)))


statement error
INSERT INTO vedernikoff_mop_data VALUES (5000);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_mop_data with expression CHECK((vedernikoff_mop_is_positive(v) AND vedernikoff_mop_is_small(v)))


# Drop one of the two CHECK functions with CASCADE -- the table goes with it.
statement error
DROP FUNCTION vedernikoff_mop_is_positive(INT);
----
db error: ERROR: Cannot drop entry "vedernikoff_mop_is_positive" because there are entries that depend on it.<slt:ignore>



statement ok
DROP FUNCTION vedernikoff_mop_is_positive(INT) CASCADE;


query error
SELECT v FROM vedernikoff_mop_data ORDER BY v;
----
db error: ERROR: Table with name vedernikoff_mop_data does not exist!
Did you mean "<slt:ignore>"?


# The second CHECK function lost its only dependent with the table.
statement ok
DROP FUNCTION vedernikoff_mop_is_small(INT);


# --- 4. Chained: fn1 calls fn2 used by CHECK -----------------------------

statement ok
CREATE FUNCTION vedernikoff_ml_inner(x INT) AS x % 100;


statement ok
CREATE FUNCTION vedernikoff_ml_outer(x INT) AS vedernikoff_ml_inner(x) >= 0;


statement ok
CREATE TABLE vedernikoff_ml_data (
  v INT, CONSTRAINT ck CHECK (vedernikoff_ml_outer(v))
);


statement count 1
INSERT INTO vedernikoff_ml_data VALUES (42);


# Drop the inner with CASCADE -- outer fn dies, and the table CHECKing it too.
statement error
DROP FUNCTION vedernikoff_ml_inner(INT);
----
db error: ERROR: Cannot drop entry "vedernikoff_ml_inner" because there are entries that depend on it.<slt:ignore>



statement ok
DROP FUNCTION vedernikoff_ml_inner(INT) CASCADE;


statement error
SELECT vedernikoff_ml_outer(1);
----
db error: ERROR: Scalar Function with name vedernikoff_ml_outer does not exist!
Did you mean "<slt:ignore>"?


query error
SELECT v FROM vedernikoff_ml_data ORDER BY v;
----
db error: ERROR: Table with name vedernikoff_ml_data does not exist!
Did you mean "<slt:ignore>"?



# --- 5. Multiple CHECKs on one table, all referencing a single fn --------

statement ok
CREATE FUNCTION vedernikoff_clickclack_threshold() AS 1000;


statement ok
CREATE TABLE vedernikoff_clickclack_metrics (
  qps INT,
  latency INT,
  err INT,
  CONSTRAINT cap_qps CHECK (qps < vedernikoff_clickclack_threshold()),
  CONSTRAINT cap_lat CHECK (latency < vedernikoff_clickclack_threshold()),
  CONSTRAINT cap_err CHECK (err < vedernikoff_clickclack_threshold())
);


statement count 1
INSERT INTO vedernikoff_clickclack_metrics VALUES (100, 50, 1);


statement error
INSERT INTO vedernikoff_clickclack_metrics VALUES (5000, 1, 1);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_clickclack_metrics with expression CHECK((qps < vedernikoff_clickclack_threshold()))


statement error
INSERT INTO vedernikoff_clickclack_metrics VALUES (1, 5000, 1);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_clickclack_metrics with expression CHECK((latency < vedernikoff_clickclack_threshold()))


statement error
INSERT INTO vedernikoff_clickclack_metrics VALUES (1, 1, 5000);
----
db error: ERROR: CHECK constraint failed on table vedernikoff_clickclack_metrics with expression CHECK((err < vedernikoff_clickclack_threshold()))


statement error
DROP FUNCTION vedernikoff_clickclack_threshold();
----
db error: ERROR: Cannot drop entry "vedernikoff_clickclack_threshold" because there are entries that depend on it.<slt:ignore>



statement ok
DROP FUNCTION vedernikoff_clickclack_threshold() CASCADE;


# Three CHECKs on the same function, one table dropped.
query error
SELECT qps, latency, err FROM vedernikoff_clickclack_metrics ORDER BY qps;
----
db error: ERROR: Table with name vedernikoff_clickclack_metrics does not exist!
Did you mean "<slt:ignore>"?
