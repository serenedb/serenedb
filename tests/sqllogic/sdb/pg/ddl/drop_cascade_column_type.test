# A table column declared with a user-defined type records no dependency on
# that type: DROP TYPE succeeds (plain, RESTRICT or CASCADE) while tables use
# it, nothing else is dropped, and the column keeps the enum duckdb copied
# into it.

statement ok
CREATE TYPE iceberg_partition_kind AS ENUM ('red', 'green', 'blue');


statement ok
CREATE TABLE iceberg_manifests (id INT, c iceberg_partition_kind);


statement count 2
INSERT INTO iceberg_manifests VALUES (1, 'red'), (2, 'green');


query
SELECT id, c FROM iceberg_manifests ORDER BY id;
----
id	c
1	red
2	green


statement ok
DROP TYPE iceberg_partition_kind;


query
SELECT id, c FROM iceberg_manifests ORDER BY id;
----
id	c
1	red
2	green


# The column still sorts by enum ordinal, not alphabetically.
query
SELECT c FROM iceberg_manifests ORDER BY c;
----
c
red
green


# The type name itself is gone, so a new column cannot be declared with it.
statement error
CREATE TABLE iceberg_manifests_copy (id INT, c iceberg_partition_kind);
----
db error: ERROR: Type with name iceberg_partition_kind does not exist!
Did you mean "<slt:ignore>"?


statement ok
DROP TABLE iceberg_manifests;


# Several columns of the same type in one table: all keep working.

statement ok
CREATE TYPE clickclack_node_state AS ENUM ('on','off');


statement ok
CREATE TABLE clickclack_workers (id INT, s1 clickclack_node_state, s2 clickclack_node_state, label TEXT);


statement count 1
INSERT INTO clickclack_workers VALUES (1, 'on', 'off', 'lamp');


statement ok
DROP TYPE clickclack_node_state;


query
SELECT id, s1, s2, label FROM clickclack_workers ORDER BY id;
----
id	s1	s2	label
1	on	off	lamp


statement ok
DROP TABLE clickclack_workers;


# CASCADE has nothing to cascade to: both tables using the type survive.

statement ok
CREATE TYPE mop_application_priority AS ENUM ('low','high');


statement ok
CREATE TABLE mop_applications (id INT, p mop_application_priority);


statement ok
CREATE TABLE mop_recruiter_calls (id INT, p mop_application_priority);


statement count 1
INSERT INTO mop_applications VALUES (1, 'high');


statement count 1
INSERT INTO mop_recruiter_calls VALUES (1, 'low');


statement ok
DROP TYPE mop_application_priority CASCADE;


query
SELECT id, p FROM mop_applications ORDER BY id;
----
id	p
1	high


query
SELECT id, p FROM mop_recruiter_calls ORDER BY id;
----
id	p
1	low


statement ok
DROP TABLE mop_applications;


statement ok
DROP TABLE mop_recruiter_calls;


statement ok
CREATE TYPE solid_principle_flag AS ENUM ('a','b');


statement ok
CREATE TABLE solid_violations (id INT, f solid_principle_flag);


statement ok
DROP TABLE solid_violations;


statement ok
DROP TYPE solid_principle_flag RESTRICT;


# The column owns its own copy of the enum: re-creating the type with an extra
# label does not extend the column's accepted values.

statement ok
CREATE TYPE ml_loss_mood AS ENUM ('happy','sad');


statement ok
CREATE TABLE ml_lectures (id INT, m ml_loss_mood);


statement count 1
INSERT INTO ml_lectures VALUES (1, 'happy');


statement ok
DROP TYPE ml_loss_mood CASCADE;


statement ok
CREATE TYPE ml_loss_mood AS ENUM ('happy','sad','meh');


statement error
INSERT INTO ml_lectures VALUES (2, 'meh');
----
db error: ERROR: Could not convert string 'meh' to UINT8


statement count 1
INSERT INTO ml_lectures VALUES (2, 'sad');


query
SELECT id, m FROM ml_lectures ORDER BY id;
----
id	m
1	happy
2	sad


statement ok
DROP TABLE ml_lectures;


statement ok
DROP TYPE ml_loss_mood;


# --- Indexes over a column of the type. Nothing depends on the type, so
# --- DROP TYPE CASCADE keeps every index, including the one on that column.

statement ok
CREATE TYPE vedernikoff_iceberg_state AS ENUM ('open','closed','pending');


statement ok
CREATE TABLE vedernikoff_manifests (
  id INT PRIMARY KEY,
  body TEXT,
  state vedernikoff_iceberg_state
);


statement ok
CREATE INDEX ix_state ON vedernikoff_manifests(state);


statement ok
CREATE INDEX ix_body ON vedernikoff_manifests(body);


statement ok
CREATE INDEX ix_state_body ON vedernikoff_manifests(state, body);


statement count 2
INSERT INTO vedernikoff_manifests VALUES (1, 'b1', 'open'), (2, 'b2', 'closed');


query
SELECT indexname FROM pg_indexes
  WHERE tablename = 'vedernikoff_manifests' ORDER BY indexname;
----
indexname
ix_body
ix_state
ix_state_body
vedernikoff_manifests_pkey


statement ok
DROP TYPE vedernikoff_iceberg_state CASCADE;


query
SELECT indexname FROM pg_indexes
  WHERE tablename = 'vedernikoff_manifests' ORDER BY indexname;
----
indexname
ix_body
ix_state
ix_state_body
vedernikoff_manifests_pkey


query
SELECT id, body, state FROM vedernikoff_manifests ORDER BY id;
----
id	body	state
1	b1	open
2	b2	closed


# The index on the column of the dropped type still answers lookups.
query
SELECT id FROM vedernikoff_manifests WHERE state = 'open' ORDER BY id;
----
id
1


statement ok
DROP TABLE vedernikoff_manifests;


# --- Cross-schema variant: type in schema A, table in schema B, index in B.

statement ok
CREATE SCHEMA vedernikoff_clickclack_types;


statement ok
CREATE SCHEMA vedernikoff_clickclack_data;


statement ok
CREATE TYPE vedernikoff_clickclack_types.priority AS ENUM ('low','high');


statement ok
CREATE TABLE vedernikoff_clickclack_data.jobs (
  id INT,
  p vedernikoff_clickclack_types.priority,
  label TEXT
);


# The build sorts its keys, and duckdb's sort re-resolves each key's type by
# bare name (decode_sort_key): an enum key only binds with its schema on the
# search path. Known upstream hole; deliberately not patched in the fork.
statement ok
SET search_path = public, vedernikoff_clickclack_types;


statement ok
CREATE INDEX ix_jobs_p ON vedernikoff_clickclack_data.jobs(p);


statement ok
RESET search_path;


statement ok
CREATE INDEX ix_jobs_label ON vedernikoff_clickclack_data.jobs(label);


statement count 2
INSERT INTO vedernikoff_clickclack_data.jobs VALUES (1, 'low', 'a'), (2, 'high', 'b');


statement ok
DROP TYPE vedernikoff_clickclack_types.priority;


query
SELECT indexname FROM pg_indexes
  WHERE schemaname = 'vedernikoff_clickclack_data' ORDER BY indexname;
----
indexname
ix_jobs_label
ix_jobs_p


query
SELECT id, p, label FROM vedernikoff_clickclack_data.jobs ORDER BY id;
----
id	p	label
1	low	a
2	high	b


statement error
CREATE TABLE vedernikoff_clickclack_data.jobs_copy (
  id INT,
  p vedernikoff_clickclack_types.priority
);
----
db error: ERROR: Type with name priority does not exist!
Did you mean "<slt:ignore>"?


statement ok
DROP SCHEMA vedernikoff_clickclack_data CASCADE;


statement ok
DROP SCHEMA vedernikoff_clickclack_types;
