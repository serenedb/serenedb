# --- 17. Self-overlapping cascade: same column DEFAULT and CHECK on one seq -
# Single sequence, single table; the table uses the seq in BOTH column
# DEFAULT and a CHECK constraint. CASCADE drops the table once.

statement ok
CREATE SEQUENCE vedernikoff_solid_journal_seq;


statement ok
CREATE TABLE vedernikoff_solid_journal (
  id INT DEFAULT nextval('vedernikoff_solid_journal_seq'),
  body TEXT,
  CONSTRAINT body_window
    CHECK (length(body) < nextval('vedernikoff_solid_journal_seq') + 1000)
);


