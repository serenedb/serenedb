statement ok
CREATE TABLE vedernikoff_mop_ats_records (
  id INT DEFAULT nextval('vedernikoff_mop_ats_seq'),
  score INT,
  CONSTRAINT score_caps CHECK (score < (nextval('vedernikoff_mop_ats_seq') + 1000000))
);


statement ok
CREATE FUNCTION vedernikoff_mop_ats_next() AS nextval('vedernikoff_mop_ats_seq');


statement ok
CREATE VIEW vedernikoff_mop_ats_window AS
  SELECT nextval('vedernikoff_mop_ats_seq') AS n;


