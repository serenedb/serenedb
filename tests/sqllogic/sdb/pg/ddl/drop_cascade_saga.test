# --- 16. CASCADE through a multi-schema function chain ---------------------
# Schema D has a sequence; schema E has a function that calls D's sequence;
# schema F has a table whose column DEFAULT calls E's function. Drop schema D
# CASCADE -> E's function is dropped and F's table goes with it.

statement ok
CREATE SCHEMA vedernikoff_layer_d;


statement ok
CREATE SCHEMA vedernikoff_layer_e;


statement ok
CREATE SCHEMA vedernikoff_layer_f;


statement ok
CREATE SEQUENCE vedernikoff_layer_d.iceberg_seq START 200;


statement ok
CREATE FUNCTION vedernikoff_layer_e.iceberg_next()
  AS nextval('vedernikoff_layer_d.iceberg_seq');


statement ok
CREATE TABLE vedernikoff_layer_f.consumer (
  id INT DEFAULT vedernikoff_layer_e.iceberg_next(),
  note TEXT
);


statement count 1
INSERT INTO vedernikoff_layer_f.consumer (note) VALUES ('captured');


query
