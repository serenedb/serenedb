# DROP TYPE / DROP TYPE CASCADE for user-defined types. duckdb tracks a
# dependency wherever the type is named inside a stored *expression* -- a view
# body, a macro body, a macro return type, a CHECK constraint or a column
# DEFAULT -- and plain DROP TYPE is refused for those. A type used only as a
# column type (including nested in LIST/STRUCT) records no dependency at all.

# --- 1. View body CAST ------------------------------------------------------

statement ok
CREATE TYPE clickclack_flavor AS ENUM ('sweet', 'salty');


statement ok
CREATE TABLE clickclack_strs (s TEXT);


statement count 2
INSERT INTO clickclack_strs VALUES ('sweet'), ('salty');


statement ok
CREATE VIEW clickclack_v_cast AS SELECT CAST(s AS clickclack_flavor) AS f FROM clickclack_strs;


statement error
DROP TYPE clickclack_flavor;
----
db error: ERROR: Cannot drop entry "clickclack_flavor" because there are entries that depend on it.
view "clickclack_v_cast" depends on type "clickclack_flavor".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE clickclack_flavor CASCADE;


statement error
SELECT * FROM clickclack_v_cast;
----
db error: ERROR: Table with name clickclack_v_cast does not exist!
Did you mean "<slt:ignore>"?


statement ok
DROP TABLE clickclack_strs;


# --- 2. Function body CAST --------------------------------------------------

statement ok
CREATE TYPE babsky_kind AS ENUM ('a', 'b');


statement ok
CREATE FUNCTION babsky_fn_cast(x TEXT) AS CAST(x AS babsky_kind);


statement error
DROP TYPE babsky_kind;
----
db error: ERROR: Cannot drop entry "babsky_kind" because there are entries that depend on it.
macro function "babsky_fn_cast" depends on type "babsky_kind".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE babsky_kind CASCADE;


statement error
SELECT babsky_fn_cast('a');
----
db error: ERROR: Scalar Function with name babsky_fn_cast does not exist!
Did you mean "<slt:ignore>"?


# --- 3. Function parameter type ---------------------------------------------
# A parameter type is not an expression, so no dependency is recorded and
# DROP TYPE succeeds. The macro survives with its enum parameter inlined into
# the signature.

statement ok
CREATE TYPE kostya_param AS ENUM ('p', 'q');


statement ok
CREATE FUNCTION kostya_fn_param(x kostya_param) AS x;


statement ok
DROP TYPE kostya_param;


statement error
SELECT kostya_fn_param('p');
----
db error: ERROR: Macro kostya_fn_param() does not support the supplied arguments. You might need to add explicit type casts.
Candidate macros:
	kostya_fn_param(x ENUM('p', 'q'))


# An inline anonymous enum of the same shape still binds the macro.
query
SELECT kostya_fn_param(CAST('p' AS ENUM('p','q')));
----
kostya_fn_param
p


statement ok
DROP FUNCTION kostya_fn_param;


# --- 3b. Function RETURN type -----------------------------------------------

statement ok
CREATE TYPE deadinside_ret AS ENUM ('r', 's');


statement ok
CREATE FUNCTION deadinside_fn_ret() RETURNS deadinside_ret AS 'r'::deadinside_ret;


statement error
DROP TYPE deadinside_ret;
----
db error: ERROR: Cannot drop entry "deadinside_ret" because there are entries that depend on it.
macro function "deadinside_fn_ret" depends on type "deadinside_ret".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE deadinside_ret CASCADE;


statement error
SELECT deadinside_fn_ret();
----
db error: ERROR: Scalar Function with name deadinside_fn_ret does not exist!
Did you mean "<slt:ignore>"?


# --- 4. CHECK constraint with CAST ------------------------------------------
# The dependency is recorded on the table, so CASCADE drops the whole table,
# not just the constraint.

statement ok
CREATE TYPE iceberg_check AS ENUM ('y', 'n');


statement ok
CREATE TABLE iceberg_t_check (s TEXT, CHECK (CAST(s AS iceberg_check) IS NOT NULL));


statement error
DROP TYPE iceberg_check;
----
db error: ERROR: Cannot drop entry "iceberg_check" because there are entries that depend on it.
table "iceberg_t_check" depends on type "iceberg_check".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE iceberg_check CASCADE;


query
SELECT count(*) FROM pg_class WHERE relname = 'iceberg_t_check';
----
count
0


statement error
SELECT s FROM iceberg_t_check;
----
db error: ERROR: Table with name iceberg_t_check does not exist!
Did you mean "<slt:ignore>"?


# --- 5. Column DEFAULT with CAST --------------------------------------------

statement ok
CREATE TYPE mop_def AS ENUM ('d', 'e');


statement ok
CREATE TABLE mop_t_def (x TEXT DEFAULT CAST('d' AS mop_def)::TEXT);


statement error
DROP TYPE mop_def;
----
db error: ERROR: Cannot drop entry "mop_def" because there are entries that depend on it.
table "mop_t_def" depends on type "mop_def".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE mop_def CASCADE;


query
SELECT count(*) FROM pg_class WHERE relname = 'mop_t_def';
----
count
0


# --- 6. Container column types (LIST / STRUCT) ------------------------------
# A column type does not create a dependency even when the user type is nested
# inside a LIST or STRUCT: DROP TYPE succeeds and the column keeps reading.

statement ok
CREATE TYPE saga_box AS ENUM ('x', 'y');


statement ok
CREATE TABLE saga_t_arr (xs saga_box[]);


statement count 1
INSERT INTO saga_t_arr VALUES (ARRAY['x','y']::saga_box[]);


statement ok
DROP TYPE saga_box;


query
SELECT xs FROM saga_t_arr;
----
xs
{x,y}


statement ok
DROP TABLE saga_t_arr;


statement ok
CREATE TYPE saga_box AS ENUM ('x', 'y');


statement ok
CREATE TABLE saga_t_struct (s STRUCT(a INT, b saga_box));


statement count 1
INSERT INTO saga_t_struct VALUES ({'a': 1, 'b': 'y'});


statement ok
DROP TYPE saga_box;


query
SELECT s FROM saga_t_struct;
----
s
(1,y)


statement ok
DROP TABLE saga_t_struct;


# --- 7. Cross-schema type ref (function in sb references type in sa) -------

statement ok
CREATE SCHEMA jira_ticket;


statement ok
CREATE SCHEMA manifest;


statement ok
CREATE TYPE jira_ticket.flav AS ENUM ('x', 'y');


statement ok
CREATE FUNCTION manifest.useflav(s TEXT) AS CAST(s AS jira_ticket.flav);


# RESTRICT blocked because the function in sb depends on the type in sa.
statement error
DROP TYPE jira_ticket.flav;
----
db error: ERROR: Cannot drop entry "flav" because there are entries that depend on it.
macro function "useflav" depends on type "flav".
Use DROP...CASCADE to drop all dependents.


# CASCADE drops the type and the dependent function in the other schema.
statement ok
DROP TYPE jira_ticket.flav CASCADE;


statement error
SELECT manifest.useflav('x');
----
db error: ERROR: Scalar Function with name useflav does not exist!
Did you mean "<slt:ignore>"?


statement ok
DROP SCHEMA jira_ticket;


statement ok
DROP SCHEMA manifest;


# --- 8. VARIANT and user-defined types -------------------------------------
# VARIANT shares STRUCT_TYPE_INFO with STRUCT, so CollectTypeRefs descends
# into its child slots. The VARIANT LogicalType's children are a fixed
# internal layout (keys / children / values / data) -- none user-defined --
# so VARIANT expressions must NOT spuriously register a dependency on an
# unrelated enum/type. But dependencies DO flow through CAST-to-usertype
# expressions nested inside ::VARIANT casts (CHECK, DEFAULT, view, function).
#
# Two scenarios exercised per dep site:
#   (a) VARIANT WITHOUT a CAST to the user type -- no dep, DROP succeeds.
#   (b) VARIANT WITH    a CAST to the user type -- dep tracked, RESTRICT blocks.
#
# Note: SereneDB's RocksDB storage can't persist VARIANT-typed columns, so
# VARIANT only appears inside expression sites (CHECK predicates, DEFAULT,
# view body, function body) -- never as a stored column type.

# --- 8a. VARIANT in a view, no user-type ref: no spurious dep -------------

statement ok
CREATE TYPE shred_solo_kind AS ENUM ('hot', 'cold');


# VARIANT used purely on built-in types -- no reference to shred_solo_kind.
statement ok
CREATE VIEW shred_solo_v AS SELECT 42::INT::VARIANT AS v, 'hello'::TEXT::VARIANT AS s;


# No CAST to shred_solo_kind anywhere -- DROP TYPE must succeed.
statement ok
DROP TYPE shred_solo_kind;


statement ok
DROP VIEW shred_solo_v;


# --- 8b. CHECK constraint: VARIANT CAST through user type tracks the dep ---

statement ok
CREATE TYPE shred_check_kind AS ENUM ('hot', 'cold');


statement ok
CREATE TABLE shred_check_t (
  s TEXT,
  CHECK (CAST(s AS shred_check_kind)::VARIANT IS NOT NULL)
);


statement error
DROP TYPE shred_check_kind;
----
db error: ERROR: Cannot drop entry "shred_check_kind" because there are entries that depend on it.
table "shred_check_t" depends on type "shred_check_kind".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE shred_check_kind CASCADE;


query
SELECT count(*) FROM pg_class WHERE relname = 'shred_check_t';
----
count
0


# --- 8c. Two CHECKs side-by-side: one with the dep, one without -----------
# The dependency is recorded on the table, so CASCADE drops the table with
# both constraints -- the unrelated CHECK is not preserved.

statement ok
CREATE TYPE shred_pair_kind AS ENUM ('a', 'b');


statement ok
CREATE TABLE shred_pair_t (
  s TEXT,
  n INT,
  CHECK (CAST(s AS shred_pair_kind)::VARIANT IS NOT NULL),
  CHECK (CAST(n AS BIGINT)::VARIANT IS NOT NULL)
);


statement error
DROP TYPE shred_pair_kind;
----
db error: ERROR: Cannot drop entry "shred_pair_kind" because there are entries that depend on it.
table "shred_pair_t" depends on type "shred_pair_kind".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE shred_pair_kind CASCADE;


query
SELECT count(*) FROM pg_class WHERE relname = 'shred_pair_t';
----
count
0


# --- 8d. Column DEFAULT with VARIANT CAST: dep tracked --------------------

statement ok
CREATE TYPE shred_def_kind AS ENUM ('p', 'q');


statement ok
CREATE TABLE shred_def_t (x TEXT DEFAULT CAST(CAST('p' AS shred_def_kind)::VARIANT AS TEXT));


statement error
DROP TYPE shred_def_kind;
----
db error: ERROR: Cannot drop entry "shred_def_kind" because there are entries that depend on it.
table "shred_def_t" depends on type "shred_def_kind".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE shred_def_kind CASCADE;


query
SELECT count(*) FROM pg_class WHERE relname = 'shred_def_t';
----
count
0


# --- 8e. VIEW body: VARIANT CAST referencing the user type ----------------

statement ok
CREATE TYPE shred_view_kind AS ENUM ('on', 'off');


statement ok
CREATE TABLE shred_view_src (s TEXT);


statement ok
CREATE VIEW shred_view_v AS SELECT CAST(s AS shred_view_kind)::VARIANT AS f FROM shred_view_src;


statement error
DROP TYPE shred_view_kind;
----
db error: ERROR: Cannot drop entry "shred_view_kind" because there are entries that depend on it.
view "shred_view_v" depends on type "shred_view_kind".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE shred_view_kind CASCADE;


statement error
SELECT * FROM shred_view_v;
----
db error: ERROR: Table with name shred_view_v does not exist!
Did you mean "<slt:ignore>"?


statement ok
DROP TABLE shred_view_src;


# --- 8f. FUNCTION body: VARIANT CAST referencing the user type ------------

statement ok
CREATE TYPE shred_fn_kind AS ENUM ('m', 'n');


statement ok
CREATE FUNCTION shred_fn_use(x TEXT) AS CAST(x AS shred_fn_kind)::VARIANT;


statement error
DROP TYPE shred_fn_kind;
----
db error: ERROR: Cannot drop entry "shred_fn_kind" because there are entries that depend on it.
macro function "shred_fn_use" depends on type "shred_fn_kind".
Use DROP...CASCADE to drop all dependents.


statement ok
DROP TYPE shred_fn_kind CASCADE;


statement error
SELECT shred_fn_use('m');
----
db error: ERROR: Scalar Function with name shred_fn_use does not exist!
Did you mean "<slt:ignore>"?
