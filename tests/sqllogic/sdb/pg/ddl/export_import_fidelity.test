control substitution on

statement ok
CREATE DATABASE eif_src;


statement ok
USE eif_src;


statement ok
CREATE SCHEMA s1;


statement ok
CREATE SCHEMA s2;


statement ok
CREATE SCHEMA "Odd S";


statement ok
CREATE TYPE s1.mood AS ENUM ('a', 'b');


statement ok
CREATE TYPE s2.mood AS ENUM ('x', 'y');


statement ok
CREATE TYPE "Odd S"."My T" AS STRUCT(a INT, b s2.mood);


statement ok
CREATE TABLE s1.typed (id INT, m s2.mood, p "Odd S"."My T", ms s2.mood[], arr s2.mood[2], mp MAP(TEXT, s1.mood), st STRUCT(k s2.mood), ip INET);


statement ok
INSERT INTO s1.typed VALUES (1, 'y', {'a': 1, 'b': 'x'}, ['x', 'y'], ['y', 'x'], MAP {'q': 'a'}, {'k': 'y'}, '10.0.0.1');


statement ok
CREATE TABLE s1.strings (id INT, t TEXT, v VARCHAR(10), l TEXT[]);


statement ok
INSERT INTO s1.strings VALUES (1, '', '', ['', NULL]), (2, NULL, NULL, NULL), (3, '"', ',', ['a,b']);


statement ok
CREATE SEQUENCE "Odd S"."q s" START 5 INCREMENT 2;


statement ok
CREATE SEQUENCE s1.fresh START 9;


statement ok
CREATE SEQUENCE s1.wrap START 2 INCREMENT -1 MINVALUE 1 MAXVALUE 2 CYCLE;


statement ok
CREATE SEQUENCE s1.done START 1 MAXVALUE 2;


query
SELECT nextval('"Odd S"."q s"') AS q, nextval('"Odd S"."q s"') AS q2, nextval('s1.wrap') AS w, nextval('s1.wrap') AS w2, nextval('s1.done') AS d, nextval('s1.done') AS d2;
----
q	q2	w	w2	d	d2
5	7	2	1	1	2


statement ok
CREATE TABLE s1.docs (id INT, body TEXT);


statement ok
CREATE INDEX docs_inv ON s1.docs USING inverted (body) WITH (segment_docs_max = 7, compaction_max_segments = 3, cleanup_interval_step = 2);


statement ok
EXPORT DATABASE '${__TEST_DIR__}/export_import_fidelity';


query
SELECT trim(line) AS line FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text('${__TEST_DIR__}/export_import_fidelity/schema.sql')) WHERE line LIKE 'CREATE TABLE s1.typed%' OR line LIKE 'CREATE TYPE "Odd S"%' OR line LIKE '%setval%' OR line LIKE 'CREATE SEQUENCE%' ORDER BY 1;
----
line
CREATE SEQUENCE "Odd S"."q s" INCREMENT BY 2 MINVALUE 1 MAXVALUE 9223372036854775807 START 5 NO CYCLE;
CREATE SEQUENCE s1.done INCREMENT BY 1 MINVALUE 1 MAXVALUE 2 START 1 NO CYCLE;
CREATE SEQUENCE s1.fresh INCREMENT BY 1 MINVALUE 1 MAXVALUE 9223372036854775807 START 9 NO CYCLE;
CREATE SEQUENCE s1.wrap INCREMENT BY -1 MINVALUE 1 MAXVALUE 2 START 2 CYCLE;
CREATE TABLE s1.typed(id INTEGER, m s2.mood, p "Odd S"."My T", ms s2.mood[], arr s2.mood[2], mp MAP(VARCHAR, s1.mood), st STRUCT(k s2.mood), ip INET);
CREATE TYPE "Odd S"."My T" AS STRUCT(a INTEGER, b s2.mood);
SELECT setval('"Odd S"."q s"', 7, true);
SELECT setval('s1.done', 2, true);
SELECT setval('s1.wrap', 1, true);


query
SELECT o = list_sort(o) AS sorted, list_contains(o, 'segment_docs_max = 7') AS kept FROM (SELECT string_split(regexp_extract(sql, 'WITH \((.*) \)', 1), ', ') AS o FROM sdb_indexes() WHERE database_name = current_database() AND index_name = 'docs_inv');
----
sorted	kept
t	t


