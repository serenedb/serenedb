statement ok
USE eif_dst;


statement ok
IMPORT DATABASE '${__TEST_DIR__}/export_import_fidelity';


query
SELECT column_name, data_type, udt_schema, udt_name FROM information_schema.columns WHERE table_schema = 's1' AND table_name = 'typed' AND column_name NOT IN ('ms', 'arr') ORDER BY ordinal_position;
----
column_name	data_type	udt_schema	udt_name
id	integer	pg_catalog	int4
m	USER-DEFINED	s2	mood
p	USER-DEFINED	Odd S	My T
mp	ARRAY	pg_catalog	_record
st	record	pg_catalog	record
ip	inet	pg_catalog	inet


query
SELECT * FROM s1.typed;
----
id	m	p	ms	arr	mp	st	ip
1	y	(1,x)	{x,y}	{y,x}	{"(q,a)"}	(y)	10.0.0.1


query
SELECT id, t IS NULL AS t_null, length(t) AS t_len, v IS NULL AS v_null, length(v) AS v_len, l FROM s1.strings ORDER BY id;
----
id	t_null	t_len	v_null	v_len	l
1	f	0	f	0	{"",NULL}
2	t	NULL	t	NULL	NULL
3	f	1	f	1	{"a,b"}


query
SELECT sequence_name, start_value, last_value FROM duckdb_sequences() WHERE database_name = current_database() ORDER BY 1;
----
sequence_name	start_value	last_value
done	1	2
fresh	9	NULL
q s	5	7
wrap	2	1


query
SELECT nextval('"Odd S"."q s"') AS q, nextval('s1.fresh') AS f, nextval('s1.wrap') AS w;
----
q	f	w
9	9	2


statement error
