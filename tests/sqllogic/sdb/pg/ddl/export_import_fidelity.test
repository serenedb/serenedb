query
SELECT count(*) AS indexes, count(DISTINCT replace(sql, database_name || '.', '')) AS variants FROM sdb_indexes() WHERE database_name IN ('eif_src', 'eif_dst') AND index_name = 'docs_inv';
----
indexes	variants
2	1


