USE exf_src;


query
SELECT (SELECT count(*) FROM (SELECT * FROM exf_src.public.f EXCEPT ALL SELECT * FROM exf_csv.public.f)) AS only_src, (SELECT count(*) FROM (SELECT * FROM exf_csv.public.f EXCEPT ALL SELECT * FROM exf_src.public.f)) AS only_dst, (SELECT count(*) FROM (SELECT * FROM exf_src.public.neg EXCEPT ALL SELECT * FROM exf_csv.public.neg)) AS neg_diff;
----
only_src	only_dst	neg_diff
0	0	0


query
SELECT (SELECT count(*) FROM (SELECT * FROM exf_src.public.f EXCEPT ALL SELECT * FROM exf_text.public.f)) AS only_src, (SELECT count(*) FROM (SELECT * FROM exf_text.public.f EXCEPT ALL SELECT * FROM exf_src.public.f)) AS only_dst, (SELECT count(*) FROM (SELECT * FROM exf_src.public.neg EXCEPT ALL SELECT * FROM exf_text.public.neg)) AS neg_diff;
