EXPORT DATABASE '${__TEST_DIR__}/eins';


query
SELECT line
FROM (
    SELECT unnest(string_split(content, chr(10))) AS line
    FROM read_text('${__TEST_DIR__}/eins/schema.sql')
)
WHERE line LIKE 'CREATE TEXT SEARCH DICTIONARY %' OR line LIKE 'CREATE JOB %' OR line LIKE '%OWNED BY%'
ORDER BY 1;
----
line
ALTER SEQUENCE eins_inner.top_owned OWNED BY t.id;
ALTER SEQUENCE eins_outer.eins_inner.nested_owned OWNED BY t.n;
CREATE JOB eins_outer.eins_inner.j AFTER INTERVAL '01:00:00' AS SELECT 1;
CREATE TEXT SEARCH DICTIONARY eins_outer.eins_inner.d AS split_text();


