query
SELECT d.objid::regclass::text AS sequence, d.refobjid::regclass::text AS owner, a.attname AS column
FROM pg_depend d
JOIN pg_class c ON c.oid = d.objid
JOIN pg_attribute a ON a.attrelid = d.refobjid AND a.attnum = d.refobjsubid
WHERE d.deptype = 'a' AND c.relkind = 'S'
ORDER BY 1;
----
sequence	owner	column
altered_owned	owners	d
created_owned	owners	c
drawn	drawers	b
eios.serials_big_seq	eios.serials	big
eios.serials_id_seq	eios.serials	id


statement ok
EXPORT DATABASE '${__TEST_DIR__}/eios';


query
SELECT line
FROM (
    SELECT unnest(string_split(content, chr(10))) AS line
    FROM read_text('${__TEST_DIR__}/eios/schema.sql')
)
WHERE line LIKE '%OWNED BY%'
ORDER BY 1;
----
line
ALTER SEQUENCE eios.serials_big_seq OWNED BY serials.big;
ALTER SEQUENCE eios.serials_id_seq OWNED BY serials.id;
ALTER SEQUENCE public.altered_owned OWNED BY owners.d;
ALTER SEQUENCE public.created_owned OWNED BY owners.c;
ALTER SEQUENCE public.drawn OWNED BY drawers.b;


query
SELECT position('CREATE SEQUENCE public.free ' IN content) < position('CREATE VIEW eios.free_next ' IN content) AS view_after_sequence,
       position('CREATE SEQUENCE public.released ' IN content) < position('released_next' IN content) AS macro_after_sequence
FROM read_text('${__TEST_DIR__}/eios/schema.sql');
----
view_after_sequence	macro_after_sequence
t	t


