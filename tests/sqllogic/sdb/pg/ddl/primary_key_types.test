# ---- composite scalar PK: enforced; only the full tuple must be unique ----

statement ok
CREATE TABLE pk_comp(a INTEGER, b TEXT, v TEXT, PRIMARY KEY (a, b));


statement ok
INSERT INTO pk_comp VALUES (1, 'x', 'one');


statement error
INSERT INTO pk_comp VALUES (1, 'x', 'two');
----
db error: ERROR: duplicate key value violates unique constraint "pk_comp_pkey"
DETAIL: Key (a, b)=(1, x) already exists.


statement ok
INSERT INTO pk_comp VALUES (1, 'y', 'three');


# ---- nested-type key columns ----

statement ok
CREATE TABLE pk_struct(k STRUCT(a INT) PRIMARY KEY, v TEXT);

statement ok
INSERT INTO pk_struct VALUES ({'a': 1}, 'a'), ({'a': 2}, 'b');

statement error
INSERT INTO pk_struct VALUES ({'a': 1}, 'c');
----
db error: ERROR: duplicate key value violates unique constraint "pk_struct_pkey"
DETAIL: Key (k)=({'a': 1}) already exists.


statement ok
CREATE TABLE pk_list(k INT[] PRIMARY KEY, v TEXT);

statement ok
INSERT INTO pk_list VALUES ([1, 2], 'a'), ([2, 1], 'b'), ([1], 'c');

statement error
INSERT INTO pk_list VALUES ([1, 2], 'd');
----
db error: ERROR: duplicate key value violates unique constraint "pk_list_pkey"
DETAIL: Key (k)=([1, 2]) already exists.


statement ok
CREATE TABLE complex_pk (a INTEGER, b INTEGER[] PRIMARY KEY);

statement ok
CREATE TABLE pk_map(k MAP(INTEGER, INTEGER) PRIMARY KEY, v TEXT);

statement ok
INSERT INTO pk_map VALUES (MAP {1: 2}, 'a');

statement error
INSERT INTO pk_map VALUES (MAP {1: 2}, 'b');
----
db error: ERROR: duplicate key value violates unique constraint "pk_map_pkey"
DETAIL: Key (k)=({1=2}) already exists.


statement ok
CREATE TABLE uq_struct(id INT PRIMARY KEY, k STRUCT(a INT), UNIQUE(k));

statement ok
INSERT INTO uq_struct VALUES (1, NULL), (2, NULL), (3, {'a': 3});

statement error
INSERT INTO uq_struct VALUES (4, {'a': 3});
----
db error: ERROR: duplicate key value violates unique constraint "uq_struct_k_key"
DETAIL: Key (k)=({'a': 3}) already exists.
