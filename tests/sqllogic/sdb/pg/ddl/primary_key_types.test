# Primary key / unique constraint type matrix: every column type a key can
# hold, scalar or nested, refuses a duplicate.


# ---- scalar PK types: uniqueness enforced (duplicate -> error) ----

statement ok
CREATE TABLE pk_i32(k INTEGER PRIMARY KEY, v TEXT);


statement ok
INSERT INTO pk_i32 VALUES (1, 'a');


statement error
INSERT INTO pk_i32 VALUES (1, 'b');
----
db error: ERROR: duplicate key value violates unique constraint "pk_i32_pkey"
DETAIL: Key (k)=(1) already exists.


statement ok
CREATE TABLE pk_u64(k UBIGINT PRIMARY KEY, v TEXT);


statement ok
INSERT INTO pk_u64 VALUES (1, 'a');


statement error
INSERT INTO pk_u64 VALUES (1, 'b');
----
db error: ERROR: duplicate key value violates unique constraint "pk_u64_pkey"
DETAIL: Key (k)=(1) already exists.


