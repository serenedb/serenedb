statement ok
CREATE TABLE rcv_t (a INTEGER, b INTEGER);


statement ok
CREATE TABLE rcv_u (a INTEGER, x INTEGER);


statement ok
INSERT INTO rcv_t VALUES (1, 10), (2, 20);


statement ok
INSERT INTO rcv_u VALUES (1, 100), (3, 300);


statement ok
CREATE VIEW rcv_cte AS WITH c AS (SELECT a FROM rcv_t) SELECT a FROM c;


statement ok
CREATE VIEW rcv_union AS SELECT a FROM rcv_t UNION ALL SELECT 5 AS a;


statement ok
CREATE VIEW rcv_recursive AS WITH RECURSIVE r(n) AS (SELECT a FROM rcv_t WHERE a = 1 UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n FROM r;


statement ok
CREATE VIEW rcv_join AS SELECT rcv_t.a, rcv_u.a AS ua, x FROM rcv_t JOIN rcv_u ON rcv_t.a = rcv_u.a;


statement ok
CREATE VIEW rcv_subquery AS SELECT s.a FROM (SELECT a FROM rcv_t) s;


statement ok
CREATE VIEW rcv_function AS SELECT rcv_t.a, r.range AS g FROM rcv_t, range(2) r;


statement ok
CREATE VIEW rcv_scalar AS SELECT (SELECT max(a) FROM rcv_t) AS m;


statement ok
CREATE VIEW rcv_star AS SELECT rcv_t.* FROM rcv_t;


statement ok
CREATE VIEW rcv_grouped AS SELECT a, count(*) AS n FROM rcv_t GROUP BY a HAVING count(a) > 0 ORDER BY a;


statement ok
CREATE VIEW rcv_qualify AS SELECT a FROM rcv_t QUALIFY row_number() OVER (ORDER BY a DESC) = 1;


statement ok
CREATE MACRO rcv_macro() AS TABLE SELECT a FROM rcv_t;


statement ok
ALTER TABLE rcv_t RENAME COLUMN a TO a2;


query
SELECT viewname, definition FROM pg_views WHERE schemaname = 'public' AND viewname LIKE 'rcv%' ORDER BY viewname;
----
viewname	definition
rcv_cte	WITH c AS (SELECT a2 AS a FROM rcv_t) SELECT a FROM c;
rcv_function	SELECT rcv_t.a2 AS a, r."range" AS g FROM rcv_t , "range"(2) AS r;
rcv_grouped	SELECT a2 AS a, count_star() AS n FROM rcv_t GROUP BY a2 HAVING (count(a2) > 0) ORDER BY a2;
rcv_join	SELECT rcv_t.a2 AS a, rcv_u.a AS ua, x FROM (rcv_t INNER JOIN rcv_u ON ((rcv_t.a2 = rcv_u.a)));
rcv_qualify	SELECT a2 AS a FROM rcv_t QUALIFY (row_number() OVER (ORDER BY a2 DESC) = 1);
rcv_recursive	WITH RECURSIVE r (n) AS ((SELECT a2 AS a FROM rcv_t WHERE (a2 = 1)) UNION ALL (SELECT (n + 1) FROM r WHERE (n < 3))) SELECT n FROM r;
rcv_scalar	SELECT (SELECT max(a2) FROM rcv_t) AS m;
rcv_star	SELECT * FROM (SELECT rcv_t.* FROM rcv_t) AS rcv_star(a, b);
rcv_subquery	SELECT s.a FROM (SELECT a2 AS a FROM rcv_t) AS s;
rcv_union	(SELECT a2 AS a FROM rcv_t) UNION ALL (SELECT 5 AS a);


