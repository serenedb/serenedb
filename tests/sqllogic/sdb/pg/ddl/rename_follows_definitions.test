statement ok
CREATE VIEW rfd_both AS SELECT p.a, q.z FROM public.rfd_t p, rfd_s.rfd_t q;


statement ok
ALTER TABLE rfd_t RENAME TO rfd_t2;


query
SELECT viewname, definition FROM pg_views WHERE viewname IN ('rfd_cte', 'rfd_both') ORDER BY viewname;
----
viewname	definition
rfd_both	SELECT p.a, q.z FROM public.rfd_t2 AS p , rfd_s.rfd_t AS q;
rfd_cte	WITH c AS (SELECT a FROM rfd_t2 AS rfd_t) SELECT a FROM c;


query
SELECT a FROM rfd_cte;
----
a
7


query
SELECT a, z FROM rfd_both;
----
a	z
7	9


