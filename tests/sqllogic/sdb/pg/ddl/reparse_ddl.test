query
SELECT pg_get_userbyid(datdba) AS owner FROM pg_database WHERE datname = 'rtd_db';
----
owner
rtd_owner


query
SELECT pg_get_userbyid(nspowner) AS owner FROM pg_namespace WHERE nspname = 'rtd_s';
----
owner
rtd_owner


query
SELECT subslotname IS NULL AS no_slot, subenabled, subbinary FROM pg_subscription WHERE subname = 'rtd_sub';
----
no_slot	subenabled	subbinary
t	f	t


query
SELECT unnest(s.setconfig) AS setting
FROM pg_db_role_setting s JOIN pg_roles r ON r.oid = s.setrole
WHERE r.rolname = 'rtd_owner' AND s.setdatabase = 0
ORDER BY setting;
----
setting
search_path="a,b", c
standard_conforming_strings=on


query
SELECT proconfig FROM pg_proc WHERE proname = 'rtd_f';
----
proconfig
{search_path=}


query
SELECT parname FROM pg_parameter_acl WHERE parname LIKE 'rtd_ext.%';
----
parname
rtd_ext.a.b


