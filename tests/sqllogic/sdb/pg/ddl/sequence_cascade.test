# Both tables depend on the sequence, so a plain DROP SEQUENCE is refused.
statement error
DROP SEQUENCE clickclack_dashboards_id_seq;
----
db error: ERROR: Cannot drop entry "clickclack_dashboards_id_seq" because there are entries that depend on it.<slt:ignore>



statement error
DROP SEQUENCE clickclack_dashboards_id_seq RESTRICT;
----
db error: ERROR: Cannot drop entry "clickclack_dashboards_id_seq" because there are entries that depend on it.<slt:ignore>



query
SELECT id, name FROM clickclack_dashboards ORDER BY id;
----
id	name
1	a
2	b


statement count 1
INSERT INTO clickclack_dashboards_audit (payload) VALUES ('still-works');


query
SELECT id, payload FROM clickclack_dashboards_audit ORDER BY id;
----
id	payload
3	first
4	still-works


statement ok
DROP TABLE clickclack_dashboards CASCADE;


query
SELECT count(*) AS n FROM pg_class WHERE relname = 'clickclack_dashboards';
----
n
0


# The sequence is not owned by the dropped table -- it keeps counting.
query error
SELECT nextval('clickclack_dashboards_id_seq');
----
db error: ERROR: Sequence with name clickclack_dashboards_id_seq does not exist!
Did you mean "<slt:ignore>"?



statement error
INSERT INTO clickclack_dashboards_audit (id, payload) VALUES (100, 'explicit');
----
db error: ERROR: Table with name clickclack_dashboards_audit does not exist!
Did you mean "<slt:ignore>"?



statement error
INSERT INTO clickclack_dashboards_audit (payload) VALUES ('default-still-works');
----
db error: ERROR: Table with name clickclack_dashboards_audit does not exist!
Did you mean "<slt:ignore>"?



query error
SELECT id, payload FROM clickclack_dashboards_audit ORDER BY id;
----
db error: ERROR: Table with name clickclack_dashboards_audit does not exist!
Did you mean "<slt:ignore>"?



# CASCADE granularity: the dependent TABLE goes, not just its column DEFAULT.
statement error
DROP SEQUENCE clickclack_dashboards_id_seq CASCADE;
----
db error: ERROR: Sequence with name clickclack_dashboards_id_seq does not exist!
Did you mean "<slt:ignore>"?



