query
SELECT current_setting('wal_receiver_timeout') AS timeout, current_setting('wal_receiver_status_interval') AS status, current_setting('wal_retrieve_retry_interval') AS retry, current_setting('max_sync_workers_per_subscription') AS workers;
----
timeout	status	retry	workers
1min	10s	5s	2


