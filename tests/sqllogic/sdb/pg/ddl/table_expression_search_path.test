control substitution on

statement ok
CREATE SCHEMA tesp_s;


statement ok
CREATE FUNCTION tesp_s.tesp_pos(x INT) RETURNS BOOLEAN LANGUAGE sql IMMUTABLE AS 'SELECT x > 0';


statement ok
CREATE FUNCTION tesp_s.tesp_conv(x INT) RETURNS BIGINT LANGUAGE sql IMMUTABLE AS 'SELECT x * 10';


statement ok
CREATE TEMPORARY MACRO tesp_tmp(x) AS x + 100;


statement ok
CREATE DATABASE tesp_db_${__DATABASE__};


statement ok
SET search_path = tesp_s, public;


statement error
