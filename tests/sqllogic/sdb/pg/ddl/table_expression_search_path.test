query
SELECT conrelid::regclass AS tbl, conname, pg_get_constraintdef(oid) AS def FROM pg_constraint
WHERE conrelid IN ('public.tesp_t'::regclass, 'public.tesp_st'::regclass) AND contype = 'c' ORDER BY conname;
----
tbl	conname	def
tesp_st	tesp_st_a	CHECK (tesp_s.tesp_pos(a))
tesp_st	tesp_st_id	CHECK (tesp_s.tesp_pos(id))
tesp_t	tesp_t_a	CHECK (tesp_s.tesp_pos(a))
tesp_t	tesp_t_id	CHECK (tesp_s.tesp_pos(id))


query
SELECT table_name, column_name, column_default, generation_expression FROM information_schema.columns
WHERE table_schema = 'public' AND table_name IN ('tesp_t', 'tesp_st') AND column_name IN ('d', 'e', 'g')
ORDER BY table_name, column_name;
----
table_name	column_name	column_default	generation_expression
tesp_st	d	tesp_s.tesp_conv(2)	NULL
tesp_st	e	tesp_s.tesp_conv(3)	NULL
tesp_st	g	NULL	CAST(tesp_s.tesp_conv(a) AS BIGINT)
tesp_t	d	tesp_s.tesp_conv(2)	NULL
tesp_t	e	tesp_s.tesp_conv(3)	NULL
tesp_t	g	NULL	CAST(tesp_s.tesp_conv(a) AS BIGINT)


