statement ok
CREATE TABLE tesp_db_${__DATABASE__}.public.tesp_x (a INT CHECK (tesp_pos(a)));


statement ok
CREATE TABLE public.tesp_t (id INT, a INT CONSTRAINT tesp_t_a CHECK (tesp_pos(a)),
  d BIGINT DEFAULT tesp_conv(1), g BIGINT GENERATED ALWAYS AS (tesp_conv(a)) STORED);


statement ok
CREATE TABLE public.tesp_st (id INT, a INT CONSTRAINT tesp_st_a CHECK (tesp_pos(a)),
  d BIGINT DEFAULT tesp_conv(1), g BIGINT GENERATED ALWAYS AS (tesp_conv(a)) STORED)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
ALTER TABLE public.tesp_t ADD CONSTRAINT tesp_t_id CHECK (tesp_pos(id));


statement ok
ALTER TABLE public.tesp_st ADD CONSTRAINT tesp_st_id CHECK (tesp_pos(id));


