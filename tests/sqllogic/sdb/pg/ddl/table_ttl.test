CREATE TABLE ttl_logs (ts TIMESTAMP_NS NOT NULL, msg VARCHAR)
WITH (storage = 'search', ttl = '30 days', ttl_column = 'ts');


query
SELECT job_name, schedule, regexp_replace(body, '[0-9]+', 'N', 'g') AS body
FROM sdb_jobs() WHERE job_name = 'ttl_logs_ttl';
----
job_name	schedule	body
ttl_logs_ttl	EVERY INTERVAL '01:00:00'	PRAGMA serenedb_expire_by_id(CAST(N AS BIGINT));


query
SELECT option FROM (SELECT unnest(reloptions) AS option FROM pg_class WHERE relname = 'ttl_logs')
WHERE option LIKE 'ttl%' ORDER BY option;
----
option
ttl=30 days
ttl_column=ts


