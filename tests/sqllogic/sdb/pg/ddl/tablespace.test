statement ok
CREATE TEXT SEARCH DICTIONARY ts_english AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false);

statement ok
CREATE TABLE docs (id INT, body TEXT) WITH (storage = 'search') TABLESPACE ts_${__DATABASE__};

statement ok
INSERT INTO docs VALUES (1, 'quick brown fox'), (2, 'lazy dog');

statement ok
CREATE TABLE notes (id INT, body TEXT);

statement ok
INSERT INTO notes VALUES (1, 'red fox'), (2, 'blue whale');

statement ok
CREATE INDEX notes_idx ON notes USING inverted(body ts_english) TABLESPACE ts_${__DATABASE__};

statement ok
VACUUM (REFRESH_TABLE) docs;

query
SELECT c.relname, t.spcname = 'ts_${__DATABASE__}' AS in_ts
FROM pg_class c JOIN pg_tablespace t ON t.oid = c.reltablespace
WHERE c.relname IN ('docs', 'notes', 'notes_idx') ORDER BY c.relname;
----
relname	in_ts
docs	t
notes_idx	t

query
SELECT id, body FROM docs ORDER BY id;
