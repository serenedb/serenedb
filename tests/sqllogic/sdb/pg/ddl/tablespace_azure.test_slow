control substitution on

# A transaction that began before the secret holds back the cleanup of
# older catalog versions; the tablespace has to find the secret anyway.
connection holder
statement ok
BEGIN;


connection holder
query
SELECT count(*) > 0 AS open FROM duckdb_settings();
----
open
t


statement ok
CREATE OR REPLACE PERSISTENT SECRET ts_az_${__DATABASE__} (
  TYPE azure,
  CONNECTION_STRING '${AZURITE_CONNECTION_STRING}',
  SCOPE 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_ts'
);


statement ok
CREATE TABLESPACE ts_az_${__DATABASE__} LOCATION 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_ts';


connection holder
statement ok
COMMIT;


query
SELECT pg_tablespace_location(oid) = 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_ts' AS located
FROM pg_tablespace WHERE spcname = 'ts_az_${__DATABASE__}';
----
located
t


statement ok
CREATE TEXT SEARCH DICTIONARY ts_az_english AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE TABLE docs (id INT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0)
  TABLESPACE ts_az_${__DATABASE__};


statement ok
CREATE INDEX docs_idx ON docs USING inverted(body ts_az_english);


statement ok
INSERT INTO docs VALUES
  (1, 'the quick brown fox jumps over the lazy dog'),
  (2, 'a lazy afternoon by the river'),
  (3, 'brown bread and a quick breakfast');


statement ok
VACUUM (REFRESH_TABLE) docs;


statement ok
INSERT INTO docs VALUES
  (4, 'the fox hides in the brown leaves'),
  (5, 'quick thinking saves the day');


statement ok
VACUUM (REFRESH_TABLE) docs;


statement ok
CREATE TABLE notes (id INT, body TEXT);


statement ok
INSERT INTO notes SELECT i, CASE WHEN i % 3 = 0 THEN 'red fox at dawn' ELSE 'blue whale at sea' END
FROM generate_series(1, 300) AS s(i);


statement ok
CREATE INDEX notes_idx ON notes USING inverted(body ts_az_english)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)')
  TABLESPACE ts_az_${__DATABASE__};


statement ok
VACUUM (REFRESH_TABLE) notes;


query
SELECT count(*) > 0 AS stored_on_azure
FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_ts/engine_v1/*/*/*');
----
stored_on_azure
t


query
SELECT id FROM docs_idx WHERE body @@ ts_phrase('brown') ORDER BY id;
----
id
1
3
4


query
SELECT count(*) AS foxes FROM notes_idx WHERE body @@ ts_phrase('red fox');
----
foxes
100


query
SELECT count(*) AS top FROM (
  SELECT id FROM notes_idx WHERE body @@ ts_phrase('fox')
  ORDER BY BM25(notes_idx.tableoid) DESC LIMIT 10
);
----
top
10


statement ok
VACUUM (COMPACT_TABLE) docs;


statement ok
VACUUM (COMPACT_TABLE) notes;


query
SELECT id FROM docs_idx WHERE body @@ ts_phrase('quick') ORDER BY id;
----
id
1
3
5


query
SELECT count(*) AS whales FROM notes_idx WHERE body @@ ts_phrase('blue whale');
----
whales
200


statement ok
DROP TABLE docs;


statement ok
DROP TABLE notes;


statement ok
DROP TABLESPACE ts_az_${__DATABASE__};


query ok retry 40 backoff 250ms
SELECT count(*) AS left_on_azure
FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_ts/engine_v1/**');
----
left_on_azure
0


statement ok
DROP TEXT SEARCH DICTIONARY ts_az_english;


statement ok
DROP PERSISTENT SECRET ts_az_${__DATABASE__};
