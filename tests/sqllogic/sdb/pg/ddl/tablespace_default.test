SET default_tablespace = 'def_gone_${__DATABASE__}';

statement ok
DROP TABLESPACE def_gone_${__DATABASE__};

connection other
statement ok
CREATE TABLE after_drop (id INT) WITH (storage = 'search');

connection other
query
SELECT current_setting('default_tablespace') = 'def_gone_${__DATABASE__}' AS still_named;
----
still_named
t

query
SELECT reltablespace FROM pg_class WHERE relname = 'after_drop';
