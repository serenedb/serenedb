statement ok
GRANT CREATE ON TABLESPACE def_x_${__DATABASE__} TO def_user_${__DATABASE__};

statement ok
SET ROLE def_user_${__DATABASE__};

statement ok
SET default_tablespace = 'def_x_${__DATABASE__}';

statement ok
CREATE TABLE granted (id INT) WITH (storage = 'search');

statement ok
RESET default_tablespace;

statement ok
RESET ROLE;

query
SELECT c.relname, coalesce(replace(t.spcname, '_${__DATABASE__}', ''), '(database)') AS tablespace,
       r.rolname = 'def_user_${__DATABASE__}' AS owned_by_user
FROM pg_class c LEFT JOIN pg_tablespace t ON t.oid = c.reltablespace JOIN pg_roles r ON r.oid = c.relowner
WHERE c.relname IN ('in_database_tablespace', 'granted') ORDER BY c.relname;
----
relname	tablespace	owned_by_user
granted	def_x	t
in_database_tablespace	(database)	t

