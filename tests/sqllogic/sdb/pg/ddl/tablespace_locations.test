db error: ERROR: Could not rename "<slt:ignore>" to "<slt:ignore>": another entry with this name already exists!


statement ok
DROP TABLESPACE "PG_upper_${__DATABASE__}";

statement ok retry 240 backoff 250ms
CREATE TABLESPACE reuse_${__DATABASE__} LOCATION '${__TEST_DIR__}/names/upper';

query
SELECT pg_tablespace_location(oid) = '${__TEST_DIR__}/names/upper' AS reused
FROM pg_tablespace WHERE spcname = 'reuse_${__DATABASE__}';
----
reused
t

