control substitution on

# Several tablespaces in one database: every object keeps its files in its own
# tablespace, queries span them, and each tablespace drops once its last object
# is gone.

statement ok
CREATE TABLESPACE many_a_${__DATABASE__} LOCATION '${__TEST_DIR__}/many/a';

statement ok
CREATE TABLESPACE many_b_${__DATABASE__} LOCATION '${__TEST_DIR__}/many/b';

statement ok
CREATE TABLESPACE many_c_${__DATABASE__} LOCATION '${__TEST_DIR__}/many/c';

statement ok
CREATE TABLESPACE many_unused_${__DATABASE__} LOCATION '${__TEST_DIR__}/many/unused';

statement ok
CREATE TEXT SEARCH DICTIONARY many_words AS split_text(case := 'lower') WITH (frequency, position, norm);

statement ok
CREATE TABLE articles (id INT, title TEXT)
  WITH (storage = 'search') TABLESPACE many_a_${__DATABASE__};

statement ok
CREATE TABLE comments (id INT, article INT, body TEXT)
  WITH (storage = 'search') TABLESPACE many_b_${__DATABASE__};

statement ok
CREATE TABLE tags (article INT, tag TEXT) WITH (storage = 'search');

statement ok
CREATE TABLE notes (id INT, head TEXT, body TEXT);

statement ok
CREATE INDEX notes_head ON notes USING inverted(head many_words) TABLESPACE many_a_${__DATABASE__};

statement ok
CREATE INDEX notes_body ON notes USING inverted(body many_words) TABLESPACE many_c_${__DATABASE__};

statement ok
CREATE INDEX notes_both ON notes USING inverted(head many_words, body many_words) INCLUDE (id);

statement ok
INSERT INTO articles VALUES (1, 'Foxes in winter'), (2, 'Whales of the north'), (3, 'Bread at dawn');

statement ok
INSERT INTO comments VALUES (1, 1, 'red fox seen'), (2, 1, 'great pictures'), (3, 2, 'blue whale song'), (4, 3, 'fresh bread');

statement ok
INSERT INTO tags VALUES (1, 'animals'), (2, 'animals'), (3, 'food');

statement ok
INSERT INTO notes VALUES (1, 'fox notes', 'the quick brown fox'), (2, 'whale notes', 'a blue whale sings'), (3, 'bread notes', 'the fox steals bread');

statement ok
VACUUM (REFRESH_TABLE) articles;

statement ok
VACUUM (REFRESH_TABLE) comments;

statement ok
VACUUM (REFRESH_TABLE) tags;

statement ok
VACUUM (REFRESH_TABLE) notes;

query
SELECT c.relname, coalesce(replace(t.spcname, '_${__DATABASE__}', ''), '(database)') AS tablespace
FROM pg_class c LEFT JOIN pg_tablespace t ON t.oid = c.reltablespace
WHERE c.relname IN ('articles', 'comments', 'tags', 'notes', 'notes_head', 'notes_body', 'notes_both')
ORDER BY c.relname;
----
relname	tablespace
articles	many_a
comments	many_b
notes	(database)
notes_body	many_c
notes_both	(database)
notes_head	many_a
tags	(database)

query
SELECT a.title, count(c.id) AS comments, string_agg(t.tag, ',') AS tags
FROM articles a JOIN comments c ON c.article = a.id JOIN tags t ON t.article = a.id
GROUP BY a.title ORDER BY a.title;
----
title	comments	tags
Bread at dawn	1	food
Foxes in winter	2	animals,animals
Whales of the north	1	animals

query
SELECT id FROM notes_head WHERE head @@ ts_phrase('fox notes') ORDER BY id;
----
id
1

query
SELECT id FROM notes_body WHERE body @@ ts_phrase('fox') ORDER BY id;
----
id
1
3

query
SELECT id FROM notes_both WHERE head @@ ts_phrase('bread') AND body @@ ts_phrase('fox') ORDER BY id;
----
id
3

query
SELECT n.id, c.body FROM notes_body n JOIN comments c ON c.id = n.id
WHERE n.body @@ ts_phrase('whale') ORDER BY n.id;
----
id	body
2	great pictures

query
SELECT count(*) > 0 AS a_files, (SELECT count(*) > 0 FROM glob('${__TEST_DIR__}/many/b/engine_v1/*/*/*')) AS b_files,
       (SELECT count(*) > 0 FROM glob('${__TEST_DIR__}/many/c/engine_v1/*/*/*')) AS c_files,
       (SELECT count(*) FROM glob('${__TEST_DIR__}/many/unused/engine_v1/**')) AS unused_files
FROM glob('${__TEST_DIR__}/many/a/engine_v1/*/*/*');
----
a_files	b_files	c_files	unused_files
t	t	t	0

query
SELECT replace(spcname, '_${__DATABASE__}', '') AS tablespace, pg_tablespace_size(spcname) > 0 AS holds_files
FROM pg_tablespace WHERE spcname LIKE 'many_%_${__DATABASE__}' ORDER BY spcname;
----
tablespace	holds_files
many_a	t
many_b	t
many_c	t
many_unused	f

statement error
DROP TABLESPACE many_a_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
DROP TABLE articles;

statement error
DROP TABLESPACE many_a_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
DROP INDEX notes_head;

statement ok
DROP TABLESPACE many_a_${__DATABASE__};

query ok retry 240 backoff 250ms
SELECT count(*) AS left_in_a FROM glob('${__TEST_DIR__}/many/a/**');
----
left_in_a
0

statement ok
DROP TABLESPACE many_unused_${__DATABASE__};

query
SELECT id FROM notes_body WHERE body @@ ts_phrase('bread') ORDER BY id;
----
id
3

query
SELECT count(*) AS comments FROM comments;
----
comments
4

statement ok
DROP TABLE comments;

statement ok
DROP TABLESPACE many_b_${__DATABASE__};

statement ok
DROP INDEX notes_body;

statement ok
DROP TABLESPACE many_c_${__DATABASE__};

query
SELECT count(*) AS tablespaces FROM pg_tablespace WHERE spcname LIKE 'many_%_${__DATABASE__}';
----
tablespaces
0

query
SELECT id FROM notes_both WHERE body @@ ts_phrase('whale') ORDER BY id;
----
id
2

statement ok
DROP TABLE notes;

statement ok
DROP TABLE tags;

statement ok
DROP TEXT SEARCH DICTIONARY many_words;
