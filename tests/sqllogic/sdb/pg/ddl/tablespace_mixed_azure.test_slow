control substitution on

# Azure and local tablespaces side by side in one database, and two Azure
# tablespaces under different prefixes, each reached with the secret whose
# scope covers it.

statement ok
CREATE OR REPLACE PERSISTENT SECRET mixaz_a_${__DATABASE__} (
  TYPE azure,
  CONNECTION_STRING '${AZURITE_CONNECTION_STRING}',
  SCOPE 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_a'
);


statement ok
CREATE OR REPLACE PERSISTENT SECRET mixaz_b_${__DATABASE__} (
  TYPE azure,
  CONNECTION_STRING '${AZURITE_CONNECTION_STRING}',
  SCOPE 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_b'
);


statement ok
CREATE TABLESPACE mixaz_a_${__DATABASE__} LOCATION 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_a';


statement ok
CREATE TABLESPACE mixaz_b_${__DATABASE__} LOCATION 'az://${AZURITE_BLOB_CONTAINER}/./${__DATABASE__}_mixaz_b/';


statement ok
CREATE TABLESPACE mixaz_local_${__DATABASE__} LOCATION '${__TEST_DIR__}/mixaz/local';


query
SELECT pg_tablespace_location(oid) = 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_b' AS normalized
FROM pg_tablespace WHERE spcname = 'mixaz_b_${__DATABASE__}';
----
normalized
t


statement ok
CREATE TEXT SEARCH DICTIONARY mixaz_words AS split_text(case := 'lower') WITH (frequency, position, norm);


statement ok
CREATE TABLE remote_docs (id INT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0)
  TABLESPACE mixaz_a_${__DATABASE__};


statement ok
CREATE TABLE notes (id INT, body TEXT);


statement ok
CREATE INDEX notes_remote ON notes USING inverted(body mixaz_words) TABLESPACE mixaz_b_${__DATABASE__};


statement ok
CREATE INDEX notes_local ON notes USING inverted(body mixaz_words) TABLESPACE mixaz_local_${__DATABASE__};


statement ok
INSERT INTO remote_docs SELECT i, CASE WHEN i % 5 = 0 THEN 'quick brown fox ' || i ELSE 'lazy dog ' || i END
FROM range(1, 101) t(i);


statement ok
INSERT INTO notes SELECT i, CASE WHEN i % 3 = 0 THEN 'red fox at dawn' ELSE 'blue whale at sea' END
FROM range(1, 301) t(i);


statement ok
VACUUM (REFRESH_TABLE) remote_docs;


statement ok
VACUUM (REFRESH_TABLE) notes;


statement ok
UPDATE remote_docs SET body = 'quick brown fox updated' WHERE id = 1;


statement ok
VACUUM (REFRESH_TABLE) remote_docs;


query
SELECT c.relname, replace(t.spcname, '_${__DATABASE__}', '') AS tablespace
FROM pg_class c JOIN pg_tablespace t ON t.oid = c.reltablespace
WHERE c.relname IN ('remote_docs', 'notes_remote', 'notes_local') ORDER BY c.relname;
----
relname	tablespace
notes_local	mixaz_local
notes_remote	mixaz_b
remote_docs	mixaz_a


query
SELECT count(*) FILTER (WHERE body LIKE 'quick brown fox%') AS foxes, count(*) AS rows FROM remote_docs;
----
foxes	rows
21	100


query
SELECT (SELECT count(*) FROM notes_remote WHERE body @@ ts_phrase('red fox')) AS remote_foxes,
       (SELECT count(*) FROM notes_local WHERE body @@ ts_phrase('red fox')) AS local_foxes;
----
remote_foxes	local_foxes
100	100


statement ok
VACUUM (COMPACT_TABLE) remote_docs;


statement ok
VACUUM (COMPACT_TABLE) notes;


query
SELECT count(*) AS whales FROM notes_remote WHERE body @@ ts_phrase('blue whale');
----
whales
200


query
SELECT (SELECT count(*) > 0 FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_a/engine_v1/*/*/*')) AS a_files,
       (SELECT count(*) > 0 FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_b/engine_v1/*/*/*')) AS b_files;
----
a_files	b_files
t	t


query
SELECT replace(spcname, '_${__DATABASE__}', '') AS tablespace, pg_tablespace_size(spcname) > 0 AS holds_files
FROM pg_tablespace WHERE spcname IN ('mixaz_a_${__DATABASE__}', 'mixaz_b_${__DATABASE__}') ORDER BY spcname;
----
tablespace	holds_files
mixaz_a	t
mixaz_b	t


statement ok
DROP INDEX notes_remote;


statement ok
DROP TABLESPACE mixaz_b_${__DATABASE__};


query ok retry 40 backoff 250ms
SELECT count(*) AS left_in_b FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_b/engine_v1/**');
----
left_in_b
0


statement ok
DROP TABLE remote_docs;


statement ok
DROP TABLESPACE mixaz_a_${__DATABASE__};


query ok retry 40 backoff 250ms
SELECT count(*) AS left_in_a FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_mixaz_a/engine_v1/**');
----
left_in_a
0


query
SELECT count(*) AS local_foxes FROM notes_local WHERE body @@ ts_phrase('fox');
----
local_foxes
100


statement ok
DROP INDEX notes_local;


statement ok
DROP TABLE notes;


statement ok
DROP TABLESPACE mixaz_local_${__DATABASE__};


statement ok
DROP TEXT SEARCH DICTIONARY mixaz_words;


statement ok
DROP PERSISTENT SECRET mixaz_a_${__DATABASE__};


statement ok
DROP PERSISTENT SECRET mixaz_b_${__DATABASE__};
