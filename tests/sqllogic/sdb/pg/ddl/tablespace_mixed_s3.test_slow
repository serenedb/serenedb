control substitution on

# Object-store and local tablespaces side by side in one database, and two
# object-store tablespaces under different prefixes, each reached with the
# secret whose scope covers it.

statement ok
CREATE OR REPLACE PERSISTENT SECRET mix_a_${__DATABASE__} (
  TYPE s3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/${__DATABASE__}_mix_a'
);


statement ok
CREATE OR REPLACE PERSISTENT SECRET mix_b_${__DATABASE__} (
  TYPE s3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/${__DATABASE__}_mix_b'
);


statement ok
CREATE TABLESPACE mix_a_${__DATABASE__} LOCATION 's3://${MINIO_BUCKET}/${__DATABASE__}_mix_a';


statement ok
CREATE TABLESPACE mix_b_${__DATABASE__} LOCATION 's3://${MINIO_BUCKET}//${__DATABASE__}_mix_b//';


statement ok
CREATE TABLESPACE mix_local_${__DATABASE__} LOCATION '${__TEST_DIR__}/mix/local';


query
SELECT pg_tablespace_location(oid) = 's3://${MINIO_BUCKET}/${__DATABASE__}_mix_b' AS normalized
FROM pg_tablespace WHERE spcname = 'mix_b_${__DATABASE__}';
----
normalized
t


statement ok
CREATE TEXT SEARCH DICTIONARY mix_words AS split_text(case := 'lower') WITH (frequency, position, norm);


statement ok
CREATE TABLE remote_docs (id INT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0)
  TABLESPACE mix_a_${__DATABASE__};


statement ok
CREATE TABLE local_docs (id INT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0)
  TABLESPACE mix_local_${__DATABASE__};


statement ok
CREATE TABLE notes (id INT, body TEXT);


statement ok
CREATE INDEX notes_remote ON notes USING inverted(body mix_words)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)') TABLESPACE mix_b_${__DATABASE__};


statement ok
CREATE INDEX notes_local ON notes USING inverted(body mix_words) TABLESPACE mix_local_${__DATABASE__};


statement ok
INSERT INTO remote_docs SELECT i, 'remote fox number ' || i FROM range(1, 51) t(i);


statement ok
INSERT INTO local_docs SELECT i, 'local dog number ' || i FROM range(1, 51) t(i);


statement ok
INSERT INTO notes SELECT i, CASE WHEN i % 4 = 0 THEN 'red fox at dawn' ELSE 'blue whale at sea' END
FROM range(1, 201) t(i);


statement ok
VACUUM (REFRESH_TABLE) remote_docs;


statement ok
VACUUM (REFRESH_TABLE) local_docs;


statement ok
VACUUM (REFRESH_TABLE) notes;


statement ok
INSERT INTO remote_docs SELECT i, 'remote fox number ' || i FROM range(51, 101) t(i);


statement ok
VACUUM (REFRESH_TABLE) remote_docs;


query
SELECT c.relname, replace(t.spcname, '_${__DATABASE__}', '') AS tablespace
FROM pg_class c JOIN pg_tablespace t ON t.oid = c.reltablespace
WHERE c.relname IN ('remote_docs', 'local_docs', 'notes_remote', 'notes_local') ORDER BY c.relname;
----
relname	tablespace
local_docs	mix_local
notes_local	mix_local
notes_remote	mix_b
remote_docs	mix_a


query
SELECT count(*) AS joined, min(r.body) AS first_remote, min(l.body) AS first_local
FROM remote_docs r JOIN local_docs l USING (id);
----
joined	first_remote	first_local
50	remote fox number 1	local dog number 1


query
SELECT (SELECT count(*) FROM notes_remote WHERE body @@ ts_phrase('red fox')) AS remote_foxes,
       (SELECT count(*) FROM notes_local WHERE body @@ ts_phrase('red fox')) AS local_foxes;
----
remote_foxes	local_foxes
50	50


query
SELECT count(*) AS top FROM (
  SELECT id FROM notes_remote WHERE body @@ ts_phrase('whale')
  ORDER BY BM25(notes_remote.tableoid) DESC LIMIT 10
);
----
top
10


statement ok
VACUUM (COMPACT_TABLE) remote_docs;


statement ok
DELETE FROM remote_docs WHERE id > 90;


statement ok
VACUUM (REFRESH_TABLE) remote_docs;


query
SELECT count(*) AS rows, max(id) AS last FROM remote_docs;
----
rows	last
90	90


query
SELECT (SELECT count(*) > 0 FROM glob('s3://${MINIO_BUCKET}/${__DATABASE__}_mix_a/engine_v1/*/*/*')) AS a_files,
       (SELECT count(*) > 0 FROM glob('s3://${MINIO_BUCKET}/${__DATABASE__}_mix_b/engine_v1/*/*/*')) AS b_files,
       (SELECT count(*) > 0 FROM glob('${__TEST_DIR__}/mix/local/engine_v1/*/*/*')) AS local_files;
----
a_files	b_files	local_files
t	t	t


query
SELECT replace(spcname, '_${__DATABASE__}', '') AS tablespace, pg_tablespace_size(spcname) > 0 AS holds_files
FROM pg_tablespace WHERE spcname IN ('mix_a_${__DATABASE__}', 'mix_b_${__DATABASE__}', 'mix_local_${__DATABASE__}')
ORDER BY spcname;
----
tablespace	holds_files
mix_a	t
mix_b	t
mix_local	t


statement ok
CREATE DATABASE mixdb_${__DATABASE__} TABLESPACE mix_a_${__DATABASE__};


query
SELECT t.spcname = 'mix_a_${__DATABASE__}' AS placed
FROM pg_database d JOIN pg_tablespace t ON t.oid = d.dattablespace WHERE d.datname = 'mixdb_${__DATABASE__}';
----
placed
t


query
SELECT count(*) AS database_files_on_s3 FROM glob('s3://${MINIO_BUCKET}/${__DATABASE__}_mix_a/engine_v1/*/data.db*');
----
database_files_on_s3
0


statement error
DROP TABLESPACE mix_a_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
DROP DATABASE mixdb_${__DATABASE__};


statement ok
DROP INDEX notes_remote;


statement ok
DROP TABLESPACE mix_b_${__DATABASE__};


query ok retry 40 backoff 250ms
SELECT count(*) AS left_in_b FROM glob('s3://${MINIO_BUCKET}/${__DATABASE__}_mix_b/engine_v1/**');
----
left_in_b
0


query
SELECT count(*) AS local_foxes FROM notes_local WHERE body @@ ts_phrase('fox');
----
local_foxes
50


