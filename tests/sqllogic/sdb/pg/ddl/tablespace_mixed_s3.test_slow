DROP TABLE remote_docs;


statement ok
DROP TABLESPACE mix_a_${__DATABASE__};


query ok retry 40 backoff 250ms
SELECT count(*) AS left_in_a FROM glob('s3://${MINIO_BUCKET}/${__DATABASE__}_mix_a/engine_v1/**');
----
left_in_a
0


statement ok
DROP INDEX notes_local;


statement ok
DROP TABLE notes;


statement ok
DROP TABLE local_docs;


statement ok
DROP TABLESPACE mix_local_${__DATABASE__};


statement ok
DROP TEXT SEARCH DICTIONARY mix_words;


