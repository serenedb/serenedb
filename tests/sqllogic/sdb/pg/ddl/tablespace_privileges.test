control substitution on

# Who may place objects in a tablespace, who may pass that on, and who may
# change the tablespace itself.

statement ok
CREATE TABLESPACE priv_ts_${__DATABASE__} LOCATION '${__TEST_DIR__}/priv/ts';

statement ok
CREATE ROLE priv_group_${__DATABASE__};

statement ok
CREATE ROLE priv_member_${__DATABASE__};

statement ok
CREATE ROLE priv_other_${__DATABASE__};

statement ok
CREATE ROLE priv_third_${__DATABASE__};

statement ok
GRANT priv_group_${__DATABASE__} TO priv_member_${__DATABASE__};

statement ok
GRANT ALL ON SCHEMA public TO priv_group_${__DATABASE__};

statement ok
GRANT ALL ON SCHEMA public TO priv_other_${__DATABASE__};

statement ok
GRANT CREATE ON TABLESPACE priv_ts_${__DATABASE__} TO priv_group_${__DATABASE__};

query
SELECT has_tablespace_privilege('priv_member_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS member,
       has_tablespace_privilege('priv_member_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'create') AS lowercase,
       has_tablespace_privilege('priv_other_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS other;
----
member	lowercase	other
t	t	f

query
SELECT has_tablespace_privilege('priv_member_${__DATABASE__}', oid, 'CREATE') AS member,
       has_tablespace_privilege('priv_other_${__DATABASE__}', oid, 'CREATE') AS other,
       has_tablespace_privilege('priv_member_${__DATABASE__}', 4294967295, 'CREATE') AS missing,
       pg_tablespace_location(4294967295) AS no_location
FROM pg_tablespace WHERE spcname = 'priv_ts_${__DATABASE__}';
----
member	other	missing	no_location
t	f	NULL	NULL

statement ok
SET ROLE priv_member_${__DATABASE__};

statement ok
CREATE TABLE member_docs (id INT) WITH (storage = 'search') TABLESPACE priv_ts_${__DATABASE__};

query
SELECT has_tablespace_privilege('priv_ts_${__DATABASE__}', 'CREATE') AS current_role_can;
----
current_role_can
t

statement ok
RESET ROLE;

statement ok
SET ROLE priv_other_${__DATABASE__};

statement error
CREATE TABLE other_docs (id INT) WITH (storage = 'search') TABLESPACE priv_ts_${__DATABASE__};
----
db error: ERROR: permission denied for tablespace <slt:ignore>


statement ok
CREATE TABLE other_docs (id INT) WITH (storage = 'search');

statement ok
RESET ROLE;

statement ok
GRANT CREATE ON TABLESPACE priv_ts_${__DATABASE__} TO priv_other_${__DATABASE__} WITH GRANT OPTION;

query
SELECT has_tablespace_privilege('priv_other_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE WITH GRANT OPTION') AS other_grantable,
       has_tablespace_privilege('priv_member_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE WITH GRANT OPTION') AS member_grantable;
----
other_grantable	member_grantable
t	f

statement ok
SET ROLE priv_other_${__DATABASE__};

statement ok
GRANT CREATE ON TABLESPACE priv_ts_${__DATABASE__} TO priv_third_${__DATABASE__};

statement ok
RESET ROLE;

query
SELECT replace(array_to_string(spcacl, ','), '_${__DATABASE__}', '') AS acl
FROM pg_tablespace WHERE spcname = 'priv_ts_${__DATABASE__}';
----
acl
postgres=C/postgres,priv_group=C/postgres,priv_other=C*/postgres,priv_third=C/priv_other

statement error
REVOKE GRANT OPTION FOR CREATE ON TABLESPACE priv_ts_${__DATABASE__} FROM priv_other_${__DATABASE__};
----
db error: ERROR: dependent privileges exist


statement error
REVOKE CREATE ON TABLESPACE priv_ts_${__DATABASE__} FROM priv_other_${__DATABASE__};
----
db error: ERROR: dependent privileges exist


statement ok
REVOKE CREATE ON TABLESPACE priv_ts_${__DATABASE__} FROM priv_other_${__DATABASE__} CASCADE;

query
SELECT has_tablespace_privilege('priv_other_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS other,
       has_tablespace_privilege('priv_third_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS third;
----
other	third
f	f

statement ok
GRANT CREATE ON TABLESPACE priv_ts_${__DATABASE__} TO PUBLIC;

query
SELECT has_tablespace_privilege('priv_third_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS through_public;
----
through_public
t

statement ok
REVOKE CREATE ON TABLESPACE priv_ts_${__DATABASE__} FROM PUBLIC;

statement ok
REVOKE CREATE ON TABLESPACE priv_ts_${__DATABASE__} FROM priv_group_${__DATABASE__};

query
SELECT has_tablespace_privilege('priv_member_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS member_after_revoke,
       has_tablespace_privilege('priv_third_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'CREATE') AS third_after_revoke;
----
member_after_revoke	third_after_revoke
f	f

statement ok
SET ROLE priv_member_${__DATABASE__};

statement error
CREATE TABLE member_docs_2 (id INT) WITH (storage = 'search') TABLESPACE priv_ts_${__DATABASE__};
----
db error: ERROR: permission denied for tablespace <slt:ignore>


statement ok
RESET ROLE;

query
SELECT count(*) AS member_docs_kept FROM member_docs;
----
member_docs_kept
0

statement error
SELECT has_tablespace_privilege('priv_member_${__DATABASE__}', 'priv_ts_${__DATABASE__}', 'USAGE');
----
db error: ERROR: unrecognized privilege type: "USAGE"


statement error
SELECT has_tablespace_privilege('priv_member_${__DATABASE__}', 'missing_${__DATABASE__}', 'CREATE');
----
db error: ERROR: tablespace "<slt:ignore>" does not exist


query
SELECT has_tablespace_privilege('priv_member_${__DATABASE__}', 'pg_default', 'CREATE') AS member_on_default,
       has_tablespace_privilege('priv_member_${__DATABASE__}', 'pg_global', 'CREATE') AS member_on_global,
       has_tablespace_privilege('pg_default', 'CREATE') AS superuser_on_default;
----
member_on_default	member_on_global	superuser_on_default
f	f	t

statement ok
ALTER TABLESPACE priv_ts_${__DATABASE__} OWNER TO priv_other_${__DATABASE__};

statement ok
SET ROLE priv_other_${__DATABASE__};

query
SELECT has_tablespace_privilege('priv_ts_${__DATABASE__}', 'CREATE WITH GRANT OPTION') AS owner_grantable;
----
owner_grantable
t

statement ok
CREATE TABLE owner_docs (id INT) WITH (storage = 'search') TABLESPACE priv_ts_${__DATABASE__};

statement ok
ALTER TABLESPACE priv_ts_${__DATABASE__} RENAME TO priv_renamed_${__DATABASE__};

statement ok
GRANT CREATE ON TABLESPACE priv_renamed_${__DATABASE__} TO priv_third_${__DATABASE__};

statement error
CREATE TABLESPACE priv_by_owner_${__DATABASE__} LOCATION '${__TEST_DIR__}/priv/by_owner';
----
db error: ERROR: permission denied to create tablespace "<slt:ignore>"
HINT: Must be superuser to create a tablespace.


statement error
DROP TABLESPACE priv_renamed_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
RESET ROLE;

statement ok
DROP TABLE member_docs;

statement ok
DROP TABLE owner_docs;

statement ok
REVOKE CREATE ON TABLESPACE priv_renamed_${__DATABASE__} FROM priv_third_${__DATABASE__};

statement ok
DROP TABLE other_docs;

statement ok
REVOKE ALL ON SCHEMA public FROM priv_other_${__DATABASE__};

statement error
DROP ROLE priv_other_${__DATABASE__};
----
db error: ERROR: Cannot drop entry "<slt:ignore>" because there are entries that depend on it.
tablespace "<slt:ignore>" depends on role "<slt:ignore>".
Use DROP...CASCADE to drop all dependents.


statement ok
SET ROLE priv_other_${__DATABASE__};

statement ok
DROP TABLESPACE priv_renamed_${__DATABASE__};

statement ok
RESET ROLE;

query
SELECT count(*) AS left FROM pg_tablespace WHERE spcname LIKE 'priv_%${__DATABASE__}';
----
left
0

statement ok
REVOKE ALL ON SCHEMA public FROM priv_group_${__DATABASE__};

statement ok
DROP ROLE priv_third_${__DATABASE__};

statement ok
DROP ROLE priv_other_${__DATABASE__};

statement ok
DROP ROLE priv_member_${__DATABASE__};

statement ok
DROP ROLE priv_group_${__DATABASE__};
