control substitution on

# Objects placed in a tablespace by a transaction that rolls back leave no
# files and do not hold the tablespace, a rolled-back drop keeps its object,
# and a cascade empties the tablespaces its objects lived in.

statement ok
CREATE TABLESPACE tx_ts_${__DATABASE__} LOCATION '${__TEST_DIR__}/tx/ts';

statement ok
CREATE TABLESPACE tx_other_${__DATABASE__} LOCATION '${__TEST_DIR__}/tx/other';

statement ok
CREATE TEXT SEARCH DICTIONARY tx_words AS split_text(case := 'lower');

statement ok
CREATE TABLE plain (id INT, body TEXT);

statement ok
INSERT INTO plain VALUES (1, 'kept fox'), (2, 'kept dog');

statement ok
BEGIN;

statement ok
CREATE TABLE rolled_back (id INT, body TEXT) WITH (storage = 'search') TABLESPACE tx_ts_${__DATABASE__};

statement ok
INSERT INTO rolled_back VALUES (1, 'never committed');

statement ok
CREATE INDEX rolled_back_index ON plain USING inverted(body tx_words) TABLESPACE tx_other_${__DATABASE__};

statement ok
ROLLBACK;

query
SELECT count(*) AS left FROM pg_class WHERE relname IN ('rolled_back', 'rolled_back_index');
----
left
0

query ok retry 240 backoff 250ms
SELECT (SELECT count(*) FROM glob('${__TEST_DIR__}/tx/ts/engine_v1/**')) AS ts_files,
       (SELECT count(*) FROM glob('${__TEST_DIR__}/tx/other/engine_v1/**')) AS other_files;
----
ts_files	other_files
0	0

statement ok
DROP TABLESPACE tx_other_${__DATABASE__};

statement ok retry 240 backoff 250ms
CREATE TABLESPACE tx_other_${__DATABASE__} LOCATION '${__TEST_DIR__}/tx/other';

statement ok
BEGIN;

statement ok
CREATE TABLE committed (id INT, body TEXT) WITH (storage = 'search') TABLESPACE tx_ts_${__DATABASE__};

statement ok
INSERT INTO committed VALUES (1, 'committed fox'), (2, 'committed dog');

statement ok
COMMIT;

statement ok
VACUUM (REFRESH_TABLE) committed;

statement ok
BEGIN;

statement ok
DROP TABLE committed;

statement ok
ROLLBACK;

query
SELECT id, body FROM committed ORDER BY id;
----
id	body
1	committed fox
2	committed dog

statement error
DROP TABLESPACE tx_ts_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
CREATE SCHEMA tx_schema;

statement ok
CREATE TABLE tx_schema.inside (id INT, body TEXT) WITH (storage = 'search') TABLESPACE tx_other_${__DATABASE__};

statement ok
CREATE TABLE tx_schema.plain_inside (id INT, body TEXT);

statement ok
CREATE INDEX plain_inside_body ON tx_schema.plain_inside USING inverted(body tx_words) TABLESPACE tx_other_${__DATABASE__};

statement ok
INSERT INTO tx_schema.inside VALUES (1, 'in the schema');

statement ok
VACUUM (REFRESH_TABLE) tx_schema.inside;

query
SELECT count(*) > 0 AS other_files FROM glob('${__TEST_DIR__}/tx/other/engine_v1/*/*/*');
----
other_files
t

statement error
DROP TABLESPACE tx_other_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
DROP SCHEMA tx_schema CASCADE;

statement ok
DROP TABLESPACE tx_other_${__DATABASE__};

query ok retry 240 backoff 250ms
SELECT count(*) AS other_files FROM glob('${__TEST_DIR__}/tx/other/**');
----
other_files
0

statement ok
CREATE TABLE indexed (id INT, body TEXT);

statement ok
CREATE INDEX indexed_body ON indexed USING inverted(body tx_words) TABLESPACE tx_ts_${__DATABASE__};

statement ok
DROP TABLE committed;

statement error
DROP TABLESPACE tx_ts_${__DATABASE__};
----
db error: ERROR: tablespace "<slt:ignore>" is not empty


statement ok
DROP TABLE indexed;

statement ok
DROP TABLESPACE tx_ts_${__DATABASE__};

query ok retry 240 backoff 250ms
SELECT count(*) AS ts_files FROM glob('${__TEST_DIR__}/tx/ts/**');
----
ts_files
0

statement ok
DROP TABLE plain;

statement ok
DROP TEXT SEARCH DICTIONARY tx_words;
