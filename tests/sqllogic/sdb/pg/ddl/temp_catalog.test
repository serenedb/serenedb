# Temporary objects follow the rules of every other schema: one namespace for
# relations, names matched as written once unquoted ones are folded, the same
# table options, and only temporary objects in temp.

statement ok
CREATE TEMP TABLE temp_rel (a INT, b TEXT);


statement error
CREATE TEMP SEQUENCE temp_rel;
----
db error: ERROR: relation "temp_rel" already exists


statement error
CREATE TEMP VIEW temp_rel AS SELECT 1 AS x;
----
db error: ERROR: relation "temp_rel" already exists


statement error
CREATE INDEX temp_rel ON temp_rel (a);
----
db error: ERROR: relation "temp_rel" already exists


statement ok
CREATE TEMP TABLE "TempMixed" (a INT);


statement ok
CREATE TEMP TABLE TempFolded (a INT);


statement ok
INSERT INTO "TempMixed" VALUES (1);


statement ok
INSERT INTO tempfolded VALUES (2);


query
SELECT (SELECT sum(a) FROM "TempMixed") AS mixed, (SELECT sum(a) FROM TEMPFOLDED) AS folded;
----
mixed	folded
1	2


statement error
SELECT * FROM tempmixed;
----
db error: ERROR: Table with name tempmixed does not exist!
Did you mean "TempMixed"?


statement ok
CREATE TEMP SEQUENCE temp_rel_seq;


statement error
CREATE TEMP TABLE temp_rel_seq (a INT);
----
db error: ERROR: relation "temp_rel_seq" already exists


statement ok
CREATE TEMP TABLE temp_partitioned (a INT, b TEXT) PARTITIONED BY (a);


statement ok
CREATE TEMP TABLE temp_sorted (a INT, b TEXT) SORTED BY (a);


statement ok
CREATE TEMP TABLE temp_option (a INT) WITH (compaction_interval = 0);


statement error
CREATE TEMP TABLE temp_unknown_option (a INT) WITH (fillfactor = 10);
----
db error: ERROR: unrecognized parameter "fillfactor"


statement ok
INSERT INTO temp_partitioned VALUES (2, 'two'), (1, 'one');


statement ok
INSERT INTO temp_sorted VALUES (2, 'two'), (1, 'one');


query
SELECT (SELECT sum(a) FROM temp_partitioned) AS partitioned,
       (SELECT string_agg(b, ',' ORDER BY a) FROM temp_sorted) AS sorted;
----
partitioned	sorted
3	one,two


statement error
