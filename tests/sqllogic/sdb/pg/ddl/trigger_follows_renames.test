CREATE TABLE tfr_s (id INT, v INT);


statement ok
CREATE TABLE tfr_sum (n BIGINT);


statement ok
CREATE TRIGGER tfr_stmt AFTER INSERT ON tfr_s
  REFERENCING NEW TABLE AS nt FOR EACH STATEMENT
  INSERT INTO tfr_sum SELECT sum(v) FROM nt;


statement ok
ALTER TABLE tfr_s RENAME COLUMN v TO w;


statement ok
INSERT INTO tfr_s VALUES (1, 2), (2, 3);


query
SELECT n FROM tfr_sum;
----
n
