query
SELECT table_name, trigger_name, sql FROM sdb_triggers()
WHERE trigger_name IN ('tfr_row', 'tfr_cols', 'tfr_join')
ORDER BY trigger_name;
----
table_name	trigger_name	sql
tfr_t2	tfr_cols	CREATE TRIGGER tfr_cols AFTER DELETE ON tfr_t2 FOR EACH ROW INSERT INTO tfr_b (y2) (VALUES ("old".id));
tfr_t2	tfr_join	CREATE TRIGGER tfr_join AFTER INSERT ON tfr_t2 FOR EACH ROW INSERT INTO tfr_log SELECT k2 AS k FROM tfr_k WHERE (tfr_k.id = "new".id);
tfr_t2	tfr_row	CREATE TRIGGER tfr_row AFTER INSERT ON tfr_t2 FOR EACH ROW INSERT INTO tfr_a2 (VALUES ("new".w));


