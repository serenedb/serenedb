query
SELECT trigger_name, sql FROM duckdb_triggers()
WHERE trigger_name IN ('tfd_upd', 'tfd_ups', 'tfd_del')
ORDER BY trigger_name;
----
trigger_name	sql
tfd_del	CREATE TRIGGER tfd_del AFTER INSERT ON tfd_ev FOR EACH STATEMENT DELETE FROM tfd_log USING tfd_kk WHERE ((tfd_kk.id = tfd_log.id) AND (tfd_log.amount > tfd_kk.step)) RETURNING amount;
tfd_upd	CREATE TRIGGER tfd_upd AFTER INSERT ON tfd_ev FOR EACH STATEMENT UPDATE tfd_cnt SET total = (tfd_cnt.total + kk.step) FROM tfd_kk AS kk WHERE (kk.id = tfd_cnt.id) RETURNING total;
tfd_ups	CREATE TRIGGER tfd_ups AFTER INSERT ON tfd_ev FOR EACH STATEMENT INSERT INTO tfd_up SELECT id, step AS inc FROM tfd_kk ON CONFLICT (key ) DO UPDATE SET acc = (tfd_up.acc + excluded.acc) WHERE (tfd_up.acc < 1000) RETURNING acc;


