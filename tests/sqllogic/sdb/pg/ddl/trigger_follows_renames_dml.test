query
SELECT trigger_name, sql FROM duckdb_triggers() WHERE trigger_name IN ('tfd_jupd', 'tfd_jdel') ORDER BY trigger_name;
----
trigger_name	sql
tfd_jdel	CREATE TRIGGER tfd_jdel AFTER INSERT ON tfd_jev FOR EACH STATEMENT DELETE FROM tfd_jlog USING (tfd_ja INNER JOIN tfd_jb ON ((tfd_ja.k2 = tfd_jb.k))) WHERE ((tfd_jb.id = tfd_jlog.id) AND (tfd_jlog.amount = 0));
tfd_jupd	CREATE TRIGGER tfd_jupd AFTER INSERT ON tfd_jev FOR EACH STATEMENT UPDATE tfd_jlog SET amount = 1 FROM (tfd_ja INNER JOIN tfd_jb ON ((tfd_ja.k2 = tfd_jb.k))) WHERE (tfd_ja.id = tfd_jlog.id);


