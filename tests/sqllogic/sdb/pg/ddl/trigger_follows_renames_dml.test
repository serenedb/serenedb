CREATE TABLE tfd_up (id INT PRIMARY KEY, n INT);


statement ok
CREATE TABLE tfd_log (id INT, n INT);


statement ok
CREATE TRIGGER tfd_upd AFTER INSERT ON tfd_ev FOR EACH STATEMENT
  UPDATE tfd_cnt SET cnt = tfd_cnt.cnt + kk.inc FROM tfd_kk kk WHERE kk.id = tfd_cnt.id RETURNING cnt;


statement ok
CREATE TRIGGER tfd_ups AFTER INSERT ON tfd_ev FOR EACH STATEMENT
  INSERT INTO tfd_up SELECT id, inc FROM tfd_kk
  ON CONFLICT (id) DO UPDATE SET n = tfd_up.n + excluded.n WHERE tfd_up.n < 1000 RETURNING n;


statement ok
CREATE TRIGGER tfd_del AFTER INSERT ON tfd_ev FOR EACH STATEMENT
  DELETE FROM tfd_log USING tfd_kk WHERE tfd_kk.id = tfd_log.id AND tfd_log.n > tfd_kk.inc RETURNING n;


