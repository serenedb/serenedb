# A single transaction may write to only one database. Each serenedb database
# owns the duckdb file its rows live in, so this covers two serenedb databases
# as well as a serenedb database and an attached duckdb one. There is no
# two-phase commit across attachments, so the alternative would be a
# transaction whose halves can land separately -- PostgreSQL refuses the shape
# outright (a session reaches exactly one database), and refusing the write is
# the closest we get while still allowing cross-database reads.
#
# Cluster-global objects -- roles, the database list -- stay exempt: they live
# in a storage-less attachment that forwards its writes, so CREATE ROLE beside
# a table write is still one writable database.

control substitution on


statement ok
CREATE TABLE local_t(x INTEGER);


statement ok
ATTACH '${__TEST_DIR__}/db71.duckdb' AS db71;


statement ok
CREATE TABLE db71.main.ext_t(x INTEGER);


# serenedb table then attached duckdb in one transaction -> rejected
statement ok
BEGIN;


statement ok
INSERT INTO local_t VALUES (1);


statement error
INSERT INTO db71.main.ext_t VALUES (1);
----
db error: ERROR: Attempting to write to database "<slt:ignore>" in a transaction that has already modified database "<slt:ignore>" - a single transaction can only write to a single attached database.


statement ok
ROLLBACK;


# both sides rolled back
query
SELECT count(*) FROM local_t;
----
count
0


query
SELECT count(*) FROM db71.main.ext_t;
----
count
0


# the symmetric order is rejected too: attached duckdb then serenedb table
statement ok
BEGIN;


statement ok
INSERT INTO db71.main.ext_t VALUES (2);


statement error
INSERT INTO local_t VALUES (2);
----
db error: ERROR: Attempting to write to database "<slt:ignore>" in a transaction that has already modified database "<slt:ignore>" - a single transaction can only write to a single attached database.


statement ok
ROLLBACK;


# writing only one database per transaction is fine
statement ok
INSERT INTO local_t VALUES (3);


statement ok
INSERT INTO db71.main.ext_t VALUES (3);


query
SELECT count(*) FROM local_t;
----
count
1


query
SELECT count(*) FROM db71.main.ext_t;
----
count
1


statement ok
DETACH db71;


# two serenedb databases in one transaction are rejected the same way, on both
# the data and the definition side
statement ok
CREATE DATABASE cdw_other;


statement ok
CREATE TABLE cdw_other.public.other_t(x INTEGER);


statement ok
BEGIN;


statement ok
INSERT INTO local_t VALUES (4);


statement error
INSERT INTO cdw_other.public.other_t VALUES (4);
----
db error: ERROR: Attempting to write to database "<slt:ignore>" in a transaction that has already modified database "<slt:ignore>" - a single transaction can only write to a single attached database.


statement ok
ROLLBACK;


statement ok
BEGIN;


statement ok
CREATE TABLE cdw_ddl_t(x INTEGER);


statement error
CREATE TABLE cdw_other.public.other_ddl_t(x INTEGER);
----
db error: ERROR: Attempting to write to database "<slt:ignore>" in a transaction that has already modified database "<slt:ignore>" - a single transaction can only write to a single attached database.


statement ok
ROLLBACK;


# reading the other database in the same transaction stays legal
statement ok
BEGIN;


statement ok
INSERT INTO local_t VALUES (5);


query
SELECT count(*) FROM cdw_other.public.other_t;
----
count
0


statement ok
ROLLBACK;


statement ok
DROP DATABASE cdw_other;


statement ok
DROP TABLE local_t;


statement ok
DETACH IF EXISTS db71;
