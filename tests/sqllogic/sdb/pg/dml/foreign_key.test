# FOREIGN KEY constraints: enforcement on insert/delete, the unsupported
# referential-action error, and the same with an inverted index on the child.

statement ok
CREATE TABLE fk_parent(id INTEGER PRIMARY KEY, label TEXT);

statement ok
CREATE TABLE fk_child(id INTEGER PRIMARY KEY, p INTEGER REFERENCES fk_parent(id));

statement count 2
INSERT INTO fk_parent VALUES (1, 'one'), (2, 'two');

statement count 1
INSERT INTO fk_child VALUES (10, 1);

# Inserting a child row referencing a missing parent key is rejected.
statement error
INSERT INTO fk_child VALUES (11, 99);
----
db error: ERROR: insert or update on table "fk_child" violates foreign key constraint "fk_child_p_fkey"
DETAIL: Key (p)=(99) is not present in table "fk_parent".


# Deleting a still-referenced parent is rejected (default NO ACTION).
statement error
DELETE FROM fk_parent WHERE id = 1;
----
db error: ERROR: update or delete on table "fk_parent" violates foreign key constraint "fk_child_p_fkey" on table "fk_child"
DETAIL: Key (id)=(1) is still referenced from table "fk_child".


# Changing a referenced key is rejected; changing another column is not.
statement error
UPDATE fk_parent SET id = 5 WHERE id = 1;
----
db error: ERROR: update or delete on table "fk_parent" violates foreign key constraint "fk_child_p_fkey" on table "fk_child"
DETAIL: Key (id)=(1) is still referenced from table "fk_child".


statement count 1
UPDATE fk_parent SET label = 'uno' WHERE id = 1;

statement error
TRUNCATE fk_parent;
----
db error: ERROR: cannot truncate a table referenced in a foreign key constraint
DETAIL: Table "fk_child" references "fk_parent".
HINT: Truncate table "fk_child" at the same time, or use TRUNCATE ... CASCADE.


# A parent row and the child referencing it inserted in one transaction; the
# delete of that parent row in the same transaction is refused.
statement ok
BEGIN

statement ok
INSERT INTO fk_parent VALUES (3, 'three')

statement ok
INSERT INTO fk_child VALUES (13, 3)

statement error
DELETE FROM fk_parent WHERE id = 3
----
db error: ERROR: update or delete on table "fk_parent" violates foreign key constraint "fk_child_p_fkey" on table "fk_child"
DETAIL: Key (id)=(3) is still referenced from table "fk_child".


statement ok
ROLLBACK


# An unreferenced parent deletes fine.
statement count 1
DELETE FROM fk_parent WHERE id = 2;

# NULL child reference is allowed (no parent required).
statement count 1
INSERT INTO fk_child VALUES (12, NULL);

statement ok
DROP TABLE fk_child;

# Dropping the child takes the back-reference off the parent: the row that was
# referenced a moment ago now deletes.
statement count 1
DELETE FROM fk_parent WHERE id = 1;

statement ok
DROP TABLE fk_parent;


# Referential actions (CASCADE / SET NULL / SET DEFAULT) are not supported.
statement ok
CREATE TABLE fk_p2(id INTEGER PRIMARY KEY);

statement error
CREATE TABLE fk_c2(id INTEGER PRIMARY KEY, p INTEGER REFERENCES fk_p2(id) ON DELETE CASCADE);
----
db error: ERROR: FOREIGN KEY constraints cannot use CASCADE, SET NULL or SET DEFAULT


statement ok
DROP TABLE fk_p2;


# FK enforcement with an inverted index on the child table -- the index feeds
# at commit and must not interfere with constraint checking.

statement ok
CREATE TEXT SEARCH DICTIONARY fk_dict AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE TABLE fk_parent_i(id INTEGER PRIMARY KEY);

statement ok
CREATE TABLE fk_child_i(id INTEGER PRIMARY KEY, p INTEGER REFERENCES fk_parent_i(id), body TEXT);

statement ok
CREATE INDEX fk_child_i_inv ON fk_child_i USING inverted(body fk_dict);

statement count 1
INSERT INTO fk_parent_i VALUES (1);

statement count 1
INSERT INTO fk_child_i VALUES (10, 1, 'valid child row');

# Rejected: missing parent key. The index must not have picked up the row.
statement error
INSERT INTO fk_child_i VALUES (11, 77, 'orphan child row');
----
db error: ERROR: insert or update on table "fk_child_i" violates foreign key constraint "fk_child_i_p_fkey"
DETAIL: Key (p)=(77) is not present in table "fk_parent_i".


statement ok
VACUUM (REFRESH_TABLE) fk_child_i;

query
SELECT id FROM fk_child_i_inv WHERE body @@ ts_phrase('valid child');
----
id
10

# The rejected row's terms are absent from the index.
query
SELECT id FROM fk_child_i_inv WHERE body @@ ts_phrase('orphan child');
----
id

statement ok
DROP TABLE fk_child_i;

statement ok
DROP TABLE fk_parent_i;

# Self-referencing FOREIGN KEY: checked at the end of the statement, so rows of
# one INSERT may reference each other.
statement ok
CREATE TABLE fk_self (id INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES fk_self (id));

statement ok
INSERT INTO fk_self VALUES (1, NULL);

statement ok
INSERT INTO fk_self VALUES (2, 1);

statement error
INSERT INTO fk_self VALUES (3, 99);
----
db error: ERROR: insert or update on table "fk_self" violates foreign key constraint "fk_self_parent_fkey"
DETAIL: Key (parent)=(99) is not present in table "fk_self".


statement ok
INSERT INTO fk_self VALUES (5, 6), (6, 5);

statement error
DELETE FROM fk_self WHERE id = 1;
----
db error: ERROR: update or delete on table "fk_self" violates foreign key constraint "fk_self_parent_fkey" on table "fk_self"
DETAIL: Key (id)=(1) is still referenced from table "fk_self".


statement ok
DELETE FROM fk_self WHERE id IN (5, 6);

query
SELECT id, parent FROM fk_self ORDER BY id;
----
id	parent
1	NULL
2	1

statement ok
DROP TABLE fk_self;

# A FOREIGN KEY may reference a UNIQUE (non-PK) column, not only the PRIMARY KEY
# (matches PG and native duckdb).
statement ok
CREATE TABLE fk_u_parent (id INTEGER UNIQUE, j VARCHAR);

statement ok
INSERT INTO fk_u_parent VALUES (1, 'a');

statement ok
CREATE TABLE fk_u_child (id INTEGER PRIMARY KEY, pid INTEGER, FOREIGN KEY (pid) REFERENCES fk_u_parent (id));

statement error
INSERT INTO fk_u_child VALUES (10, 999);
----
db error: ERROR: insert or update on table "fk_u_child" violates foreign key constraint "fk_u_child_pid_fkey"
DETAIL: Key (pid)=(999) is not present in table "fk_u_parent".


statement ok
INSERT INTO fk_u_child VALUES (11, 1);

statement error
ALTER TABLE fk_u_parent DROP CONSTRAINT fk_u_parent_id_key;
----
db error: ERROR: cannot drop constraint fk_u_parent_id_key on table fk_u_parent because other objects depend on it
DETAIL: constraint fk_u_child_pid_fkey on table fk_u_child depends on index fk_u_parent_id_key
HINT: Use DROP ... CASCADE to drop the dependent objects too.


statement ok
ALTER TABLE fk_u_parent DROP CONSTRAINT fk_u_parent_id_key CASCADE;

statement ok
INSERT INTO fk_u_child VALUES (12, 999);

statement ok
DROP TABLE fk_u_child;

statement ok
DROP TABLE fk_u_parent;

# FOREIGN KEY constraints are reflected in pg_constraint (contype 'f') and
# information_schema, matching a native duckdb table.
statement ok
CREATE TABLE fk_refl_p (a INTEGER PRIMARY KEY);

statement ok
CREATE TABLE fk_refl_c (id INTEGER PRIMARY KEY, pa INTEGER, FOREIGN KEY (pa) REFERENCES fk_refl_p (a));

query
SELECT contype FROM pg_constraint WHERE conrelid = 'fk_refl_c'::regclass AND contype = 'f';
----
contype
f

query
SELECT constraint_type FROM information_schema.table_constraints WHERE table_name = 'fk_refl_c' AND constraint_type = 'FOREIGN KEY';
----
constraint_type
FOREIGN KEY

statement ok
DROP TABLE fk_refl_c;

statement ok
DROP TABLE fk_refl_p;

# ALTER TABLE ADD FOREIGN KEY checks the rows already there, then holds on both
# sides until the constraint is dropped.
statement ok
CREATE TABLE fk_a_p (a INTEGER PRIMARY KEY);

statement ok
INSERT INTO fk_a_p VALUES (1), (2);

statement ok
CREATE TABLE fk_a_c (id INTEGER, pa INTEGER);

statement ok
INSERT INTO fk_a_c VALUES (1, 1), (2, 7);

statement error
ALTER TABLE fk_a_c ADD CONSTRAINT fk_a_c_pa FOREIGN KEY (pa) REFERENCES fk_a_p (a);
----
db error: ERROR: insert or update on table "fk_a_c" violates foreign key constraint "fk_a_c_pa"
DETAIL: Key (pa)=(7) is not present in table "fk_a_p".


statement ok
DELETE FROM fk_a_c WHERE id = 2;

statement ok
ALTER TABLE fk_a_c ADD CONSTRAINT fk_a_c_pa FOREIGN KEY (pa) REFERENCES fk_a_p (a);

statement error
INSERT INTO fk_a_c VALUES (3, 8);
----
db error: ERROR: insert or update on table "fk_a_c" violates foreign key constraint "fk_a_c_pa"
DETAIL: Key (pa)=(8) is not present in table "fk_a_p".


statement error
DELETE FROM fk_a_p WHERE a = 1;
----
db error: ERROR: update or delete on table "fk_a_p" violates foreign key constraint "fk_a_c_pa" on table "fk_a_c"
DETAIL: Key (a)=(1) is still referenced from table "fk_a_c".


statement ok
ALTER TABLE fk_a_c DROP CONSTRAINT fk_a_c_pa;

statement count 1
DELETE FROM fk_a_p WHERE a = 1;

statement ok
DROP TABLE fk_a_c;

statement ok
DROP TABLE fk_a_p;
