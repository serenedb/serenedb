query
SELECT count(*) AS n, count(DISTINCT b) AS branches, sum(k) AS total FROM iuas
----
n	branches	total
40000	20	39980000


query
SELECT max(value) FILTER (WHERE metric = 'num_segments') <= 2 AS few_segments
FROM sdb_metrics WHERE relation_id = 'iuas'::regclass
----
few_segments
