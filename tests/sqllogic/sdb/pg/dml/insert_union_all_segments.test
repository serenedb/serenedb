statement ok
CREATE TABLE iuas (b INT, k BIGINT) WITH (compaction_interval = 0, compaction_floor_segment_bytes = 262144)


statement ok
INSERT INTO iuas
SELECT 1, k FROM range(2000) t(k)
UNION ALL SELECT 2, k FROM range(2000) t(k)
