# A count whose one filter compares a column with its type's default value is
# answered from the blocks' counts of default values; columns with NULLs,
# deleted rows and other constants are counted from the rows.

statement ok
CREATE TABLE scd WITH (storage = 'search') AS
SELECT i,
       i % 3 AS a,
       CASE WHEN i % 4 = 0 THEN '' ELSE 'value-long-enough-' || i END AS s,
       i % 5 = 0 AS b,
       (i % 2)::DOUBLE * 0.5 AS f,
       CASE WHEN i % 7 = 0 THEN NULL ELSE i % 2 END AS n
FROM range(10000) t(i);


statement ok
VACUUM (REFRESH_TABLE) scd;


query
SELECT count(*) AS c FROM scd WHERE a <> 0;
----
c
6666


query
SELECT count(*) AS c FROM scd WHERE a = 0;
----
c
3334


query
SELECT count(*) AS c FROM scd WHERE 0 <> a;
----
c
6666


query
SELECT count(*) AS c FROM scd WHERE a <> 1;
----
c
6667


query
SELECT count(*) AS c FROM scd WHERE s <> '';
----
c
7500


query
SELECT count(*) AS c FROM scd WHERE s = '';
----
c
2500


query
SELECT count(*) AS c FROM scd WHERE b = false;
----
c
8000


query
SELECT count(*) AS c FROM scd WHERE b <> false;
----
c
2000


query
SELECT count(*) AS c FROM scd WHERE f <> 0;
----
c
5000


query
SELECT count(*) AS c FROM scd WHERE f = -0.0;
----
c
5000


query
SELECT count(*) AS c FROM scd WHERE n <> 0;
----
c
4286


query
SELECT count(*) AS c FROM scd WHERE n = 0;
----
c
4285


query
SELECT count(*) AS c FROM scd WHERE a <> 0 AND s <> '';
----
c
5000


statement ok
DELETE FROM scd WHERE i < 100;


statement ok
VACUUM (REFRESH_TABLE) scd;


query
SELECT count(*) AS c FROM scd WHERE a <> 0;
----
c
6600


query
SELECT count(*) AS c FROM scd WHERE s = '';
----
c
2475
