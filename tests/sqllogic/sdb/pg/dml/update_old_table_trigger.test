CREATE TABLE uott_audit (image TEXT, id INT, v INT)

statement ok
CREATE TRIGGER uott_upd AFTER UPDATE ON uott_t
REFERENCING OLD TABLE AS o NEW TABLE AS n
FOR EACH STATEMENT
  INSERT INTO uott_audit SELECT 'old', id, v FROM o UNION ALL SELECT 'new', id, v FROM n

