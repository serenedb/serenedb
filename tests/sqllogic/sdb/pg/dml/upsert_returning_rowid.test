# INSERT ... ON CONFLICT and INSERT OR REPLACE: the rows an upsert leaves, its
# RETURNING rows, and every unique key consistent afterwards.

statement ok
CREATE TABLE u_plain(a INTEGER PRIMARY KEY, b INTEGER);

statement count 1
INSERT INTO u_plain VALUES (1, 10);

# DO UPDATE on a plain column.
statement count 1
INSERT INTO u_plain VALUES (1, 20) ON CONFLICT (a) DO UPDATE SET b = EXCLUDED.b;

query
SELECT a, b FROM u_plain;
----
a	b
1	20

# Same with RETURNING: returns the updated row.
query
INSERT INTO u_plain VALUES (1, 30) ON CONFLICT (a) DO UPDATE SET b = EXCLUDED.b RETURNING a, b;
----
a	b
1	30

query
SELECT a, b FROM u_plain;
----
a	b
1	30

# DO NOTHING: no row touched.
statement count 0
INSERT INTO u_plain VALUES (1, 777) ON CONFLICT (a) DO NOTHING;

query
SELECT a, b FROM u_plain;
----
a	b
1	30

statement ok
DROP TABLE u_plain;


# DO UPDATE on a LIST column.

statement ok
CREATE TABLE u_list(a INTEGER PRIMARY KEY, l INTEGER[]);

statement count 1
INSERT INTO u_list VALUES (1, ARRAY[1, 2, 3]);

query
INSERT INTO u_list VALUES (1, ARRAY[9, 9]) ON CONFLICT (a) DO UPDATE SET l = EXCLUDED.l RETURNING a, l;
----
a	l
1	{9,9}

query
SELECT a, l FROM u_list;
----
a	l
1	{9,9}

statement ok
DROP TABLE u_list;


# DO UPDATE on a column of another UNIQUE key: the new key conflicts, the old
# one is free again.

statement ok
CREATE TABLE u_idx(a INTEGER PRIMARY KEY, b INTEGER UNIQUE);

statement count 2
INSERT INTO u_idx VALUES (1, 10), (2, 20);

statement count 1
INSERT INTO u_idx VALUES (1, 555) ON CONFLICT (a) DO UPDATE SET b = EXCLUDED.b;

query
SELECT a, b FROM u_idx ORDER BY a;
----
a	b
1	555
2	20

statement error
INSERT INTO u_idx VALUES (3, 555);
----
db error: ERROR: duplicate key value violates unique constraint "u_idx_b_key"
DETAIL: Key (b)=(555) already exists.


statement count 1
INSERT INTO u_idx VALUES (3, 10);

query
SELECT a, b FROM u_idx ORDER BY a;
----
a	b
1	555
2	20
3	10

statement ok
DROP TABLE u_idx;


# DO UPDATE rewriting the conflict key itself: the old key is free, the new one
# taken.

statement ok
CREATE TABLE u_pk(a INTEGER PRIMARY KEY, b INTEGER);

statement count 2
INSERT INTO u_pk VALUES (1, 10), (2, 20);

statement count 1
INSERT INTO u_pk VALUES (1, 99) ON CONFLICT (a) DO UPDATE SET a = 100;

query
SELECT a, b FROM u_pk ORDER BY a;
----
a	b
2	20
100	10

statement count 1
INSERT INTO u_pk VALUES (1, 1);

statement count 0
INSERT INTO u_pk VALUES (100, 2) ON CONFLICT (a) DO NOTHING;

query
SELECT a, b FROM u_pk ORDER BY a;
----
a	b
1	1
2	20
100	10

statement ok
DROP TABLE u_pk;


# INSERT OR REPLACE sets every non-key column, also with RETURNING.

statement ok
CREATE TABLE r_plain(a INTEGER PRIMARY KEY, b INTEGER, c INTEGER);

statement count 1
INSERT INTO r_plain VALUES (1, 10, 100);

statement count 1
INSERT OR REPLACE INTO r_plain VALUES (1, 20, 200);

query
SELECT a, b, c FROM r_plain;
----
a	b	c
1	20	200

query
INSERT OR REPLACE INTO r_plain VALUES (1, 30, 300) RETURNING a, b, c;
----
a	b	c
1	30	300

query
SELECT a, b, c FROM r_plain;
----
a	b	c
1	30	300

statement ok
DROP TABLE r_plain;


# With a LIST column among the replaced columns.

statement ok
CREATE TABLE r_list(a INTEGER PRIMARY KEY, b INTEGER, l INTEGER[]);

statement count 1
INSERT INTO r_list VALUES (1, 10, ARRAY[1, 2]);

statement count 1
INSERT OR REPLACE INTO r_list VALUES (1, 20, ARRAY[3, 4, 5]);

query
SELECT a, b, l FROM r_list;
----
a	b	l
1	20	{3,4,5}

statement ok
DROP TABLE r_list;
