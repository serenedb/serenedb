id	title
2996	title-2996-long-enough-to-not-inline
2989	title-2989-long-enough-to-not-inline
2982	title-2982-long-enough-to-not-inline

statement ok
DETACH ljs_local_${__DATABASE__};

statement ok
BEGIN;

statement ok
UPDATE ljs_${__DATABASE__}.ljs.t SET title = 'changed' WHERE id = 7;

query
EXPLAIN SELECT id, title FROM ljs_${__DATABASE__}.ljs.t ORDER BY k, id LIMIT 3;
----
QUERY PLAN
╭─ PROJECTION ──────────────────────╮
│ Projections: #0, #1               │
│ ~0 rows                           │
╰─────────────────┬─────────────────╯
╭─ POSTGRES_SCAN ─┴─────────────────╮
│ Table: t                          │
│ Projections: id, title, k         │
│ Column Filter:                    │
│ optional: Dynamic Filter (k <= ?) │
│ ~0 rows                           │
╰───────────────────────────────────╯

query
SELECT id, title FROM ljs_${__DATABASE__}.ljs.t ORDER BY k, id LIMIT 3;
----
id	title
7	changed
14	title-14-long-enough-to-not-inline
21	title-21-long-enough-to-not-inline

statement ok
ROLLBACK;

statement ok
DROP SCHEMA ljs_${__DATABASE__}.ljs CASCADE;

statement ok
DETACH ljs_rc_${__DATABASE__};

statement ok
DETACH ljs_${__DATABASE__};
