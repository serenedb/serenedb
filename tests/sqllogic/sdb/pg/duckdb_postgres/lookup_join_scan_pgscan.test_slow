│ Projections: id, title, body, k   │
│ Column Filter:                    │
│ optional: Dynamic Filter (k <= ?) │
│ ~0 rows                           │
╰───────────────────────────────────╯

query
SELECT id, title FROM ljs_local_${__DATABASE__}.ljs.t ORDER BY k, id DESC LIMIT 3;
