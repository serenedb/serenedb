control substitution on

# Lookup fetch-back of an array of a custom type (1-D and 2-D), an enum and a
# composite. The lookup types each column the way the attached catalog does, so
# the values match a plain scan, and a composite holding a custom-type field fails
# cleanly, as in the scan.
#
# The remote table is created with postgres_execute because SereneDB's parser has
# no macaddr type.
#
# The attach alias and remote schema carry ${__DATABASE__}: the remote postgres
# is shared and the runner replays this file once per wire engine.

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS pgrt_${__DATABASE__} (TYPE postgres);


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}', 'DROP SCHEMA IF EXISTS s${__DATABASE__}_rt CASCADE');


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}', 'CREATE SCHEMA s${__DATABASE__}_rt');


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}', 'CREATE TYPE s${__DATABASE__}_rt.mood AS ENUM (''sad'', ''happy'')');


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}', 'CREATE TYPE s${__DATABASE__}_rt.pair AS (n int, s text)');


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}', 'CREATE TYPE s${__DATABASE__}_rt.macpair AS (m macaddr, n int)');


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}',
  'CREATE TABLE s${__DATABASE__}_rt.docs (id bigint, macs macaddr[], grid macaddr[][],
     mood s${__DATABASE__}_rt.mood, p s${__DATABASE__}_rt.pair, q s${__DATABASE__}_rt.macpair, body text)');


statement ok
CALL postgres_execute('pgrt_${__DATABASE__}',
  'INSERT INTO s${__DATABASE__}_rt.docs VALUES
     (1, ''{08:00:2b:01:02:01,08:00:2b:01:02:02}'',
         ''{{08:00:2b:01:02:01,08:00:2b:01:02:02},{08:00:2b:01:02:03,08:00:2b:01:02:04}}'',
         ''happy'', ROW(7, ''x''), ROW(''08:00:2b:01:02:01'', 7), ''servis doc 1''),
     (2, ''{08:00:2b:01:02:05}'', ''{{08:00:2b:01:02:05}}'',
         ''sad'', ROW(8, ''y''), ROW(''08:00:2b:01:02:02'', 8), ''servis doc 2'')');


statement ok
CREATE TEXT SEARCH DICTIONARY pgrt_en_${__DATABASE__} AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE VIEW pgrt_v AS SELECT id, macs, grid, mood, p, q, body FROM pgrt_${__DATABASE__}.s${__DATABASE__}_rt.docs;


statement ok
CREATE INDEX pgrt_idx ON pgrt_v USING inverted(body pgrt_en_${__DATABASE__}) WITH (key_columns = 'id');


query
SELECT id, macs, grid, mood, p FROM pgrt_idx WHERE body @@ ts_phrase('servis') ORDER BY id;
----
id	macs	grid	mood	p
1	{08:00:2b:01:02:01,08:00:2b:01:02:02}	{{08:00:2b:01:02:01,08:00:2b:01:02:02},{08:00:2b:01:02:03,08:00:2b:01:02:04}}	happy	(7,x)
2	{08:00:2b:01:02:05}	{{08:00:2b:01:02:05}}	sad	(8,y)


statement error Error reading table "docs" - cast to varchar not implemented for composite column "q"
SELECT id, q FROM pgrt_idx WHERE body @@ ts_phrase('servis');


statement ok
DROP INDEX pgrt_idx;

statement ok
DROP VIEW pgrt_v;

statement ok
DROP TEXT SEARCH DICTIONARY pgrt_en_${__DATABASE__};

statement ok
CALL postgres_execute('pgrt_${__DATABASE__}', 'DROP SCHEMA s${__DATABASE__}_rt CASCADE');

statement ok
DETACH pgrt_${__DATABASE__};
