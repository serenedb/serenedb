control substitution on

# A REINDEX of a view index over a postgres table leaves the index as it is when
# the postgres catalog is missing. The index keys on the table's primary key, so
# it has no file manifest and every REINDEX is a full rebuild. The rebuild used
# to commit a remove-all before its pass bound the view; with the catalog
# detached the pass failed to bind and the index stayed empty. The pass now
# commits the remove-all itself, once it has bound the view.

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS vsmp_${__DATABASE__} (TYPE postgres);

statement ok
CALL postgres_execute('vsmp_${__DATABASE__}', 'DROP SCHEMA IF EXISTS vsmp_docs CASCADE');

statement ok
CREATE SCHEMA vsmp_${__DATABASE__}.vsmp_docs;

statement ok
CREATE TABLE vsmp_${__DATABASE__}.vsmp_docs.articles (id BIGINT PRIMARY KEY, body TEXT);

statement count 3
INSERT INTO vsmp_${__DATABASE__}.vsmp_docs.articles VALUES (1, 'pudge goes mid'), (2, 'pudge goes top'), (3, 'pudge goes bot');

statement ok
CREATE TEXT SEARCH DICTIONARY vsmp_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE VIEW vsmp_v AS SELECT id, body FROM vsmp_${__DATABASE__}.vsmp_docs.articles;

statement ok
CREATE INDEX vsmp_idx ON vsmp_v USING inverted(id, body vsmp_en) WITH (compaction_interval = 0);

query
SELECT count(*) AS n FROM vsmp_idx WHERE body @@ ts_phrase('pudge');
----
n
3

statement ok
DETACH vsmp_${__DATABASE__};

statement error Table with name "vsmp_.*articles" does not exist
REINDEX INDEX vsmp_idx;

statement ok
VACUUM (REFRESH_INDEX) vsmp_idx;

query
SELECT count(*) AS n FROM vsmp_idx WHERE body @@ ts_phrase('pudge');
----
n
3

# The catalog is back: REINDEX works again.

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS vsmp_${__DATABASE__} (TYPE postgres);

statement ok
REINDEX INDEX vsmp_idx;

query
SELECT count(*) AS n FROM vsmp_idx WHERE body @@ ts_phrase('pudge');
----
n
3

# A rebuild over an empty source reads no rows; it still removes the old ones.

statement ok
CALL postgres_execute('vsmp_${__DATABASE__}', 'DELETE FROM vsmp_docs.articles');

statement ok
REINDEX INDEX vsmp_idx;

statement ok
VACUUM (REFRESH_INDEX) vsmp_idx;

query
SELECT count(*) AS n FROM vsmp_idx WHERE body @@ ts_phrase('pudge');
----
n
0

statement ok
DROP INDEX vsmp_idx;

statement ok
DROP VIEW vsmp_v;

statement ok
CALL postgres_execute('vsmp_${__DATABASE__}', 'DROP SCHEMA vsmp_docs CASCADE');

statement ok
DETACH vsmp_${__DATABASE__};
