----
filter_reorder
safe


statement ok
CREATE TABLE filter_reorder_t (a INT, b INT, c INT, d INT, s TEXT);


statement ok
INSERT INTO filter_reorder_t SELECT i % 300, i % 7, i % 5, i % 3, (i % 300)::TEXT FROM generate_series(1, 1000) g(i);


query
EXPLAIN SELECT a FROM filter_reorder_t WHERE a <> b AND s::INTEGER <> a AND s || b::TEXT <> reverse(s) AND b <> c AND a::TINYINT <> d AND c <> d;
----
QUERY PLAN
╭─ PROJECTION ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮
│ Projections: #0                                                                                                                                               │
│ ~200 rows                                                                                                                                                     │
╰───────────────────────────────────────────────────────────────────────────────┬───────────────────────────────────────────────────────────────────────────────╯
╭─ FILTER ──────────────────────────────────────────────────────────────────────┴───────────────────────────────────────────────────────────────────────────────╮
│ Expression:                                                                                                                                                   │
│ (a != b) AND (CAST(s AS INTEGER) != a) AND (b != c) AND ((s || CAST(b AS VARCHAR)) != reverse(s)) AND (CAST(CAST(a AS TINYINT) AS INTEGER) != d) AND (c != d) │
│ ~200 rows                                                                                                                                                     │
╰───────────────────────────────────────────────────────────────────────────────┬───────────────────────────────────────────────────────────────────────────────╯
╭─ SEQ_SCAN ────────────────────────────────────────────────────────────────────┴───────────────────────────────────────────────────────────────────────────────╮
