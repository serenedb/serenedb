╰───────────────────────────────────╯


query
SELECT count(*), bool_and(c = (SELECT count(*) FROM group_limit_bound_t t WHERE t.a IS NOT DISTINCT FROM r.a AND t.b = r.b)) FROM (SELECT a, b, count(*) AS c FROM group_limit_bound_t GROUP BY a, b LIMIT 5) r;
----
count	bool_and
5	t


