statement ok
CREATE TABLE group_limit_bound_t (a BIGINT, b TEXT, c INT);


statement ok
INSERT INTO group_limit_bound_t SELECT CASE WHEN i < 50 THEN NULL ELSE (i % 1000) * 1000003 END, (i % 7)::TEXT, i FROM generate_series(0, 99999) g(i);


query
