control substitution on

statement ok
SET profiling_renderer_settings = {'deterministic': true};


statement ok
SET threads = 1;


statement ok
CREATE TEXT SEARCH DICTIONARY profile_words AS
    split_text(case := 'lower')
    WITH (frequency, position);


statement ok
CREATE TABLE profile_docs (id INTEGER PRIMARY KEY, body VARCHAR, year INTEGER);


statement ok
INSERT INTO profile_docs
SELECT i,
       CASE WHEN i % 7 = 0 THEN 'new york city'
            WHEN i % 5 = 0 THEN 'new york town'
            WHEN i % 3 = 0 THEN 'york city'
            ELSE 'other words here' END,
       2000 + i % 30
FROM range(0, 10000) t(i);


statement ok
CREATE INDEX profile_idx ON profile_docs USING inverted (id, body profile_words) INCLUDE (year);


query
EXPLAIN ANALYZE
SELECT id
FROM profile_idx
WHERE body @@ ts_phrase('new york') AND (body @@ 'city' OR body @@ 'town')
ORDER BY bm25(profile_idx.tableoid) DESC
LIMIT 10;
----
