statement ok
COPY (
  SELECT i AS id, i % 100 AS extra, [i::FLOAT, 0, 0, 0]::FLOAT[4] AS emb
  FROM range(0, 3000) t(i)
) TO '${__TEST_DIR__}/profile_vector_lookup.parquet' (FORMAT PARQUET);


statement ok
CREATE VIEW profile_vector_lookup AS
SELECT id, extra, emb::FLOAT[4] AS emb
FROM read_parquet('${__TEST_DIR__}/profile_vector_lookup.parquet');


statement ok
CREATE INDEX profile_vector_lookup_idx ON profile_vector_lookup USING inverted (id, emb hnsw (metric = 'l2'));


query
EXPLAIN ANALYZE
SELECT id
FROM profile_vector_lookup_idx
WHERE extra = 7
ORDER BY emb <-> [1500.4, 0, 0, 0]::FLOAT[4]
LIMIT 5;
