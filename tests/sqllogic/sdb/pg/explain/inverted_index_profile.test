statement ok
RESET tracked_metrics;


statement ok
CREATE TABLE profile_vectors (id INTEGER PRIMARY KEY, emb FLOAT[4], label VARCHAR);


statement ok
INSERT INTO profile_vectors
SELECT i,
       [i::FLOAT, (i % 7)::FLOAT, 0, 0]::FLOAT[4],
       CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END
FROM range(0, 1000) t(i);


statement ok
CREATE INDEX profile_hnsw_idx ON profile_vectors USING inverted (id, label, emb hnsw (metric = 'l2'));


statement ok
CREATE INDEX profile_ivf_idx ON profile_vectors USING inverted (id, label, emb ivf (metric = 'l2'));


