query
SELECT t.value ->> 'type' AS type, (t.value ->> 'timing')::DOUBLE > 0 AS timed
FROM read_text('${__TEST_DIR__}/inverted_index_profile.json') f, json_tree(f.content) t
WHERE t.type = 'OBJECT' AND t.value ->> 'type' IS NOT NULL
ORDER BY t.id;
