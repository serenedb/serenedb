statement ok
COPY (
    SELECT i AS n,
           CASE WHEN i % 5 = 0 THEN 'new york town' ELSE 'other words here' END AS body,
           'title ' || i AS title
    FROM range(0, 10000) t(i)
) TO '${__TEST_DIR__}/profile_lookup.parquet' (FORMAT parquet);


statement ok
CREATE VIEW profile_lookup AS SELECT * FROM read_parquet('${__TEST_DIR__}/profile_lookup.parquet');


statement ok
CREATE INDEX profile_lookup_idx ON profile_lookup USING inverted (body profile_words, n) INCLUDE (n);


query
EXPLAIN ANALYZE
SELECT title, n
FROM profile_lookup_idx
WHERE body @@ 'town';
