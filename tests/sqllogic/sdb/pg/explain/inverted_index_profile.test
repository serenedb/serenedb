type	timed
RESULT_COLLECTOR	t
UNGROUPED_AGGREGATE	t
TABLE_SCAN	t


query
SELECT t.key AS detail,
       list_filter(from_json(t.value, '["VARCHAR"]'),
                   lambda line: NOT regexp_matches(line, '(Total|Time|Snapshot|Plan): ')) AS lines
FROM read_text('${__TEST_DIR__}/inverted_index_profile.json') f, json_tree(f.content) t
WHERE t.key IN ('Index Filter Prepare', 'Index Filter Execute')
ORDER BY t.id;
