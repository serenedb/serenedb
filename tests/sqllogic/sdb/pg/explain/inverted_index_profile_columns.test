statement ok
RESET sdb_hnsw_column_filter;


statement ok
RESET sdb_hnsw_filter_mode;


statement ok
CREATE TABLE columns_rows (pk INTEGER PRIMARY KEY, emb FLOAT[8], label VARCHAR, grp INTEGER);


statement ok
CREATE INDEX columns_rows_idx ON columns_rows
USING inverted (pk, emb hnsw (metric = 'l2', quant = 'none'))
INCLUDE (label, grp);


statement ok
INSERT INTO columns_rows
SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8],
       CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END, i % 7
FROM range(300) t(i);


query
EXPLAIN ANALYZE
SELECT pk
FROM columns_rows_idx
WHERE label = 'even' OR grp = 3
ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8]
LIMIT 4;
