statement ok
SET profiling_renderer_settings = {'deterministic': true};


statement ok
SET threads = 1;


statement ok
CREATE TEXT SEARCH DICTIONARY columns_words AS
    split_text(case := 'lower')
    WITH (frequency, position);


statement ok
CREATE TABLE columns_docs (id INTEGER PRIMARY KEY, body VARCHAR, year INTEGER)
WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
INSERT INTO columns_docs
SELECT i,
       CASE WHEN i % 7 = 0 THEN 'new york city'
            WHEN i % 3 = 0 THEN 'york city'
            ELSE 'other words here' END,
       2000 + i % 30
FROM range(0, 20000) t(i);


statement ok
CREATE INDEX columns_idx ON columns_docs USING inverted (id, body columns_words) INCLUDE (year);


statement ok
SET sdb_index_profile_nodes = true;


query
EXPLAIN ANALYZE
SELECT count(*)
FROM columns_idx
WHERE body @@ 'city' AND year >= 2020;
