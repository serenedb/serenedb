CREATE TEXT SEARCH DICTIONARY columns_shapes AS encode_geojson();


statement ok
CREATE TABLE columns_places (id INTEGER PRIMARY KEY, geo GEOMETRY('OGC:CRS84'));


statement ok
CREATE INDEX columns_places_idx ON columns_places USING inverted (id, geo columns_shapes);


statement ok
INSERT INTO columns_places
SELECT i, ('POINT(' || (37 + (i % 100) / 100.0) || ' ' || (55 + (i % 50) / 50.0) || ')')::GEOMETRY('OGC:CRS84')
FROM range(0, 2000) t(i);


query
