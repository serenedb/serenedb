statement ok
CREATE TABLE columns_vectors (pk INTEGER PRIMARY KEY, emb FLOAT[8], cat INTEGER, num INTEGER, tag VARCHAR)
WITH (compaction_interval = 0);


statement ok
CREATE INDEX columns_vectors_idx ON columns_vectors
USING inverted (pk, cat, num, tag, emb hnsw (metric = 'l2', quant = 'none'));


statement ok
INSERT INTO columns_vectors
SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8], i % 10, i,
       CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END
FROM range(3000) t(i);


query
EXPLAIN ANALYZE
SELECT pk
FROM columns_vectors
WHERE cat = 4 AND num < 2000 AND tag @@ 'even'
ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8]
LIMIT 4;
