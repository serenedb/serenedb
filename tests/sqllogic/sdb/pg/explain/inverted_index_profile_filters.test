statement ok
SET profiling_renderer_settings = {'deterministic': true};


statement ok
SET threads = 1;


statement ok
CREATE TEXT SEARCH DICTIONARY filters_kw AS keyword();


statement ok
CREATE TEXT SEARCH DICTIONARY filters_ngrams AS generate_wildcard_ngrams(keyword(), 3);


statement ok
CREATE TEXT SEARCH DICTIONARY filters_shapes AS encode_geojson();


statement ok
CREATE TEXT SEARCH DICTIONARY filters_points AS encode_geojson(coding := 's2point');


statement ok
CREATE TABLE filters_msgs (id INTEGER PRIMARY KEY, msg VARCHAR, code VARCHAR, n INTEGER);


statement ok
INSERT INTO filters_msgs
SELECT i,
       'user-' || (i % 100) || '-' || CASE WHEN i % 3 = 0 THEN 'abc' ELSE 'xyz' END,
       'code' || lpad((i % 1000)::VARCHAR, 4, '0'),
       i
FROM range(0, 20000) t(i);


statement ok
CREATE INDEX filters_kw_idx ON filters_msgs USING inverted (id, msg filters_kw, code filters_kw, n);


statement ok
CREATE INDEX filters_ngrams_idx ON filters_msgs USING inverted (id, msg filters_ngrams);


statement ok
CREATE TABLE filters_nets (pk INTEGER PRIMARY KEY, net CIDR, ip INET);


statement ok
INSERT INTO filters_nets
SELECT i,
       ('10.' || (i % 256) || '.0.0/16')::CIDR,
       ('10.' || (i % 256) || '.' || (i % 200) || '.1')::INET
FROM range(0, 5000) t(i);


statement ok
CREATE INDEX filters_nets_idx ON filters_nets USING inverted (pk, net, ip);


statement ok
CREATE TABLE filters_places (id INTEGER PRIMARY KEY, geo GEOMETRY('OGC:CRS84'), pt JSON);


statement ok
INSERT INTO filters_places
SELECT i,
       ('POINT(' || (37 + (i % 100) / 100.0) || ' ' || (55 + (i // 100) / 100.0) || ')')::GEOMETRY('OGC:CRS84'),
       ('{"type":"Point","coordinates":[' || (37 + (i % 100) / 100.0) || ',' || (55 + (i // 100) / 100.0) || ']}')::JSON
FROM range(0, 5000) t(i);


statement ok
CREATE INDEX filters_places_idx ON filters_places USING inverted (id, geo filters_shapes, pt filters_points);


statement ok
SET sdb_index_profile_nodes = true;


