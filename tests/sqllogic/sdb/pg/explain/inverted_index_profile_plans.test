statement ok
CREATE TABLE plans_ivf (id INTEGER PRIMARY KEY, emb FLOAT[4]);


statement ok
INSERT INTO plans_ivf
SELECT i, [i % 100, i // 100, (i * 7) % 13, (i * 3) % 11]::FLOAT[4]
FROM range(0, 5000) t(i);


statement ok
CREATE INDEX plans_ivf_idx ON plans_ivf USING inverted (id, emb ivf (metric = 'l2'));


statement ok
SET sdb_ivf_search_nprobe = 1;


query
EXPLAIN ANALYZE
SELECT id
FROM plans_ivf_idx
ORDER BY emb <-> [50, 25, 6, 5]::FLOAT[4]
LIMIT 3000;
