# Next to a word without score bounds (the column keeps no norms), the pattern
# is a row of its own in the window: the union of its words, given its constant
# once per row.
query
EXPLAIN ANALYZE
SELECT id
FROM plans_idx
WHERE body @@ 'city' OR body @@ ts_like('%o%')
ORDER BY bm25(plans_idx.tableoid) DESC
LIMIT 3;
