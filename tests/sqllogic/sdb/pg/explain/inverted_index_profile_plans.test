CREATE TABLE plans_tags (id INTEGER PRIMARY KEY, body VARCHAR, tag VARCHAR);


statement ok
INSERT INTO plans_tags
SELECT i,
       CASE WHEN i < 30000 THEN 'word' || (i % 5) END,
       CASE WHEN i % 2 = 0 THEN 'red blue' ELSE 'blue red' END
FROM range(0, 60000) t(i);


statement ok
CREATE INDEX plans_tags_idx ON plans_tags USING inverted (id, body plans_words, tag plans_words);


query
EXPLAIN ANALYZE
SELECT unnest(ts_dict_agg(body)) AS term
FROM plans_tags_idx
WHERE tag @@ ts_phrase('red blue') AND tag @@ 'red';
