statement ok
CREATE TABLE plans_vectors (id INTEGER PRIMARY KEY, emb FLOAT[4], label VARCHAR);


statement ok
INSERT INTO plans_vectors
SELECT i,
       [i::FLOAT, (i % 7)::FLOAT, 0, 0]::FLOAT[4],
       CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END
FROM range(0, 1000) t(i);


statement ok
CREATE INDEX plans_hnsw_idx ON plans_vectors USING inverted (id, label, emb hnsw (metric = 'l2'));


query
