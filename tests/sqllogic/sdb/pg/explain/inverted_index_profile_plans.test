# A scored stream over a pattern reads its rows from the union of the
# pattern's words and gives each the constant.
query
EXPLAIN ANALYZE
SELECT id
FROM plans_idx
WHERE body @@ ts_like('%o%') AND bm25(plans_idx.tableoid) > 0.5
ORDER BY id
LIMIT 3;
