statement ok
CREATE TABLE plans_segments (id INTEGER PRIMARY KEY, body VARCHAR)
WITH (compaction_interval = 0);


statement ok
CREATE INDEX plans_segments_idx ON plans_segments USING inverted (id, body plans_words);


statement ok
INSERT INTO plans_segments
SELECT i, CASE WHEN i % 3 = 0 THEN 'york city' ELSE 'other words' END
FROM range(0, 50000) t(i);


statement ok
VACUUM (FLUSH_TABLE) plans_segments;


statement ok
INSERT INTO plans_segments
SELECT i, CASE WHEN i % 3 = 0 THEN 'new york city' ELSE 'new words' END
FROM range(50000, 100000) t(i);


statement ok
VACUUM (FLUSH_TABLE) plans_segments;


