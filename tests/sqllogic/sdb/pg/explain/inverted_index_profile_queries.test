statement ok
SET profiling_renderer_settings = {'deterministic': true};


statement ok
SET threads = 1;


statement ok
CREATE TEXT SEARCH DICTIONARY queries_words AS
    split_text(case := 'lower')
    WITH (frequency, position, offset);


statement ok
CREATE TABLE queries_docs (id INTEGER PRIMARY KEY, body VARCHAR, year INTEGER)
WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
INSERT INTO queries_docs
SELECT i,
       CASE WHEN i % 7 = 0 THEN 'new york city'
            WHEN i % 5 = 0 THEN 'new york town'
            WHEN i % 3 = 0 THEN 'york city'
            ELSE 'other words here' END
       || repeat(' pad', i % 9)
       || CASE WHEN i % 11 = 0 THEN ' town town' ELSE '' END
       || CASE WHEN i % 997 = 0 THEN ' rare' ELSE '' END,
       2000 + i % 30
FROM range(0, 100000) t(i);


statement ok
CREATE INDEX queries_idx ON queries_docs USING inverted (id, body queries_words, year);


statement ok
SET sdb_index_profile_nodes = true;


query
EXPLAIN ANALYZE
SELECT count(*)
FROM queries_idx
WHERE body @@ 'rare' AND body @@ ts_phrase('york city');
