# Pins the *shape* of the compiled-in spatial extension: geometry operations run
# on Boost.Geometry (SPATIAL_USE_BOOST in third_party/CMakeLists.txt). GEOS,
# PROJ and GDAL are not vendored at all, so the extension has no dependency
# outside the repository and every geometry function is its own code.
#
# One liveness assert per module, so a module silently dropping out of the build
# fails here rather than surfacing at the call site as a confusing "not in the
# catalog, but it exists in the spatial extension" error.
#
# The RTREE index is compiled out (SPATIAL_USE_RTREE=OFF) because SereneDB
# indexes geometry through `USING inverted` instead, so this file pins that its
# whole surface -- access method, pragmas, scan function -- is absent, not merely
# rejected. The FlatRTree that accelerates spatial joins is unrelated and stays.

# --- Boost.Geometry ---

query
SELECT ST_AsText(ST_Intersection('LINESTRING (0 0, 4 0)'::GEOMETRY,
                                 'LINESTRING (2 0, 6 0)'::GEOMETRY)) AS geom;
----
geom
LINESTRING (2 0, 4 0)


# GEOS is gone, so the functions only it ever provided must be absent rather
# than present and failing.

query
SELECT count(*) AS v FROM duckdb_functions()
WHERE lower(function_name) IN ('st_makevalid', 'st_node', 'st_polygonize', 'st_buildarea',
                               'st_concavehull', 'st_voronoidiagram', 'st_coverageunion');
----
v
0


# --- PROJ is gone: reprojection goes with it ---

query
SELECT count(*) AS v FROM duckdb_functions()
WHERE lower(function_name) IN ('st_transform', 'duckdb_proj_version',
                               'duckdb_proj_compiled_version');
----
v
0


# The spheroid measures stay: they only ever needed PROJ's bundled geodesic
# solver, which is vendored into the extension instead. Counted by distinct
# name because several of them carry both a GEOMETRY and a POINT_2D variant.

query
SELECT count(DISTINCT lower(function_name)) AS v FROM duckdb_functions()
WHERE lower(function_name) IN ('st_area_spheroid', 'st_distance_spheroid',
                               'st_dwithin_spheroid', 'st_length_spheroid',
                               'st_perimeter_spheroid');
----
v
5


# The CRS itself is a parameter of the GEOMETRY type and comes from the
# database catalog, not from PROJ, so labelling a geometry still works.

query
SELECT ST_CRS('POINT (1 1)'::GEOMETRY('OGC:CRS84')) AS crs;
----
crs
OGC:CRS84


# --- GDAL is gone: the file readers and the COPY format go with it ---

query
SELECT count(*) AS v FROM duckdb_functions()
WHERE lower(function_name) IN ('st_read', 'st_read_meta', 'st_drivers');
----
v
0


# The formats spatial reads on its own are unaffected: shapefiles go through
# the vendored shapelib, OSM through protozero.

query
SELECT count(DISTINCT lower(function_name)) AS v FROM duckdb_functions()
WHERE lower(function_name) IN ('st_readshp', 'st_readosm');
----
v
2


# --- spatial's RTREE index type stays unreachable on SereneDB tables ---

statement ok
CREATE TABLE shapes (id INTEGER, g GEOMETRY);

statement error
CREATE INDEX shapes_rtree ON shapes USING RTREE (g);
----
db error: ERROR: Unknown index type: rtree


# Nothing rtree-shaped is registered at all -- not the pragmas, not the scan
# function. A build that turned the index back on would answer these instead of
# erroring, so they are the guard that SPATIAL_USE_RTREE is still off.

query
SELECT count(*) AS v FROM duckdb_functions() WHERE function_name ILIKE '%rtree%';
----
v
0


statement error
SELECT * FROM rtree_index_dump('shapes_rtree');


statement error
SELECT * FROM pragma_rtree_index_info('shapes_rtree');


statement ok
DROP TABLE shapes;
