# GEOMETRY reaches a PG client as upper-case hex WKB, byte-for-byte what PostGIS
# sends for 2D geometries. ST_AsText is the readable spelling; these assertions
# pin the raw wire form, so they stay SereneDB-only and out of any/pg.

query
SELECT 'POINT(1 2)'::GEOMETRY AS geom;
----
geom
0101000000000000000000F03F0000000000000040

query
SELECT 'POINT Z(1 2 3)'::GEOMETRY AS z, 'POINT ZM(1 2 3 4)'::GEOMETRY AS zm;
----
z	zm
01E9030000000000000000F03F00000000000000400000000000000840	01B90B0000000000000000F03F000000000000004000000000000008400000000000001040

query
SELECT 'POLYGON EMPTY'::GEOMETRY AS empty;
----
empty
010300000000000000

query
SELECT 'GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'::GEOMETRY AS coll;
----
coll
0107000000020000000101000000000000000000F03F000000000000004001020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F

# sqllogictest-rs decodes a binary record field by field and has no
# decoder for the geometry oid, so this row is simple-protocol only.
skipif pg-wire-extended
query
SELECT ROW(1, 'POINT(1 2)'::GEOMETRY) AS rec;
----
rec
(1,0101000000000000000000F03F0000000000000040)

query
SELECT ARRAY['POINT(1 2)'::GEOMETRY, 'LINESTRING(0 0, 1 1)'::GEOMETRY] AS arr;
----
arr
{0101000000000000000000F03F0000000000000040:01020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F}

query
SELECT ARRAY['POINT(1 2)'::GEOMETRY, NULL] AS arr_null;
----
arr_null
{0101000000000000000000F03F0000000000000040:NULL}

query
SELECT ARRAY[ARRAY['POINT(1 2)'::GEOMETRY]] AS nested;
----
nested
{{0101000000000000000000F03F0000000000000040}}

query
SELECT 'POINT(1 2)'::GEOMETRY('OGC:CRS84') AS crs_geom;
----
crs_geom
0101000000000000000000F03F0000000000000040

statement ok
CREATE TABLE geom_wire(id INTEGER, g GEOMETRY);

statement ok
INSERT INTO geom_wire VALUES (1, 'POINT(1 2)'), (2, 'LINESTRING(0 0,1 1)'), (3, NULL);

query
SELECT id, g, ST_AsText(g) AS readable FROM geom_wire ORDER BY id;
----
id	g	readable
1	0101000000000000000000F03F0000000000000040	POINT (1 2)
2	01020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F	LINESTRING (0 0, 1 1)
3	NULL	NULL

statement ok
DROP TABLE geom_wire;
