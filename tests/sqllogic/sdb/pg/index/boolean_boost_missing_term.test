statement ok
CREATE TEXT SEARCH DICTIONARY bbmt_en AS split_text()
    WITH (frequency, position, norm);


statement ok
CREATE TABLE bbmt (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX bbmt_idx ON bbmt
  USING inverted(id, body bbmt_en);


statement ok
INSERT INTO bbmt VALUES (1, 'eel zzz'), (2, 'eel'), (3, 'fig');


query
SELECT id, BM25(bbmt_idx.tableoid) AS score FROM bbmt_idx
WHERE body @@ (('fig'::tsquery::score('constant(1)') ||
                ('eel'::tsquery::score('constant(2)') &&
                 'zzz'::tsquery::score('constant(1)'))) ^ 2.0)
ORDER BY id;
----
id	score
1	6
3	2


