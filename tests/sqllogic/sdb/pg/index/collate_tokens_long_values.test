statement ok
CREATE TEXT SEARCH DICTIONARY lv_coll AS collate_tokens('en')


statement ok
CREATE TABLE lv(id INTEGER PRIMARY KEY, body VARCHAR)


statement ok
CREATE INDEX lv_idx ON lv USING inverted(body lv_coll)
    WITH (refresh_interval = 0, compaction_interval = 0)


statement ok
INSERT INTO lv VALUES (1, 'short'), (2, repeat('a', 40000)), (3, repeat('b', 40000))


statement ok
VACUUM (REFRESH_TABLE) lv;


query
SELECT octet_length(ts_lexize('lv_coll', repeat('a', 40000))[1]) > 32768 AS long_key
----
long_key
t


query
SELECT id FROM lv_idx WHERE body @@ repeat('a', 40000)
----
id
2


query
SELECT id FROM lv_idx WHERE body @@ ts_ge(repeat('b', 40000)) ORDER BY id
----
id
1
3


query
SELECT id FROM lv_idx WHERE body @@ 'short'
----
id
1


