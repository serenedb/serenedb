query
SELECT sum(CAST(j.atom AS BIGINT)) < 64 * 10000 / 2 AS pruned
FROM read_text('${__TEST_DIR__}/curve_differential_default.json') f, json_tree(f.content) j
WHERE j.key = 'rows_scanned';
----
pruned
t

query
