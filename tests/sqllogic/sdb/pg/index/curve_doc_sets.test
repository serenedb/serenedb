statement ok
CREATE TEXT SEARCH DICTIONARY curve_sets_dict AS split_text(case := 'lower')
  WITH (frequency, position);

statement ok
CREATE TABLE curve_sets(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT, tag INTEGER, body VARCHAR);

statement ok
INSERT INTO curve_sets SELECT i, (i * 7919) % 100000, (i * 104729) % 100000, i % 7,
 CASE WHEN i % 3 = 0 THEN 'alpha beta' ELSE 'alpha' END FROM range(200000) t(i);

statement ok
