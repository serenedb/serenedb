PREPARE curve_sets_ranges AS SELECT count(*) AS n, sum(id) AS total FROM curve_sets_idx
 WHERE tag = $1 AND x BETWEEN 0 AND 5000 AND y BETWEEN 0 AND 5000;

statement ok
PREPARE curve_sets_box AS SELECT count(*) AS n, sum(id) AS total FROM curve_sets_idx
 WHERE tag = $1 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(5000, 5000), true, true);

statement ok
PREPARE curve_sets_open AS SELECT count(*) AS n, sum(id) AS total FROM curve_sets_idx
 WHERE id >= $1 AND curve(ROW(x, y)) @@ ts_between(ROW(0, NULL), ROW(5000, NULL), true, true);

