query
SELECT
 (SELECT sum(id) FROM curve_sets_idx WHERE tag = 3 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(1000, 1000), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE tag = 3 AND x BETWEEN 0 AND 1000 AND y BETWEEN 0 AND 1000) AS few,
 (SELECT sum(id) FROM curve_sets_idx WHERE tag = 3 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(50000, 50000), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE tag = 3 AND x BETWEEN 0 AND 50000 AND y BETWEEN 0 AND 50000) AS many,
 (SELECT sum(id) FROM curve_sets_idx WHERE tag <> 3 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(50000, 50000), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE tag <> 3 AND x BETWEEN 0 AND 50000 AND y BETWEEN 0 AND 50000) AS excluded,
 (SELECT count(*) FROM curve_sets_idx WHERE tag = 3 AND x BETWEEN 0 AND 50000 AND y BETWEEN 0 AND 50000) =
 (SELECT count(*) FROM curve_sets WHERE tag = 3 AND x BETWEEN 0 AND 50000 AND y BETWEEN 0 AND 50000) AS ranges;
----
few	many	excluded	ranges
t	t	t	t

query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_sets_idx WHERE id >= 1000 AND id < 60000 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(5000, 5000), true, true)) =
 (SELECT list(id ORDER BY id) FROM curve_sets WHERE id >= 1000 AND id < 60000 AND x BETWEEN 0 AND 5000 AND y BETWEEN 0 AND 5000) AS sparse,
 (SELECT list(id ORDER BY id) FROM curve_sets_idx WHERE id >= 1000 AND id < 2000 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(90000, 90000), true, true)) =
 (SELECT list(id ORDER BY id) FROM curve_sets WHERE id >= 1000 AND id < 2000 AND x BETWEEN 0 AND 90000 AND y BETWEEN 0 AND 90000) AS dense;
----
sparse	dense
t	t

