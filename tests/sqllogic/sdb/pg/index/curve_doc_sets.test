 (SELECT count(*) FROM curve_sets WHERE x BETWEEN 0 AND 1000 AND y BETWEEN 0 AND 1000) AS few,
 (SELECT count(*) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(50000, 50000), true, true)) =
