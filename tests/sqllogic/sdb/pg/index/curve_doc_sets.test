query
SELECT
 (SELECT list(id ORDER BY id) FROM (
   SELECT id FROM curve_knn_wide_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(5, 35), ROW(5, 35), true, true)
   ORDER BY emb <-> [20000, 0]::FLOAT[2] LIMIT 3) t) AS few,
 (SELECT list(id ORDER BY id) FROM (
   SELECT id FROM curve_knn_wide_idx WHERE x = 5 AND y = 35
   ORDER BY emb <-> [20000, 0]::FLOAT[2] LIMIT 3) t) AS few_ranges,
 (SELECT list(id ORDER BY id) FROM (
   SELECT id FROM curve_knn_wide WHERE x = 5 AND y = 35
   ORDER BY array_distance(emb, [20000, 0]::FLOAT[2]) LIMIT 3) t) AS truth;
----
