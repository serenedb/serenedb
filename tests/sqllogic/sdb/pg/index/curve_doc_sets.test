statement ok
INSERT INTO curve_sets SELECT 201000 + i, 210000 + (i % 2) * 10000, 210000 + (i % 2) * 10000, i % 7, 'alpha beta' FROM range(300) t(i);

statement ok
INSERT INTO curve_sets VALUES (202000, 200000, 200001, 1, 'alpha'), (202001, 210000, 210001, 1, 'alpha'), (202002, 500, 500, 1, 'alpha');

statement ok
CREATE INDEX curve_sets_idx ON curve_sets USING inverted(id, tag, body curve_sets_dict, (curve(ROW(x, y))));

statement ok
VACUUM (REFRESH_TABLE) curve_sets;

query
SELECT
 (SELECT sum(id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(1000, 1000), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE x BETWEEN 0 AND 1000 AND y BETWEEN 0 AND 1000) AS few,
 (SELECT sum(id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(50000, 50000), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE x BETWEEN 0 AND 50000 AND y BETWEEN 0 AND 50000) AS many,
 (SELECT sum(id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(200000, 200000), ROW(200000, 200002), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE x = 200000 AND y BETWEEN 200000 AND 200002) AS run,
 (SELECT sum(id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(210000, 210000), ROW(210000, 210002), true, true)) =
 (SELECT sum(id) FROM curve_sets WHERE x = 210000 AND y BETWEEN 210000 AND 210002) AS gaps,
 (SELECT sum(id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(250000, 250000), true, true)) =
 (SELECT sum(id) FROM curve_sets) AS every;
----
few	many	run	gaps	every
t	t	t	t	t

statement ok
VACUUM (COMPACT_TABLE) curve_sets;

query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(200000, 200000), ROW(200000, 200002), true, true)) =
 (SELECT list(id ORDER BY id) FROM curve_sets WHERE x = 200000 AND y BETWEEN 200000 AND 200002) AS run,
 (SELECT list(id ORDER BY id) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(210000, 210000), ROW(210000, 210002), true, true)) =
 (SELECT list(id ORDER BY id) FROM curve_sets WHERE x = 210000 AND y BETWEEN 210000 AND 210002) AS gaps,
 (SELECT count(*) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(200000, 200000), ROW(200000, 200002), true, true)) AS run_rows,
 (SELECT count(*) FROM curve_sets_idx WHERE curve(ROW(x, y)) @@ ts_between(ROW(210000, 210000), ROW(210000, 210002), true, true)) AS gaps_rows;
----
run	gaps	run_rows	gaps_rows
t	t	151	151

