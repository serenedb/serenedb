query
SELECT ip FROM (VALUES ('2001:db8::1'::INET), ('10.0.0.2'::INET), ('::'::INET), ('10.0.0.1'::INET), ('255.255.255.255'::INET)) v(ip)
ORDER BY curve(ip, 0);
