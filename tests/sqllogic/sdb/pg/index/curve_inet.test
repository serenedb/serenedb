statement ok
CREATE TABLE curve_subnet(id INTEGER PRIMARY KEY, ip INET, t BIGINT);

statement ok
INSERT INTO curve_subnet SELECT i,
 ('2001:db8:1::' || lower(printf('%x', (i * 7919) % 65536)) || ':' || lower(printf('%x', i % 4096)))::INET,
 (i * 104729) % 10000 FROM range(20000) r(i);

statement ok
INSERT INTO curve_subnet SELECT 20000 + i, ('2001:db8:' || (i % 7 + 2) || '::' || lower(printf('%x', i)))::INET, i
FROM range(200) r(i);

statement ok
INSERT INTO curve_subnet SELECT 21000 + i, ('10.0.0.' || i)::INET, i FROM range(100) r(i);

statement ok
CREATE INDEX curve_subnet_plain ON curve_subnet USING inverted(id, (curve(ROW(ip, t)))) INCLUDE (ip, t);

statement ok
CREATE INDEX curve_subnet_norm ON curve_subnet USING inverted(id, (curve(ROW(ip, t),
 lower := ROW('2001:db8:1::'::INET, NULL), upper := ROW('2001:db8:1::ffff:ffff:ffff:ffff'::INET, NULL)))) INCLUDE (ip, t);

statement ok
VACUUM (REFRESH_TABLE) curve_subnet;

statement ok
SET enable_profiling = 'json';

statement ok
