query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_masked_idx WHERE curve(ROW(ip, t)) @@ ts_between(
   ROW('10.64.0.0'::INET, NULL), ROW('10.100.0.0'::INET, NULL), true, true)) AS ipv4,
 (SELECT list(id ORDER BY id) FROM curve_masked_idx WHERE curve(ROW(ip, t)) @@ ts_between(
   ROW('2001:db8::/32'::INET, NULL), ROW('2001:db8::1'::INET, NULL), true, true)) AS ipv6,
 (SELECT list(id ORDER BY id) FROM curve_masked_idx
   WHERE ip BETWEEN '10.64.0.0'::INET AND '10.100.0.0'::INET AND t BETWEEN 0 AND 0) AS ipv4_range,
 (SELECT list(id ORDER BY id) FROM curve_masked_idx
   WHERE ip >= '2001:db8::/32'::INET AND ip <= '2001:db8::1'::INET AND t = 0) AS ipv6_range;
