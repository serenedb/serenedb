DROP TABLE curve_masked;

statement ok
CREATE TABLE curve_networks(id INTEGER PRIMARY KEY, ip INET, t BIGINT);

statement ok
INSERT INTO curve_networks SELECT i,
 CASE WHEN i % 2 = 0
      THEN ('10.' || (i * 37 % 256) || '.' || (i * 91 % 256) || '.' || (i % 256) || '/' || (i * 7 % 33))::INET
      ELSE ('2001:db8:' || lower(printf('%x', i * 7919 % 65536)) || '::' || lower(printf('%x', i)) || '/' || (i * 13 % 129))::INET END,
 i % 100
FROM range(4000) r(i);

statement ok
CREATE INDEX curve_networks_m ON curve_networks USING inverted(id, (curve(ROW(ip, t)))) INCLUDE (ip, t);

statement ok
CREATE INDEX curve_networks_h ON curve_networks USING inverted(id, (curve(ROW(ip, t), kind := 'hilbert', max_cells := 64))) INCLUDE (ip, t);

statement ok
CREATE INDEX curve_networks_v4 ON curve_networks USING inverted(id, (curve(ROW(ip, t),
 lower := ROW('10.0.0.0'::INET, 0), upper := ROW('10.255.255.255'::INET, 100)))) INCLUDE (ip, t);

statement ok
CREATE INDEX curve_networks_v6 ON curve_networks USING inverted(id, (curve(ROW(ip, t),
 lower := ROW('2001:db8::'::INET, NULL), upper := ROW('2001:db8:ffff:ffff:ffff:ffff:ffff:ffff'::INET, NULL)))) INCLUDE (ip, t);

statement ok
VACUUM (REFRESH_TABLE) curve_networks;

query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_networks_m WHERE curve(ROW(ip, t)) @@ ts_between(
   ROW('10.64.0.0'::INET, 10), ROW('10.100.0.0'::INET, 60), true, true))
 IS NOT DISTINCT FROM
 (SELECT list(id ORDER BY id) FROM curve_networks
   WHERE ip BETWEEN '10.64.0.0'::INET AND '10.100.0.0'::INET AND t BETWEEN 10 AND 60) AS morton,
 (SELECT list(id ORDER BY id) FROM curve_networks_h WHERE curve(ROW(ip, t), kind := 'hilbert', max_cells := 64) @@ ts_between(
   ROW('10.64.0.0/10'::INET, 10), ROW('10.100.0.0/16'::INET, 60), false, true))
 IS NOT DISTINCT FROM
 (SELECT list(id ORDER BY id) FROM curve_networks
   WHERE ip > '10.64.0.0/10'::INET AND ip <= '10.100.0.0/16'::INET AND t > 10 AND t <= 60) AS hilbert,
 (SELECT list(id ORDER BY id) FROM curve_networks_v4 WHERE curve(ROW(ip, t),
   lower := ROW('10.0.0.0'::INET, 0), upper := ROW('10.255.255.255'::INET, 100)) @@ ts_between(
   ROW('10.64.0.0'::INET, 10), ROW('10.100.0.0'::INET, 60), true, false))
 IS NOT DISTINCT FROM
 (SELECT list(id ORDER BY id) FROM curve_networks
   WHERE ip >= '10.64.0.0'::INET AND ip < '10.100.0.0'::INET AND t >= 10 AND t < 60) AS ipv4_range,
 (SELECT list(id ORDER BY id) FROM curve_networks_v6 WHERE curve(ROW(ip, t),
   lower := ROW('2001:db8::'::INET, NULL), upper := ROW('2001:db8:ffff:ffff:ffff:ffff:ffff:ffff'::INET, NULL)) @@ ts_between(
   ROW('2001:db8:4000::/20'::INET, NULL), ROW('2001:db8:9000::'::INET, NULL), true, true))
 IS NOT DISTINCT FROM
 (SELECT list(id ORDER BY id) FROM curve_networks
   WHERE ip BETWEEN '2001:db8:4000::/20'::INET AND '2001:db8:9000::'::INET AND t IS NOT NULL) AS ipv6_range,
 (SELECT count(*) FROM curve_networks
   WHERE ip BETWEEN '10.64.0.0'::INET AND '10.100.0.0'::INET AND t BETWEEN 10 AND 60
   AND host(ip)::INET > '10.100.0.0'::INET) > 0 AS hosts_past_upper;
----
morton	hilbert	ipv4_range	ipv6_range	hosts_past_upper
t	t	t	t	t

