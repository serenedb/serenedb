query
SELECT curve(0::DOUBLE, 0, lower := ROW(-8e307, NULL), upper := ROW(8e307, NULL)) IS NOT NULL AS finite_span,
 curve(DATE '2000-01-01', 0, lower := ROW(DATE '-infinity', NULL), upper := ROW(DATE 'infinity', NULL)) IS NOT NULL AS dates,
 curve(TIMESTAMP '2000-01-01', 0, lower := ROW(TIMESTAMP '-infinity', NULL), upper := ROW(TIMESTAMP 'infinity', NULL)) IS NOT NULL AS timestamps;
