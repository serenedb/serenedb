statement ok
CREATE TABLE curve_option_identity(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT);

statement ok
INSERT INTO curve_option_identity VALUES (1,1,1), (2,NULL,1);

statement ok
CREATE INDEX curve_option_identity_idx ON curve_option_identity USING inverted(id,(curve(ROW(x,y)))) INCLUDE (x,y);

statement ok
VACUUM (REFRESH_TABLE) curve_option_identity;

query
SELECT id FROM curve_option_identity_idx WHERE curve(ROW(x,y),kind := 'MORTON') @@ ts_between(ROW(0,0),ROW(2,2),true,true);
----
id
1

