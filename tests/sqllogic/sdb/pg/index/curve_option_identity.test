statement ok
PREPARE curve_option_identity_query AS SELECT id FROM curve_option_identity_idx WHERE curve(ROW(x,y),kind := upper('morton'),level_step := 1+2,max_cells := 8+8) @@ ts_between(ROW($1::BIGINT,0),ROW($2::BIGINT,2),true,true);

query
EXECUTE curve_option_identity_query(0,2);
----
id
1

statement ok
DEALLOCATE curve_option_identity_query;

statement ok
CREATE INDEX curve_option_identity_normalized ON curve_option_identity USING inverted(id,(curve(ROW(x,y),lower := ROW(0,0),upper := ROW(10,10)))) INCLUDE (x,y);

