statement ok
CREATE TABLE curve_walk(id INTEGER PRIMARY KEY, x DOUBLE, y DOUBLE, z DOUBLE, tag INTEGER);

statement ok
INSERT INTO curve_walk SELECT i, ((i * 48271) % 300007) / 300.007, ((i * 69621 + 123) % 300017) / 300.017,
 ((i * 40699 + 321) % 300023) / 300.023, i % 5 FROM range(300000) t(i);

statement ok
INSERT INTO curve_walk SELECT 300000 + i, 500, 500, 500, i % 5 FROM range(2000) t(i);

statement ok
INSERT INTO curve_walk SELECT 302000 + i, 250 + i % 40, 250 + i % 40, 750, i % 5 FROM range(4000) t(i);

statement ok
CREATE INDEX curve_walk_idx ON curve_walk USING inverted(id, tag, (curve(ROW(x, y, z))));

statement ok
VACUUM (REFRESH_TABLE) curve_walk;

