statement ok
SET threads = 4;

query
SELECT
 (SELECT count(*) || ':' || sum(id) FROM curve_walk_idx WHERE curve(ROW(x, y, z)) @@ ts_between(ROW(100, 200, 300), ROW(700, 800, 900), true, true)) =
 (SELECT count(*) || ':' || sum(id) FROM curve_walk WHERE x BETWEEN 100 AND 700 AND y BETWEEN 200 AND 800 AND z BETWEEN 300 AND 900) AS wide,
 (SELECT count(*) || ':' || sum(id) FROM curve_walk_idx WHERE curve(ROW(x, y, z)) @@ ts_between(ROW(400, NULL, NULL), ROW(450, NULL, NULL), true, true)) =
 (SELECT count(*) || ':' || sum(id) FROM curve_walk WHERE x BETWEEN 400 AND 450) AS slab,
 (SELECT count(*) || ':' || sum(id) FROM curve_walk_idx WHERE curve(ROW(x, y, z)) @@ ts_between(ROW(NULL, 300.5, NULL), ROW(NULL, 300.75, NULL), false, false)) =
 (SELECT count(*) || ':' || sum(id) FROM curve_walk WHERE y > 300.5 AND y < 300.75) AS thin,
 (SELECT count(*) || ':' || sum(id) FROM curve_walk_idx WHERE curve(ROW(x, y, z)) @@ ts_between(ROW(0, 0, 499), ROW(1000, 1000, 501), true, true)) =
 (SELECT count(*) || ':' || sum(id) FROM curve_walk WHERE z BETWEEN 499 AND 501) AS shared,
 (SELECT count(*) || ':' || sum(id) FROM curve_walk_idx WHERE curve(ROW(x, y, z)) @@ ts_between(ROW(240, 240, 700), ROW(300, 300, 800), true, true)) =
 (SELECT count(*) || ':' || sum(id) FROM curve_walk WHERE x BETWEEN 240 AND 300 AND y BETWEEN 240 AND 300 AND z BETWEEN 700 AND 800) AS repeated,
 (SELECT count(*) || ':' || sum(id) FROM curve_walk_idx WHERE tag = 3 AND curve(ROW(x, y, z)) @@ ts_between(ROW(0, 100, 0), ROW(900, 1000, 1000), true, true)) =
 (SELECT count(*) || ':' || sum(id) FROM curve_walk WHERE tag = 3 AND x BETWEEN 0 AND 900 AND y BETWEEN 100 AND 1000) AS tagged,
 (SELECT count(*) FROM curve_walk_idx WHERE curve(ROW(x, y, z)) @@ ts_between(ROW(0, 0, 0), ROW(1000, 1000, 1000), true, true)) AS every;
----
wide	slab	thin	shared	repeated	tagged	every
t	t	t	t	t	t	306000

