statement ok
CREATE TABLE cpl(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT, tag INTEGER);

statement ok
INSERT INTO cpl SELECT i, i % 20, (i * 7) % 20, i % 4 FROM range(2000) t(i);

statement ok
CREATE INDEX cpl_idx ON cpl USING inverted(id, tag, (curve(ROW(x, y))));

statement ok
VACUUM (REFRESH_TABLE) cpl;

statement ok
PREPARE cpl_box AS SELECT count(*) AS n, sum(id) AS total FROM cpl_idx
 WHERE tag = $1 AND curve(ROW(x, y)) @@ ts_between(ROW(0, 0), ROW(9, 9), true, true);

statement ok
PREPARE cpl_ranges AS SELECT count(*) AS n, sum(id) AS total FROM cpl_idx
 WHERE tag = $1 AND x BETWEEN 0 AND 9 AND y BETWEEN 0 AND 9;

query
SELECT count(*) AS n, sum(id) AS total FROM cpl WHERE tag = 1 AND x BETWEEN 0 AND 9 AND y BETWEEN 0 AND 9;
----
n	total
200	199000

query
EXECUTE cpl_box(1);
----
n	total
200	199000

query
EXECUTE cpl_ranges(1);
----
n	total
200	199000

