query
SELECT count(*) AS groups, sum(n) AS total FROM (SELECT curve(ROW(x, y)) AS k, count(*) AS n FROM curve_forms_idx GROUP BY 1) t;
----
groups	total
15	60

query
SELECT list(id ORDER BY id) AS ids FROM curve_forms_idx WHERE curve(ROW(x, y)) = curve(ROW(1, 1));
----
ids
{1,16,31,46}

query
SELECT list(id ORDER BY id) AS ids FROM curve_forms_idx WHERE x <> 2 AND x BETWEEN 1 AND 3 AND y = 1;
----
ids
{1,13,16,28,31,43,46,58}

query
SELECT (SELECT count(*) FROM curve_forms_idx WHERE x BETWEEN y AND 3 AND y BETWEEN 0 AND 1)
 = (SELECT count(*) FROM curve_forms WHERE x BETWEEN y AND 3 AND y BETWEEN 0 AND 1) AS same;
----
same
t

query
