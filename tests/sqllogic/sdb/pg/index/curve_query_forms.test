statement ok
CREATE TABLE curve_forms(id INTEGER PRIMARY KEY, x INTEGER, y INTEGER, s VARCHAR);

statement ok
INSERT INTO curve_forms SELECT i, i % 5, i % 3, 'x' || i FROM range(60) t(i);

statement ok
CREATE INDEX curve_forms_idx ON curve_forms USING inverted(id, (curve(ROW(x, y)))) INCLUDE (x, y, s);

statement ok
CREATE INDEX curve_forms_insert ON curve_forms USING inverted(id, (curve(struct_insert({'x': x}, y := y)))) INCLUDE (x, y);

statement ok
CREATE INDEX curve_forms_null ON curve_forms USING inverted(id, (curve(ROW(NULL, x)))) INCLUDE (x);

statement ok
VACUUM (REFRESH_TABLE) curve_forms;


