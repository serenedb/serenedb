statement ok
CREATE TABLE crp(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT);

statement ok
INSERT INTO crp VALUES (1,-10,-10),(2,0,0),(3,1,1),(4,2,2),(5,NULL,1),(6,1,NULL),(7,10,10);

statement ok
CREATE INDEX crp_idx ON crp USING inverted(id,(curve(x,y,max_level:=0))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_expr ON crp USING inverted(id,(curve(abs(x),abs(y),max_level:=0))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_multi ON crp USING inverted(id,(curve(x,y,max_level:=0)),(curve(abs(x),abs(y),max_level:=0))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_dup ON crp USING inverted(id,(curve(x,x,max_level:=0))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_term ON crp USING inverted(id,x,(curve(x,y,max_level:=0))) INCLUDE(x,y);

statement ok
VACUUM (REFRESH_TABLE) crp;

query
EXPLAIN SELECT id FROM crp_idx WHERE x BETWEEN 0 AND 1 AND y BETWEEN 0 AND 1;
