query
SELECT
 (SELECT list(id ORDER BY id) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s >= -300000 AND s <= 1) AS wide_lower,
 (SELECT list(id ORDER BY id) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s >= 2 AND s <= 300000) AS wide_upper,
 (SELECT list(id ORDER BY id) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s >= 1 AND s <= 5) AS sides,
 (SELECT list(id ORDER BY id) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s BETWEEN -300000 AND 300000) AS wide;
----
wide_lower	wide_upper	sides	wide
{1}	{2}	{1,2}	{1,2}

query
SELECT
 (SELECT count(*) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s >= 300000) AS above,
 (SELECT count(*) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s >= 300000 AND s <= 300001) AS above_both,
 (SELECT count(*) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s >= -300001 AND s <= -300000) AS below_both,
 (SELECT count(*) FROM crpe_cast WHERE f BETWEEN 0 AND 3 AND s <= 300000) AS one_side;
----
above	above_both	below_both	one_side
0	0	0	2

