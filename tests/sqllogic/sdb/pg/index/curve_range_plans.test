statement ok
CREATE TABLE crp(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT);

statement ok
INSERT INTO crp VALUES (1,-10,-10),(2,0,0),(3,1,1),(4,2,2),(5,NULL,1),(6,1,NULL),(7,10,10);

statement ok
CREATE INDEX crp_idx ON crp USING inverted(id,(curve(ROW(x,y),max_level := 1))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_expr ON crp USING inverted(id,(curve(ROW(abs(x),abs(y)),max_level := 1))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_multi ON crp USING inverted(id,(curve(ROW(x,y),max_level := 1)),(curve(ROW(abs(x),abs(y)),max_level := 1))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_dup ON crp USING inverted(id,(curve(ROW(x,x),max_level := 1))) INCLUDE(x,y);

statement ok
CREATE INDEX crp_term ON crp USING inverted(id,x,(curve(ROW(x,y),max_level := 1))) INCLUDE(x,y);

statement ok
VACUUM (REFRESH_TABLE) crp;

