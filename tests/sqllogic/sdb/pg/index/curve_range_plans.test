statement ok
DROP TABLE crpt;

statement ok
CREATE TABLE crpe(id INTEGER PRIMARY KEY, x BIGINT, y DOUBLE, i INET, f FLOAT, s SMALLINT);

statement ok
INSERT INTO crpe VALUES (1, 1, 1.5, '10.0.0.1', 1, 1), (2, 5, 2.5, '10.0.0.2', 2, 2);

statement ok
CREATE INDEX crpe_exact ON crpe USING inverted(id, (curve(ROW(x, y))));

statement ok
CREATE INDEX crpe_inet ON crpe USING inverted(id, (curve(ROW(x, i))));

statement ok
CREATE INDEX crpe_norm ON crpe USING inverted(id, (curve(ROW(x, y), lower := ROW(0, NULL), upper := ROW(10, NULL))));

statement ok
CREATE INDEX crpe_cast ON crpe USING inverted(id, (curve(ROW(f, s))));

statement ok
VACUUM (REFRESH_TABLE) crpe;

