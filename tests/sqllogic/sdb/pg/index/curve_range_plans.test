query
SELECT
 (SELECT list(id ORDER BY id) FROM crpe_exact WHERE curve(ROW(x, y)) @@ ts_between(ROW(1, 1.5), ROW(5, 2.5), false, false)) AS strict,
 (SELECT list(id ORDER BY id) FROM crpe_exact WHERE x BETWEEN 1 AND 5 AND y BETWEEN 1.5 AND 2.5) AS closed,
 (SELECT list(id ORDER BY id) FROM crpe_inet WHERE curve(ROW(x, i)) @@ ts_between(ROW(0, '10.0.0.2'::INET), ROW(9, '10.0.0.9'::INET), true, true)) AS inet,
 (SELECT list(id ORDER BY id) FROM crpe_norm WHERE curve(ROW(x, y), lower := ROW(0, NULL), upper := ROW(10, NULL)) @@ ts_between(ROW(2, 0), ROW(9, 9), true, true)) AS norm,
 (SELECT list(id ORDER BY id) FROM crpe_cast WHERE curve(ROW(f, s)) @@ ts_between(ROW(0.5, 0), ROW(1.5, 300000), true, true)) AS clamped;
----
strict	closed	inet	norm	clamped
NULL	{1,2}	{2}	{2}	{1}

