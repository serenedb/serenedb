statement ok
CREATE TABLE curve_ranges(id INTEGER PRIMARY KEY, x BIGINT, y DOUBLE, t TIMESTAMP);

statement ok
INSERT INTO curve_ranges VALUES
 (1, -5, -0.0, '2026-01-01'),
 (2, 0, 0, '2026-01-02'),
 (3, 5, 5, '2026-01-03'),
 (4, 10, 10, '2026-01-04'),
 (5, NULL, 5, '2026-01-03'),
 (6, 5, NULL, '2026-01-03'),
 (7, 9007199254740993, 5, '2026-01-03'),
 (8, 5, 'NaN', '2026-01-03'),
 (9, 5, 'Infinity', '2026-01-03'),
 (10, 5, '-Infinity', '2026-01-03');

statement ok
CREATE INDEX curve_ranges_idx ON curve_ranges USING inverted(
 id, (curve(x, y, t, max_cells := 16))) INCLUDE (x, y, t);

statement ok
CREATE INDEX curve_ranges_hilbert ON curve_ranges USING inverted(
 id, (curve(x, y, t, kind := 'hilbert', max_cells := 1))) INCLUDE (x, y, t);

statement ok
VACUUM (REFRESH_TABLE) curve_ranges;

