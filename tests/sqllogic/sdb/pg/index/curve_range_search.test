statement ok
PREPARE curve_range_query AS SELECT
 (SELECT list(id ORDER BY id) FROM curve_ranges_idx WHERE x BETWEEN $1::BIGINT AND $2::BIGINT
  AND y BETWEEN 0 AND 5 AND t = TIMESTAMP '2026-01-03') IS NOT DISTINCT FROM
 (SELECT list(id ORDER BY id) FROM curve_ranges WHERE x BETWEEN $1::BIGINT AND $2::BIGINT
  AND y BETWEEN 0 AND 5 AND t = TIMESTAMP '2026-01-03') AS equal;

query
EXECUTE curve_range_query(0, 5);
----
equal
t

query
EXECUTE curve_range_query(5, 10);
----
equal
t

statement ok
DEALLOCATE curve_range_query;

statement ok
CREATE INDEX curve_ranges_expr ON curve_ranges USING inverted(
 id, (curve(x + 1, y * 2))) INCLUDE (x, y, t);

statement ok
CREATE INDEX curve_ranges_multi ON curve_ranges USING inverted(
 id, (curve(x, y)), (curve(y, t, kind := 'hilbert'))) INCLUDE (x, y, t);

statement ok
CREATE INDEX curve_ranges_dup ON curve_ranges USING inverted(
 id, (curve(x, x))) INCLUDE (x, y, t);

statement ok
CREATE INDEX curve_ranges_term ON curve_ranges USING inverted(
 id, x, (curve(x, y))) INCLUDE (x, y);

statement ok
VACUUM (REFRESH_TABLE) curve_ranges;

