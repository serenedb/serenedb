 (1, 1, 1, 1, '2026-01-01', '2026-01-01', '2026-01-01 00:00:00+00'),
 (2, 2, 18446744073709551615::UBIGINT, 2, '2026-01-02', '2026-01-02', '2026-01-02 00:00:00+00'),
 (3, NULL, NULL, NULL, NULL, NULL, NULL);

