control substitution on

statement ok
CREATE TABLE curve_metrics(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT);

statement ok
INSERT INTO curve_metrics VALUES
 (1,0,0),
 (2,100,100),
 (3,NULL,NULL);

statement ok
CREATE INDEX curve_metrics_p ON curve_metrics USING inverted(id, (curve(x, y, max_level := 0))) INCLUDE(x,y);

statement ok
VACUUM (REFRESH_TABLE) curve_metrics;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_point.json';

query
SELECT max(id) FROM curve_metrics_p WHERE curve(x, y, max_level := 0) @@ ts_between(ROW(-1,-1), ROW(1,1), true, true);
----
max
1

statement ok
RESET enable_profiling;

query
SELECT max(CAST(j.atom AS BIGINT)) AS candidates
FROM read_text('${__TEST_DIR__}/curve_point.json') f, json_tree(f.content) j
WHERE j.key='rows_scanned';
----
candidates
2

statement ok
DROP TABLE curve_metrics;

statement ok
CREATE TABLE curve_range_metrics(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT);

statement ok
INSERT INTO curve_range_metrics SELECT i, i % 64, i // 64 FROM range(4096) t(i);

statement ok
CREATE INDEX curve_range_metrics_idx ON curve_range_metrics USING inverted(
 id, (curve(x, y, max_cells := 16))) INCLUDE (x,y);

statement ok
VACUUM (REFRESH_TABLE) curve_range_metrics;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_range_plain.json';

query
SELECT sum(id) AS total FROM curve_range_metrics_idx WHERE x BETWEEN 20 AND 25 AND y BETWEEN 20 AND 25;
----
total
52650

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_range_box.json';

query
SELECT sum(id) AS total FROM curve_range_metrics_idx WHERE curve(x, y, max_cells := 16) @@ ts_between(ROW(20,20), ROW(25,25), true, true);
----
total
52650

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_range_strict.json';

query
SELECT sum(id) AS total FROM curve_range_metrics_idx WHERE x > 20 AND x < 25 AND y > 20 AND y < 25;
----
total
23400

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_range_equal.json';

query
SELECT sum(id) AS total FROM curve_range_metrics_idx WHERE x = 22 AND y = 22;
----
total
1430

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_range_intersect.json';

query
SELECT sum(id) AS total FROM curve_range_metrics_idx WHERE x BETWEEN 10 AND 30 AND x >= 20 AND x <= 25
 AND y BETWEEN 10 AND 30 AND y >= 20 AND y <= 25;
----
total
52650

statement ok
RESET enable_profiling;

query
WITH plain AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_range_plain.json') f, json_tree(f.content) j WHERE j.key='rows_scanned'),
box AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_range_box.json') f, json_tree(f.content) j WHERE j.key='rows_scanned')
SELECT plain.candidates = box.candidates AS equal, box.candidates < 4096 AS pruned FROM plain, box;
----
equal	pruned
t	t

query
WITH strict AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_range_strict.json') f, json_tree(f.content) j WHERE j.key='rows_scanned'),
equal AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_range_equal.json') f, json_tree(f.content) j WHERE j.key='rows_scanned'),
intersection AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_range_intersect.json') f, json_tree(f.content) j WHERE j.key='rows_scanned'),
box AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_range_box.json') f, json_tree(f.content) j WHERE j.key='rows_scanned')
SELECT strict.candidates < 4096 AS strict_pruned, equal.candidates < 4096 AS equal_pruned,
 intersection.candidates = box.candidates AS intersect_equal FROM strict, equal, intersection, box;
----
strict_pruned	equal_pruned	intersect_equal
t	t	t

