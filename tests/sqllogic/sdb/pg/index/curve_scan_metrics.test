statement ok
RESET enable_profiling;

query
SELECT
 (SELECT sum(id) FROM curve_scales WHERE x BETWEEN 10 AND 20 AND y BETWEEN 200000000 AND 400000000) AS exact,
 (SELECT sum(id) FROM curve_scales WHERE x BETWEEN 10 AND 20 AND d BETWEEN 1000.2 AND 1000.4) AS exact_double;
----
exact	exact_double
1096300	1088300

query
WITH candidates AS (
 SELECT f.filename AS name, max(CAST(j.atom AS BIGINT)) AS n
 FROM read_text('${__TEST_DIR__}/curve_scales_*.json') f, json_tree(f.content) j
 WHERE j.key='rows_scanned' GROUP BY f.filename),
plain AS (SELECT n FROM candidates WHERE name LIKE '%curve_scales_plain.json'),
norm AS (SELECT n FROM candidates WHERE name LIKE '%curve_scales_norm.json'),
dbl AS (SELECT n FROM candidates WHERE name LIKE '%curve_scales_double.json'),
dbl_norm AS (SELECT n FROM candidates WHERE name LIKE '%curve_scales_double_norm.json')
SELECT norm.n * 4 < plain.n AS scales_pruned, dbl_norm.n * 4 < dbl.n AS doubles_pruned,
 norm.n < 440 AND dbl_norm.n < 440 AS close FROM plain, norm, dbl, dbl_norm;
----
scales_pruned	doubles_pruned	close
t	t	t

statement ok
DROP TABLE curve_scales;
