statement ok
CREATE TABLE curve_scales(id INTEGER PRIMARY KEY, x BIGINT, y BIGINT, d DOUBLE);

statement ok
INSERT INTO curve_scales SELECT i, i % 100, (i * 7919 % 10000) * 100000,
 1000 + (i * 104729 % 10000) / 10000.0 FROM range(10000) t(i);

statement ok
CREATE INDEX curve_scales_plain ON curve_scales USING inverted(id, (curve(x, y))) INCLUDE (x, y);

statement ok
CREATE INDEX curve_scales_norm ON curve_scales USING inverted(
 id, (curve(x, y, lower := ROW(0, 0), upper := ROW(99, 999999999)))) INCLUDE (x, y);

statement ok
CREATE INDEX curve_scales_double ON curve_scales USING inverted(
 id, (curve(x, d, max_level := 24))) INCLUDE (x, d);

statement ok
CREATE INDEX curve_scales_double_norm ON curve_scales USING inverted(
 id, (curve(x, d, max_level := 24, lower := ROW(0, 1000), upper := ROW(99, 1001)))) INCLUDE (x, d);

statement ok
VACUUM (REFRESH_TABLE) curve_scales;

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_scales_plain.json';

query
SELECT sum(id) AS total FROM curve_scales_plain WHERE curve(x, y) @@ ts_between(
 ROW(10, 200000000), ROW(20, 400000000), true, true);
----
total
1096300

