CREATE TABLE curve_nullable(id INTEGER PRIMARY KEY, p STRUCT(x BIGINT, y DOUBLE));

statement ok
INSERT INTO curve_nullable VALUES (1, NULL), (2, ROW(NULL, 1)), (3, ROW(1, 1));

statement ok
CREATE INDEX curve_nullable_idx ON curve_nullable USING inverted(id, p curve());

statement ok
VACUUM (REFRESH_TABLE) curve_nullable;

query
SELECT id FROM curve_nullable_idx WHERE p IS NULL;
----
id
1

query
SELECT id FROM curve_nullable_idx WHERE p IS NOT NULL ORDER BY id;
----
id
2
3

query
SELECT id FROM curve_nullable_idx WHERE sdb_box_contains(p, ROW(0, 0::DOUBLE), ROW(2, 2::DOUBLE));
----
id
3

