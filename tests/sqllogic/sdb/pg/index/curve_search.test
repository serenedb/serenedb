statement ok
CREATE TABLE curve_structs(id INTEGER PRIMARY KEY, p STRUCT(x INTEGER, y INTEGER), x INTEGER, y INTEGER);


statement ok
INSERT INTO curve_structs SELECT i, {'x': i % 10, 'y': i // 10}, i % 10, i // 10 FROM range(100) r(i);


statement ok
CREATE INDEX curve_structs_idx ON curve_structs USING inverted(id, (curve(p)), (curve({'x': x, 'y': y}))) INCLUDE (p, x, y);


statement ok
VACUUM (REFRESH_TABLE) curve_structs;


query
SELECT list(id ORDER BY id) AS ids FROM curve_structs_idx
WHERE curve({'x': x, 'y': y}) @@ ts_between(ROW(2, 3), ROW(3, 4), true, true);
----
ids
{32,33,42,43}


query
SELECT list(id ORDER BY id) AS ids FROM curve_structs_idx WHERE x BETWEEN 2 AND 3 AND y BETWEEN 3 AND 4;
----
ids
{32,33,42,43}


