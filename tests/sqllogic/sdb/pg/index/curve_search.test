query
SELECT hex(curve(ROW(1, 2))) AS morton, hex(curve(ROW(1, 2), kind := 'hilbert', max_level := 8)) AS hilbert,
 octet_length(curve(ROW(1, 2, 3))) AS bytes, octet_length(curve(ROW(1, 2, 3), max_level := 3)) AS short;
----
morton	hilbert	bytes	short
C000000000000006	8000	12	2

query
SELECT octet_length(curve(ROW(1::TINYINT, 2::SMALLINT))) AS small,
 octet_length(curve(ROW(DATE '2026-01-01', 1::UTINYINT))) AS date,
 octet_length(curve(ROW(1, 2.5::DOUBLE))) AS double,
 octet_length(curve(ROW(5::BIGINT, 7::BIGINT), lower := ROW(0, 0), upper := ROW(100, 1000))) AS scaled,
 octet_length(curve(ROW(TIMESTAMP '2026-01-01 12:00', 0::TINYINT),
   lower := ROW(TIMESTAMP '2026-01-01', NULL), upper := ROW(TIMESTAMP '2026-01-02', NULL))) AS day,
 octet_length(curve(ROW('10.0.1.2'::INET, 0::TINYINT),
   lower := ROW('10.0.0.0'::INET, NULL), upper := ROW('10.0.255.255'::INET, NULL))) AS ipv4,
 octet_length(curve(ROW('2001:db8::1:2'::INET, 0::TINYINT),
   lower := ROW('2001:db8::'::INET, NULL), upper := ROW('2001:db8::ffff:ffff'::INET, NULL))) AS ipv6;
----
small	date	double	scaled	day	ipv4	ipv6
4	8	16	3	10	4	8

query
SELECT hex(curve(ROW(1::TINYINT, 2::TINYINT))) = hex(curve(ROW(1::TINYINT, 2::TINYINT), max_level := 8)) AS same,
 hex(curve(ROW(1, 2), max_level := NULL)) = hex(curve(ROW(1, 2))) AS null_default,
 hex(curve(ROW((-128)::TINYINT, 127::TINYINT))) AS corners;
----
same	null_default	corners
t	t	5555

query
SELECT curve(ROW(NULL, 1)) IS NULL AS n, curve(ROW(1, NULL::DOUBLE)) IS NULL AS component;
----
n	component
t	t

query
SELECT x, y FROM (VALUES (3, 3), (0, 0), (1, 0), (0, 1), (2, 2)) t(x, y) ORDER BY curve(ROW(x, y));
----
x	y
0	0
0	1
1	0
2	2
3	3

statement ok
CREATE TABLE curve_points(id INTEGER PRIMARY KEY, x BIGINT, y DOUBLE, t TIMESTAMP);

statement ok
INSERT INTO curve_points VALUES
 (1, -5, -0.0, '2026-01-01'),
 (2, 0, 0, '2026-01-02'),
 (3, 5, 5, '2026-01-03'),
 (4, 10, 10, '2026-01-04'),
 (5, NULL, 5, '2026-01-03'),
 (6, 5, NULL, '2026-01-03'),
 (7, 9007199254740993, 5, '2026-01-03');

statement ok
CREATE INDEX curve_morton ON curve_points USING inverted(
 id, (curve(ROW(x, y, t), max_cells := 16))) INCLUDE (x, y, t);

statement ok
CREATE INDEX curve_hilbert ON curve_points USING inverted(
 id, (curve(ROW(x, y, t), kind := 'hilbert', max_cells := 1))) INCLUDE (x, y, t);

statement ok
VACUUM (REFRESH_TABLE) curve_points;

query
SELECT id FROM curve_morton WHERE curve(ROW(x, y, t), max_cells := 16) @@ ts_between(
 ROW(0, 0, TIMESTAMP '2026-01-01'), ROW(5, 5, TIMESTAMP '2026-01-03'), true, true) ORDER BY id;
----
id
2
3

query
SELECT id FROM curve_hilbert WHERE curve(ROW(x, y, t), kind := 'hilbert', max_cells := 1) @@ ts_between(
 ROW(0, 0, TIMESTAMP '2026-01-01'), ROW(5, 5, TIMESTAMP '2026-01-03'), true, true) ORDER BY id;
----
id
2
3

query
SELECT id FROM curve_morton WHERE curve(ROW(x, y, t), max_cells := 16) @@ ts_between(
 ROW(9007199254740993::BIGINT, NULL, NULL), ROW(9007199254740993::BIGINT, NULL, NULL), true, true);
----
id
7

query
SELECT id FROM curve_hilbert WHERE curve(ROW(x, y, t), kind := 'hilbert', max_cells := 1) @@ ts_between(
 ROW(NULL, 5, NULL), ROW(NULL, 5, NULL), true, true) ORDER BY id;
