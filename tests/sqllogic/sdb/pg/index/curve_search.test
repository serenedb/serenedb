n
0

query
SELECT count(*) AS n FROM curve_morton WHERE curve(ROW(x, y, t), max_cells := 16) @@ ts_between(
 NULL, NULL, true, true);
----
n
5

query
SELECT count(*) AS n FROM (
 SELECT id FROM curve_morton WHERE curve(ROW(x, y, t), max_cells := 16) @@ ts_between(
   ROW(-5, 0, TIMESTAMP '2026-01-01'), ROW(5, 5, TIMESTAMP '2026-01-03'), true, true)
 EXCEPT
 SELECT id FROM curve_points WHERE x BETWEEN -5 AND 5 AND y BETWEEN 0 AND 5
   AND t BETWEEN TIMESTAMP '2026-01-01' AND TIMESTAMP '2026-01-03') differences;
----
n
0

query
EXPLAIN SELECT id FROM curve_hilbert WHERE curve(ROW(x, y, t), kind := 'hilbert', max_cells := 1) @@ ts_between(
 ROW(0, NULL, NULL), ROW(5, NULL, NULL), true, false);
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────────────────────────────────╮
│ Index: curve_hilbert                                                 │
│ Lookup: table                                                        │
│ Index Filter:                                                        │
│ ╭─ Term ───────────────────────────────────────────────────────────╮ │
│ │ Field:                                                           │ │
│ │ curve("row"(x, y, t), kind := 'hilbert', max_cells := 1)(string) │ │
│ │ Value: A\\x3\\x0                                                   │ │
│ ╰──────────────────────────────────────────────────────────────────╯ │
│ Column Filter: (x >= 0) AND (x < 5), y IS NOT NULL                   │
│ Projections: id                                                      │
│ ~1 row                                                               │
╰──────────────────────────────────────────────────────────────────────╯

statement ok
PREPARE curve_query AS SELECT id FROM curve_morton WHERE curve(ROW(x, y, t), max_cells := 16) @@ ts_between(
 ROW($1::BIGINT, NULL, NULL), ROW($2::BIGINT, NULL, NULL), true, true) ORDER BY id;

query
EXECUTE curve_query(5, 10);
----
id
3
4

statement ok
UPDATE curve_points SET x=4 WHERE id=4;

statement ok
DELETE FROM curve_points WHERE id=2;

statement ok
VACUUM (REFRESH_TABLE) curve_points;

query
EXECUTE curve_query(0, 5);
----
id
3
4

query
SELECT id FROM curve_morton WHERE curve(ROW(x, y, t), max_cells := 16) @@ ts_between(
 ROW(0, NULL, NULL), ROW(5, NULL, NULL), false, false);
----
id
4

statement ok
DEALLOCATE curve_query;

