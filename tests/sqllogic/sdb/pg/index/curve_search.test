statement ok
CREATE TABLE curve_points(id INTEGER PRIMARY KEY, x BIGINT, y DOUBLE, t TIMESTAMP);

query
SELECT opcname FROM pg_catalog.pg_opclass WHERE opcname = 'curve';
----
opcname
curve

query
SELECT sdb_box_contains(NULL, ROW(0,0), ROW(1,1)) IS NULL AS n,
 sdb_box_contains(ROW(NULL,1), ROW(0,0), ROW(1,1)) IS NULL AS component;
----
n	component
t	t

query
SELECT sdb_box_contains(ROW(NULL,2), ROW(0,0), ROW(1,1)) AS outside,
 sdb_box_contains(ROW(NULL,2), ROW(NULL,0), ROW(NULL,3)) AS partial;
----
outside	partial
f	t

statement ok
INSERT INTO curve_points VALUES
 (1, -5, -0.0, '2026-01-01'),
 (2, 0, 0, '2026-01-02'),
 (3, 5, 5, '2026-01-03'),
 (4, 10, 10, '2026-01-04'),
 (5, NULL, 5, '2026-01-03'),
 (6, 5, NULL, '2026-01-03'),
 (7, 9007199254740993, 5, '2026-01-03');

statement ok
CREATE INDEX curve_morton ON curve_points USING inverted(
 id, (ROW(x, y, t)) curve(max_cells=16)) INCLUDE (x, y, t);

statement ok
CREATE INDEX curve_hilbert ON curve_points USING inverted(
 id, (ROW(x, y, t)) curve(curve='hilbert', max_cells=1)) INCLUDE (x, y, t);

statement ok
VACUUM (REFRESH_TABLE) curve_points;

query
SELECT id FROM curve_morton WHERE sdb_box_contains(
 ROW(x, y, t), ROW(0, 0::DOUBLE, TIMESTAMP '2026-01-01'),
 ROW(5, 5::DOUBLE, TIMESTAMP '2026-01-03')) ORDER BY id;
----
id
2
3

query
SELECT id FROM curve_hilbert WHERE sdb_box_contains(
 ROW(x, y, t), ROW(0, 0::DOUBLE, TIMESTAMP '2026-01-01'),
 ROW(5, 5::DOUBLE, TIMESTAMP '2026-01-03')) ORDER BY id;
----
 id
2
3

query
SELECT id FROM curve_morton WHERE sdb_box_contains(
 ROW(x, y, t), ROW(9007199254740993::BIGINT, NULL, NULL),
 ROW(9007199254740993::BIGINT, NULL, NULL));
----
id
7

query
SELECT id FROM curve_hilbert WHERE sdb_box_contains(
 ROW(x, y, t), ROW(NULL, 5::DOUBLE, NULL), ROW(NULL, 5::DOUBLE, NULL)) ORDER BY id;
----
id
3
5
7

query
SELECT id FROM curve_morton WHERE NOT sdb_box_contains(
 ROW(x, y, t), ROW(0, 0::DOUBLE, TIMESTAMP '2026-01-01'),
 ROW(5, 5::DOUBLE, TIMESTAMP '2026-01-03')) ORDER BY id;
----
id
1
4
7

query
SELECT count(*) AS n FROM curve_morton WHERE sdb_box_contains(
 ROW(x, y, t), ROW(5, NULL, NULL), ROW(0, NULL, NULL));
----
n
0

query
SELECT count(*) AS n FROM curve_morton WHERE
 sdb_box_contains(ROW(x, y, t), ROW(-5, NULL, NULL), ROW(-5, NULL, NULL)) OR id=4;
----
n
2

query
SELECT count(*) AS n FROM (
 SELECT id FROM curve_morton WHERE sdb_box_contains(ROW(x,y,t),
   ROW(-5, 0::DOUBLE, TIMESTAMP '2026-01-01'), ROW(5, 5::DOUBLE, TIMESTAMP '2026-01-03'))
 EXCEPT
 SELECT id FROM curve_points WHERE x BETWEEN -5 AND 5 AND y BETWEEN 0 AND 5
   AND t BETWEEN TIMESTAMP '2026-01-01' AND TIMESTAMP '2026-01-03') differences;
----
n
0

statement ok
PREPARE curve_query AS SELECT id FROM curve_morton WHERE
 sdb_box_contains(ROW(x,y,t), ROW($1::BIGINT, NULL, NULL), ROW($2::BIGINT, NULL, NULL)) ORDER BY id;

query
EXECUTE curve_query(5, 10);
----
id
3
4
6

statement ok
UPDATE curve_points SET x=4 WHERE id=4;

statement ok
DELETE FROM curve_points WHERE id=2;

statement ok
VACUUM (REFRESH_TABLE) curve_points;

query
EXECUTE curve_query(0, 5);
----
id
3
4
6

