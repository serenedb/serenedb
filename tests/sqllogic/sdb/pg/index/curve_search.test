statement ok
CREATE TABLE curve_steps(id INTEGER PRIMARY KEY, x BIGINT, y DOUBLE, z INTEGER);

statement ok
INSERT INTO curve_steps SELECT i, (i * 7919) % 1000, ((i * 104729) % 1000)::DOUBLE / 10, (i * 31) % 100 FROM range(2000) t(i);

statement ok
CREATE INDEX curve_steps_1 ON curve_steps USING inverted(id, (curve(x, y, z, level_step := 1))) INCLUDE (x, y, z);

statement ok
CREATE INDEX curve_steps_5 ON curve_steps USING inverted(id, (curve(x, y, z, level_step := 5, max_cells := 8))) INCLUDE (x, y, z);

statement ok
VACUUM (REFRESH_TABLE) curve_steps;

query
SELECT
 (SELECT count(*) FROM curve_steps_1 WHERE curve(x, y, z, level_step := 1) @@ ts_between(ROW(100, 10, 20), ROW(400, 60, 70), true, true)) AS step1,
 (SELECT count(*) FROM curve_steps_5 WHERE curve(x, y, z, level_step := 5, max_cells := 8) @@ ts_between(ROW(100, 10, 20), ROW(400, 60, 70), true, true)) AS step5,
 (SELECT count(*) FROM curve_steps WHERE x BETWEEN 100 AND 400 AND y BETWEEN 10 AND 60 AND z BETWEEN 20 AND 70) AS exact;
----
step1	step5	exact
138	138	138

statement ok
DROP TABLE curve_steps;
