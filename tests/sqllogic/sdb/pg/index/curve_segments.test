CREATE INDEX curve_batches_built ON curve_batches USING inverted(id, (curve(ROW(x, y, z)))) INCLUDE (x, y, z);

statement ok
VACUUM (REFRESH_TABLE) curve_batches;

statement ok
CREATE MACRO curve_batches_box(h) AS ts_between(ROW(500 - h, 500 - h, 500 - h), ROW(500 + h, 500 + h, 500 + h), true, true);

statement ok
CREATE MACRO curve_batches_scanned(path) AS (
 SELECT max(CAST(j.atom AS BIGINT)) FROM read_text(path) f, json_tree(f.content) j WHERE j.key = 'rows_scanned');

query
SELECT count(*), sum(id) FROM curve_batches_flushed WHERE curve(ROW(x, y, z)) @@ curve_batches_box(40);
----
count	sum
1	869

query
SELECT count(*), sum(id) FROM curve_batches_built WHERE curve(ROW(x, y, z)) @@ curve_batches_box(40);
----
count	sum
1	869

query
SELECT count(*), sum(id) FROM curve_batches WHERE x BETWEEN 500 - 40 AND 500 + 40 AND y BETWEEN 500 - 40 AND 500 + 40 AND z BETWEEN 500 - 40 AND 500 + 40;
----
count	sum
1	869

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_batches_flushed_flushed_40.json';

statement ok
SELECT max(id) FROM curve_batches_flushed WHERE curve(ROW(x, y, z)) @@ curve_batches_box(40);

statement ok
SET profiling_output = '${__TEST_DIR__}/curve_batches_built_flushed_40.json';

statement ok
SELECT max(id) FROM curve_batches_built WHERE curve(ROW(x, y, z)) @@ curve_batches_box(40);

statement ok
RESET enable_profiling;

query
SELECT curve_batches_scanned('${__TEST_DIR__}/curve_batches_flushed_flushed_40.json') = curve_batches_scanned('${__TEST_DIR__}/curve_batches_built_flushed_40.json') AS same;
----
same
t

