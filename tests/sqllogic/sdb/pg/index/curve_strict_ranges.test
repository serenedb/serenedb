query
WITH strict AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_strict_plain.json') f, json_tree(f.content) j WHERE j.key='rows_scanned'),
explicit AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_strict_box.json') f, json_tree(f.content) j WHERE j.key='rows_scanned'),
closed AS (
 SELECT max(CAST(j.atom AS BIGINT)) AS candidates
 FROM read_text('${__TEST_DIR__}/curve_strict_closed.json') f, json_tree(f.content) j WHERE j.key='rows_scanned')
SELECT strict.candidates AS strict_candidates, strict.candidates = explicit.candidates AS explicit_equal,
 strict.candidates < closed.candidates AS stricter FROM strict, explicit, closed;
----
strict_candidates	explicit_equal	stricter
1	t	t

