query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(x, y, lower := ROW(0, 0), upper := ROW(10, 1))
   @@ ts_between(ROW(10, NULL), ROW(NULL, NULL), false, true)) AS above,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(x, y, lower := ROW(0, 0), upper := ROW(10, 1))
   @@ ts_between(ROW(NULL, NULL), ROW(0, NULL), true, false)) AS below,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(d, y, lower := ROW(0, 0), upper := ROW(1, 1))
   @@ ts_between(ROW(1, NULL), ROW(NULL, NULL), false, true)) AS double_above,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(d, y, lower := ROW(0, 0), upper := ROW(1, 1))
   @@ ts_between(ROW(NULL, NULL), ROW(0, NULL), true, false)) AS double_below;
----
above	below	double_above	double_below
{6,7}	{1,2}	{5,6,7}	{1}

query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE x > 10) AS above,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE x < 0) AS below,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE d > 1) AS double_above,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE d < 0) AS double_below;
----
above	below	double_above	double_below
{6,7}	{1,2}	{5,6,7}	{1}

query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(ip, y)
   @@ ts_between(ROW('10.0.0.1/24'::INET, NULL), ROW(NULL, NULL), false, true)) AS mask,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(ip, y)
   @@ ts_between(ROW('::1'::INET, NULL), ROW(NULL, NULL), false, true)) AS ipv6_above,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy_idx WHERE curve(ip, y)
   @@ ts_between(ROW(NULL, NULL), ROW('::3'::INET, NULL), true, false)) AS ipv6_below;
----
mask	ipv6_above	ipv6_below
{2,3,4,5,6,7}	{5,6,7}	{1,2,3,4,5}

query
SELECT
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE ip > '10.0.0.1/24'::INET) AS mask,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE ip > '::1'::INET) AS ipv6_above,
 (SELECT list(id ORDER BY id) FROM curve_strict_lossy WHERE ip < '::3'::INET) AS ipv6_below;
----
mask	ipv6_above	ipv6_below
{2,3,4,5,6,7}	{5,6,7}	{1,2,3,4,5}

