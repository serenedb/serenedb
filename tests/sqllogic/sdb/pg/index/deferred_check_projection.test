statement ok
CREATE TABLE dcp_nested AS
    SELECT g AS id,
           'w' || (g % 7) || ' w' || (g % 11) AS body,
           CASE WHEN g % 13 = 0 THEN NULL
                WHEN g % 17 = 0 THEN []::VARCHAR[]
                ELSE ['w' || (g % 5) || ' w' || (g % 3), 'x' || (g % 4)]
           END AS tags,
           CASE WHEN g % 19 = 0 THEN NULL ELSE {'a': g % 10, 'b': 'w' || (g % 6)} END AS s
    FROM range(1, 300001) t(g)

statement ok
CREATE INDEX dcp_nested_idx ON dcp_nested USING inverted (id, body dcp_words, tags dcp_words) INCLUDE (body, tags, s)

statement ok
VACUUM (REFRESH_TABLE) dcp_nested

query
SELECT (SELECT count(*) FROM dcp_nested_idx WHERE tags @@ ts_phrase('w1 w2')) AS matches,
       (SELECT count(*) FROM dcp_nested
        WHERE id % 5 = 1 AND id % 3 = 2 AND id % 13 <> 0 AND id % 17 <> 0) AS expected,
       (SELECT count(*) FROM (SELECT id, tags, s FROM dcp_nested_idx WHERE tags @@ ts_phrase('w1 w2')) i
        JOIN dcp_nested g USING (id)
        WHERE i.tags IS DISTINCT FROM g.tags OR i.s IS DISTINCT FROM g.s
           OR NOT (g.id % 5 = 1 AND g.id % 3 = 2 AND g.id % 13 <> 0 AND g.id % 17 <> 0)) AS wrong
----
matches	expected	wrong
17376	17376	0

query
SELECT (SELECT count(*) FROM dcp_nested_idx WHERE body @@ 'w3' AND tags @@ ts_phrase('w1 w2')) AS matches,
       (SELECT count(*) FROM (
           SELECT id, tags, s FROM dcp_nested_idx WHERE body @@ 'w3' AND tags @@ ts_phrase('w1 w2')
           EXCEPT ALL
           SELECT id, tags, s FROM dcp_nested
           WHERE (id % 7 = 3 OR id % 11 = 3) AND id % 5 = 1 AND id % 3 = 2 AND id % 13 <> 0 AND id % 17 <> 0)) AS extra,
       (SELECT count(*) FROM (
           SELECT id, tags, s FROM dcp_nested
           WHERE (id % 7 = 3 OR id % 11 = 3) AND id % 5 = 1 AND id % 3 = 2 AND id % 13 <> 0 AND id % 17 <> 0
           EXCEPT ALL
           SELECT id, tags, s FROM dcp_nested_idx WHERE body @@ 'w3' AND tags @@ ts_phrase('w1 w2'))) AS missing
----
matches	extra	missing
3835	0	0

query
SELECT (SELECT count(*) FROM dcp_nested_idx WHERE body @@ 'w3' AND len(tags) = 2) AS matches,
       (SELECT count(*) FROM (
           SELECT id, tags, s FROM dcp_nested_idx WHERE body @@ 'w3' AND len(tags) = 2
           EXCEPT ALL
           SELECT id, tags, s FROM dcp_nested WHERE (id % 7 = 3 OR id % 11 = 3) AND len(tags) = 2)) AS extra,
       (SELECT count(*) FROM (
           SELECT id, tags, s FROM dcp_nested WHERE (id % 7 = 3 OR id % 11 = 3) AND len(tags) = 2
           EXCEPT ALL
           SELECT id, tags, s FROM dcp_nested_idx WHERE body @@ 'w3' AND len(tags) = 2)) AS missing
----
matches	extra	missing
57543	0	0

query
SELECT (SELECT count(*) FROM dcp_nested_idx WHERE body @@ 'w3' AND s IS NOT NULL) AS matches,
       (SELECT count(*) FROM (
           SELECT id, tags, s FROM dcp_nested_idx WHERE body @@ 'w3' AND s IS NOT NULL
           EXCEPT ALL
           SELECT id, tags, s FROM dcp_nested WHERE (id % 7 = 3 OR id % 11 = 3) AND s IS NOT NULL)) AS extra,
       (SELECT count(*) FROM (
           SELECT id, tags, s FROM dcp_nested WHERE (id % 7 = 3 OR id % 11 = 3) AND s IS NOT NULL
           EXCEPT ALL
