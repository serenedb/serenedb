CREATE TEXT SEARCH DICTIONARY dcp_shape AS encode_geojson()

statement ok
CREATE TABLE dcp_geo (id INTEGER PRIMARY KEY, geo JSON)

statement ok
INSERT INTO dcp_geo
    SELECT g, '{"type":"Point","coordinates":[' || (37.6 + (g % 100) * 0.0001) || ',' || (55.7 + (g // 100) * 0.0001) || ']}'
    FROM range(0, 10000) t(g)

statement ok
CREATE INDEX dcp_geo_idx ON dcp_geo USING inverted (id, geo dcp_shape)

