statement ok
CREATE TABLE dcp_gen AS
    SELECT g AS id,
           CASE WHEN g % 97 = 0 THEN NULL
                ELSE 'w' || (g % 7) || ' w' || (g % 11) || ' w' || (g % 5) || ' w' || (g % 3)
           END AS body
    FROM range(1, 30001) t(g)

statement ok
INSERT INTO dcp_gen SELECT g, NULL FROM range(30001, 30101) t(g)

statement ok
CREATE INDEX dcp_gen_idx ON dcp_gen USING inverted (id, body dcp_words) INCLUDE (body)

statement ok
VACUUM (REFRESH_TABLE) dcp_gen

query
SELECT (SELECT count(*) FROM dcp_gen_idx WHERE body @@ ts_phrase('w3 w4')) AS matches,
       (SELECT count(*) FROM dcp_gen WHERE (' ' || body || ' ') LIKE '% w3 w4 %') AS expected
----
matches	expected
926	926

query
SELECT count(*) FROM (SELECT id, body FROM dcp_gen_idx WHERE body @@ ts_phrase('w3 w4')) i
JOIN dcp_gen g USING (id) WHERE i.body IS DISTINCT FROM g.body
----
count
0

query
SELECT count(*) FROM (SELECT id, body FROM dcp_gen_idx WHERE body @@ ts_phrase('w3 w4') AND id % 3 <> 0) i
JOIN dcp_gen g USING (id) WHERE i.body IS DISTINCT FROM g.body
----
count
0

