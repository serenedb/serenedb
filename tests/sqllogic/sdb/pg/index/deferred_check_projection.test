statement ok
CREATE TEXT SEARCH DICTIONARY dcp_words AS split_text(case := 'lower') WITH (frequency)

statement ok
CREATE TABLE dcp (id INTEGER PRIMARY KEY, body TEXT, tags VARCHAR[])

statement ok
INSERT INTO dcp VALUES
    (1, 'quick brown fox', ['quick brown', 'fox']),
    (2, 'brown quick fox', ['brown', 'quick fox']),
    (3, 'the quick brown dog', [NULL, 'quick brown dog']),
    (4, 'quick and brown', ['quick', 'and brown']),
    (5, NULL, NULL),
    (6, 'a quick brown cat', ['a quick brown cat']),
    (7, 'quick brown', NULL),
    (8, NULL, ['quick brown'])

statement ok
CREATE INDEX dcp_idx ON dcp USING inverted (id, body dcp_words, tags dcp_words) INCLUDE (body, tags)

statement ok
VACUUM (REFRESH_TABLE) dcp

query
SELECT id, body FROM dcp_idx WHERE body @@ ts_phrase('quick brown') ORDER BY id
