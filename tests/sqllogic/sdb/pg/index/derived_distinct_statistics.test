CREATE TABLE dds_parent (id INT PRIMARY KEY, code VARCHAR UNIQUE, tag VARCHAR);


statement ok
CREATE TABLE dds_child (id INT PRIMARY KEY, parent INT REFERENCES dds_parent (id), label VARCHAR);


statement ok
CREATE INDEX dds_child_label ON dds_child USING inverted (label);


statement ok
INSERT INTO dds_parent SELECT i, 'c' || i, 'tag-' || (i % 7) FROM range(1000) t(i);


statement ok
INSERT INTO dds_child SELECT i, i % 100, 'l' || (i % 13) FROM range(5000) t(i);


statement ok
VACUUM (FLUSH_TABLE) dds_child;


query
SELECT (stats(id)).approx_unique AS id, (stats(code)).approx_unique AS code FROM dds_parent LIMIT 1;
----
id	code
1000	1000


query
