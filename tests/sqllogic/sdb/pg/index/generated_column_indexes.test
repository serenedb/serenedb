statement ok
CREATE TABLE gci (id INT PRIMARY KEY, a INT, v INT GENERATED ALWAYS AS (a * 10) VIRTUAL, s INT GENERATED ALWAYS AS (a * 100) STORED, b TEXT);


statement ok
INSERT INTO gci (id, a, b) VALUES (1, 1, 'red'), (2, 2, 'blue'), (3, 3, 'red');


statement ok
CREATE INDEX gci_inv ON gci USING inverted (id, b, v, s, v included(), s included());


statement ok
CREATE UNIQUE INDEX gci_art_v ON gci (v);


statement ok
CREATE INDEX gci_art_s ON gci (s);


statement ok
VACUUM (REFRESH_TABLE) gci;


query
SELECT id, v, s FROM gci_inv WHERE v = 20;
----
id	v	s
2	20	200


query
SELECT id, v, s FROM gci_inv WHERE s = 300;
----
id	v	s
3	30	300


