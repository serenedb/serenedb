# Generated: every deferred geo shape. A required geo predicate is checked
# by a table filter; the same predicate under OR is checked inline. Both
# must return the same rows: mismatches is always 0.

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_shape AS encode_geojson()

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_centroid AS encode_geojson(type := 'centroid')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_point AS encode_geojson(type := 'point')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_s2point AS encode_geojson(coding := 's2point')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_f64 AS encode_geojson(coding := 's2latlngf64')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_u32 AS encode_geojson(coding := 's2latlngu32')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_centroid_s2 AS encode_geojson(type := 'centroid', coding := 's2point')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_geopoint AS encode_geopoint('lat', 'lng')

statement ok
CREATE TABLE gdm (id INTEGER PRIMARY KEY, geo JSON)

