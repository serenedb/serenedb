SELECT (SELECT count(*) FROM (SELECT id FROM gdm_shape_idx WHERE ((ST_Intersects(geo, '{"type":"Polygon","coordinates":[[[37.6,55.715],[37.606,55.715],[37.606,55.721000000000004],[37.6,55.721000000000004],[37.6,55.715]]]}')) OR id < 0))) AS matches, (SELECT count(*) FROM ((SELECT id FROM gdm_shape_idx WHERE ST_Intersects(geo, '{"type":"Polygon","coordinates":[[[37.6,55.715],[37.606,55.715],[37.606,55.721000000000004],[37.6,55.721000000000004],[37.6,55.715]]]}') EXCEPT SELECT id FROM gdm_shape_idx WHERE ((ST_Intersects(geo, '{"type":"Polygon","coordinates":[[[37.6,55.715],[37.606,55.715],[37.606,55.721000000000004],[37.6,55.721000000000004],[37.6,55.715]]]}')) OR id < 0)) UNION ALL (SELECT id FROM gdm_shape_idx WHERE ((ST_Intersects(geo, '{"type":"Polygon","coordinates":[[[37.6,55.715],[37.606,55.715],[37.606,55.721000000000004],[37.6,55.721000000000004],[37.6,55.715]]]}')) OR id < 0) EXCEPT SELECT id FROM gdm_shape_idx WHERE ST_Intersects(geo, '{"type":"Polygon","coordinates":[[[37.6,55.715],[37.606,55.715],[37.606,55.721000000000004],[37.6,55.721000000000004],[37.6,55.715]]]}')))) AS mismatches
