statement ok
CREATE TEXT SEARCH DICTIONARY gdm_centroid AS encode_geojson(type := 'centroid')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_point AS encode_geojson(type := 'point')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_f64 AS encode_geojson(coding := 's2latlngf64')

statement ok
CREATE TEXT SEARCH DICTIONARY gdm_centroid_s2 AS encode_geojson(type := 'centroid', coding := 's2point')

statement ok
CREATE INDEX gdm_centroid_idx ON gdm USING inverted (id, geo gdm_centroid)

statement ok
CREATE INDEX gdm_point_idx ON gdm USING inverted (id, geo gdm_point)

statement ok
CREATE INDEX gdm_s2point_idx ON gdm USING inverted (id, geo gdm_s2point)

statement ok
CREATE INDEX gdm_f64_idx ON gdm USING inverted (id, geo gdm_f64)

statement ok
CREATE INDEX gdm_centroid_s2_idx ON gdm USING inverted (id, geo gdm_centroid_s2)

statement ok
VACUUM (REFRESH_TABLE) gdm

statement ok
CREATE INDEX gdm_g_source_idx ON gdm_g USING inverted (id, geo gdm_shape)

statement ok
