statement ok
CREATE TEXT SEARCH DICTIONARY gdm_norm AS split_text(case := 'lower') WITH (frequency, norm)

statement ok
CREATE TABLE gdm_score (id INTEGER PRIMARY KEY, geo JSON, body VARCHAR)

statement ok
INSERT INTO gdm_score VALUES
    (1, '{"type":"Point","coordinates":[37.603,55.718]}', 'house on a long quiet street near the old green park by the river'),
    (2, '{"type":"LineString","coordinates":[[37.603,55.718],[37.62,55.73]]}', 'house house house')

statement ok
CREATE INDEX gdm_score_idx ON gdm_score USING inverted (id, geo gdm_shape, body gdm_norm) INCLUDE (body)

statement ok
VACUUM (REFRESH_TABLE) gdm_score

query
SELECT id FROM gdm_score_idx
WHERE ST_Contains('{"type":"Polygon","coordinates":[[[37.6,55.715],[37.606,55.715],[37.606,55.721],[37.6,55.721],[37.6,55.715]]]}', geo) AND body @@ 'house'
  AND (BM25(gdm_score_idx.tableoid) * 115)::TINYINT < 125
