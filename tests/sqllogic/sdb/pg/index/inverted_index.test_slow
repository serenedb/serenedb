show-column-names false
hash-threshold 100

statement count 100000
CREATE TABLE clickclack AS
SELECT
  CASE
    WHEN vedernikoff_team.crook % 2 = 0 THEN
      'team member vedernikoff has ' || (crook / 10)::text || ' stocks'
    ELSE
      'team member cutelooked has ' || (boss * 1000)::text || ' stocks'
  END AS fact
FROM
  generate_series(1, 1000) as vedernikoff_team(crook),
  generate_series(1, 100) as cutelooked_team(boss);

statement ok
CREATE TEXT SEARCH DICTIONARY test_english(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true,
    norm = true
);

statement ok
CREATE INDEX clickclack_facts ON clickclack USING inverted(fact test_english);

query
SELECT * FROM clickclack_facts WHERE fact @@ ts_phrase('team member') ORDER BY fact;
----
100000 values hashing to 51603a4b63a2f41ba5f7eb9ea86a7bc0

query
SELECT * FROM clickclack_facts WHERE fact @@ ts_phrase('vedernikoff has') ORDER BY fact;
----
50000 values hashing to 8a9f7cf11ff6366dc2a455912f4875f2

query
SELECT * FROM clickclack_facts WHERE fact @@ ts_phrase('cutelooked has') ORDER BY fact;
----
50000 values hashing to 01cd7f94d0a1fefec052b3c3f4c08138

query
SELECT * FROM clickclack_facts WHERE fact @@ ts_phrase('has 0 stocks') ORDER BY fact;
----
400 values hashing to 281bddebb99a13518781132c8d56e194


statement ok
DROP TABLE clickclack;

statement ok
CREATE TABLE clickclack_pk (fact TEXT PRIMARY KEY, detail TEXT);

statement count 10000
INSERT INTO clickclack_pk
SELECT
  CASE
    WHEN rn % 2 = 0 THEN
      'team member vedernikoff has ' || rn::text || ' stocks'
    ELSE
      'team member cutelooked has ' || rn::text || ' stocks'
  END AS fact,
  CASE
    WHEN rn % 2 = 0 THEN
      'vedernikoff row ' || rn::text
    ELSE
      'cutelooked row ' || rn::text
  END AS detail
FROM
  generate_series(1, 10000) AS s(rn);

statement ok
CREATE INDEX clickclack_pk_facts ON clickclack_pk USING inverted(fact test_english, detail test_english);

query
SELECT * FROM clickclack_pk_facts WHERE fact @@ ts_phrase('team member') ORDER BY fact;
----
20000 values hashing to c5e18a8a07f65b8031c775e242239353

query
SELECT * FROM clickclack_pk_facts WHERE fact @@ ts_phrase('vedernikoff has') ORDER BY fact;
----
10000 values hashing to b74729795b45633d271483956071de12

query
SELECT * FROM clickclack_pk_facts WHERE fact @@ ts_phrase('cutelooked has') ORDER BY fact;
----
10000 values hashing to 1d8c44c6f3d932d3b08d276682b5124e

query
SELECT * FROM clickclack_pk_facts WHERE fact @@ ts_phrase('has 0 stocks') ORDER BY fact;
----

query
SELECT * FROM clickclack_pk_facts WHERE detail @@ ts_phrase('vedernikoff row') ORDER BY fact;
----
10000 values hashing to b74729795b45633d271483956071de12

query
SELECT * FROM clickclack_pk_facts WHERE detail @@ ts_phrase('cutelooked row') ORDER BY fact;
----
10000 values hashing to 1d8c44c6f3d932d3b08d276682b5124e

statement ok
DROP TABLE clickclack_pk;

control substitution on

# index on external text/csv table with large dataset

statement count 100000
CREATE TABLE csv_idx_src AS
SELECT
  CASE
    WHEN vedernikoff_team.crook % 2 = 0 THEN
      'team member vedernikoff has ' || (crook / 10)::text || ' stocks'
    ELSE
      'team member cutelooked has ' || (boss * 1000)::text || ' stocks'
  END AS fact,
  CASE
    WHEN vedernikoff_team.crook % 3 = 0 THEN
      'department alpha'
    ELSE
      'department beta'
  END AS dept
FROM
  generate_series(1, 1000) as vedernikoff_team(crook),
  generate_series(1, 100) as cutelooked_team(boss);

statement count 100000
COPY csv_idx_src TO '${__TEST_DIR__}/csv_idx_slow.csv' HEADER;

statement ok
CREATE VIEW csv_idx_ext AS
  SELECT * FROM read_csv('${__TEST_DIR__}/csv_idx_slow.csv');

statement ok
CREATE INDEX csv_idx_ext_facts ON csv_idx_ext USING inverted(fact test_english, dept test_english);

query
SELECT * FROM csv_idx_ext_facts WHERE fact @@ ts_phrase('team member') ORDER BY fact, dept;
----
200000 values hashing to 9cb9ed857b60c62c37a67c43dec58d3f

query
SELECT * FROM csv_idx_ext_facts WHERE fact @@ ts_phrase('vedernikoff has') ORDER BY fact, dept;
----
100000 values hashing to 32db853f00f4c041183880a0be769eac

query
SELECT * FROM csv_idx_ext_facts WHERE fact @@ ts_phrase('cutelooked has') ORDER BY fact, dept;
----
100000 values hashing to 31762b7effffa8f2df0d3cba0788543c

query
SELECT * FROM csv_idx_ext_facts WHERE dept @@ ts_phrase('department alpha') ORDER BY fact, dept;
----
66600 values hashing to d51b2e4d5287709b9d19c6f2ae68b715

statement ok
DROP VIEW csv_idx_ext;

statement ok
DROP TABLE csv_idx_src;


statement count 10000
CREATE TABLE dense_pq_slow_src AS
SELECT
  'every row shares this phrase plus detail number ' || s.n::text AS fact,
  CASE
    WHEN s.n % 3 = 0 THEN 'division alpha sector'
    WHEN s.n % 3 = 1 THEN 'division beta sector'
    ELSE 'division gamma sector'
  END AS division
FROM generate_series(1, 10000) AS s(n);

statement count 10000
COPY dense_pq_slow_src TO '${__TEST_DIR__}/dense_pq_slow.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW dense_pq_slow_ext AS
  SELECT * FROM read_parquet('${__TEST_DIR__}/dense_pq_slow.parquet');

statement ok
CREATE INDEX dense_pq_slow_idx ON dense_pq_slow_ext USING inverted(fact test_english, division test_english);

query
SELECT * FROM dense_pq_slow_idx WHERE fact @@ ts_phrase('every row shares') ORDER BY fact, division;
----
20000 values hashing to 564b0f1fcbf2e6bace7223478f98a782

query
SELECT * FROM dense_pq_slow_idx WHERE fact @@ ts_phrase('phrase plus detail') ORDER BY fact, division;
----
20000 values hashing to 564b0f1fcbf2e6bace7223478f98a782

query
SELECT fact FROM dense_pq_slow_idx WHERE division @@ ts_phrase('division alpha sector') ORDER BY fact;
----
3333 values hashing to f54ba4501dfcab26d4d914fb8d161a74

query
SELECT division FROM dense_pq_slow_idx WHERE division @@ ts_phrase('division beta sector') ORDER BY division;
----
3334 values hashing to 8bad37619523a21283df61bb5760c091

query
SELECT * FROM dense_pq_slow_idx WHERE division @@ ts_phrase('division gamma sector') ORDER BY fact, division;
----
6666 values hashing to 553f02e8d46b80d01e9a4b5727181deb

query
SELECT * FROM dense_pq_slow_idx WHERE fact @@ ts_phrase('every') AND division @@ ts_phrase('division alpha sector') ORDER BY fact, division;
----
6666 values hashing to 26f55af804b8a82ad1a8c5242cdc9aa1

query
SELECT * FROM dense_pq_slow_idx WHERE fact @@ ts_phrase('every') OR division @@ ts_phrase('division alpha sector') ORDER BY fact, division;
----
20000 values hashing to 564b0f1fcbf2e6bace7223478f98a782

statement ok
DROP VIEW dense_pq_slow_ext;

statement ok
DROP TABLE dense_pq_slow_src;


statement count 10000
CREATE TABLE dense_csv_slow_src AS
SELECT
  'universal text entry number ' || s.n::text || ' in dataset' AS content,
  CASE
    WHEN s.n % 2 = 0 THEN 'region north area'
    ELSE 'region south area'
  END AS region
FROM generate_series(1, 10000) AS s(n);

statement count 10000
