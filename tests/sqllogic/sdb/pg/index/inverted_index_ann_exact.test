statement ok
CREATE TABLE axoh (id INTEGER, emb FLOAT[2], a INTEGER, c VARCHAR);

statement ok
CREATE INDEX axoh_idx ON axoh
  USING inverted(id, emb hnsw (metric = 'l2', quant = 'none'), a, c);

statement ok
INSERT INTO axoh SELECT * FROM axo;

statement ok
VACUUM (FLUSH_TABLE) axoh;

