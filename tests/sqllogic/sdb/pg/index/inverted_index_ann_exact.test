control substitution on

# sdb_ann_exact: the vector search scores every stored vector instead of
# walking the index. The answer is what a brute-force ORDER BY computes, the
# plan says so, and a WHERE narrows the rows scored.

statement ok
CREATE TABLE ax (pk INTEGER PRIMARY KEY, emb FLOAT[8], label VARCHAR);

statement ok
CREATE INDEX ax_idx ON ax
  USING inverted(pk, label, emb hnsw (metric = 'l2', quant = 'sq8'));

statement ok
INSERT INTO ax SELECT i, [i::FLOAT, (i % 7)::FLOAT, 0, 0, 0, 0, 0, 0]::FLOAT[8],
  CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(3000) t(i);

statement ok
SET sdb_ann_force_exact = true;

query
EXPLAIN SELECT pk FROM ax_idx
  ORDER BY emb <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────╮
│ Index: ax_idx                       │
│ Lookup: search                      │
│ Score: l2_distance(emb, FLOAT[8])   │
│ Exact:                              │
│ brute force over the stored vectors │
│ Top: 3                              │
│ Projections: pk                     │
│ ~3,000 rows                         │
╰─────────────────────────────────────╯

# Exact and brute force agree row for row.
query
SELECT pk FROM ax_idx
  ORDER BY emb <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5;
----
pk
1501
1500
1502
1499
1503

statement ok
SET sdb_ann_force_exact = false;

query
SELECT pk FROM ax_idx
  ORDER BY emb::DOUBLE[8] <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::DOUBLE[8] LIMIT 5;
----
pk
1501
1500
1502
1499
1503

statement ok
SET sdb_ann_force_exact = true;

# An indexed predicate narrows the rows scored.
query
SELECT pk FROM ax_idx
  WHERE label = 'odd'
  ORDER BY emb <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
1501
1499
1503

# So does one nothing satisfies.
query
SELECT pk FROM ax_idx
  WHERE pk >= 3000
  ORDER BY emb <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk

# The distance is the exact one, not the quantized approximation.
query
SELECT pk, round((emb <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::FLOAT[8])::DOUBLE, 3) AS d FROM ax_idx
  ORDER BY emb <-> [1500.4, 3, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
pk	d
1501	0.6
1500	1.077

statement ok
RESET sdb_ann_force_exact;

statement ok
CREATE TABLE axl (pk INTEGER PRIMARY KEY, emb FLOAT[8], cat INTEGER);

statement ok
CREATE INDEX axl_idx ON axl
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO axl SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8], i % 10
  FROM range(2000) t(i);

statement ok
SET sdb_ann_force_exact = true;

query
SELECT pk FROM axl_idx WHERE cat = 1
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
101
91
111

statement ok
CREATE TABLE axn (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
CREATE INDEX axn_idx ON axn
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'usq8'));

statement ok
CREATE TABLE axr (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
CREATE INDEX axr_idx ON axr
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO axn
  SELECT i, [i, 1, 2, 3]::FLOAT[4] FROM range(0, 50, 5) t(i)
  UNION ALL SELECT i, NULL::FLOAT[4] FROM range(50) t(i) WHERE i % 5 <> 0
  ORDER BY 1;

statement ok
INSERT INTO axr SELECT * FROM axn;

query
SELECT pk FROM axn_idx ORDER BY emb <-> [0, 1, 2, 3]::FLOAT[4] LIMIT 20;
----
pk
0
5
10
15
20
25
30
35
40
45

query
SELECT pk FROM axr_idx ORDER BY emb <-> [0, 1, 2, 3]::FLOAT[4] LIMIT 20;
----
pk
0
5
10
15
20
25
30
35
40
45

statement ok
RESET sdb_ann_force_exact;

statement error invalid value for parameter "sdb_ann_rescore_width"
SET sdb_ann_rescore_width = 'inf';


# A WHERE that ORs an IS NULL test with a predicate on another column admits
# exactly its rows on every route: unflushed rows, IVF, the forced exact scan
# and HNSW, also when the index can't claim the predicate.
statement ok
CREATE TABLE axo (id INTEGER, emb FLOAT[2], a INTEGER, c VARCHAR);

statement ok
CREATE INDEX axo_idx ON axo
  USING inverted(id, emb ivf (metric = 'l2', quant = 'none'), a, c);

statement ok
INSERT INTO axo SELECT i, [i, 0]::FLOAT[2],
  CASE WHEN i % 10 = 0 THEN NULL ELSE i END, 'v' || i FROM range(1, 201) r(i);

query
SELECT id FROM axo WHERE a IS NULL OR c = 'v3'
  ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 5;
----
id
3
10
20
30
40

query
SELECT id FROM axo WHERE a IS NOT NULL OR c = 'v3'
  ORDER BY emb <-> [20.4, 0]::FLOAT[2] LIMIT 3;
----
id
21
19
22

query
SELECT id FROM axo WHERE (a + 0) IS NULL OR upper(c) = 'V3'
  ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 5;
----
id
3
10
20
30
40

statement ok
VACUUM (FLUSH_TABLE) axo;

query
SELECT id FROM axo WHERE a IS NULL OR c = 'v3'
  ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 5;
----
id
3
10
20
30
40

query
SELECT id FROM axo_idx WHERE (a + 0) IS NULL OR upper(c) = 'V3'
  ORDER BY id LIMIT 5;
----
id
3
10
20
30
40

statement ok
SET sdb_ann_force_exact = true;

