control substitution on

statement ok
CREATE TABLE ebl (pk INTEGER PRIMARY KEY, emb FLOAT[16], tag INTEGER);

statement ok
CREATE INDEX ebl_idx ON ebl
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'usq8'))
  INCLUDE (tag) WITH (compaction_interval = 0);

statement ok
CREATE TABLE ebi (pk INTEGER PRIMARY KEY, emb FLOAT[16], tag INTEGER);

statement ok
CREATE INDEX ebi_idx ON ebi
  USING inverted(pk, emb hnsw (metric = 'ip', quant = 'usq8'))
  INCLUDE (tag) WITH (compaction_interval = 0);

statement ok
CREATE TABLE ebc (pk INTEGER PRIMARY KEY, emb FLOAT[16], tag INTEGER);

statement ok
CREATE INDEX ebc_idx ON ebc
  USING inverted(pk, emb hnsw (metric = 'cosine', quant = 'sq8'))
  INCLUDE (tag) WITH (compaction_interval = 0);

statement ok
CREATE TABLE eb_src AS SELECT i AS pk,
  list_transform(range(16), j -> CASE WHEN i % 10 = 0
    THEN (1 + (((i * 1103515245 + j * 12345 + 6789) % 1000003)::DOUBLE
               / 1000003 - 0.5) * 0.02)::FLOAT
    ELSE ((((i * 1103515245 + j * 12345 + 6789) % 1000003)::DOUBLE
           / 1000003 - 0.5) * 4)::FLOAT END)::FLOAT[16] AS emb,
  i % 7 AS tag
  FROM range(4000) t(i);

statement ok
INSERT INTO ebl SELECT * FROM eb_src WHERE pk < 2000;

statement ok
INSERT INTO ebi SELECT * FROM eb_src WHERE pk < 2000;

statement ok
INSERT INTO ebc SELECT * FROM eb_src WHERE pk < 2000;

statement ok
VACUUM (REFRESH_TABLE) ebl;

statement ok
VACUUM (REFRESH_TABLE) ebi;

statement ok
VACUUM (REFRESH_TABLE) ebc;

statement ok
INSERT INTO ebl SELECT * FROM eb_src WHERE pk >= 2000;

statement ok
INSERT INTO ebi SELECT * FROM eb_src WHERE pk >= 2000;

statement ok
INSERT INTO ebc SELECT * FROM eb_src WHERE pk >= 2000;

