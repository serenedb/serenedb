statement ok
SET sdb_ann_force_exact = true;

query
WITH w AS (SELECT pk FROM ebl_idx
           ORDER BY emb <-> list_transform(range(16), j -> (1 + cos(j::DOUBLE) * 0.002)::FLOAT)::FLOAT[16]
           LIMIT 10),
     p AS (SELECT pk FROM ebl
           ORDER BY emb <-> list_transform(range(16), j -> (1 + cos(j::DOUBLE) * 0.002)::FLOAT)::FLOAT[16]
           LIMIT 10)
SELECT COUNT(*) FROM ((SELECT * FROM w EXCEPT SELECT * FROM p)
                      UNION ALL (SELECT * FROM p EXCEPT SELECT * FROM w)) d;
