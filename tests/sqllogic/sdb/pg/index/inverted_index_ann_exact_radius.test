statement ok
CREATE TABLE er_hnsw (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX er_hnsw_idx ON er_hnsw
  USING inverted(id, label, emb hnsw (metric = 'l2', quant = 'sq8'))
  INCLUDE (num);

statement ok
CREATE TABLE er_ivf (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX er_ivf_idx ON er_ivf
  USING inverted(id, label, emb ivf (metric = 'l2', quant = 'sq8'))
  INCLUDE (num);

statement ok
CREATE TABLE er_search (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, emb FLOAT[8])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX er_search_idx ON er_search
  USING inverted(id, label, num, extra, emb hnsw (metric = 'l2', quant = 'sq4'));

statement ok
INSERT INTO er_hnsw SELECT i, 'l' || (i % 10)::VARCHAR, i % 100, i % 10,
  [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(3000) t(i);

statement ok
VACUUM (REFRESH_TABLE) er_hnsw;

statement ok
INSERT INTO er_ivf SELECT * FROM er_hnsw;

statement ok
VACUUM (REFRESH_TABLE) er_ivf;

statement ok
INSERT INTO er_search SELECT * FROM er_hnsw;

statement ok
VACUUM (REFRESH_TABLE) er_search;

statement ok
SET sdb_ann_force_exact = true;

