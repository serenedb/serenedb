statement ok
SELECT pk FROM aev_ivf_cos ORDER BY emb <=> [1, 1]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_sq8 ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_usq8 ORDER BY emb <#> [0, 1]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_rabitq ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_tq ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_osq ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_bq ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_fp16 ORDER BY emb <-> [0, 0]::FLOAT[2] LIMIT 3;

statement ok
SELECT pk FROM aev_ivf ORDER BY emb <-> ['NaN'::FLOAT, 0]::FLOAT[2] LIMIT 3;

# A merge builds the indexes again from every row.
statement ok
INSERT INTO aev SELECT g, [g, g + 1]::FLOAT[2] FROM generate_series(401, 500) g;

statement ok
VACUUM (FLUSH_TABLE) aev;

statement ok
VACUUM (COMPACT_TABLE) aev;

query
SELECT pk FROM aev_ivf ORDER BY emb <-> [500, 501]::FLOAT[2] LIMIT 2;
----
pk
500
499

query
SELECT pk FROM aev_pq ORDER BY emb <-> [500, 501]::FLOAT[2] LIMIT 2;
----
pk
500
499

statement ok
SELECT pk FROM aev_sq8 ORDER BY emb <-> [500, 501]::FLOAT[2] LIMIT 2;

# A segment whose vectors are all equal has a zero range: usq8 still answers.
statement ok
CREATE TABLE aev_flat (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
CREATE INDEX aev_flat_cos ON aev_flat
  USING inverted(pk, emb hnsw (metric = 'cosine', quant = 'usq8'));

statement ok
CREATE INDEX aev_flat_ip ON aev_flat
  USING inverted(pk, emb hnsw (metric = 'ip', quant = 'usq8'));

statement ok
INSERT INTO aev_flat SELECT g, [2, 2, 2, 2]::FLOAT[4] FROM generate_series(1, 10) g;

statement ok
VACUUM (FLUSH_TABLE) aev_flat;

query
SELECT count(*) AS n FROM (SELECT pk FROM aev_flat_cos ORDER BY emb <=> [1, 2, 3, 4]::FLOAT[4] LIMIT 5);
----
n
5

query
SELECT count(*) AS n FROM (SELECT pk FROM aev_flat_ip ORDER BY emb <#> [1, 2, 3, 4]::FLOAT[4] LIMIT 5);
----
n
5
