statement ok
CREATE TABLE many_users AS SELECT i AS id,
  [(i % 300)::FLOAT + 0.25, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] AS emb FROM range(3000) t(i);

query
SELECT count(*), sum(s.pk) FROM many_users u
  JOIN songs_hnsw s NEAREST 2 BY DISTANCE u.emb <-> s.emb;
----
count	sum
6000	899980

query
SELECT count(*), sum(s.pk) FROM many_users u
  JOIN songs_ivf s NEAREST 2 BY DISTANCE u.emb <-> s.emb;
----
count	sum
6000	899980

# The outer side is a join; its columns pass through the search

statement ok
CREATE TABLE teams (id INTEGER, name VARCHAR);

statement ok
INSERT INTO teams VALUES (0, 'a team of even numbers'), (1, 'a team of odd numbers');

query
SELECT u.id, t.name, s.pk FROM users u JOIN teams t ON t.id = u.id % 2
  JOIN songs_ivf s NEAREST 1 BY DISTANCE u.emb <-> s.emb
  ORDER BY u.id;
----
id	name	pk
1	a team of odd numbers	10
2	a team of even numbers	151
4	a team of even numbers	299
5	a team of odd numbers	10

query
SELECT count(*) FROM users u
  JOIN songs_hnsw s NEAREST 3 BY DISTANCE u.emb <-> s.emb;
----
count
12

# LEFT keeps every outer row when the filter leaves nothing to find

query
SELECT u.id, n.pk FROM users u
  LEFT JOIN LATERAL (SELECT pk FROM songs_ivf WHERE cat = 7
                     ORDER BY emb <-> u.emb LIMIT 2) n ON TRUE
  ORDER BY u.id;
----
id	pk
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL

# A subquery output that reads the outer row keeps today's plan

query
SELECT n.uid, n.pk FROM users u,
  LATERAL (SELECT pk, u.id AS uid FROM songs_hnsw ORDER BY emb <-> u.emb LIMIT 1) n
  WHERE u.emb IS NOT NULL
  ORDER BY n.uid;
----
uid	pk
1	10
2	151
4	299
5	10

# One search fetches more distinct rows than a vector holds

statement ok
CREATE TABLE line (pk INTEGER PRIMARY KEY, tag INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX line_ivf ON line
  USING inverted(pk, emb ivf (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO line SELECT i, 2 * i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8]
  FROM range(10000) t(i);

statement ok
VACUUM (REFRESH_TABLE) line;

statement ok
CREATE TABLE spread_users AS SELECT i AS id,
  [(i * 100)::FLOAT + 0.25, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] AS emb
  FROM range(100) t(i);

query
SELECT count(*), count(DISTINCT l.pk), sum(l.tag) FROM spread_users u
  JOIN line_ivf l EXACT NEAREST 40 BY DISTANCE u.emb <-> l.emb;
----
count	count	sum
4000	4000	39605520

# A join the index cannot serve keeps its plan and its answer

query
SELECT u.id, n.pk FROM users u,
  LATERAL (SELECT pk FROM songs_hnsw ORDER BY emb <-> u.emb DESC LIMIT 1) n
  WHERE u.emb IS NOT NULL
  ORDER BY u.id;
----
id	pk
1	299
2	0
4	0
5	299

query
EXPLAIN SELECT u.id, n.pk FROM users u,
  LATERAL (SELECT pk FROM songs_hnsw ORDER BY emb <-> u.emb DESC LIMIT 1) n;
----
