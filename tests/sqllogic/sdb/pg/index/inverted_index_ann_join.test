control substitution on

# ============================================================================
# Nearest-neighbour joins through the vector index: NEAREST BY and a
# hand-written LATERAL top-k. Points lie on a line, so every outer vector has
# a unique ranking; quant = 'none' keeps the scores exact.
# ============================================================================

statement ok
CREATE TABLE songs (pk INTEGER PRIMARY KEY, cat INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX songs_hnsw ON songs
  USING inverted(pk, cat, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
CREATE INDEX songs_ivf ON songs
  USING inverted(pk, cat, emb ivf (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO songs SELECT i, i % 3,
  [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(300) t(i);

statement ok
VACUUM (REFRESH_TABLE) songs;

statement ok
CREATE TABLE users (id INTEGER, emb FLOAT[8]);

statement ok
INSERT INTO users VALUES
  (1, [10.4, 0, 0, 0, 0, 0, 0, 0]),
  (2, [150.6, 0, 0, 0, 0, 0, 0, 0]),
  (3, NULL),
  (4, [299.2, 0, 0, 0, 0, 0, 0, 0]),
  (5, [10.4, 0, 0, 0, 0, 0, 0, 0]);

# songs_hnsw: no keyword, APPROX, EXACT

query
SELECT u.id, s.pk FROM users u
  JOIN songs_hnsw s NEAREST 3 BY DISTANCE u.emb <-> s.emb
  ORDER BY u.id, s.pk;
----
id	pk
1	9
1	10
1	11
2	150
2	151
2	152
4	297
4	298
4	299
5	9
5	10
5	11

query
SELECT u.id, s.pk FROM users u
  JOIN songs_hnsw s APPROX NEAREST 3 BY DISTANCE u.emb <-> s.emb
  ORDER BY u.id, s.pk;
----
id	pk
1	9
1	10
1	11
2	150
2	151
2	152
4	297
4	298
4	299
5	9
5	10
5	11

query
SELECT u.id, s.pk FROM users u
  JOIN songs_hnsw s EXACT NEAREST 3 BY DISTANCE u.emb <-> s.emb
  ORDER BY u.id, s.pk;
----
id	pk
1	9
1	10
1	11
2	150
2	151
2	152
4	297
4	298
4	299
5	9
5	10
5	11

query
SELECT u.id, s.pk FROM users u
  LEFT JOIN songs_hnsw s NEAREST 2 BY DISTANCE u.emb <-> s.emb
  ORDER BY u.id, s.pk;
----
id	pk
1	10
1	11
2	150
2	151
3	NULL
4	298
4	299
5	10
5	11

query
SELECT u.id, n.pk, round(n.d, 3) AS d FROM users u,
  LATERAL (SELECT pk, emb <-> u.emb AS d FROM songs_hnsw ORDER BY d LIMIT 2) n
  ORDER BY u.id, n.d;
----
id	pk	d
1	10	0.4
1	11	0.6
2	151	0.4
2	150	0.6
4	299	0.2
4	298	1.2
5	10	0.4
5	11	0.6

query
SELECT u.id, n.pk FROM users u,
  LATERAL (SELECT pk FROM songs_hnsw WHERE cat = 1 ORDER BY emb <-> u.emb LIMIT 2) n
  ORDER BY u.id, n.pk;
----
id	pk
1	10
1	13
2	148
2	151
4	295
4	298
5	10
5	13

