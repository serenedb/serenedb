statement ok
CREATE TABLE lw_hnsw (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, rare INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX lw_hnsw_idx ON lw_hnsw
  USING inverted(id, label, emb hnsw (metric = 'l2', quant = 'sq8'))
  INCLUDE (num);

statement ok
CREATE TABLE lw_ivf (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, rare INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX lw_ivf_idx ON lw_ivf
  USING inverted(id, label, emb ivf (metric = 'l2', quant = 'sq8'))
  INCLUDE (num);

statement ok
CREATE TABLE lw_flat (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, rare INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX lw_flat_idx ON lw_flat
  USING inverted(id, label, emb ivf (metric = 'l2', quant = 'none'))
  INCLUDE (num);

statement ok
INSERT INTO lw_hnsw SELECT i, 'l' || (i % 10)::VARCHAR, i % 100, i % 10,
  i % 1000, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(1500) t(i);

statement ok
VACUUM (REFRESH_TABLE) lw_hnsw;

statement ok
INSERT INTO lw_hnsw SELECT i, 'l' || (i % 10)::VARCHAR, i % 100, i % 10,
  i % 1000, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(1500, 3000) t(i);

statement ok
VACUUM (REFRESH_TABLE) lw_hnsw;

statement ok
INSERT INTO lw_ivf SELECT * FROM lw_hnsw;

statement ok
VACUUM (REFRESH_TABLE) lw_ivf;

statement ok
INSERT INTO lw_flat SELECT * FROM lw_hnsw;

statement ok
VACUUM (REFRESH_TABLE) lw_flat;

