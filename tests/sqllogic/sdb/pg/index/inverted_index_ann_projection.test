statement ok
CREATE TABLE pj_hnsw (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX pj_hnsw_idx ON pj_hnsw
  USING inverted(id, label, emb hnsw (metric = 'l2', quant = 'sq8'))
  INCLUDE (num);

statement ok
CREATE TABLE pj_ivf (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, emb FLOAT[8]);

statement ok
CREATE INDEX pj_ivf_idx ON pj_ivf
  USING inverted(id, label, emb ivf (metric = 'l2', quant = 'sq8'))
  INCLUDE (num);

statement ok
CREATE TABLE pj_search (id INTEGER PRIMARY KEY, label VARCHAR, num INTEGER,
  extra INTEGER, emb FLOAT[8])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX pj_search_idx ON pj_search
  USING inverted(id, label, num, extra, emb ivf (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO pj_hnsw SELECT i, 'l' || (i % 10)::VARCHAR, i % 100, i % 10,
  [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(3000) t(i);

statement ok
VACUUM (REFRESH_TABLE) pj_hnsw;

statement ok
INSERT INTO pj_ivf SELECT * FROM pj_hnsw;

statement ok
VACUUM (REFRESH_TABLE) pj_ivf;

statement ok
INSERT INTO pj_search SELECT * FROM pj_hnsw;

statement ok
VACUUM (REFRESH_TABLE) pj_search;

query
SELECT count(*) AS n, round(sum(d))::BIGINT AS s FROM (
  SELECT emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] AS d FROM pj_hnsw_idx
) t;
----
n	s
3000	2250001

