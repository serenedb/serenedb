CREATE TABLE sp_hnsw (pk INTEGER PRIMARY KEY, cat TEXT, emb FLOAT[3]);

statement ok
CREATE INDEX sp_hnsw_idx ON sp_hnsw
  USING inverted(pk, cat, emb hnsw (metric = 'l2', quant = 'sq8'));

statement ok
CREATE TABLE sp_ivf (pk INTEGER PRIMARY KEY, cat TEXT, emb FLOAT[3]);

statement ok
CREATE INDEX sp_ivf_idx ON sp_ivf
  USING inverted(pk, cat, emb ivf (metric = 'l2', quant = 'sq8'));

