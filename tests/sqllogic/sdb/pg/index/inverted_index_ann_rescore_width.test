statement ok
CREATE TABLE rw (pk INTEGER PRIMARY KEY, emb FLOAT[8])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rw_hnsw ON rw
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'sq8'));

statement ok
CREATE TABLE rwi (pk INTEGER PRIMARY KEY, emb FLOAT[8])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rwi_ivf ON rwi
  USING inverted(pk, emb ivf (metric = 'l2', quant = 'sq8'));

statement ok
INSERT INTO rw
  SELECT i, [100 + i * 0.04, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(10) t(i)
  UNION ALL SELECT 100, [0, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8]
  UNION ALL SELECT 101, [255, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8];

statement ok
