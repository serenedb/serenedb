statement ok
CREATE TABLE zl2 (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
INSERT INTO zl2 VALUES (1, [1, 2, 3, 4]), (2, [5, 6, 7, 8]), (3, [0, 0, 0, 0]), (4, [0, 1, 0, 0]);

statement ok
CREATE INDEX zl2_idx ON zl2 USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
CREATE TABLE zl1 (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
INSERT INTO zl1 SELECT * FROM zl2;

statement ok
CREATE INDEX zl1_idx ON zl1 USING inverted(pk, emb hnsw (metric = 'l1', quant = 'none'));

statement ok
CREATE TABLE zip (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
INSERT INTO zip SELECT * FROM zl2;

statement ok
CREATE INDEX zip_idx ON zip USING inverted(pk, emb hnsw (metric = 'ip', quant = 'none'));

statement ok
VACUUM (REFRESH_TABLE) zl2;

statement ok
VACUUM (REFRESH_TABLE) zl1;

statement ok
VACUUM (REFRESH_TABLE) zip;

query
SELECT pk, emb <-> [1, 2, 3, 4]::FLOAT[4] AS d
FROM zl2_idx ORDER BY emb <-> [1, 2, 3, 4]::FLOAT[4] LIMIT 1;
----
pk	d
1	0

query
SELECT pk, l2_sqr_distance(emb, [1, 2, 3, 4]::FLOAT[4]) AS d
FROM zl2_idx ORDER BY l2_sqr_distance(emb, [1, 2, 3, 4]::FLOAT[4]) LIMIT 1;
----
pk	d
1	0

query
SELECT pk, l2_norm(emb) AS d FROM zl2_idx ORDER BY l2_norm(emb) LIMIT 1;
----
pk	d
3	0

query
SELECT pk, emb <+> [1, 2, 3, 4]::FLOAT[4] AS d
