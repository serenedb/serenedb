d
-0

query
SELECT pk, emb <+> [1, 2, 3, 4]::FLOAT[4] AS d FROM zl1_idx
WHERE emb <+> [1, 2, 3, 4]::FLOAT[4] <= 9 ORDER BY emb <+> [1, 2, 3, 4]::FLOAT[4] LIMIT 4;
----
pk	d
1	0
4	9

query
EXPLAIN SELECT pk, emb <+> [1, 2, 3, 4]::FLOAT[4] AS d FROM zl1_idx
WHERE emb <+> [1, 2, 3, 4]::FLOAT[4] <= 9 ORDER BY emb <+> [1, 2, 3, 4]::FLOAT[4] LIMIT 4;
----
