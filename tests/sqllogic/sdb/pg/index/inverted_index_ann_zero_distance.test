query
SELECT pk, emb <#> [1, 0, 0, 0]::FLOAT[4] AS d
FROM zip_idx WHERE pk = 4 ORDER BY emb <#> [1, 0, 0, 0]::FLOAT[4] LIMIT 1;
----
pk	d
4	-0

query
SELECT [0, 1, 0, 0]::FLOAT[4] <#> [1, 0, 0, 0]::FLOAT[4] AS d;
