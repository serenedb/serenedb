# Background refresh and compaction follow ALTER at once: disabling stops the
# loop before its next tick, and a rolled-back ALTER leaves the options that
# were in effect before it.


statement ok
CREATE TABLE ibs(id INTEGER, t TEXT);


statement ok
CREATE INDEX ibs_idx ON ibs USING inverted(t) WITH (refresh_interval = 2000, compaction_interval = 0);


statement count 5
INSERT INTO ibs SELECT g, 'common' FROM generate_series(1, 5) g;


query ok retry 60 backoff 200ms
SELECT count(*) FROM ibs_idx;
----
count
5


statement ok
ALTER INDEX ibs_idx SET (refresh_interval = 0);


statement count 5
INSERT INTO ibs SELECT g, 'common' FROM generate_series(6, 10) g;


sleep 3s


query
SELECT count(*) FROM ibs_idx;
----
count
5


statement ok
VACUUM (REFRESH_TABLE) ibs;


query
SELECT count(*) FROM ibs_idx;
----
count
10


statement ok
CREATE TABLE ibc(id INTEGER, t TEXT);


statement ok
CREATE INDEX ibc_idx ON ibc USING inverted(t) WITH (refresh_interval = 100, compaction_interval = 0);


statement ok
INSERT INTO ibc VALUES (1, 'one common');


statement ok
VACUUM (REFRESH_TABLE) ibc;


statement ok
INSERT INTO ibc VALUES (2, 'two common');


statement ok
VACUUM (REFRESH_TABLE) ibc;


statement ok
INSERT INTO ibc VALUES (3, 'three common');


statement ok
VACUUM (REFRESH_TABLE) ibc;


statement ok
BEGIN;


statement ok
ALTER INDEX ibc_idx SET (compaction_interval = 100);


statement ok
ROLLBACK;


sleep 2s


query
SELECT value AS segments FROM sdb_metrics
WHERE metric = 'num_segments' AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'ibc_idx');
----
segments
3


statement ok
ALTER INDEX ibc_idx SET (compaction_interval = 100);


query ok retry 60 backoff 200ms
SELECT value AS segments FROM sdb_metrics
WHERE metric = 'num_segments' AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'ibc_idx');
----
segments
1


statement ok
BEGIN;


statement ok
ALTER INDEX ibc_idx SET (compaction_interval = 0);


statement ok
ROLLBACK;


statement ok
INSERT INTO ibc VALUES (4, 'four common');


statement ok
VACUUM (REFRESH_TABLE) ibc;


statement ok
INSERT INTO ibc VALUES (5, 'five common');


statement ok
VACUUM (REFRESH_TABLE) ibc;


query ok retry 60 backoff 200ms
SELECT value AS segments FROM sdb_metrics
WHERE metric = 'num_segments' AND relation_id = (SELECT oid FROM pg_class WHERE relname = 'ibc_idx');
----
segments
1


statement ok
CREATE TABLE sbs(id INTEGER, t TEXT) WITH (storage = 'search', refresh_interval = 2000);


statement count 5
INSERT INTO sbs SELECT g, 'common' FROM generate_series(1, 5) g;


query ok retry 60 backoff 200ms
SELECT count(*) FROM sbs;
----
count
5


statement ok
ALTER TABLE sbs SET (refresh_interval = 0);


statement count 5
INSERT INTO sbs SELECT g, 'common' FROM generate_series(6, 10) g;


sleep 3s


query
SELECT count(*) FROM sbs;
----
count
5


statement ok
ALTER TABLE sbs RESET (refresh_interval);


query ok retry 60 backoff 200ms
SELECT count(*) FROM sbs;
----
count
10


statement ok
DROP TABLE ibs;


statement ok
DROP TABLE ibc;


statement ok
DROP TABLE sbs;
