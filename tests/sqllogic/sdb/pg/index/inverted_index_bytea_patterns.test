statement ok
CREATE TEXT SEARCH DICTIONARY bp_wild AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY bp_wild_pos AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)
    WITH (frequency, position)

statement ok
CREATE TABLE bp (id INTEGER PRIMARY KEY, v BYTEA)

statement ok
INSERT INTO bp VALUES
    (1, 'beast'),
    (2, '\x6d72ff6265617374'),
    (3, '\xc3bf'),
    (4, '\x6265617374ff'),
    (5, '\x62ff6561ff7374'),
    (6, '\x6265617374c3')

statement ok
CREATE INDEX bp_wild_idx ON bp USING inverted (id, v bp_wild)

statement ok
CREATE INDEX bp_wild_pos_idx ON bp USING inverted (id, v bp_wild_pos)

statement ok
CREATE INDEX bp_kw_idx ON bp USING inverted (id, v)

query
SELECT 'scan' AS src, list(id ORDER BY id) AS ids FROM bp WHERE v LIKE '%beast%'
UNION ALL SELECT 'wild', list(id ORDER BY id) FROM bp_wild_idx WHERE v @@ ts_like('%beast%')
UNION ALL SELECT 'wild_pos', list(id ORDER BY id) FROM bp_wild_pos_idx WHERE v @@ ts_like('%beast%')
UNION ALL SELECT 'keyword', list(id ORDER BY id) FROM bp_kw_idx WHERE v @@ ts_like('%beast%')
ORDER BY src
----
src	ids
keyword	{1,2,4,6}
scan	{1,2,4,6}
wild	{1,2,4,6}
wild_pos	{1,2,4,6}

