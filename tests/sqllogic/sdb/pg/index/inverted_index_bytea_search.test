# ts_any and ts_all take BYTEA lists and lists that mix BYTEA with strings or
# TSQUERY values.
query
SELECT id FROM bt WHERE v @@ ts_any(['\xff61'::bytea, '\xc3'::bytea]) ORDER BY id
----
id
1
5

query
SELECT id FROM bt WHERE v @@ ts_any(['\x6262'::bytea, '\xc3a9'::bytea]) ORDER BY id
----
id
2
3

query
SELECT id FROM bt WHERE v @@ ts_any(['\xff61'::bytea, 'bb']) ORDER BY id
----
id
1
2

query
SELECT id FROM bt WHERE v @@ ts_any([ts_phrase('bb'), '\xff61'::bytea]) ORDER BY id
----
id
1
2

query
SELECT id FROM bt WHERE v @@ ts_any(['\xff61'::bytea, ts_starts_with('\xe4'::bytea)]) ORDER BY id
----
id
1
6
7

query
SELECT id FROM bt WHERE v @@ ts_all(['\xff61'::bytea]) ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ ts_all([ts_starts_with('\xff'::bytea), '\xff61'::bytea]) ORDER BY id
----
id
1

