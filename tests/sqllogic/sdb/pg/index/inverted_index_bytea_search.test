SELECT '\xff61'::bytea::TSQUERY
----
db error: ERROR: BYTEA that is not valid UTF-8 cannot be cast to TSQUERY
HINT: Match the BYTEA value in an @@ match instead, e.g. col @@ '\xff61'::bytea.


query
SELECT i, b::TSQUERY IS NULL AS missing FROM (VALUES (1, NULL::bytea), (2, '\x61'::bytea)) v(i, b) ORDER BY i
----
i	missing
1	t
2	f

# A || of strings known only per row is a concatenation, with no TSQUERY to
# match.
statement error
SELECT id FROM bt WHERE v @@ (random()::VARCHAR || 'x')
----
db error: ERROR: Not a TSQUERY-producing function: ||
HINT: Use a TSQUERY constructor (ts_phrase, ts_like, ts_between, ts_ngram, ts_levenshtein, ts_regexp, ts_any, ts_all, ts_compound, ...) or 'literal'::TSQUERY.


statement error
SELECT id FROM bt WHERE v @@ ((random()::VARCHAR || 'x')::TSQUERY || 'bb'::TSQUERY)::min_match(1)
----
db error: ERROR: Not a TSQUERY-producing function: ||
HINT: Use a TSQUERY constructor (ts_phrase, ts_like, ts_between, ts_ngram, ts_levenshtein, ts_regexp, ts_any, ts_all, ts_compound, ...) or 'literal'::TSQUERY.


statement ok
CREATE TEXT SEARCH DICTIONARY bt_words AS split_text(case := 'lower') WITH (frequency, position)

statement ok
CREATE TABLE bp(id INTEGER PRIMARY KEY, p BYTEA)

statement ok
CREATE INDEX bp_idx ON bp USING inverted(id, p bt_words)

statement ok
