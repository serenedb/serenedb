statement ok
CREATE TEXT SEARCH DICTIONARY bt_bigram AS generate_ngrams(min_gram := 2, max_gram := 2, preserve_original := false) WITH (frequency, position)

statement ok
CREATE TABLE bg(id INTEGER PRIMARY KEY, g VARCHAR)

statement ok
CREATE INDEX bg_idx ON bg USING inverted(id, g bt_bigram)

statement ok
INSERT INTO bg VALUES (1, 'hello'), (2, 'help')

query
SELECT id FROM bg WHERE ngram_matches(g, 'hello'::bytea, 1.0) ORDER BY id
----
id
1

statement ok
CREATE TABLE bgb(id INTEGER PRIMARY KEY, g BYTEA)

statement ok
CREATE INDEX bgb_idx ON bgb USING inverted(id, g bt_bigram)

statement ok
INSERT INTO bgb VALUES (1, '\xff6162'::bytea), (2, 'hello'::bytea)

query
SELECT id FROM bgb WHERE ngram_matches(g, '\xff6162'::bytea, 1.0) ORDER BY id
----
id
1

query
SELECT id FROM bgb WHERE g @@ ts_ngram('\xff6162'::bytea) ORDER BY id
----
id
1

