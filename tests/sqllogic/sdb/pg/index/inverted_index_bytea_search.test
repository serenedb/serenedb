# Highlighting, offsets and score explanations of a BYTEA query.
statement ok
CREATE TEXT SEARCH DICTIONARY bt_words_hl AS split_text(case := 'lower') WITH (frequency, position, offset)

statement ok
CREATE TABLE bh(id INTEGER PRIMARY KEY, t VARCHAR)

statement ok
CREATE INDEX bh_idx ON bh USING inverted(id, t bt_words_hl)

statement ok
INSERT INTO bh VALUES (1, 'the quick fox'), (2, 'a lazy dog')

query
SELECT ts_highlight(t) AS h FROM bh_idx WHERE t @@ ts_starts_with('qu'::bytea) ORDER BY id
----
h
the <b>quick</b> fox

query
SELECT ts_highlight('bt_words_hl', 'the quick fox', ts_starts_with('qu'::bytea)) AS h
----
h
the <b>quick</b> fox

query
SELECT id, ts_offsets(t) AS offsets FROM bh_idx WHERE t @@ ts_levenshtein('quik'::bytea, 1) ORDER BY id
----
id	offsets
1	{4,9}

query
SELECT id, ts_explain(bh_idx.tableoid) IS NOT NULL AS explained, BM25(bh_idx.tableoid) > 0 AS scored
FROM bh_idx
WHERE t @@ ts_levenshtein('quick'::bytea, 1)
ORDER BY id
----
id	explained	scored
1	t	t

# A byte that is not part of a valid UTF-8 character is a segment of its own
# for split_text, like a punctuation mark: alpha drops it, graphic keeps it.
# Indexing and querying split the same way.
statement ok
CREATE TEXT SEARCH DICTIONARY bt_graphic AS split_text(break := 'graphic')

query
SELECT list_transform(ts_lexize('bt_words', '\x6162ff6364'::bytea), lambda x: hex(x)) AS alpha,
       list_transform(ts_lexize('bt_graphic', '\x6162ff6364'::bytea), lambda x: hex(x)) AS graphic
----
alpha	graphic
{6162,6364}	{6162,FF,6364}

