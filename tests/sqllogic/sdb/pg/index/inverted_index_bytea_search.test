# Search with BYTEA input: on a BYTEA column a BYTEA value matches its bytes,
# whether or not they are valid UTF-8.

statement ok
CREATE TABLE bt(id INTEGER PRIMARY KEY, v BYTEA)

statement ok
CREATE INDEX bt_idx ON bt USING inverted(id, v)

statement ok
INSERT INTO bt VALUES
  (1, '\xff61'::bytea),
  (2, '\x6262'::bytea),
  (3, '\xc3a9'::bytea),
  (4, '\x65'::bytea),
  (5, '\xc3'::bytea),
  (6, '\xe4b8ad'::bytea),
  (7, '\xe4b8'::bytea)

query
SELECT id FROM bt WHERE v @@ '\x6262'::bytea ORDER BY id
----
id
2

query
SELECT id FROM bt WHERE v @@ '\xff61'::bytea ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ '\xff61'::bytea::TSQUERY ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ ('\x6262'::bytea || ts_starts_with('\xe4'::bytea)) ORDER BY id
----
id
2
6
7

query
SELECT id FROM bt WHERE v @@ (ts_starts_with('\xe4'::bytea) || '\xff61'::bytea) ORDER BY id
----
id
1
6
7

query
SELECT id FROM bt WHERE v @@ ('\xff61'::bytea && !!ts_starts_with('\xe4'::bytea)) ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ (ts_starts_with('\xff'::bytea) && '\xff61'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ (!!('\xff61'::bytea)) ORDER BY id
----
id
2
3
4
5
6
7

query
SELECT id FROM bt WHERE v @@ ('\xff61'::bytea ^ 2) ORDER BY id
----
id
1

# A BYTEA value concatenates with another value or a string, as two strings
# do; with a TSQUERY operand || is an OR.
query
SELECT id FROM bt WHERE v @@ ('\xe4'::bytea || '\xb8ad'::bytea) ORDER BY id
----
id
6

query
SELECT id FROM bt WHERE v @@ ('\xff'::bytea || 'a') ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ ('\xff61'::bytea || 'bb'::TSQUERY) ORDER BY id
----
id
1
2

query
SELECT id FROM bt WHERE v @@ ('bb'::TSQUERY || '\xff61'::bytea) ORDER BY id
----
id
1
2

query
SELECT id FROM bt WHERE v @@ (ts_phrase('bb') || '\xff61'::bytea || ts_phrase('e')) ORDER BY id
----
id
1
2
4

query
SELECT id FROM bt WHERE v @@ ('\x6262'::bytea && 'bb') ORDER BY id
----
id
2

query
SELECT id FROM bt WHERE v @@ ('bb' && '\x6262'::bytea) ORDER BY id
----
id
2

statement ok
PREPARE bt_match AS SELECT id FROM bt WHERE v @@ $1 ORDER BY id;

query
EXECUTE bt_match('\xff61'::bytea);
----
id
1

statement ok
PREPARE bt_match_or AS SELECT id FROM bt WHERE v @@ ($1::bytea || ts_starts_with('\x62'::bytea)) ORDER BY id;

query
EXECUTE bt_match_or('\xff61'::bytea);
----
id
1
2

