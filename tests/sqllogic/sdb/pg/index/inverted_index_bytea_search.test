# A phrase part next to a BYTEA part is matched as written, also when the
# other part is a constructor or a nested phrase.
query
SELECT id FROM bx WHERE t @@ (ts_phrase('quick') ## ts_starts_with('\x66'::bytea)) ORDER BY id
----
id
1

query
SELECT id FROM bx WHERE t @@ (ts_phrase('the quick') ## '\x666f78'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bx WHERE t @@ (ts_like('qu%') ## ts_phrase('fox'::bytea)) ORDER BY id
----
id
1

query
SELECT id FROM bx WHERE t @@ ((ts_phrase('the') ## 'quick') ## 'fox'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bx WHERE t @@ (ts_phrase('the') ## (ts_phrase('quick') ## ts_starts_with('\x66'::bytea))) ORDER BY id
----
id
1

