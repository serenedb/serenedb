# Search with BYTEA input: on a BYTEA column a BYTEA value matches its bytes,
# whether or not they are valid UTF-8.

statement ok
CREATE TABLE bt(id INTEGER PRIMARY KEY, v BYTEA)

statement ok
CREATE INDEX bt_idx ON bt USING inverted(id, v)

statement ok
INSERT INTO bt VALUES
  (1, '\xff61'::bytea),
  (2, '\x6262'::bytea),
  (3, '\xc3a9'::bytea),
  (4, '\x65'::bytea),
  (5, '\xc3'::bytea),
  (6, '\xe4b8ad'::bytea),
  (7, '\xe4b8'::bytea)

query
SELECT id FROM bt WHERE v @@ '\x6262'::bytea ORDER BY id
----
id
2

query
SELECT id FROM bt WHERE v @@ '\xff61'::bytea ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ '\xff61'::bytea::TSQUERY ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ ('\x6262'::bytea || ts_starts_with('\xe4'::bytea)) ORDER BY id
----
id
2
6
7

query
SELECT id FROM bt WHERE v @@ (ts_starts_with('\xe4'::bytea) || '\xff61'::bytea) ORDER BY id
----
id
1
6
7

query
SELECT id FROM bt WHERE v @@ ('\xff61'::bytea && !!ts_starts_with('\xe4'::bytea)) ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ (ts_starts_with('\xff'::bytea) && '\xff61'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ (!!('\xff61'::bytea)) ORDER BY id
----
id
2
3
4
5
6
7

query
SELECT id FROM bt WHERE v @@ ('\xff61'::bytea ^ 2) ORDER BY id
----
id
1

# A BYTEA value concatenates with another value or a string, as two strings
# do; with a TSQUERY operand || is an OR.
query
SELECT id FROM bt WHERE v @@ ('\xe4'::bytea || '\xb8ad'::bytea) ORDER BY id
----
id
6

query
SELECT id FROM bt WHERE v @@ ('\xff'::bytea || 'a') ORDER BY id
----
id
1

query
SELECT id FROM bt WHERE v @@ ('\xff61'::bytea || 'bb'::TSQUERY) ORDER BY id
----
id
1
2

query
SELECT id FROM bt WHERE v @@ ('bb'::TSQUERY || '\xff61'::bytea) ORDER BY id
----
id
1
2

query
SELECT id FROM bt WHERE v @@ (ts_phrase('bb') || '\xff61'::bytea || ts_phrase('e')) ORDER BY id
----
id
1
2
4

query
SELECT id FROM bt WHERE v @@ ('\x6262'::bytea && 'bb') ORDER BY id
----
id
2

query
SELECT id FROM bt WHERE v @@ ('bb' && '\x6262'::bytea) ORDER BY id
----
id
2

statement ok
PREPARE bt_match AS SELECT id FROM bt WHERE v @@ $1 ORDER BY id;

query
EXECUTE bt_match('\xff61'::bytea);
----
id
1

statement ok
PREPARE bt_match_or AS SELECT id FROM bt WHERE v @@ ($1::bytea || ts_starts_with('\x62'::bytea)) ORDER BY id;

query
EXECUTE bt_match_or('\xff61'::bytea);
----
id
1
2

statement error
SELECT '\xff61'::bytea::TSQUERY
----
db error: ERROR: BYTEA that is not valid UTF-8 cannot be cast to TSQUERY
HINT: Match the BYTEA value in an @@ match instead, e.g. col @@ '\xff61'::bytea.


query
SELECT i, b::TSQUERY IS NULL AS missing FROM (VALUES (1, NULL::bytea), (2, '\x61'::bytea)) v(i, b) ORDER BY i
----
i	missing
1	t
2	f

# A || of strings known only per row is a concatenation, with no TSQUERY to
# match.
statement error
SELECT id FROM bt WHERE v @@ (random()::VARCHAR || 'x')
----
db error: ERROR: Not a TSQUERY-producing function: ||
HINT: Use a TSQUERY constructor (ts_phrase, ts_like, ts_between, ts_ngram, ts_levenshtein, ts_regexp, ts_any, ts_all, ts_compound, ...) or 'literal'::TSQUERY.


statement error
SELECT id FROM bt WHERE v @@ ((random()::VARCHAR || 'x')::TSQUERY || 'bb'::TSQUERY)::min_match(1)
----
db error: ERROR: Not a TSQUERY-producing function: ||
HINT: Use a TSQUERY constructor (ts_phrase, ts_like, ts_between, ts_ngram, ts_levenshtein, ts_regexp, ts_any, ts_all, ts_compound, ...) or 'literal'::TSQUERY.


statement ok
CREATE TEXT SEARCH DICTIONARY bt_words AS split_text(case := 'lower') WITH (frequency, position)

statement ok
CREATE TABLE bp(id INTEGER PRIMARY KEY, p BYTEA)

statement ok
CREATE INDEX bp_idx ON bp USING inverted(id, p bt_words)

statement ok
INSERT INTO bp VALUES (1, 'quick fox'::bytea), (2, 'fox quick'::bytea)

query
SELECT id FROM bp WHERE p @@ ('quick'::bytea ## 'fox'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bp WHERE p @@ ('quick'::bytea ## ts_phrase('fox')) ORDER BY id
----
id
1

query
SELECT id FROM bp WHERE p @@ tsquery_phrase('quick'::bytea, 'fox'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bp WHERE p @@ ('quick'::bytea ## 'fox') ORDER BY id
----
id
1

query
SELECT id FROM bp WHERE p @@ ('quick' ## 'fox'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM bp WHERE p @@ ('fox'::bytea ## 0 ## 'quick') ORDER BY id
----
id
2

query
SELECT id FROM bp WHERE p @@ ('fox'::bytea ## [0, 1] ## 'quick'::bytea) ORDER BY id
----
id
2

query
SELECT id FROM bp WHERE p @@ tsquery_phrase('quick'::bytea, 'fox') ORDER BY id
----
id
1

query
SELECT id FROM bp WHERE p @@ tsquery_phrase('quick', 'fox'::bytea) ORDER BY id
----
id
1

statement ok
CREATE TABLE bx(id INTEGER PRIMARY KEY, t VARCHAR)

statement ok
CREATE INDEX bx_idx ON bx USING inverted(id, t bt_words)

statement ok
INSERT INTO bx VALUES (1, 'the quick fox'), (2, 'a lazy dog'), (3, 'foxdog')

query
SELECT id FROM bx WHERE t @@ ('quick'::bytea || ts_phrase('dog')) ORDER BY id
----
id
1
2

query
SELECT id FROM bx WHERE t @@ (ts_phrase('dog') || 'quick'::bytea) ORDER BY id
----
id
1
2

query
SELECT id FROM bx WHERE t @@ ('quick'::bytea || 'dog'::TSQUERY) ORDER BY id
----
id
1
2

query
SELECT id FROM bx WHERE t @@ ('quick'::bytea && 'fox') ORDER BY id
----
id
1

query
SELECT id FROM bx WHERE t @@ ('quick'::bytea ## 'fox') ORDER BY id
----
id
1

# A BYTEA pattern matches bytes on any column: `_` and `.` are one byte, also
# right after a byte that starts a UTF-8 sequence. A text pattern matches
# characters on a text column.
query
SELECT id FROM bt WHERE v @@ ts_like('\xc35f'::bytea) ORDER BY id
----
id
3

query
SELECT id FROM bt WHERE v @@ ts_like('\xe45f5f'::bytea) ORDER BY id
----
id
6

query
SELECT id FROM bt WHERE v @@ ts_like('\xe425'::bytea) ORDER BY id
----
id
6
7

query
SELECT id FROM bt WHERE v @@ ts_like('__') ORDER BY id
----
id
1
2
3
7

query
SELECT id FROM bt WHERE v @@ ts_regexp('\xc32e'::bytea) ORDER BY id
----
id
3

query
SELECT id FROM bt WHERE v @@ ts_regexp('\xe42e2a'::bytea) ORDER BY id
----
id
6
7

statement ok
CREATE TABLE bk(id INTEGER PRIMARY KEY, k VARCHAR)

statement ok
CREATE INDEX bk_idx ON bk USING inverted(id, k)

statement ok
INSERT INTO bk VALUES (1, 'a'), (2, 'ab'), (3, 'é'), (4, '中'), (5, 'x')

query
SELECT id FROM bk WHERE k @@ ts_like('\xc35f'::bytea) ORDER BY id
----
id
3

query
SELECT id FROM bk WHERE k @@ ts_like('_'::bytea) ORDER BY id
----
id
1
5

query
SELECT id FROM bk WHERE k @@ ts_like('__'::bytea) ORDER BY id
----
id
2
3

query
SELECT id FROM bk WHERE k @@ ts_like('_') ORDER BY id
----
id
1
3
4
5

query
SELECT id FROM bk WHERE k @@ ts_regexp('\xc32e'::bytea) ORDER BY id
----
id
3

query
SELECT id FROM bk WHERE k @@ ts_regexp('.'::bytea) ORDER BY id
----
id
1
5

query
SELECT id FROM bk WHERE k @@ ts_regexp('.') ORDER BY id
----
id
1
3
4
5

statement ok
CREATE TABLE bc(id INTEGER PRIMARY KEY, t VARCHAR)

statement ok
CREATE INDEX bc_idx ON bc USING inverted(id, t bt_words)

statement ok
INSERT INTO bc VALUES (1, 'quick café'), (2, 'quick cafe')

query
SELECT id FROM bc WHERE t @@ ('quick' ## ts_like('caf_'::bytea)) ORDER BY id
----
id
2

query
SELECT id FROM bc WHERE t @@ ('quick' ## ts_like('caf_')) ORDER BY id
----
id
1
2

query
SELECT id FROM bc WHERE t @@ ('quick' ## ts_regexp('caf.'::bytea)) ORDER BY id
----
id
2

query
SELECT id FROM bc WHERE t @@ ('quick' ## ts_regexp('caf.')) ORDER BY id
----
id
1
2

statement ok
CREATE TABLE bq(id INTEGER PRIMARY KEY, p BYTEA)

statement ok
CREATE INDEX bq_idx ON bq USING inverted(id, p bt_words)

statement ok
INSERT INTO bq VALUES (1, 'quick café'::bytea), (2, 'quick cafe'::bytea)

query
SELECT id FROM bq WHERE p @@ ('quick' ## ts_like('caf_')) ORDER BY id
----
id
2

query
SELECT id FROM bq WHERE p @@ ('quick' ## ts_regexp('caf.')) ORDER BY id
----
