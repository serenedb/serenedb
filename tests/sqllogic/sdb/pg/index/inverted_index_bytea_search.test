# A BYTEA pattern matches bytes on any column: `_` and `.` are one byte, also
# right after a byte that starts a UTF-8 sequence. A text pattern matches
# characters on a text column.
query
SELECT id FROM bt WHERE v @@ ts_like('\xc35f'::bytea) ORDER BY id
----
id
3

query
SELECT id FROM bt WHERE v @@ ts_like('\xe45f5f'::bytea) ORDER BY id
----
id
6

query
SELECT id FROM bt WHERE v @@ ts_like('\xe425'::bytea) ORDER BY id
----
id
6
7

query
SELECT id FROM bt WHERE v @@ ts_like('__') ORDER BY id
----
id
1
2
3
7

query
SELECT id FROM bt WHERE v @@ ts_regexp('\xc32e'::bytea) ORDER BY id
----
id
3

query
SELECT id FROM bt WHERE v @@ ts_regexp('\xe42e2a'::bytea) ORDER BY id
----
id
6
7

