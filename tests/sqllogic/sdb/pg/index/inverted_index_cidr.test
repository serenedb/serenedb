statement ok
CREATE TABLE cidr_idx_t (pk INT PRIMARY KEY, net CIDR);

statement ok
CREATE INDEX cidr_idx ON cidr_idx_t USING inverted(pk, net);

statement ok
INSERT INTO cidr_idx_t
SELECT g, CASE
  WHEN g % 10 = 0 THEN NULL
  WHEN g % 2 = 0 THEN network(((8 + g % 5)::text || '.' || (g % 7)::text || '.' || (g % 3)::text || '.' || (g % 11)::text || '/' || (g % 33)::text)::INET)
  ELSE network(('2001:db8:' || to_hex(g % 3) || '::' || to_hex(g % 50) || '/' || (g % 129)::text)::INET)
END
FROM generate_series(1, 2000) AS s(g);

statement ok
INSERT INTO cidr_idx_t VALUES
  (3001, '0.0.0.0/0'),
  (3002, '::/0'),
  (3003, '10.0.0.0/8'),
  (3004, '10.1.0.0/16'),
  (3005, '10.1.2.3/32'),
  (3006, '255.255.255.255/32'),
  (3007, 'ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff/128'),
  (3008, '2001:db8:1::/48'),
  (3009, '10.1.2.3');

statement ok
CREATE TABLE cidr_plain_t AS SELECT * FROM cidr_idx_t;

statement ok
VACUUM (REFRESH_TABLE) cidr_idx_t;

