# Three rows per value keep every posting inline in the dictionary: a term that
# several overlapping clauses select still counts its rows once.
statement ok
CREATE TABLE csv_dup (id INT PRIMARY KEY, v INT)
  WITH (compaction_interval = 0)


statement ok
CREATE INDEX csv_dup_idx ON csv_dup USING inverted (id, v)


statement ok
INSERT INTO csv_dup SELECT i, 1 + i % 100 FROM generate_series(0, 299) g(i)


statement ok
VACUUM (FLUSH_TABLE) csv_dup


query
SELECT
  (SELECT count(*) FROM csv_dup_idx
     WHERE v BETWEEN 2 AND 3 OR v BETWEEN 1 AND 2 OR v BETWEEN 2 AND 4)
    AS ranges,
  (SELECT count(*) FROM csv_dup_idx
     WHERE NOT (v BETWEEN 2 AND 3 OR v BETWEEN 1 AND 2 OR v BETWEEN 2 AND 4))
    AS negated,
  (SELECT count(*) FROM csv_dup_idx
     WHERE v BETWEEN 1 AND 5 AND v BETWEEN 1 AND 5) AS repeated
----
ranges	negated	repeated
12	288	15
