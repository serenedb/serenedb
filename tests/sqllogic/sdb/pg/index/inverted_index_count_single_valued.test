# The scan hands count(*) the counts it computed instead of one empty row per
# match: several count(*) in one aggregate, an aggregate over nothing, and the
# aggregates that still need the rows (FILTER, GROUP BY, count(column)) agree
# with the table.
query
SELECT count(*) AS c, count(*) + 1 AS c1,
  count(*) FILTER (WHERE id % 2 = 0) AS even
FROM csv_t WHERE v BETWEEN 10 AND 4000
----
c	c1	even
17955	17956	7980


query
SELECT count(*) AS c, count(*) + 1 AS c1,
  count(*) FILTER (WHERE id % 2 = 0) AS even
FROM csv_idx WHERE v BETWEEN 10 AND 4000
----
c	c1	even
17955	17956	7980


query
SELECT
  (SELECT count(*) FROM csv_t WHERE v > 100000) AS none,
  (SELECT count(*) FROM csv_t WHERE v IS NULL) AS nulls,
  (SELECT count(v) FROM csv_t WHERE v BETWEEN 10 AND 4000) AS non_null,
  (SELECT count(*) FROM (SELECT * FROM csv_t WHERE v < 50 LIMIT 7)) AS limited
----
none	nulls	non_null	limited
0	2599	17955	7


