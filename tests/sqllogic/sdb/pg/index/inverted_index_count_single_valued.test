query
SELECT
  (SELECT sum(id) FROM csv_t WHERE v BETWEEN 10 AND 4000) AS dense,
  (SELECT sum(id) FROM csv_t WHERE v >= 0) AS full_range,
  (SELECT sum(id) FROM csv_t WHERE v NOT BETWEEN 100 AND 4500) AS negated,
  (SELECT count(*) FROM csv_t WHERE v BETWEEN 10 AND 4000 AND id % 7 = 0)
    AS dense_filtered
----
dense	full_range	negated	dense_filtered
287369775	379800000	52897500	2565


