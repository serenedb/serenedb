# A column filter keeps the count off term statistics: each unit counts the
# rows of a many-term range that fall inside it.
query
SELECT count(*) AS dense_filtered FROM csv_t
WHERE v BETWEEN 10 AND 4000 AND id % 7 = 0
----
dense_filtered
3078


query
SELECT count(*) AS dense_filtered FROM csv_idx
WHERE v BETWEEN 10 AND 4000 AND id % 7 = 0
----
dense_filtered
3078


statement ok
DELETE FROM csv_t WHERE id BETWEEN 5000 AND 9000


statement ok
VACUUM (FLUSH_TABLE) csv_t


