# One commit removing rows of two tables.
statement ok
CREATE TABLE dq (id BIGINT, body VARCHAR)


statement ok
CREATE INDEX dq_idx ON dq USING inverted(id, body dp_words)
  WITH (refresh_interval = 0, compaction_interval = 0)


statement ok
INSERT INTO dp SELECT i, 'zeta', true FROM range(5) r(i)


statement ok
INSERT INTO dq SELECT i, 'zeta' FROM range(5) r(i)


statement ok
BEGIN


statement ok
DELETE FROM dp WHERE id < 2


statement ok
DELETE FROM dq WHERE id >= 2


statement ok
COMMIT


statement ok
VACUUM (REFRESH_TABLE) dp


statement ok
VACUUM (REFRESH_TABLE) dq


query
SELECT id FROM dp_idx WHERE body @@ ts_phrase('zeta') ORDER BY id
