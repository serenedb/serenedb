# Inserts and deletes of one transaction, the deletes naming rows of other
# commits and of the same transaction.
statement ok
BEGIN


statement ok
INSERT INTO dp SELECT 200 + i, 'delta', true FROM range(20) r(i)


statement ok
DELETE FROM dp WHERE id >= 210 OR id IN (6, 8)


statement ok
COMMIT


statement ok
VACUUM (REFRESH_TABLE) dp


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('delta')
----
count
10


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('alpha')
----
count
1


