statement ok
CREATE TEXT SEARCH DICTIONARY dp_words AS split_text()


statement ok
CREATE TABLE dp (id BIGINT, body VARCHAR, keep BOOLEAN) WITH (compaction_interval = 0)


statement ok
CREATE INDEX dp_idx ON dp USING inverted(id, body dp_words)


statement ok
CREATE INDEX dp_part ON dp USING inverted(id, body dp_words) WHERE keep


statement ok
INSERT INTO dp SELECT i, 'alpha', i % 2 = 0 FROM range(10) r(i)


statement ok
INSERT INTO dp SELECT 100 + i, 'beta', true FROM range(10) r(i)


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('beta')
----
count
10


statement ok
DELETE FROM dp WHERE id < 3


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('beta')
----
count
10


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('alpha')
----
count
7


query
SELECT count(*) FROM dp_part WHERE body @@ ts_phrase('alpha')
----
count
3


query
SELECT (SELECT count(*) FROM dp_idx) AS dp_idx, (SELECT count(*) FROM dp_part) AS dp_part
----
dp_idx	dp_part
17	13


# Rows of a partial index's left-out rows and rows already removed remove nothing.
statement ok
DELETE FROM dp WHERE id IN (3, 5, 7)


query
SELECT (SELECT count(*) FROM dp_idx) AS dp_idx, (SELECT count(*) FROM dp_part) AS dp_part
----
dp_idx	dp_part
14	13


# An update writes the row under a new row id: the old one leaves both indexes.
statement ok
UPDATE dp SET body = 'gamma' WHERE id IN (4, 101)


query
SELECT id FROM dp_idx WHERE body @@ ts_phrase('gamma') ORDER BY id
----
id
4
101


query
SELECT count(*) FROM dp_idx WHERE body @@ (ts_phrase('alpha') || ts_phrase('beta'))
----
count
12


query
SELECT id FROM dp_part WHERE body @@ ts_phrase('gamma') ORDER BY id
----
id
4
101


# A rolled back delete leaves the index alone.
statement ok
BEGIN


statement ok
DELETE FROM dp


statement ok
ROLLBACK


query
SELECT (SELECT count(*) FROM dp_idx) AS dp_idx, (SELECT count(*) FROM dp_part) AS dp_part
----
dp_idx	dp_part
14	13


# Inserts and deletes of one transaction, the deletes naming rows of other
# commits and of the same transaction.
statement ok
BEGIN


statement ok
INSERT INTO dp SELECT 200 + i, 'delta', true FROM range(20) r(i)


statement ok
DELETE FROM dp WHERE id >= 210 OR id IN (6, 8)


statement ok
COMMIT


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('delta')
----
count
10


query
SELECT count(*) FROM dp_idx WHERE body @@ ts_phrase('alpha')
----
count
1


