DROP DATABASE IF EXISTS ie_target;

statement ok
CREATE DATABASE ie_target;

statement ok
USE ie_target;

statement ok
IMPORT DATABASE '${__TEST_DIR__}/inverted_index_export_import';

query
SELECT ts_lexize('ie_derived', 'The Runner') AS tokens;
----
tokens
{RUNNER!}

query
SELECT ts_lexize('ie_union', 'abc') AS tokens;
----
tokens
{abc,ab,abc,bc}

query
SELECT ts_lexize('ie_shingle', 'Quick Brown Fox') AS tokens;
----
tokens
{quick,"quick brown","quick brown fox",brown,"brown fox",fox}

query
SELECT ts_lexize('ie_filter', 'a an ant') AS tokens;
----
tokens
{ant}

query
SELECT ts_lexize('ie_words', 'Running') AS tokens;
----
tokens
{run}

query
SELECT regexp_replace(sql, ' WITH \(.*$', '') AS sql FROM sdb_indexes() WHERE database_name = current_database() ORDER BY index_name;
----
sql
CREATE INDEX ie_docs_idx ON public.ie_docs USING inverted (id, body ie_words, emb ivf (metric = 'l2'))
CREATE INDEX ie_pts_idx ON public.ie_pts USING inverted (id, emb hnsw (m = 16, metric = 'cosine', quant = 'none'))

statement ok
VACUUM (REFRESH_TABLE) ie_target.public.ie_docs;

statement ok
VACUUM (REFRESH_TABLE) ie_target.public.ie_pts;

query
SELECT id FROM ie_docs_idx WHERE body @@ ts_phrase('running late') ORDER BY id;
----
id
1
3

query
SELECT id FROM ie_docs_idx ORDER BY emb <-> [0, 0, 1]::FLOAT[3] LIMIT 1;
----
id
3

query
SELECT id FROM ie_pts_idx ORDER BY emb <=> [3, 1, 0]::FLOAT[3] LIMIT 1;
----
id
3

query
SELECT count(*) FROM ie_pts;
----
count
20

