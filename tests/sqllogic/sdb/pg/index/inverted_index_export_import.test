control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY ie_words AS split_text(case := 'lower') | stem_words('en_US.UTF-8') WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY ie_base AS split_text(case := 'lower');

statement ok
CREATE TEXT SEARCH DICTIONARY ie_derived AS ie_base | remove_stopwords(['the']) | upper() | (lambda x: x || '!');

statement ok
CREATE TEXT SEARCH DICTIONARY ie_union AS [keyword(), generate_ngrams(2, 3)];

statement ok
CREATE TEXT SEARCH DICTIONARY ie_shingle AS generate_shingles(split_text_csv(' ') | normalize_tokens(case := 'lower'), 2, 3);

statement ok
CREATE TEXT SEARCH DICTIONARY ie_filter AS split_text() | filter_tokens(lambda x: length(x) > 2);

statement ok
DROP TEXT SEARCH DICTIONARY ie_base;

statement ok
CREATE TABLE ie_docs (id INTEGER PRIMARY KEY, body VARCHAR, emb FLOAT[3]);

statement ok
INSERT INTO ie_docs VALUES (1, 'The runners were running late', [1, 0, 0]), (2, 'A quiet walk', [0, 1, 0]), (3, 'Running late again', [0, 0, 1]);

statement ok
CREATE INDEX ie_docs_idx ON ie_docs USING inverted (id, body ie_words, emb ivf (metric = 'l2'));

statement ok
CREATE TABLE ie_pts (id INTEGER PRIMARY KEY, emb FLOAT[3]);

statement ok
INSERT INTO ie_pts SELECT i, [i, 1, 0]::FLOAT[3] FROM range(1, 21) t(i);

statement ok
CREATE INDEX ie_pts_idx ON ie_pts USING inverted (id, emb hnsw (m = 16, metric = 'cosine', quant = 'none'));

query
SELECT regexp_replace(sql, ' WITH \(.*$', '') AS sql FROM sdb_indexes() WHERE database_name = current_database() ORDER BY index_name;
----
sql
CREATE INDEX ie_docs_idx ON public.ie_docs USING inverted (id, body ie_words, emb ivf (metric = 'l2'))
CREATE INDEX ie_pts_idx ON public.ie_pts USING inverted (id, emb hnsw (m = 16, metric = 'cosine', quant = 'none'))

statement ok
EXPORT DATABASE '${__TEST_DIR__}/inverted_index_export_import';

query
SELECT regexp_replace(name, '^.*/', '') AS name FROM glob('${__TEST_DIR__}/inverted_index_export_import/*') t(name) ORDER BY 1;
----
name
load.sql
public_ie_docs.csv
public_ie_pts.csv
schema.sql

query
SELECT rtrim(line, ';') AS line FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text('${__TEST_DIR__}/inverted_index_export_import/schema.sql')) WHERE line LIKE 'CREATE SCHEMA%' OR line LIKE 'CREATE TEXT SEARCH DICTIONARY%' ORDER BY 1;
----
line
CREATE SCHEMA IF NOT EXISTS public
CREATE TEXT SEARCH DICTIONARY public.ie_derived AS split_text(case := 'lower') | remove_stopwords(stopwords := ['the']) | (lambda input: upper("input")) | (lambda input: ("input" || '!'))
CREATE TEXT SEARCH DICTIONARY public.ie_filter AS split_text() | filter_tokens(predicate := lambda input: (length("input") > 2))
CREATE TEXT SEARCH DICTIONARY public.ie_shingle AS generate_shingles(split_text_csv(delimiter := ' ') | normalize_tokens(case := 'lower'), min_gram := 2, max_gram := 3)
CREATE TEXT SEARCH DICTIONARY public.ie_union AS [keyword(), generate_ngrams(min_gram := 2, max_gram := 3)]
CREATE TEXT SEARCH DICTIONARY public.ie_words AS split_text(case := 'lower') | stem_words(locale := 'en_US.UTF-8') WITH (frequency, position)

query
SELECT position('sdb_payload' IN content) AS payload, position('reindex_interval' IN content) AS reindex FROM read_text('${__TEST_DIR__}/inverted_index_export_import/schema.sql');
----
payload	reindex
0	0

