control substitution on


statement ok
DROP DATABASE IF EXISTS exrj_target;


system ok
rm -rf $__TEST_DIR__/exrj_glob && mkdir -p $__TEST_DIR__/exrj_glob


statement count 2
COPY (SELECT 1 AS id, 'pudge goes mid' AS body UNION ALL SELECT 2, 'arelav is skuf')
TO '${__TEST_DIR__}/exrj_glob/f1.parquet' (FORMAT PARQUET);


statement ok
CREATE VIEW exrj_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/exrj_glob/f*.parquet');


statement ok
CREATE INDEX exrj_idx ON exrj_v USING inverted (id, body) WITH (reindex_interval = 3600000);


statement ok
CREATE JOB exrj_job AFTER 1 HOUR AS SELECT 1;


statement ok
EXPORT DATABASE '${__TEST_DIR__}/exrj_export';


query
SELECT position('CREATE JOB' IN content) AS job,
       position('reindex_interval' IN content) AS reindex,
       position('CREATE INDEX exrj_idx' IN content) > 0 AS idx
FROM read_text('${__TEST_DIR__}/exrj_export/schema.sql');
----
job	reindex	idx
0	0	t


statement ok
CREATE DATABASE exrj_target;


statement ok
USE exrj_target;


statement ok
SET reindex_interval = 7200000;


statement ok
IMPORT DATABASE '${__TEST_DIR__}/exrj_export';


statement ok
RESET reindex_interval;


query
SELECT job_name, schedule FROM sdb_jobs() WHERE database_name = current_database() ORDER BY job_name;
----
job_name	schedule
exrj_idx	AFTER INTERVAL '02:00:00'


query
SELECT body FROM exrj_idx WHERE id = 2;
----
body
arelav is skuf


statement ok
USE $__DATABASE__;


statement ok
DROP DATABASE exrj_target;


statement ok
DROP JOB exrj_job;


statement ok
DROP VIEW exrj_v CASCADE;
