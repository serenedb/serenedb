# Index keys go through the optimizer's expression rules the way the same
# expression in a query does, so a key the optimizer rewrites in queries still
# matches them: LIKE becomes prefix, contains or equality, regexp_matches and
# starts_with become prefix or contains, instr(...) = 1 becomes prefix, negations
# are pushed into comparisons, constants move across a comparison, a double
# negation cancels, a no-op replace, an empty concatenation and a list built only
# to be indexed are dropped.

statement ok
CREATE TEXT SEARCH DICTIONARY verbatim_dict AS keyword() WITH (frequency);

statement ok
CREATE TABLE rewrites (id INT PRIMARY KEY, n INT, s VARCHAR);

statement ok
INSERT INTO rewrites VALUES (1, 5, 'abcdef'), (2, 7, 'xyz');

statement ok
CREATE INDEX rewrites_idx ON rewrites USING inverted (id,
  (s LIKE 'abc%') included(), (regexp_matches(s, 'bcd')) included(),
  (NOT (n > 6)) included(), (lower(s) || '') verbatim_dict);

statement ok
VACUUM (REFRESH_TABLE) rewrites;

statement ok
CREATE TABLE rewrites_composed (id INT PRIMARY KEY, a VARCHAR, b VARCHAR, s VARCHAR);

statement ok
INSERT INTO rewrites_composed VALUES (1, 'foo', 'bar', 'AbcDef'), (2, 'baz', 'qux', 'Xyz');

statement ok
CREATE INDEX rewrites_composed_idx ON rewrites_composed USING inverted (id, (a || b || '!') verbatim_dict,
  ([upper(s), 'x'][1]) verbatim_dict, ({'x': lower(s)}.x) verbatim_dict);

statement ok
VACUUM (REFRESH_TABLE) rewrites_composed;

statement ok
CREATE VIEW rewrites_composed_view AS
  SELECT id, a || b AS ab, [upper(s), 'x'] AS l, {'x': lower(s)} AS st FROM rewrites_composed_idx;

# A subquery, a view or a GROUP BY supplies part of the key's expression.
query
SELECT id FROM (SELECT id, a || b AS ab FROM rewrites_composed_idx) t WHERE ab || '!' @@ 'foobar!' ORDER BY id;
----
id
1

query
EXPLAIN SELECT id FROM (SELECT id, a || b AS ab FROM rewrites_composed_idx) t WHERE ab || '!' @@ 'foobar!';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────╮
│ Index: rewrites_composed_idx         │
│ Lookup: table                        │
│ Index Filter:                        │
│ ╭─ Term ───────────────────────────╮ │
│ │ Field: ((a || b) || '!')(string) │ │
│ │ Value: foobar!                   │ │
│ ╰──────────────────────────────────╯ │
│ Projections: id                      │
│ ~1 row                               │
╰──────────────────────────────────────╯

query
SELECT id FROM (SELECT id, [upper(s), 'x'] AS l FROM rewrites_composed_idx) t WHERE l[1] @@ 'XYZ' ORDER BY id;
----
id
2

query
EXPLAIN SELECT id FROM (SELECT id, [upper(s), 'x'] AS l FROM rewrites_composed_idx) t WHERE l[1] @@ 'XYZ';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────╮
│ Index: rewrites_composed_idx             │
│ Lookup: table                            │
│ Index Filter:                            │
│ ╭─ Term ───────────────────────────────╮ │
│ │ Field:                               │ │
│ │ list_value(upper(s), 'x')[1](string) │ │
│ │ Value: XYZ                           │ │
│ ╰──────────────────────────────────────╯ │
│ Projections: id                          │
│ ~1 row                                   │
╰──────────────────────────────────────────╯

