statement ok
CREATE TABLE rewrites_stored (id INT PRIMARY KEY, n INT, s VARCHAR, d DATE);

statement ok
INSERT INTO rewrites_stored VALUES (1, 5, 'abcdef', DATE '2024-03-15'), (2, 7, 'xyz', DATE '2025-06-02');

statement ok
CREATE INDEX rewrites_stored_idx ON rewrites_stored USING inverted (id,
  (s LIKE '%bcd%') included(), (s LIKE 'abcdef') included(), (regexp_matches(s, '^abc')) included(),
  (instr(s, 'ab') = 1) included(), (NOT (n > 1 AND n < 6)) included(), (n + 1 > 5) included(),
  (-(-n) * 2) included(), (date_trunc('month', d) = DATE '2024-03-01') included(),
  (starts_with(s, 'ab')) included(), (CASE WHEN n > 6 THEN 'big' ELSE 'small' END) included());

statement ok
VACUUM (REFRESH_TABLE) rewrites_stored;

query
SELECT id, s LIKE '%bcd%' AS a, s LIKE 'abcdef' AS b, regexp_matches(s, '^abc') AS c, instr(s, 'ab') = 1 AS e,
    NOT (n > 1 AND n < 6) AS f, n + 1 > 5 AS g, -(-n) * 2 AS h, date_trunc('month', d) = DATE '2024-03-01' AS i,
    starts_with(s, 'ab') AS j, CASE WHEN n > 6 THEN 'big' ELSE 'small' END AS k
FROM rewrites_stored_idx ORDER BY id;
----
id	a	b	c	e	f	g	h	i	j	k
1	t	t	t	t	f	t	10	t	t	small
2	f	f	f	f	t	t	14	f	f	big

query
EXPLAIN SELECT id, s LIKE '%bcd%', s LIKE 'abcdef', regexp_matches(s, '^abc'), instr(s, 'ab') = 1,
    NOT (n > 1 AND n < 6), n + 1 > 5, -(-n) * 2, date_trunc('month', d) = DATE '2024-03-01',
    starts_with(s, 'ab'), CASE WHEN n > 6 THEN 'big' ELSE 'small' END
FROM rewrites_stored_idx;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────────────────────────────╮
│ Index: rewrites_stored_idx                                 │
│ Lookup: table                                              │
│ Projections:                                               │
│ id (l), (s ~~ '%bcd%') (i), (s ~~ 'abcdef') (i),           │
│ regexp_matches(s, '^abc') (i), (instr(s, 'ab') = 1) (i),   │
│ (NOT ((n > 1) AND (n < 6))) (i), ((n + 1) > 5) (i),        │
│ ((-((-(n)))) * 2) (i),                                     │
│ (date_trunc('month', d) = CAST('2024-03-01' AS date)) (i), │
│ starts_with(s, 'ab') (i),                                  │
│ CASE  WHEN ((n > 6)) THEN ('big') ELSE 'small' END (i)     │
│ ~2 rows                                                    │
╰────────────────────────────────────────────────────────────╯

