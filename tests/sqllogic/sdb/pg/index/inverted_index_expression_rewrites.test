statement ok
CREATE TEXT SEARCH DICTIONARY rewrites_words_dict AS split_text(case := 'lower') WITH (frequency);

statement ok
CREATE TABLE rewrites_columns (id INT PRIMARY KEY, s VARCHAR, n INT);

statement ok
INSERT INTO rewrites_columns VALUES (1, 'abc', 5), (2, 'xyz', 7);

# A key the rules reduce to a column is a key on that column.
statement ok
CREATE INDEX rewrites_columns_idx ON rewrites_columns USING inverted (id, ([s, 'x'][1]) verbatim_dict, (n + 0) included());

statement ok
VACUUM (REFRESH_TABLE) rewrites_columns;

query
SELECT id FROM rewrites_columns_idx WHERE [s, 'x'][1] @@ 'abc' ORDER BY id;
----
id
1

query
EXPLAIN SELECT id FROM rewrites_columns_idx WHERE [s, 'x'][1] @@ 'abc';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────╮
│ Index: rewrites_columns_idx │
│ Lookup: table               │
│ Index Filter:               │
│ ╭─ Term ───────────╮        │
│ │ Field: s(string) │        │
│ │ Value: abc       │        │
│ ╰──────────────────╯        │
│ Projections: id             │
│ ~1 row                      │
╰─────────────────────────────╯

query
SELECT id FROM rewrites_columns_idx WHERE s @@ 'xyz' ORDER BY id;
----
id
2

query
SELECT id, n + 0 AS m FROM rewrites_columns_idx ORDER BY id;
----
id	m
1	5
2	7

query
EXPLAIN SELECT id, n + 0 FROM rewrites_columns_idx;
----
