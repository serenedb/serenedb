statement ok
CREATE INDEX rewrites_terms_idx ON rewrites_terms USING inverted (id,
  (replace(lower(s), 'q', 'q')) verbatim_dict, ([upper(s), 'x'][1]) verbatim_dict,
  (concat(lower(s), '', '')) verbatim_dict);

statement ok
VACUUM (REFRESH_TABLE) rewrites_terms;

