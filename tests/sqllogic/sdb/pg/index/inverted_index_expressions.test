# --- A stored expression is read back by scans: projections and filters use the stored value, not its columns.

statement ok
CREATE TABLE inc_e_read(id INT PRIMARY KEY, title VARCHAR, n INT);

statement ok
CREATE INDEX inc_e_read_idx ON inc_e_read USING inverted(
    id, (lower(title)) verbatim_dict, (lower(title)) included(), (n + 1) included());

statement ok
INSERT INTO inc_e_read VALUES (1, 'New York', 10), (2, 'Boston', 20), (3, 'NEWARK', 30), (4, 'abc', 40);

statement ok
VACUUM (REFRESH_TABLE) inc_e_read;

query
SELECT id, lower(title) AS l, upper(lower(title)) AS u, n + 1 AS m FROM inc_e_read_idx ORDER BY id;
----
id	l	u	m
1	new york	NEW YORK	11
2	boston	BOSTON	21
3	newark	NEWARK	31
4	abc	ABC	41

query
EXPLAIN SELECT id, lower(title), n + 1 FROM inc_e_read_idx;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────╮
│ Index: inc_e_read_idx          │
│ Lookup: table                  │
│ Projections: id (l),           │
│              lower(title) (i), │
│              (n + 1) (i)       │
│ ~4 rows                        │
╰────────────────────────────────╯

query
SELECT id FROM inc_e_read_idx WHERE lower(title) = 'boston';
----
id
2

query
