# --- A stored value that depends on the session, not only on its row, is computed from the row instead.

statement ok
SET TimeZone = 'UTC';

statement ok
CREATE TABLE inc_e_tz(id INT PRIMARY KEY, ts TIMESTAMPTZ, plain TIMESTAMP, v VARIANT);

statement ok
CREATE INDEX inc_e_tz_idx ON inc_e_tz USING inverted(
    id, (ts::VARCHAR) included(), (ts::DATE) included(), (date_part('hour', ts)) included(),
    (v::VARCHAR) included(), (epoch(plain)) included());

statement ok
INSERT INTO inc_e_tz VALUES (1, '2026-01-01 23:30:00+00', '2026-01-01 23:30:00', '2026-01-01 23:30:00+00'::TIMESTAMPTZ::VARIANT);

statement ok
VACUUM (REFRESH_TABLE) inc_e_tz;

statement ok
SET TimeZone = 'Asia/Tokyo';

query
SELECT ts::VARCHAR AS s, ts::DATE AS d, date_part('hour', ts) AS h, v::VARCHAR AS vs, epoch(plain) AS e FROM inc_e_tz_idx;
----
s	d	h	vs	e
2026-01-02 08:30:00+09	2026-01-02	8	2026-01-02 08:30:00+09	1767310200

query
SELECT ts::DATE AS d, count(*) AS c FROM inc_e_tz_idx GROUP BY ts::DATE;
----
d	c
2026-01-02	1

query
SELECT id FROM inc_e_tz_idx WHERE ts::DATE = DATE '2026-01-02';
----
