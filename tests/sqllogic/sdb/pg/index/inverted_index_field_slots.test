# A NULL element leaves the list itself non-NULL, but makes a comparison with
# the list UNKNOWN, so a negation excludes the row.

statement ok
CREATE TABLE slot_lists (id INTEGER PRIMARY KEY, tags VARCHAR[]);


statement ok
CREATE INDEX slot_lists_idx ON slot_lists USING inverted(id, tags slots_keyword)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO slot_lists VALUES (1, ['a', NULL]), (2, NULL), (3, ['b']), (4, ['b', NULL]);


statement ok
VACUUM (REFRESH_TABLE) slot_lists;


query
SELECT id FROM slot_lists_idx WHERE tags IS NULL ORDER BY id;
----
id
2

query
SELECT id FROM slot_lists WHERE tags IS NULL ORDER BY id;
----
id
2

query
SELECT id FROM slot_lists_idx WHERE tags IS NOT NULL ORDER BY id;
----
id
1
3
4

query
SELECT id FROM slot_lists WHERE tags IS NOT NULL ORDER BY id;
----
id
1
3
4

query
SELECT id FROM slot_lists_idx WHERE NOT ('a' = ANY(tags)) ORDER BY id;
----
id
2
3

query
SELECT id FROM slot_lists WHERE NOT ('a' = ANY(tags)) ORDER BY id;
----
id
2
3

statement ok
INSERT INTO slot_lists VALUES (5, [NULL]), (6, NULL), (7, ['a']);


statement ok
VACUUM (REFRESH_TABLE) slot_lists;


query
SELECT id FROM slot_lists_idx WHERE tags IS NULL ORDER BY id;
----
id
2
6

