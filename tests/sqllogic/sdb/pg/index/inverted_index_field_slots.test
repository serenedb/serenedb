# Each indexed column keeps its NULL rows, its boolean values, its numbers and
# its strings apart within the index. Every query runs against the index and
# against the table, across two segments and again after they merge.

statement ok
CREATE TEXT SEARCH DICTIONARY slots_keyword AS
    keyword() WITH (frequency);


statement ok
CREATE TABLE slots (id INTEGER PRIMARY KEY, b BOOLEAN, n BIGINT, s VARCHAR);


statement ok
CREATE INDEX slots_idx ON slots USING inverted(id, b, n, s slots_keyword)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO slots VALUES
  (1, true, 10, 'apple'),
  (2, false, 20, 'pear'),
  (3, NULL, NULL, NULL),
  (4, true, 40, 'plum');


statement ok
VACUUM (REFRESH_TABLE) slots;


statement ok
INSERT INTO slots VALUES
  (5, false, 50, 'apple'),
  (6, NULL, 60, NULL),
  (7, true, NULL, 'fig');


statement ok
VACUUM (REFRESH_TABLE) slots;


query
SELECT id FROM slots_idx WHERE b IS NULL ORDER BY id;
----
id
3
6

query
SELECT id FROM slots WHERE b IS NULL ORDER BY id;
----
id
3
6

query
EXPLAIN SELECT id FROM slots_idx WHERE b IS NULL;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───╮
│ Index: slots_idx   │
│ Lookup: table      │
│ Index Filter:      │
│ ╭─ Term ─────────╮ │
│ │ Field: b(null) │ │
│ │ Value:         │ │
│ ╰────────────────╯ │
│ Projections: id    │
│ ~1 row             │
╰────────────────────╯

query
SELECT id FROM slots_idx WHERE b = true ORDER BY id;
