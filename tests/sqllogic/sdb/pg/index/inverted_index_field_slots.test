# A JSON null makes every cast comparison of the leaf UNKNOWN as well.

statement ok
CREATE TABLE slot_json (id INTEGER PRIMARY KEY, content JSON);


statement ok
CREATE INDEX slot_json_idx ON slot_json
  USING inverted(id, (content->'val') slots_keyword)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO slot_json VALUES
  (1, '{"val":42}'), (2, '{"val":null}'), (3, '{"other":1}'), (4, '{"val":7}');


statement ok
VACUUM (REFRESH_TABLE) slot_json;


query
SELECT id FROM slot_json_idx WHERE NOT ((content->'val')::double = 42) ORDER BY id;
----
id
4

query
SELECT id FROM slot_json WHERE NOT ((content->'val')::double = 42) ORDER BY id;
----
id
4

query
EXPLAIN SELECT id FROM slot_json_idx WHERE NOT ((content->'val')::double = 42);
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────────────────────────────────────────────────────────────────────────────────────────╮
│ Index: slot_json_idx                                                                                                        │
│ Lookup: table                                                                                                               │
│ Index Filter:                                                                                                               │
│ ╭─ Not ────────────────────────────────╮                                                                                    │
│ ╰───────────────────┬──────────────────╯                                                                                    │
│                     ├───────────────────────────────────────┬─────────────────────────────────────────╮                     │
│ ╭─ Terms ───────────┴──────────────────╮  ╭─ Terms ─────────┴─────────────────╮  ╭─ Terms ────────────┴───────────────────╮ │
│ │ Field: ("content" -> 'val')(numeric) │  │ Field: ("content" -> 'val')(null) │  │ Field: ("content" -> 'val')(json null) │ │
│ │ Values: 42                           │  ╰───────────────────────────────────╯  ╰────────────────────────────────────────╯ │
│ ╰──────────────────────────────────────╯                                                                                    │
│ Projections: id                                                                                                             │
│ ~1 row                                                                                                                      │
╰─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯

