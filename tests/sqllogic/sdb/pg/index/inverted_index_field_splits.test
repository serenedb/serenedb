# --- a BOOLEAN-returning indexed expression takes the same pair of fields; a
# NULL input makes the expression SQL NULL, which is the marker field.
query TII
SELECT 'expr_true' AS q,
       (SELECT count(*) FROM fs_whole WHERE (n > 30) = true) AS whole,
       (SELECT count(*) FROM fs_split WHERE (n > 30) = true) AS split
UNION ALL SELECT 'expr_false',
       (SELECT count(*) FROM fs_whole WHERE (n > 30) = false),
       (SELECT count(*) FROM fs_split WHERE (n > 30) = false)
UNION ALL SELECT 'expr_null',
       (SELECT count(*) FROM fs_whole WHERE (n > 30) IS NULL),
       (SELECT count(*) FROM fs_split WHERE (n > 30) IS NULL)
ORDER BY 1
----
q	whole	split
expr_false	28	28
expr_null	5	5
expr_true	27	27


# --- a JSON key: the bool leaves take the same pair, and the two null facts
# are now two predicates over two fields. `IS NULL` is the 12 NULL rows plus
# the 6 rows whose document has no `v` at all; the `null` leaf is its own 12.
query TII
SELECT 'json_true' AS q,
       (SELECT count(*) FROM fs_whole WHERE (j->'v')::BOOLEAN = true) AS whole,
       (SELECT count(*) FROM fs_split WHERE (j->'v')::BOOLEAN = true) AS split
UNION ALL SELECT 'json_false',
       (SELECT count(*) FROM fs_whole WHERE (j->'v')::BOOLEAN = false),
       (SELECT count(*) FROM fs_split WHERE (j->'v')::BOOLEAN = false)
UNION ALL SELECT 'json_sql_null',
       (SELECT count(*) FROM fs_whole WHERE (j->'v') IS NULL),
       (SELECT count(*) FROM fs_split WHERE (j->'v') IS NULL)
UNION ALL SELECT 'json_null_leaf',
       (SELECT count(*) FROM fs_whole WHERE json_type(j->'v') = 'NULL'),
       (SELECT count(*) FROM fs_split WHERE json_type(j->'v') = 'NULL')
UNION ALL SELECT 'json_not_null_leaf',
       (SELECT count(*) FROM fs_whole WHERE json_type(j->'v') <> 'NULL'),
       (SELECT count(*) FROM fs_split WHERE json_type(j->'v') <> 'NULL')
UNION ALL SELECT 'json_string',
       (SELECT count(*) FROM fs_whole WHERE (j->'v') = 's'),
       (SELECT count(*) FROM fs_split WHERE (j->'v') = 's')
ORDER BY 1
----
q	whole	split
json_false	12	12
json_not_null_leaf	30	30
json_null_leaf	12	12
json_sql_null	18	18
json_string	6	6
json_true	12	12


query I
SELECT id FROM fs_whole WHERE (j->'v')::BOOLEAN = true ORDER BY id LIMIT 4
----
id
2
7
12
17


query I
SELECT id FROM fs_split WHERE (j->'v')::BOOLEAN = false ORDER BY id LIMIT 4
----
id
3
8
13
18


