hash-threshold 100

# A boolean value is not a term in a two-term dictionary: it is one of two
# always-<X> fields, and the FIELD is picked by the VALUE -- at write time per
# row, at query time per predicate. The same split separates the two null
# facts a JSON key used to collapse into one field: `IS NULL` (the key
# evaluates to SQL NULL -- a NULL row, or a path the document does not carry)
# and a `null` leaf, which is a value like any other.
#
# Covers, at a row group spanning the segment and at a row group smaller than
# it, before and after a merge: the field roles the pragma reports; equality,
# inequality, range, IN and ts_* forms over a plain BOOLEAN column; a
# BOOLEAN-returning indexed expression; a JSON key's bool leaves; `IS NULL`
# against the JSON null value; the EXPLAIN rendering of both fields; and the
# exact ids of the true and false sets, which differ, so selecting the wrong
# field of the pair fails here rather than passing on equal cardinalities.

statement ok
SET compaction_interval = 0


statement ok
SET refresh_interval = 0


statement ok
CREATE TEXT SEARCH DICTIONARY fs_kw(template = 'keyword', frequency = true)


statement ok
CREATE TABLE fs(id INTEGER PRIMARY KEY, b BOOLEAN, n INTEGER, j JSON)


# b: 18 true, 34 false, 8 null over 60 rows -- deliberately unequal, so a
# swapped true/false selection changes every count below.
# j: SQL NULL, `null` leaf, `true` leaf, `false` leaf, a missing path (also SQL
# NULL for the key) and a string leaf.
statement ok
INSERT INTO fs
SELECT i,
       CASE WHEN i % 7 = 0 THEN NULL WHEN i % 3 = 0 THEN true ELSE false END,
       CASE WHEN i % 11 = 0 THEN NULL ELSE i END,
       CASE WHEN i % 5 = 0 THEN NULL
            WHEN i % 5 = 1 THEN '{"v":null}'
            WHEN i % 5 = 2 THEN '{"v":true}'
            WHEN i % 5 = 3 THEN '{"v":false}'
            WHEN i % 10 = 4 THEN '{"other":1}'
            ELSE '{"v":"s"}' END :: JSON
FROM range(1, 61) t(i)


statement ok
CREATE INDEX fs_whole ON fs USING inverted(id, b, (n > 30), (j->'v') fs_kw)
    WITH (refresh_interval = 0, compaction_interval = 0,
          row_group_size = 2000000000)


statement ok
CREATE INDEX fs_split ON fs USING inverted(id, b, (n > 30), (j->'v') fs_kw)
    WITH (refresh_interval = 0, compaction_interval = 0, row_group_size = 8)


statement ok
VACUUM (REFRESH_TABLE) fs


# --- the fields the split creates. Three keys can hold booleans (the column,
# the expression, the JSON leaf) and each contributes both value fields; the
# JSON key alone contributes a `json_null` field beside its SQL-null marker.
query TTI
SELECT column_path, segment_type, count(*) AS fields
FROM pragma_storage_info('fs_whole')
WHERE segment_type IN ('VAR', 'FIXED_STRIDE', 'SINGLE')
GROUP BY 1, 2 ORDER BY 1, 2
----
column_path	segment_type	fields
[dict, expr]	VAR	1
[dict, false]	SINGLE	3
[dict, json_null]	SINGLE	1
[dict, null]	SINGLE	3
[dict, pk]	FIXED_STRIDE	1
[dict, true]	SINGLE	3
[dict]	VAR	1


# --- a plain BOOLEAN column: every predicate form, against hand-computed
# counts, at both row group sizes.
query TII
SELECT 'eq_true' AS q,
       (SELECT count(*) FROM fs_whole WHERE b = true) AS whole,
       (SELECT count(*) FROM fs_split WHERE b = true) AS split
UNION ALL SELECT 'eq_false',
       (SELECT count(*) FROM fs_whole WHERE b = false),
       (SELECT count(*) FROM fs_split WHERE b = false)
UNION ALL SELECT 'is_null',
       (SELECT count(*) FROM fs_whole WHERE b IS NULL),
       (SELECT count(*) FROM fs_split WHERE b IS NULL)
UNION ALL SELECT 'is_not_null',
       (SELECT count(*) FROM fs_whole WHERE b IS NOT NULL),
       (SELECT count(*) FROM fs_split WHERE b IS NOT NULL)
UNION ALL SELECT 'ne_true',
       (SELECT count(*) FROM fs_whole WHERE b <> true),
       (SELECT count(*) FROM fs_split WHERE b <> true)
UNION ALL SELECT 'ne_false',
       (SELECT count(*) FROM fs_whole WHERE b <> false),
       (SELECT count(*) FROM fs_split WHERE b <> false)
UNION ALL SELECT 'ge_false',
       (SELECT count(*) FROM fs_whole WHERE b >= false),
       (SELECT count(*) FROM fs_split WHERE b >= false)
UNION ALL SELECT 'gt_false',
       (SELECT count(*) FROM fs_whole WHERE b > false),
       (SELECT count(*) FROM fs_split WHERE b > false)
UNION ALL SELECT 'gt_true',
       (SELECT count(*) FROM fs_whole WHERE b > true),
       (SELECT count(*) FROM fs_split WHERE b > true)
UNION ALL SELECT 'lt_true',
       (SELECT count(*) FROM fs_whole WHERE b < true),
       (SELECT count(*) FROM fs_split WHERE b < true)
UNION ALL SELECT 'lt_false',
       (SELECT count(*) FROM fs_whole WHERE b < false),
       (SELECT count(*) FROM fs_split WHERE b < false)
UNION ALL SELECT 'le_false',
       (SELECT count(*) FROM fs_whole WHERE b <= false),
       (SELECT count(*) FROM fs_split WHERE b <= false)
UNION ALL SELECT 'in_both',
       (SELECT count(*) FROM fs_whole WHERE b IN (true, false)),
       (SELECT count(*) FROM fs_split WHERE b IN (true, false))
UNION ALL SELECT 'in_true',
       (SELECT count(*) FROM fs_whole WHERE b IN (true)),
       (SELECT count(*) FROM fs_split WHERE b IN (true))
UNION ALL SELECT 'not_in_false',
       (SELECT count(*) FROM fs_whole WHERE b NOT IN (false)),
       (SELECT count(*) FROM fs_split WHERE b NOT IN (false))
UNION ALL SELECT 'ts_between',
       (SELECT count(*) FROM fs_whole
        WHERE b @@ ts_between(false, true, true, true)),
       (SELECT count(*) FROM fs_split
        WHERE b @@ ts_between(false, true, true, true))
UNION ALL SELECT 'ts_between_excl',
       (SELECT count(*) FROM fs_whole
        WHERE b @@ ts_between(false, true, false, false)),
       (SELECT count(*) FROM fs_split
        WHERE b @@ ts_between(false, true, false, false))
UNION ALL SELECT 'ts_lt_true',
       (SELECT count(*) FROM fs_whole WHERE b @@ ts_lt(true)),
       (SELECT count(*) FROM fs_split WHERE b @@ ts_lt(true))
UNION ALL SELECT 'ts_ge_false',
       (SELECT count(*) FROM fs_whole WHERE b @@ ts_ge(false)),
       (SELECT count(*) FROM fs_split WHERE b @@ ts_ge(false))
ORDER BY 1
----
q	whole	split
eq_false	34	34
eq_true	18	18
ge_false	52	52
gt_false	18	18
gt_true	0	0
in_both	52	52
in_true	18	18
is_not_null	52	52
is_null	8	8
le_false	34	34
lt_false	0	0
lt_true	34	34
ne_false	18	18
ne_true	34	34
not_in_false	18	18
ts_between	52	52
ts_between_excl	0	0
ts_ge_false	52	52
ts_lt_true	34	34


# The exact ids, not the cardinalities: reading the other field of the pair
# fails here even though both fields exist and both are non-empty.
query I
SELECT id FROM fs_whole WHERE b = true AND id <= 12 ORDER BY id
----
id
3
6
9
12


query I
SELECT id FROM fs_split WHERE b = false AND id <= 12 ORDER BY id
----
id
1
2
4
5
8
10
