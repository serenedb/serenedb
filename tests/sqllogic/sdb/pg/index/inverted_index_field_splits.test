db error: ERROR: ts_dict_agg(): column has no text term dictionary
HINT: ts_dict_agg requires a text-tokenized or keyword VARCHAR column, or an array of such


# --- a second batch into its own segment, then a merge: the fields are the
# schema's, so the merged segment carries the same split.
statement ok
INSERT INTO fs
SELECT i,
       CASE WHEN i % 7 = 0 THEN NULL WHEN i % 3 = 0 THEN true ELSE false END,
       CASE WHEN i % 11 = 0 THEN NULL ELSE i END,
       CASE WHEN i % 5 = 0 THEN NULL
            WHEN i % 5 = 1 THEN '{"v":null}'
            WHEN i % 5 = 2 THEN '{"v":true}'
            WHEN i % 5 = 3 THEN '{"v":false}'
            WHEN i % 10 = 4 THEN '{"other":1}'
            ELSE '{"v":"s"}' END :: JSON
FROM range(61, 121) t(i)


statement ok
VACUUM (REFRESH_TABLE) fs


statement ok
VACUUM (COMPACT_TABLE) fs


query TTII
SELECT column_path, segment_type, count(DISTINCT row_group_id) AS segments,
       count(*) AS fields
FROM pragma_storage_info('fs_split')
WHERE segment_type IN ('VAR', 'FIXED_STRIDE', 'SINGLE')
GROUP BY 1, 2 ORDER BY 1, 2
----
column_path	segment_type	segments	fields
[dict, expr]	VAR	1	1
[dict, false]	SINGLE	1	3
[dict, json_null]	SINGLE	1	1
[dict, null]	SINGLE	1	3
[dict, pk]	FIXED_STRIDE	1	1
[dict, true]	SINGLE	1	3
[dict]	VAR	1	1


query TII
SELECT 'm_eq_true' AS q,
       (SELECT count(*) FROM fs_whole WHERE b = true) AS whole,
       (SELECT count(*) FROM fs_split WHERE b = true) AS split
UNION ALL SELECT 'm_eq_false',
       (SELECT count(*) FROM fs_whole WHERE b = false),
       (SELECT count(*) FROM fs_split WHERE b = false)
UNION ALL SELECT 'm_is_null',
       (SELECT count(*) FROM fs_whole WHERE b IS NULL),
       (SELECT count(*) FROM fs_split WHERE b IS NULL)
UNION ALL SELECT 'm_ge_false',
       (SELECT count(*) FROM fs_whole WHERE b >= false),
       (SELECT count(*) FROM fs_split WHERE b >= false)
UNION ALL SELECT 'm_expr_true',
       (SELECT count(*) FROM fs_whole WHERE (n > 30) = true),
       (SELECT count(*) FROM fs_split WHERE (n > 30) = true)
UNION ALL SELECT 'm_expr_false',
       (SELECT count(*) FROM fs_whole WHERE (n > 30) = false),
       (SELECT count(*) FROM fs_split WHERE (n > 30) = false)
UNION ALL SELECT 'm_expr_null',
       (SELECT count(*) FROM fs_whole WHERE (n > 30) IS NULL),
       (SELECT count(*) FROM fs_split WHERE (n > 30) IS NULL)
UNION ALL SELECT 'm_json_true',
       (SELECT count(*) FROM fs_whole WHERE (j->'v')::BOOLEAN = true),
       (SELECT count(*) FROM fs_split WHERE (j->'v')::BOOLEAN = true)
UNION ALL SELECT 'm_json_false',
       (SELECT count(*) FROM fs_whole WHERE (j->'v')::BOOLEAN = false),
       (SELECT count(*) FROM fs_split WHERE (j->'v')::BOOLEAN = false)
UNION ALL SELECT 'm_json_sql_null',
