# The emitted ids after the merge, whole-vs-split, for both sides of every
# pair.
query TT
SELECT 'm_true_ids' AS q,
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_whole
        WHERE b = true) =
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_split
        WHERE b = true) AS same
UNION ALL SELECT 'm_false_ids',
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_whole
        WHERE b = false) =
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_split
        WHERE b = false)
UNION ALL SELECT 'm_json_null_ids',
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_whole
        WHERE json_type(j->'v') = 'NULL') =
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_split
        WHERE json_type(j->'v') = 'NULL')
UNION ALL SELECT 'm_sql_null_ids',
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_whole
        WHERE (j->'v') IS NULL) =
       (SELECT md5(string_agg(id::VARCHAR, ',' ORDER BY id)) FROM fs_split
        WHERE (j->'v') IS NULL)
ORDER BY 1
----
q	same
m_false_ids	t
m_json_null_ids	t
m_sql_null_ids	t
m_true_ids	t


# The two null facts are disjoint and neither leaks into the other.
query I
SELECT count(*) FROM fs_split
WHERE (j->'v') IS NULL AND json_type(j->'v') = 'NULL'
----
count
0


statement ok
