# --- the null-marker exclude a boolean column anchors. A postings-only
# positive on either value field already rejects every row the column's marker
# indexes, so the marker exclude is redundant and the exclusion normal form
# drops it. The map that says so is keyed by the VALUE field precisely because
# one marker faces two of them here. Answers are unchanged either way -- this
# is a pruning pin, and both queries return the 34 false rows.
query
EXPLAIN SELECT id FROM fs_whole WHERE NOT (b = true) AND b = false
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────╮
│ Index: fs_whole                         │
│ Lookup: table                           │
│ Index Filter:                           │
│ ╭─ Exclusion ─────╮                     │
│ ╰────────┬────────╯                     │
│          ├────────────────────╮         │
│ ╭─ Term ─┴────────╮  ╭─ Term ─┴───────╮ │
│ │ Field: b(false) │  │ Field: b(true) │ │
│ │ Value: false    │  │ Value: true    │ │
│ ╰─────────────────╯  ╰────────────────╯ │
│ Projections: id                         │
│ ~12 rows                                │
╰─────────────────────────────────────────╯


query
EXPLAIN SELECT id FROM fs_whole WHERE b = false AND NOT (b IS NULL)
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────╮
│ Index: fs_whole     │
│ Lookup: table       │
│ Index Filter:       │
│ ╭─ Term ──────────╮ │
│ │ Field: b(false) │ │
│ │ Value: false    │ │
│ ╰─────────────────╯ │
│ Projections: id     │
│ ~12 rows            │
╰─────────────────────╯


query III
SELECT (SELECT count(*) FROM fs_whole WHERE NOT (b = true) AND b = false)
         AS pruned_and,
       (SELECT count(*) FROM fs_whole WHERE b = false AND NOT (b IS NULL))
         AS pruned_not_null,
       (SELECT count(*) FROM fs WHERE b = false) AS base
----
pruned_and	pruned_not_null	base
34	34	34


# --- dictionary-enumerating consumers. `ts_dict_agg` and the GROUP BY facet
# pushdown both require a text term dictionary, so neither claims a boolean
# key; the grouping runs over the scan and stays correct, including the NULL
# group and the distinct count.
query TI
SELECT coalesce(b::VARCHAR, '-') AS val, count(*) AS rows
FROM fs_whole GROUP BY 1 ORDER BY 1
----
val	rows
-	8
false	34
true	18


query I
SELECT count(DISTINCT b) FROM fs_whole
----
count
2


