query
SELECT
  (SELECT sum(id) FROM fill_edge_idx WHERE body @@ ('every'::TSQUERY && !!'aligned'::TSQUERY)) AS indexed,
  (SELECT sum(id) FROM fill_edge WHERE NOT (id >= 2 AND (id - 2) % 3 <> 2)) AS scanned;
