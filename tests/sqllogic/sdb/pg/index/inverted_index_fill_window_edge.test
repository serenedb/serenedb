hash-threshold 200


statement ok
CREATE TEXT SEARCH DICTIONARY fill_edge_en AS split_by_non_alpha(case := 'lower');


statement ok
CREATE TABLE fill_edge (id INTEGER, body VARCHAR);


statement ok
INSERT INTO fill_edge
SELECT r, concat_ws(' ',
    CASE WHEN r >= 2 AND (r - 2) % 3 <> 2 THEN 'aligned' END,
    CASE WHEN r >= 258 AND (r - 258) % 3 <> 2 THEN 'flush' END,
    CASE WHEN r >= 3 AND (r - 3) % 3 <> 2 THEN 'shifted' END,
    CASE WHEN r = 8700 THEN 'lone' END,
    'every')
FROM range(1, 8701) t(r);


statement ok
CREATE INDEX fill_edge_idx ON fill_edge USING inverted(body fill_edge_en);


query
SELECT
  (SELECT sum(id) FROM fill_edge_idx
    WHERE body @@ ('aligned'::TSQUERY || ('every'::TSQUERY && 'lone'::TSQUERY))) AS indexed,
  (SELECT sum(id) FROM fill_edge WHERE (id >= 2 AND (id - 2) % 3 <> 2) OR id = 8700) AS scanned;
----
indexed	scanned
25235800	25235800


