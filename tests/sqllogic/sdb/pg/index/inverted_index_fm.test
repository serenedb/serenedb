statement ok
CREATE TEXT SEARCH DICTIONARY fm_keyword AS keyword()

statement ok
CREATE TABLE fm_terms (id INT, body VARCHAR)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0)

statement ok
CREATE INDEX fm_terms_idx ON fm_terms USING inverted (id, body fm_keyword)

statement ok
INSERT INTO fm_terms VALUES
    (1, 'banana'),
    (2, 'bandana'),
    (3, 'banana banana'),
    (4, ''),
    (5, NULL),
    (6, 'ab'),
    (7, 'cd'),
    (8, '50% banana'),
    (9, '50_ banana'),
    (10, 'café banana'),
    (11, 'BANANA')

statement ok
VACUUM (REFRESH_TABLE) fm_terms

