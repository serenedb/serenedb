query
SELECT COALESCE(MAX(value), 1) > 0 AS fm_ready
FROM sdb_metrics WHERE metric = 'fm_index_serialized_bytes'
----
fm_ready
t

query
EXPLAIN SELECT count(*) FROM fm_terms_idx WHERE body LIKE '%ana%'
----
QUERY PLAN
╭─ UNGROUPED_AGGREGATE ────╮
│ Aggregates: count_star() │
│ ~1 row                   │
╰─────────────┬────────────╯
╭─ IRESEARCH_SCAN ─────────╮
│ Index: fm_terms_idx      │
│ Lookup: search           │
│ Index Filter:            │
│ ╭─ Automaton ─────────╮  │
│ │ Field: body(string) │  │
│ │ Pattern: %ana%      │  │
│ ╰─────────────────────╯  │
│ Output: row-count only   │
│ ~2 rows                  │
╰──────────────────────────╯

query
SELECT count(*) FROM fm_terms_idx WHERE body @@ ts_like('%ana%')
----
count
6

