control substitution on

statement ok
SET sdb_ann_rescore_width = 100

statement ok
CREATE TABLE hnsw_bq (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX hnsw_bq_idx ON hnsw_bq
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'bq'));

statement ok
INSERT INTO hnsw_bq SELECT i,
  list_transform(range(8),
                 x -> CASE WHEN x = i % 8 THEN (10.0 * (1 + i / 8))::FLOAT
                           ELSE 0.0::FLOAT END)::FLOAT[8]
  FROM range(64) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_bq;

query
SELECT pk FROM hnsw_bq_idx
  ORDER BY emb <-> [0, 0, 0, 62, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
43
51
35

query
SELECT pk FROM hnsw_bq_idx
  ORDER BY emb <-> [80, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
56
48
40

query
SELECT count(*) FROM hnsw_bq_idx;
----
count
64

query
SELECT pk FROM hnsw_bq_idx
  WHERE emb <-> [0, 0, 0, 62, 0, 0, 0, 0]::FLOAT[8] < 10 ORDER BY pk;
----
pk
43
51

query
SELECT count(*) FROM hnsw_bq_idx
  WHERE emb <-> [0, 0, 0, 62, 0, 0, 0, 0]::FLOAT[8] < 10;
----
count
2


