CREATE TABLE hnsw_nest (pk INTEGER PRIMARY KEY, emb FLOAT[8],
  meta STRUCT(cat INTEGER, name VARCHAR), tags INTEGER[], pair INTEGER[2]);


statement ok
CREATE INDEX hnsw_nest_idx ON hnsw_nest
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'))
  INCLUDE (meta, tags, pair);


statement ok
INSERT INTO hnsw_nest SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8],
  {'cat': i % 5, 'name': 'n' || i},
  CASE WHEN i % 4 = 0 THEN NULL ELSE [i] END,
  (CASE WHEN i % 3 = 0 THEN NULL ELSE [i, i] END)::INTEGER[2]
FROM range(2000) t(i);


statement ok
VACUUM (REFRESH_TABLE) hnsw_nest;


statement ok
SET sdb_hnsw_filter_mode = 'walk';


statement ok
