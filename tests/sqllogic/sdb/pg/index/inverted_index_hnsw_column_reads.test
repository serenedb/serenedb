statement ok
CREATE TABLE hnsw_cr (
  pk INTEGER PRIMARY KEY, emb FLOAT[8], tag VARCHAR, url VARCHAR, body VARCHAR,
  price DOUBLE, ratio DOUBLE, qty BIGINT, run BIGINT, flag BOOLEAN, opt INTEGER);


statement ok
CREATE INDEX hnsw_cr_idx ON hnsw_cr
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'))
  INCLUDE (tag included (compression = 'dict_fsst'),
           url included (compression = 'dict_fsst'),
           body included (compression = 'zstd'),
           price included (compression = 'alp'),
           ratio included (compression = 'alprd'),
           qty included (compression = 'bitpacking'),
           run included (compression = 'rle'),
           flag included (compression = 'roaring'),
           opt included (compression = 'bitpacking'));


statement ok
INSERT INTO hnsw_cr SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8],
  ['a', 'b', 'c'][i % 3 + 1],
  'https://example.org/p/' || i,
  repeat('x', 100) || i,
  (i % 100) / 4.0,
  round(sin(i) * 1000.123456789, 9),
  i // 10,
  i // 500,
  i % 7 = 0,
  CASE WHEN i % 5 = 0 THEN NULL ELSE i END
FROM range(5000) t(i);


statement ok
VACUUM (REFRESH_TABLE) hnsw_cr;


statement ok
