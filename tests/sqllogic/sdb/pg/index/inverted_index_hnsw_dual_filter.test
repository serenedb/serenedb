# Deleted rows stay out on both sides.
statement ok
DELETE FROM hd WHERE pk IN (1503, 1493);

statement ok
VACUUM (REFRESH_TABLE) hd;

statement ok
SET sdb_hnsw_filter_mode = 'walk';

