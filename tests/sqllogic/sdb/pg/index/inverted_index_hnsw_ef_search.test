control substitution on

# ============================================================================
# sdb_hnsw_ef_search is HNSW's own search-time beam width.
#
# Before it existed, ef came from sdb_nprobe -- an IVF-named knob -- through
# max(nprobe, 64), so ef was pinned at 64 for anyone not tuning and could never
# be driven below it. 0 keeps exactly that derivation; any other value is used
# verbatim, which is what makes the low-latency end of the recall/latency curve
# reachable at all.
#
# The beam is also the result ceiling: HnswSearchTopK keeps at most ef
# candidates, so the scan floors ef at the LIMIT -- a beam narrower than k
# could not answer the query -- and above that the value is used verbatim. On
# a linear dataset the graph finds the exact neighbours at any beam, so what
# this file pins is that every LIMIT is met and that small values are honoured
# rather than pinned to the old floor of 64.
#
# quant = 'none' is pinned so the graph traverses raw f32; with a quantizer the
# scan layer reads sdb_ann_oversample * k of the beam's hits back at full
# precision, and the beam is widened to hold that pool.
# ============================================================================

statement ok
CREATE TABLE hnsw_ef (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX hnsw_ef_idx ON hnsw_ef
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none', m = 4,
                               ef_construction = 8));

statement ok
INSERT INTO hnsw_ef SELECT i,
  [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(2000) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_ef;


query
SHOW sdb_hnsw_ef_search;
----
sdb_hnsw_ef_search
64


# A wide beam ranks exactly. 1500.4 is off-lattice so no two neighbours tie.
statement ok
SET sdb_hnsw_ef_search = 512;

query
SELECT pk FROM hnsw_ef_idx
  ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
1500
1501
1499


# Below the old floor of 64 the value is honoured, floored at the LIMIT: a
# beam of 1 asked for 5 rows searches with a beam of 5 and returns all 5.
statement ok
SET sdb_hnsw_ef_search = 1;

query
SELECT pk FROM hnsw_ef_idx
  ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5;
----
pk
1500
1501
1499
1502
1498


statement ok
SET sdb_hnsw_ef_search = 3;

query
SELECT pk FROM hnsw_ef_idx
  ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5;
----
pk
1500
1501
1499
1502
1498


# 0 restores the legacy derivation, so sdb_nprobe drives ef again and the old
# floor of 64 applies -- five rows come back where ef = 3 returned three.
statement error db error: ERROR: invalid value for parameter "sdb_hnsw_ef_search": "0"
SET sdb_hnsw_ef_search = 0;

statement error
SET sdb_nprobe = 3;
----
db error: ERROR: unrecognized configuration parameter "sdb_nprobe"

Did you mean: "role"


query
SELECT count(*) FROM (
  SELECT pk FROM hnsw_ef_idx
    ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5);
----
count
5


statement error
SET sdb_hnsw_ef_search = -1;
----
db error: ERROR: invalid value for parameter "sdb_hnsw_ef_search": "-1"


statement ok
CREATE TABLE hnsw_efq (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX hnsw_efq_idx ON hnsw_efq
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'sq8', m = 4,
                               ef_construction = 8));

statement ok
INSERT INTO hnsw_efq SELECT i,
  [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(2000) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_efq;

# sdb_ann_oversample is HNSW's own oversample; sdb_ann_oversample is the IVF
# one and does not reach here. The pool it asks for is read back at full
# precision, and the beam is widened to hold it -- so an oversample of 4 at
# LIMIT 5 searches at least 20 however narrow ef is set.
statement ok
SET sdb_ann_oversample = 4;

statement ok
SET sdb_hnsw_ef_search = 1;

query
SELECT count(*) FROM (
  SELECT pk FROM hnsw_efq_idx
    ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5);
----
count
5


# 0 disables the rescore, as Elasticsearch's oversample of 0 does. Nothing
# widens the beam past the LIMIT then, but the LIMIT is still a floor, so the
# full five come back and they come back straight from the quantized codes.
statement ok
SET sdb_ann_oversample = 0;

query
SELECT count(*) FROM (
  SELECT pk FROM hnsw_efq_idx
    ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5);
----
count
5


# On this linear dataset the codes separate the neighbours cleanly, so the
# answer is the exact one either way: the oversample is a recall knob, never a
# correctness one.
query
SELECT pk FROM hnsw_efq_idx
  ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 5;
----
pk
1500
1501
1499
1502
1498


statement ok
SET sdb_ann_oversample = 3;
