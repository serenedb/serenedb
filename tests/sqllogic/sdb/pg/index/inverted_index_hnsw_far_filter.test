query
SELECT COUNT(*) FROM (SELECT pk FROM ff_idx WHERE side = 'far'
  ORDER BY emb <-> list_transform(range(128), j -> 0.1::FLOAT)::FLOAT[128]
  LIMIT 10) w WHERE pk < 1500;
