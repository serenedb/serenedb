           ORDER BY emb <-> list_transform(range(128), j -> 9.9::FLOAT)::FLOAT[128]
           LIMIT 10),
     p AS (SELECT pk FROM ff WHERE side = 'near'
           ORDER BY emb <-> list_transform(range(128), j -> 9.9::FLOAT)::FLOAT[128]
           LIMIT 10)
SELECT COUNT(*) FROM ((SELECT * FROM w EXCEPT SELECT * FROM p)
                      UNION ALL (SELECT * FROM p EXCEPT SELECT * FROM w)) d;
