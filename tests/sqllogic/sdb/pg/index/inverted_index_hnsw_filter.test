control substitution on

statement ok
CREATE TABLE hnsw_f (pk INTEGER PRIMARY KEY, emb FLOAT[8], label VARCHAR);


statement ok
CREATE INDEX hnsw_f_idx ON hnsw_f
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none')) INCLUDE (label);


statement ok
INSERT INTO hnsw_f SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8],
  CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(300) t(i);


statement ok
VACUUM (REFRESH_TABLE) hnsw_f;


# Unfiltered kNN keeps the pushed top-k, so the scan runs the graph search.
query
EXPLAIN SELECT pk FROM hnsw_f_idx
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ──────────────────╮
│ Index: hnsw_f_idx                 │
│ Lookup: table                     │
│ Score: l2_distance(emb, FLOAT[8]) │
│ Top: 2                            │
│ Projections: pk                   │
│ ~300 rows                         │
╰───────────────────────────────────╯


query
SELECT pk FROM hnsw_f_idx
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
100
101
99


query error an hnsw vector index does not support filtered search
SELECT pk FROM hnsw_f_idx
  WHERE label = 'even'
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;


query error an hnsw vector index does not support filtered search
SELECT pk FROM hnsw_f_idx
  WHERE label = 'odd'
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;


query
SELECT count(*) FROM hnsw_f_idx WHERE label = 'even';
----
count
150


query error an hnsw vector index does not support filtered search
SELECT pk FROM hnsw_f_idx
  WHERE pk >= 250
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;


query error an hnsw vector index does not support filtered search
SELECT pk FROM hnsw_f_idx
  WHERE pk IN (1, 2, 3)
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;


query error an hnsw vector index does not support filtered search
SELECT pk FROM hnsw_f_idx
  WHERE label = 'even' OR pk < 10
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;


statement ok
CREATE TABLE hnsw_l (pk INTEGER PRIMARY KEY, emb FLOAT[8], tag INTEGER);


statement ok
CREATE INDEX hnsw_l_idx ON hnsw_l
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'));


statement ok
INSERT INTO hnsw_l SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8], i % 10
  FROM range(300) t(i);


statement ok
VACUUM (REFRESH_TABLE) hnsw_l;


query
SELECT pk FROM hnsw_l_idx
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
100
101
99


query error an hnsw vector index does not support filtered search
SELECT pk FROM hnsw_l_idx
  WHERE tag = 3
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;


query error an hnsw vector index answers ORDER BY <distance> LIMIT k and distance ranges
SELECT count(*) FROM (
  SELECT pk, emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] AS d FROM hnsw_l_idx
) s;
