control substitution on

statement ok
CREATE TABLE hnsw_f (pk INTEGER PRIMARY KEY, emb FLOAT[8], label VARCHAR);


statement ok
CREATE INDEX hnsw_f_idx ON hnsw_f
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none')) INCLUDE (label);


statement ok
INSERT INTO hnsw_f SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8],
  CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(300) t(i);


statement ok
VACUUM (REFRESH_TABLE) hnsw_f;


# Unfiltered kNN keeps the pushed top-k, so the scan runs the graph search.
query
EXPLAIN SELECT pk FROM hnsw_f_idx
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ──────────────────╮
│ Index: hnsw_f_idx                 │
│ Lookup: table                     │
│ Score: l2_distance(emb, FLOAT[8]) │
│ Top: 2                            │
│ Projections: pk                   │
│ ~300 rows                         │
╰───────────────────────────────────╯


query
SELECT pk FROM hnsw_f_idx
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
100
101
99


# `label` is INCLUDE'd, not indexed: a column predicate. It folds into the
# set the graph walk admits from, so the answer is the k nearest that pass.
query
SELECT pk FROM hnsw_f_idx
  WHERE label = 'even'
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
100
102
98


query
SELECT pk FROM hnsw_f_idx
  WHERE label = 'odd'
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
101
99
103


query
SELECT count(*) FROM hnsw_f_idx WHERE label = 'even';
----
count
150


# `pk` is indexed: the range is claimed into the scan and becomes the walk's
# predicate. The qualifying rows lie far from the query, where an unfiltered
# beam would never look; the predicate-aware walk (or the scan of its docs,
# when the predicate is sparse) still finds the nearest of them.
query
SELECT pk FROM hnsw_f_idx
  WHERE pk >= 250
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
pk
250
251


# Both kinds at once: the indexed range and the stored column.
query
SELECT pk FROM hnsw_f_idx
  WHERE pk >= 250 AND label = 'odd'
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
pk
251
253


# A predicate nothing satisfies.
query
SELECT pk FROM hnsw_f_idx
  WHERE pk >= 300
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
pk


# Filtered count through the graph's radius search.
query
SELECT count(*) FROM hnsw_f_idx
  WHERE label = 'even' AND emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] < 5;
----
count
5
