SET sdb_ivf_search_nprobe = 1000

statement ok
CREATE TABLE ivf_fp16 (pk INTEGER PRIMARY KEY, emb FLOAT[3]);

statement ok
CREATE INDEX ivf_fp16_idx ON ivf_fp16
  USING inverted(pk, emb ivf (metric = 'cosine', quant = 'fp16'));

statement count 4
INSERT INTO ivf_fp16 VALUES
  (1, [1, 0, 0]::FLOAT[3]),
  (2, [0, 1, 0]::FLOAT[3]),
  (3, [0, 0, 1]::FLOAT[3]),
  (4, [1, 1, 0]::FLOAT[3])

statement ok
VACUUM (REFRESH_TABLE) ivf_fp16;

query
SELECT pk FROM ivf_fp16_idx ORDER BY emb <=> [0.9, 1, 0]::FLOAT[3] LIMIT 2;
