query
SELECT min(id) AS lowest, max(id) AS highest, count(*) AS found
FROM (SELECT id FROM ht_none_idx
      ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 60);
----
lowest	highest	found
1471	1530	60
