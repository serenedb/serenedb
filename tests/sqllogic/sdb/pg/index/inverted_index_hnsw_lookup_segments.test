statement ok
CREATE TABLE hls (pk INTEGER PRIMARY KEY, emb FLOAT[2], x BIGINT);

statement ok
CREATE INDEX hls_idx ON hls
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'))
  WITH (compaction_interval = 0);

statement ok
INSERT INTO hls SELECT i, [i, 0]::FLOAT[2], i % 41 FROM range(1200) t(i);

statement ok
VACUUM (REFRESH_TABLE) hls;

statement ok
INSERT INTO hls SELECT i, [i, 0]::FLOAT[2], i % 41 FROM range(1200, 1500) t(i);

statement ok
VACUUM (REFRESH_TABLE) hls;

query
SELECT m.value FROM sdb_metrics m JOIN pg_class c ON c.oid = m.relation_id
  WHERE c.relname = 'hls_idx' AND m.metric = 'num_segments';
----
value
2

query
SELECT list(pk ORDER BY pk) AS pks FROM (SELECT pk FROM hls_idx WHERE x = 2
  ORDER BY emb <-> [0.4, 0]::FLOAT[2] LIMIT 10) t;
----
pks
{2,43,84,125,166,207,248,289,330,371}

