statement ok
SET sdb_ann_rescore_width = 100

statement ok
CREATE TABLE hnsw_osq (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX hnsw_osq_idx ON hnsw_osq
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'osq'));

statement ok
INSERT INTO hnsw_osq SELECT i,
  list_transform(range(8),
                 x -> CASE WHEN x = i % 8 THEN (10.0 * (1 + i / 8))::FLOAT
                           ELSE 0.0::FLOAT END)::FLOAT[8]
  FROM range(64) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_osq;

query
SELECT pk FROM hnsw_osq_idx
  ORDER BY emb <-> [0, 0, 0, 62, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
43
51
35

query
SELECT count(*) FROM hnsw_osq_idx;
----
count
64


