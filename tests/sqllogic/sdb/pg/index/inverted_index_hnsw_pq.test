control substitution on

statement ok
SET sdb_ann_oversample = 4

statement ok
CREATE TABLE hnsw_pq (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX hnsw_pq_idx ON hnsw_pq
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'pq', pq_m = 4));

statement ok
INSERT INTO hnsw_pq SELECT i,
  list_transform(range(8),
                 x -> CASE WHEN x = i % 8 THEN (10.0 * (1 + i / 8))::FLOAT
                           ELSE 0.0::FLOAT END)::FLOAT[8]
  FROM range(64) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_pq;

query
SELECT pk FROM hnsw_pq_idx
  ORDER BY emb <-> [0, 0, 0, 60, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
43
35
51

query
SELECT pk FROM hnsw_pq_idx
  ORDER BY emb <-> [80, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
56
48
40

query
SELECT count(*) FROM hnsw_pq_idx;
----
count
64


statement ok
CREATE TABLE hnsw_pq_ip (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX hnsw_pq_ip_idx ON hnsw_pq_ip
  USING inverted(pk, emb hnsw (metric = 'ip', quant = 'pq'));

statement ok
INSERT INTO hnsw_pq_ip SELECT i,
  list_transform(range(8),
                 x -> CASE WHEN x = i % 8 THEN (10.0 * (1 + i / 8))::FLOAT
                           ELSE 0.0::FLOAT END)::FLOAT[8]
  FROM range(64) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_pq_ip;

query
SELECT pk FROM hnsw_pq_ip_idx
  ORDER BY emb <#> [0, 0, 1, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
58
50
42

query
SELECT count(*) FROM hnsw_pq_ip_idx;
----
count
64


statement ok
CREATE TABLE hnsw_pq_cos (pk INTEGER PRIMARY KEY, emb FLOAT[4]);

statement ok
CREATE INDEX hnsw_pq_cos_idx ON hnsw_pq_cos
  USING inverted(pk, emb hnsw (metric = 'cosine', quant = 'pq', pq_m = 2));

statement ok
INSERT INTO hnsw_pq_cos VALUES
  (1, [1, 0, 0, 0]::FLOAT[4]),
  (2, [0, 1, 0, 0]::FLOAT[4]),
  (3, [0, 0, 1, 0]::FLOAT[4]),
  (4, [0, 0, 0, 1]::FLOAT[4]);

statement ok
VACUUM (REFRESH_TABLE) hnsw_pq_cos;

query
SELECT pk FROM hnsw_pq_cos_idx
  ORDER BY emb <=> [0, 0, 3, 0]::FLOAT[4] LIMIT 1;
----
pk
3

query
SELECT count(*) FROM hnsw_pq_cos_idx;
----
count
4


statement ok
DELETE FROM hnsw_pq WHERE pk = 43;

statement ok
VACUUM (REFRESH_TABLE) hnsw_pq;

query
SELECT pk FROM hnsw_pq_idx
  ORDER BY emb <-> [0, 0, 0, 60, 0, 0, 0, 0]::FLOAT[8] LIMIT 1;
----
pk
35

query
SELECT count(*) FROM hnsw_pq_idx;
----
count
63


statement error
CREATE INDEX hnsw_pq_bad_m ON hnsw_pq
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'pq', pq_m = 3));
----
db error: ERROR: Column 'emb': hnsw option 'pq_m' (3) must divide the vector dimension 8


statement error
CREATE INDEX hnsw_pq_m_sq8 ON hnsw_pq
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'sq8', pq_m = 4));
----
db error: ERROR: Column 'emb': hnsw option 'pq_m' is only valid with quant 'pq'


statement error
