query
SELECT count(*) FROM (
  (SELECT id FROM hrc_idx WHERE emb <-> [180.2, 1]::FLOAT[2] < 5.5)
  EXCEPT (SELECT id FROM hrc WHERE emb <-> [180.2, 1]::FLOAT[2] < 5.5)) t;
