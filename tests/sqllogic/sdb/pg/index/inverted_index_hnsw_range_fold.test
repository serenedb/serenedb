control substitution on

statement ok
CREATE TABLE rf (pk INTEGER PRIMARY KEY, emb FLOAT[4], i8 TINYINT,
  i16 SMALLINT, i32 INTEGER, i64 BIGINT, x32 INTEGER, x64 BIGINT);

statement ok
CREATE INDEX rf_idx ON rf
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'))
  INCLUDE (i8, i16, i32, i64, x32, x64);

statement ok
INSERT INTO rf SELECT i,
  [(i % 97)::FLOAT, (i % 89)::FLOAT, (i % 83)::FLOAT, (i % 79)::FLOAT]::FLOAT[4],
  CASE WHEN i % 11 = 0 THEN NULL ELSE ((i * 37) % 256 - 128)::TINYINT END,
  CASE WHEN i % 13 = 0 THEN NULL ELSE ((i * 7919) % 65536 - 32768)::SMALLINT END,
  CASE WHEN i % 17 = 0 THEN NULL ELSE ((i * 104729) % 2000001 - 1000000)::INTEGER END,
  CASE WHEN i % 19 = 0 THEN NULL ELSE (i::BIGINT * 1000003 % 4000000007 - 2000000000) END,
  CASE WHEN i % 23 = 0 THEN NULL
       WHEN i % 1000 = 1 THEN -2147483648
       WHEN i % 1000 = 2 THEN 2147483647
       ELSE ((i * 104729) % 2000001 - 1000000)::INTEGER END,
  CASE WHEN i % 29 = 0 THEN NULL
       WHEN i % 1000 = 3 THEN -9223372036854775808
       WHEN i % 1000 = 4 THEN 9223372036854775807
       ELSE (i::BIGINT * 1000003 % 4000000007 - 2000000000) END
  FROM range(30000) t(i);

statement ok
VACUUM (REFRESH_TABLE) rf;

statement ok
SET sdb_hnsw_filter_mode = 'scan';

query
WITH w AS (SELECT pk FROM rf_idx WHERE i32 BETWEEN -100000 AND 100000
           ORDER BY emb <-> [10, 20, 30, 40]::FLOAT[4] LIMIT 25),
     p AS (SELECT pk FROM rf WHERE i32 BETWEEN -100000 AND 100000
           ORDER BY emb <-> [10, 20, 30, 40]::FLOAT[4], pk LIMIT 25)
SELECT COUNT(*) FROM ((SELECT * FROM w EXCEPT SELECT * FROM p)
                      UNION ALL (SELECT * FROM p EXCEPT SELECT * FROM w)) d;
----
count
0

