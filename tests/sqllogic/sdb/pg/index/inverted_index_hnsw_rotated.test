same
t

statement ok
CREATE TABLE rot_st (id INTEGER PRIMARY KEY, emb FLOAT[256])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rot_st_l2 ON rot_st
  USING inverted(id, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
CREATE TABLE rot_st_ip (id INTEGER PRIMARY KEY, emb FLOAT[256])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rot_st_ip_idx ON rot_st_ip
  USING inverted(id, emb hnsw (metric = 'ip', quant = 'none'));

statement ok
INSERT INTO rot_st SELECT i, rot_vec(i) FROM range(0, 2500) t(i);

