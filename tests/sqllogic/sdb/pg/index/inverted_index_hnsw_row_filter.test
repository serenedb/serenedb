statement ok
CREATE TABLE hnsw_r (pk INTEGER PRIMARY KEY, emb FLOAT[8], label VARCHAR,
  grp INTEGER, other INTEGER);

statement ok
CREATE INDEX hnsw_r_idx ON hnsw_r
  USING inverted(pk, emb hnsw (metric = 'l2', quant = 'none'))
  INCLUDE (label, grp);

statement ok
INSERT INTO hnsw_r SELECT i, [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8],
  CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END, i % 7, i FROM range(300) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_r;

query
SELECT pk FROM hnsw_r_idx
  WHERE label = 'even' OR grp = 3
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 4;
----
pk
100
101
102
98

query
SELECT pk FROM hnsw_r
  WHERE label = 'even' OR grp = 3
  ORDER BY abs(pk - 100.4) LIMIT 4;
----
pk
100
101
102
98

query
EXPLAIN SELECT pk FROM hnsw_r_idx
  WHERE label = 'even' OR grp = 3
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 4;
----
