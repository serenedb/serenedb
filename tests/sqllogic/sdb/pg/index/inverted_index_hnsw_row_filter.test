query
SELECT pk FROM hnsw_r_idx
  WHERE (label = 'even' OR grp = 3) AND pk >= 250
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
