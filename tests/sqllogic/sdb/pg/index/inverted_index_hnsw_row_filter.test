statement error
SELECT pk FROM hnsw_r_idx
  WHERE label = 'even' OR other < 10
  ORDER BY emb <-> [100.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 2;
----
db error: ERROR: an hnsw vector index answers ORDER BY <distance> LIMIT k and distance ranges, not a distance for every row
DETAIL: The WHERE reads column "other" from the table, which a graph walk cannot filter on.
HINT: Add it to the index's INCLUDE list.


statement ok
CREATE TABLE hnsw_rs (pk INTEGER PRIMARY KEY, num INTEGER, tag VARCHAR,
  extra INTEGER, emb FLOAT[2])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX hnsw_rs_idx ON hnsw_rs
  USING inverted(pk, num, tag, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO hnsw_rs SELECT i, i, CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END,
  i % 13, [i::FLOAT, 0]::FLOAT[2] FROM range(2000) t(i);

statement ok
VACUUM (REFRESH_TABLE) hnsw_rs;

query
SELECT pk FROM hnsw_rs WHERE tag = 'even' OR extra = 0
  ORDER BY emb <-> [1599.4, 0]::FLOAT[2] LIMIT 3;
