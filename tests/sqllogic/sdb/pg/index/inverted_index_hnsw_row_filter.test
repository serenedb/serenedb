  SELECT pk FROM hnsw_rarr_idx WHERE pair = [3, 3]::INTEGER[2] OR grp = 1
  ORDER BY emb <-> [2500.1, 0]::FLOAT[2] LIMIT 3) t JOIN hnsw_rarr r USING (pk);
