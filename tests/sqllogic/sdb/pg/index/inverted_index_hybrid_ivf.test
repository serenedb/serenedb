control substitution on

# ============================================================================
# Hybrid inverted index: text column(s) + IVF vector column(s) in one index.
#
# A text field with the 'offset' feature sets IndexFeatures::Offs; an IVF vector
# field quantized with sq8 (the default) sets IndexFeatures::Vec. Both share the
# same segment and the same ".pay" stream, so a hybrid index makes the segment
# aggregate carry Offs|Pay at once. This exercises that the writer/reader handle
# the mixed stream (the per-field Offs/Pay mutual-exclusion must not be asserted
# at segment scope).
# ============================================================================

statement ok
CREATE TEXT SEARCH DICTIONARY hy_en (
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'lower',
    stemming = false,
    frequency = true,
    position = true,
    offset = true
);

statement ok
CREATE TABLE docs(
    pk INTEGER PRIMARY KEY,
    title VARCHAR,
    body VARCHAR,
    va FLOAT[3],
    vb FLOAT[4]
);

# Two text columns (Offs) + two IVF vector columns defaulting to sq8 (Pay).
statement ok
CREATE INDEX docs_idx ON docs
    USING inverted(pk, title hy_en, body hy_en,
                       va ivf (metric = 'l2'), vb ivf (metric = 'cosine'));

# Same layout but with a mix of an unquantized vector (no Pay) and a quantized
# one (Pay) alongside the text Offs, all in the same segment.
statement ok
CREATE INDEX docs_idx_mix ON docs
    USING inverted(pk, title hy_en,
                       va ivf (metric = 'l2', quant = 'none'),
                       vb ivf (metric = 'ip', quant = 'sq8'));

statement ok
INSERT INTO docs VALUES
    (1, 'red running shoes',     'lightweight trail gear',   [100,0,0]::FLOAT[3], [10,0,0,0]::FLOAT[4]),
    (2, 'blue swimming goggles', 'water sport equipment',    [0,100,0]::FLOAT[3], [0,10,0,0]::FLOAT[4]),
    (3, 'green hiking boots',    'rugged trail gear',        [0,0,100]::FLOAT[3], [0,0,10,0]::FLOAT[4]),
    (4, 'red trail shoes',       'lightweight running gear', [90,10,0]::FLOAT[3], [9,1,0,0]::FLOAT[4]),
    (5, 'yellow tennis racket',  'indoor court equipment',   [50,50,0]::FLOAT[3], [0,0,0,10]::FLOAT[4]);

statement ok
VACUUM (REFRESH_TABLE) docs;

# Exhaustive scan so the tiny-table kNN is exact (nprobe >= nlist).
statement ok
SET sdb_ivf_search_nprobe = 256;

query
SELECT count(*) FROM docs_idx;
----
count
5

# --- text search on each text column -----------------------------------------

query
SELECT pk FROM docs_idx WHERE title @@ 'red' ORDER BY pk;
----
pk
1
4

query
SELECT pk FROM docs_idx WHERE title @@ 'shoes' ORDER BY pk;
----
pk
1
4

query
SELECT pk FROM docs_idx WHERE body @@ 'gear' ORDER BY pk;
----
pk
1
3
4

query
SELECT pk FROM docs_idx WHERE body @@ 'trail' ORDER BY pk;
----
pk
1
3

# --- kNN on each vector column (index name and base-table rewrite) -----------

query
SELECT pk FROM docs_idx ORDER BY va <-> [100,0,0]::FLOAT[3] LIMIT 2;
----
pk
1
4

query
SELECT pk FROM docs ORDER BY va <-> [100,0,0]::FLOAT[3] LIMIT 2;
----
pk
1
4

query
SELECT pk FROM docs_idx ORDER BY va <-> [0,0,100]::FLOAT[3] LIMIT 1;
----
pk
3

query
SELECT pk FROM docs_idx ORDER BY vb <=> [1,0,0,0]::FLOAT[4] LIMIT 2;
----
pk
1
4

query
SELECT pk FROM docs_idx ORDER BY vb <=> [0,0,1,0]::FLOAT[4] LIMIT 1;
----
pk
3

# --- hybrid: one ranking built from a text score and a vector distance -------
#
# Both scores are ordinary projections, so combining them needs no dedicated
# surface -- the weight is what decides which signal wins. These pin that the
# two are available together and that the trade-off actually moves the ranking.
#
# 'trail' / 'gear' picks docs 1, 3 and 4. IDF puts 3 above 4 (two matched terms
# against one); the vector puts 4 above 3 (14.1 away against 141.4). So the
# ranking they disagree on is the interesting one.

query
SELECT pk, round(IDF(docs_idx.tableoid)::DOUBLE, 3) AS idf,
       round((va <-> [100,0,0]::FLOAT[3])::DOUBLE, 3) AS dist
FROM docs_idx WHERE body @@ ts_any(['trail', 'gear']) ORDER BY pk;
----
pk	idf	dist
1	1.414	0
3	1.414	141.421
4	0.539	14.142


# Text alone: 3 before 4.
query
SELECT pk FROM docs_idx WHERE body @@ ts_any(['trail', 'gear'])
ORDER BY IDF(docs_idx.tableoid) DESC, pk;
----
pk
1
3
4


# The vector alone disagrees: 4 before 3.
query
SELECT pk FROM docs_idx WHERE body @@ ts_any(['trail', 'gear'])
ORDER BY va <-> [100,0,0]::FLOAT[3];
----
pk
1
4
3


# Weighted into one score, a small weight leaves the text ranking standing.
query
SELECT pk, round((IDF(docs_idx.tableoid)
                  - (va <-> [100,0,0]::FLOAT[3]) * 0.001)::DOUBLE, 3) AS hybrid
FROM docs_idx WHERE body @@ ts_any(['trail', 'gear'])
ORDER BY hybrid DESC, pk;
----
pk	hybrid
1	1.414
3	1.273
4	0.525


# Ten times the weight and the vector takes over, flipping 3 and 4. That the
# same query answers differently on the weight alone is the whole point: the
# two scores are on unrelated scales, and nothing here normalises them.
query
SELECT pk, round((IDF(docs_idx.tableoid)
                  - (va <-> [100,0,0]::FLOAT[3]) * 0.01)::DOUBLE, 3) AS hybrid
FROM docs_idx WHERE body @@ ts_any(['trail', 'gear'])
ORDER BY hybrid DESC, pk;
----
pk	hybrid
1	1.414
4	0.398
3	0


# A per-branch override composes with it: scoring one branch by a constant
# makes the text side contribute a flat amount, leaving the vector to order
# what is left.
query
SELECT pk, round((BM25(docs_idx.tableoid)
                  - (va <-> [100,0,0]::FLOAT[3]) * 0.01)::DOUBLE, 3) AS hybrid
FROM docs_idx
WHERE (body @@ ts_any(['trail', 'gear']))::score('constant(1)')::merge('max')
ORDER BY hybrid DESC, pk;
----
pk	hybrid
1	1
4	0.859
3	-0.414


# The plan for the weighted form. One IRESEARCH_SCAN carries the text filter and
# the chosen text scorer, and the vector column is read from the index rather
# than looked up in the table -- so both signals come out of a single scan.
query
EXPLAIN SELECT pk, IDF(docs_idx.tableoid)
                   - (va <-> [100,0,0]::FLOAT[3]) * 0.01 AS hybrid
FROM docs_idx WHERE body @@ ts_any(['trail', 'gear'])
ORDER BY hybrid DESC, pk;
----
QUERY PLAN
╭─ ORDER_BY ─────────────────────────────────────────────────────╮
│ Order By:                                                      │
│ va <-> CAST(list_value(100, 0, 0) AS FLOAT[3])) * 0.01)) DESC, │
│ docs_idx.pk ASC                                                │
│ ~1 row                                                         │
╰────────────────────────────────┬───────────────────────────────╯
╭─ PROJECTION ───────────────────┴───────────────────────────────╮
│ Projections: pk, hybrid                                        │
│ ~1 row                                                         │
╰────────────────────────────────┬───────────────────────────────╯
╭─ IRESEARCH_SCAN ───────────────┴───────────────────────────────╮
│ Index: docs_idx                                                │
│ Lookup: table                                                  │
│ Index Filter:                                                  │
│ ╭─ Terms ─────────────────╮                                    │
│ │ Field: body(string)     │                                    │
│ │ Values: 'gear', 'trail' │                                    │
│ │ Min Match: 1            │                                    │
│ ╰─────────────────────────╯                                    │
│ Score: idf()                                                   │
│ Projections: pk (l), va (i), sdb_inverted_index_score          │
│ ~1 row                                                         │
╰────────────────────────────────────────────────────────────────╯


# Ordering by the vector alone, for contrast: the text side is a filter and
# nothing asks for a text score.
query
EXPLAIN SELECT pk FROM docs_idx WHERE body @@ ts_any(['trail', 'gear'])
ORDER BY va <-> [100,0,0]::FLOAT[3];
----
QUERY PLAN
╭─ ORDER_BY ─────────────────────────────╮
│ Order By: #1 ASC                       │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: docs_idx                        │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Terms ─────────────────╮            │
│ │ Field: body(string)     │            │
│ │ Values: 'gear', 'trail' │            │
│ │ Min Match: 1            │            │
│ ╰─────────────────────────╯            │
│ Score: l2_distance(va, FLOAT[3])       │
│ Projections: pk,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# And with the text side pinned to a constant, which is how "rank the text
# matches by vector alone" reads in a plan.
query
EXPLAIN SELECT pk, BM25(docs_idx.tableoid)
                   - (va <-> [100,0,0]::FLOAT[3]) * 0.01 AS hybrid
FROM docs_idx
WHERE (body @@ ts_any(['trail', 'gear']))::score('constant(1)')::merge('max')
ORDER BY hybrid DESC, pk;
----
QUERY PLAN
╭─ ORDER_BY ─────────────────────────────────────────────────────╮
│ Order By:                                                      │
│ va <-> CAST(list_value(100, 0, 0) AS FLOAT[3])) * 0.01)) DESC, │
│ docs_idx.pk ASC                                                │
│ ~1 row                                                         │
╰────────────────────────────────┬───────────────────────────────╯
╭─ PROJECTION ───────────────────┴───────────────────────────────╮
│ Projections: pk, hybrid                                        │
│ ~1 row                                                         │
╰────────────────────────────────┬───────────────────────────────╯
╭─ IRESEARCH_SCAN ───────────────┴───────────────────────────────╮
│ Index: docs_idx                                                │
│ Lookup: table                                                  │
│ Index Filter:                                                  │
│ ╭─ Terms ──────────────────╮                                   │
│ │ Field: body(string)      │                                   │
│ │ Values: 'gear', 'trail'  │                                   │
│ │ Min Match: 1             │                                   │
│ │ Merge: max               │                                   │
│ │ Score: constant(value=1) │                                   │
│ ╰──────────────────────────╯                                   │
│ Score: bm25(k1=1.2, b=0.75)                                    │
│ Projections: pk (l), va (i), sdb_inverted_index_score          │
│ ~1 row                                                         │
╰────────────────────────────────────────────────────────────────╯


# --- hybrid: text filter + vector ordering -----------------------------------

query
SELECT pk FROM docs_idx
WHERE title @@ 'shoes'
ORDER BY va <-> [100,0,0]::FLOAT[3]
LIMIT 2;
----
pk
1
4

query
SELECT pk FROM docs_idx
WHERE body @@ 'gear'
ORDER BY va <-> [0,0,100]::FLOAT[3]
LIMIT 1;
----
pk
3

# --- hybrid: two text predicates + vector ordering ---------------------------

query
SELECT pk FROM docs_idx
WHERE title @@ 'red' AND body @@ 'gear'
ORDER BY va <-> [100,0,0]::FLOAT[3];
----
pk
1
4

# --- mixed-quant index (none vector + sq8 vector + text Offs) -----------------

query
SELECT count(*) FROM docs_idx_mix;
----
count
5

query
SELECT pk FROM docs_idx_mix WHERE title @@ 'red' ORDER BY pk;
----
pk
1
4

query
SELECT pk FROM docs_idx_mix ORDER BY va <-> [0,0,100]::FLOAT[3] LIMIT 1;
----
pk
3

query
SELECT pk FROM docs_idx_mix ORDER BY vb <#> [10,0,0,0]::FLOAT[4] LIMIT 1;
----
pk
1

# --- merge: a second flushed batch + compaction, then re-query ---------------

statement ok
INSERT INTO docs VALUES
    (6, 'red climbing rope',     'durable trail gear',       [80,20,0]::FLOAT[3], [8,2,0,0]::FLOAT[4]),
    (7, 'black cycling helmet',  'road sport equipment',     [0,80,20]::FLOAT[3], [0,8,2,0]::FLOAT[4]),
    (8, 'white golf gloves',     'course accessory',         [0,20,80]::FLOAT[3], [0,0,8,2]::FLOAT[4]);

statement ok
VACUUM (REFRESH_TABLE) docs;

statement ok
VACUUM (COMPACT_TABLE) docs;

query
SELECT count(*) FROM docs_idx;
----
count
8

# newly merged rows are searchable across text and both vectors
query
SELECT pk FROM docs_idx WHERE body @@ 'trail' ORDER BY pk;
----
pk
1
3
6

query
SELECT pk FROM docs_idx WHERE title @@ 'red' ORDER BY pk;
----
pk
1
4
6

query
SELECT pk FROM docs_idx ORDER BY va <-> [100,0,0]::FLOAT[3] LIMIT 1;
----
pk
1

query
SELECT pk FROM docs_idx ORDER BY vb <=> [0,0,1,0]::FLOAT[4] LIMIT 1;
----
pk
3

query
SELECT pk FROM docs_idx
WHERE title @@ 'red'
ORDER BY va <-> [100,0,0]::FLOAT[3]
LIMIT 2;
----
pk
1
4

statement ok
RESET sdb_ivf_search_nprobe;

# --- teardown ---------------------------------------------------------------

statement ok
DROP TABLE docs;
