statement ok
CREATE TABLE inet_edge_t (pk INT PRIMARY KEY, ip INET);

statement ok
CREATE INDEX inet_edge_idx ON inet_edge_t USING inverted(pk, ip);

statement ok
INSERT INTO inet_edge_t SELECT row_number() OVER (), ip FROM (
  SELECT ('10.' || b || '.' || c || '.' || d || '/' || m)::INET AS ip
  FROM (VALUES (0), (1), (2), (3)) b(b), (VALUES (0), (255)) c(c), (VALUES (0), (1), (254), (255)) d(d), (VALUES (16), (24), (31), (32)) m(m)
  UNION ALL
  SELECT ('2001:db8:' || x || '::' || y || '/' || m)::INET
  FROM (VALUES ('0'), ('1'), ('2')) x(x), (VALUES ('0'), ('1'), ('ffff')) y(y), (VALUES (48), (64), (128)) m(m)
  UNION ALL
  SELECT NULL
) s;

statement ok
CREATE TABLE inet_edge_plain AS SELECT * FROM inet_edge_t;

statement ok
VACUUM (REFRESH_TABLE) inet_edge_t;

