statement ok
CREATE TABLE inet_idx_t (pk INT PRIMARY KEY, ip INET);

statement ok
CREATE INDEX inet_idx ON inet_idx_t USING inverted(pk, ip);

statement ok
INSERT INTO inet_idx_t
SELECT g, CASE
  WHEN g % 10 = 0 THEN NULL
  WHEN g % 4 = 0 THEN ((8 + g % 5)::text || '.' || ((g % 9) % 4)::text || '.' || (g % 3)::text || '.' || (g % 7)::text)::INET
  WHEN g % 4 = 1 THEN ((8 + g % 5)::text || '.' || ((g % 9) % 4)::text || '.' || (g % 3)::text || '.' || (g % 7)::text || '/' || (g % 33)::text)::INET
  WHEN g % 4 = 2 THEN ('2001:db8:' || to_hex(g % 3) || '::' || to_hex(g % 50))::INET
  ELSE ('2001:db8:' || to_hex(g % 3) || '::' || to_hex(g % 50) || '/' || (g % 129)::text)::INET
END
FROM generate_series(1, 2000) AS s(g);

statement ok
INSERT INTO inet_idx_t VALUES
  (3001, '0.0.0.0/0'),
  (3002, '::/0'),
  (3003, '10.0.0.0/7'),
  (3004, '255.255.255.255'),
  (3005, 'ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff'),
  (3006, '10.1.2.3'),
  (3007, '10.1.2.3/24'),
  (3008, '2001:db8:1::5'),
  (3009, '10.1.2.3');

statement ok
CREATE TABLE inet_plain_t AS SELECT * FROM inet_idx_t;

statement ok
VACUUM (REFRESH_TABLE) inet_idx_t;

