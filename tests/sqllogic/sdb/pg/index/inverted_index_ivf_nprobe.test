  SELECT pk FROM ivf_np_idx
    ORDER BY emb <-> [1500.4, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 50)
  WHERE pk BETWEEN 1476 AND 1525;
