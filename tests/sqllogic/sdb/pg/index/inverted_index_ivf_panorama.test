# --- l1 stays on the legacy layout, since a rotation does not preserve it -----

statement ok
CREATE TABLE pn_l1 (pk INTEGER PRIMARY KEY, emb FLOAT[64])

statement ok
CREATE INDEX pn_l1_idx ON pn_l1 USING inverted(pk, emb ivf (metric = 'l1', quant = 'none'))

statement count 2000
INSERT INTO pn_l1
SELECT i, list_transform(range(64), x -> CASE WHEN x = 0 THEN i::FLOAT ELSE 0.0::FLOAT END)::FLOAT[64]
FROM range(1, 2001) t(i)

statement ok
VACUUM (REFRESH_TABLE) pn_l1

query
SELECT pk, emb <+> list_transform(range(64), x -> 0.0::FLOAT)::FLOAT[64] AS d
FROM pn_l1_idx ORDER BY d LIMIT 3;
----
pk	d
1	1
2	2
3	3
