  ((SELECT pk FROM pn_l2_idx
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 20)
   EXCEPT
   (SELECT pk FROM pn_l2
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 20))
  UNION ALL
  ((SELECT pk FROM pn_l2
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 20)
   EXCEPT
   (SELECT pk FROM pn_l2_idx
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 20))
) q;
