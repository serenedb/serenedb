# --- a real tree: many clusters, so the threshold carries across postings -----

statement ok
SET sdb_ivf_posting_size = 16

statement ok
CREATE TABLE pn_tree (pk INTEGER PRIMARY KEY, emb FLOAT[64])

statement ok
CREATE INDEX pn_tree_idx ON pn_tree USING inverted(pk, emb ivf (metric = 'l2', quant = 'none'))

statement count 3000
INSERT INTO pn_tree
SELECT i, list_transform(range(64), j -> (sin(i * 1.1 + j * 0.9) / (j + 1))::FLOAT)::FLOAT[64]
FROM range(3000) t(i)

statement ok
VACUUM (REFRESH_TABLE) pn_tree

statement ok
RESET sdb_ivf_posting_size

query
SELECT count(*) AS diff FROM (
  ((SELECT pk FROM pn_tree_idx
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 25)
   EXCEPT
   (SELECT pk FROM pn_tree
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 25))
  UNION ALL
  ((SELECT pk FROM pn_tree
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 25)
   EXCEPT
   (SELECT pk FROM pn_tree_idx
      ORDER BY emb <-> list_transform(range(64), j -> (1.0 / (j + 1))::FLOAT)::FLOAT[64]
      LIMIT 25))
) q;
----
diff
0

# --- store_pk = 'none': no lookup source, and none never needed one ----------

statement ok
CREATE TABLE pn_nopk (pk INTEGER PRIMARY KEY, emb FLOAT[64])

statement ok
CREATE INDEX pn_nopk_idx ON pn_nopk USING inverted(emb ivf (metric = 'l2', quant = 'none')) WITH (store_pk = 'none')

statement count 2000
INSERT INTO pn_nopk
SELECT i, list_transform(range(64), x -> CASE WHEN x = 0 THEN i::FLOAT ELSE 0.0::FLOAT END)::FLOAT[64]
FROM range(1, 2001) t(i)

statement ok
VACUUM (REFRESH_TABLE) pn_nopk

query
SELECT round(emb <-> list_transform(range(64), x -> 0.0::FLOAT)::FLOAT[64], 3) AS d
FROM pn_nopk_idx ORDER BY d LIMIT 3;
