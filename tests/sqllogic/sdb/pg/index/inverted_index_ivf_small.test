control substitution on

# ============================================================================
# Small-dataset IVF: no centroids tree, single all-docs cluster.
#
# When a column's whole valid dataset is smaller than the IVF leaf cap, the
# training sample stays under it too, so the builder never splits and puts every
# doc into a single cluster (id 0) with no coarse tree to descend. Search then
# scans that one posting list via the normal postings + reranker path --
# exhaustive over the segment, hence exact -- even at nprobe = 1. Points lie on a
# line so every query has a unique exact nearest.
#
# The leaf cap is pinned rather than left at the default: sdb_ivf_posting_size 0
# derives it from the row count, the vector width and the quantizer's scan cost,
# which on 300 rows of FLOAT[8] lands at 64 and splits this dataset across
# clusters, making a single-probe search approximate.
# ============================================================================

statement ok
SET sdb_nprobe = 1;

statement ok
SET sdb_ivf_posting_size = 4096;

statement ok
CREATE TABLE small_l2 (pk INTEGER PRIMARY KEY, emb FLOAT[8]);

statement ok
CREATE INDEX small_l2_idx ON small_l2 USING inverted(pk, emb ivf (metric = 'l2'));

statement ok
INSERT INTO small_l2 SELECT i,
  [i::FLOAT, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] FROM range(300) t(i);

statement ok
VACUUM (REFRESH_TABLE) small_l2;

query
SELECT pk FROM small_l2_idx
  ORDER BY emb <-> [0, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 1;
----
pk
0

query
SELECT pk FROM small_l2_idx
  ORDER BY emb <-> [137, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 1;
----
pk
137

query
SELECT pk FROM small_l2_idx
  ORDER BY emb <-> [299, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 3;
----
pk
299
298
297

query
SELECT count(*) FROM small_l2_idx;
----
count
300

query
SELECT pk FROM small_l2_idx
  WHERE pk >= 150
  ORDER BY emb <-> [100, 0, 0, 0, 0, 0, 0, 0]::FLOAT[8] LIMIT 1;
----
pk
150

statement ok
RESET sdb_ivf_posting_size;

statement ok
RESET sdb_nprobe;
