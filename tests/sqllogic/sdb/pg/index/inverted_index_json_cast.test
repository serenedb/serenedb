# An index that also holds the cast expression answers that cast from it.

statement ok
CREATE INDEX jc_both_idx ON jc USING inverted (id, (doc->'v') jc_kw, ((doc->'v')::INT));

query
SELECT id FROM jc_both_idx WHERE (doc->'v')::INT = 42 ORDER BY id;
----
id
1
2
3
4
8

query
EXPLAIN SELECT id FROM jc_both_idx WHERE (doc->'v')::INT = 42;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────────────╮
│ Index: jc_both_idx                         │
│ Lookup: search                             │
│ Index Filter:                              │
│ ╭─ Term ─────────────────────────────────╮ │
│ │ Field:                                 │ │
│ │ CAST((doc -> 'v') AS INTEGER)(numeric) │ │
│ │ Value: 42                              │ │
│ ╰────────────────────────────────────────╯ │
│ Projections: id                            │
│ ~2 rows                                    │
╰────────────────────────────────────────────╯

statement ok
CREATE TABLE jb (id INTEGER PRIMARY KEY, doc JSON);

statement ok
CREATE INDEX jb_idx ON jb USING inverted (id, (doc->'v') jc_kw);

statement ok
INSERT INTO jb VALUES
  (1, '{"v": 9007199254740992}'),
  (2, '{"v": 9007199254740993}'),
  (3, '{"v": 42}');

query
SELECT id FROM jb_idx WHERE (doc->'v')::BIGINT = 9007199254740993 ORDER BY id;
----
id
2

statement ok
CREATE TABLE jd (id INTEGER PRIMARY KEY, doc JSON);

statement ok
CREATE INDEX jd_idx ON jd USING inverted (id, (doc->'v') jc_kw);

statement ok
INSERT INTO jd VALUES
  (1, '{"v": "2024-01-01"}'),
  (2, '{"v": "2024-01-02"}'),
  (3, '{"v": null}'),
  (4, '{"w": 1}');

query
SELECT id FROM jd_idx WHERE (doc->'v')::DATE = DATE '2024-01-01' ORDER BY id;
----
id
1

query
EXPLAIN SELECT id FROM jd_idx WHERE (doc->'v')::DATE = DATE '2024-01-01';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ──────────────────────────────────────────╮
│ Index: jd_idx                                             │
│ Lookup: search                                            │
│ Projections: id                                           │
│ Column Filter:                                            │
│ CAST(json_extract(doc, 'v') AS DATE) = '2024-01-01'::DATE │
│ ~1 row                                                    │
╰───────────────────────────────────────────────────────────╯

query
SELECT id FROM jd_idx WHERE (doc->'v')::TIMESTAMP < TIMESTAMP '2024-01-02' ORDER BY id;
----
id
1

# Issue #1725: -0.0 equals 0.0 and every NaN equals NaN and sorts above every
# number, through an inverted index on a regular table as well.

statement ok
CREATE TABLE repro_nz (id INT PRIMARY KEY, x DOUBLE, f REAL);

statement ok
CREATE INDEX repro_nz_idx ON repro_nz USING inverted (id, x, f);

statement ok
INSERT INTO repro_nz VALUES (1, '-0'::DOUBLE, '-0'::REAL), (2, 0.0, 0.0), (3, -1.5, -1.5), (4, 2.5, 2.5);

query
SELECT id FROM repro_nz_idx WHERE x = 0 ORDER BY id;
----
id
1
2

query
SELECT id FROM repro_nz_idx WHERE x < 0 ORDER BY id;
----
id
3

query
SELECT id FROM repro_nz_idx WHERE x >= 0 ORDER BY id;
----
id
1
2
4

query
SELECT id FROM repro_nz_idx WHERE x = '-0'::DOUBLE ORDER BY id;
----
id
1
2

query
SELECT id FROM repro_nz_idx WHERE f = 0 ORDER BY id;
----
id
1
2

query
SELECT id FROM repro_nz_idx WHERE f < 0 ORDER BY id;
----
id
3

statement ok
CREATE TABLE repro_nan (id INT PRIMARY KEY, x DOUBLE);

statement ok
CREATE INDEX repro_nan_idx ON repro_nan USING inverted (id, x);

statement ok
INSERT INTO repro_nan VALUES (1, 'NaN'::DOUBLE), (2, -('NaN'::DOUBLE)), (3, 1.0), (4, 'Infinity'::DOUBLE);

query
SELECT id FROM repro_nan_idx WHERE x > 0 ORDER BY id;
----
id
1
2
3
4

query
SELECT id FROM repro_nan_idx WHERE x = 'NaN'::DOUBLE ORDER BY id;
----
id
1
2
