# A cast of an indexed JSON path is answered by the index only for the types
# its leaves are stored as: ::DOUBLE for numbers, ::BOOLEAN for booleans, each
# matching leaves of that kind only. Any other cast is checked on the rows, so
# it returns the table's answer (issue #2051).

statement ok
CREATE TEXT SEARCH DICTIONARY jc_kw AS keyword() WITH (frequency);

statement ok
CREATE TABLE jc (id INTEGER PRIMARY KEY, doc JSON);

statement ok
CREATE INDEX jc_idx ON jc USING inverted (id, (doc->'v') jc_kw);

statement ok
CREATE TABLE jcs (id INTEGER PRIMARY KEY, doc JSON);

statement ok
CREATE INDEX jcs_idx ON jcs USING inverted (id, (doc->'v') jc_kw);

statement ok
INSERT INTO jc VALUES
  (1, '{"v": 42}'),
  (2, '{"v": 42.4}'),
  (3, '{"v": 41.6}'),
  (4, '{"v": 42.5}'),
  (5, '{"v": 0.1}'),
  (6, '{"v": -0.0}'),
  (7, '{"v": 0}'),
  (8, '{"v": "42"}'),
  (9, '{"v": true}'),
  (10, '{"v": null}'),
  (11, '{"w": 1}'),
  (12, '{"v": 43.5}'),
  (13, '{"v": 0.10000000149011612}');

statement ok
INSERT INTO jcs SELECT * FROM jc;

query
SELECT id FROM jc WHERE (doc->'v')::INT = 42 ORDER BY id;
----
id
1
2
3
4
8

query
SELECT id FROM jc_idx WHERE (doc->'v')::INT = 42 ORDER BY id;
----
id
1
2
3
4
8

query
EXPLAIN SELECT id FROM jc_idx WHERE (doc->'v')::INT = 42;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────────╮
│ Index: jc_idx                                │
│ Lookup: search                               │
│ Projections: id                              │
│ Column Filter:                               │
│ CAST(json_extract(doc, 'v') AS INTEGER) = 42 │
│ ~2 rows                                      │
╰──────────────────────────────────────────────╯

query
SELECT id FROM jcs WHERE (doc->'v')::INT = 42 ORDER BY id;
----
id
1
2
3
4
8

query
EXPLAIN SELECT id FROM jcs WHERE (doc->'v')::INT = 42;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────────╮
│ Table: jcs                                   │
│ Projections: id                              │
│ Column Filter:                               │
│ CAST(json_extract(doc, 'v') AS INTEGER) = 42 │
│ ~2 rows                                      │
╰──────────────────────────────────────────────╯

