# ::DOUBLE and ::BOOLEAN stay on the index and match number and boolean
# leaves only: the string "42" is not a number leaf.

query
SELECT id FROM jc_idx WHERE (doc->'v')::DOUBLE = 42 ORDER BY id;
----
id
1

query
EXPLAIN SELECT id FROM jc_idx WHERE (doc->'v')::DOUBLE = 42;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────╮
│ Index: jc_idx                    │
│ Lookup: search                   │
│ Index Filter:                    │
│ ╭─ Term ───────────────────────╮ │
│ │ Field: (doc -> 'v')(numeric) │ │
│ │ Value: 42                    │ │
│ ╰──────────────────────────────╯ │
│ Projections: id                  │
│ ~2 rows                          │
╰──────────────────────────────────╯

