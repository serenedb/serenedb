# Arrays of objects and nested arrays are indexed through an expression that
# yields their leaves: list_transform over the objects, a JSONPath wildcard
# over the text, or flatten over the nested arrays.

statement ok
CREATE TABLE jn(pk INTEGER PRIMARY KEY, doc JSON);

statement ok
INSERT INTO jn VALUES
  (1, '{"items": [{"name": "apple", "price": 1.5, "gift": true,
                   "tags": ["red", "fresh"]},
                  {"name": "pear", "price": 3, "tags": ["green"]}],
        "matrix": [["a", 1], [true]]}'),
  (2, '{"items": [{"name": "plum", "price": 10, "gift": false}, {"sku": 7}],
        "matrix": [[2.5, "b"], []]}'),
  (3, '{"items": [], "matrix": []}'),
  (4, '{"other": 1}'),
  (5, NULL),
  (6, '{"items": [{"name": null, "price": null, "tags": [null]}]}'),
  (7, '{"items": [{"name": "a very long product name", "price": "3"},
                  {"name": "groß", "price": 3},
                  {"name": "say \"hi\"", "price": 3}]}');

statement ok
CREATE INDEX jn_idx ON jn USING inverted(pk,
  (list_transform((doc->'items')::JSON[], lambda x: x->'name')) jl_verbatim,
  (list_transform((doc->'items')::JSON[], lambda x: x->'price')) jl_verbatim,
  (list_transform((doc->'items')::JSON[], lambda x: x->'gift')) jl_verbatim,
  (json_extract(doc::VARCHAR, '$.items[*].tags[*]')) jl_verbatim,
  (flatten((doc->'matrix')::JSON[][])) jl_verbatim);

statement ok
VACUUM (REFRESH_TABLE) jn;

query
SELECT pk FROM jn_idx
WHERE list_transform((doc->'items')::JSON[], lambda x: x->'name')
      @@ ts_like('pear')
ORDER BY pk;
----
pk
1

query
SELECT pk FROM jn
WHERE '"pear"'::JSON = ANY(list_transform((doc->'items')::JSON[],
                                          lambda x: x->'name'))
ORDER BY pk;
----
pk
1

query
EXPLAIN SELECT pk FROM jn_idx
WHERE list_transform((doc->'items')::JSON[], lambda x: x->'name')
      @@ ts_like('pear');
----
