query
SELECT pk FROM jl_idx
WHERE ((doc->'t')::JSON[])::BOOLEAN[] @@ ts_between(true, true, true, true)
ORDER BY pk;
----
pk
1

query
SELECT pk FROM jl_idx
WHERE ((doc->'t')::JSON[])::BOOLEAN[] @@ ts_between(false, false, true, true)
ORDER BY pk;
----
pk
2

statement error
INSERT INTO jl VALUES (8, ['{"a": 1}']::JSON[], NULL, '{}');
----
db error: ERROR: Failed to commit: JSON expression indexed by an inverted index must point to a primitive (string/number/boolean/null) leaf; got an object or array


statement ok
VACUUM (COMPACT_TABLE) jl;

query
SELECT pk FROM jl_idx WHERE js @@ ts_like('alpha') ORDER BY pk;
----
pk
1
4

