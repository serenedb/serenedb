hash-threshold 100

# A JSON[] / JSON[N] key with a dictionary is indexed element by element, each
# element by its JSON leaf: strings, numbers, booleans and JSON null. A NULL
# row, a NULL element and a JSON null element stay apart.

statement ok
CREATE TEXT SEARCH DICTIONARY jl_verbatim AS keyword() WITH (frequency);

statement ok
CREATE TABLE jl(pk INTEGER PRIMARY KEY, js JSON[], ja JSON[2], doc JSON);

statement ok
INSERT INTO jl VALUES
  (1, ['"alpha"', '1', 'true']::JSON[], ['"alpha"', '1']::JSON[2],
      '{"t": ["alpha", 1, true]}'),
  (2, ['"beta"', '2.5', 'false', 'null']::JSON[], ['"beta"', 'null']::JSON[2],
      '{"t": ["beta", 2.5, false, null]}'),
  (3, NULL, NULL, '{"u": 1}'),
  (4, ['"alpha"', NULL]::JSON[], [NULL, '"alpha"']::JSON[2],
      '{"t": ["alpha", null]}'),
  (5, []::JSON[], ['true', 'false']::JSON[2], '{"t": []}');

statement ok
CREATE INDEX jl_idx ON jl USING inverted(pk, js jl_verbatim, ja jl_verbatim,
                                         ((doc->'t')::JSON[]) jl_verbatim);

statement ok
VACUUM (REFRESH_TABLE) jl;

statement ok
INSERT INTO jl VALUES
  (6, ['"gamma"', '3', NULL]::JSON[], ['"gamma"', '3']::JSON[2],
      '{"t": ["gamma", 3, null]}'),
  (7, NULL, NULL, '{}');

statement ok
VACUUM (REFRESH_TABLE) jl;

query
SELECT pk FROM jl_idx WHERE js @@ ts_like('alpha') ORDER BY pk;
----
pk
1
4

query
SELECT pk FROM jl WHERE '"alpha"'::JSON = ANY(js) ORDER BY pk;
----
pk
1
4

query
EXPLAIN SELECT pk FROM jl_idx WHERE js @@ ts_like('alpha');
----
