hash-threshold 100
control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY wc_list_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY wc_list_pos_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)
    WITH (frequency, position)

statement ok
CREATE TABLE wc_list_t (id BIGINT PRIMARY KEY, tags VARCHAR[])

statement ok
INSERT INTO wc_list_t VALUES
    (1, ['search', 'alpha']),
    (2, ['research']),
    (3, ['seabird']),
    (4, ['plain']),
    (5, NULL),
    (6, ['deep sea', 'blue whale']),
    (7, ['kappa', NULL, 'omega']),
    (8, [])

statement ok
CREATE INDEX wc_list_idx ON wc_list_t
    USING inverted(id, tags wc_list_dict)
    INCLUDE (id, tags)

statement ok
CREATE INDEX wc_list_pos_idx ON wc_list_t
    USING inverted(id, tags wc_list_pos_dict)

statement ok
INSERT INTO wc_list_t VALUES
    (9, ['bear', 'lynx']),
    (10, ['sew', 'much'])

statement ok
