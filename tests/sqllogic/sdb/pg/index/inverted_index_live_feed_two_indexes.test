CREATE TABLE papich_chat (id INT PRIMARY KEY, word TEXT, mood TEXT);


statement ok
CREATE INDEX papich_chat_word ON papich_chat USING inverted (word);


statement ok
CREATE INDEX papich_chat_mood ON papich_chat USING inverted (mood);


statement ok
