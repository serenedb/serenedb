VACUUM (REFRESH_TABLE) papich_chat;


query
SELECT (SELECT count(*) FROM papich_chat_word) AS words, (SELECT count(*) FROM papich_chat_mood) AS moods, (SELECT count(*) FROM papich_chat_word WHERE word @@ 'word2') AS word2, (SELECT count(*) FROM papich_chat_mood WHERE mood @@ 'mood1') AS mood1;
----
words	moods	word2	mood1
300000	300000	60000	100000


