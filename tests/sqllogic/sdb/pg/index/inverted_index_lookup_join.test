statement ok
COPY (SELECT i AS id, 'title-' || i || '-long-enough-to-not-inline' AS title,
             CASE WHEN i % 3 = 0 THEN 'red fox pad' ELSE 'blue cat pad' END || i AS body, i * 10 AS n
      FROM generate_series(1, 3000) t(i))
TO '${__TEST_DIR__}/lj_src.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet'))
TO '${__TEST_DIR__}/lj_src.csv' (FORMAT csv, HEADER);

statement ok
COPY (SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet'))
TO '${__TEST_DIR__}/lj_src.json' (FORMAT json);

statement ok
COPY (SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet') WHERE id <= 1500)
TO '${__TEST_DIR__}/lj_glob_1.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet') WHERE id > 1500)
TO '${__TEST_DIR__}/lj_glob_2.parquet' (FORMAT parquet);

statement ok
ATTACH '${__TEST_DIR__}/lj_file.duckdb' AS lj_file_${__DATABASE__};

statement ok
CREATE TABLE lj_file_${__DATABASE__}.main.src AS SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet');

statement ok
DETACH lj_file_${__DATABASE__};

statement ok
ATTACH '${__TEST_DIR__}/lj_att.duckdb' AS lj_att_${__DATABASE__};

statement ok
CREATE TABLE lj_att_${__DATABASE__}.main.src AS SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet');

statement ok
CREATE VIEW lj_v_parquet AS SELECT * FROM read_parquet('${__TEST_DIR__}/lj_src.parquet');

statement ok
CREATE VIEW lj_v_csv AS SELECT * FROM read_csv('${__TEST_DIR__}/lj_src.csv');

statement ok
CREATE VIEW lj_v_json AS SELECT * FROM read_json('${__TEST_DIR__}/lj_src.json');

statement ok
CREATE VIEW lj_v_glob AS SELECT * FROM read_parquet('${__TEST_DIR__}/lj_glob_*.parquet');

statement ok
CREATE VIEW lj_v_duckdb AS SELECT * FROM read_duckdb('${__TEST_DIR__}/lj_file.duckdb', table_name='src');

statement ok
CREATE VIEW lj_v_att AS SELECT * FROM lj_att_${__DATABASE__}.main.src;

statement ok
CREATE INDEX lj_v_parquet_idx ON lj_v_parquet USING inverted (body lj_words, n) INCLUDE (n);

statement ok
CREATE INDEX lj_v_csv_idx ON lj_v_csv USING inverted (body lj_words, n) INCLUDE (n);

statement ok
CREATE INDEX lj_v_json_idx ON lj_v_json USING inverted (body lj_words, n) INCLUDE (n);

statement ok
CREATE INDEX lj_v_glob_idx ON lj_v_glob USING inverted (body lj_words, n) INCLUDE (n);

statement ok
CREATE INDEX lj_v_duckdb_idx ON lj_v_duckdb USING inverted (body lj_words, n) INCLUDE (n);

statement ok
CREATE INDEX lj_v_att_idx ON lj_v_att USING inverted (body lj_words, n) INCLUDE (n);

