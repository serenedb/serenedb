statement ok
CREATE TABLE lj_hits (id INTEGER PRIMARY KEY, url VARCHAR, event_time INTEGER, c1 VARCHAR, c2 BIGINT, c3 VARCHAR)
WITH (storage = 'search', compaction_interval = 0);

statement ok
INSERT INTO lj_hits
SELECT i,
       CASE WHEN i % 7 = 0 THEN 'https://google.com/' ELSE 'https://example.com/' END || i,
       100000 - i,
       'payload-' || i || '-long-enough-to-not-inline',
       i * 3,
       md5(i::VARCHAR)
FROM range(5000) t(i);

statement ok
VACUUM (REFRESH_TABLE) lj_hits;

