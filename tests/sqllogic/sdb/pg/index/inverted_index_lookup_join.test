control substitution on

hash-threshold 100

statement ok
CREATE TABLE lj_docs (id INTEGER PRIMARY KEY, title VARCHAR, body VARCHAR, n INTEGER);

statement ok
INSERT INTO lj_docs
SELECT i,
       'title-' || i || '-long-enough-to-not-inline',
       CASE WHEN i % 3 = 0 THEN 'red fox pad' ELSE 'blue cat pad' END || i,
       i * 10
FROM generate_series(1, 3000) t(i);

statement ok
CREATE TEXT SEARCH DICTIONARY lj_words AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm, offset);

statement ok
CREATE INDEX lj_idx ON lj_docs USING inverted (id, body lj_words, n) INCLUDE (n);

statement ok
VACUUM (REFRESH_TABLE) lj_docs;

query
