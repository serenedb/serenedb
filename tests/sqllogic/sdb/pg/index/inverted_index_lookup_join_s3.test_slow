query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || id || '-long-enough-to-not-inline'
  AND body IS NOT DISTINCT FROM (CASE WHEN id % 11 = 0 THEN NULL ELSE CASE WHEN id % 3 = 0 THEN 'red fox pad' ELSE 'blue cat pad' END || id END)
  AND note = CASE WHEN id % 5 = 0 THEN 'line one' || chr(10) || 'line, two ' || id ELSE 'short' END)
FROM (SELECT * FROM read_json('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.json') ORDER BY n DESC LIMIT 1500);
