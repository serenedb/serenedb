control substitution on

statement ok
SET late_materialization_lookup_max_rows = 10000;

statement ok
CREATE OR REPLACE SECRET minio_${__DATABASE__} (
  TYPE s3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/${__DATABASE__}_'
);

statement ok
SET s3_use_ssl = false;

statement ok
CREATE TEXT SEARCH DICTIONARY ljs3_words AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);

statement ok
CREATE TABLE ljs3_src AS
SELECT i AS id,
       'title-' || i || '-long-enough-to-not-inline' AS title,
       CASE WHEN i % 3 = 0 THEN 'red fox pad' ELSE 'blue cat pad' END || i AS body,
       i * 10 AS n
FROM generate_series(1, 3000) t(i);

statement ok
COPY (SELECT * FROM ljs3_src) TO 's3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM ljs3_src WHERE id <= 1500) TO 's3://${MINIO_BUCKET}/${__DATABASE__}_lj_glob_1.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM ljs3_src WHERE id > 1500) TO 's3://${MINIO_BUCKET}/${__DATABASE__}_lj_glob_2.parquet' (FORMAT parquet);

query
EXPLAIN SELECT * FROM read_parquet('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_glob_*.parquet') ORDER BY id % 1500, id LIMIT 4;
----
QUERY PLAN
╭─ PROJECTION ─────────────────────╮
│ Projections: #0, #1, #2, #3      │
│ ~4 rows                          │
╰─────────────────┬────────────────╯
╭─ PROJECTION ────┴────────────────╮
│ Projections: id, title, body, n, │
│              id % 1500           │
│ ~4 rows                          │
╰─────────────────┬────────────────╯
╭─ LOOKUP_JOIN ───┴────────────────╮
│ Key: file_index, file_row_number │
│ ~4 rows                          │
╰─────────────────┬────────────────╯
                  ├────────────────────────────────╮
╭─ TOP_N ─────────┴────────────────╮  ╭─ READ_PARQUET ─────────╮
│ Top: 4                           │  │ Function: READ_PARQUET │
│ Order By: #1 ASC, id ASC         │  │ Projections: title,    │
│ ~4 rows                          │  │              body, n   │
╰─────────────────┬────────────────╯  │ ~4 rows                │
╭─ PROJECTION ────┴────────────────╮  ╰────────────────────────╯
│ Projections: id, id % 1500,      │
│              file_index,         │
│              file_row_number     │
│ ~3,000 rows                      │
╰─────────────────┬────────────────╯
╭─ READ_PARQUET ──┴────────────────╮
│ Function: READ_PARQUET           │
│ Projections: id                  │
│ ~3,000 rows                      │
╰──────────────────────────────────╯

query
SELECT id, title FROM read_parquet('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_glob_*.parquet') ORDER BY id % 1500, id LIMIT 4;
----
id	title
1500	title-1500-long-enough-to-not-inline
3000	title-3000-long-enough-to-not-inline
1	title-1-long-enough-to-not-inline
1501	title-1501-long-enough-to-not-inline

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || id || '-long-enough-to-not-inline' AND n = id * 10)
FROM (SELECT * FROM read_parquet('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_glob_*.parquet') LIMIT 2500 OFFSET 7);
----
count	count
2500	2500

statement ok
COPY (SELECT id, title, CASE WHEN id % 11 = 0 THEN NULL ELSE body END AS body, CASE WHEN id % 5 = 0 THEN 'line one' || chr(10) || 'line, two ' || id ELSE 'short' END AS note, n FROM ljs3_src) TO 's3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.csv' (HEADER);

statement ok
COPY (SELECT id, title, CASE WHEN id % 11 = 0 THEN NULL ELSE body END AS body, CASE WHEN id % 5 = 0 THEN 'line one' || chr(10) || 'line, two ' || id ELSE 'short' END AS note, n FROM ljs3_src) TO 's3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.json' (FORMAT json);

query
EXPLAIN SELECT * FROM read_csv('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.csv') ORDER BY n DESC LIMIT 3;
----
QUERY PLAN
╭─ LOOKUP_JOIN ────────────────╮
│ Key: file_index, file_offset │
│ ~3 rows                      │
╰───────────────┬──────────────╯
                ├────────────────────────────╮
╭─ TOP_N ───────┴──────────────╮  ╭─ READ_CSV ──────────╮
│ Top: 3                       │  │ Function: READ_CSV  │
│ Order By: n DESC             │  │ Projections: id,    │
│ ~3 rows                      │  │              title, │
╰───────────────┬──────────────╯  │              body,  │
╭─ READ_CSV ────┴──────────────╮  │              note   │
│ Function: READ_CSV           │  │ ~3 rows             │
│ Projections: n               │  ╰─────────────────────╯
│ ~8,608 rows                  │
╰──────────────────────────────╯

query
SELECT id, title, body, replace(note, chr(10), '|') AS note FROM read_csv('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.csv') ORDER BY n DESC LIMIT 3;
----
id	title	body	note
3000	title-3000-long-enough-to-not-inline	red fox pad3000	line one|line, two 3000
2999	title-2999-long-enough-to-not-inline	blue cat pad2999	short
2998	title-2998-long-enough-to-not-inline	blue cat pad2998	short

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || id || '-long-enough-to-not-inline'
  AND body IS NOT DISTINCT FROM (CASE WHEN id % 11 = 0 THEN NULL ELSE CASE WHEN id % 3 = 0 THEN 'red fox pad' ELSE 'blue cat pad' END || id END)
  AND note = CASE WHEN id % 5 = 0 THEN 'line one' || chr(10) || 'line, two ' || id ELSE 'short' END)
FROM (SELECT * FROM read_csv('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.csv') ORDER BY n DESC LIMIT 1500);
----
count	count
1500	1500

