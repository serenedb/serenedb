count	count
1500	1500

statement ok
CREATE VIEW ljs3_v_one AS SELECT * FROM read_parquet('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_one.parquet');

statement ok
CREATE VIEW ljs3_v_glob AS SELECT * FROM read_parquet('s3://${MINIO_BUCKET}/${__DATABASE__}_lj_glob_*.parquet');

statement ok
CREATE INDEX ljs3_v_one_idx ON ljs3_v_one USING inverted (body ljs3_words, n) INCLUDE (n);

statement ok
CREATE INDEX ljs3_v_glob_idx ON ljs3_v_glob USING inverted (body ljs3_words, n) INCLUDE (n);

query
EXPLAIN SELECT title, n FROM ljs3_v_glob_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(ljs3_v_glob_idx.tableoid) ASC LIMIT 5;
----
QUERY PLAN
╭─ LOOKUP_JOIN ───────────────────────────────────────────╮
│ Key: file_index, file_row_number                        │
│ ~5 rows                                                 │
╰────────────────────────────┬────────────────────────────╯
                             ├───────────────────────────────────────────────────────────╮
╭─ LOOKUP_JOIN ──────────────┴────────────────────────────╮                  ╭─ INDEX_SOURCE ───────╮
│ Key: iresearch_pk                                       │                  │ Lookup: glob parquet │
│ ~5 rows                                                 │                  │ Projections: title   │
╰────────────────────────────┬────────────────────────────╯                  │ ~5 rows              │
                             ├────────────────────────────────────────────╮  ╰──────────────────────╯
╭─ TOP_N ────────────────────┴────────────────────────────╮  ╭─ IRESEARCH_SCAN ───────╮
│ Top: 5                                                  │  │ Index: ljs3_v_glob_idx │
│ Order By: #0 ASC                                        │  │ Projections: n, pk     │
│ ~5 rows                                                 │  │ ~5 rows                │
╰────────────────────────────┬────────────────────────────╯  ╰────────────────────────╯
╭─ IRESEARCH_SCAN ───────────┴────────────────────────────╮
│ Index: ljs3_v_glob_idx                                  │
│ Index Filter:                                           │
│ ╭─ Term ──────────────╮                                 │
│ │ Field: body(string) │                                 │
│ │ Value: fox          │                                 │
│ ╰─────────────────────╯                                 │
│ Column Filter:                                          │
│ optional: Dynamic Filter (sdb_inverted_index_score < ?) │
│ Score: bm25(k1=1.2, b=0.75)                             │
│ Projections: sdb_inverted_index_score, iresearch_pk     │
│ ~600 rows                                               │
╰─────────────────────────────────────────────────────────╯

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || n // 10 || '-long-enough-to-not-inline' AND body = 'red fox pad' || n // 10)
FROM (SELECT title, body, n FROM ljs3_v_one_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(ljs3_v_one_idx.tableoid) ASC LIMIT 5);
----
count	count
5	5

query
SELECT count(*), count(*) FILTER (WHERE title = 'title-' || n // 10 || '-long-enough-to-not-inline')
FROM (SELECT title, n FROM ljs3_v_one_idx LIMIT 2500 OFFSET 7);
