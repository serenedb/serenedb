statement ok
CREATE TEXT SEARCH DICTIONARY verbatim_dict AS keyword() WITH (frequency);

statement ok
CREATE MACRO twice(x) AS CASE WHEN len(x) = 0 THEN '' ELSE x END;

statement ok
CREATE MACRO joined(l) AS lower(array_to_string(list_transform(l, x -> x.a), ' '));

statement ok
CREATE MACRO edu(l) AS lower(array_to_string(flatten(list_transform(l, x -> [x.a, x.b])), chr(30)));

statement ok
CREATE MACRO suffixes(l) AS
  list_transform(l, x -> array_to_string(list_transform(range(1, len(x.a) + 1), i -> substr(x.a, i)), ' '));

statement ok
CREATE MACRO tails(l, tag) AS
  flatten(list_transform(l, x -> list_transform(
    list_transform([x.t], tok -> list_transform(list_filter(range(1, len(tok) + 1), i -> len(tok[i]) > 0),
                                                i -> array_to_string(tok[i:], ' ')))[1],
    sx -> tag || ':' || sx)));

statement ok
CREATE MACRO tagged(l, v) AS list_transform(l, x -> x.a || ':' || array_to_string(list_sort(v), ' '));

statement ok
CREATE MACRO annotated(a) AS list_transform(a, y -> y || '/' || len(a));

statement ok
CREATE MACRO counted(a) AS array_to_string(list_sort(a), ' ') || '|' || len(a);

statement ok
CREATE MACRO reduced(a) AS list_reduce(a, (acc, y) -> acc || '+' || y, '') || '#' || len(a);

statement ok
CREATE MACRO typed_join(a VARCHAR[]) AS array_to_string(a, ';');

statement ok
CREATE MACRO once(x) AS list_aggr(x, 'string_agg', ' ');

statement ok
CREATE MACRO either(x) AS CASE WHEN len(x) > 1 THEN list_sort(x) ELSE x END;

statement ok
CREATE MACRO dup0(a) AS a || a;

statement ok
CREATE TABLE docs (id BIGINT, s VARCHAR, v VARCHAR[], l STRUCT(a VARCHAR, b VARCHAR, t VARCHAR[])[])
  WITH (storage = 'search');

statement ok
CREATE INDEX docs_idx ON docs USING inverted (id,
  (array_to_string(list_sort(v), ' ')) verbatim_dict,
  (array_to_string(list_sort(v), '-')) verbatim_dict,
  (twice(lower(s))) verbatim_dict,
  (joined(l)) verbatim_dict,
  (lower(array_to_string(flatten(list_transform(l, x -> [x.a, x.b])), chr(30)))) verbatim_dict,
  (suffixes(l)) verbatim_dict,
  (tagged(l, v)) verbatim_dict,
  (annotated(list_sort(v))) verbatim_dict,
  (counted(list_transform(l, x -> x.a))) verbatim_dict,
  (reduced(list_sort(v))) verbatim_dict,
  (typed_join(list_sort(v))) verbatim_dict,
  (list_transform(l, x -> array_to_string(list_sort(x.t), ' '))) verbatim_dict,
  (dup0(lower(s))) verbatim_dict,
  (flatten(list_transform(l, x -> list_transform(range(1, len(x.a) + 1), i -> substr(x.a, i))))) verbatim_dict,
  (list_transform(l, x -> list_aggr(list_transform(range(1, len(x.a) + 1), i -> substr(x.a, i)), 'string_agg', ' '))) verbatim_dict,
  (list_transform(l, x -> array_to_string(['p', 'q'], ' '))) verbatim_dict,
  (list_transform(l, x -> array_to_string(x.t, ' '))) verbatim_dict,
  (once(list_transform(l, y -> y.a))) verbatim_dict,
  (either(v)) verbatim_dict,
  (tails(l, s)) verbatim_dict);

statement ok
INSERT INTO docs VALUES
  (1, 'Data Engineer', ['eng', 'data'], [{'a': 'Data', 'b': 'Engineer', 't': ['y', 'x']}]),
  (2, 'Chef', ['x', 'chef'], [{'a': 'Chef', 'b': 'Cook', 't': ['p']}, {'a': 'Sous', 'b': 'Chef', 't': []}]),
  (3, '', [], []);

statement ok
VACUUM (REFRESH_TABLE) docs;

