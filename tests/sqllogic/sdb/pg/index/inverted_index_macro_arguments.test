# A shared argument that the optimizer rewrites, a || chain or a cast of a
# constant, matches too, also where the body uses it inside its own lambda.
statement ok
CREATE TABLE rewritten (id BIGINT, s VARCHAR) WITH (storage = 'search');

statement ok
CREATE INDEX rewritten_idx ON rewritten USING inverted (id,
  (annotated(string_split(s || '-' || s || '-x', '-'))) verbatim_dict,
  (twice(s || '-' || CAST(1 AS VARCHAR) || '-' || s)) verbatim_dict);

statement ok
INSERT INTO rewritten VALUES (1, 'a'), (2, 'b');

statement ok
VACUUM (REFRESH_TABLE) rewritten;

query
SELECT id FROM rewritten WHERE annotated(string_split(s || '-' || s || '-x', '-')) @@ ts_regexp('x/3') ORDER BY id;
----
id
1
2

query
EXPLAIN SELECT id FROM rewritten WHERE annotated(string_split(s || '-' || s || '-x', '-')) @@ ts_regexp('x/3');
----
QUERY PLAN
╭─ IRESEARCH_SCAN ──────────────────────────────────────────────╮
│ Index: rewritten                                              │
│ Lookup: search                                                │
│ Index Filter:                                                 │
│ ╭─ Term ────────────────────────────────────────────────────╮ │
│ │ Field:                                                    │ │
│ │ annotated(string_split((((s || '-') || s) || '-x'), '-')) │ │
│ │ Value: x/3                                                │ │
│ ╰───────────────────────────────────────────────────────────╯ │
│ Projections: id                                               │
│ ~1 row                                                        │
╰───────────────────────────────────────────────────────────────╯

