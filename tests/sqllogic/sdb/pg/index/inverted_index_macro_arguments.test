statement ok
CREATE TABLE checked (id BIGINT, s VARCHAR) WITH (storage = 'search');

statement ok
CREATE MACRO narrowed(x) AS CASE WHEN len(x) > 1000 THEN CAST(300 AS TINYINT)::VARCHAR ELSE x END;

statement error
CREATE INDEX checked_narrowed_idx ON checked USING inverted (id, (narrowed(lower(s))) verbatim_dict);
----
db error: ERROR: Type INT32 with value 300 can't be cast because the value is out of range for the destination type INT8


statement ok
CREATE MACRO with_oid(x) AS CASE WHEN len(x) > 1000 THEN 'pg_class'::regclass::VARCHAR ELSE x END;

statement error
CREATE INDEX checked_oid_idx ON checked USING inverted (id, (with_oid(lower(s))) verbatim_dict);
----
db error: ERROR: Index keys cannot convert to or from reg* types: the conversion reads the catalog.
HINT: Index the OID column and compare it with a reg* value, such as oid_column = 'name'::regclass.


# A macro body that reads the session is computed from the row, not read
# from the value the inserting session stored, also when the body binds
# its argument once.
statement ok
SET TimeZone = 'UTC';

statement ok
CREATE MACRO local_stamp(a) AS a::TIMESTAMPTZ::VARCHAR || ' / ' || a::VARCHAR;

statement ok
CREATE TABLE stamped (id INT PRIMARY KEY, plain TIMESTAMP);

statement ok
CREATE INDEX stamped_idx ON stamped USING inverted (id, (local_stamp(plain + INTERVAL 1 HOUR)) included());

statement ok
INSERT INTO stamped VALUES (1, '2026-01-01 23:30:00');

statement ok
VACUUM (REFRESH_TABLE) stamped;

statement ok
SET TimeZone = 'Asia/Tokyo';

query
SELECT local_stamp(plain + INTERVAL 1 HOUR) AS s FROM stamped_idx;
----
s
2026-01-02 00:30:00+09 / 2026-01-02 00:30:00

query
EXPLAIN SELECT local_stamp(plain + INTERVAL 1 HOUR) AS s FROM stamped_idx;
----
QUERY PLAN
╭─ PROJECTION ───────╮
│ Projections: s     │
│ ~1 row             │
╰──────────┬─────────╯
╭─ IRESEARCH_SCAN ───╮
│ Index: stamped_idx │
│ Lookup: table      │
│ Projections: plain │
│ ~1 row             │
╰────────────────────╯
