query
SELECT id FROM docs
WHERE list_transform(l, x -> list_aggr(list_transform(range(1, len(x.a) + 1), i -> substr(x.a, i)), 'string_agg', ' '))
  @@ ts_regexp('Data ata ta a') ORDER BY id;
----
id
1

query
EXPLAIN SELECT id FROM docs
WHERE list_transform(l, x -> list_aggr(list_transform(range(1, len(x.a) + 1), i -> substr(x.a, i)), 'string_agg', ' '))
  @@ ts_regexp('Data ata ta a');
----
