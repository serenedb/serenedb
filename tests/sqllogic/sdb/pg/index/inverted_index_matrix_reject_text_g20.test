----
db error: ERROR: Column 'list_d' uses a tokenizer; must be VARCHAR, BLOB, or a LIST/ARRAY of VARCHAR/BLOB (got DOUBLE[])


# (d) ng_dict on LIST<UUID>.
statement error
CREATE INDEX g20_ng_lu ON g20_t USING inverted(pk, list_u ng_dict);
----
db error: ERROR: Column 'list_u' uses a tokenizer; must be VARCHAR, BLOB, or a LIST/ARRAY of VARCHAR/BLOB (got UUID[])


# (e) ng_dict on LIST<GEOMETRY('OGC:CRS84')>: not previously covered for
#     ng_dict on a LIST (only ARRAY at m_gl_ng_array).
statement error
CREATE INDEX g20_ng_lg ON g20_t USING inverted(pk, list_g ng_dict);
----
db error: ERROR: Column 'list_g' has unsupported type GEOMETRY('OGC:CRS84')[] and can not be indexed


# (f) ng_dict on ARRAY<INTEGER,3>.
statement error
CREATE INDEX g20_ng_ai ON g20_t USING inverted(pk, arr_i ng_dict);
----
db error: ERROR: Column 'arr_i' uses a tokenizer; must be VARCHAR, BLOB, or a LIST/ARRAY of VARCHAR/BLOB (got INTEGER[3])


# (g) ng_dict on ARRAY<GEOMETRY('OGC:CRS84'),3>.
statement error
CREATE INDEX g20_ng_ag ON g20_t USING inverted(pk, arr_g ng_dict);
----
db error: ERROR: Column 'arr_g' has unsupported type GEOMETRY('OGC:CRS84')[3] and can not be indexed


# (h) ng_dict on ARRAY<JSON,3>.
statement ok
CREATE INDEX g20_ng_aj ON g20_t USING inverted(pk, arr_j ng_dict);

# (i) ng_dict on scalar BIT.
statement error
CREATE INDEX g20_ng_bit ON g20_t USING inverted(pk, bit_s ng_dict);
----
db error: ERROR: Column 'bit_s' has unsupported type BIT and can not be indexed


# (j) ng_dict on scalar ENUM.
statement error
CREATE INDEX g20_ng_en ON g20_t USING inverted(pk, enum_s ng_dict);
----
db error: ERROR: Column 'enum_s' has unsupported type g20_enum_t and can not be indexed


# (k) ng_dict on INTEGER expression source.
statement error
CREATE INDEX g20_ng_expr_n ON g20_t USING inverted(pk, (n + 1) ng_dict);
----
db error: ERROR: Column '(n + 1)' uses a tokenizer; must be VARCHAR, BLOB, or a LIST/ARRAY of VARCHAR/BLOB (got INTEGER)


# (l) ng_dict on GEOMETRY('OGC:CRS84') expression source. Single-identifier
#     paren collapses to bare column label 'g'.
statement error
CREATE INDEX g20_ng_expr_g ON g20_t USING inverted(pk, (g) ng_dict);
----
db error: ERROR: Column 'g' uses a tokenizer; must be VARCHAR, BLOB, or a LIST/ARRAY of VARCHAR/BLOB (got GEOMETRY('OGC:CRS84'))


