query
SELECT id, indri_dirichlet(mgs_two_idx.tableoid) AS score
FROM mgs_two_idx
WHERE (body @@ 'red' AND tag @@ 'king')::merge('max')
ORDER BY id;
----
id	score
1	0

query
SELECT id,
       abs(ts_explain(mgs_two_idx.tableoid).clauses[1].value::DOUBLE
           + greatest(ts_explain(mgs_two_idx.tableoid).clauses[2].clauses[1].value::DOUBLE,
                      ts_explain(mgs_two_idx.tableoid).clauses[2].clauses[2].value::DOUBLE)
           - bm25(mgs_two_idx.tableoid)) < 1e-5 AS adds_up
FROM mgs_two_idx
WHERE body @@ 'red' AND (body @@ 'fox' AND tag @@ 'king')::merge('max')
ORDER BY id;
----
id	adds_up
1	t
