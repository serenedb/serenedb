query
SELECT id, raw_tf(mgs_term_leads_idx.tableoid) AS score
FROM mgs_term_leads_idx
WHERE body @@ 'red' AND (body @@ 'fox' AND (tag @@ 'king' AND tag @@ 'queen')::merge('sum'))::merge('max')
ORDER BY id;
