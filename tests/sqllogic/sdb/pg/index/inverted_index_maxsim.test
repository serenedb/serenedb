# More outer rows than one chunk, with vector lists of several sizes

statement ok
CREATE TABLE many_users AS SELECT i AS id, toks(i * 1.37 + 0.5, 1 + i % 4) AS q
  FROM range(2500) t(i);

query
SELECT count(*), count(DISTINCT u.id) FROM many_users u
  JOIN docs_ivf d NEAREST 2 BY SIMILARITY maxsim(d.toks, u.q);
----
count	count
5000	2500

query
SELECT count(*) FROM (
  (SELECT u.id, n.pk FROM many_users u,
     LATERAL (SELECT pk FROM docs_ivf ORDER BY maxsim(toks, u.q) DESC LIMIT 2) n)
  EXCEPT (SELECT u.id, d.pk FROM many_users u
     JOIN docs_ivf d EXACT NEAREST 2 BY SIMILARITY maxsim(d.toks, u.q))) t;
----
count
0

query
SELECT count(*) FROM (
  (SELECT u.id, d.pk FROM many_users u
     JOIN docs_hnsw d NEAREST 2 BY SIMILARITY maxsim(d.toks, u.q))
  EXCEPT (SELECT u.id, d.pk FROM many_users u
     JOIN docs_hnsw d EXACT NEAREST 2 BY SIMILARITY maxsim(d.toks, u.q))) t;
