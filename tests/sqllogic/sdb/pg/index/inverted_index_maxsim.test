# A filter is applied per row, before the top is taken

query
SELECT count(*) FROM (
  (SELECT pk FROM docs_ivf WHERE cat = 1
     ORDER BY maxsim(toks, toks(99.5, 3)) DESC LIMIT 10)
  EXCEPT (SELECT pk FROM docs WHERE cat = 1
     ORDER BY maxsim(toks, toks(99.5, 3)) DESC LIMIT 10)) t;
