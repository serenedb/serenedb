control substitution on

# ============================================================================
# Multi-vector columns and late interaction: every token vector of a
# FLOAT[N][] row is an index entry, and ORDER BY maxsim(column, query) DESC
# ranks rows through the vector index. Tokens are unit vectors, as late
# interaction models emit them. At full effort the pushed answer equals the
# scalar's, scores included; at default effort it keeps most of the top.
# ============================================================================

statement ok
CREATE MACRO raw_tok(i, j) AS
  list_transform(range(8), lambda c: sin(i * 0.37 + j * 1.91 + c * 0.73 + i * c * 0.011));

statement ok
CREATE MACRO tok(i, j) AS
  list_transform(raw_tok(i, j), lambda x: x / sqrt(list_sum(list_transform(raw_tok(i, j), lambda y: y * y))))::FLOAT[8];

statement ok
CREATE MACRO toks(i, n) AS
  list_transform(range(n), lambda j: tok(i, j))::FLOAT[8][];

statement ok
CREATE TABLE docs (pk INTEGER PRIMARY KEY, cat INTEGER, toks FLOAT[8][]);

statement ok
INSERT INTO docs SELECT i, i % 3,
  CASE WHEN i % 23 = 0 THEN NULL
       WHEN i % 29 = 0 THEN []::FLOAT[8][]
       ELSE toks(i, 1 + i % 5) END
  FROM range(2000) t(i);

statement ok
CREATE INDEX docs_ivf ON docs
  USING inverted(pk, cat, toks ivf (metric = 'ip', quant = 'none'));

statement ok
CREATE INDEX docs_ivf_sq8 ON docs
  USING inverted(pk, cat, toks ivf (metric = 'ip', quant = 'sq8'));

statement ok
CREATE INDEX docs_ivf_pq ON docs
  USING inverted(pk, cat, toks ivf (metric = 'ip', quant = 'pq', pq_m = 4));

statement ok
CREATE INDEX docs_ivf_rabitq ON docs
  USING inverted(pk, cat, toks ivf (metric = 'ip', quant = 'rabitq', rabitq_bits = 8));

statement ok
CREATE INDEX docs_hnsw ON docs
  USING inverted(pk, cat, toks hnsw (metric = 'ip', quant = 'none'));

statement ok
CREATE INDEX docs_hnsw_sq8 ON docs
  USING inverted(pk, cat, toks hnsw (metric = 'ip', quant = 'sq8'));

statement ok
VACUUM (FLUSH_TABLE) docs;

# A multi-vector index scores by inner product, which maxsim() sums

statement error
CREATE INDEX docs_l2 ON docs USING inverted(pk, toks ivf (metric = 'l2'));
----
db error: ERROR: Column 'toks': an index over FLOAT[N][] needs metric = 'ip', which maxsim() scores with


statement error
CREATE INDEX docs_cos ON docs USING inverted(pk, toks hnsw (metric = 'cosine'));
----
db error: ERROR: Column 'toks': an index over FLOAT[N][] needs metric = 'ip', which maxsim() scores with


# Full effort: every entry is a candidate, so the index answers exactly

statement ok
SET sdb_ivf_search_nprobe = 100000;

statement ok
SET sdb_hnsw_ef_search = 10000;

statement ok
SET sdb_maxsim_overfetch = 1000;

query
SELECT pk, maxsim(toks, toks(777.5, 3)) AS s FROM docs
  ORDER BY s DESC LIMIT 5;
----
pk	s
1377	2.9980333
773	2.9889145
1949	2.9876146
234	2.9840386
1339	2.9773064

query
SELECT pk, maxsim(toks, toks(777.5, 3)) AS s FROM docs_ivf
  ORDER BY s DESC LIMIT 5;
----
pk	s
1377	2.9980333
773	2.9889145
1949	2.9876146
234	2.9840386
1339	2.9773064

query
SELECT pk, maxsim(toks, toks(777.5, 3)) AS s FROM docs_hnsw
  ORDER BY s DESC LIMIT 5;
----
pk	s
1377	2.9980333
773	2.9889145
1949	2.9876146
234	2.9840386
1339	2.9773064

