# Joins: each outer row's vector list is one MaxSim query

statement ok
CREATE TABLE users (id INTEGER, q FLOAT[8][]);

statement ok
INSERT INTO users VALUES
  (1, toks(777.5, 3)),
  (2, toks(1234.5, 1)),
  (3, NULL),
  (4, []::FLOAT[8][]),
  (5, toks(777.5, 3));

query
SELECT u.id, d.pk FROM users u
  JOIN docs_ivf d NEAREST 3 BY SIMILARITY maxsim(d.toks, u.q)
  ORDER BY u.id, d.pk;
----
id	pk
1	1949
1	2488
1	2512
2	914
2	1802
2	2063
5	1949
5	2488
5	2512

query
SELECT u.id, d.pk FROM users u
  JOIN docs d NEAREST 3 BY SIMILARITY maxsim(d.toks, u.q)
  ORDER BY u.id, d.pk;
----
