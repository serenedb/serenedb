1	1949
1	2488
1	2512
2	914
2	1802
2	2063
5	1949
5	2488
5	2512

query
SELECT count(*) FROM (
  (SELECT u.id, d.pk FROM users u
     JOIN docs_ivf d NEAREST 3 BY SIMILARITY maxsim(d.toks, u.q))
  EXCEPT (SELECT u.id, d.pk FROM users u
     JOIN docs_ivf d EXACT NEAREST 3 BY SIMILARITY maxsim(d.toks, u.q))) t;
