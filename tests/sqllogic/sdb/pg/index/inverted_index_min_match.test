hash-threshold 100

statement ok
CREATE TABLE mm (id INTEGER PRIMARY KEY, title VARCHAR, skills VARCHAR, edu VARCHAR, tenure INTEGER);


statement ok
INSERT INTO mm VALUES
  (1, 'data engineer', 'gcp python', 'computer engineering', 5),
  (2, 'data engineer', 'aws', 'computer engineering', 5),
  (3, 'sales manager', 'gcp', 'business', 5),
  (4, 'sales manager', 'aws', 'business', 50),
  (5, 'data engineer', 'gcp', 'business', 50),
  (6, 'sales manager', 'gcp python', 'business', 50);


statement ok
CREATE TEXT SEARCH DICTIONARY mm_words AS split_text() WITH (frequency, position);


statement ok
CREATE INDEX mm_idx ON mm USING inverted(id, title mm_words, skills mm_words, edu mm_words, tenure)
  WITH (compaction_interval = 0);


statement ok
VACUUM (REFRESH_TABLE) mm;


query
SELECT id FROM mm_idx
WHERE (title @@ ts_phrase('data engineer') OR skills @@ 'gcp'
       OR edu @@ ts_like('%engineer%') OR tenure <= 10)::min_match(4)
ORDER BY id;
----
id
1


