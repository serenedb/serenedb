query
SELECT id FROM mm_idx
WHERE (NOT skills @@ 'gcp' OR NOT tenure <= 10 OR NOT edu @@ ts_like('%engineer%'))::min_match(2)
ORDER BY id;
----
id
4
5
6


query error ::min_match\(3\) on an OR of 2 branches
SELECT id FROM mm_idx WHERE (skills @@ 'gcp' OR tenure <= 10)::min_match(3);


query error min_match\(\) count must be >= 1
SELECT id FROM mm_idx WHERE (skills @@ 'gcp' OR tenure <= 10)::min_match(0);


query error ::min_match\(K\) applies to an OR of predicates
SELECT id FROM mm_idx WHERE (skills @@ 'gcp')::min_match(1);


query error ::min_match\(K\) applies to an OR of predicates
SELECT id FROM mm_idx WHERE (skills @@ 'gcp' AND tenure <= 10)::min_match(1);


query error NOT on a ::min_match\(K\) group is not supported
SELECT id FROM mm_idx
WHERE NOT (skills @@ 'gcp' OR tenure <= 10 OR edu @@ ts_like('%engineer%'))::min_match(2);


query error ::min_match used on a predicate the inverted index could not claim
SELECT id FROM mm_idx WHERE (skills @@ 'gcp' OR id > id)::min_match(1);


query error ::min_match\(K\) applies to an OR of predicates, not to a query inside `@@`
SELECT id FROM mm_idx
WHERE skills @@ (ts_phrase('gcp') || ts_phrase('python') || ts_phrase('aws'))::min_match(2);


query error ::min_match\(K\) is only meaningful on an OR of predicates the inverted index answers
SELECT (id > 2 OR tenure <= 10)::min_match(2) FROM mm;


query error ::min_match\(K\) is only meaningful on an OR of predicates the inverted index answers
SELECT ts_phrase('gcp')::min_match(2);


query error ::min_match\(K\) is only meaningful on an OR of predicates the inverted index answers
SELECT 'gcp'::min_match(2);


statement ok
DROP TABLE mm;
