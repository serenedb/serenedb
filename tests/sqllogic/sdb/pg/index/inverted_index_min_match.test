statement ok
CREATE TABLE nm (id INTEGER PRIMARY KEY, skills VARCHAR, bonus INTEGER, tenure INTEGER);


statement ok
INSERT INTO nm VALUES
  (1, 'gcp', NULL, 5),
  (2, 'aws', NULL, 50),
  (3, 'gcp', 10, 50),
  (4, 'aws', 1, 50),
  (5, NULL, 10, 50),
  (6, 'gcp', 1, 5);


statement ok
CREATE INDEX nm_idx ON nm USING inverted(id, skills mm_words, bonus, tenure)
  WITH (compaction_interval = 0);


statement ok
VACUUM (REFRESH_TABLE) nm;


