CREATE TABLE opt_t(x bigint, label text) WITH (segment_memory_max = 67108864, compaction_max_segments = 4, compaction_max_segments_bytes = 1073741824, compaction_floor_segment_bytes = 4194304, row_group_size = 4096, compaction_interval = 0);


statement ok
INSERT INTO opt_t SELECT g, md5(g::text) FROM generate_series(1, 1000) g;


statement ok
CREATE INDEX opt_tuned ON opt_t USING inverted(label);


statement ok
CREATE INDEX opt_default ON opt_t USING inverted(label);


statement ok
CREATE UNIQUE INDEX opt_sec ON opt_t(x);


query
SELECT c.relname, a.amname, c.reloptions FROM pg_class c LEFT JOIN pg_am a ON a.oid = c.relam WHERE c.relname IN ('opt_tuned', 'opt_default', 'opt_sec') ORDER BY c.relname;
