statement ok
CREATE TEXT SEARCH DICTIONARY phrase_words AS split_text(case := 'lower') WITH (frequency, position, norm);

statement ok
CREATE TABLE phrase_docs (id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
CREATE INDEX phrase_idx ON phrase_docs USING inverted (id, body phrase_words);

statement ok
INSERT INTO phrase_docs VALUES (1, 'red fox red'), (2, 'red red red red'), (3, 'a fox and a dog');

query
SELECT a.scorer, a.score = b.score AS same
FROM (
    SELECT 'lm_jm' AS scorer, lm_jm(phrase_idx.tableoid) AS score FROM phrase_idx WHERE body @@ ts_phrase('red fox')
    UNION ALL
    SELECT 'lm_dirichlet', lm_dirichlet(phrase_idx.tableoid, 10) FROM phrase_idx WHERE body @@ ts_phrase('red fox')
    UNION ALL
    SELECT 'indri_dirichlet', indri_dirichlet(phrase_idx.tableoid, 10) FROM phrase_idx WHERE body @@ ts_phrase('red fox')
    UNION ALL
    SELECT 'dfi', dfi(phrase_idx.tableoid) FROM phrase_idx WHERE body @@ ts_phrase('red fox')
    UNION ALL
    SELECT 'dfi saturated', dfi(phrase_idx.tableoid, 'saturated') FROM phrase_idx WHERE body @@ ts_phrase('red fox')
    UNION ALL
    SELECT 'dfi chi_squared', dfi(phrase_idx.tableoid, 'chi_squared') FROM phrase_idx WHERE body @@ ts_phrase('red fox')
) a
JOIN (
    SELECT 'lm_jm' AS scorer, lm_jm(phrase_idx.tableoid) AS score FROM phrase_idx WHERE body @@ ts_phrase('fox red')
    UNION ALL
    SELECT 'lm_dirichlet', lm_dirichlet(phrase_idx.tableoid, 10) FROM phrase_idx WHERE body @@ ts_phrase('fox red')
    UNION ALL
    SELECT 'indri_dirichlet', indri_dirichlet(phrase_idx.tableoid, 10) FROM phrase_idx WHERE body @@ ts_phrase('fox red')
    UNION ALL
    SELECT 'dfi', dfi(phrase_idx.tableoid) FROM phrase_idx WHERE body @@ ts_phrase('fox red')
    UNION ALL
    SELECT 'dfi saturated', dfi(phrase_idx.tableoid, 'saturated') FROM phrase_idx WHERE body @@ ts_phrase('fox red')
    UNION ALL
    SELECT 'dfi chi_squared', dfi(phrase_idx.tableoid, 'chi_squared') FROM phrase_idx WHERE body @@ ts_phrase('fox red')
) b ON a.scorer = b.scorer
ORDER BY a.scorer;
----
scorer	same
dfi	t
dfi chi_squared	t
dfi saturated	t
indri_dirichlet	t
lm_dirichlet	t
lm_jm	t

query
SELECT id,
       round(lm_jm(phrase_idx.tableoid), 4) AS score,
       round(ln(1 + (0.9 * 1 / 3) / (0.1 * 7 / 13)) + ln(1 + (0.9 * 1 / 3) / (0.1 * 3 / 13)), 4) AS sum_of_terms
FROM phrase_idx
WHERE body @@ ts_phrase('red fox')
ORDER BY id;
----
id	score	sum_of_terms
1	4.5218	4.5218

query
SELECT id, lm_jm(phrase_idx.tableoid) AS score, ts_explain(phrase_idx.tableoid) AS why
FROM phrase_idx
WHERE body @@ ts_phrase('red fox')
ORDER BY id;
----
id	score	why
1	4.5217886	{"column":"body","formula":"sum","parts":[{"column":"body","formula":"boost * log(1 + ((1 - lambda) * freq / dl) / (lambda * p))","inputs":{"dl":{"value":3},"freq":{"value":1},"lambda":{"value":0.1},"p":{"formula":"(ttf + 1) / (L + 1)","inputs":{"L":{"value":12},"ttf":{"value":6}},"value":0.53846157}},"term":"red","value":1.8827312},{"column":"body","formula":"boost * log(1 + ((1 - lambda) * freq / dl) / (lambda * p))","inputs":{"dl":{"value":3},"freq":{"value":1},"lambda":{"value":0.1},"p":{"formula":"(ttf + 1) / (L + 1)","inputs":{"L":{"value":12},"ttf":{"value":2}},"value":0.23076923}},"term":"fox","value":2.6390572}],"phrase":["red","fox"],"scorer":"lm_jm(lambda=0.1)","value":4.5217886}

query
SELECT id, dfi(phrase_idx.tableoid) AS score, ts_explain(phrase_idx.tableoid) AS why
FROM phrase_idx
WHERE body @@ ts_phrase('red fox')
ORDER BY id;
----
id	score	why
1	0.45396537	{"column":"body","formula":"sum","parts":[{"column":"body","inputs":{"expected":{"formula":"p * dl","inputs":{"dl":{"value":3}},"value":1.6153847},"freq":{"value":1},"p":{"formula":"(ttf + 1) / (L + 1)","inputs":{"L":{"value":12},"ttf":{"value":6}},"value":0.53846157}},"note":"the term occurs no more often than expected, so it scores 0","term":"red","value":0},{"column":"body","formula":"boost * log2(1 + (freq - expected) / sqrt(expected))","inputs":{"expected":{"formula":"p * dl","inputs":{"dl":{"value":3}},"value":0.6923077},"freq":{"value":1},"p":{"formula":"(ttf + 1) / (L + 1)","inputs":{"L":{"value":12},"ttf":{"value":2}},"value":0.23076923}},"term":"fox","value":0.45396537}],"phrase":["red","fox"],"scorer":"dfi(measure=standardized)","value":0.45396537}
