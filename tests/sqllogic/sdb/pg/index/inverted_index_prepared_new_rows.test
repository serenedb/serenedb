statement ok
CREATE TEXT SEARCH DICTIONARY pnr_dict AS split_text(case := 'lower')
  WITH (frequency, position);

statement ok
CREATE TABLE pnr (pk INTEGER PRIMARY KEY, v INTEGER, b VARCHAR, emb FLOAT[2]);

statement ok
CREATE INDEX pnr_idx ON pnr
  USING inverted(pk, v, b pnr_dict, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
CREATE TABLE pnrs (pk INTEGER PRIMARY KEY, v INTEGER, b VARCHAR, emb FLOAT[2])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX pnrs_idx ON pnrs
  USING inverted(pk, v, b pnr_dict, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO pnr SELECT i, i % 10, CASE WHEN i = 7 THEN 'zeta alpha' ELSE 'alpha' END,
  [i, 0]::FLOAT[2] FROM range(100) t(i);

statement ok
INSERT INTO pnrs SELECT i, i % 10, CASE WHEN i = 7 THEN 'zeta alpha' ELSE 'alpha' END,
  [i, 0]::FLOAT[2] FROM range(100) t(i);

statement ok
VACUUM (REFRESH_TABLE) pnr;

statement ok
VACUUM (REFRESH_TABLE) pnrs;

statement ok
PREPARE pnr_count AS SELECT count(*) AS n FROM pnr_idx;

statement ok
PREPARE pnr_count_where AS SELECT count(*) AS n FROM pnr_idx WHERE v = 3;

statement ok
PREPARE pnr_count_param AS SELECT count(*) AS n FROM pnr_idx WHERE v = $1;

statement ok
PREPARE pnr_match AS SELECT pk FROM pnr_idx WHERE b @@ 'zeta' ORDER BY pk LIMIT 4;

statement ok
PREPARE pnr_top AS SELECT pk FROM pnr_idx WHERE b @@ 'zeta'
  ORDER BY bm25(tableoid) DESC, pk LIMIT 3;

statement ok
PREPARE pnr_terms AS SELECT unnest(ts_dict_agg(b)) AS term FROM pnr_idx ORDER BY term;

statement ok
PREPARE pnr_offsets AS SELECT pk, ts_offsets(b) AS o FROM pnr_idx WHERE b @@ 'zeta'
  ORDER BY pk LIMIT 2;

statement ok
PREPARE pnr_knn AS SELECT pk FROM pnr_idx ORDER BY emb <-> [150, 0]::FLOAT[2] LIMIT 2;

statement ok
PREPARE pnr_knn_where AS SELECT pk FROM pnr_idx WHERE v < 100
  ORDER BY emb <-> [150, 0]::FLOAT[2] LIMIT 2;

statement ok
PREPARE pnrs_count AS SELECT count(*) AS n FROM pnrs;

statement ok
PREPARE pnrs_idx_count AS SELECT count(*) AS n FROM pnrs_idx WHERE v = 3;

statement ok
PREPARE pnrs_match AS SELECT pk FROM pnrs WHERE b @@ 'zeta' ORDER BY pk LIMIT 4;

statement ok
PREPARE pnrs_knn_where AS SELECT pk FROM pnrs WHERE v < 100
  ORDER BY emb <-> [150, 0]::FLOAT[2] LIMIT 2;

