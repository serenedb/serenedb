statement ok
CREATE TEXT SEARCH DICTIONARY ppa_dict AS split_text(case := 'lower')
  WITH (frequency, position);

statement ok
CREATE TABLE ppa (pk INTEGER PRIMARY KEY, v INTEGER, b VARCHAR, emb FLOAT[2]);

statement ok
CREATE INDEX ppa_idx ON ppa
  USING inverted(pk, v, b ppa_dict, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
CREATE TABLE ppas (pk INTEGER PRIMARY KEY, v INTEGER, b VARCHAR, emb FLOAT[2])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX ppas_idx ON ppas
  USING inverted(pk, v, b ppa_dict, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO ppa SELECT i, i % 10,
  CASE WHEN i < 5 THEN repeat('zeta ', i + 1) || 'alpha' ELSE 'alpha' END,
  [i, 0]::FLOAT[2] FROM range(100) t(i);

statement ok
INSERT INTO ppas SELECT i, i % 10,
  CASE WHEN i < 5 THEN repeat('zeta ', i + 1) || 'alpha' ELSE 'alpha' END,
  [i, 0]::FLOAT[2] FROM range(100) t(i);

statement ok
VACUUM (REFRESH_TABLE) ppa;

statement ok
VACUUM (REFRESH_TABLE) ppas;

statement ok
PREPARE ppa_knn AS SELECT pk FROM ppa_idx WHERE v = $1
  ORDER BY emb <-> $2::FLOAT[2] LIMIT $3;

statement ok
PREPARE ppa_bm25 AS SELECT pk FROM ppa_idx WHERE b @@ $1::VARCHAR
  ORDER BY bm25(tableoid) DESC LIMIT $2 OFFSET $3;

statement ok
PREPARE ppa_in AS SELECT count(*) AS n FROM ppa_idx WHERE v IN ($1, $2);

statement ok
PREPARE ppa_range AS SELECT count(*) AS n FROM ppa_idx
  WHERE v BETWEEN $1 AND $2;

statement ok
PREPARE ppa_text AS SELECT count(*) AS n FROM ppa_idx WHERE b @@ $1::VARCHAR;

statement ok
PREPARE ppas_knn AS SELECT pk FROM ppas WHERE v = $1
  ORDER BY emb <-> $2::FLOAT[2] LIMIT $3;

statement ok
PREPARE ppas_bm25 AS SELECT pk FROM ppas WHERE b @@ $1::VARCHAR
  ORDER BY bm25(tableoid) DESC LIMIT $2 OFFSET $3;

statement ok
PREPARE ppas_range AS SELECT count(*) AS n FROM ppas_idx
  WHERE v BETWEEN $1 AND $2;

statement ok
PREPARE ppas_in AS SELECT count(*) AS n FROM ppas WHERE v IN ($1, $2);

statement ok
PREPARE ppas_between AS SELECT count(*) AS n FROM ppas
  WHERE v BETWEEN $1 AND $2;

statement ok
PREPARE ppas_text AS SELECT count(*) AS n FROM ppas WHERE b @@ $1::VARCHAR;

statement ok
PREPARE ppas_beyond AS SELECT count(*) AS n FROM ppas WHERE v > 1000;

