query
SELECT 'é' ~ '^.+.$' AS two_or_more, 'Жук' ~ '^.+...$' AS four_or_more, 'é' ~ '^(.+){2}$' AS two_runs, 'éé' ~ '^(.+){2}$' AS two_chars
