CREATE TEXT SEARCH DICTIONARY irur_w AS generate_wildcard_ngrams(keyword(), 3)


statement ok
CREATE TABLE irur (id INT PRIMARY KEY, msg VARCHAR)


statement ok
INSERT INTO irur VALUES (1, 'é'), (2, 'ab'), (3, 'Жук'), (4, 'x')


