CREATE TABLE rejected_t(id INTEGER PRIMARY KEY, a INTEGER);

statement ok
CREATE INDEX rejected_t_idx ON rejected_t USING inverted(id, a);

statement ok
INSERT INTO rejected_t SELECT i, i % 7 FROM range(1, 2001) r(i);

statement ok
VACUUM (REFRESH_TABLE) rejected_t;

statement ok
CREATE TABLE rejected_u(id INTEGER PRIMARY KEY, w INTEGER);

statement ok
INSERT INTO rejected_u SELECT i, i * 10 FROM range(1, 20001) r(i);

