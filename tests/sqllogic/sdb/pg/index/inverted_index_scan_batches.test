statement ok
SET sdb_scan_split = 'tail'


query
SELECT count(*) FROM sb WHERE body @@ 'dog';
----
count
19733


query
SELECT count(*), max(id) FROM sb WHERE body @@ 'dog';
----
count	max
19733	61200


query
SELECT count(*) FROM sb WHERE body @@ 'fox' AND NOT body @@ 'dog';
----
count
39467


query
SELECT unnest(ts_dict_agg(body)) AS term, unnest(ts_dict_count(body)) AS docs
FROM sb ORDER BY term;
----
term	docs
dog	19733
fox	59200


