control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY sb_words AS split_text_csv(' ')
  WITH (frequency, position)


statement ok
CREATE TABLE sb (id INT PRIMARY KEY, body TEXT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
      row_group_size = 4096)


statement ok
CREATE INDEX sb_idx ON sb USING inverted (body sb_words)


statement ok
INSERT INTO sb
SELECT i, CASE WHEN i % 3 = 0 THEN 'fox dog' ELSE 'fox' END
FROM generate_series(1, 20000) s(i)


statement ok
