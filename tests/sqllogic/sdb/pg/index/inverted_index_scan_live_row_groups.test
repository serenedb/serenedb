n
2048


statement ok
SET profiling_output = '${__TEST_DIR__}/ilr_prefix_k.json'


query
SELECT count(*) AS n FROM ilr_idx WHERE body @@ ts_starts_with('n') AND k = 4;
----
n
2048


statement ok
SET profiling_output = '${__TEST_DIR__}/ilr_score_k.json'


query
SELECT count(*) AS n FROM (SELECT BM25(ilr_idx.tableoid) AS score FROM ilr_idx WHERE body @@ 'fox' AND k = 3) s WHERE score > 0;
----
n
2048


