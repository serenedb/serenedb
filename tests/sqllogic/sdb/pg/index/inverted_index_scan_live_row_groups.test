control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY ilr_words AS split_text(case := 'lower') WITH (frequency, norm);


statement ok
CREATE TABLE ilr (id INTEGER PRIMARY KEY, k INTEGER, body TEXT, tags VARCHAR[], v VARIANT);


statement ok
SET threads = 1


statement ok
INSERT INTO ilr SELECT i, i // 2048, 'quick brown fox n' || (i % 5), ['t' || (i % 4)],
  CASE WHEN i % 2 = 0 THEN {'a': i % 5}::VARIANT ELSE (i % 5)::VARIANT END
FROM range(20480) t(i) ORDER BY i;


statement ok
CREATE INDEX ilr_idx ON ilr USING inverted (id, body ilr_words) INCLUDE (k, body, tags, v)
  WITH (row_group_size = 2048);


statement ok
VACUUM (REFRESH_TABLE) ilr;


statement ok
SET threads = 4


statement ok
SET enable_profiling = 'json'


statement ok
SET profiling_output = '${__TEST_DIR__}/ilr_phrase_k.json'


query
SELECT count(*) AS n FROM ilr_idx WHERE body @@ ts_phrase('quick brown') AND k = 3;
----
n
2048


statement ok
