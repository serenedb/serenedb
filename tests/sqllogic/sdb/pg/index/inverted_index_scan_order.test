statement ok
CREATE TEXT SEARCH DICTIONARY so_en AS split_text_csv(' ')
  WITH (frequency, position)


statement ok
CREATE TABLE so (id INT PRIMARY KEY, body TEXT, g INT)


statement ok
CREATE INDEX so_idx ON so USING inverted (id, body so_en) INCLUDE (g)
  WITH (compaction_interval = 0)


statement ok
CREATE INDEX so_wand ON so USING inverted (id, body so_en)
  WITH (compaction_interval = 0, optimize_top_k = 'bm25(1.2, 0.75)')


statement ok
INSERT INTO so
SELECT i, CASE WHEN i = 250000 THEN repeat('fox ', 30)
               WHEN i % 3 = 0 THEN 'fox dog' ELSE 'fox' END, i % 10000
FROM generate_series(1, 400000) s(i)


statement ok
