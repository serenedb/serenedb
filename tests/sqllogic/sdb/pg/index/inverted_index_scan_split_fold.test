statement ok
CREATE TEXT SEARCH DICTIONARY sf_words AS split_text_csv(' ')
  WITH (frequency, position)


statement ok
CREATE TABLE sf (id INT PRIMARY KEY, body TEXT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
      row_group_size = 4096)


statement ok
CREATE INDEX sf_idx ON sf USING inverted (body sf_words)


statement ok
INSERT INTO sf
SELECT i, 'fox' || (i % 7) || ' dog' || (i % 5)
FROM generate_series(1, 61440) s(i)


statement ok
VACUUM (REFRESH_TABLE) sf


