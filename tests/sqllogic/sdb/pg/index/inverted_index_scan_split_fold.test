statement ok
SET threads = 1


statement ok
SET sdb_scan_split = 'never'


query
SELECT count(*) FROM sf WHERE body @@ ts_any(['fox1', 'fox2', 'fox3']);
----
count
31599


query
SELECT count(*) FROM sf WHERE body @@ ts_starts_with('dog');
----
count
73728


query
SELECT count(*) FROM sf
WHERE body @@ ts_any(['fox1', 'fox2', 'fox3']) AND NOT body @@ 'dog0';
----
count
25279


query
SELECT sum(id) FROM sf
WHERE body @@ ts_any(['fox1', 'fox2', 'fox3', 'dog4']);
----
sum
1475481600


query
SELECT count(*) FROM sf WHERE body @@ ts_any(['fox6', 'dog1']);
----
count
23171


