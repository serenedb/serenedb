# The policy name is read case-insensitively.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::merge('MAX') ORDER BY id;
----
id	score
1	0.3032
2	0.316
3	0.238


# A policy binds to its own node. The inner group takes the best of
# fox / cat, and the outer one still adds dog on top -- doc 1 is fox's 0.6671
# plus dog's 0.8143.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE ((body @@ 'fox' OR body @@ 'cat')::merge('max') OR body @@ 'dog')
ORDER BY id;
----
id	score
1	0.6734
2	0.316
3	0.238


# Written on the outer group instead, and the nested Or flattens into it,
# so the best of all three wins: doc 1 is dog's 0.8143 alone.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE ((body @@ 'fox' OR body @@ 'cat') OR body @@ 'dog')::merge('max')
ORDER BY id;
----
id	score
1	0.3701
2	0.316
3	0.238


# Same thing written flat.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat' OR body @@ 'dog')::merge('max')
ORDER BY id;
----
id	score
1	0.3701
2	0.316
3	0.238


# A per-branch scorer under a group policy: doc 3 matches both, and 10
# beats cat's 0.5235, so the constant is what survives.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE ((body @@ 'fox')::score('constant(10)') OR body @@ 'cat')::merge('max')
ORDER BY id;
----
id	score
1	10
2	0.316
3	10


# An unscored branch contributes nothing to compare, so the other branch
# is the maximum by default.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE ((body @@ 'fox')::score(NULL) OR body @@ 'cat')::merge('max')
ORDER BY id;
----
id	score
1	0
2	0.316
3	0.238


# A boost multiplies what the winning branch scored rather than what the
# sum would have been: doc 3 is 2 x 0.5235, not 2 x 1.0471.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::boost(2.0)::merge('max')
ORDER BY id;
----
id	score
1	0.6065
2	0.6319
3	0.476


# The policy also reaches a group built from a tsquery value, where it
# travels in the value rather than on a predicate.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ ts_any(['fox', 'cat'])::merge('max')
ORDER BY id;
----
id	score
1	0.3032
2	0.316
3	0.238


# And an AND group with an exclusion in it.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (NOT body @@ 'dog' AND body @@ 'fox')::merge('max')
ORDER BY id;
----
id	score
3	0.238


# The plans for those combinations. Nesting first: the policy sits on the inner
# node only, and the outer one is left at its default.
query
