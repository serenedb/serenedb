# ::merge needs a boolean group -- a leaf has no branches to combine, and
# saying so beats ignoring it.
query error ::merge\(\.\.\.\) applies to a boolean group
SELECT id FROM score_idx WHERE (body @@ 'fox')::merge('max');


statement error
