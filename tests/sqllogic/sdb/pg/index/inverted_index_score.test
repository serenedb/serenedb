# ============================================================================
# `(<predicate>)::score(<scorer>)` -- overrides how the wrapped subtree is
# scored, leaving the rest of the query on the ORDER BY scorer.
# ============================================================================

statement ok
CREATE TABLE score_docs (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX score_idx ON score_docs USING inverted(id, body en)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO score_docs VALUES
    (1, 'fox fox fox dog'), (2, 'cat cat'), (3, 'fox cat');


statement ok
VACUUM (REFRESH_TABLE) score_docs;


# Baseline: both branches on the query's BM25.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' OR body @@ 'cat' ORDER BY id;
----
id	score
1	0.3032
2	0.316
3	0.476


# raw_boost scores a flat 1 regardless of frequency. Only the overridden
# branch moves: doc 1 (fox only) is untouched, doc 2 (cat only) becomes 1,
# doc 3 sums fox's 0.5235 with cat's 1.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' OR (body @@ 'cat')::score('raw_boost()')
ORDER BY id;
----
id	score
1	0.3032
2	1
3	1.238


# raw_tf scores the term frequency: doc 2 carries 'cat' twice.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' OR (body @@ 'cat')::score('raw_tf()')
ORDER BY id;
----
id	score
1	0.3032
2	2
3	1.238


# An override on the whole predicate applies to the root node.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'cat')::score('raw_tf()') ORDER BY id;
----
id	score
2	2
3	1


# ::boost composes with the overridden scorer: 3.0 * tf 2.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE body @@ 'fox' OR ((body @@ 'cat')::boost(3.0))::score('raw_tf()')
ORDER BY id;
----
id	score
1	0.3032
2	6
3	3.238


# A nested override wins for its own subtree.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE ((body @@ 'cat')::score('raw_boost()'))::score('raw_tf()')
ORDER BY id;
----
id	score
2	1
3	1


# The in-scan top-k collects overridden hits like any other.
query
SELECT id, score FROM (
  SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
  FROM score_idx WHERE body @@ 'fox' OR (body @@ 'cat')::score('raw_boost()')
  ORDER BY BM25(score_idx.tableoid) DESC LIMIT 5
) t ORDER BY id;
----
id	score
1	0.3032
2	1
3	1.238


# ::score(NULL) excludes the subtree from scoring: it still selects rows, but
# contributes nothing. Docs 1 and 3 score their fox-only BM25 and doc 2, which
# only matches through the unscored branch, comes back with 0.
#
# Note the in-scan top-k is deliberately not exercised here: an unscored branch
# makes 0 a legitimate score, and `ORDER BY score ... LIMIT k` only keeps such
# rows once the top-k collector stops seeding its threshold above zero.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' OR (body @@ 'cat')::score(NULL)
ORDER BY id;
----
id	score
1	0.3032
2	0
3	0.238


# ::score(NULL) applies to a whole boolean group, nested groups included: the
# group still matches, and nothing in it reaches the score.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::score(NULL)
ORDER BY id;
----
id	score
1	0
2	0
3	0


# Doc 1 matches both 'dog' and the unscored group, and scores 'dog' alone.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE body @@ 'dog' OR (body @@ 'fox' OR body @@ 'cat')::score(NULL)
ORDER BY id;
----
id	score
1	0.3701
2	0
3	0


# Inside an AND the unscored side still gates the match, so doc 1 must carry
# 'dog', but scores as if only 'fox' were there -- 1.4814 without the override,
# 0.6671 with it, and 'dog' alone is the 0.8143 difference.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' AND body @@ 'dog' ORDER BY id;
----
id	score
1	0.6734


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' AND (body @@ 'dog')::score(NULL)
ORDER BY id;
----
id	score
1	0.3032


# Two branches agreeing on the override fuse into one node carrying it, so the
# override costs nothing in plan shape: raw_tf sums the term frequencies.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE (body @@ 'fox')::score('raw_tf()') OR (body @@ 'cat')::score('raw_tf()')
ORDER BY id;
----
id	score
1	3
2	2
3	2


# Branches disagreeing cannot fuse into one node, and each keeps its own
# scorer: doc 2 gets raw_boost's flat 1 while doc 1 keeps raw_tf's 3.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE (body @@ 'fox')::score('raw_tf()')
   OR (body @@ 'cat')::score('raw_boost()')
ORDER BY id;
----
id	score
1	3
2	1
3	2


# A constant scorer on a group applies per matching branch, and the group's
# merge type sums them -- doc 3 matches both branches and scores 2, not 1. A
# constant for the whole group needs the group merged with max instead, which
# no SQL surface reaches yet. ::score(NULL) is immune to this: 0 + 0 is 0.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::score('raw_boost()')
ORDER BY id;
----
id	score
1	1
2	1
3	2


# An empty scorer expression is rejected at bind time.
statement error
SELECT id FROM score_idx WHERE (body @@ 'cat')::score('') ORDER BY id;

# Something that is not a scorer call is rejected.
statement error
SELECT id FROM score_idx WHERE (body @@ 'cat')::score('42') ORDER BY id;

# A predicate the index cannot claim is a user error, as it is for ::boost.
query error ::score\(\.\.\.\) used on a predicate the inverted index could not claim
SELECT id FROM score_idx WHERE (id > id)::score('raw_tf()');


# Phrase leaves resolve their scorer from the node they were collected for, so
# an override reaches them. A single-term phrase scores its phrase frequency,
# which is the term frequency -- the same values the plain term spelling gives
# below.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox'))::score('raw_tf()') ORDER BY id;
----
id	score
1	3
3	1


# A two-term phrase occurs twice in doc 1 ('fox fox fox' has two 'fox fox'
# windows) and nowhere else, so raw_tf on the phrase is 2.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox fox'))::score('raw_tf()') ORDER BY id;
----
id	score
1	2


# ::score(NULL) on a phrase drops it out of the ranking entirely.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox'))::score(NULL) ORDER BY id;
----
id	score
1	0
3	0


query
SELECT id FROM score_idx WHERE NOT (body @@ 'cat')::score('raw_tf()');
----
id
1


# ::score also attaches to the tsquery operand of `@@`, not just to a whole
# predicate. The two spellings mean the same thing on a single leaf, so they
# must score the same; the modifier reaching the builder at all depends on the
# cast declining to fold, the way ::tokenize and ::slop already do.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox'::score('raw_tf()') ORDER BY id;
----
id	score
1	3
3	1


# Same, on the predicate instead of the operand.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox')::score('raw_tf()') ORDER BY id;
----
id	score
1	3
3	1


# score(NULL) on an operand leaves that branch out of the score, so doc 1
# (fox only) collects nothing and doc 3 keeps only its cat contribution.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox'::score(NULL) OR body @@ 'cat' ORDER BY id;
----
id	score
1	0
2	0.316
3	0.238


# A boost on the same operand still multiplies the overriding scorer.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox'::boost(2.0)::score('raw_tf()') ORDER BY id;
----
id	score
1	6
3	2


# Chained after another modifier, which resolves through a different cast.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox'::tokenize('keyword')::score('raw_tf()')
ORDER BY id;
----
id	score
1	3
3	1


# Outside an `@@` match there is no subtree to score, as for ::tokenize.
statement error
SELECT 'fox'::score('raw_tf()');

# Siblings that name the same scorer must resolve to one instance, or the
# ByTerms fusion would decline and run a separate iterator per term.
query
EXPLAIN SELECT id FROM score_idx
WHERE (body @@ 'fox')::score('bm25(1.2, 0.75)')
   OR (body @@ 'cat')::score('bm25(1.2, 0.75)');
