statement ok
RESET sdb_disable_top_k_optimization


# Wildcards, regexps and edit distances are lowered to an automaton or a
# multiterm in a pass of their own, and that pass replaces the node the override
# sits on. The scorer has to survive the replacement, or `::score` on any of
# them would silently fall back to the ORDER BY scorer.

query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_like('fo%'))::score(NULL) ORDER BY id;
----
id	score
1	0
3	0


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_regexp('fo.'))::score(NULL) ORDER BY id;
----
id	score
1	0
3	0


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE (body @@ ts_levenshtein('fox', 1))::score(NULL) ORDER BY id;
----
id	score
1	0
3	0


# Without an override the same predicate keeps the ORDER BY scorer, so the zeros
# above are the override landing rather than scoring disappearing.

query
SELECT id, BM25(score_idx.tableoid) > 0 AS scored
FROM score_idx WHERE body @@ ts_like('fo%') ORDER BY id;
----
id	scored
1	t
3	t


# And a scoring override is applied, not merely absent: raw_tf counts 'fox'
# three times in doc 1 and once in doc 3.

query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_like('fo%'))::score('raw_tf()') ORDER BY id;
----
id	score
1	3
3	1


