# constant(K) scores every match the same and asks for no index features, so
# it is the scorer to reach for where frequency and norms are not stored.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox')::score('constant(42)') ORDER BY id;
----
id	score
1	42
3	42


# Over a group the constant is collected per branch and merged, so a document
# matching both branches collects it twice. This is the boolean node's merge,
# not the scorer's doing.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::score('constant(42)')
ORDER BY id;
----
id	score
1	42
2	42
3	84


# constant() with no argument is the query boost alone, which is what
# raw_boost already scores.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox')::score('constant()') ORDER BY id;
----
id	score
1	1
3	1


# A modifier on one element of a list applies to that element only. It reaches
# the element through the tsquery value rather than through the element's type,
# which is what lets it survive the list settling on one element type.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ ts_any(['fox'::score('constant(42)'), 'cat'])
ORDER BY id;
----
id	score
1	42
2	0.316
3	42.238


# Doc 3 above is 42 for fox plus cat's ordinary BM25, so the two elements are
# scored independently rather than one scorer winning the list.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ ts_any(['fox'::score(NULL), 'cat']) ORDER BY id;
----
id	score
1	0
2	0.316
3	0.238


# Same for a per-element boost, and in either element order -- the leading
# element used to decide the whole list's type and so its modifier.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ ts_any(['fox'::boost(5.0), 'cat']) ORDER BY id;
----
id	score
1	1.5161
2	0.316
3	1.4279


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ ts_any(['cat', 'fox'::boost(5.0)]) ORDER BY id;
----
id	score
1	1.5161
2	0.316
3	1.4279


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ ts_all(['fox'::score('constant(9)'), 'cat'])
ORDER BY id;
----
id	score
3	9.238


# Every modifier now lives in the value, so a tsquery reads back as the
# expression that produced it -- which is also how it crosses the wire.
query
SELECT (ts_phrase('a', 'b')::slop(2)::boost(3.0)::score('constant(7)'))::TSQUERY::VARCHAR
  AS rendered;
----
rendered
((ts_phrase('a', 'b'))::slop(2) ^ 3)::score('constant(7)')


query
SELECT ('fox'::TSQUERY)::score(NULL)::TSQUERY::VARCHAR AS rendered;
----
rendered
'fox'::score(NULL)


# ::merge(<policy>) says how a boolean node combines what its branches score.
# 'max' takes the best branch instead of adding them up, so a document matching
# both branches stops collecting twice.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::merge('max') ORDER BY id;
----
id	score
1	0.3032
2	0.316
3	0.238


# 'sum' and 'default' are what the node already did, so both read like the
# unmodified query.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::merge('sum') ORDER BY id;
----
id	score
1	0.3032
2	0.316
3	0.476


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' OR body @@ 'cat')::merge('default')
ORDER BY id;
----
id	score
1	0.3032
2	0.316
3	0.476


# Together with a constant this is what makes a constant score constant: doc 3
# matches both branches and still scores 42 rather than 84.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE (body @@ 'fox' OR body @@ 'cat')::score('constant(42)')::merge('max')
ORDER BY id;
----
id	score
1	42
2	42
3	42


# Either order: ::score wraps the group, and ::merge looks through that wrapper
# to the node whose branches actually merge.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE (body @@ 'fox' OR body @@ 'cat')::merge('max')::score('constant(42)')
ORDER BY id;
----
id	score
1	42
2	42
3	42


query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox' AND body @@ 'cat')::merge('max') ORDER BY id;
----
id	score
3	0.238


# The policy shows in the plan. Same-field branches fuse into one Terms, which
# carries the policy of the Or it replaced.
query
EXPLAIN SELECT id FROM score_idx
WHERE (body @@ 'fox' OR body @@ 'cat')::merge('max');
