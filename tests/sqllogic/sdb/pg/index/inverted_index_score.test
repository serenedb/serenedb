│ │ Slop: 2                                 │ │
│ │ Score: constant(value=7)                │ │
│ ╰─────────────────────────────────────────╯ │
│ Projections: id                             │
│ ~1 row                                      │
╰─────────────────────────────────────────────╯


# Score-bound pruning writes per-block bounds with the index's scorer, which is
# not an upper bound for an overridden node. Pruning is turned off under the
# override, so the ranking must be identical with the optimization forced off.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox'))::score('raw_tf()')
ORDER BY BM25(score_idx.tableoid) DESC, id LIMIT 2;
----
id	score
1	3
3	1


