# Now the leaf kinds that used to reject the override because their iterators
# read the query scorer instead of the node's.

# constant(K) on a phrase: frequency-independent, so the value is exact.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox'))::score('constant(42)')
ORDER BY id;
----
id	score
1	42
3	42


# A phrase with slop is a different iterator from a plain one, so it gets its
# own case.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox dog')::slop(2))::score('constant(7)')
ORDER BY id;
----
id	score
1	7


# n-gram similarity: two n-grams at a 0.5 threshold need only one to match, so
# doc 1 matches on both and doc 3 on 'fox' alone. The node publishes the match
# ratio as a per-document boost, and constant(K) multiplies by it -- so doc 1
# scores the full 5 and doc 3, matching one n-gram of two, scores half.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_ngram('fox dog', 0.5))::score('constant(5)')
ORDER BY id;
----
id	score
1	5
3	2.5


# The hole this fixes: an override written on a group used to pass validation
# because the wrapped node is an Or, and then be ignored by the phrase leaf
# underneath it. Every branch is unscored now, phrase included.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ ts_phrase('fox') OR body @@ 'cat')::score(NULL)
ORDER BY id;
----
id	score
1	0
2	0
3	0


# A phrase branch and a term branch keep their own scorers inside one group.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx
WHERE (body @@ ts_phrase('fox'))::score('raw_tf()') OR (body @@ 'cat')::score('constant(10)')
ORDER BY id;
----
id	score
1	3
2	10
3	11


# The plans. A per-node override prints as a Score attribute on the node it
# wraps, not as a node of its own -- the wrapper is transparent here the same
# way it is to the optimizer. On a phrase that attribute used to be
# unreachable, because the leaf could not have honoured it.
query
EXPLAIN SELECT id FROM score_idx
WHERE (body @@ ts_phrase('fox dog'))::score('constant(42)');
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────────╮
│ Index: score_idx                            │
│ Lookup: table                               │
│ Index Filter:                               │
│ ╭─ Phrase ────────────────────────────────╮ │
│ │ Field: body(string)                     │ │
│ │ Parts: Term:fox(0, 0); Term:dog(1, 1);  │ │
│ │ Score: constant(value=42)               │ │
│ ╰─────────────────────────────────────────╯ │
│ Projections: id                             │
│ ~1 row                                      │
╰─────────────────────────────────────────────╯


# Slop is the phrase node's own attribute and the override is appended after
# it, so a sloppy phrase carries both.
query
EXPLAIN SELECT id FROM score_idx
WHERE (body @@ ts_phrase('fox dog')::slop(2))::score('constant(7)');
