# An override may need index features the query's own scorer does not. The
# features a leaf's postings are read with come from the scorer its collector
# was built for, and the override replaces that scorer for its own subtree, so
# bm25 still gets frequency and norms under an IDF query -- the same values a
# bm25 query produces.
query
SELECT id, round(BM25(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE body @@ 'fox' ORDER BY id;
----
id	score
1	0.3032
3	0.238


query
SELECT id, round(IDF(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox')::score('bm25(1.2, 0.75)') ORDER BY id;
----
id	score
1	0.3032
3	0.238


# Same shape one step further: raw_boost asks for nothing, raw_tf wants
# frequency, and the override gets it.
query
SELECT id, round(RAW_BOOST(score_idx.tableoid)::DOUBLE, 4) AS score
FROM score_idx WHERE (body @@ 'fox')::score('raw_tf()') ORDER BY id;
----
id	score
1	3
3	1


