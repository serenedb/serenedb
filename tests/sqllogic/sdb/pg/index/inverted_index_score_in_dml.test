statement ok
DELETE FROM score_dml
WHERE id = (
  SELECT d.id FROM score_dml_idx AS d
  WHERE d.body @@ ts_phrase('fox')
  ORDER BY bm25(d.tableoid) DESC
  LIMIT 1
);


query
SELECT id FROM score_dml ORDER BY id;
