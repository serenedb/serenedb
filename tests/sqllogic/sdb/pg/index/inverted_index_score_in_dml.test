statement ok
CREATE TEXT SEARCH DICTIONARY score_dml_dict AS split_text(case := 'lower') WITH (frequency, position, norm);


statement ok
CREATE TABLE score_dml (id BIGINT PRIMARY KEY, body TEXT, tag TEXT) WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
CREATE INDEX score_dml_idx ON score_dml USING inverted (id, body score_dml_dict);


statement ok
INSERT INTO score_dml VALUES (1, 'quick fox', 'a'), (2, 'fox', 'a'), (3, 'dog', 'a'), (4, 'fox fox fox', 'a'), (5, 'cat', 'a');


query
SELECT id FROM score_dml_idx
WHERE body @@ ts_phrase('fox')
ORDER BY bm25(score_dml_idx.tableoid) DESC
LIMIT 1;
----
id
4


statement ok
UPDATE score_dml SET tag = 'top'
WHERE id = (
  SELECT id FROM score_dml_idx
  WHERE body @@ ts_phrase('fox')
  ORDER BY bm25(score_dml_idx.tableoid) DESC
  LIMIT 1
);


statement ok
MERGE INTO score_dml AS t
USING (
  SELECT id FROM score_dml_idx
  WHERE body @@ ts_phrase('fox')
  ORDER BY bm25(score_dml_idx.tableoid) DESC
  LIMIT 2
) AS s ON t.id = s.id
WHEN MATCHED AND t.tag = 'a' THEN UPDATE SET tag = 'second';


query
SELECT id, tag FROM score_dml ORDER BY id;
----
id	tag
1	a
2	second
3	a
4	top
5	a


statement ok
DELETE FROM score_dml
WHERE id IN (
  SELECT id FROM score_dml_idx
  WHERE body @@ ts_phrase('fox')
  ORDER BY bm25(score_dml_idx.tableoid) DESC
  LIMIT 2
);


query
SELECT id FROM score_dml ORDER BY id;
