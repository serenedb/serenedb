hash-threshold 100

# ---------------------------------------------------------------------------
# Score-prune optimization correctness on inverted indexes.
#
# Pruning fires only when:
#   * the index has WITH (optimize_top_k = '<scorer-expr>')
#   * the query is `WHERE <filter> ORDER BY <scorer>(idx.tableoid) DESC LIMIT k`
#   * the index's `optimize_top_k` scorer matches the ORDER BY scorer
#   * the filter compiles to an iterator that exposes per-block score bounds:
#       - single Term  (`body @@ ts_phrase('x')` with one token)
#       - ByTerms      (`body @@ ts_any(['a','b'])` -- disjunction over terms)
#
# Two passes:
#   * Small dataset -> EXPLAIN matches a deterministic plan with /
#     without `, optimized`.
#   * 50k-row dataset -> score-bound and plain indexes return identical top-K
#     results, proving the pruning preserves ranking.
# ---------------------------------------------------------------------------

statement ok
CREATE TEXT SEARCH DICTIONARY en_prune(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true,
    norm = true
);


# ---------------------------------------------------------------------------
# Small dataset -- deterministic EXPLAIN coverage.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE prune_small (id INTEGER PRIMARY KEY, body VARCHAR);


statement count 1
INSERT INTO prune_small VALUES (1, 'fox quick');


statement count 1
INSERT INTO prune_small VALUES (2, 'fox lazy dog');


statement count 1
INSERT INTO prune_small VALUES (3, 'lazy dog');


statement count 1
INSERT INTO prune_small VALUES (4, 'fox runs');


statement count 1
INSERT INTO prune_small VALUES (5, 'rabbit fox');


statement ok
CREATE INDEX prune_small_idx ON prune_small USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
VACUUM (REFRESH_TABLE) prune_small;


# Term-only filter + matching scorer + LIMIT -> pruning engages.

query
EXPLAIN SELECT id FROM prune_small_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(prune_small_idx.tableoid) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: prune_small_idx                 │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: bm25(k1=1.2, b=0.75)            │
│ Top: 3, optimized                      │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# Term disjunction (ByTerms iterator) -> pruning engages.

query
EXPLAIN SELECT id FROM prune_small_idx WHERE body @@ ts_any(['fox', 'rabbit']) ORDER BY BM25(prune_small_idx.tableoid) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: prune_small_idx                 │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Terms ─────────────────╮            │
│ │ Field: body(string)     │            │
│ │ Values: 'fox', 'rabbit' │            │
│ │ Min Match: 1            │            │
│ ╰─────────────────────────╯            │
│ Score: bm25(k1=1.2, b=0.75)            │
│ Top: 3, optimized                      │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# No LIMIT -> no TopK pull-up at all -> pruning can't engage.

query
EXPLAIN SELECT id, BM25(prune_small_idx.tableoid) AS s FROM prune_small_idx WHERE body @@ ts_phrase('fox') ORDER BY s DESC;
----
QUERY PLAN
╭─ ORDER_BY ─────────────────────────────╮
│ Order By: #1 DESC                      │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: prune_small_idx                 │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: bm25(k1=1.2, b=0.75)            │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# ASC ordering -> score_top_k rule only matches DESC; pruning does NOT engage.

query
EXPLAIN SELECT id FROM prune_small_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(prune_small_idx.tableoid) ASC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ─────────────────────────────────────────────────╮
│ Top: 3                                                  │
│ Order By: #1 ASC                                        │
│ ~1 row                                                  │
╰────────────────────────────┬────────────────────────────╯
╭─ IRESEARCH_SCAN ───────────┴────────────────────────────╮
│ Index: prune_small_idx                                  │
│ Lookup: table                                           │
│ Index Filter:                                           │
│ ╭─ Term ──────────────╮                                 │
│ │ Field: body(string) │                                 │
│ │ Value: fox          │                                 │
│ ╰─────────────────────╯                                 │
│ Column Filter:                                          │
│ optional: Dynamic Filter (sdb_inverted_index_score < ?) │
│ Score: bm25(k1=1.2, b=0.75)                             │
│ Projections: id, sdb_inverted_index_score               │
│ ~1 row                                                  │
╰─────────────────────────────────────────────────────────╯


# Same bound type, different k1: the stored bound is a representative
# (freq, norm) pair, and k1 cancels out of the comparison that picks it, so the
# pair a bm25 index stored is still the argmax for any k1. Pruning stays on.

query
EXPLAIN SELECT id FROM prune_small_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(prune_small_idx.tableoid, 2.0, 0.75) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: prune_small_idx                 │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: bm25(k1=2, b=0.75)              │
│ Top: 3, optimized                      │
│ Bounds: bm25(k1=1.2, b=0.75)           │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# Same bound type, different b: b does NOT cancel out of the comparison that
# picks the stored (freq, norm) pair, so the pair the index stored for b = 0.75
# need not be the argmax for b = 0.5. Scoring it would under-estimate the block
# maximum and skip blocks holding qualifying rows, so pruning is refused: no
# `, optimized` and no `Bounds:` row.

query
EXPLAIN SELECT id FROM prune_small_idx WHERE body @@ ts_phrase('fox') ORDER BY BM25(prune_small_idx.tableoid, 1.2, 0.5) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: prune_small_idx                 │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: bm25(k1=1.2, b=0.5)             │
│ Top: 3                                 │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# Mismatched scorer: index carries BM25 score bounds, ORDER BY uses TFIDF.
# Top-K still pulls up but `score_prune` is false
# (topk_scorer != scorer), so no `, optimized` suffix.

query
EXPLAIN SELECT id FROM prune_small_idx WHERE body @@ ts_phrase('fox') ORDER BY TFIDF(prune_small_idx.tableoid) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~1 row                                 │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: prune_small_idx                 │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: tfidf(with_norms=false)         │
│ Top: 3                                 │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# ---------------------------------------------------------------------------
# 50k-row dataset -- prove pruning-on and pruning-off return identical top-K.
#
# Vocabulary cycles 10 sentences so term frequencies vary:
#   'fox'        appears in 7 of 10 buckets (~35k docs)  -- prune-friendly
#   'lazy'       appears in 2 of 10 buckets (~10k docs)
#   'rare_token' appears in 1 of 10 buckets (~5k docs)
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE prune_big (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE TABLE plain_big (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
INSERT INTO prune_big SELECT i, CASE i % 10
    WHEN 0 THEN 'fox quick brown jumps'
    WHEN 1 THEN 'fox lazy dog under tree'
    WHEN 2 THEN 'cat sleeping in box'
    WHEN 3 THEN 'fox runs fast across field'
    WHEN 4 THEN 'rabbit and fox dance'
    WHEN 5 THEN 'fox jumps over wall'
    WHEN 6 THEN 'lazy fox does nothing'
    WHEN 7 THEN 'rare_token bird sings'
    WHEN 8 THEN 'fox climbs the tree'
    ELSE 'cat watches eagle eat'
  END
  FROM generate_series(1, 50000) AS s(i);


statement ok
INSERT INTO plain_big SELECT * FROM prune_big;


statement ok
CREATE INDEX prune_big_idx ON prune_big USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
CREATE INDEX plain_big_idx ON plain_big USING inverted(id, body en_prune);


statement ok
VACUUM (REFRESH_TABLE) prune_big;


statement ok
VACUUM (REFRESH_TABLE) plain_big;


# Sanity: both indexes match the same population.

query
SELECT COUNT(*) FROM prune_big_idx WHERE body @@ ts_phrase('fox');
----
count
35000


query
SELECT COUNT(*) FROM plain_big_idx WHERE body @@ ts_phrase('fox');
----
count
35000


# === Term-only pruning -- top-K equivalence ===
#
# The key correctness signal: pruning must never drop a document that belongs
# in the top-K. EXCEPT in both directions catches both false positives and
# false negatives. Tie-break on id keeps results deterministic when scores
# tie (every doc in the same vocabulary bucket has the same body, hence
# the same score).

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY BM25(prune_big_idx.tableoid) DESC, id
           LIMIT 100),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY BM25(plain_big_idx.tableoid) DESC, id
           LIMIT 100)
SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) d;
----
count
0


# Reverse direction (anything in plain top-100 must be in pruned top-100 too).

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY BM25(prune_big_idx.tableoid) DESC, id
           LIMIT 100),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY BM25(plain_big_idx.tableoid) DESC, id
           LIMIT 100)
SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) d;
----
count
0


# === Term disjunction (ByTerms) pruning -- top-K equivalence ===
#
# `ts_any(['fox','lazy','rare_token'])` resolves to ByTerms over three
# postings lists with very different lengths (35k / 10k / 5k). Pruning has to
# carry the heap minimum across term iterators correctly.

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_any(['fox', 'lazy', 'rare_token'])
           ORDER BY BM25(prune_big_idx.tableoid) DESC, id
           LIMIT 100),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_any(['fox', 'lazy', 'rare_token'])
           ORDER BY BM25(plain_big_idx.tableoid) DESC, id
           LIMIT 100)
SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) d;
----
count
0


query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_any(['fox', 'lazy', 'rare_token'])
           ORDER BY BM25(prune_big_idx.tableoid) DESC, id
           LIMIT 100),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_any(['fox', 'lazy', 'rare_token'])
           ORDER BY BM25(plain_big_idx.tableoid) DESC, id
           LIMIT 100)
SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) d;
----
count
0


# === Non-engaging shapes still correct on the score-bound index ===

# No LIMIT -- whole result set, ordered. Pruning is impossible (no k);
# the scan must produce the full ordered sequence.

query
SELECT COUNT(*) FROM prune_big_idx
WHERE body @@ ts_phrase('fox')
  AND BM25(prune_big_idx.tableoid) > 0;
----
count
35000


# ASC ordering -- pruning skipped; bottom-K must still be returned correctly.

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_phrase('rare_token')
           ORDER BY BM25(prune_big_idx.tableoid) ASC, id
           LIMIT 5),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_phrase('rare_token')
           ORDER BY BM25(plain_big_idx.tableoid) ASC, id
           LIMIT 5)
SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) d;
----
count
0


# Mismatched scorer (TFIDF on the BM25 score-bound index) -- pruning off, but
# ranking under TFIDF must agree with the plain index.

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY TFIDF(prune_big_idx.tableoid) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY TFIDF(plain_big_idx.tableoid) DESC, id
           LIMIT 50)
SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) d;
----
count
0

# Cross-k1 pruning must not drop documents. The bound was written with
# bm25(1.2, 0.75) and is read by bm25(2.0, 0.75); if it were not a valid upper
# bound for the query scorer, blocks would be skipped and rows would vanish.

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY BM25(prune_big_idx.tableoid, 2.0, 0.75) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY BM25(plain_big_idx.tableoid, 2.0, 0.75) DESC, id
           LIMIT 50)
SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) d;
----
count
0


# Same, over a ByTerms disjunction rather than a single term.

query
WITH w AS (SELECT id FROM prune_big_idx
           WHERE body @@ ts_any(['fox', 'rabbit'])
           ORDER BY BM25(prune_big_idx.tableoid, 2.0, 0.75) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM plain_big_idx
           WHERE body @@ ts_any(['fox', 'rabbit'])
           ORDER BY BM25(plain_big_idx.tableoid, 2.0, 0.75) DESC, id
           LIMIT 50)
SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) d;
----
count
0


# Comprehensive 100k-row pruned-vs-plain coverage across every multi-term
# filter shape (Range / Prefix / Regexp / Levenshtein) lives in the sibling
# inverted_index_score_prune.test_slow -- kept out of this file so the cheap
# correctness checks above stay fast.


# ============================================================================
# Score bounds beyond bm25 / tfidf.
#
# A scorer can persist skip-list bounds whenever its score is monotone in the
# quantities the bound stores: increasing in tf alone (MaxFreq), in tf/dl
# (DivNorm), or separably in max tf and min dl (MinNorm). The bodies below vary
# both tf and dl heavily -- one-word documents next to 30-repeat and 200-pad
# ones -- so the stored representative pair is actually exercised rather than
# being the same for every block.
# ============================================================================

statement ok
CREATE TABLE bnd (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
INSERT INTO bnd SELECT i, CASE i % 7
    WHEN 0 THEN 'fox'
    WHEN 1 THEN repeat('fox ', 30)
    WHEN 2 THEN 'fox ' || repeat('pad ', 200)
    WHEN 3 THEN repeat('fox ', 12) || repeat('pad ', 3)
    WHEN 4 THEN 'fox fox'
    WHEN 5 THEN repeat('pad ', 100) || repeat('fox ', 25)
    ELSE 'fox ' || repeat('z ', 2)
  END
  FROM generate_series(1, 20000) AS s(i);


statement ok
CREATE INDEX bnd_plain_idx ON bnd USING inverted(id, body en_prune);


statement ok
CREATE INDEX bnd_jm_idx ON bnd USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'lm_jm(0.7)');


statement ok
CREATE INDEX bnd_dir_idx ON bnd USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'lm_dirichlet(2000)');


statement ok
CREATE INDEX bnd_dfi_idx ON bnd USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'dfi()');


statement ok
CREATE INDEX bnd_rtf_idx ON bnd USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'raw_tf()');


statement ok
CREATE INDEX bnd_ind_idx ON bnd USING inverted(id, body en_prune)
  WITH (optimize_top_k = 'indri_dirichlet(2000)');


statement ok
VACUUM (REFRESH_TABLE) bnd;


# lm_jm: DivNorm -- log1p(c * tf/dl) is monotone in tf/dl, and the constant folds
# into a monotone log, so the stored argmax holds for every lambda.

query
EXPLAIN SELECT id FROM bnd_jm_idx WHERE body @@ ts_phrase('fox')
  ORDER BY LM_JM(bnd_jm_idx.tableoid, 0.7) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~3 rows                                │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: bnd_jm_idx                      │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: lm_jm(lambda=0.7)               │
│ Top: 3, optimized                      │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~4,000 rows                            │
╰────────────────────────────────────────╯


# Pruned and unpruned must agree exactly; a bound that under-estimates a block
# maximum would skip blocks holding qualifying rows and the counts would part.

query
WITH w AS (SELECT id FROM bnd_jm_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY LM_JM(bnd_jm_idx.tableoid, 0.7) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM bnd_plain_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY LM_JM(bnd_plain_idx.tableoid, 0.7) DESC, id
           LIMIT 50)
SELECT (SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) a)
     + (SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) b) AS diff;
----
diff
0


# lm_dirichlet: MinNorm -- log1p(tf/(mu*p)) - log1p(dl/mu) separates into a term that only
# grows with tf and one that only shrinks with dl, so max tf with min dl
# bounds the block for every mu.

query
EXPLAIN SELECT id FROM bnd_dir_idx WHERE body @@ ts_phrase('fox')
  ORDER BY LM_DIRICHLET(bnd_dir_idx.tableoid, 2000) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~3 rows                                │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: bnd_dir_idx                     │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: lm_dirichlet(mu=2000)           │
│ Top: 3, optimized                      │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~4,000 rows                            │
╰────────────────────────────────────────╯


# Pruned and unpruned must agree exactly; a bound that under-estimates a block
# maximum would skip blocks holding qualifying rows and the counts would part.

query
WITH w AS (SELECT id FROM bnd_dir_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY LM_DIRICHLET(bnd_dir_idx.tableoid, 2000) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM bnd_plain_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY LM_DIRICHLET(bnd_plain_idx.tableoid, 2000) DESC, id
           LIMIT 50)
SELECT (SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) a)
     + (SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) b) AS diff;
----
diff
0


# dfi: MinNorm -- every measure ((tf-e)/sqrt(e), (tf-e)/e, (tf-e)^2/e) grows with
# tf and shrinks with e = ratio*dl, and the tf <= e -> 0 floor is monotone.

query
EXPLAIN SELECT id FROM bnd_dfi_idx WHERE body @@ ts_phrase('fox')
  ORDER BY DFI(bnd_dfi_idx.tableoid) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~3 rows                                │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: bnd_dfi_idx                     │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: dfi(measure=standardized)       │
│ Top: 3, optimized                      │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~4,000 rows                            │
╰────────────────────────────────────────╯


# Pruned and unpruned must agree exactly; a bound that under-estimates a block
# maximum would skip blocks holding qualifying rows and the counts would part.

query
WITH w AS (SELECT id FROM bnd_dfi_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY DFI(bnd_dfi_idx.tableoid) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM bnd_plain_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY DFI(bnd_plain_idx.tableoid) DESC, id
           LIMIT 50)
SELECT (SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) a)
     + (SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) b) AS diff;
----
diff
0


# raw_tf: MaxFreq -- the score is the frequency itself, so no norm is stored at all:
# Need<kNorm, uint32_t> collapses to an empty member for this tag.

query
EXPLAIN SELECT id FROM bnd_rtf_idx WHERE body @@ ts_phrase('fox')
  ORDER BY RAW_TF(bnd_rtf_idx.tableoid) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~3 rows                                │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: bnd_rtf_idx                     │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: raw_tf()                        │
│ Top: 3, optimized                      │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~4,000 rows                            │
╰────────────────────────────────────────╯


# Pruned and unpruned must agree exactly; a bound that under-estimates a block
# maximum would skip blocks holding qualifying rows and the counts would part.

query
WITH w AS (SELECT id FROM bnd_rtf_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY RAW_TF(bnd_rtf_idx.tableoid) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM bnd_plain_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY RAW_TF(bnd_plain_idx.tableoid) DESC, id
           LIMIT 50)
SELECT (SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) a)
     + (SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) b) AS diff;
----
diff
0


# indri_dirichlet is deliberately NOT given bounds. log((tf + mu*p) / (dl + mu))
# is monotone the same way the two above are, but unlike them it has no floor at
# zero and scores negative whenever tf < mu * P(t|C) -- which on this data is
# every document. Pruning drops rows in that regime, so the scorer reports no
# bound type and the plan must show a bare `Top:` with no `Bounds:` row. Give it
# bounds again only together with a fix for negative scores.

query
EXPLAIN SELECT id FROM bnd_ind_idx WHERE body @@ ts_phrase('fox')
  ORDER BY INDRI_DIRICHLET(bnd_ind_idx.tableoid, 2000) DESC LIMIT 3;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────╮
│ Top: 3                                 │
│ Order By: #1 DESC                      │
│ ~3 rows                                │
╰────────────────────┬───────────────────╯
╭─ IRESEARCH_SCAN ───┴───────────────────╮
│ Index: bnd_ind_idx                     │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Term ──────────────╮                │
│ │ Field: body(string) │                │
│ │ Value: fox          │                │
│ ╰─────────────────────╯                │
│ Score: indri_dirichlet(mu=2000)        │
│ Top: 3                                 │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~4,000 rows                            │
╰────────────────────────────────────────╯


query
WITH w AS (SELECT id FROM bnd_ind_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY INDRI_DIRICHLET(bnd_ind_idx.tableoid, 2000) DESC, id
           LIMIT 50),
     p AS (SELECT id FROM bnd_plain_idx
           WHERE body @@ ts_phrase('fox')
           ORDER BY INDRI_DIRICHLET(bnd_plain_idx.tableoid, 2000) DESC, id
           LIMIT 50)
SELECT (SELECT COUNT(*) FROM (SELECT * FROM w EXCEPT SELECT * FROM p) a)
     + (SELECT COUNT(*) FROM (SELECT * FROM p EXCEPT SELECT * FROM w) b) AS diff;
----
diff
0


statement ok
DROP TABLE bnd;
