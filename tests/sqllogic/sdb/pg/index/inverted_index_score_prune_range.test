INSERT INTO ispr
SELECT i, CASE WHEN i = 6504 THEN 'a a' WHEN hash(i) % 8 = 0 THEN 'a b' ELSE 'b b' END
FROM generate_series(0, 19999) AS g(i);


statement ok
CREATE INDEX ispr_idx ON ispr USING inverted(id, body ispr_dict);


query
SELECT id FROM ispr_idx
WHERE body @@ 'a' AND id < 6600
ORDER BY BM25(ispr_idx.tableoid) DESC
LIMIT 1;
