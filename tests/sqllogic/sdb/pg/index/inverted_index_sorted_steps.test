SET threads = 1;


statement ok
CREATE TABLE iiss (id INTEGER, k INTEGER, body VARCHAR);


statement ok
INSERT INTO iiss SELECT i, (i * 7919) % 1009, 'w' || (i % 13) FROM range(600000) t(i);


statement ok
CREATE INDEX iiss_idx ON iiss USING inverted (body) SORTED BY (k DESC)
  WITH (segment_docs_max = 1, refresh_interval = 0, compaction_interval = 0);


query
SELECT count(*) AS segments, sum(docs) AS docs FROM sdb_segments('iiss_idx');
----
segments	docs
293	600000


statement ok
VACUUM (COMPACT_INDEX) iiss_idx;


query
SELECT count(*) AS segments, sum(docs) AS docs FROM sdb_segments('iiss_idx');
----
segments	docs
1	600000


query
SELECT outcome, cardinality(inputs) AS inputs, input_docs FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'iiss_idx') AND type = 'merge'
ORDER BY id;
----
outcome	inputs	input_docs
merged	38	77760
merged	256	600000


query
SELECT count(*) AS n, list(k) = list(k ORDER BY k DESC) AS sorted FROM iiss_idx;
----
n	sorted
600000	t


query
SELECT count(*) AS n, sum(id) AS total FROM iiss_idx WHERE body @@ 'w3';
----
n	total
46154	13846084615


statement ok
