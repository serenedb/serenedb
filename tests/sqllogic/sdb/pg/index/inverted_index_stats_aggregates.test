statement count 40
COPY (SELECT i AS id, i * 5 AS n, 'category-shared-prefix-' || (i % 3) AS cat, 'quick fox' AS body
      FROM generate_series(1, 40) g(i))
TO '${__TEST_DIR__}/sag_a.parquet' (FORMAT PARQUET)

statement count 30
COPY (SELECT i AS id, i * 5 AS n, 'category-shared-prefix-' || (i % 3) AS cat, 'lazy dog' AS body
      FROM generate_series(41, 70) g(i))
TO '${__TEST_DIR__}/sag_b.parquet' (FORMAT PARQUET)

statement ok
CREATE VIEW sag_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/sag_*.parquet')

statement ok
CREATE INDEX sag_v_idx ON sag_v USING inverted(cat sag_kw, body sag_en) INCLUDE (n)

