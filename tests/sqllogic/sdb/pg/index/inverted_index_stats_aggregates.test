CREATE TABLE sag_g (a INT, g INT GENERATED ALWAYS AS (a * 10) VIRTUAL, b INT, c TEXT)

statement ok
CREATE INDEX sag_g_idx ON sag_g USING inverted(c sag_kw) INCLUDE (a, b)

statement ok
INSERT INTO sag_g (a, b, c) SELECT i, 1000 - i, 'k' || i FROM generate_series(1, 50) g(i)

statement ok
