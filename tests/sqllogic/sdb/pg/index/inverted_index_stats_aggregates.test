control substitution on

statement ok
SET compaction_interval = 0

statement ok
SET refresh_interval = 0

statement ok
CREATE TEXT SEARCH DICTIONARY sag_kw AS keyword()

statement ok
CREATE TEXT SEARCH DICTIONARY sag_en AS split_text(case := 'lower')

statement ok
CREATE TABLE sag (id INTEGER PRIMARY KEY, n BIGINT, d DATE, cat VARCHAR, body VARCHAR, s VARCHAR)

statement ok
CREATE INDEX sag_idx ON sag USING inverted(cat sag_kw, body sag_en, s) INCLUDE (n, d)
    WITH (refresh_interval = 0, compaction_interval = 0)

statement ok
INSERT INTO sag SELECT i, i * 3 - 50, DATE '2024-01-01' + i, 'category-shared-prefix-' || (i % 7),
    CASE WHEN i % 2 = 0 THEN 'quick fox' ELSE 'lazy dog' END, 'v' || i
  FROM generate_series(1, 100) g(i)

statement ok
VACUUM (REFRESH_TABLE) sag

statement ok
INSERT INTO sag SELECT i, i * 3 - 50, DATE '2024-01-01' + i, 'category-shared-prefix-' || (i % 7),
    'slow cat', NULL
  FROM generate_series(101, 150) g(i)

statement ok
VACUUM (REFRESH_TABLE) sag

