control substitution on

hash-threshold 100

statement ok
CREATE TEMPORARY TABLE temp_docs (
  id    INTEGER PRIMARY KEY,
  body  TEXT,
  tag   TEXT,
  views INTEGER
);


statement count 5
INSERT INTO temp_docs VALUES
  (1, 'pudge goes mid and dominates the lane', 'gameplay', 1200),
  (2, 'anchin reads manga every weekend',      'reading',  340),
  (3, 'pudge plays again in a ranked match',   'gameplay', 870),
  (4, 'krivda writes sql for the new feature', 'work',     55),
  (5, 'mom reviews pudge highlight reel',      'family',   12);


statement ok
CREATE TEXT SEARCH DICTIONARY temp_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE INDEX temp_idx ON temp_docs USING inverted(body temp_en) INCLUDE (tag, views)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


query
SELECT id, tag, views FROM temp_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id	tag	views
1	gameplay	1200
3	gameplay	870
5	family	12


query
SELECT id FROM temp_idx WHERE body @@ ts_phrase('ranked match') ORDER BY id;
----
id
3


query
SELECT id FROM temp_idx WHERE body @@ ts_phrase('pudge')
ORDER BY BM25(temp_idx.tableoid) DESC, id LIMIT 2;
----
id
5
1


statement count 2
INSERT INTO temp_docs VALUES
  (6, 'pudge hooks the courier again', 'gameplay', 4),
  (7, 'a quiet weekend with tea',      'family',   9);


statement ok
VACUUM (REFRESH_TABLE) temp_docs;


