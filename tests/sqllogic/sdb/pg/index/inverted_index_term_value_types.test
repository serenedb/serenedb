statement ok
CREATE TEXT SEARCH DICTIONARY tvt_shape AS encode_geojson()


statement ok
CREATE TEXT SEARCH DICTIONARY tvt_en AS split_text_csv(' ') WITH (frequency, position)


statement ok
CREATE TABLE tvt (id INTEGER PRIMARY KEY, b BOOLEAN, g GEOMETRY('OGC:CRS84'), body TEXT)


statement ok
CREATE INDEX tvt_idx ON tvt USING inverted (id, b, g tvt_shape, body tvt_en, (lower(body)))


statement ok
INSERT INTO tvt VALUES
  (1, true, 'POINT(1 1)'::GEOMETRY('OGC:CRS84'), 'quick brown fox'),
  (2, false, 'POINT(2 2)'::GEOMETRY('OGC:CRS84'), 'lazy dog')


query
SELECT id FROM tvt_idx WHERE b @@ 'true' ORDER BY id;
----
id
1


query error
SELECT id FROM tvt_idx WHERE b @@ 'maybe' ORDER BY id;
