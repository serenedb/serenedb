db error: ERROR: Could not convert string 'maybe' to BOOL


query
SELECT id FROM tvt_idx WHERE b < true ORDER BY id;
----
id
2


query
SELECT id FROM tvt_idx WHERE CAST(lower(body) AS BLOB) = 'lazy dog'::BLOB ORDER BY id;
----
id
2


query
SELECT id FROM tvt_idx WHERE g = 'POINT(1 1)'::GEOMETRY('OGC:CRS84') ORDER BY id;
----
id
1


query
SELECT id FROM tvt_idx WHERE g <> 'POINT(1 1)'::GEOMETRY('OGC:CRS84') ORDER BY id;
----
id
2


query
SELECT id FROM tvt_idx WHERE g IN ('POINT(1 1)'::GEOMETRY('OGC:CRS84'), 'POINT(3 3)'::GEOMETRY('OGC:CRS84')) ORDER BY id;
----
id
1


