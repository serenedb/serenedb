│ Index Filter:                         │
│ ╭─ Or ──────────────────╮             │
│ ╰───────────┬───────────╯             │
│ ╭─ Terms ───┴───────────╮             │
│ │ Field: body(string)   │             │
│ │ Values: 'mid', 'rare' │             │
│ ╰───────────────────────╯             │
│ Score: bm25(k1=1.2, b=0.75)           │
│ Top: 10, optimized                    │
│ Projections: sdb_inverted_index_score │
│ ~12,000 rows                          │
╰───────────────────────────────────────╯


query
SELECT q, k, same FROM (
  SELECT 'rare OR mid' AS q, 10 AS k, same FROM shapes_same('rare OR mid', 10)
  UNION ALL SELECT 'run OR rare', 10, same FROM shapes_same('run OR rare', 10)
  UNION ALL SELECT 'run OR holes OR sparse', 10, same FROM shapes_same('run OR holes OR sparse', 10)
  UNION ALL SELECT 'run OR holes OR sparse', 100, same FROM shapes_same('run OR holes OR sparse', 100)
  UNION ALL SELECT 'cluster OR half', 10, same FROM shapes_same('cluster OR half', 10)
  UNION ALL SELECT 'edge OR dense', 10, same FROM shapes_same('edge OR dense', 10)
  UNION ALL SELECT 'burst OR mid OR rare', 10, same FROM shapes_same('burst OR mid OR rare', 10)
  UNION ALL SELECT 'common OR rare', 10, same FROM shapes_same('common OR rare', 10)
  UNION ALL SELECT 'run OR cluster', 100, same FROM shapes_same('run OR cluster', 100)
  UNION ALL SELECT 'run OR sparse OR rare', 1, same FROM shapes_same('run OR sparse OR rare', 1)
  UNION ALL SELECT '+rare +dense', 10, same FROM shapes_same('+rare +dense', 10)
