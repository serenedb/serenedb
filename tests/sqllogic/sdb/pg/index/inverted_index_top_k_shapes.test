CREATE MACRO shapes_same_ranged(q, upto, k) AS TABLE
  SELECT p.n = e.n
     AND abs(p.low - e.low) <= 1e-4 * greatest(1, abs(e.low))
     AND abs(p.total - e.total) <= 1e-4 * greatest(1, abs(e.total)) AS same
  FROM (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx
          WHERE body @@ to_tsquery(q) AND id @@ (ts_lt(upto) ^ 2.0)
          ORDER BY s DESC
          LIMIT k)) AS p,
       (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx
          WHERE body @@ to_tsquery(q) AND id @@ (ts_lt(upto) ^ 2.0)
          ORDER BY s DESC, id
          LIMIT k)) AS e;


statement ok
CREATE MACRO shapes_same_or_ranged(q, upto, k) AS TABLE
  SELECT p.n = e.n
     AND abs(p.low - e.low) <= 1e-4 * greatest(1, abs(e.low))
     AND abs(p.total - e.total) <= 1e-4 * greatest(1, abs(e.total)) AS same
  FROM (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx
          WHERE body @@ to_tsquery(q) OR id @@ (ts_lt(upto) ^ 0.5)
          ORDER BY s DESC
          LIMIT k)) AS p,
       (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx
          WHERE body @@ to_tsquery(q) OR id @@ (ts_lt(upto) ^ 0.5)
          ORDER BY s DESC, id
          LIMIT k)) AS e;


query
SELECT
  (SELECT same FROM shapes_same_ranged('mid', 30000, 10)) AS mid_below,
  (SELECT same FROM shapes_same_ranged('+mid +half', 30000, 10)) AS mid_half_below,
  (SELECT same FROM shapes_same_ranged('mid OR rare', 30000, 10)) AS mid_or_rare_below,
  (SELECT same FROM shapes_same_ranged('mid', 100000, 10)) AS mid_all,
  (SELECT same FROM shapes_same_or_ranged('mid', 30000, 10)) AS mid_or_below,
  (SELECT same FROM shapes_same_or_ranged('mid OR rare', 100000, 100)) AS mid_or_rare_or_all;
----
mid_below	mid_half_below	mid_or_rare_below	mid_all	mid_or_below	mid_or_rare_or_all
t	t	t	t	t	t


statement ok
DELETE FROM shapes WHERE id % 97 = 0;


statement ok
CREATE MACRO shapes_excluded(must, mustnot) AS TABLE
  SELECT list(id ORDER BY id) AS ids FROM shapes
  WHERE regexp_matches(body, '\b' || must || '\b')
    AND NOT regexp_matches(body, '\b' || mustnot || '\b');


query
SELECT
  (SELECT list(id ORDER BY id) FROM shapes_idx WHERE body @@ to_tsquery('+rare -run')) =
  (SELECT ids FROM shapes_excluded('rare', 'run')) AS rare_run,
  (SELECT list(id ORDER BY id) FROM shapes_idx WHERE body @@ to_tsquery('+cluster -run')) =
  (SELECT ids FROM shapes_excluded('cluster', 'run')) AS cluster_run,
  (SELECT list(id ORDER BY id) FROM shapes_idx WHERE body @@ to_tsquery('+cluster -edge')) =
  (SELECT ids FROM shapes_excluded('cluster', 'edge')) AS cluster_edge,
  (SELECT list(id ORDER BY id) FROM shapes_idx WHERE body @@ to_tsquery('+sparse -holes')) =
  (SELECT ids FROM shapes_excluded('sparse', 'holes')) AS sparse_holes,
  (SELECT list(id ORDER BY id) FROM shapes_idx WHERE body @@ to_tsquery('+mid -run')) =
  (SELECT ids FROM shapes_excluded('mid', 'run')) AS mid_run,
  (SELECT list(id ORDER BY id) FROM shapes_idx WHERE body @@ to_tsquery('+half -edge')) =
  (SELECT ids FROM shapes_excluded('half', 'edge')) AS half_edge;
----
rare_run	cluster_run	cluster_edge	sparse_holes	mid_run	half_edge
t	t	t	t	t	t


statement ok
CREATE TABLE early (id INTEGER PRIMARY KEY, body VARCHAR) WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement count 60000
INSERT INTO early
SELECT i, concat_ws(' ', 'doc',
  CASE WHEN hash(i, 24) % 1000 < 1 THEN 'mark' END,
  CASE WHEN hash(i, 21) % 1000 < 10 THEN 'zephyr' END,
  NULLIF(repeat('pad ', (hash(i, 22) % 8)::INTEGER), ''),
  CASE WHEN i < 30000 AND hash(i, 23) % 1000 < 400 THEN 'early' END,
  CASE WHEN i < 30000 AND hash(i, 25) % 1000 < 400 THEN 'late' END)
FROM generate_series(0, 59999) AS g(i);


statement ok
CREATE INDEX early_idx ON early USING inverted(id, body shapes_dict);


query
SELECT
  (SELECT list(id ORDER BY id) FROM early_idx
   WHERE body @@ ts_phrase('zephyr early')) =
  (SELECT list(id ORDER BY id) FROM early
   WHERE regexp_matches(body, '\bzephyr\s+early\b')) AS phrase,
  (SELECT list(id ORDER BY id) FROM early_idx
   WHERE body @@ to_tsquery('+doc +"zephyr early"')) =
  (SELECT list(id ORDER BY id) FROM early
   WHERE regexp_matches(body, '\bzephyr\s+early\b')) AS probed,
  (SELECT list(id ORDER BY id) FROM early_idx
   WHERE body @@ to_tsquery('+mark +"zephyr early"')) IS NOT DISTINCT FROM
  (SELECT list(id ORDER BY id) FROM early
   WHERE regexp_matches(body, '\bmark\b')
     AND regexp_matches(body, '\bzephyr\s+early\b')) AS probed_by_mark,
  (SELECT count(*) FROM early_idx WHERE body @@ to_tsquery('+mark +"zephyr early"')) =
  (SELECT count(*) FROM early
   WHERE regexp_matches(body, '\bmark\b')
     AND regexp_matches(body, '\bzephyr\s+early\b')) AS counted_by_mark,
  (SELECT count(*) FROM early_idx WHERE body @@ to_tsquery('+doc +"zephyr early"')) =
  (SELECT count(*) FROM early
   WHERE regexp_matches(body, '\bzephyr\s+early\b')) AS counted;
----
phrase	probed	probed_by_mark	counted_by_mark	counted
t	t	t	t	t


statement ok
CREATE MACRO early_same(q, k) AS TABLE
  SELECT p.n = e.n
     AND abs(coalesce(p.low - e.low, 0)) <= 1e-4 * greatest(1, abs(coalesce(e.low, 0)))
     AND abs(coalesce(p.total - e.total, 0)) <= 1e-4 * greatest(1, abs(coalesce(e.total, 0))) AS same
  FROM (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(early_idx.tableoid) AS s FROM early_idx
          WHERE body @@ to_tsquery(q)
          ORDER BY s DESC
          LIMIT k)) AS p,
       (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(early_idx.tableoid) AS s FROM early_idx
          WHERE body @@ to_tsquery(q)
          ORDER BY s DESC, id
          LIMIT k)) AS e;


query
SELECT
  (SELECT same FROM early_same('"zephyr early"', 10)) AS phrase,
  (SELECT same FROM early_same('+doc +"zephyr early"', 10)) AS probed,
  (SELECT same FROM early_same('+mark +"zephyr early"', 10)) AS probed_by_mark,
  (SELECT same FROM early_same('+mark +"zephyr early late"~1', 10)) AS sloppy_by_mark,
  (SELECT same FROM early_same('+doc +"zephyr early late"~1', 10)) AS sloppy_by_doc;
----
phrase	probed	probed_by_mark	sloppy_by_mark	sloppy_by_doc
t	t	t	t	t
