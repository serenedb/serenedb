  UNION ALL SELECT '+"mid mid"~1 +half', 10, same FROM shapes_same('+"mid mid"~1 +half', 10)
  UNION ALL SELECT '+half "dense dense"', 10, same FROM shapes_same('+half "dense dense"', 10)
  UNION ALL SELECT '+"pad pad"~1 +mid', 10, same FROM shapes_same('+"pad pad"~1 +mid', 10)
  UNION ALL SELECT '+"pad pad" +half', 100, same FROM shapes_same('+"pad pad" +half', 100)
  UNION ALL SELECT '+mid +"dense dense" +half', 10, same FROM shapes_same('+mid +"dense dense" +half', 10)
  UNION ALL SELECT 'run OR half OR rare', 1000, same FROM shapes_same('run OR half OR rare', 1000)
  UNION ALL SELECT 'run OR dense', 10, same FROM shapes_same('run OR dense', 10)
  UNION ALL SELECT 'run OR dense', 1000, same FROM shapes_same('run OR dense', 1000)
  UNION ALL SELECT 'holes OR run OR mid', 1, same FROM shapes_same('holes OR run OR mid', 1)
  UNION ALL SELECT 'common OR run', 10, same FROM shapes_same('common OR run', 10)
  UNION ALL SELECT 'half OR dense OR mid OR sparse', 10, same FROM shapes_same('half OR dense OR mid OR sparse', 10)
  UNION ALL SELECT 'half OR dense OR mid OR sparse', 1000, same FROM shapes_same('half OR dense OR mid OR sparse', 1000)
  UNION ALL SELECT '+half mid', 10, same FROM shapes_same('+half mid', 10)
  UNION ALL SELECT '+dense sparse', 10, same FROM shapes_same('+dense sparse', 10)
  UNION ALL SELECT '+common rare', 10, same FROM shapes_same('+common rare', 10)
  UNION ALL SELECT '+mid half dense', 100, same FROM shapes_same('+mid half dense', 100)
  UNION ALL SELECT '+edge rare', 10, same FROM shapes_same('+edge rare', 10)
  UNION ALL SELECT '+rare run', 10, same FROM shapes_same('+rare run', 10)
)
ORDER BY q, k;
