hash-threshold 1000

statement ok
SET disabled_optimizers = 'late_materialization';


statement ok
CREATE TABLE shapes (id INTEGER PRIMARY KEY, body VARCHAR) WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement count 60000
INSERT INTO shapes
SELECT i, concat_ws(' ', 'doc',
  CASE WHEN i >= 10000 AND i < 20000 THEN repeat('run ', 1 + (hash(i, 1) % 3)::INTEGER) END,
  CASE WHEN hash(i, 2) % 1000 < 500 THEN repeat('half ', 1 + (hash(i, 3) % 3)::INTEGER) END,
  CASE WHEN hash(i, 4) % 1000 < 300 THEN repeat('dense ', 1 + (hash(i, 5) % 3)::INTEGER) END,
  CASE WHEN hash(i, 6) % 1000 < 50 THEN repeat('mid ', 1 + (hash(i, 7) % 3)::INTEGER) END,
  CASE WHEN hash(i, 8) % 1000 < 10 THEN repeat('sparse ', 1 + (hash(i, 9) % 3)::INTEGER) END,
  CASE WHEN hash(i, 10) % 1000 < 1 THEN repeat('rare ', 1 + (hash(i, 11) % 3)::INTEGER) END,
  CASE WHEN i IN (5000, 10000) THEN 'edge' END,
  CASE WHEN i >= 30000 AND i < 40000 AND i % 37 <> 0 THEN repeat('holes ', 1 + (hash(i, 12) % 3)::INTEGER) END,
  CASE WHEN hash(i, 13) % 1000 < CASE WHEN i >= 45000 AND i < 50000 THEN 500 ELSE 5 END THEN repeat('cluster ', 1 + (hash(i, 14) % 3)::INTEGER) END,
  CASE WHEN hash(i, 15) % 1000 < 900 THEN 'common' END,
  CASE WHEN hash(i, 16) % 1000 < 400 THEN repeat('burst ', CASE WHEN i >= 2000 AND i < 3000 THEN 8 ELSE 1 END) END,
  NULLIF(repeat('pad ', (hash(i, 17) % 24)::INTEGER), ''))
FROM generate_series(0, 59999) AS g(i);


statement ok
CREATE TEXT SEARCH DICTIONARY shapes_dict AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE INDEX shapes_idx ON shapes USING inverted(id, body shapes_dict);


statement ok
CREATE MACRO shapes_same(q, k) AS TABLE
  SELECT p.n = e.n
     AND abs(p.low - e.low) <= 1e-4 * greatest(1, abs(e.low))
     AND abs(p.total - e.total) <= 1e-4 * greatest(1, abs(e.total)) AS same
  FROM (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx
          WHERE body @@ to_tsquery(q)
          ORDER BY s DESC
          LIMIT k)) AS p,
       (SELECT count(*) AS n, min(s) AS low, sum(s) AS total FROM (
          SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx
          WHERE body @@ to_tsquery(q)
          ORDER BY s DESC, id
          LIMIT k)) AS e;


query
EXPLAIN SELECT BM25(shapes_idx.tableoid) AS s FROM shapes_idx WHERE body @@ to_tsquery('rare OR mid') ORDER BY s DESC LIMIT 10;
