statement ok
CREATE TEXT SEARCH DICTIONARY es_words AS split_text_csv(' ')
  WITH (frequency, position)


statement ok
CREATE TABLE es (id INT PRIMARY KEY, ts BIGINT, r BIGINT, name TEXT, body TEXT)


statement ok
CREATE INDEX es_idx ON es USING inverted (id, body es_words)
  INCLUDE (ts, r, name) WITH (compaction_interval = 0)


statement ok
CREATE TABLE ess (id INT PRIMARY KEY, ts BIGINT, r BIGINT, name TEXT, body TEXT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
      row_group_size = 4096)


statement ok
CREATE INDEX ess_idx ON ess USING inverted (body es_words)


statement ok
INSERT INTO es
SELECT i, i, (i * 7919) % 100003, 'prefix__' || lpad(i::text, 8, '0'),
  'fox' || (i % 7) || CASE WHEN i % 1000 = 0 THEN ' rare' ELSE '' END
FROM generate_series(1, 40960) s(i)


statement ok
VACUUM (REFRESH_TABLE) es


