CREATE TABLE tuple_base (id BIGINT PRIMARY KEY, x BIGINT, y BIGINT);


statement ok
INSERT INTO tuple_base VALUES (1, 10, 20), (2, 30, NULL);


statement ok
CREATE INDEX tuple_expr_idx ON tuple_base USING inverted(id, (ROW(x, y)) included());


query
SELECT id, ROW(x, y) AS payload FROM tuple_expr_idx ORDER BY id;
----
id	payload
1	(10,20)
2	(30,)


