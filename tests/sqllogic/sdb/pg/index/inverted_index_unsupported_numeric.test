# --- Numeric column types an inverted index rejects or accepts
#
# A type the index can't encode must fail CREATE INDEX with a catalogable
# error, never succeed and then drop the column or match nothing.

# --- 128-bit, unsigned 64/128-bit and DECIMAL columns are accepted

statement ok
CREATE TABLE wide_hugeint (id INTEGER PRIMARY KEY, big HUGEINT);

statement ok
CREATE INDEX wide_hugeint_idx ON wide_hugeint USING inverted(id, big);

statement ok
CREATE TABLE wide_decimal (id INTEGER PRIMARY KEY, amount DECIMAL(20, 4));

statement ok
CREATE INDEX wide_decimal_idx ON wide_decimal USING inverted(id, amount);

statement ok
CREATE TABLE wide_ubigint (id INTEGER PRIMARY KEY, n UBIGINT);

statement ok
CREATE INDEX wide_ubigint_idx ON wide_ubigint USING inverted(id, n);

statement ok
CREATE TABLE wide_uhugeint (id INTEGER PRIMARY KEY, n UHUGEINT);

statement ok
CREATE INDEX wide_uhugeint_idx ON wide_uhugeint USING inverted(id, n);

# INTERVAL is a composite (months/days/micros): rejected.

statement ok
CREATE TABLE unsup_interval (id INTEGER PRIMARY KEY, iv INTERVAL);


statement error
CREATE INDEX unsup_interval_idx ON unsup_interval USING inverted(id, iv);
----
db error: ERROR: Column 'iv' has unsupported type INTERVAL and can not be indexed


# UTINYINT/USMALLINT/UINTEGER + TIME + TIMETZ are accepted.

statement ok
CREATE TABLE sup_unsigned (
  id INTEGER PRIMARY KEY,
  a UTINYINT,
  b USMALLINT,
  c UINTEGER
);


statement ok
CREATE INDEX sup_unsigned_idx ON sup_unsigned USING inverted(id, a, b, c);


statement ok
CREATE TABLE sup_time (
  id INTEGER PRIMARY KEY,
  t TIME,
  tz TIMETZ
);


statement ok
CREATE INDEX sup_time_idx ON sup_time USING inverted(id, t, tz);


# --- Indexed expressions returning HUGEINT / DECIMAL are accepted too

statement ok
CREATE TABLE wide_jsondoc (id INTEGER PRIMARY KEY, content JSON);

statement ok
CREATE INDEX wide_jsondoc_huge ON wide_jsondoc USING inverted(id, ((content->'v')::HUGEINT));

statement ok
CREATE INDEX wide_jsondoc_dec ON wide_jsondoc USING inverted(id, ((content->'v')::DECIMAL(20,4)));

# --- Filter-side: BIGINT-indexed column, HUGEINT/DECIMAL bound in the predicate
#
# Indexed column accepted; bound supplied as HUGEINT or DECIMAL must either
# (a) auto-cast to the column's type and tokenize cleanly, or (b) error out.
# Silent zero-match is the regression we're guarding against.

statement ok
CREATE TABLE filter_bigint (id INTEGER PRIMARY KEY, n BIGINT);

statement ok
CREATE INDEX filter_bigint_idx ON filter_bigint USING inverted(id, n);

statement ok
INSERT INTO filter_bigint VALUES (1, 100), (2, 200), (3, 300);

# Sanity: same predicate with native BIGINT bound finds the row.
query
SELECT id FROM filter_bigint_idx WHERE n = 200;
----
id
2

# HUGEINT bound that fits in BIGINT range -- expected: DuckDB casts the bound
# to BIGINT at bind time so the filter sees BIGINT (passes). If that doesn't
# happen, the filter must error rather than silently return zero rows.
query
SELECT id FROM filter_bigint_idx WHERE n = 200::HUGEINT;
----
id
2

# DECIMAL bound that fits in BIGINT range -- same expectation as HUGEINT.
query
SELECT id FROM filter_bigint_idx WHERE n = 200::DECIMAL(20,4);
----
id
2

# A DOUBLE bound just past the column's range, where the type's limit rounds
# to the bound itself, keeps every value on its side.
query
SELECT id FROM filter_bigint_idx
  WHERE n @@ ts_le(9223372036854775808::DOUBLE) ORDER BY id;
----
id
1
2
3

query
SELECT id FROM filter_bigint_idx
  WHERE n @@ ts_lt(9223372036854775808::DOUBLE) ORDER BY id;
----
id
1
2
3

query
SELECT id FROM filter_bigint_idx
  WHERE n @@ ts_ge(9223372036854775808::DOUBLE);
----
id

query
SELECT id FROM filter_bigint_idx
  WHERE n @@ ts_between(-9223372036854775808::DOUBLE,
                        9223372036854775808::DOUBLE, true, false)
  ORDER BY id;
----
id
1
2
3

statement ok
INSERT INTO wide_ubigint VALUES (1, 0), (2, 18446744073709551615);

statement ok
VACUUM (FLUSH_TABLE) wide_ubigint;

query
SELECT id FROM wide_ubigint_idx
  WHERE n @@ ts_lt(18446744073709551616::DOUBLE) ORDER BY id;
----
id
1
2

query
SELECT id FROM wide_ubigint_idx
  WHERE n @@ ts_gt(18446744073709551616::DOUBLE);
----
id

# A thousand 16-byte keys are inverted in several batches: values of the first,
# a middle and the last batch are all found, and ranges count every one.
statement ok
INSERT INTO wide_hugeint
SELECT i, (i * 3)::HUGEINT * 1000000000000000000000 FROM range(1000) r(i);

statement ok
VACUUM (FLUSH_TABLE) wide_hugeint;

query
SELECT id FROM wide_hugeint_idx
  WHERE big IN (15000000000000000000000, 390000000000000000000000,
                2997000000000000000000000)
  ORDER BY id;
----
id
5
130
999

query
SELECT count(*) AS n FROM wide_hugeint_idx
  WHERE big @@ ts_lt(1500000000000000000000000::HUGEINT);
----
n
500

query
SELECT id FROM wide_hugeint_idx ORDER BY big DESC LIMIT 3;
----
id
999
998
997

# A UHUGEINT bound past the column's range takes its side from its own sign.
query
SELECT id FROM wide_ubigint_idx
  WHERE n @@ ts_gt(1267650600228229401496703205376::UHUGEINT);
----
id

query
SELECT id FROM wide_ubigint_idx
  WHERE n @@ ts_lt(1267650600228229401496703205376::UHUGEINT) ORDER BY id;
----
id
1
2

# A DOUBLE bound past FLOAT's range compares with the infinities a REAL column
# holds, as the table compares them.
statement ok
CREATE TABLE real_bounds (id INTEGER PRIMARY KEY, f REAL);

statement ok
CREATE INDEX real_bounds_idx ON real_bounds USING inverted(id, f);

statement ok
INSERT INTO real_bounds VALUES (1, 'inf'), (2, 'nan'), (3, '-inf'), (4, 1);

statement ok
VACUUM (FLUSH_TABLE) real_bounds;

query
SELECT id FROM real_bounds WHERE f > 1e39 ORDER BY id;
----
id
1
2

query
SELECT id FROM real_bounds_idx WHERE f @@ ts_gt(1e39::DOUBLE) ORDER BY id;
----
id
1
2

query
SELECT id FROM real_bounds_idx WHERE f @@ ts_ge(-1e39::DOUBLE) ORDER BY id;
----
id
1
2
4

query
SELECT id FROM real_bounds_idx WHERE f @@ ts_le(1e39::DOUBLE) ORDER BY id;
----
id
3
4

query
SELECT id FROM real_bounds_idx WHERE f @@ ts_lt(-1e39::DOUBLE) ORDER BY id;
----
id
3
