# ORDER BY one indexed numeric column with a constant LIMIT is answered by the
# scan: it reads the column's terms in value order and stops after LIMIT +
# OFFSET live rows, instead of a TOP_N over every row. A filter on another
# column, a second key, a computed key or a parameter keep the TOP_N. v holds
# every value once, so ids are unique except among NULLs.

statement ok
CREATE TABLE vt (id INTEGER PRIMARY KEY, v BIGINT, w INTEGER, s INTEGER,
                 ts TIMESTAMP)


statement ok
CREATE INDEX vt_idx ON vt USING inverted (id, v, w, ts) INCLUDE (s)
  WITH (compaction_interval = 0)


statement ok
INSERT INTO vt
SELECT i, CASE WHEN i % 10 = 0 THEN NULL ELSE (i * 37) % 401 END, i % 7, i,
       TIMESTAMP '2024-01-01' + i * INTERVAL '5 hours'
FROM range(1, 201) r(i)


statement ok
VACUUM (REFRESH_TABLE) vt


statement ok
INSERT INTO vt
SELECT i, CASE WHEN i % 10 = 0 THEN NULL ELSE (i * 37) % 401 END, i % 7, i,
       TIMESTAMP '2024-01-01' + i * INTERVAL '5 hours'
FROM range(201, 401) r(i)


statement ok
VACUUM (REFRESH_TABLE) vt


statement ok
DELETE FROM vt WHERE id % 13 = 0


statement ok
VACUUM (REFRESH_TABLE) vt


# --- The scan takes the TOP_N.

query
EXPLAIN SELECT id, v FROM vt_idx ORDER BY v LIMIT 3;
----
QUERY PLAN
╭─ LOOKUP_JOIN ───────╮
│ Key: rowid          │
│ ~3 rows             │
╰──────────┬──────────╯
           ├──────────────────────╮
╭─ IRESEARCH_SCAN ────╮  ╭─ INDEX_SOURCE ──╮
│ Index: vt_idx       │  │ Lookup: table   │
│ Lookup: table       │  │ Projections: id │
│ Top: 3              │  │ ~3 rows         │
│ Order: v NULLS LAST │  ╰─────────────────╯
│ Projections: v, pk  │
│ ~370 rows           │
╰─────────────────────╯


query
SELECT id, v FROM vt_idx ORDER BY v LIMIT 3;
----
id	v
336	1
271	2
206	3


query
EXPLAIN SELECT v FROM vt_idx ORDER BY v DESC LIMIT 4 OFFSET 2;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────╮
│ Index: vt_idx            │
│ Lookup: table            │
│ Top: 4, offset 2         │
│ Order: v DESC NULLS LAST │
│ Projections: v           │
│ ~370 rows                │
╰──────────────────────────╯


query
SELECT v FROM vt_idx ORDER BY v DESC LIMIT 4 OFFSET 2;
----
v
392
391
390
389


# 37 live rows hold NULL: the offset skips 35 of them.

query
SELECT v FROM vt_idx ORDER BY v NULLS FIRST LIMIT 3 OFFSET 35;
----
v
NULL
NULL
1


query
SELECT v FROM vt_idx ORDER BY v DESC NULLS FIRST LIMIT 2;
----
v
NULL
NULL


