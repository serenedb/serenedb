# One worker reads both segments, one after the other.

statement ok
SET threads = 1;


query
SELECT id, v FROM vt_idx ORDER BY v DESC LIMIT 3;
----
id	v
54	394
119	393
184	392


query
SELECT v FROM vt_idx ORDER BY v DESC NULLS FIRST LIMIT 2 OFFSET 36;
----
v
NULL
394


statement ok
RESET threads;


# --- The TOP_N stays.

query
EXPLAIN SELECT id, v FROM vt_idx WHERE v BETWEEN 10 AND 20 AND v <> 15
        ORDER BY v LIMIT 3;
----
QUERY PLAN
╭─ LOOKUP_JOIN ────────────────────────────────╮
│ Key: rowid                                   │
│ ~3 rows                                      │
╰───────────────────────┬──────────────────────╯
                        ├──────────────────────────────────╮
╭─ TOP_N ───────────────┴──────────────────────╮  ╭─ INDEX_SOURCE ──╮
│ Top: 3                                       │  │ Lookup: table   │
│ Order By: v ASC                              │  │ Projections: id │
│ ~3 rows                                      │  │ ~3 rows         │
╰───────────────────────┬──────────────────────╯  ╰─────────────────╯
╭─ IRESEARCH_SCAN ──────┴──────────────────────╮
│ Index: vt_idx                                │
│ Lookup: table                                │
│ Index Filter:                                │
│ ╭─ Bool ────────────╮                        │
│ ╰─────────┬─────────╯                        │
│           ├──────────────────────╮           │
│ ╭─ Must ──┴─────────╮  ╭─ Must Not ────────╮ │
│ ╰─────────┬─────────╯  ╰─────────┬─────────╯ │
│ ╭─ Granular Range ──╮  ╭─ Terms ─┴─────────╮ │
│ │ Field: v(numeric) │  │ Field: v(numeric) │ │
│ │ Range: >=10, <=20 │  │ Values: 15        │ │
│ ╰───────────────────╯  ╰───────────────────╯ │
│ Column Filter:                               │
│ optional: Dynamic Filter (v < ?)             │
│ Projections: v, pk                           │
│ ~74 rows                                     │
╰──────────────────────────────────────────────╯


query
SELECT id, v FROM vt_idx WHERE v BETWEEN 10 AND 20 AND v <> 15
ORDER BY v LIMIT 3;
