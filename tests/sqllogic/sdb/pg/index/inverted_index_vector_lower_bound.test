statement ok
COPY (SELECT i AS pk, [i, 0]::FLOAT[] AS emb FROM range(1000) t(i))
TO '${__TEST_DIR__}/vlb.parquet' (FORMAT parquet);


statement ok
CREATE VIEW vlb_view AS
    SELECT pk, emb::FLOAT[2] AS emb FROM read_parquet('${__TEST_DIR__}/vlb.parquet');


statement ok
CREATE INDEX vlb_view_hnsw ON vlb_view
    USING inverted (pk, emb hnsw (metric = 'l2'));


query
SELECT pk FROM vlb_view_hnsw
WHERE emb <-> [0, 0]::FLOAT[2] > 500
ORDER BY emb <-> [0, 0]::FLOAT[2]
LIMIT 3;
----
pk
501
502
503
