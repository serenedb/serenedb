CREATE TABLE vlb_segments (pk INTEGER PRIMARY KEY, emb FLOAT[2]);


statement ok
CREATE INDEX vlb_segments_hnsw ON vlb_segments
    USING inverted (pk, emb hnsw (metric = 'l2', quant = 'none'));


statement ok
INSERT INTO vlb_segments SELECT i, [i, 0]::FLOAT[2] FROM range(0, 2048) t(i);


statement ok
INSERT INTO vlb_segments SELECT i, [i, 0]::FLOAT[2] FROM range(2048, 4096) t(i);


query
SELECT pk FROM vlb_segments
WHERE emb <-> [0, 0]::FLOAT[2] > 500
ORDER BY emb <-> [0, 0]::FLOAT[2]
LIMIT 3;
