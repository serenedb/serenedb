# A view over a file reader may spell its columns in a different case than the
# file does (DuckDB binds them case-insensitively). Materialising a real column
# through the index must resolve the view's names the same way.
control substitution on


statement count 20
COPY (SELECT TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i) SECOND AS "Timestamp",
             'trace' || i AS "TraceId",
             (i % 5)::INTEGER AS "SeverityNumber",
             CASE WHEN i % 2 = 0 THEN 'error in module ' || (i % 4) ELSE 'all good in module ' || (i % 4) END AS "Body"
      FROM range(20) t(i))
TO '${__TEST_DIR__}/view_column_case.parquet' (FORMAT PARQUET);


statement ok
CREATE TEXT SEARCH DICTIONARY view_column_case_en AS keyword() WITH (frequency, position, norm);

statement ok
CREATE VIEW view_column_case_v AS SELECT timestamp AS Ts, body AS Body FROM read_parquet('${__TEST_DIR__}/view_column_case.parquet');

statement ok
CREATE INDEX view_column_case_idx ON view_column_case_v USING inverted ((split_by_non_alpha(Body, case := 'lower')) view_column_case_en) INCLUDE (Ts);

query
SELECT Body FROM view_column_case_idx ORDER BY Ts LIMIT 1;
----
body
error in module 0

query
SELECT Ts::VARCHAR AS ts, Body FROM view_column_case_idx WHERE split_by_non_alpha(Body, case := 'lower') @@ 'error' ORDER BY Ts LIMIT 3;
----
ts	body
2025-01-01 00:00:00	error in module 0
2025-01-01 00:00:02	error in module 2
2025-01-01 00:00:04	error in module 0

query
SELECT count(*) AS c FROM view_column_case_idx WHERE split_by_non_alpha(Body, case := 'lower') @@ 'module';
----
c
20


# A quoted mixed-case column of the view is a searchable key as well as an
# included one, and the unquoted name resolves to the same column.
statement count 10
COPY (SELECT i AS "AdvEngineID", 'http://example.com/' || i AS "URL" FROM range(1, 11) t(i))
TO '${__TEST_DIR__}/view_column_case_quoted.parquet' (FORMAT PARQUET);


statement ok
CREATE VIEW view_column_case_quoted_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/view_column_case_quoted.parquet');


statement ok
CREATE INDEX view_column_case_quoted_num ON view_column_case_quoted_v USING inverted ("AdvEngineID");


statement ok
CREATE INDEX view_column_case_quoted_url ON view_column_case_quoted_v USING inverted ("URL");


statement ok
CREATE INDEX view_column_case_quoted_included ON view_column_case_quoted_v USING inverted ("AdvEngineID" included());


statement ok
CREATE INDEX view_column_case_unquoted_num ON view_column_case_quoted_v USING inverted (AdvEngineID);


query
SELECT "AdvEngineID" FROM view_column_case_quoted_num WHERE "AdvEngineID" = 3;
----
AdvEngineID
3


query
SELECT "URL" FROM view_column_case_quoted_url WHERE "URL" @@ 'http://example.com/7';
----
URL
http://example.com/7


query
SELECT AdvEngineID FROM view_column_case_unquoted_num WHERE AdvEngineID = 9;
----
AdvEngineID
9
