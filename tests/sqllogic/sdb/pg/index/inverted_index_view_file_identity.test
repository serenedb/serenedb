statement ok
COPY (SELECT 5 AS id, 'plain file' AS body) TO '${__TEST_DIR__}/vfi_b_f1.parquet' (FORMAT parquet);


statement ok
CREATE VIEW vfi_b AS SELECT id, body FROM read_parquet('${__TEST_DIR__}/vfi_b_*.parquet');


statement ok
CREATE INDEX vfi_b_idx ON vfi_b USING inverted (id, body vfi_dict);


