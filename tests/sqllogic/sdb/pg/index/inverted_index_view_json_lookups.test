control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY vjlk_en AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
COPY (SELECT ('{"id": 1, "body": "red fox", "n": 10}   ' || chr(10) || '{"id": 2, "body": "blue fox", "n": 20}' || chr(9) || chr(10) || '{"id": 3, "body": "red dog", "n": 30}' || chr(10) || '{"id": 4, "body": "red cat", "n": 40}')::BLOB) TO '${__TEST_DIR__}/vjlk.json' (FORMAT BLOB);


statement ok
CREATE VIEW vjlk AS SELECT * FROM read_json('${__TEST_DIR__}/vjlk.json', format := 'newline_delimited');


statement ok
CREATE INDEX vjlk_idx ON vjlk USING inverted(id, body vjlk_en);


query
SELECT id, n FROM vjlk_idx WHERE body @@ 'red' ORDER BY id;
----
id	n
1	10
3	30
4	40


query
SELECT id, n FROM vjlk_idx WHERE body @@ 'fox' ORDER BY id DESC;
----
id	n
2	20
1	10


query
SELECT id FROM vjlk_idx WHERE body @@ 'red' AND n > 15 ORDER BY id;
----
id
3
4


query
SELECT count(*) AS c FROM vjlk_idx WHERE body @@ 'red' AND n > 100;
----
c
0


query
SELECT id FROM vjlk_idx WHERE body @@ 'red' AND n > 5 ORDER BY id;
----
id
1
3
4


statement ok
CREATE VIEW vjlk_rn AS SELECT * FROM read_json('${__TEST_DIR__}/vjlk.json', format := 'newline_delimited', file_row_number := true);


statement ok
CREATE INDEX vjlk_rn_idx ON vjlk_rn USING inverted(id, body vjlk_en);


query
SELECT count(*) AS c FROM ((SELECT id, n, file_row_number FROM vjlk_rn_idx WHERE body @@ 'red') EXCEPT ALL (SELECT id, n, file_row_number FROM vjlk_rn WHERE body LIKE '%red%'));
----
c
0


query
SELECT id, file_row_number FROM vjlk_rn_idx WHERE body @@ 'red' ORDER BY id;
----
id	file_row_number
1	0
3	81
4	119


statement ok
DROP INDEX vjlk_rn_idx;


statement ok
DROP VIEW vjlk_rn;


statement ok
DROP INDEX vjlk_idx;


statement ok
DROP VIEW vjlk;


statement ok
DROP TEXT SEARCH DICTIONARY vjlk_en;
