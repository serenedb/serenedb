# REINDEX of a view-backed index indexes the rows it adds under the index's
# expression keys, not under the plain columns they read.

control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY vrek_words AS split_text() WITH (frequency);

system ok
mkdir -p $__TEST_DIR__/vrek

statement ok
COPY (SELECT * FROM (VALUES (1, 'pudge goes mid'), (2, 'anchin reads manga')) t(id, body))
TO '${__TEST_DIR__}/vrek/a.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW vrek_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/vrek/*.parquet');

statement ok
CREATE INDEX vrek_idx ON vrek_v USING inverted(id, (upper(body)) vrek_words, (upper(body)) included());

query
SELECT id FROM vrek_idx WHERE upper(body) @@ 'PUDGE' ORDER BY id;
----
id
1

statement ok
COPY (SELECT * FROM (VALUES (3, 'lina burns pudge')) t(id, body))
TO '${__TEST_DIR__}/vrek/b.parquet' (FORMAT PARQUET);

query
SELECT * FROM serenedb_reindex('vrek_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

query
SELECT id FROM vrek_idx WHERE upper(body) @@ 'PUDGE' ORDER BY id;
----
id
1
3

query
SELECT id, upper(body) AS u FROM vrek_idx WHERE upper(body) @@ 'LINA' ORDER BY id;
----
id	u
3	LINA BURNS PUDGE

# A full rebuild indexes every row under the expression keys too.
statement ok
COPY (SELECT * FROM (VALUES (1, 'pudge stays mid'), (2, 'anchin reads manga')) t(id, body))
TO '${__TEST_DIR__}/vrek/a.parquet' (FORMAT PARQUET);

statement ok
SELECT * FROM serenedb_reindex('vrek_idx');

query
SELECT id FROM vrek_idx WHERE upper(body) @@ 'STAYS' ORDER BY id;
----
id
1
