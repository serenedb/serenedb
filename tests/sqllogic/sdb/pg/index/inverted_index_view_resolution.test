control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY meme_res_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA kek;

statement ok
CREATE TEXT SEARCH DICTIONARY kek.meme_res_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE TABLE kek.pepe (id INTEGER, body TEXT);

statement ok
INSERT INTO kek.pepe VALUES (1, 'kek pepe body'), (2, 'kek doge body');

statement ok
CREATE TABLE pepe (id INTEGER, body TEXT);

statement ok
INSERT INTO pepe VALUES (1, 'public pepe body'), (2, 'public doge body');

statement ok
CREATE VIEW kek.pepe_v AS SELECT * FROM pepe;

statement ok
CREATE INDEX pepe_idx ON kek.pepe_v USING inverted (id, body meme_res_en);

query
SELECT id, body FROM kek.pepe_idx WHERE body @@ 'pepe';
----
id	body
1	kek pepe body

statement ok
SET search_path = public, kek;

query
SELECT id, body FROM kek.pepe_idx WHERE body @@ 'doge';
----
id	body
2	kek doge body

statement ok
RESET search_path;

statement ok
DETACH DATABASE IF EXISTS meme_att;

statement ok
ATTACH '${__TEST_DIR__}/meme_att.duckdb' AS meme_att;

statement ok
CREATE TABLE meme_att.main.doge (id INTEGER, body TEXT);

statement ok
INSERT INTO meme_att.main.doge VALUES (1, 'much wow'), (2, 'such amaze');

statement ok
CREATE VIEW doge_v AS SELECT * FROM meme_att.doge;

statement ok
CREATE INDEX doge_idx ON doge_v USING inverted (id, body meme_res_en);

query
SELECT id, body FROM doge_idx WHERE body @@ 'wow';
----
id	body
1	much wow

query
EXPLAIN SELECT id, body FROM doge_idx WHERE body @@ 'wow';
----
QUERY PLAN
<slt:ignore>Lookup: duckdb<slt:ignore>

statement ok
COPY (SELECT * FROM (VALUES (1, 'stonks go up'), (2, 'hodl the line')) t(id, body))
TO '${__TEST_DIR__}/stonks.csv' (DELIMITER '|', HEADER);

statement ok
CREATE VIEW stonks_v AS SELECT * FROM read_csv('${__TEST_DIR__}/stonks.csv', delim := '|');

statement ok
CREATE INDEX stonks_idx ON stonks_v USING inverted (id, body meme_res_en);

query
SELECT id, body FROM stonks_idx WHERE body @@ 'stonks';
----
id	body
1	stonks go up

query
EXPLAIN SELECT id, body FROM stonks_idx WHERE body @@ 'stonks';
----
