statement ok
CREATE TEXT SEARCH DICTIONARY beast_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY beast_pos_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)
    WITH (frequency, position)

statement ok
CREATE TABLE beast_t (id INTEGER PRIMARY KEY, v VARCHAR)

statement ok
INSERT INTO beast_t VALUES
    (1, 'beast'),
    (2, 'mrbeasts'),
    (3, 'east'),
    (4, 'mr' || chr(31) || 'beast'),
    (5, 'beast' || chr(31) || 'games'),
    (6, 'mr' || chr(31) || 'beast' || chr(31) || 'games'),
    (7, chr(31) || 'east'),
    (8, 'ÿ67'),
    (9, '67ÿ'),
    (10, 'ÿ')

statement ok
CREATE INDEX beast_idx ON beast_t USING inverted (id, v beast_dict)

statement ok
CREATE INDEX beast_pos_idx ON beast_t USING inverted (id, v beast_pos_dict)

statement ok
VACUUM (REFRESH_TABLE) beast_t

query
SELECT list_transform(generate_wildcard_ngrams('6' || chr(31) || '7', 3), x -> hex(x)) AS control,
       list_transform(generate_wildcard_ngrams('ÿ7', 3), x -> hex(x)) AS latin
