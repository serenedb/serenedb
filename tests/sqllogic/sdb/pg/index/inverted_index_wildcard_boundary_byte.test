    (4, 'a' || chr(31) || 'bcd'),
    (5, 'bcd' || chr(31) || 'e'),
    (6, 'a' || chr(31) || 'bcd' || chr(31) || 'e'),
    (7, chr(31) || 'cd')

statement ok
VACUUM (REFRESH_TABLE) wbb_t

query
SELECT list_contains(generate_wildcard_ngrams('bcd', 3), chr(31)) AS plain,
       list_contains(generate_wildcard_ngrams('a' || chr(31) || 'bcd', 3), chr(31)) AS marked
----
plain	marked
f	t

