statement ok
CREATE TEXT SEARCH DICTIONARY wbb_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY wbb_pos_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)
    WITH (frequency, position)

statement ok
CREATE TABLE wbb_t (id INTEGER PRIMARY KEY, v VARCHAR)

statement ok
INSERT INTO wbb_t VALUES
    (1, 'bcd'),
    (2, 'xbcdx'),
    (3, 'cd'),
    (4, 'a' || chr(31) || 'bcd'),
    (5, 'bcd' || chr(31) || 'e'),
    (6, 'a' || chr(31) || 'bcd' || chr(31) || 'e'),
    (7, chr(31) || 'cd'),
    (8, 'ÿbc'),
    (9, 'aÿ'),
    (10, 'ÿ')

statement ok
CREATE INDEX wbb_idx ON wbb_t USING inverted (id, v wbb_dict)

statement ok
CREATE INDEX wbb_pos_idx ON wbb_t USING inverted (id, v wbb_pos_dict)

statement ok
VACUUM (REFRESH_TABLE) wbb_t

query
SELECT list_transform(generate_wildcard_ngrams('a' || chr(31) || 'b', 3), x -> hex(x)) AS control,
       list_transform(generate_wildcard_ngrams('ÿb', 3), x -> hex(x)) AS latin
----
control	latin
{FF611F,611F62,1F62FF,62FF}	{FFC3BF62,C3BF62FF,62FF}

