statement ok
CREATE TABLE wc_nr_g (id BIGINT PRIMARY KEY, b VARCHAR)

statement ok
INSERT INTO wc_nr_g VALUES
    (1, 'ab'),
    (2, 'abc'),
    (3, 'xab'),
    (4, 'abx'),
    (5, 'a'),
    (6, 'abxbc'),
    (7, 'xabcx'),
    (8, 'a b')

statement ok
CREATE INDEX wc_nr_g_idx ON wc_nr_g USING inverted(id, b wc_nr_dict)

query
SELECT id FROM wc_nr_g_idx WHERE b @@ ts_like('ab%') ORDER BY id
