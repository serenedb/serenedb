hash-threshold 100
control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY wc_nr_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY wc_nr_pos_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)
    WITH (frequency, position)

statement ok
CREATE TABLE wc_nr_t (id BIGINT PRIMARY KEY, b VARCHAR)

statement ok
INSERT INTO wc_nr_t VALUES
    (1, 'search'),
    (2, 'plain'),
    (3, 'research'),
    (4, NULL),
    (5, 'rain')

statement ok
CREATE INDEX wc_nr_idx ON wc_nr_t USING inverted(id, b wc_nr_dict)

statement ok
CREATE INDEX wc_nr_pos_idx ON wc_nr_t USING inverted(id, b wc_nr_pos_dict)

statement ok
VACUUM (REFRESH_TABLE) wc_nr_t

query
SELECT id FROM wc_nr_idx WHERE b @@ ts_like('%') ORDER BY id
----
id
1
2
3
5

query
SELECT id FROM wc_nr_idx WHERE b @@ ts_like('%ai%') ORDER BY id
----
id
2
5

query
SELECT count(*) FROM wc_nr_idx WHERE b @@ ts_like('%ai%')
----
count
2

query
SELECT id FROM wc_nr_idx WHERE b @@ ts_like('%ai%') AND id > 2 ORDER BY id
----
id
5

query
SELECT id FROM wc_nr_idx WHERE b @@ ts_like('%ai%')
ORDER BY BM25(wc_nr_idx.tableoid) DESC, id LIMIT 1
----
id
2

query
SELECT id FROM wc_nr_pos_idx WHERE b @@ ts_like('%') ORDER BY id
----
id
1
2
3
5

query
SELECT id FROM wc_nr_pos_idx WHERE b @@ ts_like('%ear%') ORDER BY id
----
id
1
3

query
SELECT count(*) FROM wc_nr_pos_idx WHERE b @@ ts_like('%ear%')
----
count
2

query
SELECT id FROM wc_nr_pos_idx WHERE b @@ ts_like('%ear%') AND id > 1 ORDER BY id
----
id
3

query
SELECT id FROM wc_nr_pos_idx WHERE b @@ ts_like('%ear%')
ORDER BY BM25(wc_nr_pos_idx.tableoid) DESC, id LIMIT 1
----
id
1

query
SELECT id FROM wc_nr_pos_idx WHERE b @@ ts_like('search') ORDER BY id
----
id
1

query
SELECT id FROM wc_nr_pos_idx WHERE b @@ ts_like('%ai%') ORDER BY id
----
id
2
5

statement ok
DROP TABLE wc_nr_t

statement ok
DROP TEXT SEARCH DICTIONARY wc_nr_pos_dict

statement ok
DROP TEXT SEARCH DICTIONARY wc_nr_dict
