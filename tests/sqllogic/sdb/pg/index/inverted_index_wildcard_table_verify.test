# ts_dict builds its own filter; the check stays inside it.

query
SELECT count(*) AS d FROM (
    (SELECT unnest(ts_dict_agg(k)) AS t, unnest(ts_dict_count(k)) AS c
     FROM tv_idx WHERE msg @@ ts_like('%timed out%')
     EXCEPT SELECT k, count(*) FROM tv_t WHERE msg LIKE '%timed out%' GROUP BY k)
    UNION ALL
    (SELECT k, count(*) FROM tv_t WHERE msg LIKE '%timed out%' GROUP BY k
     EXCEPT SELECT unnest(ts_dict_agg(k)) AS t, unnest(ts_dict_count(k)) AS c
     FROM tv_idx WHERE msg @@ ts_like('%timed out%'))
) s
----
d
0

