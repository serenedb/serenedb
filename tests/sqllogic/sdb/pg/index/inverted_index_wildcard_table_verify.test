# AND with a stored column: x > T keeps about 1, 50 and 99% of the rows.

query
SELECT (SELECT count(*) FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 98) -
       (SELECT count(*) FROM tv_t WHERE msg LIKE '%timed out%' AND x > 98) AS d
----
d
0

query
SELECT (SELECT count(*) FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 49) -
       (SELECT count(*) FROM tv_t WHERE msg LIKE '%timed out%' AND x > 49) AS d
----
d
0

query
SELECT (SELECT count(*) FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 0) -
       (SELECT count(*) FROM tv_t WHERE msg LIKE '%timed out%' AND x > 0) AS d
----
d
0

query
SELECT count(*) AS d FROM (
    (SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 49
     EXCEPT SELECT id FROM tv_t WHERE msg LIKE '%timed out%' AND x > 49)
    UNION ALL
    (SELECT id FROM tv_t WHERE msg LIKE '%timed out%' AND x > 49
     EXCEPT SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 49)
) t
----
d
0

query
SELECT count(*) AS d FROM (SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 49
      ORDER BY BM25(tv_idx.tableoid) DESC LIMIT 10) t
WHERE id NOT IN (SELECT id FROM tv_t WHERE msg LIKE '%timed out%' AND x > 49)
----
d
0

query
SELECT (SELECT count(*) FROM (SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%') AND x > 49
      ORDER BY BM25(tv_idx.tableoid) DESC LIMIT 10) t) -
       least(10, (SELECT count(*) FROM tv_t WHERE msg LIKE '%timed out%' AND x > 49)) AS d
----
d
0

