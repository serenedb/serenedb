hash-threshold 100

statement ok
CREATE TEXT SEARCH DICTIONARY tv_dict AS
    generate_wildcard_ngrams(keyword(), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY tv_pos_dict AS
    generate_wildcard_ngrams(keyword(), 3)
    WITH (frequency, position)

statement ok
CREATE TABLE tv_t (id BIGINT PRIMARY KEY, x INTEGER, k VARCHAR, msg VARCHAR)

statement ok
CREATE INDEX tv_idx ON tv_t USING inverted(id, msg tv_dict, k) INCLUDE (x)
  WITH (refresh_interval = 0, compaction_interval = 0)

statement ok
CREATE INDEX tv_pos_idx ON tv_t USING inverted(id, msg tv_pos_dict) INCLUDE (x)
  WITH (refresh_interval = 0, compaction_interval = 0)

# Each refresh seals a segment and nothing merges them: the scan meets several
# segments, one of them without a stored term at all (every msg is NULL).
statement ok
INSERT INTO tv_t SELECT i, i % 100, 'k' || (i % 5),
    CASE i % 10
        WHEN 0 THEN 'GET /api/v' || (i % 3) || '/users/' || i || ' 200 ' || (i % 97) || ' ms'
        WHEN 1 THEN 'POST /api/v' || (i % 3) || '/orders/' || i || ' 500 ' || (i % 89) || ' ms'
        WHEN 2 THEN 'connection to db-' || (i % 13) || ' timed out after ' || (i % 30) || ' s'
        WHEN 3 THEN 'timed out waiting for connection to db-' || (i % 13)
        WHEN 4 THEN 'disk usage ' || (i % 100) || ' pct on /dev/sd' || chr(CAST(97 + i % 4 AS INTEGER)) || (i % 5)
        WHEN 5 THEN 'cache hit ratio 0.' || (i % 100)
        WHEN 6 THEN 'user ' || i || ' login ok'
        WHEN 7 THEN 'heartbeat ' || i
        WHEN 8 THEN 'payment failed: card declined for order ' || i
        ELSE CASE WHEN i % 1000 = 9
                  THEN 'java.lang.OutOfMemoryError: Java heap space'
                  ELSE 'NullPointerException at Foo.bar(Foo.java:' || (i % 300) || ')'
             END
    END
FROM range(1, 12001) t(i)

statement ok
VACUUM (REFRESH_TABLE) tv_t

statement ok
INSERT INTO tv_t SELECT i, i % 100, 'k' || (i % 5),
    CASE i % 10
        WHEN 0 THEN 'GET /api/v' || (i % 3) || '/users/' || i || ' 200 ' || (i % 97) || ' ms'
        WHEN 1 THEN 'POST /api/v' || (i % 3) || '/orders/' || i || ' 500 ' || (i % 89) || ' ms'
        WHEN 2 THEN 'connection to db-' || (i % 13) || ' timed out after ' || (i % 30) || ' s'
        WHEN 3 THEN 'timed out waiting for connection to db-' || (i % 13)
        WHEN 4 THEN 'disk usage ' || (i % 100) || ' pct on /dev/sd' || chr(CAST(97 + i % 4 AS INTEGER)) || (i % 5)
        WHEN 5 THEN 'cache hit ratio 0.' || (i % 100)
        WHEN 6 THEN 'user ' || i || ' login ok'
        WHEN 7 THEN 'heartbeat ' || i
        WHEN 8 THEN 'payment failed: card declined for order ' || i
        ELSE CASE WHEN i % 1000 = 9
                  THEN 'java.lang.OutOfMemoryError: Java heap space'
                  ELSE 'NullPointerException at Foo.bar(Foo.java:' || (i % 300) || ')'
             END
    END
FROM range(12001, 20001) t(i)

statement ok
VACUUM (REFRESH_TABLE) tv_t

statement ok
INSERT INTO tv_t SELECT i, i % 100, 'k' || (i % 5), NULL
FROM range(20001, 20101) t(i)

statement ok
VACUUM (REFRESH_TABLE) tv_t

statement ok
INSERT INTO tv_t VALUES
    (30001, 7, 'k1', NULL),
    (30002, 7, 'k1', ''),
    (30003, 7, 'k2', chr(31)),
    (30004, 7, 'k2', 'a' || chr(31) || 'b'),
    (30005, 7, 'k3', chr(1086) || chr(1096) || chr(1080) || chr(1073) || chr(1082) || chr(1072) || ': timed out'),
    (30006, 7, 'k3', 'GET /api/'),
    (30007, 7, 'k4', 'timed out'),
    (30008, 99, 'k4', 'heartbeat 17'),
    (30009, 7, 'k4', NULL),
    (30010, 7, 'k4', NULL)

statement ok
VACUUM (REFRESH_TABLE) tv_t

statement ok
DELETE FROM tv_t WHERE id % 10 IN (2, 3) AND id <= 6000

statement ok
VACUUM (REFRESH_TABLE) tv_t

query
SELECT c.relname, m.value >= 4 AS several
FROM sdb_metrics m JOIN pg_class c ON c.oid = m.relation_id
WHERE c.relname IN ('tv_idx', 'tv_pos_idx') AND m.metric = 'num_segments'
ORDER BY c.relname
----
relname	several
tv_idx	t
tv_pos_idx	t

# One predicate: count, stream and top-k.

query
SELECT (SELECT count(*) FROM tv_idx WHERE msg @@ ts_like('%timed out%')) -
       (SELECT count(*) FROM tv_t WHERE msg LIKE '%timed out%') AS d
----
d
0

query
SELECT count(*) AS d FROM (
    (SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%')
     EXCEPT SELECT id FROM tv_t WHERE msg LIKE '%timed out%')
    UNION ALL
    (SELECT id FROM tv_t WHERE msg LIKE '%timed out%'
     EXCEPT SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%'))
) t
----
d
0

query
SELECT count(*) AS d FROM (SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%')
      ORDER BY BM25(tv_idx.tableoid) DESC LIMIT 10) t
WHERE id NOT IN (SELECT id FROM tv_t WHERE msg LIKE '%timed out%')
----
d
0

query
SELECT (SELECT count(*) FROM (SELECT id FROM tv_idx WHERE msg @@ ts_like('%timed out%')
      ORDER BY BM25(tv_idx.tableoid) DESC LIMIT 10) t) -
       least(10, (SELECT count(*) FROM tv_t WHERE msg LIKE '%timed out%')) AS d
----
d
0

