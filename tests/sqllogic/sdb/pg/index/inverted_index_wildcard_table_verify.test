id	s
1	10
3	20
6	30

query
SELECT id, s FROM (SELECT id, s FROM tv_thr_idx WHERE msg @@ ts_like('%foo%bar%') AND CAST(s AS INTEGER) > 0
      ORDER BY BM25(tv_thr_idx.tableoid) DESC LIMIT 10) t ORDER BY id
----
id	s
1	10
3	20
6	30

