query
SELECT id, k, payload FROM ljs WHERE url LIKE '%google%' ORDER BY k, id LIMIT 6;
----
id	k	payload
3000	0	payload-3000-long-enough-to-not-inline
6000	0	payload-6000-long-enough-to-not-inline
7	7	payload-7-long-enough-to-not-inline
3007	7	payload-3007-long-enough-to-not-inline
6007	7	payload-6007-long-enough-to-not-inline
3014	14	payload-3014-long-enough-to-not-inline

query
SELECT count(*) AS n, count(*) FILTER (WHERE payload = 'payload-' || id || '-long-enough-to-not-inline' AND k = id % 3000) AS matching
FROM (SELECT id, k, payload FROM ljs WHERE url LIKE '%google%' ORDER BY k, id LIMIT 1000);
----
n	matching
1000	1000

