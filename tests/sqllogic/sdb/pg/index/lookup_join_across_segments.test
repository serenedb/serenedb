statement ok
CREATE TABLE ljs (id INTEGER, k INTEGER, url VARCHAR, payload VARCHAR)
WITH (storage = 'search', compaction_interval = 0, refresh_interval = 0);

statement ok
INSERT INTO ljs
SELECT i, i % 3000,
       CASE WHEN i % 3000 % 7 = 0 THEN 'https://google.com/' ELSE 'https://example.com/' END || i,
       'payload-' || i || '-long-enough-to-not-inline'
FROM range(0, 3000) t(i);

statement ok
VACUUM (REFRESH_TABLE) ljs;

