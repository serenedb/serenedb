statement ok
CREATE TEXT SEARCH DICTIONARY ljd_words AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm, offset);

statement ok
CREATE TABLE ljd (id INTEGER PRIMARY KEY, k INTEGER, body VARCHAR, payload VARCHAR, note VARCHAR);

statement ok
CREATE INDEX ljd_idx ON ljd USING inverted (id, k, body ljd_words) INCLUDE (k, payload)
WITH (refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO ljd
SELECT i, i % 3000,
       CASE WHEN i % 3000 % 7 = 0 THEN 'red fox pad' ELSE 'blue cat pad' END || i,
       'payload-' || i || '-long-enough-to-not-inline',
       'note-' || i
FROM range(0, 3000) t(i);

statement ok
VACUUM (REFRESH_TABLE) ljd;

