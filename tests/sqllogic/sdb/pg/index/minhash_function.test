# A MinHash similarity index is an expression index over minhash(); the query
# side hashes its text the same way and matches signatures as raw keyword
# terms through ts_tokenize(..., 'keyword').

statement ok
CREATE TEXT SEARCH DICTIONARY mh_words(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'lower',
    stemming = false,
    accent = false
);

statement ok
CREATE TABLE mh_docs(id INTEGER, body TEXT);

statement ok
INSERT INTO mh_docs VALUES
    (1, 'the quick brown fox'),
    (2, 'the quick brown dog'),
    (3, 'lorem ipsum dolor sit'),
    (4, NULL);

statement ok
CREATE INDEX mh_idx ON mh_docs USING inverted(id, (minhash(ts_lexize('mh_words', body), 16)));

statement ok
VACUUM (REFRESH_TABLE) mh_docs;


# --- At least two of the query's signatures must match ---

query
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 16), 'keyword'), 2)
ORDER BY id;
----
id
1
2


# --- A single matching signature is enough with the default min_match ---

query
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'fox'), 16), 'keyword'))
ORDER BY id;
----
id
1


# --- Every query signature must match with ts_all ---

query
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_all(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 16), 'keyword'))
ORDER BY id;
----
id
1
2


query
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_all(ts_tokenize(minhash(ts_lexize('mh_words', 'quick fox'), 16), 'keyword'))
ORDER BY id;
----
id
1


# --- Not enough shared signatures: one token from each of two documents ---

query
SELECT count(*) FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick lorem'), 16), 'keyword'), 2);
----
count
0


# --- min_match above the query's own signature count can never match ---

query
SELECT count(*) FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 16), 'keyword'), 3);
----
count
0


# --- Hashing the query with a different dictionary yields different signatures ---

statement ok
CREATE TEXT SEARCH DICTIONARY mh_upper(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'upper',
    stemming = false,
    accent = false
);

query
SELECT count(*) FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_upper', 'quick brown'), 16), 'keyword'), 2);
----
count
0


# --- Plain words are not signatures: nothing matches without minhash on the query side ---

query
SELECT count(*) FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16) @@ ts_any(['quick', 'brown'], 2);
----
count
0


# --- The query expression must be the indexed one: a different num_hashes is another expression ---

statement error
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 8)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 8), 'keyword'), 2);
----
db error: ERROR: @@ requires an inverted-indexed column on one side
HINT: Use: <indexed_col> @@ <tsquery_expr>. CREATE INDEX ... USING inverted(<col>) if missing.


statement error
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 16), 'keyword'), 0);
----
db error: ERROR: ts_any min_match must be >= 1, got 0
HINT: Example: ts_any(ts_tokenize(['quick', 'brown'])). Tokenises each list element through the column analyzer.


# --- The index follows inserts and deletes ---

statement ok
INSERT INTO mh_docs VALUES (5, 'a quick brown cat');

statement ok
VACUUM (REFRESH_TABLE) mh_docs;

query
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 16), 'keyword'), 2)
ORDER BY id;
----
id
1
2
5

statement ok
DELETE FROM mh_docs WHERE id = 2;

statement ok
VACUUM (REFRESH_TABLE) mh_docs;

query
SELECT id FROM mh_docs
WHERE minhash(ts_lexize('mh_words', body), 16)
      @@ ts_any(ts_tokenize(minhash(ts_lexize('mh_words', 'quick brown'), 16), 'keyword'), 2)
ORDER BY id;
----
id
1
5
