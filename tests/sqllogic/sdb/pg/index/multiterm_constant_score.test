hash-threshold 100

# A prefix, wildcard, regular-expression or range match is an OR of the terms
# it matches that keeps the best of them, and scores a constant: a matching row
# gets the match's constant (1 times its boost) once, however many of the
# row's terms the pattern matches. Under OR and AND the match is one clause.
# ::score(scorer) on the match scores its terms with that scorer and keeps the
# best; ::merge('sum') adds them up. A fuzzy match scores its terms by
# default. Matches on numeric columns always score a constant once.

statement ok
CREATE TEXT SEARCH DICTIONARY mcs_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE TABLE mcs (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX mcs_idx ON mcs USING inverted(id, body mcs_en);


# 'a' expands to apple (ids 1, 2, 3, 5), avocado (2, 3) and apricot (3).
statement ok
INSERT INTO mcs VALUES
  (1, 'apple'),
  (2, 'apple avocado'),
  (3, 'apple apricot avocado'),
  (4, 'banana'),
  (5, 'banana apple'),
  (6, 'cherry');


# --- One constant per matching row, whatever number of terms it matches.

query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_starts_with('a') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_like('a%') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_regexp('a.*') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_lt('b') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_between('a', 'b', true, false) ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


# The constant is the same under any ranking scorer.
query
SELECT id, TFIDF(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_starts_with('a') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


# A boost scales the constant and ::score('constant(N)') replaces it.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_like('a%') ^ 2.0) ORDER BY id;
----
id	score
1	2
2	2
3	2
5	2


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_regexp('a.*')::score('constant(3)') ORDER BY id;
----
id	score
1	3
2	3
3	3
5	3


query
SELECT COUNT(*) AS hits FROM mcs_idx WHERE body @@ ts_starts_with('a');
----
hits
4


# ::merge('sum') gives the constant once per matching term; ::merge('max') is
# the default.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_starts_with('a')::merge('sum') ORDER BY id;
----
id	score
1	1
2	2
3	3
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_like('a%')::merge('max') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_regexp('a.*')::score('constant(3)')::merge('sum')
ORDER BY id;
----
id	score
1	3
2	6
3	9
5	3


query
EXPLAIN SELECT id, BM25(mcs_idx.tableoid) FROM mcs_idx
WHERE body @@ ts_starts_with('a')::merge('sum');
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────────╮
│ Index: mcs_idx                         │
│ Lookup: search                         │
│ Index Filter:                          │
│ ╭─ Starts With ───────╮                │
│ │ Field: body(string) │                │
│ │ Prefix: a           │                │
│ │ Merge: sum          │                │
│ ╰─────────────────────╯                │
│ Score: bm25(k1=1.2, b=0.75)            │
│ Projections: id,                       │
│              sdb_inverted_index_score  │
│ ~1 row                                 │
╰────────────────────────────────────────╯


# --- Under OR and AND a pattern is one clause.

# A row matching both patterns scores 2, a row matching one of them 1.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_like('ap%') || ts_regexp('av.*')) ORDER BY id;
----
id	score
1	1
2	2
3	2
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_starts_with('ap') || ts_starts_with('av')) ORDER BY id;
----
id	score
1	1
2	2
3	2
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_starts_with('ap') && ts_regexp('av.*')) ORDER BY id;
----
id	score
2	2
3	2


# A term next to a pattern: the term's BM25 plus the pattern's constant.
# banana has df 2 of N = 6 rows, idf = ln(1 + 4.5 / 2.5) = 1.0296194, and
# avgdl = 10 / 6, so with k1 = 1.2, b = 0.75 a one-word row scores
# idf / (1.2 * (0.25 + 0.75 * 0.6) + 1) = 0.5595758 and a two-word row
# idf / (1.2 * (0.25 + 0.75 * 1.2) + 1) = 0.4326132.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ('banana'::tsquery || ts_starts_with('ap')) ORDER BY id;
----
id	score
1	1
2	1
3	1
4	0.5595758
5	1.4326131


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ('banana'::tsquery && ts_starts_with('ap')) ORDER BY id;
----
id	score
5	1.4326131


# apple has df 4, idf = ln(1 + 2.5 / 4.5) = 0.44183275, and row 3 has three
# words: 0.44183275 / (1.2 * (0.25 + 0.75 * 1.8) + 1) + 1 = 1.1513126.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_starts_with('apr') && 'apple'::tsquery) ORDER BY id;
----
id	score
3	1.1513126


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_starts_with('a') && !!'avocado'::tsquery) ORDER BY id;
----
id	score
1	1
5	1


# Under ::merge('max') a row takes its best clause.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ('banana'::tsquery || ts_starts_with('ap'))::merge('max')
ORDER BY id;
----
id	score
1	1
2	1
3	1
4	0.5595758
5	1


# Two wildcards on one column stay two clauses when the score adds them up,
# and become one when it takes the best of them or is not needed.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_like('%ppl%') || ts_like('%voc%')) ORDER BY id;
----
id	score
1	1
2	2
3	2
5	1


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_like('%ppl%') || ts_like('%voc%'))::merge('max') ORDER BY id;
----
id	score
1	1
2	1
3	1
5	1


query
EXPLAIN SELECT id, BM25(mcs_idx.tableoid) FROM mcs_idx
WHERE body @@ (ts_like('%ppl%') || ts_like('%voc%'));
----
