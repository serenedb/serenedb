# ::score(scorer) on a group scores the group's terms with it; a pattern in the
# group keeps its constant unless the scorer is on the pattern itself. A
# constant scorer on the group replaces the pattern's constant too.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ('banana'::tsquery || ts_starts_with('ap'))::score('bm25(1.2, 0.75)')
ORDER BY id;
----
id	score
1	1
2	1
3	1
4	0.5595758
5	1.4326131


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ('banana'::tsquery || ts_starts_with('ap'))::score('constant(3)')
ORDER BY id;
----
id	score
1	3
2	3
3	3
4	3
5	6


# --- ::score(scorer) scores the matching terms and keeps the best of them;
# ::merge('sum') adds them up. Each kind of pattern expands 'a' to the same
# terms, so all four score alike. With N = 6 and avgdl = 10 / 6, a term in a
# row of dl words scores idf / (1.2 * (0.25 + 0.75 * dl / avgdl) + 1), with idf
# ln(1 + 2.5 / 4.5) for apple, ln(2.8) for avocado and ln(1 + 5.5 / 1.5) for
# apricot: row 3 is best at apricot, 1.5404450 / 2.92 = 0.5275496, row 2 at
# avocado, 1.0296194 / 2.38 = 0.4326132.

query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_starts_with('a')::score('bm25(1.2, 0.75)')
ORDER BY score DESC, id;
----
id	score
3	0.5275496
2	0.4326132
1	0.24012649
5	0.185644


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_like('a%')::score('bm25(1.2, 0.75)')
ORDER BY score DESC, id;
----
id	score
3	0.5275496
2	0.4326132
1	0.24012649
5	0.185644


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_regexp('a.*')::score('bm25(1.2, 0.75)')
ORDER BY score DESC, id;
----
id	score
3	0.5275496
2	0.4326132
1	0.24012649
5	0.185644


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_lt('b')::score('bm25(1.2, 0.75)')
ORDER BY score DESC, id;
----
id	score
3	0.5275496
2	0.4326132
1	0.24012649
5	0.185644


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_starts_with('a')::score('bm25(1.2, 0.75)')::merge('sum')
ORDER BY score DESC, id;
----
id	score
3	1.0314716
2	0.61825716
1	0.24012649
5	0.185644


query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ ts_lt('b')::score('bm25(1.2, 0.75)')::merge('sum')
ORDER BY score DESC, id;
----
id	score
3	1.0314716
2	0.61825716
1	0.24012649
5	0.185644


# Two scored patterns under OR: each keeps its best term and the OR adds the two
# up, so row 3 scores apricot plus avocado, 0.5275496 + 0.3526094.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_starts_with('ap')::score('bm25(1.2, 0.75)') ||
               ts_starts_with('av')::score('bm25(1.2, 0.75)'))
ORDER BY score DESC, id;
----
id	score
3	0.880159
2	0.61825716
1	0.24012649
5	0.185644


# Adding up their terms instead, they score as an OR of those terms does.
query
SELECT id, BM25(mcs_idx.tableoid) AS score FROM mcs_idx
WHERE body @@ (ts_starts_with('ap')::score('bm25(1.2, 0.75)')::merge('sum') ||
               ts_starts_with('av')::score('bm25(1.2, 0.75)')::merge('sum'))
ORDER BY score DESC, id;
----
id	score
3	1.0314716
2	0.61825716
1	0.24012649
5	0.185644


