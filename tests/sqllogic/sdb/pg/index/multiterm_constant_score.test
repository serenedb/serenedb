# --- Top-k returns the same scores, with and without pruning.

statement ok
CREATE TABLE mcs_top (id INTEGER PRIMARY KEY, body VARCHAR)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
CREATE INDEX mcs_top_idx ON mcs_top USING inverted(id, body mcs_en);


statement ok
INSERT INTO mcs_top SELECT id, body FROM mcs;


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_top_idx.tableoid) AS score FROM mcs_top_idx
  WHERE body @@ ts_starts_with('a')
  ORDER BY BM25(mcs_top_idx.tableoid) DESC LIMIT 3) t;
----
hits	lo	hi
3	1	1


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_idx.tableoid) AS score FROM mcs_idx
  WHERE body @@ ts_starts_with('a')
  ORDER BY BM25(mcs_idx.tableoid) DESC LIMIT 3) t;
----
hits	lo	hi
3	1	1


query
SELECT id, BM25(mcs_top_idx.tableoid) AS score FROM mcs_top_idx
WHERE body @@ ('banana'::tsquery || ts_starts_with('ap'))
ORDER BY BM25(mcs_top_idx.tableoid) DESC LIMIT 1;
----
id	score
5	1.5320172


# Pruned top-k of a term and a pattern returns the best rows of the full
# result: common and apple in two words. common has df 1500 of 3000 rows,
# idf = ln(2), and avgdl = 11 / 6, so those rows score
# ln(2) / (1.2 * (0.25 + 0.75 * 2 / (11 / 6)) + 1) + 1 = 1.3037697 and the
# three-word rows ln(2) / (1.2 * (0.25 + 0.75 * 3 / (11 / 6)) + 1) + 1 =
# 1.2499875.
statement ok
CREATE TABLE mcs_big (id INTEGER PRIMARY KEY, body VARCHAR)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
CREATE INDEX mcs_big_idx ON mcs_big USING inverted(id, body mcs_en);


statement ok
INSERT INTO mcs_big
SELECT i, CASE WHEN i % 2 = 0 THEN 'common ' ELSE '' END ||
          CASE i % 3 WHEN 0 THEN 'apple apricot' WHEN 1 THEN 'apple'
                     ELSE 'banana' END
FROM generate_series(1, 3000) AS s(i);


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_big_idx.tableoid) AS score FROM mcs_big_idx
  WHERE body @@ ('common'::tsquery && ts_starts_with('ap'))
  ORDER BY BM25(mcs_big_idx.tableoid) DESC LIMIT 5) t;
----
hits	lo	hi
5	1.3037697	1.3037697


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_big_idx.tableoid) AS score FROM mcs_big_idx
  WHERE body @@ ('common'::tsquery && ts_starts_with('ap'))) t;
----
hits	lo	hi
1000	1.2499875	1.3037697


# A pattern scored per term on a column without frequencies: each of its terms
# scores one value of its own, and pruned top-k ranks rows by their best or by
# their sum as the full result does: the best rows hold common and apricot, the
# rarer term.
statement ok
CREATE TEXT SEARCH DICTIONARY mcs_plain AS split_text();


statement ok
CREATE TABLE mcs_tags (id INTEGER PRIMARY KEY, body VARCHAR, tag VARCHAR)
  WITH (optimize_top_k = 'bm25(1.2, 0.75)');


statement ok
CREATE INDEX mcs_tags_idx ON mcs_tags
  USING inverted(id, body mcs_en, tag mcs_plain);


statement ok
INSERT INTO mcs_tags
SELECT i, CASE WHEN i % 2 = 0 THEN 'common' ELSE 'rare' END,
          CASE i % 3 WHEN 0 THEN 'apple apricot' WHEN 1 THEN 'apple'
                     ELSE 'banana' END
FROM generate_series(1, 3000) AS s(i);


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_tags_idx.tableoid) AS score FROM mcs_tags_idx
  WHERE body @@ 'common'::tsquery
    AND tag @@ ts_starts_with('ap')::score('bm25(1.2, 0.75)')
  ORDER BY BM25(mcs_tags_idx.tableoid) DESC LIMIT 5) t;
----
hits	lo	hi
5	0.8712419	0.8712419


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_tags_idx.tableoid) AS score FROM mcs_tags_idx
  WHERE body @@ 'common'::tsquery
    AND tag @@ ts_starts_with('ap')::score('bm25(1.2, 0.75)')) t;
----
hits	lo	hi
1000	0.52040786	0.8712419


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_tags_idx.tableoid) AS score FROM mcs_tags_idx
  WHERE body @@ 'common'::tsquery
    AND tag @@ ts_starts_with('ap')::score('bm25(1.2, 0.75)')::merge('sum')
  ORDER BY BM25(mcs_tags_idx.tableoid) DESC LIMIT 5) t;
----
hits	lo	hi
5	1.0765829	1.0765829


query
SELECT COUNT(*) AS hits, MIN(score) AS lo, MAX(score) AS hi FROM (
  SELECT BM25(mcs_tags_idx.tableoid) AS score FROM mcs_tags_idx
  WHERE body @@ 'common'::tsquery
    AND tag @@ ts_starts_with('ap')::score('bm25(1.2, 0.75)')::merge('sum')) t;
----
hits	lo	hi
1000	0.52040786	1.0765829


# A fuzzy match given a constant score weighs the same for every row, however
# close its words are: apple is one edit from aple and apples two.
statement ok
CREATE TABLE mcs_fuzzy (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX mcs_fuzzy_idx ON mcs_fuzzy USING inverted(id, body mcs_en);


statement ok
INSERT INTO mcs_fuzzy VALUES
  (1, 'apple'), (2, 'apples'), (3, 'apple apples'), (4, 'banana');


query
SELECT id, BM25(mcs_fuzzy_idx.tableoid) AS score FROM mcs_fuzzy_idx
WHERE body @@ ts_levenshtein('aple', 2)::score('constant(1)') ORDER BY id;
----
id	score
1	1
2	1
3	1


query
SELECT id, BM25(mcs_fuzzy_idx.tableoid) AS score FROM mcs_fuzzy_idx
WHERE body @@ ('banana'::tsquery ||
               ts_levenshtein('aple', 2)::score('constant(1)'))
ORDER BY id;
----
id	score
1	1
2	1
3	1
4	0.5960261


# Scored by BM25, a fuzzy match takes its best word scaled by its similarity,
# alone and under OR alike.
query
SELECT id, BM25(mcs_fuzzy_idx.tableoid) AS score FROM mcs_fuzzy_idx
WHERE body @@ ts_levenshtein('aple', 2) ORDER BY id;
----
id	score
1	0.25735664
2	0.17157109
3	0.18973008


query
SELECT id, BM25(mcs_fuzzy_idx.tableoid) AS score FROM mcs_fuzzy_idx
WHERE body @@ ('banana'::tsquery || ts_levenshtein('aple', 2)) ORDER BY id;
----
id	score
1	0.25735664
2	0.17157109
3	0.18973008
4	0.5960261


# ::merge('sum') adds its scaled words up: row 3 holds both apple and apples.
query
SELECT id, BM25(mcs_fuzzy_idx.tableoid) AS score FROM mcs_fuzzy_idx
WHERE body @@ ts_levenshtein('aple', 2)::merge('sum') ORDER BY id;
----
id	score
1	0.25735664
2	0.17157109
3	0.31621677


query
SELECT id, BM25(mcs_fuzzy_idx.tableoid) AS score FROM mcs_fuzzy_idx
WHERE body @@ ts_levenshtein('aple', 2)::score('constant(1)')::merge('sum')
ORDER BY id;
----
id	score
1	1
2	1
3	2


# --- Numeric ranges always score a constant, once per row however many of
# its values fall in the range.

statement ok
CREATE TABLE mcs_nums (id INTEGER PRIMARY KEY, nums INTEGER[]);


statement ok
INSERT INTO mcs_nums VALUES (1, [5, 50]), (2, [5]), (3, [500]);


statement ok
CREATE INDEX mcs_nums_idx ON mcs_nums USING inverted(id, nums);


query
SELECT id, BM25(mcs_nums_idx.tableoid) AS score FROM mcs_nums_idx
WHERE nums @@ ts_between(1, 100, true, true) ORDER BY id;
----
id	score
1	1
2	1


query
SELECT id, BM25(mcs_nums_idx.tableoid) AS score FROM mcs_nums_idx
WHERE nums @@ ts_between(1, 100, true, true)::score('constant(2)') ORDER BY id;
----
id	score
1	2
2	2


statement error
SELECT id FROM mcs_nums_idx
WHERE nums @@ ts_between(1, 100, true, true)::score('bm25(1.2, 0.75)');
----
db error: ERROR: ::score('bm25(k1=1.2, b=0.75)') cannot apply to a match that carries no term statistics
HINT: Such a match weighs the same for every document. Use ::score('constant(N)') or ::boost(N) here, or put the scorer on an AND / OR group that also matches an analyzed column.


# Such a match keeps the best of its terms, so ::merge('max') changes nothing
# and ::merge('sum') is an error.
query
SELECT id, BM25(mcs_nums_idx.tableoid) AS score FROM mcs_nums_idx
WHERE nums @@ ts_between(1, 100, true, true)::merge('max') ORDER BY id;
----
id	score
1	1
2	1


statement error
SELECT id FROM mcs_nums_idx
WHERE nums @@ ts_between(1, 100, true, true)::merge('sum');
----
db error: ERROR: ::merge('sum') cannot apply to a match that always scores a constant
HINT: Such a match scores its constant once per row, however many of its terms the row holds.
