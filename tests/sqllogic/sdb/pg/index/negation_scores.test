statement ok
CREATE TEXT SEARCH DICTIONARY ngs_d AS split_text() WITH (frequency, position, norm);


statement ok
CREATE TABLE ngs (id INT PRIMARY KEY, body TEXT, tag TEXT);


statement ok
CREATE INDEX ngs_idx ON ngs USING inverted (id, body ngs_d, tag ngs_d);


statement ok
INSERT INTO ngs VALUES (1, 'dot zzz', 'dog zzz'), (2, 'zzz', 'cat'), (3, 'dot', 'dog'), (4, 'fig', 'fig');


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE NOT body @@ 'dot'::tsquery::score('constant(1)')
ORDER BY id;
----
id	score
2	0
4	0


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE NOT body @@ 'dot'::tsquery::score('constant(1)') OR NOT tag @@ 'dog'::tsquery::score('constant(1)')
ORDER BY id;
----
id	score
2	0
4	0


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE NOT (body @@ 'dot'::tsquery::score('constant(1)') AND tag @@ 'dog'::tsquery::score('constant(1)'))
ORDER BY id;
----
id	score
2	0
4	0


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE (NOT body @@ 'dot')::score('constant(2)')
ORDER BY id;
----
id	score
2	0
4	0


query
SELECT id, constant(ngs_idx.tableoid, 1) AS score FROM ngs_idx
WHERE body @@ 'fig' OR NOT (body @@ 'dot' AND tag @@ 'dog')
ORDER BY id;
----
id	score
2	0
4	1


query
SELECT id, raw_boost(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE body @@ 'fig' OR id <> 1
ORDER BY id;
----
id	score
2	0
3	0
4	1


query
SELECT id, constant(ngs_idx.tableoid, 1) AS score FROM ngs_idx
WHERE body @@ 'fig' OR id NOT IN (1, 2)
ORDER BY id;
----
id	score
3	0
4	1


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE body @@ 'fig'::tsquery::score('constant(1)') OR NOT (id < 3)
ORDER BY id;
----
id	score
3	0
4	1


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE body @@ 'fig'::tsquery::score('constant(1)') OR id >= 3
ORDER BY id;
----
id	score
3	1
4	2


query
SELECT id, BM25(ngs_idx.tableoid) AS score FROM ngs_idx
WHERE body @@ 'zzz'::tsquery::score('constant(1)') OR NOT tag @@ 'dog'::tsquery::score('constant(1)')
ORDER BY id;
----
id	score
1	1
2	1
4	0
