query
EXPLAIN SELECT o.id, BM25(o.tableoid) AS score FROM obs_idx o, (VALUES (1), (2)) v(x)
WHERE (o.kind = 'a' AND v.x = 1) OR (o.id < 3 AND v.x = 2);
----
