statement ok
CREATE TEXT SEARCH DICTIONARY obs_d AS split_text() WITH (frequency, position, norm);


statement ok
CREATE TABLE obs (id INT PRIMARY KEY, body TEXT, tag TEXT);


statement ok
CREATE INDEX obs_idx ON obs USING inverted (id, body obs_d, tag obs_d);


statement ok
INSERT INTO obs VALUES (1, 'dot zzz', 'dog zzz'), (2, 'zzz', 'cat'), (3, 'dot', 'dog'), (4, 'fig', 'fig');


query
SELECT id, BM25(obs_idx.tableoid) AS score FROM obs_idx
WHERE body @@ 'zzz'::tsquery::score('constant(1)')
   OR (tag @@ 'dog'::tsquery::score('constant(1)') AND body @@ 'dot'::tsquery::score('constant(1)'))
ORDER BY id;
----
id	score
1	3
2	1
3	2


query
EXPLAIN SELECT id, BM25(obs_idx.tableoid) AS score FROM obs_idx
WHERE body @@ 'zzz'::tsquery::score('constant(1)')
   OR (tag @@ 'dog'::tsquery::score('constant(1)') AND body @@ 'dot'::tsquery::score('constant(1)'));
----
