query
SELECT bm25(partial_fusion_idx.tableoid) AS score FROM partial_fusion_idx
WHERE body @@ ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')])
  AND (id = 2)::score(NULL);
----
score
3

query
SELECT bm25(partial_fusion_idx.tableoid) AS score FROM partial_fusion_idx
WHERE body @@ ts_any([ts_phrase('quick fox'), ts_like('%ki%')::boost(3), ts_like('%wi%')::boost(2), ts_like('%iw%')::boost(4)])
  AND (id = 2)::score(NULL);
----
score
9

query
SELECT id, bm25(partial_fusion_idx.tableoid) AS score FROM partial_fusion_idx
WHERE body @@ ts_like('%a%')
  AND NOT (body @@ ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')]))
ORDER BY id;
----
id	score
3	1
4	1

query
SELECT id FROM partial_fusion_idx
WHERE NOT (body @@ ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')]))
ORDER BY id;
