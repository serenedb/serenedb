query
SELECT ts_offsets('partial_fusion_words', 'quick fox kiwi banana',
                  ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')])) AS offsets;
----
offsets
{0,9,10,14}

query
SELECT ts_highlight('partial_fusion_words', 'quick fox kiwi banana',
                    ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')])) AS highlighted;
----
highlighted
<b>quick fox kiwi</b> banana

query
SELECT ts_offsets('partial_fusion_words', 'kiwi kiwi quick fox',
                  ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')]), 1) AS offsets;
----
offsets
{0,4}

query
SELECT id, ts_offsets(body) AS indexed_offsets,
       ts_offsets('partial_fusion_words', body,
                  ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')])) AS standalone_offsets
FROM partial_fusion_idx
WHERE body @@ ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')])
ORDER BY id;
----
id	indexed_offsets	standalone_offsets
1	{0,9}	{0,9}
2	{0,4}	{0,4}
7	{0,4}	{0,4}
9	{0,9,10,14}	{0,9,10,14}

