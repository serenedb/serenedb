hash-threshold 100

statement ok
CREATE TABLE partial_fusion (id INTEGER PRIMARY KEY, body VARCHAR, other VARCHAR);

statement ok
CREATE TEXT SEARCH DICTIONARY partial_fusion_words AS split_text() WITH (frequency, position, offset);

statement ok
CREATE INDEX partial_fusion_idx ON partial_fusion USING inverted (id, body partial_fusion_words, other partial_fusion_words);

statement ok
INSERT INTO partial_fusion VALUES
  (1, 'quick fox', 'none'),
  (2, 'kiwi', 'none'),
  (3, 'banana', 'kiwi'),
  (4, 'apple', 'none'),
  (5, 'cherry', 'none'),
  (6, NULL, 'none'),
  (7, 'kiwi banana', 'none'),
  (8, 'quick sleepy fox', 'none'),
  (9, 'quick fox kiwi', 'none');

statement ok
VACUUM (FLUSH_TABLE) partial_fusion;

query
EXPLAIN SELECT id FROM partial_fusion_idx
WHERE body @@ ts_any([ts_phrase('quick fox'), ts_like('%ki%'), ts_like('%wi%'), ts_like('%iw%')]);
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────────────────────────────────╮
│ Index: partial_fusion_idx                                           │
│ Lookup: search                                                      │
│ Index Filter:                                                       │
│ ╭─ Or ───────────────────────────────╮                              │
│ ╰──────────────────┬─────────────────╯                              │
│                    ├─────────────────────────────────╮              │
│ ╭─ Phrase ─────────┴─────────────────╮  ╭─ Automaton ┴────────────╮ │
│ │ Field: body(string)                │  │ Field: body(string)     │ │
│ │ Parts:                             │  │ Pattern: %ki%|%wi%|%iw% │ │
│ │ Term:quick(0, 0); Term:fox(1, 1);  │  ╰─────────────────────────╯ │
│ ╰────────────────────────────────────╯                              │
│ Projections: id                                                     │
│ ~1 row                                                              │
╰─────────────────────────────────────────────────────────────────────╯

