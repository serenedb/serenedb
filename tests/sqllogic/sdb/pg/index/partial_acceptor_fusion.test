statement ok
CREATE TEXT SEARCH DICTIONARY partial_fusion_ngram AS
  generate_wildcard_ngrams(split_text_csv(' '), 3) WITH (frequency, position);

statement ok
CREATE TABLE partial_fusion_ngram_docs (id INT PRIMARY KEY, body VARCHAR);

statement ok
CREATE INDEX partial_fusion_ngram_idx ON partial_fusion_ngram_docs USING inverted (id, body partial_fusion_ngram);

statement ok
INSERT INTO partial_fusion_ngram_docs VALUES
  (1, 'quick brown fox'), (2, 'quick grey fox'), (3, 'slow brown fox');

statement ok
VACUUM (FLUSH_TABLE) partial_fusion_ngram_docs;

query
SELECT id, ts_offsets(body) = ts_offsets('partial_fusion_ngram', body,
  ts_any([ts_phrase('quick brown'), ts_like('%qui%'), ts_like('%ick%'), ts_like('%uic%')])) AS same_offsets
FROM partial_fusion_ngram_idx
WHERE body @@ ts_any([ts_phrase('quick brown'), ts_like('%qui%'), ts_like('%ick%'), ts_like('%uic%')])
ORDER BY id;
----
id	same_offsets
1	t
2	t
