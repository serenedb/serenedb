statement ok
CREATE TEXT SEARCH DICTIONARY pms_en AS split_text()
    WITH (frequency, position, norm);


statement ok
CREATE TABLE pms_merge (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX pms_merge_idx ON pms_merge
  USING inverted(id, body pms_en);


statement ok
INSERT INTO pms_merge VALUES
  (1, 'apple'), (2, 'apple avocado'), (3, 'apple apricot avocado'), (4, 'banana');


query
SELECT id, BM25(pms_merge_idx.tableoid) AS score FROM pms_merge_idx
WHERE body @@ ts_starts_with('a')::merge('sum') ORDER BY id;
----
id	score
1	1
2	2
3	3


query
SELECT id, BM25(pms_merge_idx.tableoid) AS score FROM pms_merge_idx
WHERE body @@ to_tsquery('a*')::merge('sum') ORDER BY id;
----
id	score
1	1
2	2
3	3


query
SELECT id, BM25(pms_merge_idx.tableoid) AS score FROM pms_merge_idx
WHERE body @@ to_tsquery('/a.*/')::merge('sum') ORDER BY id;
----
id	score
1	1
2	2
3	3


query
SELECT id, BM25(pms_merge_idx.tableoid) AS score FROM pms_merge_idx
WHERE body @@ ts_any(ARRAY[ts_starts_with('a')])::merge('sum') ORDER BY id;
----
id	score
1	1
2	2
3	3


query
SELECT count(*) AS n FROM pms_merge_idx
WHERE body @@ to_tsquery('a*')::score('bm25(1.2, 0.75)');
----
n
3


statement ok
CREATE TABLE pms_boost (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE INDEX pms_boost_idx ON pms_boost
  USING inverted(id, body pms_en);


statement ok
INSERT INTO pms_boost VALUES (1, 'eel zzz'), (2, 'eel'), (3, 'fig');


query
SELECT id, BM25(pms_boost_idx.tableoid) AS score FROM pms_boost_idx
WHERE body @@ (('fig'::tsquery::score('constant(1)') ||
                ('eel'::tsquery::score('constant(2)') &&
                 'zzz'::tsquery::score('constant(1)'))) ^ 2.0)
ORDER BY id;
----
id	score
1	6
3	2


query
SELECT id, BM25(pms_boost_idx.tableoid) AS score FROM pms_boost_idx
WHERE body @@ (('nope'::tsquery::score('constant(1)') ||
                ('eel'::tsquery::score('constant(2)') &&
                 'zzz'::tsquery::score('constant(1)'))) ^ 2.0)
ORDER BY id;
----
id	score
1	6


query
SELECT id, BM25(pms_boost_idx.tableoid) AS score FROM pms_boost_idx
WHERE body @@ (('nope'::tsquery::score('constant(1)') ||
                ('eel'::tsquery::score('constant(2)') &&
                 'zzz'::tsquery::score('constant(1)'))) ^ 3.0)
ORDER BY id;
----
id	score
1	9
