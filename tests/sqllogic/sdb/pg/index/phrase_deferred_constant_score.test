query
SELECT id, round(BM25(pdc_pos_idx.tableoid)::numeric, 4) AS score FROM pdc_pos_idx
WHERE (body @@ (ts_phrase('quick') ## ts_starts_with('br')))::score('constant(1)')
  AND body @@ 'quick'
ORDER BY id
----
id	score
1	1.117
2	1.117

