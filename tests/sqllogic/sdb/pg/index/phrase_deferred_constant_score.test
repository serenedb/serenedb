CREATE TEXT SEARCH DICTIONARY pdc_syn AS split_text(case := 'lower') | expand_solr_synonyms('quick, fast') WITH (frequency)


statement ok
CREATE TEXT SEARCH DICTIONARY pdc_syn_pos AS split_text(case := 'lower') | expand_solr_synonyms('quick, fast') WITH (frequency, position)


statement ok
CREATE TABLE pdc_syn_docs (id INTEGER PRIMARY KEY, body VARCHAR)


statement ok
INSERT INTO pdc_syn_docs VALUES (1, 'quick brown fox'), (2, 'fast brown brawn bright'), (3, 'slow brown')


statement ok
CREATE INDEX pdc_syn_text_idx ON pdc_syn_docs USING inverted (id, body pdc_syn) INCLUDE (body)


statement ok
CREATE INDEX pdc_syn_pos_idx ON pdc_syn_docs USING inverted (id, body pdc_syn_pos)


statement ok
VACUUM (REFRESH_TABLE) pdc_syn_docs


