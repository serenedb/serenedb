statement ok
CREATE TEXT SEARCH DICTIONARY pdc_words AS split_text(case := 'lower') WITH (frequency)


statement ok
CREATE TEXT SEARCH DICTIONARY pdc_words_pos AS split_text(case := 'lower') WITH (frequency, position)


statement ok
CREATE TABLE pdc_docs (id INTEGER PRIMARY KEY, body VARCHAR)


statement ok
INSERT INTO pdc_docs VALUES (1, 'quick brown fox'), (2, 'quick brown brawn bright')


statement ok
CREATE INDEX pdc_text_idx ON pdc_docs USING inverted (id, body pdc_words) INCLUDE (body)


statement ok
CREATE INDEX pdc_pos_idx ON pdc_docs USING inverted (id, body pdc_words_pos)


statement ok
VACUUM (REFRESH_TABLE) pdc_docs


query
SELECT id, constant(pdc_pos_idx.tableoid, 2.0) AS score FROM pdc_pos_idx
WHERE body @@ (ts_phrase('quick') ## ts_starts_with('br')) ORDER BY id
----
id	score
1	2
2	2

