statement ok
CREATE TEXT SEARCH DICTIONARY pdi_words AS split_text(case := 'lower') WITH (frequency)


statement ok
CREATE TEXT SEARCH DICTIONARY pdi_words_pos AS split_text(case := 'lower') WITH (frequency, position)


statement ok
CREATE TABLE pdi_docs (id INTEGER PRIMARY KEY, body VARCHAR)


statement ok
INSERT INTO pdi_docs VALUES (1, 'quick brown fox'), (2, 'quick quick brown'), (3, 'lazy dog'), (4, 'brown fox')


statement ok
CREATE INDEX pdi_text_idx ON pdi_docs USING inverted (id, body pdi_words) INCLUDE (body)


statement ok
CREATE INDEX pdi_pos_idx ON pdi_docs USING inverted (id, body pdi_words_pos)


statement ok
VACUUM (REFRESH_TABLE) pdi_docs


query
SELECT id, round(BM25(pdi_pos_idx.tableoid)::numeric, 4) AS score FROM pdi_pos_idx
WHERE body @@ ts_phrase('quick brown') ORDER BY id
----
id	score
1	0.632
2	0.632

query
SELECT id, round(constant(pdi_pos_idx.tableoid, 2.0)::numeric, 4) AS score FROM pdi_pos_idx
WHERE ((body @@ 'quick' AND body @@ ts_phrase('quick brown'))::score('bm25(1.2, 0.75)'))::merge('max')
ORDER BY id
----
id	score
1	0.632
2	0.632

