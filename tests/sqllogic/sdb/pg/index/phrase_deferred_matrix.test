query
SELECT (SELECT count(*) FROM (SELECT id FROM pdm_syn_pos WHERE body @@ to_tsquery('"quick brown"'))) AS matches, (SELECT count(*) FROM ((SELECT id FROM pdm_syn_text WHERE body @@ to_tsquery('"quick brown"') EXCEPT SELECT id FROM pdm_syn_pos WHERE body @@ to_tsquery('"quick brown"')) UNION ALL (SELECT id FROM pdm_syn_pos WHERE body @@ to_tsquery('"quick brown"') EXCEPT SELECT id FROM pdm_syn_text WHERE body @@ to_tsquery('"quick brown"')))) AS mismatches
----
matches	mismatches
