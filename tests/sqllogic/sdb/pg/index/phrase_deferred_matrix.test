RESET sdb_levenshtein_max_terms

# --- Ranked by BM25 (checked inline): same scores as positions. Fuzzy parts
# are left out until the check weights them by edit distance like the index.

query
SELECT count(*) AS mismatches FROM (SELECT id, round(BM25(pdm_text.tableoid)::numeric, 5) AS s FROM pdm_text WHERE body @@ to_tsquery('"quick brown"')) a FULL JOIN (SELECT id, round(BM25(pdm_pos.tableoid)::numeric, 5) AS s FROM pdm_pos WHERE body @@ to_tsquery('"quick brown"')) b USING (id) WHERE a.s IS DISTINCT FROM b.s
----
