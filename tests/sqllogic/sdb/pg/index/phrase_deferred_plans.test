# Where each deferred phrase shape is checked. Their answers are compared
# with a positional index in phrase_deferred_matrix.gen.test, which
# tests/sqllogic/generators/sdb/pg/index/phrase_deferred_matrix.py
# generates from the same rows.

statement ok
CREATE TEXT SEARCH DICTIONARY pdm_words AS split_text(case := 'lower') WITH (frequency)

statement ok
CREATE TEXT SEARCH DICTIONARY pdm_syn AS
    split_text(case := 'lower') | expand_solr_synonyms('car, automobile, auto')
    WITH (frequency)

statement ok
CREATE TABLE pdm (id INTEGER PRIMARY KEY, body VARCHAR)

statement ok
INSERT INTO pdm SELECT i, (SELECT string_agg(['quick', 'quack', 'quiet', 'brown', 'brawn', 'brow', 'fox', 'box', 'fix', 'the', 'a', 'dog', 'dot', 'red', 'car', 'auto', 'automobile', 'big'][1 + (hash(i, j) % 18)::INTEGER], ' ' ORDER BY j) FROM range(1 + (hash(i) % 12)::INTEGER) r(j)) FROM range(600) t(i)

statement ok
CREATE INDEX pdm_text ON pdm USING inverted (id, body pdm_words) INCLUDE (body)

statement ok
CREATE INDEX pdm_syn_text ON pdm USING inverted (id, body pdm_syn) INCLUDE (body)

statement ok
VACUUM (REFRESH_TABLE) pdm

statement ok
CREATE TABLE pdm_v (id INTEGER PRIMARY KEY, body VARCHAR, emb FLOAT[3])

statement ok
INSERT INTO pdm_v VALUES
    (1, 'quick brown fox', [1, 0, 0]::FLOAT[3]),
    (2, 'brown quick fox', [0, 1, 0]::FLOAT[3]),
    (3, 'the quick brown dog', [0, 0, 1]::FLOAT[3]),
    (4, 'quick red fox', [10, 10, 10]::FLOAT[3])

statement ok
CREATE INDEX pdm_v_idx ON pdm_v USING inverted (id, body pdm_words, emb ivf (metric = 'l2')) INCLUDE (body)

statement ok
VACUUM (REFRESH_TABLE) pdm_v

query
SELECT id FROM pdm_v_idx WHERE body @@ ts_phrase('quick brown') ORDER BY emb <-> [0, 0, 1]::FLOAT[3] LIMIT 2
----
id
3
1

query
EXPLAIN SELECT id FROM pdm_v_idx WHERE body @@ ts_phrase('quick brown') ORDER BY emb <-> [0, 0, 1]::FLOAT[3] LIMIT 2
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────╮
│ Index: pdm_v_idx                         │
│ Lookup: table                            │
│ Index Filter:                            │
│ ╭─ Phrase ─────────────────────────────╮ │
│ │ Field: body(string)                  │ │
│ │ Parts:                               │ │
│ │ Term:quick(0, 0); Term:brown(1, 1);  │ │
│ │ Verify: inline                       │ │
│ ╰──────────────────────────────────────╯ │
│ Score: l2_distance(emb, FLOAT[3])        │
│ Top: 2                                   │
│ Projections: id                          │
│ ~1 row                                   │
╰──────────────────────────────────────────╯

query
SELECT list_sort(ts_dict_agg(body)) AS terms FROM pdm_v_idx WHERE body @@ ts_phrase('quick brown')
----
terms
{brown,dog,fox,quick,the}

