statement ok
CREATE TABLE pdm_s (id INTEGER, body VARCHAR) WITH (storage = 'search')

statement ok
INSERT INTO pdm_s SELECT id, body FROM pdm

statement ok
VACUUM (REFRESH_TABLE) pdm_s

statement ok
CREATE INDEX pdm_s_text ON pdm_s USING inverted (id, body pdm_words)

statement ok
VACUUM (REFRESH_TABLE) pdm_s

