statement ok
CREATE TABLE pj_tags (id INTEGER PRIMARY KEY, doc JSON);

statement ok
CREATE INDEX pj_tags_idx ON pj_tags USING inverted(
    id, (doc->'tags'->>0) pj_nopos, (doc->'tags'->>0) included());

statement ok
INSERT INTO pj_tags VALUES
    (1, '{"tags":["red fox den","quick"]}'::json),
    (2, '{"tags":["fox red","red fox"]}'::json),
    (3, '{"tags":[]}'::json);

statement ok
VACUUM (REFRESH_TABLE) pj_tags;

query
SELECT id FROM pj_tags_idx WHERE (doc->'tags'->>0) @@ ts_phrase('red fox') ORDER BY id;
----
id
1

query
SELECT id FROM pj_tags_idx WHERE (doc->'tags'->>0) @@ ts_phrase('fox', 0, 'red') ORDER BY id;
----
id
