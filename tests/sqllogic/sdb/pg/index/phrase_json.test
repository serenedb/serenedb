statement ok
CREATE TABLE pj_raw (id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO pj_raw VALUES
    (1, '"quick\nbrown fox"'),
    (2, '"quick brown"');

statement ok
CREATE INDEX pj_raw_pos_idx ON pj_raw USING inverted(id, body pj_pos);

statement ok
CREATE INDEX pj_raw_text_idx ON pj_raw USING inverted(id, body pj_nopos) INCLUDE (body);

statement ok
VACUUM (REFRESH_TABLE) pj_raw;

query
SELECT id FROM pj_raw_pos_idx WHERE body @@ ts_phrase('quick nbrown') ORDER BY id;
----
id
1

query
SELECT id FROM pj_raw_text_idx WHERE body @@ ts_phrase('quick nbrown') ORDER BY id;
----
id
1

query
SELECT id FROM pj_raw_text_idx
WHERE body @@ ts_phrase('quick nbrown') OR body @@ ts_phrase('lazy cat')
ORDER BY id;
----
id
1

query
SELECT id FROM pj_raw_text_idx WHERE body @@ ts_phrase('quick brown') ORDER BY id;
----
id
2

statement ok
CREATE TABLE pj_search (id BIGINT PRIMARY KEY, doc JSON)
  WITH (storage='search', compaction_interval=0);

statement ok
CREATE INDEX pj_search_idx ON pj_search USING inverted (
    (doc->'title') pj_nopos, (doc->'title') included());

statement ok
INSERT INTO pj_search VALUES
    (1, '{"title":"quick\nbrown fox"}'),
    (2, '{"title":"brown quick"}'),
    (3, '{"title":"a \"quick\" brown dog"}');

statement ok
VACUUM (REFRESH_TABLE) pj_search;

