statement ok
CREATE TEXT SEARCH DICTIONARY pj_pos AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY pj_nopos AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency);

statement ok
CREATE TABLE pj (id INTEGER PRIMARY KEY, doc JSON);

statement ok
INSERT INTO pj VALUES
    (1, '{"title":"the quick brown fox","meta":{"note":"the fox jumps over the lazy dog"}}'::json),
    (2, '{"title":"quick fox brown","meta":{"note":"a lazy old dog"}}'::json),
    (3, '{"title":"a quick red fox","meta":{"note":"the dog sleeps"}}'::json),
    (4, '{"title":null,"meta":{}}'::json),
    (5, '{"title":42}'::json),
    (6, '{"other":"quick brown"}'::json);

statement ok
CREATE INDEX pj_pos_idx ON pj USING inverted(
    id, (doc->'title') pj_pos, (doc->'meta'->>'note') pj_pos);

statement ok
CREATE INDEX pj_text_idx ON pj USING inverted(
    id,
    (doc->>'title') pj_nopos, (doc->>'title') included(),
    (doc->'meta'->>'note') pj_nopos, (doc->'meta'->>'note') included());

statement ok
CREATE INDEX pj_json_idx ON pj USING inverted(
    id, (doc->'title') pj_nopos, (doc->'title') included());

statement ok
VACUUM (REFRESH_TABLE) pj;

query
SELECT id FROM pj_pos_idx WHERE (doc->'title') @@ ts_phrase('quick brown fox');
