statement ok
CREATE TEXT SEARCH DICTIONARY opt_syn AS split_text(case := 'lower') | expand_solr_synonyms('car, auto') WITH (frequency)


statement ok
CREATE TEXT SEARCH DICTIONARY opt_pos AS split_text(case := 'lower') | expand_solr_synonyms('car, auto') WITH (frequency, position)


statement ok
CREATE TABLE opt_cars (id INTEGER PRIMARY KEY, body VARCHAR)


statement ok
INSERT INTO opt_cars VALUES (1, 'red car'), (2, 'auto parts'), (3, 'green bike'), (4, 'brown bag')


statement ok
CREATE INDEX opt_cars_idx ON opt_cars USING inverted (id, body opt_syn) INCLUDE (body)


statement ok
CREATE INDEX opt_cars_pos_idx ON opt_cars USING inverted (id, body opt_pos)


statement ok
CREATE INDEX opt_cars_bare_idx ON opt_cars USING inverted (id, body opt_syn)


statement ok
VACUUM (REFRESH_TABLE) opt_cars


