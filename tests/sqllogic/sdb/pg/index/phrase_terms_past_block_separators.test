query
SELECT count(*) FROM ptb_idx
WHERE body @@ (ts_any(list_transform(range(0, 10000), lambda i: 'w' || translate(lpad(i::TEXT, 5, '0'), '0123456789', 'abcdefghij'))) ## 'tail');
----
count
10000


query
SELECT count(*) FROM ptb_idx
WHERE body @@ (ts_any(list_transform(range(10000, 20000), lambda i: 'w' || translate(lpad(i::TEXT, 5, '0'), '0123456789', 'abcdefghij'))) ## 'tail');
----
count
10000


query
SELECT count(*) FROM ptb_idx
WHERE body @@ (ts_any(list_transform(range(20000, 30000), lambda i: 'w' || translate(lpad(i::TEXT, 5, '0'), '0123456789', 'abcdefghij'))) ## 'tail');
----
count
10000


query
SELECT count(*) FROM ptb_idx WHERE body @@ ts_phrase('tail');
----
count
30000


statement ok
DROP TABLE ptb;


statement ok
DROP TEXT SEARCH DICTIONARY ptb_dict;
