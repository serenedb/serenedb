CREATE TABLE pwp_search (id BIGINT PRIMARY KEY, body TEXT, tags TEXT[])
  WITH (storage='search', compaction_interval=0)

statement ok
CREATE INDEX pwp_search_idx ON pwp_search USING inverted (body pwp_words, tags pwp_words)

statement ok
INSERT INTO pwp_search VALUES
    (1, 'the quick brown fox', ['quick brown', 'fox']),
    (2, 'quick fox brown', ['brown', 'quick fox']),
    (3, 'a quick brown dog', [NULL, 'quick brown fox', ''])

statement ok
