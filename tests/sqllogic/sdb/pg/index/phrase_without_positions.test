CREATE TABLE pwp_zstd (id INTEGER PRIMARY KEY, body VARCHAR)

statement ok
INSERT INTO pwp_zstd SELECT i, CASE
    WHEN i % 97 = 0 THEN 'start quick brown fox end ' || i
    WHEN i % 13 = 0 THEN 'start brown quick fox end ' || i
    ELSE 'filler words only ' || i END
FROM range(1, 6001) t(i)

statement ok
CREATE INDEX pwp_zstd_idx ON pwp_zstd USING inverted (id, body pwp_words)
    INCLUDE (body included (compression = 'zstd'))

statement ok
