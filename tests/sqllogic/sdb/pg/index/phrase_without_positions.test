statement ok
CREATE TEXT SEARCH DICTIONARY pwp_synonyms AS
    split_text(case := 'lower') | expand_solr_synonyms('car, automobile, auto')
    WITH (frequency)

statement ok
CREATE TABLE pwp_cars (id INTEGER PRIMARY KEY, body VARCHAR)

statement ok
INSERT INTO pwp_cars VALUES
    (1, 'a red car here'),
    (2, 'red paint on a car'),
    (3, 'the red automobile'),
    (4, 'red auto car red car')

statement ok
CREATE INDEX pwp_cars_idx ON pwp_cars USING inverted (id, body pwp_synonyms) INCLUDE (body)

statement ok
VACUUM (REFRESH_TABLE) pwp_cars

