statement ok
CREATE TEXT SEARCH DICTIONARY pwp_words AS split_text(case := 'lower') WITH (frequency)

statement ok
CREATE TEXT SEARCH DICTIONARY pwp_words_pos AS split_text(case := 'lower') WITH (frequency, position)

statement ok
CREATE TABLE pwp_docs (id INTEGER PRIMARY KEY, body VARCHAR)

statement ok
INSERT INTO pwp_docs VALUES
    (1, 'the quick brown fox jumps over the lazy dog'),
    (2, 'quick brown dog'),
    (3, 'brown fox quick'),
    (4, 'the fox is quick and brown'),
    (5, 'quick brown cat brown fox'),
    (6, 'a quick a brown a fox'),
    (7, 'quick brown quick brown quick brown'),
    (8, 'quick quick brown brown')

statement ok
CREATE INDEX pwp_text_idx ON pwp_docs USING inverted (id, body pwp_words) INCLUDE (body)

statement ok
CREATE INDEX pwp_pos_idx ON pwp_docs USING inverted (id, body pwp_words_pos)

statement ok
CREATE INDEX pwp_bare_idx ON pwp_docs USING inverted (id, body pwp_words)

statement ok
