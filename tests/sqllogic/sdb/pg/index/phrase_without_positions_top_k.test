INSERT INTO ptk
SELECT g AS id, 7 AS n, repeat('w1 w2 ', 40 - (g - 6001) * 3) || 'w3' AS body
FROM range(6001, 6004) t(g)

statement ok
DELETE FROM ptk WHERE id IN (6000, 5500, 6002)

