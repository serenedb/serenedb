statement ok
CREATE TEXT SEARCH DICTIONARY ptk_words AS split_text() WITH (frequency, norm)

statement ok
CREATE TEXT SEARCH DICTIONARY ptk_words_pos AS split_text() WITH (frequency, position, norm)

statement ok
CREATE TABLE ptk AS
SELECT g AS id,
       (g // 250) % 10 AS n,
       'w' || (g % 3) || ' w' || (g % 5) || ' ' ||
       CASE WHEN g % 250 = 0 THEN repeat('w1 w2 ', g // 250)
            ELSE repeat('w1 w2 ', g % 3) || repeat('pad ', g % 17)
       END || 'w' || (g % 7) AS body
FROM range(1, 6001) t(g)

statement ok
CREATE INDEX ptk_text_idx ON ptk USING inverted (id, body ptk_words) INCLUDE (body, n)
    WITH (optimize_top_k = 'bm25(1.2, 0.75)')

statement ok
CREATE INDEX ptk_pos_idx ON ptk USING inverted (id, body ptk_words_pos) INCLUDE (n)
    WITH (optimize_top_k = 'bm25(1.2, 0.75)')

statement ok
VACUUM (REFRESH_TABLE) ptk

query
EXPLAIN SELECT id FROM ptk_text_idx WHERE body @@ ts_phrase('w1 w2')
ORDER BY BM25(ptk_text_idx.tableoid) DESC LIMIT 5
----
QUERY PLAN
╭─ IRESEARCH_SCAN ──────────────────────────╮
│ Index: ptk_text_idx                       │
│ Lookup: table                             │
│ Index Filter:                             │
│ ╭─ Phrase ──────────────────────────────╮ │
│ │ Field: body(string)                   │ │
│ │ Parts: Term:w1(0, 0); Term:w2(1, 1);  │ │
│ │ Verify: inline                        │ │
│ ╰───────────────────────────────────────╯ │
│ Score: bm25(k1=1.2, b=0.75)               │
│ Top: 5, optimized                         │
│ Projections: id                           │
│ ~1,200 rows                               │
╰───────────────────────────────────────────╯

