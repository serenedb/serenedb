statement ok
CREATE TYPE pit_mood AS ENUM ('sad', 'ok', 'happy');


statement ok
CREATE TABLE pit (id INT, amt DECIMAL(10, 2), u UUID, m pit_mood, d DECIMAL(38, 10));


statement ok
