statement ok
INSERT INTO pit VALUES (3, 30.75, '00000000-0000-0000-0000-000000000003', 'sad', 3.5);


query
SELECT indexname, indexdef FROM pg_indexes WHERE tablename = 'pit' ORDER BY indexname;
----
indexname	indexdef
pit_amt_idx	CREATE INDEX pit_amt_idx ON public.pit USING inverted (amt)
pit_amt_uidx	CREATE UNIQUE INDEX pit_amt_uidx ON public.pit USING inverted (amt)
pit_mix_idx	CREATE INDEX pit_mix_idx ON public.pit USING inverted (id, u, m, d)


query
SELECT id FROM pit_mix_idx WHERE m = 'happy' AND u = '00000000-0000-0000-0000-000000000002';
----
id
2


query
SELECT id FROM pit WHERE amt BETWEEN 20 AND 31 ORDER BY id;
