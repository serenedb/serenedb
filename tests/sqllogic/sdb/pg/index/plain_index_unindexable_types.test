  (2, 20.25, '00000000-0000-0000-0000-000000000002', 'happy', 2.5);


statement ok
CREATE INDEX pit_amt_idx ON pit (amt);


statement ok
CREATE INDEX pit_mix_idx ON pit (id, u, m, d);


statement ok
