statement ok
CREATE TEXT SEARCH DICTIONARY pq_syn AS
    split_text(case := 'lower') | expand_solr_synonyms('car => automobile, auto')
    WITH (frequency, position)


statement ok
CREATE TABLE pq_docs (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
INSERT INTO pq_docs VALUES
    (1, 'red automobile'),
    (2, 'red auto'),
    (3, 'red car'),
    (4, 'blue car'),
    (5, 'car red');


statement ok
CREATE INDEX pq_idx ON pq_docs USING inverted (id, body pq_syn)
  WITH (compaction_interval = 0);


statement ok
VACUUM (REFRESH_TABLE) pq_docs;


query
SELECT ts_lexize('pq_syn', 'red car') AS tokens;
----
tokens
{red,auto,automobile}


query
EXPLAIN SELECT id FROM pq_idx WHERE body @@ plainto_tsquery('red car');
