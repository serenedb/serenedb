control substitution on

# REFRESH x iceberg cross-matrix: format (v2/v3) x mutation kind (append,
# row delete, whole-file delete, whole-table delete, cross-file delete,
# update, chained updates, reinsert, file born dead) x refresh cadence (one
# op per refresh vs several snapshots batched into one refresh). Every case
# asserts the action row, the visible content, and convergence (the next
# refresh is up_to_date). Background compaction is disabled per index
# (compaction_interval=0): a staged merge makes a delta legitimately degrade
# to rebuild, which would make these expectations nondeterministic.

statement ok
CREATE OR REPLACE PERSISTENT SECRET mx_${__DATABASE__} (
  TYPE S3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/warehouse/${__DATABASE__}/'
);

statement ok
SET s3_use_ssl=false;

statement ok
SET GLOBAL unsafe_enable_version_guessing=true;

statement ok
DETACH DATABASE IF EXISTS mx_${__DATABASE__};

statement ok
ATTACH '${ICEBERG_WAREHOUSE}' AS mx_${__DATABASE__} (
  TYPE ICEBERG,
  ENDPOINT '${ICEBERG_REST_URL}',
  AUTHORIZATION_TYPE 'none'
);

statement ok
CREATE TEXT SEARCH DICTIONARY mx_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA mx_${__DATABASE__}.${__DATABASE__};

statement ok
SET search_path TO public, mx_${__DATABASE__}.${__DATABASE__};

# ---- v2: several snapshots (append + delete + update) batched into ONE
# refresh: the added files scan, the delete-targeted file prunes.

statement ok
CREATE TABLE mx_${__DATABASE__}.${__DATABASE__}.mx2 (id INTEGER, body TEXT);

statement count 2
INSERT INTO mx2 VALUES (1, 'pudge alpha'), (2, 'anchin alpha');

statement count 1
INSERT INTO mx2 VALUES (3, 'vedernikoff beta');

statement ok
CREATE VIEW mx2_v AS SELECT * FROM iceberg_scan(
  's3://${MINIO_BUCKET}/warehouse/${__DATABASE__}/mx2',
  allow_moved_paths=true);

statement ok
CREATE INDEX mx2_idx ON mx2_v USING inverted(id, body mx_en) WITH (compaction_interval=0);

query
SELECT action FROM serenedb_reindex('mx2_idx');
----
action
up_to_date

statement count 1
INSERT INTO mx2 VALUES (4, 'techies gamma');

statement ok
DELETE FROM mx2 WHERE id = 2;

statement ok
UPDATE mx2 SET body = 'pudge prime' WHERE id = 1;

query
SELECT * FROM serenedb_reindex('mx2_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	2	1	0	0

query
SELECT count(*) FROM mx2_idx;
----
count
3

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('alpha');
----
count
0

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('prime');
----
count
1

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('vedernikoff');
----
count
1

query
SELECT action FROM serenedb_reindex('mx2_idx');
----
action
up_to_date

# ---- v2: kill a whole file's rows, then every remaining row of the table,
# then reinsert into the empty table.

statement ok
DELETE FROM mx2 WHERE id = 3;

query
SELECT * FROM serenedb_reindex('mx2_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	0	1	0	0

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('vedernikoff');
----
count
0

query
SELECT count(*) FROM mx2_idx;
----
count
2

statement ok
DELETE FROM mx2 WHERE id IN (1, 4);

query
SELECT * FROM serenedb_reindex('mx2_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	0	2	0	0

query
SELECT count(*) FROM mx2_idx;
----
count
0

statement count 1
INSERT INTO mx2 VALUES (5, 'pudge reborn');

query
SELECT * FROM serenedb_reindex('mx2_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

query
SELECT count(*) FROM mx2_idx;
----
count
1

query
SELECT action FROM serenedb_reindex('mx2_idx');
----
action
up_to_date

# ---- v2: the SAME row updated twice between refreshes: the intermediate
# file arrives already dead (its delete applies during its own scan).

statement ok
UPDATE mx2 SET body = 'pudge encore' WHERE id = 5;

statement ok
UPDATE mx2 SET body = 'pudge finale' WHERE id = 5;

query
SELECT * FROM serenedb_reindex('mx2_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	2	1	0	0

query
SELECT count(*) FROM mx2_idx;
----
count
1

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('finale');
----
count
1

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('encore');
----
count
0

query
SELECT count(*) FROM mx2_idx WHERE body @@ ts_phrase('reborn');
----
count
0

query
SELECT action FROM serenedb_reindex('mx2_idx');
----
action
up_to_date

# ---- v2: deletes from DIFFERENT snapshots hitting DIFFERENT files, one
# refresh prunes both.

statement ok
CREATE TABLE mx_${__DATABASE__}.${__DATABASE__}.mx2b (id INTEGER, body TEXT);

statement count 2
