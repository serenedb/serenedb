# ---- a file born and killed between two refreshes: it arrives as an ADDED
# file whose own deletes apply during its scan -- zero live docs, still a
# manifest entry.

statement ok
CREATE TABLE mx_${__DATABASE__}.${__DATABASE__}.mx2c (id INTEGER, body TEXT);

statement count 1
INSERT INTO mx2c VALUES (1, 'pudge lone');

statement ok
CREATE VIEW mx2c_v AS SELECT * FROM iceberg_scan(
  's3://${MINIO_BUCKET}/warehouse/${__DATABASE__}/mx2c',
  allow_moved_paths=true);

statement ok
CREATE INDEX mx2c_idx ON mx2c_v USING inverted(id, body mx_en) WITH (compaction_interval=0);

statement count 1
INSERT INTO mx2c VALUES (2, 'anchin doomed');

