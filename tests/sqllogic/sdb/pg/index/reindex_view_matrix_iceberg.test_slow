query
SELECT action FROM serenedb_reindex('mx2b_idx');
----
action
up_to_date

# ---- v2 partitioned: per-file attribution holds inside partitions; appends
# and deletes stay partition-local deltas.

statement ok
CREATE TABLE mx_${__DATABASE__}.${__DATABASE__}.mxp (part TEXT, id INTEGER, body TEXT);

statement ok
ALTER TABLE mx_${__DATABASE__}.${__DATABASE__}.mxp SET PARTITIONED BY (part);

statement count 3
INSERT INTO mxp VALUES
  ('a', 1, 'pudge east'),
  ('a', 2, 'anchin east'),
  ('b', 3, 'vedernikoff west');

statement ok
CREATE VIEW mxp_v AS SELECT * FROM iceberg_scan(
  's3://${MINIO_BUCKET}/warehouse/${__DATABASE__}/mxp',
  allow_moved_paths=true);

statement ok
CREATE INDEX mxp_idx ON mxp_v USING inverted(id, body mx_en) WITH (compaction_interval=0);

statement ok
DELETE FROM mxp WHERE id = 2;

query
SELECT * FROM serenedb_reindex('mxp_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	0	1	0	0

query
SELECT count(*) FROM mxp_idx WHERE body @@ ts_phrase('east');
----
count
1

query
SELECT count(*) FROM mxp_idx WHERE body @@ ts_phrase('west');
----
count
1

statement count 1
INSERT INTO mxp VALUES ('b', 4, 'techies west');

query
SELECT * FROM serenedb_reindex('mxp_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

query
SELECT count(*) FROM mxp_idx;
----
count
3

query
SELECT action FROM serenedb_reindex('mxp_idx');
----
action
up_to_date

# ---- v3 (deletion vectors): the same batched multi-op, chained updates and
# cross-file deletes, all through DVs.

statement ok
CREATE TABLE mx_${__DATABASE__}.${__DATABASE__}.mx3 (id INTEGER, body TEXT) WITH ('format-version' = 3);

statement count 2
INSERT INTO mx3 VALUES (1, 'pudge iii'), (2, 'anchin iii');

statement count 1
INSERT INTO mx3 VALUES (3, 'vedernikoff iii');

