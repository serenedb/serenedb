# ---- residue: nothing server-global may leak into later tests.

statement ok
DROP VIEW mx2_v;

statement ok
DROP VIEW mx2b_v;

statement ok
DROP VIEW mxp_v;

statement ok
DROP VIEW mx3_v;

statement ok
DROP VIEW mx2c_v;

statement ok
DETACH DATABASE mx_${__DATABASE__};

statement ok
DROP PERSISTENT SECRET mx_${__DATABASE__};

statement ok
RESET GLOBAL unsafe_enable_version_guessing;
