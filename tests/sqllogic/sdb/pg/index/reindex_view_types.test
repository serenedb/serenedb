control substitution on

# Typed keys through a delta: numbers, dates, timestamps, booleans, NULLs and
# the empty string index and read back the same way after a pass as after
# CREATE INDEX. DECIMAL is not a key type; the view still reads it back.

statement ok
CREATE TEXT SEARCH DICTIONARY rvty_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

system ok
mkdir -p $__TEST_DIR__/rvty

statement count 1
COPY (SELECT 1::BIGINT AS id, 1.5::DOUBLE AS score, 10.25::DECIMAL(10,2) AS price,
             DATE '2024-01-01' AS day, TIMESTAMP '2024-01-01 10:00:00' AS ts, true AS flag,
             'pudge goes mid' AS body)
TO '${__TEST_DIR__}/rvty/a.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW rvty_v AS SELECT * FROM read_parquet('${__TEST_DIR__}/rvty/*.parquet');

statement ok
CREATE INDEX rvty_idx ON rvty_v USING inverted(id, score, day, ts, flag, body rvty_en);

statement count 2
COPY (SELECT 2::BIGINT AS id, NULL::DOUBLE AS score, 99.99::DECIMAL(10,2) AS price,
             DATE '2024-02-29' AS day, NULL::TIMESTAMP AS ts, false AS flag, '' AS body
      UNION ALL
      SELECT 3, -0.5, NULL, NULL, TIMESTAMP '2030-12-31 23:59:59', NULL, NULL)
TO '${__TEST_DIR__}/rvty/b.parquet' (FORMAT PARQUET);

query
SELECT * FROM serenedb_reindex('rvty_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	1	0	0	0

query
SELECT * FROM rvty_idx ORDER BY id;
----
id	score	price	day	ts	flag	body
1	1.5	10.25	2024-01-01	2024-01-01 10:00:00	t	pudge goes mid
2	NULL	99.99	2024-02-29	NULL	f	(empty)
3	-0.5	NULL	NULL	2030-12-31 23:59:59	NULL	NULL

query
SELECT
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE day = DATE '2024-02-29') AS day_eq,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE ts > TIMESTAMP '2029-01-01') AS ts_gt,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE score < 0) AS score_lt,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE flag = false) AS flag_false;
----
day_eq	ts_gt	score_lt	flag_false
2	3	3	2

query
SELECT
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE score IS NULL) AS score_null,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE day IS NULL) AS day_null,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE body = '') AS body_empty,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE body IS NULL) AS body_null;
----
score_null	day_null	body_empty	body_null
2	3	2	3

query
SELECT count(*) FROM ((SELECT * FROM rvty_v EXCEPT SELECT * FROM rvty_idx)
                      UNION ALL (SELECT * FROM rvty_idx EXCEPT SELECT * FROM rvty_v));
----
count
0

# A rewrite moves every key of the file at once.
statement count 1
COPY (SELECT 1::BIGINT AS id, 2.5::DOUBLE AS score, 11.00::DECIMAL(10,2) AS price,
             DATE '2025-06-15' AS day, TIMESTAMP '2025-06-15 08:30:00' AS ts, false AS flag,
             'pudge goes top' AS body)
TO '${__TEST_DIR__}/rvty/a.parquet' (FORMAT PARQUET);

query
SELECT * FROM serenedb_reindex('rvty_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
delta	0	1	0	1

query
SELECT
  (SELECT count(*) FROM rvty_idx WHERE day = DATE '2024-01-01') AS old_day,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE day = DATE '2025-06-15') AS new_day,
  (SELECT string_agg(id::text, ',' ORDER BY id) FROM rvty_idx WHERE flag = false) AS flag_false,
  (SELECT count(*) FROM rvty_idx WHERE body @@ ts_phrase('mid')) AS old_body;
----
old_day	new_day	flag_false	old_body
0	1	1,2	0

query
SELECT count(*) FROM ((SELECT * FROM rvty_v EXCEPT SELECT * FROM rvty_idx)
                      UNION ALL (SELECT * FROM rvty_idx EXCEPT SELECT * FROM rvty_v));
----
count
0

statement ok
DROP INDEX rvty_idx;

statement ok
DROP VIEW rvty_v;

statement ok
DROP TEXT SEARCH DICTIONARY rvty_en;
