# A merge spreads its columns and postings over the session's threads; the
# rows and search results are the same with one thread and with several.
statement ok
CREATE TABLE sdbc_par (id INT PRIMARY KEY, body TEXT, n BIGINT, x DOUBLE,
                       flag BOOLEAN, label TEXT)
WITH (storage = 'search', compaction_interval = 0)


statement ok
INSERT INTO sdbc_par
SELECT i, CASE WHEN i % 2 = 0 THEN 'fox dog' ELSE 'owl cat' END, i * 3,
       i / 4.0, i % 3 = 0, 'L' || (i % 7)
FROM generate_series(1, 50000) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc_par


statement ok
INSERT INTO sdbc_par
SELECT i, CASE WHEN i % 2 = 0 THEN 'fox dog' ELSE 'owl cat' END, i * 3,
       i / 4.0, i % 3 = 0, 'L' || (i % 7)
FROM generate_series(50001, 100000) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc_par


statement ok
INSERT INTO sdbc_par
SELECT i, CASE WHEN i % 2 = 0 THEN 'fox dog' ELSE 'owl cat' END, i * 3,
       i / 4.0, i % 3 = 0, 'L' || (i % 7)
FROM generate_series(100001, 150000) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc_par


statement ok
INSERT INTO sdbc_par
SELECT i, CASE WHEN i % 2 = 0 THEN 'fox dog' ELSE 'owl cat' END, i * 3,
       i / 4.0, i % 3 = 0, 'L' || (i % 7)
FROM generate_series(150001, 200000) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc_par


