query
SELECT merge, outcome, len(inputs) AS inputs, input_docs, input_live_docs,
       output_docs, output IS NOT NULL AS has_output, total_ms >= 0 AS timed,
       error
FROM sdb_compact('sdbc', mode := 'compact', target_segments := 2)
ORDER BY merge
----
merge	outcome	inputs	input_docs	input_live_docs	output_docs	has_output	timed	error
1	merged	2	200	200	200	t	t	NULL
2	merged	2	200	200	200	t	t	NULL


