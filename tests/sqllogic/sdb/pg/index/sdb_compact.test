statement ok
INSERT INTO sdbc_plan
SELECT i, [i::FLOAT, 3::FLOAT, 4::FLOAT]::FLOAT[3], 'cat'
FROM generate_series(201, 300) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc_plan


