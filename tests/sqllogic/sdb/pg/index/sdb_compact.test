# The planner keeps a group of one segment without deletes as it is, merges a
# listed segment only when there is something to merge, and leaves a segment
# out of a background round when the tier policy picks nothing.

statement ok
CREATE TABLE sdbc_plan (id BIGINT PRIMARY KEY, vec FLOAT[3], body TEXT)
WITH (storage = 'search', compaction_interval = 0)


statement ok
CREATE INDEX sdbc_plan_hnsw ON sdbc_plan
USING inverted (vec hnsw(metric='l2', quant='none'))


statement ok
INSERT INTO sdbc_plan
SELECT i, [i::FLOAT, 1::FLOAT, 2::FLOAT]::FLOAT[3], 'fox'
FROM generate_series(1, 100) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc_plan


statement ok
INSERT INTO sdbc_plan
SELECT i, [i::FLOAT, 2::FLOAT, 3::FLOAT]::FLOAT[3], 'owl'
FROM generate_series(101, 200) s(i)


statement ok
