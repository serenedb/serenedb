# CALL sdb_compact merges segments of a search table or an inverted index on
# demand, EXPLAIN shows what it would merge, sdb_segments lists the segments and
# sdb_merge_history keeps finished merges. Background compaction is off for the
# tables that get merged here, so every merge in this file comes from
# sdb_compact or VACUUM.

statement ok
SET profiling_renderer_settings = {'deterministic': true}


statement ok
CREATE TABLE sdbc (id INT PRIMARY KEY, body TEXT)
WITH (storage = 'search', compaction_interval = 0)


statement ok
INSERT INTO sdbc SELECT i, 'fox dog' FROM generate_series(1, 100) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc


statement ok
INSERT INTO sdbc SELECT i, 'fox cat' FROM generate_series(101, 200) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc


statement ok
INSERT INTO sdbc SELECT i, 'owl dog' FROM generate_series(201, 300) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc


statement ok
INSERT INTO sdbc SELECT i, 'owl cat' FROM generate_series(301, 400) s(i)


statement ok
VACUUM (REFRESH_TABLE) sdbc


query
SELECT count(*) AS segments, sum(docs) AS docs, sum(live_docs) AS live,
       sum(deleted_docs) AS deleted, bool_and(bytes > 0) AS sized,
       bool_and(rowid_min <= rowid_max) AS rowids
FROM sdb_segments('sdbc')
----
segments	docs	live	deleted	sized	rowids
4	400	400	0	t	t


