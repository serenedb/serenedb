CREATE TABLE reenc (id INT PRIMARY KEY, body TEXT USING COMPRESSION uncompressed, tags INT[], meta STRUCT(k INT), pair INT[2])
WITH (storage = 'search', compaction_interval = 0, row_group_size = 2048)


statement ok
INSERT INTO reenc
SELECT i, 'request ' || (i % 50) || ' handled by checkout in ' || (i % 7) || ' ms', [i, i + 1], {'k': i % 3}, [i % 5, i % 7]::INT[2]
FROM generate_series(1, 8192) s(i)


statement ok
VACUUM (REFRESH_TABLE) reenc


query
SELECT "column", type, rows, codecs, verdict
FROM sdb_segments('reenc', columns := true)
WHERE "column" IN ('body', 'meta', 'pair', 'tags')
ORDER BY "column"
----
column	type	rows	codecs	verdict
body	VARCHAR	8192	Uncompressed	copy
meta	STRUCT(k INTEGER)	8192	NULL	NULL
pair	INTEGER[2]	8192	NULL	NULL
tags	INTEGER[]	8192	Sequence	NULL


query
SELECT count(*) AS columns,
       count(*) FILTER (WHERE bytes > 0) AS sized,
       count(*) FILTER (WHERE reencoded_bytes IS NULL) AS unchecked
FROM sdb_segments('reenc', columns := true)
----
columns	sized	unchecked
6	6	3


