query
SELECT event, type, relation_id = (SELECT oid FROM pg_class WHERE relname = 'sdbms') AS same,
       segment, inputs, docs, rowid_min, rowid_max, segments, overlap
FROM sdb_merge_simulate((
  SELECT * FROM sdb_compact_history
  WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'sdbms')),
  threads := 1)
ORDER BY event
