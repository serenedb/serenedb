query
SELECT event, round(time_s, 3) AS time_s, type, relation_id, segment, inputs,
       docs, live_docs, bytes, input_bytes, rowid_min, rowid_max,
       round(started_s, 3) AS started_s, segments, round(overlap, 3) AS overlap,
       merges_queued, merges_running
FROM sdb_merge_simulate((
  SELECT TIMESTAMPTZ '2026-01-01 00:00:00+00' + t * INTERVAL '1 second' AS finished,
         r AS relation_id, 100 AS output_docs, l AS output_live_docs,
         1048576 AS output_bytes, lo AS rowid_min, hi AS rowid_max
  FROM (VALUES (0, 1, 100, 1, 100), (0, 1, 50, 51, 150),
               (1, 2, 100, NULL, NULL), (1, 2, 100, NULL, NULL)) v(t, r, l, lo, hi)),
  threads := 1, merge_bytes_per_second := 1048576, compaction_max_segments := 2)
ORDER BY event
----
event	time_s	type	relation_id	segment	inputs	docs	live_docs	bytes	input_bytes	rowid_min	rowid_max	started_s	segments	overlap	merges_queued	merges_running
1	0	flush	1	_1	NULL	100	100	1048576	NULL	1	100	NULL	1	1	0	0
2	0	flush	1	_2	NULL	100	50	1048576	NULL	51	150	NULL	2	1.333	0	1
3	1	flush	2	_1	NULL	100	100	1048576	NULL	NULL	NULL	NULL	1	NULL	0	1
4	1	flush	2	_2	NULL	100	100	1048576	NULL	NULL	NULL	NULL	2	NULL	1	1
5	1.5	merge	1	_3	{_1,_2}	150	150	1572864	2097152	1	150	0	1	1	0	1
6	3.5	merge	2	_3	{_1,_2}	200	200	2097152	2097152	NULL	NULL	1.5	1	NULL	0	0


