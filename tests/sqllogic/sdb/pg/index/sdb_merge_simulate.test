merge	1


query
WITH s AS (
  SELECT * FROM sdb_merge_simulate((
    SELECT TIMESTAMPTZ '2026-01-01 00:00:00+00' + i * INTERVAL '1 second' AS finished,
           1000 AS output_docs, 1048576 AS output_bytes
    FROM generate_series(0, 5) s(i)),
    threads := 1))
SELECT (SELECT count(*) FROM s WHERE type = 'flush') AS flushes,
       (SELECT count(*) FROM s WHERE type = 'merge') AS merges
