query
SELECT event, round(time_s, 3) AS time_s, type, relation_id, segment, inputs,
       docs, bytes, round(queued_s, 3) AS queued_s,
       round(started_s, 3) AS started_s, threads, lane, segments, overlap,
       merges_queued, merges_running
FROM sdb_merge_simulate((
  SELECT TIMESTAMPTZ '2026-01-01 00:00:00+00' + i * INTERVAL '1 second' AS finished,
         1000 AS output_docs, 1048576 AS output_bytes
  FROM generate_series(0, 5) s(i)),
  threads := 1, merge_bytes_per_second := 1048576)
ORDER BY event
