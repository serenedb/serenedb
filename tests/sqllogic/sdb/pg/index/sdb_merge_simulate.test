query
SELECT s.type, count(*) AS events
FROM sdb_merge_simulate((
  SELECT TIMESTAMPTZ '2026-01-01 00:00:00+00' + i * INTERVAL '1 second' AS finished,
         1000 AS output_docs, 1048576 AS output_bytes
  FROM generate_series(0, 5) s(i)),
  threads := 1) s
JOIN (VALUES ('flush'), ('merge')) k(type) ON s.type = k.type
GROUP BY s.type
ORDER BY s.type
