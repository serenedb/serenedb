query
SELECT count(*) AS n, count(*) FILTER (WHERE f.s <> u.s) AS changed
FROM (SELECT id, BM25(t1.tableoid) AS s FROM sspr_sparse t1
      WHERE body @@ ts_any(['a', 'b']) AND NOT body @@ 'c' AND g = 0) f
JOIN (SELECT id, BM25(t2.tableoid) AS s FROM sspr_sparse t2
      WHERE body @@ ts_any(['a', 'b']) AND NOT body @@ 'c') u USING (id)
----
n	changed
456	0


query
SELECT count(*) AS n, count(*) FILTER (WHERE f.s <> u.s) AS changed
FROM (SELECT id, BM25(t1.tableoid) AS s FROM sspr_sparse t1
      WHERE NOT body @@ 'z' AND g = 0) f
JOIN (SELECT id, BM25(t2.tableoid) AS s FROM sspr_sparse t2
      WHERE NOT body @@ 'z') u USING (id)
----
n	changed
