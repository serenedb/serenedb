# --- IVF: DROP INDEX and CREATE INDEX in one transaction ---

statement ok
CREATE TABLE rq_tx (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rq_tx_idx ON rq_tx
  USING inverted(id, emb ivf (metric = 'l2', quant = 'sq8'));

statement ok
INSERT INTO rq_tx SELECT * FROM rq_ref WHERE id < 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_tx;

statement ok
INSERT INTO rq_tx SELECT * FROM rq_ref WHERE id >= 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_tx;

statement ok
BEGIN;

statement ok
DROP INDEX rq_tx_idx;

statement ok
CREATE INDEX rq_tx_idx ON rq_tx
  USING inverted(id, emb ivf (metric = 'l2', quant = 'pq', pq_m = 8));

statement ok
COMMIT;

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_tx ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)) t;
----
hits
10

# --- Two IVF indexes on one column, each with its own quantization ---

statement ok
CREATE TABLE rq_two (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
INSERT INTO rq_two SELECT * FROM rq_ref WHERE id < 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_two;

statement ok
INSERT INTO rq_two SELECT * FROM rq_ref WHERE id >= 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_two;

statement ok
CREATE INDEX rq_two_sq8 ON rq_two
  USING inverted(id, emb ivf (metric = 'l2', quant = 'sq8'));

statement ok
CREATE INDEX rq_two_pq ON rq_two
  USING inverted(id, emb ivf (metric = 'l2', quant = 'pq', pq_m = 8));

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_two_sq8 ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)) t;
----
hits
10

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_two_pq ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)) t;
----
hits
10

statement ok
VACUUM (COMPACT_TABLE) rq_two;

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_two_pq ORDER BY emb <-> rq_vec(2500.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(2500.5) LIMIT 10)) t;
----
hits
10

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_two_sq8 ORDER BY emb <-> rq_vec(2500.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(2500.5) LIMIT 10)) t;
----
hits
10

# --- A transaction that still sees the replaced index reads it after a merge ---

statement ok
CREATE TABLE rq_snap_ivf (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rq_snap_ivf_idx ON rq_snap_ivf
  USING inverted(id, emb ivf (metric = 'l2', quant = 'sq8'));

statement ok
CREATE TABLE rq_snap_hnsw (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rq_snap_hnsw_idx ON rq_snap_hnsw
  USING inverted(id, emb hnsw (metric = 'l2', quant = 'sq8'));

statement ok
CREATE TABLE rq_snap_other (id INTEGER);

statement ok
INSERT INTO rq_snap_ivf SELECT * FROM rq_ref WHERE id < 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_snap_ivf;

statement ok
INSERT INTO rq_snap_ivf SELECT * FROM rq_ref WHERE id >= 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_snap_ivf;

statement ok
INSERT INTO rq_snap_hnsw SELECT * FROM rq_ref WHERE id < 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_snap_hnsw;

statement ok
INSERT INTO rq_snap_hnsw SELECT * FROM rq_ref WHERE id >= 1500;

statement ok
VACUUM (REFRESH_TABLE) rq_snap_hnsw;

connection reader
statement ok
SET sdb_ivf_search_nprobe = 1000;

connection reader
statement ok
SET sdb_hnsw_ef_search = 2000;

connection reader
statement ok
SET sdb_ann_rescore_width = 100;

connection reader
statement ok
BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ;

connection reader
query
SELECT count(*) AS n FROM rq_snap_other;
----
n
0

connection pinned
statement ok
SET sdb_ivf_search_nprobe = 1000;

connection pinned
statement ok
SET sdb_hnsw_ef_search = 2000;

connection pinned
statement ok
SET sdb_ann_rescore_width = 100;

