# CREATE OR REPLACE INDEX that changes the quantization of a vector index on a
# populated search table: ANN queries return the exact neighbours before the
# replace, after it, and after a compaction.

statement ok
CREATE MACRO rq_vec(i) AS
  list_transform(range(16),
                 j -> (sin(i * 0.0137 * (j % 5 + 1) + j * 0.71))::FLOAT)::FLOAT[16];

statement ok
CREATE TABLE rq_ref (id INTEGER PRIMARY KEY, emb FLOAT[16]);

statement ok
INSERT INTO rq_ref SELECT i, rq_vec(i) FROM range(3000) t(i);

statement ok
SET sdb_ivf_search_nprobe = 1000;

statement ok
SET sdb_hnsw_ef_search = 2000;

statement ok
SET sdb_ann_rescore_width = 100;

# --- IVF: sq8 -> pq ---

statement ok
CREATE TABLE rq_ivf (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX rq_ivf_idx ON rq_ivf
  USING inverted(id, emb ivf (metric = 'l2', quant = 'sq8'));

statement ok
INSERT INTO rq_ivf SELECT * FROM rq_ref WHERE id < 1000;

statement ok
VACUUM (REFRESH_TABLE) rq_ivf;

statement ok
INSERT INTO rq_ivf SELECT * FROM rq_ref WHERE id >= 1000 AND id < 2000;

statement ok
VACUUM (REFRESH_TABLE) rq_ivf;

statement ok
INSERT INTO rq_ivf SELECT * FROM rq_ref WHERE id >= 2000;

statement ok
VACUUM (REFRESH_TABLE) rq_ivf;

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_ivf ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)) t;
----
hits
10

statement ok
CREATE OR REPLACE INDEX rq_ivf_idx ON rq_ivf
  USING inverted(id, emb ivf (metric = 'l2', quant = 'pq', pq_m = 8));

query
EXPLAIN SELECT id FROM rq_ivf ORDER BY emb <-> rq_vec(1234.5) LIMIT 10;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────╮
│ Index: rq_ivf                      │
│ Lookup: search                     │
│ Score: l2_distance(emb, FLOAT[16]) │
│ Top: 10                            │
│ Projections: id                    │
│ ~3,000 rows                        │
╰────────────────────────────────────╯

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_ivf ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)) t;
----
hits
10

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_ivf ORDER BY emb <-> rq_vec(2500.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(2500.5) LIMIT 10)) t;
----
hits
10

statement ok
VACUUM (COMPACT_TABLE) rq_ivf;

query
SELECT count(DISTINCT row_group_id) AS segments
FROM pragma_storage_info('rq_ivf') WHERE column_name = 'id';
----
segments
1

query
SELECT count(*) AS hits FROM (
  (SELECT id FROM rq_ivf ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)
  INTERSECT (SELECT id FROM rq_ref ORDER BY emb <-> rq_vec(1234.5) LIMIT 10)) t;
----
hits
10

