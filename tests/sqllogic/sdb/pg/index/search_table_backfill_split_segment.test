CREATE TABLE bss (id BIGINT, tag TEXT)
  WITH (compaction_interval = 0, row_group_size = 8192);

statement ok
INSERT INTO bss SELECT i, CASE WHEN i % 3 = 0 THEN 'fizz' ELSE 'buzz' END FROM range(0, 60000) r(i);

statement ok
VACUUM (FLUSH_TABLE) bss;

statement ok
SET threads = 4;

statement ok
