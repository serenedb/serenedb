relname	reloptions
bsz_default	{compaction_interval=0}
bsz_small	{compaction_interval=0,block_size=16384}


query
SELECT (SELECT string_agg(DISTINCT compression, ',') FROM pragma_storage_info('bsz_small') WHERE column_name = 'id') AS small,
       (SELECT string_agg(DISTINCT compression, ',') FROM pragma_storage_info('bsz_default') WHERE column_name = 'id') AS default_size;
----
small	default_size
Uncompressed	BitPacking


query
