SET threads = 1;

statement ok
CREATE TABLE cc (id BIGINT, n INTEGER, d DOUBLE, s VARCHAR, flag BOOLEAN, note VARCHAR)
  WITH (compaction_interval = 0, row_group_size = 2048);

statement ok
INSERT INTO cc SELECT i, i % 97, i / 7.0, 'string value number ' || i, i % 2 = 0,
    CASE WHEN i % 5 = 0 THEN NULL ELSE 'n' || (i % 11) END
  FROM range(0, 5000) r(i);

statement ok
VACUUM (FLUSH_TABLE) cc;

statement ok
INSERT INTO cc SELECT i, i % 97, i / 7.0, 'string value number ' || i, i % 2 = 0, NULL
  FROM range(5000, 11000) r(i);

statement ok
VACUUM (FLUSH_TABLE) cc;

statement ok
INSERT INTO cc SELECT i, i % 97, i / 7.0, 'string value number ' || i, i % 2 = 0, 'small' || (i % 3)
  FROM range(11000, 12000) r(i);

statement ok
VACUUM (FLUSH_TABLE) cc;

statement ok
INSERT INTO cc SELECT i, i % 97, i / 7.0, 'string value number ' || i, i % 2 = 0, 'big' || (i % 4)
  FROM range(12000, 16000) r(i);

statement ok
VACUUM (FLUSH_TABLE) cc;

statement ok
DELETE FROM cc WHERE id BETWEEN 12000 AND 15999 AND id % 3 = 0;

