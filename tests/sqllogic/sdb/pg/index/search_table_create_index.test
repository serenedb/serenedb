# CREATE INDEX on search tables (storage-less inverted index). A search-table
# index carries no separate iresearch store -- it folds its columns into the
# table's own store, giving each (index, column) its own term field carrying
# that index's declared analyzer. Predicates push down only through a direct
# index scan (SELECT ... FROM <idx>), matching a transactional inverted index:
# the bare table scan pushes down PRIMARY KEY predicates and falls back to a
# columnstore Column Filter for any other column, and a bare @@ on a non-PK
# column errors. A direct index scan (SELECT * FROM <idx>) still returns every
# column off the columnstore. The index is a real catalog object (shows in
# pg_indexes, DROPs, survives restart). Non-inverted types are rejected.
# Search tables are commit-time-only, so rows are observed after
# VACUUM (REFRESH_TABLE).
#
# Indexing a POPULATED table is supported: the build rewrites the existing
# segments to carry the new term field. Only the reachability of already-stored
# rows is asserted here -- search_table_backfill.test covers the mechanism.

statement ok
CREATE TABLE t (id BIGINT PRIMARY KEY, tag TEXT, body TEXT)
  WITH (storage='search', compaction_interval=0);

# CREATE INDEX on an empty search table succeeds (metadata-only, no backfill).
statement ok
CREATE INDEX t_tag_idx ON t USING inverted (tag);

# A non-inverted index type is rejected.
statement error
CREATE INDEX t_bad_idx ON t (tag);
----
db error: ERROR: only inverted indexes are supported on a search-backed table


# The index is a real catalog object.
query
SELECT indexname FROM pg_indexes WHERE tablename = 't' ORDER BY indexname;
----
indexname
t_pkey
t_tag_idx

statement ok
INSERT INTO t VALUES
  (1, 'red', 'the quick brown fox'),
  (2, 'blue', 'lazy dog jumps'),
  (3, 'red', 'fox runs fast');

statement ok
VACUUM (REFRESH_TABLE) t;

# CREATE INDEX on a now-non-empty search table: the rows published before the
# index are rebuilt into it. Note this leaves `t` with three indexed columns
# (id, tag, body), which is a shape DML currently cannot handle -- keep the
# assertions below reads-only, and see search_table_backfill.test's header.
statement ok
CREATE INDEX t_body_idx ON t USING inverted (body);

# No analyzer on `body`, so the index terms the whole value: the pre-existing
# row is reachable under its full text...
query
SELECT id FROM t_body_idx WHERE body @@ 'fox runs fast' ORDER BY id;
----
id
3

# ...and not under a single word out of it.
query
SELECT id FROM t_body_idx WHERE body @@ 'fox' ORDER BY id;
----
id

# The second build left the first index's postings intact.
query
SELECT id FROM t_tag_idx WHERE tag = 'red' ORDER BY id;
----
id
1
3

# A build has to wait out the write transactions that predate the index config
# it publishes, so it cannot run in a transaction that is itself one of them --
# that transaction only ends after the statement waiting on it does. Refused up
# front rather than left to deadlock. Uses a fresh empty table, so the refusal
# is about the transaction and not the row count.
statement ok
CREATE TABLE selfwrite (id BIGINT, tag TEXT) WITH (storage = 'search');

statement ok
BEGIN;

statement ok
INSERT INTO selfwrite VALUES (1, 'red');

statement error
CREATE INDEX selfwrite_idx ON selfwrite USING inverted (tag);
----
db error: ERROR: CREATE INDEX on a search-backed table cannot run in a transaction that has already written to "selfwrite"


statement ok
ROLLBACK;

# Not a blanket ban on transactions: one that has not written to the table is
# fine.
statement ok
BEGIN;

statement ok
CREATE INDEX selfwrite_idx ON selfwrite USING inverted (tag);

statement ok
COMMIT;

query
SELECT indexname FROM pg_indexes WHERE tablename = 'selfwrite';
----
indexname
selfwrite_idx


# Bare table: a non-PK predicate is not pushed down to a term filter -- it falls
# back to a columnstore Column Filter (correct results, no term lookup). This
# matches a transactional inverted index, which is reachable only via its own
# index scan.
query
SELECT id, tag FROM t WHERE tag = 'red' ORDER BY id;
----
id	tag
1	red
3	red

query
EXPLAIN SELECT id FROM t WHERE tag = 'red';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─╮
│ Index: t         │
│ Lookup: search   │
│ Index Filter:    │
│ ╭─ Term ─────╮   │
│ │ Field: tag │   │
│ │ Value: red │   │
│ ╰────────────╯   │
│ Projections: id  │
│ ~1 row           │
╰──────────────────╯

# A direct index scan pushes the predicate down through the index's own term
# field.
query
SELECT id, tag FROM t_tag_idx WHERE tag = 'red' ORDER BY id;
----
id	tag
1	red
3	red

query
SELECT id FROM t_tag_idx WHERE tag IN ('red', 'blue') ORDER BY id;
----
id
1
2
3

# A direct index scan is served off the table store: every column, all rows.
query
SELECT * FROM t_tag_idx ORDER BY id;
----
id	tag	body
1	red	the quick brown fox
2	blue	lazy dog jumps
3	red	fox runs fast

query
SELECT count(*) FROM t_tag_idx;
----
count
3

# DROP INDEX removes it, and leaves the table's other index alone.
statement ok
DROP INDEX t_tag_idx;

query
SELECT indexname FROM pg_indexes WHERE tablename = 't' ORDER BY indexname;
----
indexname
t_body_idx
t_pkey

# --- Analyzer / full-text column ---
# A text-analyzer inverted index tokenizes the column, so @@ matches individual
# terms -- via the index scan. Declared before any rows, so no rebuild is
# involved and this isolates the analyzer from the backfill.
statement ok
CREATE TEXT SEARCH DICTIONARY doc_en(
    template = 'text', locale = 'en_US.UTF-8', case = 'none',
    stemming = false, accent = false, frequency = true, position = true
);

statement ok
CREATE TABLE doc (id BIGINT PRIMARY KEY, body TEXT)
  WITH (storage='search', compaction_interval=0);

statement ok
CREATE INDEX doc_body_idx ON doc USING inverted (body doc_en);

statement ok
INSERT INTO doc VALUES
  (1, 'the quick brown fox'),
  (2, 'lazy dog jumps'),
  (3, 'fox runs fast');

statement ok
VACUUM (REFRESH_TABLE) doc;

# A bare @@ on the table itself reaches the same term filter the index scan
# uses: a search table's scan is already an index scan.
query
SELECT id FROM doc WHERE body @@ 'fox' ORDER BY id;
----
id
1
3

# Full-text via the index: 'fox' matches the two rows that contain the tokenized
# term.
query
SELECT id, body FROM doc_body_idx WHERE body @@ 'fox' ORDER BY id;
----
id	body
1	the quick brown fox
3	fox runs fast
