# CREATE INDEX on search tables (v1: empty-table only, storage-less inverted
# index). A search-table index carries no separate iresearch store -- it folds
# its columns into the table's own store, so a declared column term-indexes on
# write and its predicates push down on the table scan (keyword = term filter;
# analyzer column = full-text @@). The index is a real catalog object (shows in
# pg_indexes, DROPs, survives restart). v1 rejects CREATE INDEX on a non-empty
# table and non-inverted types. A direct index scan (SELECT * FROM <idx>) is
# served off the table store. Search tables are commit-time-only, so rows are
# observed after VACUUM (REFRESH_TABLE); EXPLAIN blocks pin the plan shape
# (indexed col -> no Column Filter; unindexed -> a columnstore Column Filter).

statement ok
CREATE TABLE t (id BIGINT PRIMARY KEY, tag TEXT, body TEXT)
  WITH (storage='search', compaction_interval=0);

# CREATE INDEX on an empty search table succeeds (metadata-only, no backfill).
statement ok
CREATE INDEX t_tag_idx ON t USING inverted (tag);

# A non-inverted index type is rejected.
statement error
CREATE INDEX t_bad_idx ON t (tag);
----
db error: ERROR: only inverted indexes are supported on a search-backed table


# The index is a real catalog object.
query
SELECT indexname FROM pg_indexes WHERE tablename = 't' ORDER BY indexname;
----
indexname
t_pkey
t_tag_idx

statement ok
INSERT INTO t VALUES
  (1, 'red', 'the quick brown fox'),
  (2, 'blue', 'lazy dog jumps'),
  (3, 'red', 'fox runs fast');

statement ok
VACUUM (REFRESH_TABLE) t;

# CREATE INDEX on a now-non-empty search table is rejected.
statement error
CREATE INDEX t_body_idx ON t USING inverted (body);
----
db error: ERROR: CREATE INDEX on a non-empty search-backed table is not yet supported (indexing existing rows)


# The indexed keyword column term-indexes and its predicate is served.
query
SELECT id, tag FROM t WHERE tag = 'red' ORDER BY id;
----
id	tag
1	red
3	red

query
SELECT id FROM t WHERE tag IN ('red', 'blue') ORDER BY id;
----
id
1
2
3

# EXPLAIN: an indexed-column predicate pushes down as a term filter -- no
# columnstore Column Filter.
query
EXPLAIN SELECT id FROM t WHERE tag = 'red';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─╮
│ Index: t         │
│ Lookup: search   │
│ Projections: id  │
│ ~1 row           │
╰──────────────────╯

# EXPLAIN: an unindexed column (body) falls back to a columnstore Column Filter.
query
EXPLAIN SELECT id FROM t WHERE body = 'fox runs fast';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ──────────────────────╮
│ Index: t                              │
│ Lookup: search                        │
│ Projections: id                       │
│ Column Filter: body = 'fox runs fast' │
│ ~1 row                                │
╰───────────────────────────────────────╯

# A direct index scan is served off the table store: every column, all rows.
query
SELECT * FROM t_tag_idx ORDER BY id;
----
id	tag	body
1	red	the quick brown fox
2	blue	lazy dog jumps
3	red	fox runs fast

query
SELECT count(*) FROM t_tag_idx;
----
count
3

# DROP INDEX removes it; the predicate on tag now falls back to a Column Filter.
statement ok
DROP INDEX t_tag_idx;

query
SELECT indexname FROM pg_indexes WHERE tablename = 't' ORDER BY indexname;
----
indexname
t_pkey

query
EXPLAIN SELECT id FROM t WHERE tag = 'red';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────╮
│ Index: t                   │
│ Lookup: search             │
│ Projections: id            │
│ Column Filter: tag = 'red' │
│ ~1 row                     │
╰────────────────────────────╯

# --- Analyzer / full-text column ---
# A text-analyzer inverted index tokenizes the column, so @@ matches individual
# terms. Declared before any rows so the empty-table gate is satisfied.
statement ok
CREATE TEXT SEARCH DICTIONARY doc_en(
    template = 'text', locale = 'en_US.UTF-8', case = 'none',
    stemming = false, accent = false, frequency = true, position = true
);

statement ok
CREATE TABLE doc (id BIGINT PRIMARY KEY, body TEXT)
  WITH (storage='search', compaction_interval=0);

statement ok
CREATE INDEX doc_body_idx ON doc USING inverted (body doc_en);

statement ok
INSERT INTO doc VALUES
  (1, 'the quick brown fox'),
  (2, 'lazy dog jumps'),
  (3, 'fox runs fast');

statement ok
VACUUM (REFRESH_TABLE) doc;

# Full-text: 'fox' matches the two rows that contain the tokenized term.
query
SELECT id, body FROM doc WHERE body @@ 'fox' ORDER BY id;
----
id	body
1	the quick brown fox
3	fox runs fast

# EXPLAIN: the @@ predicate is claimed by the term filter -- no Column Filter.
query
EXPLAIN SELECT id FROM doc WHERE body @@ 'fox';
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─╮
│ Index: doc       │
│ Lookup: search   │
│ Projections: id  │
│ ~1 row           │
╰──────────────────╯
