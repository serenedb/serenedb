# A search-table CREATE INDEX releases the statement's pinned reader of the
# shard it rewrites, so the segments it replaces stop being held for the whole
# build. A frozen transaction must not pay for that in isolation: neither the
# shard being indexed nor any other search table it has read may jump to a
# newer snapshot. The writer below commits AND publishes, so a reader that
# dropped its pin would see 2 rather than the pinned 1.

statement ok
CREATE TABLE sa (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
CREATE TABLE sb (id BIGINT, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);


statement ok
INSERT INTO sa VALUES (1, 'alpha');


statement ok
INSERT INTO sb VALUES (1, 'alpha');


statement ok
VACUUM (REFRESH_TABLE) sa;


statement ok
VACUUM (REFRESH_TABLE) sb;


connection reader
statement ok
BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ;


# Pins a reader for both shards.
connection reader
query
SELECT count(*) FROM sa;
----
count
1


connection reader
query
SELECT count(*) FROM sb;
----
count
1


connection writer
statement ok
INSERT INTO sa VALUES (2, 'beta');


connection writer
statement ok
INSERT INTO sb VALUES (2, 'beta');


connection writer
statement ok
VACUUM (REFRESH_TABLE) sa;


connection writer
statement ok
VACUUM (REFRESH_TABLE) sb;


# Published, and still invisible here: the pins hold before the build runs.
connection reader
query
SELECT count(*) FROM sa;
----
count
1


connection reader
statement ok
CREATE INDEX sb_idx ON sb USING inverted (body);


# The shard the build rewrote: its pin is kept because this view is frozen.
connection reader
query
SELECT count(*) FROM sb;
----
count
1


# An unrelated search table must never be touched by another shard's build.
connection reader
query
SELECT count(*) FROM sa;
----
count
1


connection reader
statement ok
COMMIT;


# Past the frozen view, the writer's rows are there -- so the pinned 1s above
# were a held snapshot, not an unpublished write.
connection reader
query
SELECT count(*) FROM sa;
----
count
2


connection reader
query
SELECT count(*) FROM sb;
----
count
2
