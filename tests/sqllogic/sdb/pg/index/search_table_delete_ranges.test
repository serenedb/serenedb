# A run of rows across segments and row groups, cut inside a row group at the end.
statement ok
DELETE FROM dr WHERE ts < TIMESTAMP '2026-01-01' + 151234 * INTERVAL '1 second'


statement ok
DELETE FROM dr_ref WHERE ts < TIMESTAMP '2026-01-01' + 151234 * INTERVAL '1 second'


# Scattered rows among rows that stay.
statement ok
DELETE FROM dr WHERE id % 1000 = 7


statement ok
DELETE FROM dr_ref WHERE id % 1000 = 7


# One statement with a long run and scattered rows.
statement ok
DELETE FROM dr WHERE (id >= 200000 AND id < 210000) OR id % 997 = 0


statement ok
DELETE FROM dr_ref WHERE (id >= 200000 AND id < 210000) OR id % 997 = 0


statement ok
VACUUM (REFRESH_TABLE) dr


query
SELECT count(*) AS missing FROM (SELECT id, ts, body FROM dr_ref EXCEPT ALL SELECT id, ts, body FROM dr)
----
missing
0


query
SELECT count(*) AS extra FROM (SELECT id, ts, body FROM dr EXCEPT ALL SELECT id, ts, body FROM dr_ref)
----
extra
0


query
