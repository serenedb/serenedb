CREATE TABLE dp_ref AS
SELECT i AS id, TIMESTAMP '2026-01-01' + i * INTERVAL '1 second' AS ts, 'row ' || i AS body
FROM range(0, 600000) r(i)


statement ok
CREATE TABLE dp (id BIGINT, ts TIMESTAMP, body TEXT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
      row_group_size = 8192)


statement ok
INSERT INTO dp SELECT id, ts, body FROM dp_ref


statement ok
VACUUM (REFRESH_TABLE) dp


