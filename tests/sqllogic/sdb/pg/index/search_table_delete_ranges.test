count	min
238289	151234


# Two deletes, the second below the first, then inserts between deletes, all in
# one transaction.
statement ok
BEGIN


statement ok
DELETE FROM dr WHERE id >= 300000 AND id < 320000


statement ok
DELETE FROM dr WHERE id >= 280000 AND id < 290000


statement ok
INSERT INTO dr SELECT i, TIMESTAMP '2025-01-01' + i * INTERVAL '1 second', 'new ' || i FROM range(1000000, 1010000) r(i)


statement ok
DELETE FROM dr WHERE id >= 320000 AND id < 330000


statement ok
INSERT INTO dr SELECT i, TIMESTAMP '2025-01-01' + i * INTERVAL '1 second', 'new ' || i FROM range(1010000, 1020000) r(i)


statement ok
DELETE FROM dr WHERE id >= 270000 AND id < 271000


statement ok
COMMIT


statement ok
DELETE FROM dr_ref WHERE (id >= 270000 AND id < 271000) OR (id >= 280000 AND id < 290000) OR (id >= 300000 AND id < 330000)


statement ok
INSERT INTO dr_ref SELECT i, TIMESTAMP '2025-01-01' + i * INTERVAL '1 second', 'new ' || i FROM range(1000000, 1020000) r(i)


statement ok
VACUUM (REFRESH_TABLE) dr


