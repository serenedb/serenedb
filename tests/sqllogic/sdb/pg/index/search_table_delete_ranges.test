statement ok
CREATE TABLE dr (id BIGINT, ts TIMESTAMP, body TEXT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0,
      row_group_size = 8192)


statement ok
CREATE TABLE dr_ref (id BIGINT, ts TIMESTAMP, body TEXT)


statement ok
INSERT INTO dr SELECT i, TIMESTAMP '2026-01-01' + i * INTERVAL '1 second', 'row ' || i FROM range(0, 100000) r(i)


statement ok
VACUUM (REFRESH_TABLE) dr


