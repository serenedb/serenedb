statement ok
CREATE TABLE rj (a BIGINT, b BIGINT, c BIGINT, t TEXT) WITH (storage = 'search', compaction_interval = 0, refresh_interval = 0);

statement ok
CREATE TABLE rj_plain (a BIGINT, b BIGINT, c BIGINT, t TEXT);

statement ok
INSERT INTO rj SELECT i, i * 10, i * 100, 't' || i FROM generate_series(0, 99) g(i);

statement ok
INSERT INTO rj_plain SELECT i, i * 10, i * 100, 't' || i FROM generate_series(0, 99) g(i);

statement ok
VACUUM (REFRESH_TABLE) rj;

statement ok
CREATE TABLE rk (k TEXT PRIMARY KEY, n INT, x BIGINT) WITH (storage = 'search', compaction_interval = 0, refresh_interval = 0);

statement ok
CREATE TABLE rk_plain (k TEXT PRIMARY KEY, n INT, x BIGINT);

statement ok
INSERT INTO rk SELECT 'k' || i, i, i * 7 FROM generate_series(0, 19) g(i);

statement ok
INSERT INTO rk_plain SELECT 'k' || i, i, i * 7 FROM generate_series(0, 19) g(i);

statement ok
VACUUM (REFRESH_TABLE) rk;

statement ok
CREATE TABLE rj_small (id BIGINT);

statement ok
INSERT INTO rj_small SELECT i FROM generate_series(0, 9, 3) g(i), generate_series(1, 3) r(j);

statement ok
CREATE TABLE rj_big (id BIGINT);

statement ok
INSERT INTO rj_big SELECT i % 100 FROM generate_series(0, 99999) g(i);

statement ok
