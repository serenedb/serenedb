control substitution on

statement ok
CREATE TEXT SEARCH DICTIONARY stdi_en AS
    split_text(case := 'lower')
    WITH (frequency, position, norm, offset);

statement ok
CREATE TABLE stdi_src AS
SELECT i,
       CASE WHEN i % 29 = 0 THEN NULL
            WHEN i % 31 = 0 THEN ''
            ELSE 'Red car number ' || (i % 41)::VARCHAR ||
                 CASE WHEN i % 3 = 0 THEN ' with a long tail of seven words ' || (i % 5)::VARCHAR ELSE '' END END AS body,
       CASE WHEN i % 23 = 0 THEN NULL ELSE 'Tag ' || (i % 7)::VARCHAR END AS tag
FROM generate_series(1, 20000) g(i);

statement ok
COPY stdi_src TO '${__TEST_DIR__}/stdi.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 5000);

statement ok
CREATE TABLE stdi_dict (i BIGINT PRIMARY KEY, body TEXT, tag TEXT)
WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX stdi_dict_idx ON stdi_dict USING inverted (i, body stdi_en, tag);

statement ok
CREATE TABLE stdi_flat (i BIGINT PRIMARY KEY, body TEXT, tag TEXT)
WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX stdi_flat_idx ON stdi_flat USING inverted (i, body stdi_en, tag);

statement count 20000
INSERT INTO stdi_dict SELECT i, body, tag FROM read_parquet('${__TEST_DIR__}/stdi.parquet');

statement count 20000
INSERT INTO stdi_flat SELECT i, body || '', tag || '' FROM stdi_src;

statement ok
VACUUM (REFRESH_TABLE) stdi_dict;

statement ok
VACUUM (REFRESH_TABLE) stdi_flat;

query
SELECT count(*) AS n FROM stdi_dict_idx WHERE body @@ plainto_tsquery('red car seven');
----
n
6229

query
SELECT count(*) AS n FROM (
  SELECT i, BM25(stdi_dict_idx.tableoid) AS s FROM stdi_dict_idx WHERE body @@ plainto_tsquery('red car seven')
  EXCEPT ALL
  SELECT i, BM25(stdi_flat_idx.tableoid) AS s FROM stdi_flat_idx WHERE body @@ plainto_tsquery('red car seven'));
----
