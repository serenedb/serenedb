statement count 3000
INSERT INTO stdi_const SELECT i, 'Red car number 7 with a long tail', 'Tag 3' FROM generate_series(1, 3000) g(i);

statement count 3000
INSERT INTO stdi_const_flat
SELECT i, CASE WHEN i > 0 THEN 'Red car number 7 with a long tail' END, CASE WHEN i > 0 THEN 'Tag 3' END
FROM generate_series(1, 3000) g(i);

