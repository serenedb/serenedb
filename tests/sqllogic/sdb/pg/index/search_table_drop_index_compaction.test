statement ok
CREATE TEXT SEARCH DICTIONARY dic_plain AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
DROP INDEX notes_body_idx;

statement ok
CREATE INDEX notes_body_idx ON notes USING inverted (body dic_plain);

statement ok
