VACUUM (REFRESH_TABLE) dm;

query
SELECT (SELECT count(*) FROM dm) AS search_n, (SELECT count(*) FROM dm_plain) AS plain_n, (SELECT count(*) FROM dm WHERE id % 3 = 0) AS search_left;
