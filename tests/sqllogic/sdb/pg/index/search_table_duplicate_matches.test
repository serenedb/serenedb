n	ids	updated
6666	6666	3333

query
SELECT (SELECT count(*) FROM (SELECT id, v FROM dm EXCEPT ALL SELECT id, v FROM dm_plain)) AS only_search, (SELECT count(*) FROM (SELECT id, v FROM dm_plain EXCEPT ALL SELECT id, v FROM dm)) AS only_plain;
----
only_search	only_plain
0	0

