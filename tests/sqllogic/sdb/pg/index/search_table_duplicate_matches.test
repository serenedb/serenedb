CREATE TABLE dm (id BIGINT, v TEXT) WITH (storage = 'search', compaction_interval = 0, refresh_interval = 0);

statement ok
CREATE TABLE dm_plain (id BIGINT, v TEXT);

statement ok
INSERT INTO dm SELECT i, 'v' || i FROM generate_series(0, 9999) g(i);

statement ok
INSERT INTO dm_plain SELECT i, 'v' || i FROM generate_series(0, 9999) g(i);

statement ok
VACUUM (REFRESH_TABLE) dm;

statement ok
CREATE TABLE dm_src (id BIGINT);

statement ok
INSERT INTO dm_src SELECT i FROM generate_series(0, 9999, 3) g(i), generate_series(1, 3) r(j);

statement count 3334
