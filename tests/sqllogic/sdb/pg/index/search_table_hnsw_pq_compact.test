query
SELECT count(*) FROM (
  (SELECT id FROM pqc_l2 ORDER BY emb <-> pqc_vec(1234.5) LIMIT 10)
  EXCEPT (SELECT id FROM pqc_ref ORDER BY emb <-> pqc_vec(1234.5) LIMIT 10)) t;
