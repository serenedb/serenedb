statement ok
CREATE MACRO pqc_vec(i) AS
  list_transform(range(16),
                 j -> (sin(i * 0.0137 * (j % 5 + 1) + j * 0.71))::FLOAT)::FLOAT[16];

statement ok
CREATE TABLE pqc_l2 (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX pqc_l2_idx ON pqc_l2
  USING inverted(id, emb hnsw (metric = 'l2', quant = 'pq', pq_m = 16));

statement ok
CREATE TABLE pqc_ip (id INTEGER PRIMARY KEY, emb FLOAT[16])
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX pqc_ip_idx ON pqc_ip
  USING inverted(id, emb hnsw (metric = 'ip', quant = 'pq', pq_m = 8));

statement ok
CREATE TABLE pqc_ref (id INTEGER PRIMARY KEY, emb FLOAT[16]);

statement ok
INSERT INTO pqc_ref SELECT i, pqc_vec(i) FROM range(15000) t(i);

statement ok
INSERT INTO pqc_l2 SELECT * FROM pqc_ref WHERE id < 5000;

statement ok
VACUUM (REFRESH_TABLE) pqc_l2;

statement ok
INSERT INTO pqc_l2 SELECT * FROM pqc_ref WHERE id >= 5000 AND id < 10000;

statement ok
VACUUM (REFRESH_TABLE) pqc_l2;

statement ok
INSERT INTO pqc_l2 SELECT * FROM pqc_ref WHERE id >= 10000;

statement ok
VACUUM (REFRESH_TABLE) pqc_l2;

statement ok
INSERT INTO pqc_ip SELECT * FROM pqc_ref WHERE id < 5000;

statement ok
VACUUM (REFRESH_TABLE) pqc_ip;

statement ok
INSERT INTO pqc_ip SELECT * FROM pqc_ref WHERE id >= 5000 AND id < 10000;

statement ok
VACUUM (REFRESH_TABLE) pqc_ip;

statement ok
INSERT INTO pqc_ip SELECT * FROM pqc_ref WHERE id >= 10000;

statement ok
VACUUM (REFRESH_TABLE) pqc_ip;

query
