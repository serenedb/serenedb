statement ok
CREATE TABLE hcp (id BIGINT, s TEXT, d DOUBLE)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0)


statement ok
CREATE MACRO hcp_rows(lo, hi) AS TABLE
SELECT i AS id,
       CASE WHEN i < 2048 THEN NULL ELSE 'a long prefix string ' || lpad(i::TEXT, 6, '0') END AS s,
       CASE WHEN i % 1000 = 0 THEN 'nan'::DOUBLE
            WHEN i = 4097 THEN 'inf'::DOUBLE
            WHEN i = 4098 THEN '-inf'::DOUBLE
            ELSE i * 0.5 END AS d
FROM generate_series(lo, hi) t(i)


statement ok
INSERT INTO hcp SELECT * FROM hcp_rows(0, 999)


statement ok
INSERT INTO hcp SELECT * FROM hcp_rows(1000, 1999)


