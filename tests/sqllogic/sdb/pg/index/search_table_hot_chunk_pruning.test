query
SELECT
  (SELECT count(*) FROM hcp WHERE id = 4100) AS point,
  (SELECT count(*) FROM hcp WHERE id BETWEEN 2040 AND 2060) AS across,
  (SELECT count(*) FROM hcp WHERE s IS NULL) AS null_s,
  (SELECT count(*) FROM hcp WHERE s IS NOT NULL) AS some_s,
  (SELECT count(*) FROM hcp WHERE s LIKE 'a long prefix string 0099%') AS prefix,
  (SELECT count(*) FROM hcp WHERE s = 'a long prefix string 002048') AS first_s,
  (SELECT count(*) FROM hcp WHERE s < 'a long prefix string 002100') AS below_s,
  (SELECT count(*) FROM hcp WHERE d > 4000) AS above_d,
  (SELECT count(*) FROM hcp WHERE d < -1) AS minus_inf,
  (SELECT count(*) FROM hcp WHERE d = 'nan'::DOUBLE) AS nans,
  (SELECT count(*) FROM hcp WHERE d BETWEEN 1000 AND 1001) AS between_d;
----
point	across	null_s	some_s	prefix	first_s	below_s	above_d	minus_inf	nans	between_d
1	21	2048	7952	100	1	52	2009	1	10	2


query
SELECT string_agg(id::TEXT, ',' ORDER BY id) AS ids, max(s) AS last_s
FROM hcp WHERE id IN (10, 2050, 4099, 9999);
----
ids	last_s
10,2050,4099,9999	a long prefix string 009999


query
SELECT id, s FROM hcp WHERE id = 3000;
----
id	s
3000	a long prefix string 003000


