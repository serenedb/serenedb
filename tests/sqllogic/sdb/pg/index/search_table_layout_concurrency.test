# A transaction that changes a search table's indexes or definition holds the
# table until it ends: another transaction's CREATE [OR REPLACE] INDEX, DROP
# INDEX, ALTER TABLE or DROP TABLE on it is refused meanwhile. Reads, writes
# and other tables go on.

statement ok
CREATE TABLE lc (id INT PRIMARY KEY, body TEXT)
WITH (storage = 'search', compaction_interval = 0)


statement ok
INSERT INTO lc SELECT i, 'fox ' || i FROM generate_series(1, 200) s(i)


statement ok
VACUUM (REFRESH_TABLE) lc


statement ok
CREATE INDEX lc_x ON lc USING inverted (body)


# --- CREATE INDEX holds the table until COMMIT ---

connection a
statement ok
BEGIN


connection a
statement ok
CREATE INDEX lc_a ON lc USING inverted (body, id)


connection b
statement error
CREATE INDEX lc_b ON lc USING inverted (id)
----
db error: ERROR: search table "lc" is being changed by another transaction
HINT: Retry once that transaction commits or rolls back.


connection b
statement error
CREATE OR REPLACE INDEX lc_x ON lc USING inverted (body, id)
----
db error: ERROR: search table "lc" is being changed by another transaction
HINT: Retry once that transaction commits or rolls back.


connection b
statement error
DROP INDEX lc_x
----
db error: ERROR: search table "lc" is being changed by another transaction
HINT: Retry once that transaction commits or rolls back.


connection b
statement error
ALTER TABLE lc SET (refresh_interval = 500)
----
db error: ERROR: search table "lc" is being changed by another transaction
HINT: Retry once that transaction commits or rolls back.


connection b
statement error
DROP TABLE lc
----
db error: ERROR: search table "lc" is being changed by another transaction
HINT: Retry once that transaction commits or rolls back.


connection b
statement ok
INSERT INTO lc VALUES (1001, 'wolf')


connection b
statement ok
VACUUM (REFRESH_TABLE) lc


connection b
query
SELECT count(*) AS n FROM lc
----
n
201


connection b
statement ok
CREATE TABLE lc_other (id INT PRIMARY KEY, body TEXT) WITH (storage = 'search')


connection b
statement ok
CREATE INDEX lc_other_idx ON lc_other USING inverted (body)


connection a
statement ok
COMMIT


connection b
statement ok
CREATE INDEX lc_b ON lc USING inverted (id)


statement ok
VACUUM (REFRESH_TABLE) lc


query
SELECT (SELECT count(*) FROM lc_a WHERE body = 'wolf') AS wolf_a,
       (SELECT count(*) FROM lc_b WHERE id = 1001) AS wolf_b,
       (SELECT count(*) FROM lc_x WHERE body = 'fox 7') AS fox_x
----
wolf_a	wolf_b	fox_x
1	1	1


