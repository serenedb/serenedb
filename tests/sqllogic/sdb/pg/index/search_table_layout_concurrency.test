SELECT string_agg(indexname, ',' ORDER BY indexname) AS indexes FROM pg_indexes WHERE tablename = 'lc'
----
indexes
lc_a,lc_b,lc_f,lc_g,lc_h,lc_i,lc_pkey,lc_x


statement ok
VACUUM (REFRESH_TABLE) lc


query
SELECT (SELECT count(*) FROM lc_f WHERE body = 'wolf') AS f,
       (SELECT count(*) FROM lc_g WHERE body = 'wolf') AS g,
       (SELECT count(*) FROM lc_i WHERE body = 'fox 9') AS i
----
f	g	i
1	1	1


# --- A cascaded drop is held like a direct one ---

statement ok
CREATE SCHEMA lcs


statement ok
CREATE TABLE lcs.t (id INT PRIMARY KEY, body TEXT) WITH (storage = 'search')


statement ok
CREATE INDEX lcs_t_x ON lcs.t USING inverted (body)


connection a
statement ok
BEGIN


connection a
statement ok
CREATE INDEX lcs_t_a ON lcs.t USING inverted (id)


connection b
statement error
DROP SCHEMA lcs CASCADE
----
db error: ERROR: search table "t" is being changed by another transaction
HINT: Retry once that transaction commits or rolls back.


connection a
statement ok
COMMIT


connection b
statement ok
DROP SCHEMA lcs CASCADE


