CREATE TABLE pk (id BIGINT PRIMARY KEY, r TEXT) WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX pk_r ON pk USING inverted (r);

statement ok
INSERT INTO pk SELECT i, 'r' || (i % 7) FROM generate_series(1, 7000) g(i);

statement ok
VACUUM (REFRESH_TABLE) pk;

statement ok
DELETE FROM pk WHERE r = 'r3';

statement ok
DELETE FROM pk WHERE id = 7000;

statement ok
VACUUM (REFRESH_TABLE) pk;

query
SELECT count(*) AS n, count(*) FILTER (WHERE r = 'r3') AS r3, count(*) FILTER (WHERE id = 7000) AS last FROM pk;
----
