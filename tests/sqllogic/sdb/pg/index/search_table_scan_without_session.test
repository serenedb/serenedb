control substitution on

statement ok
CREATE TABLE sws_plain (id INT);


statement ok
INSERT INTO sws_plain VALUES (1), (2);


query
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT count(*) AS n FROM ${__DATABASE__}.public.sws_plain'));
----
n
2

statement ok
CREATE TABLE sws (id BIGINT, tag TEXT)
  WITH (storage = 'search', compaction_interval = 0);


statement ok
INSERT INTO sws VALUES (1, 'red'), (2, 'blue'), (3, 'red');


statement ok
VACUUM (REFRESH_TABLE) sws;


query
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT count(*) AS n FROM ${__DATABASE__}.public.sws'));
----
n
3

query
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT id FROM ${__DATABASE__}.public.sws WHERE tag = ''red'' ORDER BY id'));
----
id
1
3

statement ok
CREATE VIEW sws_view AS SELECT id, tag FROM sws WHERE id > 1;


query
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT id, tag FROM ${__DATABASE__}.public.sws_view ORDER BY id'));
----
id	tag
2	blue
3	red

statement ok
CREATE INDEX sws_tag_idx ON sws USING inverted (tag);


query
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT count(*) AS n FROM ${__DATABASE__}.public.sws_tag_idx'));
----
n
3

statement ok
INSERT INTO sws VALUES (4, 'green');


statement ok
VACUUM (REFRESH_TABLE) sws;


query
SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT id, tag FROM ${__DATABASE__}.public.sws ORDER BY id'));
----
id	tag
1	red
2	blue
3	red
4	green
