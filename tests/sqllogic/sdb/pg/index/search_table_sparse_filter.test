# Sparse windows first, dense windows later in the same scan: the dictionary gets materialized mid-segment.
query
SELECT count(*) AS n FROM (
  SELECT i, url, phrase FROM ssf WHERE (i % 50 = 1 OR i > 15000) AND url LIKE '%google1%'
  EXCEPT ALL
  SELECT i, url, phrase FROM ssf_src WHERE (i % 50 = 1 OR i > 15000) AND url LIKE '%google1%');
----
n
0

