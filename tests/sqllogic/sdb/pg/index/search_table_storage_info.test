statement ok
CREATE TABLE nested_si (id INT PRIMARY KEY, tags INT[], u UNION(num INTEGER, str VARCHAR), v VARIANT)
WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, row_group_size = 2048)


statement ok
INSERT INTO nested_si
SELECT i, [i, i + 1],
       CASE WHEN i % 2 = 0 THEN i::INTEGER::UNION(num INTEGER, str VARCHAR) ELSE ('v' || i)::UNION(num INTEGER, str VARCHAR) END,
       i::VARIANT
FROM generate_series(1, 5000) s(i)


statement ok
VACUUM (REFRESH_TABLE) nested_si


query
SELECT column_path, segment_type, sum(count) AS rows
FROM pragma_storage_info('nested_si')
WHERE column_name = 'tags' AND segment_type <> 'VALIDITY'
GROUP BY ALL
ORDER BY segment_type
----
column_path	segment_type	rows
[1, 1]	INTEGER	10000
[1]	INTEGER[]	5000
[1, 2]	UBIGINT	5000


query
SELECT column_path, segment_type, sum(count) AS rows
FROM pragma_storage_info('nested_si')
WHERE column_name = 'u' AND segment_type <> 'VALIDITY'
GROUP BY ALL
ORDER BY segment_type
----
column_path	segment_type	rows
[2, 2]	INTEGER	5000
[2, 1]	UTINYINT	5000
[2, 3]	VARCHAR	5000


query
SELECT column_path, segment_type, sum(count) AS rows, min(start) AS first_row, max(start + count) AS end_row
FROM pragma_storage_info('nested_si')
WHERE column_name = 'v' AND segment_type = 'BLOB'
GROUP BY ALL
----
column_path	segment_type	rows	first_row	end_row
[3, 1, 4]	BLOB	5000	0	5000


query
SELECT s."column", s.bytes > 0 AS sized, s.bytes = i.bytes AS listed
FROM (
  SELECT "column", sum(bytes) AS bytes
  FROM sdb_segments('nested_si', columns := true)
  GROUP BY ALL
) s
LEFT JOIN (
  SELECT column_name, sum(split_part(segment_info, '=', 2)::BIGINT) AS bytes
  FROM pragma_storage_info('nested_si', include_segment_info = true)
  GROUP BY ALL
) i ON s."column" = i.column_name
WHERE s."column" IN ('tags', 'u', 'v')
ORDER BY s."column"
----
column	sized	listed
tags	t	t
u	t	t
v	t	t


query
SELECT DISTINCT "column", codecs
FROM sdb_segments('nested_si', columns := true)
WHERE "column" IN ('u', 'v')
ORDER BY "column"
----
column	codecs
u	NULL
v	NULL


statement ok
DROP TABLE nested_si


