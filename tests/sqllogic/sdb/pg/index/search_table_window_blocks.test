# Two filters, the string one first in the chain.
query
SELECT count(*) AS n FROM (
  SELECT i FROM swb WHERE s <> '' AND k < 30
  EXCEPT ALL
  SELECT i FROM swb_src WHERE s <> '' AND k < 30);
----
n
