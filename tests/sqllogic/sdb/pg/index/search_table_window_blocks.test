# Grouped, the ClickBench Q28 shape.
query
SELECT count(*) AS n FROM (
  SELECT k, avg(length(s)), count(*) FROM swb WHERE s <> '' GROUP BY k
  EXCEPT ALL
  SELECT k, avg(length(s)), count(*) FROM swb_src WHERE s <> '' GROUP BY k);
----
n
0

query
SELECT count(*) AS n, sum(k) AS k FROM swb WHERE s <> '';
----
n	k
117600	2116685

