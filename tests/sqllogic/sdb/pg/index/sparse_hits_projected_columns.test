id	body	note	kind	n
19982	uncompressed body of row 19982 x	note of row 19982 yyyy	kind number 2 of the sparse hits table	139874
19885	uncompressed body of row 19885 xxxxxxxx	note of row 19885 yyyyy	kind number 0 of the sparse hits table	139195
19788	uncompressed body of row 19788 xx	NULL	kind number 3 of the sparse hits table	138516


statement ok
INSERT INTO sparse_hits
SELECT i,
       CASE WHEN i % 97 = 0 THEN 'rare' ELSE 'common' END,
       'uncompressed body of row ' || i || ' ' || repeat('x', i % 13),
       CASE WHEN i % 3 = 0 THEN NULL ELSE 'note of row ' || i || ' ' || repeat('y', i % 7) END,
       'kind number ' || (i % 5) || ' of the sparse hits table',
       i * 7
FROM generate_series(20001, 21000) s(i)


statement ok
UPDATE sparse_hits SET note = 'patched note ' || id WHERE id % 194 = 0


query
SELECT count(*) AS hits,
       count(*) FILTER (WHERE body IS DISTINCT FROM 'uncompressed body of row ' || id || ' ' || repeat('x', id % 13)) AS bad_body,
       count(*) FILTER (WHERE note IS DISTINCT FROM CASE WHEN id % 194 = 0 THEN 'patched note ' || id
                                                         WHEN id % 3 = 0 THEN NULL
                                                         ELSE 'note of row ' || id || ' ' || repeat('y', id % 7) END) AS bad_note,
       count(*) FILTER (WHERE kind IS DISTINCT FROM 'kind number ' || (id % 5) || ' of the sparse hits table') AS bad_kind,
       count(*) FILTER (WHERE n IS DISTINCT FROM id * 7) AS bad_n
FROM sparse_hits_idx
WHERE tag @@ 'rare'
----
hits	bad_body	bad_note	bad_kind	bad_n
216	0	0	0	0


