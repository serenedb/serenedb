CREATE TEXT SEARCH DICTIONARY tdb_wild AS generate_wildcard_ngrams(keyword(), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY tdb_collate AS collate_tokens('en_US.UTF-8')

statement ok
CREATE TABLE tdb_t (id INTEGER PRIMARY KEY, w VARCHAR, c VARCHAR, k VARCHAR)

statement ok
CREATE INDEX tdb_idx ON tdb_t USING inverted (id, w tdb_wild, c tdb_collate, k)
    WITH (refresh_interval = 0, compaction_interval = 0)

