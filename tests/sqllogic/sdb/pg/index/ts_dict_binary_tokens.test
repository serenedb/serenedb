statement ok
CREATE TABLE beast_t (id INTEGER PRIMARY KEY, w VARCHAR, c VARCHAR, k VARCHAR) WITH (compaction_interval = 0)

statement ok
CREATE INDEX beast_idx ON beast_t USING inverted (id, w beast_wild, c beast_collate, k)

