statement ok
CREATE TEXT SEARCH DICTIONARY beast_mixed AS [keyword(), (lambda x: unhex(md5(x)))]

statement ok
CREATE TABLE beast_b (id INTEGER PRIMARY KEY, g VARCHAR, b VARCHAR, m VARCHAR, h VARCHAR, u VARCHAR) WITH (compaction_interval = 0)

statement ok
