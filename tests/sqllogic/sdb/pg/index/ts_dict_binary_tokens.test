statement ok
CREATE TEXT SEARCH DICTIONARY beast_collate AS collate_tokens('en_US.UTF-8')

statement ok
CREATE TABLE beast_t (id INTEGER PRIMARY KEY, w VARCHAR, c VARCHAR, k VARCHAR)

statement ok
CREATE INDEX beast_idx ON beast_t USING inverted (id, w beast_wild, c beast_collate, k)
    WITH (refresh_interval = 0, compaction_interval = 0)

