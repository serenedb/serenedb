╭─ IRESEARCH_SCAN ─────┴─────────────────────╮
│ Index: fl_words_idx                        │
│ Index Filter:                              │
│ ╭─ Levenshtein ────╮                       │
│ │ Field: w(string) │                       │
│ │ Target: cats     │                       │
│ │ Max Terms: 0     │                       │
│ ╰──────────────────╯                       │
│ TsDict: w                                  │
│ Projections:                               │
│ sdb_inverted_index_term$w,                 │
│ sdb_inverted_index_term_score$w            │
│ ~1 row                                     │
╰────────────────────────────────────────────╯

query
SELECT unnest(ts_dict_agg(w)) AS t, unnest(ts_dict_score(w)) AS s,
       unnest(ts_dict_count(w)) AS c
FROM fl_words_idx WHERE w @@ ts_levenshtein('cats', 1) AND length(w) > 0
ORDER BY s DESC, c DESC LIMIT 1;
