t	s	c
cuts	0.75	2

statement ok
CREATE TEXT SEARCH DICTIONARY fl_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false);

statement ok
CREATE TABLE fl_docs (id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
CREATE INDEX fl_docs_idx ON fl_docs USING inverted (body fl_en);

statement ok
INSERT INTO fl_docs VALUES (1, 'cuts dogs');

statement ok
VACUUM (REFRESH_TABLE) fl_docs;

statement ok
INSERT INTO fl_docs VALUES (2, 'bats cuts'), (3, 'mats');

statement ok
VACUUM (REFRESH_TABLE) fl_docs;

query
SELECT t, s, c
FROM (SELECT unnest(ts_dict_agg(body)) AS t, unnest(ts_dict_score(body)) AS s,
             unnest(ts_dict_count(body)) AS c
      FROM fl_docs_idx) sub
WHERE t @@ ts_levenshtein('cats', 1)
ORDER BY s DESC, c DESC LIMIT 1;
----
t	s	c
cuts	0.75	2

query
SELECT t, s, c
FROM (SELECT unnest(ts_dict_agg(body)) AS t, unnest(ts_dict_score(body)) AS s,
             unnest(ts_dict_count(body)) AS c
      FROM fl_docs_idx) sub
WHERE t @@ ts_levenshtein('cats', 1)
ORDER BY s DESC LIMIT 2;
----
t	s	c
bats	0.75	1
cuts	0.75	2

