query
EXPLAIN SELECT unnest(ts_dict_agg(w)) AS t, unnest(ts_dict_score(w)) AS s
FROM fl_words_idx WHERE w @@ ts_levenshtein('cats', 1) AND length(w) > 0
ORDER BY s DESC LIMIT 1;
----
QUERY PLAN
╭─ TOP_N ────────────────────────────────────╮
│ Top: 1                                     │
│ Order By:                                  │
│ unnest(ts_dict_score(fl_words_idx.w)) DESC │
│ ~0 rows                                    │
╰──────────────────────┬─────────────────────╯
╭─ HASH_GROUP_BY ──────┴─────────────────────╮
│ Groups: #0                                 │
│ Aggregates: max(#1)                        │
│ ~0 rows                                    │
╰──────────────────────┬─────────────────────╯
╭─ FILTER ─────────────┴─────────────────────╮
│ Expression:                                │
│ length(sdb_inverted_index_term$w) > 0      │
│ ~1 row                                     │
