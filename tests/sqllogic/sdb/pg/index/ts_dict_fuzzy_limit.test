statement ok
CREATE TABLE fl_words (id INTEGER PRIMARY KEY, w VARCHAR NOT NULL);

statement ok
CREATE INDEX fl_words_idx ON fl_words USING inverted (w);

statement ok
INSERT INTO fl_words VALUES (1, 'cuts');

statement ok
VACUUM (REFRESH_TABLE) fl_words;

statement ok
INSERT INTO fl_words VALUES (2, 'bats'), (3, 'cuts'), (4, 'mats'), (5, 'dogs');

statement ok
VACUUM (REFRESH_TABLE) fl_words;

query
EXPLAIN SELECT unnest(ts_dict_agg(w)) AS t, unnest(ts_dict_score(w)) AS s
FROM fl_words_idx WHERE w @@ ts_levenshtein('cats', 1)
ORDER BY s DESC LIMIT 1;
----
QUERY PLAN
╭─ TOP_N ─────────────────────────────────────╮
│ Top: 1                                      │
│ Order By:                                   │
│ unnest(ts_dict_score(fl_words_idx.w)) DESC, │
│ t ASC                                       │
│ ~0 rows                                     │
╰──────────────────────┬──────────────────────╯
╭─ HASH_GROUP_BY ──────┴──────────────────────╮
│ Groups: #0                                  │
│ Aggregates: max(#1)                         │
│ ~0 rows                                     │
╰──────────────────────┬──────────────────────╯
╭─ IRESEARCH_SCAN ─────┴──────────────────────╮
│ Index: fl_words_idx                         │
│ Index Filter:                               │
│ ╭─ Levenshtein ────╮                        │
│ │ Field: w(string) │                        │
│ │ Target: cats     │                        │
│ │ Max Terms: 1     │                        │
│ ╰──────────────────╯                        │
│ TsDict: w                                   │
│ Projections:                                │
│ sdb_inverted_index_term$w,                  │
│ sdb_inverted_index_term_score$w             │
│ ~1 row                                      │
╰─────────────────────────────────────────────╯

query
SELECT unnest(ts_dict_agg(w)) AS t, unnest(ts_dict_score(w)) AS s,
       unnest(ts_dict_count(w)) AS c
FROM fl_words_idx WHERE w @@ ts_levenshtein('cats', 1)
ORDER BY s DESC LIMIT 1;
----
t	s	c
bats	0.75	1

query
SELECT unnest(ts_dict_agg(w)) AS t, unnest(ts_dict_score(w)) AS s,
       unnest(ts_dict_count(w)) AS c
