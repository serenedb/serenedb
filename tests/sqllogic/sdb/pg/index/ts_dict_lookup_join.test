query
SELECT d.id, d.title, t.term
FROM (SELECT id, title FROM tl_idx WHERE body @@ ts_phrase('fox') ORDER BY id DESC LIMIT 2) d
CROSS JOIN (SELECT unnest(ts_dict_agg(body)) AS term, unnest(ts_dict_count(body)) AS docs
            FROM tl_idx ORDER BY docs DESC, term LIMIT 2) t
ORDER BY d.id, t.term
----
