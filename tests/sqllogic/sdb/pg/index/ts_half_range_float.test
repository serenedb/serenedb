DROP TABLE ts_hrf


# A REAL or DOUBLE bound keeps its value, also one that prints with an
# exponent, and selects the rows the same comparison selects on the table.
statement ok
CREATE TABLE ts_hrx (id INT PRIMARY KEY, r REAL, d DOUBLE)


statement ok
CREATE INDEX ts_hrx_idx ON ts_hrx USING inverted (id, r, d)


statement ok
INSERT INTO ts_hrx VALUES
  (1, 123456789::REAL, 1.8446744073709552e19),
  (2, 0.00001::REAL, 0.1),
  (3, 5, 5),
  (4, 0.1::REAL, -1)


query
SELECT id FROM ts_hrx_idx WHERE r @@ ts_le(123456789::REAL) ORDER BY id
----
id
1
2
3
4


query
SELECT id FROM ts_hrx_idx WHERE r @@ ts_lt(123456789::REAL) ORDER BY id
----
id
2
3
4


query
SELECT id FROM ts_hrx_idx WHERE r @@ ts_between(123456789::REAL, 123456789::REAL, true, true) ORDER BY id
----
id
1


query
SELECT id FROM ts_hrx_idx WHERE r @@ ts_ge(0.00001::REAL) ORDER BY id
----
id
1
2
3
4


query
SELECT id FROM ts_hrx_idx WHERE r @@ ts_gt(0.00001::REAL) ORDER BY id
----
id
1
3
4


query
SELECT id FROM ts_hrx WHERE r <= 1e-1 ORDER BY id
----
id
2


query
SELECT id FROM ts_hrx_idx WHERE r @@ ts_le(1e-1) ORDER BY id
----
id
2


query
SELECT id FROM ts_hrx_idx WHERE d @@ ts_le(1.8446744e19::REAL) ORDER BY id
----
id
1
2
3
4


statement ok
DROP TABLE ts_hrx
