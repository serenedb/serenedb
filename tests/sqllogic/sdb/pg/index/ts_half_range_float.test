CREATE TABLE ts_hrf (id INT PRIMARY KEY, r REAL, d DOUBLE)


statement ok
CREATE INDEX ts_hrf_idx ON ts_hrf USING inverted (id, r, d)


statement ok
INSERT INTO ts_hrf VALUES (1, 0.5, -1.25), (2, 1.5, 2.5), (3, 2.5, 7.75)


query
