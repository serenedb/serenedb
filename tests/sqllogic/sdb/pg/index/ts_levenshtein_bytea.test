# On a BYTEA column, or with a BYTEA text or prefix, ts_levenshtein counts
# bytes; a value that is not UTF-8 is within any distance of itself.

statement ok
CREATE TABLE lev_bin(id INTEGER PRIMARY KEY, v BYTEA)

statement ok
CREATE INDEX lev_bin_idx ON lev_bin USING inverted(id, v)

statement ok
INSERT INTO lev_bin VALUES (1, '\xff61'::bytea), (2, '\x7a7a7a7a'::bytea), (3, '\x6262'::bytea), (4, '\xc3a9'::bytea), (5, '\x65'::bytea), (6, '\xc3'::bytea), (7, '\xe4b8'::bytea)

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\xff61'::bytea, 1) ORDER BY id
----
id
1

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\x6262'::bytea, 1) ORDER BY id
----
id
3

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('e', 1) ORDER BY id
----
id
5
6

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\xc3a8'::bytea, 1) ORDER BY id
----
id
4
6

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\xff6162'::bytea, 1, starts_with := true) ORDER BY id
----
id
1

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\x62'::bytea, 1, prefix := '\xff'::bytea) ORDER BY id
----
id
1

query
SELECT id FROM lev_bin WHERE levenshtein_matches(v, 'e', 1) ORDER BY id
----
id
5
6

# The automatic distance counts bytes too: `中` is three bytes, one edit.
query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\xe4b8ad'::bytea) ORDER BY id
----
id
7

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\xc3a9'::bytea) ORDER BY id
----
id
4

statement ok
SET sdb_levenshtein_max_terms = 1

query
SELECT id FROM lev_bin WHERE v @@ ts_levenshtein('\xc3a9'::bytea, 1) ORDER BY id
----
id
4

statement ok
RESET sdb_levenshtein_max_terms

query
SELECT id FROM lev_bin WHERE v @@ (ts_like('\x25a9'::bytea) && ts_levenshtein('\xc3a8'::bytea, 1)) ORDER BY id
----
id
4

query
EXPLAIN SELECT id FROM lev_bin WHERE v @@ (ts_like('\x25a9'::bytea) && ts_levenshtein('\xc3a8'::bytea, 1))
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────────────╮
│ Table: lev_bin                             │
│ Index Filter:                              │
│ ╭─ And ────────────╮                       │
│ ╰─────────┬────────╯                       │
│           ├─────────────────────╮          │
│ ╭─ Automaton ──────╮  ╭─ Levenshtein ────╮ │
│ │ Field: v(string) │  │ Field: v(string) │ │
│ │ Pattern: %\\xa9   │  │ Target: \\xc3\\xa8 │ │
│ ╰──────────────────╯  │ Max Terms: 50    │ │
│                       ╰──────────────────╯ │
│ Projections: id                            │
│ ~1 row                                     │
╰────────────────────────────────────────────╯

statement ok
CREATE TEXT SEARCH DICTIONARY lev_bin_words AS split_text(case := 'lower') WITH (frequency, position)

statement ok
CREATE TABLE lev_txt(id INTEGER PRIMARY KEY, body VARCHAR)

statement ok
CREATE INDEX lev_txt_idx ON lev_txt USING inverted(id, body lev_bin_words)

statement ok
INSERT INTO lev_txt VALUES (1, 'the quick fox'), (2, 'a b'), (3, 'quick x')

query
SELECT id FROM lev_txt WHERE body @@ ts_levenshtein('\xff'::bytea, 1) ORDER BY id
----
id
2
3

query
SELECT id FROM lev_txt WHERE body @@ ts_levenshtein('\xff61'::bytea, 1) ORDER BY id
----
id
2

query
SELECT id FROM lev_txt WHERE body @@ ('quick' ## ts_levenshtein('\xff'::bytea, 1)) ORDER BY id
----
id
3

# Each byte of a sequence cut short is a character, so `qu` is two edits away.
query
SELECT id FROM lev_txt WHERE body @@ ts_levenshtein('\x7175e4b8'::bytea, 1, starts_with := true) ORDER BY id
----
id

query
SELECT id FROM lev_txt WHERE body @@ ts_levenshtein('\x7175e4b8'::bytea, 2, starts_with := true) ORDER BY id
----
id
1
3

statement ok
CREATE TABLE lev_kw(id INTEGER PRIMARY KEY, k VARCHAR)

statement ok
CREATE INDEX lev_kw_idx ON lev_kw USING inverted(id, k)

statement ok
INSERT INTO lev_kw VALUES (1, 'qu中文'), (2, 'quick'), (3, 'é'), (4, 'e')

query
SELECT id FROM lev_kw WHERE k @@ ts_levenshtein('\xc3a9'::bytea, 1) ORDER BY id
----
id
3

query
SELECT id FROM lev_kw WHERE k @@ ts_levenshtein('é', 1) ORDER BY id
----
id
3
4

query
SELECT id FROM lev_kw WHERE k @@ ts_levenshtein('x', 1, prefix := '\xc3'::bytea) ORDER BY id
----
id
3

# `qé` is three bytes, so the automatic distance is 1.
query
SELECT id FROM lev_kw WHERE k @@ ts_levenshtein('\x71c3a9'::bytea) ORDER BY id
----
id
3

# Cut short, `中` is still two bytes `qu中文` starts with.
query
SELECT id FROM lev_kw WHERE k @@ ts_levenshtein('\x7175e4b8'::bytea, 0, starts_with := true) ORDER BY id
----
id
1

query
SELECT id FROM lev_kw WHERE k @@ ts_levenshtein('\x7175e4b8'::bytea, 1, starts_with := true) ORDER BY id
----
id
1

query
SELECT id
FROM lev_kw_idx
WHERE k @@ ts_levenshtein('\x7175e4b8'::bytea, 0, starts_with := true)
ORDER BY BM25(lev_kw_idx.tableoid) DESC, id
----
id
1
