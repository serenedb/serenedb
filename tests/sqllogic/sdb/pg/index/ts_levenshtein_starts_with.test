# A TSQUERY parameter written as text keeps the named argument.
statement ok
PREPARE sw_match AS SELECT id FROM sw_idx WHERE body @@ $1 ORDER BY id

query
EXECUTE sw_match('ts_levenshtein(''quik'', 1, starts_with := true)')
----
id
1
2
4

query
EXECUTE sw_match('ts_levenshtein(''quik'', 1)')
----
id
1

statement ok
DEALLOCATE sw_match

# A NULL argument makes the whole match NULL, which no row satisfies.
query
SELECT id FROM sw_idx WHERE body @@ ts_levenshtein('quik', 1, starts_with := NULL)
----
id

statement error
SELECT id FROM sw_idx WHERE body @@ ts_levenshtein('quik', 1, starts_with := 'maybe')
----
db error: ERROR: ts_levenshtein starts_with must be a BOOLEAN constant
HINT: Example: ts_levenshtein('test', 1, true, 'pre'). Distance must be 0-4 (0-3 with transpositions). Optional `prefix` matches exactly. If distance is omitted (ts_levenshtein('test')), it is picked automatically from the term length (0 for <=2 chars, 1 for 3-5, 2 for >=6). `starts_with := true` matches the terms that start within the distance of the text.


statement error
SELECT id FROM sw_idx WHERE body @@ ts_levenshtein('quik', 1, startswith := true)
----
db error: ERROR: ts_levenshtein has no argument named startswith
HINT: Example: ts_levenshtein('test', 1, true, 'pre'). Distance must be 0-4 (0-3 with transpositions). Optional `prefix` matches exactly. If distance is omitted (ts_levenshtein('test')), it is picked automatically from the term length (0 for <=2 chars, 1 for 3-5, 2 for >=6). `starts_with := true` matches the terms that start within the distance of the text.
