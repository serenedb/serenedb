# 'run' reaches terms the fuzzy match scores below 1, so the OR stays.
query
EXPLAIN SELECT unnest(ts_dict_agg(kw)) AS t
FROM swo_idx
WHERE kw @@ (ts_starts_with('run') || ts_levenshtein('runin', 1, starts_with := true))
----
