# Matching documents, the capped fuzzy match keeps only its closest terms,
# while the exact prefix keeps all of its own: the OR stays.
query
SELECT id
FROM swo_idx
WHERE kw @@ (ts_starts_with('runin') || ts_levenshtein('runin', 1, starts_with := true))
ORDER BY id
----
id
1
2
3
4
5

