# A whole-term fuzzy match accepts only its own text at distance 0.
query
SELECT unnest(ts_dict_agg(kw))   AS t,
       unnest(ts_dict_score(kw)) AS s
FROM swo_idx
WHERE kw @@ (ts_any(['runin']) || ts_levenshtein('runin', 1))
ORDER BY s DESC, t
----
t	s
runin	1
runing	0.8
ruin	0.75

query
EXPLAIN SELECT unnest(ts_dict_agg(kw)) AS t
FROM swo_idx
WHERE kw @@ (ts_any(['runin']) || ts_levenshtein('runin', 1))
----
