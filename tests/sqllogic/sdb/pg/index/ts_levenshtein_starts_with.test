# A backslash makes `*` and `~` part of the word, which the column's
# dictionary then analyzes: split on spaces it stays one token, a word
# segmenter drops the punctuation. ts_phrase and phraseto_tsquery read no
# syntax, so they search the same words unescaped.
statement ok
CREATE TEXT SEARCH DICTIONARY sw_spaces AS
    split_text_csv(' ') WITH (frequency, position)

statement ok
CREATE TABLE swe(id INTEGER PRIMARY KEY, words VARCHAR, raw VARCHAR)

statement ok
CREATE INDEX swe_idx ON swe USING inverted(id, words sw_words, raw sw_spaces)

statement ok
INSERT INTO swe VALUES
  (1, 'quck brwn*~1', 'quck brwn*~1'),
  (2, 'quck brown', 'quck brown'),
  (3, 'quck brwn 1', 'quck brwn 1')

query
SELECT id
FROM swe_idx
WHERE raw @@ to_tsquery('"quck brwn*~1"')
ORDER BY id
----
id
1
2
3

query
SELECT id
FROM swe_idx
WHERE raw @@ to_tsquery('"quck brwn\*\~1"')
ORDER BY id
----
id
1

query
SELECT id
FROM swe_idx
WHERE raw @@ to_tsquery('brwn\*\~1')
ORDER BY id
----
id
1

query
SELECT id
FROM swe_idx
WHERE raw @@ ts_phrase('quck brwn*~1')
ORDER BY id
----
id
1

query
SELECT id
FROM swe_idx
WHERE raw @@ phraseto_tsquery('quck brwn*~1')
ORDER BY id
----
id
1

query
SELECT id
FROM swe_idx
WHERE words @@ to_tsquery('"quck brwn*~1"')
ORDER BY id
----
id
1
2
3

query
SELECT id
FROM swe_idx
WHERE words @@ to_tsquery('"quck brwn\*\~1"')
ORDER BY id
----
id
1
3

query
SELECT id
FROM swe_idx
WHERE words @@ to_tsquery('brwn\*\~1')
ORDER BY id
----
id
1
3

query
SELECT id
FROM swe_idx
WHERE words @@ ts_phrase('quck brwn*~1')
ORDER BY id
----
id
1
3

query
SELECT id
FROM swe_idx
WHERE words @@ phraseto_tsquery('quck brwn*~1')
ORDER BY id
----
id
1
3

