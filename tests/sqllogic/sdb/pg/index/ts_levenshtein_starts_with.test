query
EXPLAIN SELECT id
FROM sw_idx
WHERE body @@ ('the' ## ts_levenshtein('quik', 1, starts_with := true))
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────────────────────────────╮
│ Index: sw_idx                                                   │
│ Lookup: search                                                  │
