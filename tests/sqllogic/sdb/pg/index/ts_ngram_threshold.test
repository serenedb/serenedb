statement ok
CREATE TEXT SEARCH DICTIONARY tnt_bigram AS generate_ngrams(2, 2) WITH (frequency, position);

statement ok
CREATE TABLE tnt_titles (id INTEGER PRIMARY KEY, title VARCHAR);

statement ok
CREATE INDEX tnt_titles_idx ON tnt_titles USING inverted (id, title tnt_bigram);

statement ok
