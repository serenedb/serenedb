hash-threshold 100

statement ok
CREATE TEXT SEARCH DICTIONARY rx_dict AS
    generate_wildcard_ngrams(keyword(), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY rx_pos_dict AS
    generate_wildcard_ngrams(keyword(), 3)
    WITH (frequency, position)

statement ok
CREATE TEXT SEARCH DICTIONARY rx_dict2 AS
    generate_wildcard_ngrams(keyword(), 2)

statement ok
CREATE TEXT SEARCH DICTIONARY rx_words_dict AS
    generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TABLE rx_t (id BIGINT PRIMARY KEY, v VARCHAR)

statement ok
INSERT INTO rx_t VALUES
    (1, 'abc'),
    (2, 'xabcx'),
    (3, 'alpha'),
    (4, 'ab'),
    (5, 'ABC'),
    (6, 'abc' || chr(10) || 'd'),
    (7, 'foobar'),
    (8, 'foobaz'),
    (9, 'FooBar'),
    (10, chr(1089) || chr(1086) || chr(1073) || chr(1072) || chr(1082) || chr(1072)),
    (11, chr(1057) || chr(1086) || chr(1073) || chr(1072) || chr(1082) || chr(1072)),
    (12, ''),
    (13, NULL),
    (14, 'a' || chr(31) || 'b'),
    (15, 'gray'),
    (16, 'grey'),
    (17, 'hello world'),
    (18, 'the quick brown fox'),
    (19, 'abcabcabc'),
    (20, 'xyz123')

statement ok
CREATE INDEX rx_idx ON rx_t USING inverted(id, v rx_dict)

statement ok
CREATE INDEX rx_pos_idx ON rx_t USING inverted(id, v rx_pos_dict)

statement ok
CREATE INDEX rx_idx2 ON rx_t USING inverted(id, v rx_dict2)

statement ok
CREATE INDEX rx_words_idx ON rx_t USING inverted(id, v rx_words_dict)

statement ok
VACUUM (REFRESH_TABLE) rx_t

statement ok
INSERT INTO rx_t VALUES
    (21, 'user@example.com'),
    (22, 'admin@example.org'),
    (23, 'aaa'),
    (24, 'a'),
    (25, 'x'),
    (26, 'xx'),
    (27, 'prefix_common_1'),
    (28, 'prefix_common_2'),
    (29, 'suffix_end'),
    (30, 'other_end'),
    (31, chr(1078) || chr(1091) || chr(1082)),
    (32, chr(1046) || chr(1059) || chr(1050)),
    (33, 'abcdefghijklmnopqrstuvwxyz0123456789'),
    (34, 'aa'),
    (35, 'abab')

statement ok
VACUUM (REFRESH_TABLE) rx_t

# Through the index and by regexp_full_match over the table: no row on one
# side only.

query
SELECT count(*) FROM (
    (SELECT id FROM rx_idx WHERE v @@ ts_regexp('abc')
     EXCEPT SELECT id FROM rx_t WHERE regexp_full_match(v, 'abc'))
    UNION ALL
    (SELECT id FROM rx_t WHERE regexp_full_match(v, 'abc')
     EXCEPT SELECT id FROM rx_idx WHERE v @@ ts_regexp('abc'))
) t
----
count
0

