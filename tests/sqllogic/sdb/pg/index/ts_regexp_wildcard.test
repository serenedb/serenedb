    (SELECT id FROM rx_idx WHERE v @@ ts_regexp('.*abc.*') OR v @@ ts_regexp('x.*x')
     EXCEPT SELECT id FROM rx_t WHERE regexp_full_match(v, '.*abc.*') OR regexp_full_match(v, 'x.*x'))
    UNION ALL
    (SELECT id FROM rx_t WHERE regexp_full_match(v, '.*abc.*') OR regexp_full_match(v, 'x.*x')
     EXCEPT SELECT id FROM rx_idx WHERE v @@ ts_regexp('.*abc.*') OR v @@ ts_regexp('x.*x'))
) t
----
count
0

