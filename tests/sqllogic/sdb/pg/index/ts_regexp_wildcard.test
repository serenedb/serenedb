# A pattern RE2 rejects matches nothing, and its negation every row with a
# value.

query
SELECT count(*) FROM rx_idx WHERE v @@ ts_regexp('(')
----
count
0

query
SELECT count(*) FROM rx_idx WHERE NOT (v @@ ts_regexp('('))
----
count
34

query
SELECT count(*) FROM rx_idx WHERE v @@ ts_regexp('foo\')
----
count
0

query
SELECT count(*) FROM rx_idx WHERE NOT (v @@ ts_regexp('foo\'))
----
count
34

# Per term on a dictionary that splits values into words.

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('hello') ORDER BY id
----
id
17

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('.*o') ORDER BY id
----
id
17

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('qu.*') ORDER BY id
----
id
18

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('(?i)FOX') ORDER BY id
----
id
18

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('w.r.d') ORDER BY id
----
id
17

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('brown fox') ORDER BY id
----
id

query
SELECT id FROM rx_words_idx WHERE v @@ ts_regexp('.*_end') ORDER BY id
