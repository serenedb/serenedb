30

# Every element of a list is a term.
statement ok
CREATE TABLE rx_list (id BIGINT PRIMARY KEY, tags VARCHAR[])

statement ok
INSERT INTO rx_list VALUES
    (1, ['abc', 'xyz']),
    (2, ['foo', 'abcd']),
    (3, []),
    (4, NULL),
    (5, ['xabc', NULL])

statement ok
CREATE INDEX rx_list_idx ON rx_list USING inverted(id, tags rx_dict)

statement ok
VACUUM (REFRESH_TABLE) rx_list

query
SELECT id FROM rx_list_idx WHERE tags @@ ts_regexp('abc') ORDER BY id
----
id
1

query
SELECT id FROM rx_list_idx WHERE tags @@ ts_regexp('abc.*') ORDER BY id
----
id
1
2

query
SELECT id FROM rx_list_idx WHERE tags @@ ts_regexp('.*abc') ORDER BY id
----
id
1
5

query
SELECT id FROM rx_list_idx WHERE tags @@ ts_regexp('xyz|foo') ORDER BY id
----
id
1
2

