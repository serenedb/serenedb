statement ok
CREATE TABLE vtw (id INTEGER PRIMARY KEY, emb FLOAT[2], tag VARCHAR)
  WITH (storage = 'search', compaction_interval = 0);

statement ok
CREATE INDEX vtw_idx ON vtw
  USING inverted(id, tag, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO vtw SELECT i, [i::FLOAT, 0]::FLOAT[2],
  CASE WHEN i % 2 = 0 THEN 'even' ELSE 'odd' END FROM range(0, 1000) t(i);

statement ok
VACUUM (REFRESH_TABLE) vtw;

statement ok
