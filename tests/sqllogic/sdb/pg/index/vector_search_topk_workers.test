count
4000

query
SELECT id FROM vtw ORDER BY emb <-> [1999.6, 0]::FLOAT[2] LIMIT 3;
----
id
2000
1999
2001

query
SELECT id FROM vtw WHERE tag = 'odd'
  ORDER BY emb <-> [1999.6, 0]::FLOAT[2] LIMIT 3;
----
id
1999
2001
1997

query
SELECT count(*), min(id), max(id) FROM (
  SELECT id FROM vtw ORDER BY emb <-> [0.4, 0]::FLOAT[2] LIMIT 2100);
----
count	min	max
2100	0	2099

query
SELECT count(*), min(id), max(id) FROM (
  SELECT id FROM vtw WHERE tag = 'even'
    ORDER BY emb <-> [0.4, 0]::FLOAT[2] LIMIT 2100);
----
count	min	max
2000	0	3998

query
SELECT id FROM (
  SELECT id, row_number() OVER () AS r FROM (
    SELECT id FROM vtw ORDER BY emb <-> [0.4, 0]::FLOAT[2] LIMIT 2100))
  WHERE r IN (1, 2049, 2100) ORDER BY r;
----
id
0
2048
2099

