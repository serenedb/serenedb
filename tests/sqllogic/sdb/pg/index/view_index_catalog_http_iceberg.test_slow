CREATE TEXT SEARCH DICTIONARY vch_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vch_t (id INTEGER, body TEXT);

