CREATE VIEW vch_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vch_t;

statement ok
CREATE INDEX vch_stored_idx ON vch_v USING inverted(id, body vch_en) INCLUDE (id, body) WITH (compaction_interval=0);

statement ok
CREATE INDEX vch_lookup_idx ON vch_v USING inverted(id, body vch_en) WITH (compaction_interval=0);

statement ok
CREATE TABLE vch_http_mark AS
SELECT count(*) AS n FROM duckdb_logs_parsed('HTTP') WHERE connection_id = current_connection_id();

