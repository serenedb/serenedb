CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.meme_t (
  pepe_id VARCHAR, doge_tenant VARCHAR, wojak_source VARCHAR, chad_kind VARCHAR,
  nyan_page INTEGER, trollface_path VARCHAR, stonks_text TEXT, rickroll_emb FLOAT[]);

statement count 6
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.meme_t VALUES
  ('p1', 'much', 'wow.pdf', 'pdf', 1, 'a > b', 'stonks to the moon', [1, 0, 0, 0]),
  ('p2', 'much', 'wow.pdf', 'pdf', 2, 'a > c', 'hodl the line', [0, 1, 0, 0]),
  ('p3', 'much', 'such.md', 'md', 1, 'x > y', 'moon landing was fake', [0.9, 0.1, 0, 0]),
  ('p4', 'very', 'wow.pdf', 'pdf', 1, 'a > b', 'to the moon again', [1, 0, 0, 0]),
  ('p5', 'very', 'amaze.txt', 'txt', 3, 'z', 'nothing to see here', [0, 0, 1, 0]),
  ('p6', 'much', 'amaze.txt', 'txt', 4, 'z > q', 'never gonna give you up', [0, 0, 0, 1]);

statement ok
CREATE VIEW meme_v AS
SELECT pepe_id, doge_tenant, wojak_source, chad_kind, nyan_page, trollface_path, stonks_text,
       CAST(rickroll_emb AS FLOAT[4]) AS rickroll_emb
FROM srv_${__DATABASE__}.${__DATABASE__}.meme_t;

statement ok
CREATE INDEX meme_idx ON meme_v USING inverted (
  pepe_id, doge_tenant, wojak_source, chad_kind, nyan_page, trollface_path,
  stonks_text vch_en,
  rickroll_emb ivf (metric = 'cosine'))
INCLUDE (pepe_id, doge_tenant, wojak_source, chad_kind, nyan_page, trollface_path, stonks_text)
WITH (compaction_interval=0);

statement ok
CREATE TABLE meme_http_mark AS
SELECT count(*) AS n FROM duckdb_logs_parsed('HTTP') WHERE connection_id = current_connection_id();

query
WITH fused AS (
    SELECT pepe_id, wojak_source, nyan_page, RANK() OVER (ORDER BY s DESC) AS rank FROM (
        SELECT pepe_id, wojak_source, nyan_page, BM25(meme_idx.tableoid) AS s
        FROM meme_idx
        WHERE doge_tenant = 'much' AND stonks_text @@ 'moon'
        ORDER BY s DESC LIMIT 50
    ) lex
    UNION ALL
    SELECT pepe_id, wojak_source, nyan_page, RANK() OVER (ORDER BY dist) AS rank FROM (
        SELECT pepe_id, wojak_source, nyan_page, rickroll_emb <=> [1, 0, 0, 0]::FLOAT[4] AS dist
        FROM meme_idx
        WHERE doge_tenant = 'much'
        ORDER BY dist LIMIT 50
    ) vec
)
SELECT pepe_id, ANY_VALUE(wojak_source) AS wojak_source, ANY_VALUE(nyan_page) AS nyan_page
FROM fused
GROUP BY pepe_id
ORDER BY SUM(1.0 / (60 + rank)) DESC, pepe_id
LIMIT 3;
----
pepe_id	wojak_source	nyan_page
p1	wow.pdf	1
p3	such.md	1
p2	wow.pdf	2

query
SELECT pepe_id, trollface_path FROM meme_idx
WHERE doge_tenant = 'much'
ORDER BY rickroll_emb <=> [1, 0, 0, 0]::FLOAT[4]
LIMIT 2;
----
pepe_id	trollface_path
p1	a > b
p3	x > y

