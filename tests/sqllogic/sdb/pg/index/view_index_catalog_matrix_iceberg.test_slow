control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vcm_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vcm_t (id INTEGER, body TEXT);

statement count 2
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vcm_t VALUES (1, 'pudge alpha'), (2, 'anchin alpha');

statement count 2
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vcm_t VALUES (3, 'techies beta'), (4, 'mines beta');

statement ok
CREATE VIEW vcm_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vcm_t;

statement ok
CREATE INDEX vcm_idx ON vcm_v USING inverted(id, body vcm_en) WITH (compaction_interval=0);

query
SELECT id, body FROM vcm_idx ORDER BY id;
----
id	body
1	pudge alpha
2	anchin alpha
3	techies beta
4	mines beta

query
SELECT * FROM serenedb_reindex('vcm_idx');
----
action	files_added	files_changed	files_removed	files_rescanned
up_to_date	0	0	0	0

