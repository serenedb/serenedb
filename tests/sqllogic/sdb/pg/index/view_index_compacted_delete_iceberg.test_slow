control substitution on

# A delta masks a changed file by re-paying its whole dead-row set, seeking each
# dead row's primary-key term in turn. Compaction physically drops the terms of
# rows masked earlier, so those seeks miss -- and a seek that does not land on
# its term advances the iterator internally. Reusing it for the remaining dead
# rows of the file then skips one, and the row stays in the index for good.
#
# No background loop and no timing: the reindex and the compaction are both
# explicit, so the sequence below either loses row 1908 or it does not.

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER cmd FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE SCHEMA cmd.${__DATABASE__};

statement ok
CREATE TABLE cmd.${__DATABASE__}.t (id INTEGER, body TEXT);

statement ok
CREATE TEXT SEARCH DICTIONARY cmd_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

# One file per snapshot, so a file's rows are a contiguous key range and the
# merged term dictionary spans several blocks.

statement count 175
INSERT INTO cmd.${__DATABASE__}.t SELECT s, 'doc ' || s FROM generate_series(1, 175) t(s);

