statement count 175
INSERT INTO cmd.${__DATABASE__}.t SELECT s, 'doc ' || s FROM generate_series(3326, 3500) t(s);

statement ok
CREATE VIEW cmd_v AS SELECT * FROM cmd.${__DATABASE__}.t;

statement ok
CREATE INDEX cmd_idx ON cmd_v USING inverted(id, body cmd_en) WITH (reindex_interval=0, compaction_interval=0);

query
SELECT count(*) FROM cmd_idx;
----
count
3500

