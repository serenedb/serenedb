CREATE VIEW vdr_v AS SELECT id AS doc_id, body AS text FROM srv_${__DATABASE__}.${__DATABASE__}.vdr_t;

statement ok
CREATE INDEX vdr_idx ON vdr_v USING inverted(doc_id, text vdr_en);

