control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vdr_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vdr_t (id INTEGER, body TEXT);

statement count 3
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vdr_t VALUES (1, 'pudge goes mid'), (2, 'arrives before the restart'), (3, 'lands after the restart');

statement ok
CREATE VIEW vdr_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vdr_t;

statement ok
CREATE INDEX vdr_idx ON vdr_v USING inverted(id, body vdr_en);

query
SELECT id FROM vdr_idx WHERE body @@ ts_phrase('restart') ORDER BY id;
----
id
2
3

statement ok
DROP INDEX vdr_idx;

statement error
