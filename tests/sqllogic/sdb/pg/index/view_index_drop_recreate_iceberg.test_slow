query
SELECT count(*) FROM (
  (SELECT id, body FROM vdr_idx EXCEPT SELECT id, body FROM srv_${__DATABASE__}.${__DATABASE__}.vdr_t)
  UNION ALL
  (SELECT id, body FROM srv_${__DATABASE__}.${__DATABASE__}.vdr_t EXCEPT SELECT id, body FROM vdr_idx)
);
