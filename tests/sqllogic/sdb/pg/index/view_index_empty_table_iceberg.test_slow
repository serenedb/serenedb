control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vet_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vet_t (id INTEGER, body TEXT);

statement ok
CREATE VIEW vet_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vet_t;

statement ok
CREATE INDEX vet_idx ON vet_v USING inverted(id, body vet_en) WITH (compaction_interval=0);

query
SELECT count(*) FROM vet_idx;
----
count
0

query
SELECT id FROM vet_idx WHERE body @@ ts_phrase('pudge');
----
id

