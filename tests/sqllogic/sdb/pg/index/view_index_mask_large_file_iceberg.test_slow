control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vml_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.v2 (id INTEGER, body TEXT);

statement count 3000
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.v2 SELECT s, 'doc ' || s FROM generate_series(1, 3000) t(s);

statement ok
CREATE VIEW vml_v2 AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.v2;

statement ok
CREATE INDEX vml_v2_idx ON vml_v2 USING inverted(id, body vml_en) WITH (compaction_interval=0);

statement count 1
DELETE FROM srv_${__DATABASE__}.${__DATABASE__}.v2 WHERE id = 1;

query
SELECT action, files_added, files_changed FROM serenedb_reindex('vml_v2_idx');
----
action	files_added	files_changed
delta	0	1

query
SELECT count(*) FROM vml_v2_idx WHERE id = 1;
----
count
0

query
SELECT count(*) FROM vml_v2_idx;
----
count
2999

