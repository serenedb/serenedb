control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vmm_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.a (id INTEGER, body TEXT);

statement count 3000
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.a SELECT s, 'doc ' || s FROM generate_series(1, 3000) t(s);

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.b (id INTEGER, body TEXT);

statement count 3000
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.b SELECT s, 'doc ' || s FROM generate_series(1, 3000) t(s);

statement ok
CREATE VIEW vmm_a AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.a;

statement ok
CREATE VIEW vmm_b AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.b;

statement ok
CREATE INDEX vmm_loop_idx ON vmm_a USING inverted(id, body vmm_en) WITH (reindex_interval=200, compaction_interval=0);

statement ok
CREATE INDEX vmm_kw_idx ON vmm_b USING inverted(id, body vmm_en) WITH (compaction_interval=0);

