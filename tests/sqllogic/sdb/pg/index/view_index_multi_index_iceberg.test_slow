control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vmi_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vmi_t (id INTEGER, title TEXT, body TEXT);

statement count 3
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vmi_t VALUES
  (1, 'first title', 'pudge goes mid'),
  (2, 'second title', 'arrives before the restart'),
  (3, 'third title', 'lands after the restart');

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vmi_u (id INTEGER, body TEXT);

statement count 2
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vmi_u VALUES (10, 'techies mines the jungle'), (11, 'mines everywhere');

statement ok
CREATE VIEW vmi_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vmi_t;

statement ok
CREATE VIEW vmi_u_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vmi_u;

statement ok
CREATE INDEX vmi_idx_body ON vmi_v USING inverted(id, body vmi_en) WITH (compaction_interval=0);

statement ok
CREATE INDEX vmi_idx_title ON vmi_v USING inverted(id, title vmi_en) WITH (compaction_interval=0);

statement ok
CREATE INDEX vmi_idx_u ON vmi_u_v USING inverted(id, body vmi_en) WITH (compaction_interval=0);

query
SELECT id FROM vmi_idx_body WHERE body @@ ts_phrase('restart') ORDER BY id;
