id
2
3

query
SELECT id, title FROM vmi_idx_title WHERE title @@ ts_phrase('second');
----
id	title
2	second title

query
SELECT title, body FROM vmi_idx_body WHERE id = 3;
----
title	body
third title	lands after the restart

query
SELECT id FROM vmi_idx_u WHERE body @@ ts_phrase('mines') ORDER BY id;
----
id
