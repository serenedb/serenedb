control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vqs_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vqs_t (id INTEGER, category TEXT, body TEXT);

statement count 3
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vqs_t VALUES
  (1, 'hero', 'pudge goes mid'),
  (2, 'hero', 'pudge hooks the courier'),
  (3, 'item', 'blink dagger for pudge');

statement count 3
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vqs_t VALUES
  (4, 'hero', 'techies mines the jungle'),
  (5, 'item', 'boots of travel'),
  (6, 'item', 'aghanim scepter for pudge');

statement ok
CREATE VIEW vqs_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vqs_t;

statement ok
CREATE INDEX vqs_idx ON vqs_v USING inverted(id, body vqs_en) WITH (compaction_interval=0);

statement ok
CREATE TABLE vqs_tags (id INTEGER, tag TEXT);

statement ok
INSERT INTO vqs_tags VALUES (1, 'classic'), (3, 'mobility'), (6, 'late');

query
SELECT * FROM vqs_idx WHERE body @@ ts_phrase('pudge') ORDER BY id;
----
id	category	body
1	hero	pudge goes mid
2	hero	pudge hooks the courier
3	item	blink dagger for pudge
6	item	aghanim scepter for pudge

query
SELECT count(*) FROM vqs_idx WHERE body @@ ts_phrase('pudge');
----
count
4

query
SELECT id, body FROM vqs_idx ORDER BY id DESC LIMIT 2;
----
id	body
6	aghanim scepter for pudge
5	boots of travel

query
SELECT category, count(*) FROM vqs_idx GROUP BY category ORDER BY category;
----
category	count
hero	3
item	3

query
SELECT category, count(*) FROM vqs_idx WHERE body @@ ts_phrase('pudge') GROUP BY category ORDER BY category;
----
category	count
hero	2
item	2

query
SELECT id FROM vqs_idx WHERE id IN (2, 5) ORDER BY id;
----
id
2
5

query
SELECT body FROM vqs_idx WHERE id = 3;
----
body
blink dagger for pudge

query
SELECT id FROM vqs_idx WHERE id BETWEEN 2 AND 4 ORDER BY id;
----
id
2
3
4

query
SELECT i.id, t.tag FROM vqs_idx i JOIN vqs_tags t USING (id) WHERE i.body @@ ts_phrase('pudge') ORDER BY i.id;
----
id	tag
1	classic
3	mobility
6	late

query
SELECT id FROM vqs_idx WHERE body @@ ts_phrase('pudge') AND category = 'item' ORDER BY id;
----
id
3
6

query
SELECT count(*) FROM (
  (SELECT id, category, body FROM vqs_idx EXCEPT SELECT id, category, body FROM srv_${__DATABASE__}.${__DATABASE__}.vqs_t)
  UNION ALL
  (SELECT id, category, body FROM srv_${__DATABASE__}.${__DATABASE__}.vqs_t EXCEPT SELECT id, category, body FROM vqs_idx)
);
----
count
0

