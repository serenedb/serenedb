statement ok
CREATE VIEW vrm_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.t;

statement ok
CREATE INDEX vrm_call_idx ON vrm_v USING inverted(id, body vrm_en) WITH (compaction_interval=0);

statement ok
