CREATE VIEW vrs_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vrs_t;

statement ok
CREATE INDEX vrs_idx ON vrs_v USING inverted(id, body vrs_en) WITH (compaction_interval=0);

