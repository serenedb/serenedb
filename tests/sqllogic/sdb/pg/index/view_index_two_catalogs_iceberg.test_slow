control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_a_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE SERVER srv_b_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vtc_en(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'none',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE SCHEMA srv_a_${__DATABASE__}.${__DATABASE__}_a;

statement ok
CREATE SCHEMA srv_b_${__DATABASE__}.${__DATABASE__}_b;

statement ok
CREATE TABLE srv_a_${__DATABASE__}.${__DATABASE__}_a.docs (id INTEGER, body TEXT);

statement ok
CREATE TABLE srv_b_${__DATABASE__}.${__DATABASE__}_b.docs (id INTEGER, body TEXT);

statement count 2
INSERT INTO srv_a_${__DATABASE__}.${__DATABASE__}_a.docs VALUES (1, 'pudge in catalog a'), (2, 'anchin in catalog a');

statement count 2
INSERT INTO srv_b_${__DATABASE__}.${__DATABASE__}_b.docs VALUES (1, 'pudge in catalog b'), (3, 'techies in catalog b');

statement ok
CREATE VIEW vtc_a_v AS SELECT * FROM srv_a_${__DATABASE__}.${__DATABASE__}_a.docs;

statement ok
CREATE VIEW vtc_b_v AS SELECT * FROM srv_b_${__DATABASE__}.${__DATABASE__}_b.docs;

statement ok
CREATE INDEX vtc_a_idx ON vtc_a_v USING inverted(id, body vtc_en) WITH (compaction_interval=0);

statement ok
CREATE INDEX vtc_b_idx ON vtc_b_v USING inverted(id, body vtc_en) WITH (compaction_interval=0);

query
SELECT id, body FROM vtc_a_idx WHERE body @@ ts_phrase('pudge');
----
id	body
1	pudge in catalog a

query
SELECT id, body FROM vtc_b_idx WHERE body @@ ts_phrase('pudge');
----
id	body
1	pudge in catalog b

query
SELECT body FROM vtc_a_idx WHERE id = 1;
----
body
pudge in catalog a

query
SELECT body FROM vtc_b_idx WHERE id = 1;
----
body
pudge in catalog b

query
SELECT count(*) FROM vtc_a_idx WHERE body @@ ts_phrase('techies');
----
count
0

query
SELECT id FROM vtc_b_idx WHERE body @@ ts_phrase('techies');
----
id
3

statement count 1
INSERT INTO srv_b_${__DATABASE__}.${__DATABASE__}_b.docs VALUES (4, 'mines in catalog b');

