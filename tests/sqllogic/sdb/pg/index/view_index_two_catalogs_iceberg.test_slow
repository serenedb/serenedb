query
SELECT count(*) FROM (
  (SELECT id, body FROM vtc_a_idx EXCEPT SELECT id, body FROM srv_a_${__DATABASE__}.${__DATABASE__}_a.docs)
  UNION ALL
  (SELECT id, body FROM srv_a_${__DATABASE__}.${__DATABASE__}_a.docs EXCEPT SELECT id, body FROM vtc_a_idx)
  UNION ALL
  (SELECT id, body FROM vtc_b_idx EXCEPT SELECT id, body FROM srv_b_${__DATABASE__}.${__DATABASE__}_b.docs)
  UNION ALL
  (SELECT id, body FROM srv_b_${__DATABASE__}.${__DATABASE__}_b.docs EXCEPT SELECT id, body FROM vtc_b_idx)
);
