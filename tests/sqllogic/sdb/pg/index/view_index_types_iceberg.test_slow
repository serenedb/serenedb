tag
d

query
SELECT id FROM vty_idx WHERE body @@ ts_phrase('pudge') AND flag;
----
id
1

query
SELECT count(*) FROM (
  (SELECT id, ts, score, flag, tag, body FROM vty_idx EXCEPT SELECT id, ts, score, flag, tag, body FROM srv_${__DATABASE__}.${__DATABASE__}.vty_t)
  UNION ALL
  (SELECT id, ts, score, flag, tag, body FROM srv_${__DATABASE__}.${__DATABASE__}.vty_t EXCEPT SELECT id, ts, score, flag, tag, body FROM vty_idx)
);
----
count
0

