control substitution on

statement ok retry 20 backoff 250ms
${ICEBERG_BOOTSTRAP}

statement ok
CREATE SERVER srv_${__DATABASE__} FOREIGN DATA WRAPPER iceberg_fdw OPTIONS (${ICEBERG_SERVER_OPTIONS});

statement ok
CREATE TEXT SEARCH DICTIONARY vty_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE SCHEMA srv_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE srv_${__DATABASE__}.${__DATABASE__}.vty_t (id BIGINT, ts TIMESTAMP, score DOUBLE, flag BOOLEAN, tag VARCHAR, body TEXT);

statement count 5
INSERT INTO srv_${__DATABASE__}.${__DATABASE__}.vty_t VALUES
  (1, TIMESTAMP '2026-01-02 03:04:05', 1.5, true, 'a', 'pudge goes mid'),
  (2, NULL, NULL, false, NULL, NULL),
  (3, TIMESTAMP '2026-02-03 04:05:06', -2.25, NULL, 'b', ''),
  (4, TIMESTAMP '2026-03-04 05:06:07', 0, true, 'c', 'привет мир grüße aus münchen'),
  (1099511627776, TIMESTAMP '2026-04-05 06:07:08', 3, false, 'd', repeat('lorem ', 2000) || 'needle');

statement ok
CREATE VIEW vty_v AS SELECT * FROM srv_${__DATABASE__}.${__DATABASE__}.vty_t;

statement ok
CREATE INDEX vty_idx ON vty_v USING inverted(id, body vty_en) WITH (compaction_interval=0);

query
SELECT count(*) FROM vty_idx;
----
count
5

query
SELECT id, ts, flag, tag FROM vty_idx ORDER BY id;
----
id	ts	flag	tag
1	2026-01-02 03:04:05	t	a
2	NULL	f	NULL
3	2026-02-03 04:05:06	NULL	b
4	2026-03-04 05:06:07	t	c
1099511627776	2026-04-05 06:07:08	f	d

query
SELECT id, score FROM vty_idx WHERE id IN (1, 3) ORDER BY id;
----
id	score
1	1.5
3	-2.25

query
SELECT id, body FROM vty_idx WHERE id IN (2, 3) ORDER BY id;
----
id	body
2	NULL
3	(empty)

query
SELECT id FROM vty_idx WHERE body @@ ts_phrase('привет');
----
id
4

query
SELECT id FROM vty_idx WHERE body @@ ts_phrase('münchen');
