# Where each deferred wildcard and regexp shape is checked. Their answers are
# compared with the table itself in wildcard_deferred_matrix.gen.test, which
# tests/sqllogic/generators/sdb/pg/index/wildcard_deferred_matrix.py generates.

statement ok
CREATE TEXT SEARCH DICTIONARY wdm_kw3 AS generate_wildcard_ngrams(keyword(), 3)

statement ok
CREATE TEXT SEARCH DICTIONARY wdm_kw3_pos AS generate_wildcard_ngrams(keyword(), 3) WITH (frequency, position)

statement ok
CREATE TEXT SEARCH DICTIONARY wdm_words AS generate_wildcard_ngrams(split_text_csv(' '), 3)

statement ok
CREATE TABLE wdm (id INTEGER PRIMARY KEY, x INTEGER, msg VARCHAR, tags VARCHAR[])

statement ok
INSERT INTO wdm VALUES
    (0, 0, 'user-12-abc', ['user-12-abc', 'xyz']::VARCHAR[]),
    (1, 21, 'admin_7%', []::VARCHAR[]),
    (2, 30, 'abcabc', ['abc']::VARCHAR[]),
    (7, 7, '/api/v1/users', ['user-3-xyz']::VARCHAR[])

statement ok
CREATE INDEX wdm_kw3_idx ON wdm USING inverted (id, msg wdm_kw3) INCLUDE (x)

statement ok
CREATE INDEX wdm_kw3_pos_idx ON wdm USING inverted (id, msg wdm_kw3_pos) INCLUDE (x)

statement ok
CREATE INDEX wdm_tags_idx ON wdm USING inverted (id, tags wdm_kw3) INCLUDE (x)

statement ok
VACUUM (REFRESH_TABLE) wdm

statement ok
CREATE TABLE wdm_w (id INTEGER PRIMARY KEY, x INTEGER, msg VARCHAR)

statement ok
INSERT INTO wdm_w VALUES (0, 0, 'user-12-abc abc'), (1, 21, 'xyz admin_7')

statement ok
CREATE INDEX wdm_words_idx ON wdm_w USING inverted (id, msg wdm_words) INCLUDE (x)

statement ok
VACUUM (REFRESH_TABLE) wdm_w

statement ok
CREATE TABLE wdm_s (id INTEGER, x INTEGER, msg VARCHAR) WITH (storage = 'search')

statement ok
CREATE INDEX wdm_s_idx ON wdm_s USING inverted (id, msg wdm_kw3)

statement ok
INSERT INTO wdm_s SELECT id, x, msg FROM wdm

statement ok
VACUUM (REFRESH_TABLE) wdm_s

statement ok
CREATE TEXT SEARCH DICTIONARY wdm_kw2 AS generate_wildcard_ngrams(keyword(), 2)

statement ok
CREATE TEXT SEARCH DICTIONARY wdm_kw4 AS generate_wildcard_ngrams(keyword(), 4)

statement ok
CREATE TEXT SEARCH DICTIONARY wdm_words_pos AS generate_wildcard_ngrams(split_text_csv(' '), 3) WITH (frequency, position)

statement ok
CREATE INDEX wdm_kw2_idx ON wdm USING inverted (id, msg wdm_kw2) INCLUDE (x)

statement ok
CREATE INDEX wdm_kw4_idx ON wdm USING inverted (id, msg wdm_kw4) INCLUDE (x)

statement ok
VACUUM (REFRESH_TABLE) wdm

statement ok
CREATE INDEX wdm_words_pos_idx ON wdm_w USING inverted (id, msg wdm_words_pos) INCLUDE (x)

statement ok
VACUUM (REFRESH_TABLE) wdm_w

query
SELECT id FROM wdm_kw2_idx WHERE msg @@ ts_like('user-%-abc') ORDER BY id
----
id
0

query
EXPLAIN SELECT id FROM wdm_kw2_idx WHERE msg @@ ts_like('user-%-abc')
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────╮
│ Index: wdm_kw2_idx                      │
│ Lookup: table                           │
│ Index Filter:                           │
│ ╭─ Wildcard NGram ────────────────────╮ │
│ │ Field: msg(string)                  │ │
│ │ Pattern: (?s)\\Auser-.*-abc\\z        │ │
│ │ Syntax: perl                        │ │
│ │ Has Pos: false                      │ │
│ │ Query: And("\\xffuser-", "-abc\\xff") │ │
│ │ Verify: false                       │ │
│ ╰─────────────────────────────────────╯ │
│ Table Filter:                           │
│ ╭─ Wildcard NGram ────────────────────╮ │
│ │ Field: msg(string)                  │ │
│ │ Pattern: (?s)\\Auser-.*-abc\\z        │ │
│ │ Syntax: perl                        │ │
│ │ Has Pos: false                      │ │
│ │ Query: And("\\xffuser-", "-abc\\xff") │ │
│ │ Verify: table filter                │ │
│ ╰─────────────────────────────────────╯ │
│ Projections: id                         │
│ ~1 row                                  │
╰─────────────────────────────────────────╯

