statement ok
CREATE TEXT SEARCH DICTIONARY wdm_norm AS split_text(case := 'lower') WITH (frequency, norm)

statement ok
CREATE TABLE wdm_score (id INTEGER PRIMARY KEY, msg VARCHAR, body VARCHAR)

statement ok
INSERT INTO wdm_score VALUES
    (1, 'user-1-abc', 'house on a long quiet street near the old green park by the river'),
    (2, 'user-abc-x', 'house house house')

statement ok
CREATE INDEX wdm_score_idx ON wdm_score USING inverted (id, msg wdm_kw3, body wdm_norm)

statement ok
VACUUM (REFRESH_TABLE) wdm_score

query
SELECT id FROM wdm_score_idx
WHERE msg @@ ts_like('user-%-abc') AND body @@ 'house'
  AND (BM25(wdm_score_idx.tableoid) * 115)::TINYINT < 125
----
id
1

query
EXPLAIN SELECT id FROM wdm_score_idx
WHERE msg @@ ts_like('user-%-abc') AND body @@ 'house'
  AND (BM25(wdm_score_idx.tableoid) * 115)::TINYINT < 125
