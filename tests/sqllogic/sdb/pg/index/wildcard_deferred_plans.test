│ │ Field: body(string) │  │ Field: msg(string)                  │ │
│ │ Values: 'house'     │  │ Pattern: (?s)\\Auser-.*-abc\\z        │ │
│ ╰─────────────────────╯  │ Syntax: perl                        │ │
│                          │ Has Pos: false                      │ │
│                          │ Query: And("\\xffuser-", "-abc\\xff") │ │
│                          │ Verify: false                       │ │
│                          ╰─────────────────────────────────────╯ │
│ Table Filter:                                                    │
│ ╭─ Wildcard NGram ────────────────────╮                          │
│ │ Field: msg(string)                  │                          │
│ │ Pattern: (?s)\\Auser-.*-abc\\z        │                          │
│ │ Syntax: perl                        │                          │
│ │ Has Pos: false                      │                          │
│ │ Query: And("\\xffuser-", "-abc\\xff") │                          │
│ │ Verify: table filter                │                          │
│ ╰─────────────────────────────────────╯                          │
│ Score: bm25(k1=1.2, b=0.75)                                      │
│ Projections: id, sdb_inverted_index_score                        │
│ ~1 row                                                           │
╰──────────────────────────────────────────────────────────────────╯

