statement ok
CREATE TEXT SEARCH DICTIONARY wnp_kw3 AS generate_wildcard_ngrams(keyword(), 3)

statement ok
CREATE TABLE wnp (id INTEGER PRIMARY KEY, msg VARCHAR)

statement ok
INSERT INTO wnp SELECT i, CASE WHEN i % 3 = 0 THEN 'xfoox' WHEN i % 3 = 1 THEN 'bar' ELSE 'foofoo' END FROM range(1000) t(i)

statement ok
CREATE INDEX wnp_idx ON wnp USING inverted (id, msg wnp_kw3)

statement ok
VACUUM (FLUSH_TABLE) wnp

statement ok
CREATE TABLE wnp_s (id INTEGER, msg VARCHAR)

statement ok
CREATE INDEX wnp_s_idx ON wnp_s USING inverted (id, msg wnp_kw3)

statement ok
INSERT INTO wnp_s SELECT id, msg FROM wnp

statement ok
VACUUM (FLUSH_TABLE) wnp_s

query
SELECT id FROM wnp WHERE id IN (3, 4) AND (msg LIKE '%foo%' OR id = 100000) ORDER BY id
----
id
3

query
SELECT id FROM wnp_idx WHERE id = 3 AND (msg @@ ts_like('%foo%') OR id = 100000) ORDER BY id
----
id
3

query
SELECT count(*) AS n FROM wnp_idx WHERE id = 4 AND (msg @@ ts_like('%foo%') OR id = 100000)
----
n
0

query
SELECT count(*) AS n FROM wnp_idx WHERE id = 3 AND (msg @@ ts_like('%foo%') OR id = 100000)
----
n
1

query
SELECT id FROM wnp_s WHERE id = 3 AND (msg @@ ts_like('%foo%') OR id = 100000) ORDER BY id
----
id
3
