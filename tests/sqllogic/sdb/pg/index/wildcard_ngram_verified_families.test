statement ok
CREATE TEXT SEARCH DICTIONARY wvf_kw3 AS generate_wildcard_ngrams(keyword(), 3)

statement ok
CREATE TABLE wvf (id INTEGER PRIMARY KEY, msg VARCHAR)

statement ok
INSERT INTO wvf SELECT i, ['foobar', 'foox', 'foo', 'xfoo', 'barfoo1', 'hello', 'zoo', 'oxo'][i % 8 + 1] FROM range(64) t(i)

statement ok
CREATE INDEX wvf_idx ON wvf USING inverted (id, msg wvf_kw3)

statement ok
VACUUM (FLUSH_TABLE) wvf

query
SELECT id FROM wvf_idx WHERE msg @@ ts_like('%o_') OR id < 0 ORDER BY id LIMIT 7
----
id
1
2
