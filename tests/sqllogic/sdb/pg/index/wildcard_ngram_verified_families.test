n
3

query
SELECT count(*) AS n FROM (SELECT id FROM wvf_idx WHERE msg @@ ts_like('%o_') OR msg @@ ts_like('%ell%') ORDER BY bm25(wvf_idx.tableoid) DESC LIMIT 100) t
