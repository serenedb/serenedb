query
SELECT count(*) AS n FROM wvf_idx WHERE msg @@ ts_like('%o_') OR id < 0
----
n
40

query
SELECT count(*) AS n FROM wvf_idx WHERE msg @@ ts_like('%foo_') OR id < 0
----
n
16

query
SELECT id, bm25(wvf_idx.tableoid) > 0 AS scored FROM wvf_idx WHERE msg @@ ts_like('%foo_') OR id < 0 ORDER BY id LIMIT 4
