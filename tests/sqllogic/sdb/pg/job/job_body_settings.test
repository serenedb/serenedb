statement ok
CREATE TABLE jbs_div (via TEXT, v TEXT);


statement ok
INSERT INTO jbs_div SELECT 'client', (7 / 2)::TEXT;


statement ok
CREATE JOB jbs_bare AFTER 1 HOUR AS INSERT INTO jbs_div SELECT 'job', (7 / 2)::TEXT;


statement ok
CREATE JOB jbs_one AFTER 1 HOUR AS $$INSERT INTO jbs_div SELECT 'job', (7 / 2)::TEXT$$;


statement ok
CREATE JOB jbs_script AFTER 1 HOUR AS $$INSERT INTO jbs_div SELECT 'script', (7 / 2)::TEXT; SELECT 1;$$;


statement ok
EXECUTE JOB jbs_bare;


statement ok
EXECUTE JOB jbs_one;


statement ok
EXECUTE JOB jbs_script;


query
SELECT via, v FROM jbs_div ORDER BY via, v;
----
via	v
client	3
job	3
job	3
script	3


query
SELECT count(DISTINCT body) AS bodies, count(*) AS jobs FROM sdb_jobs() WHERE database_name = current_database() AND job_name IN ('jbs_bare', 'jbs_one');
----
bodies	jobs
1	2


statement ok
CREATE TABLE "Jbs_Q" (via TEXT);


statement ok
CREATE TABLE jbs_q (via TEXT);


statement ok
CREATE JOB jbs_case_bare AFTER 1 HOUR AS INSERT INTO Jbs_Q VALUES ('bare');


statement ok
CREATE JOB jbs_case_one AFTER 1 HOUR AS $$INSERT INTO Jbs_Q VALUES ('one')$$;


statement ok
CREATE JOB jbs_case_script AFTER 1 HOUR AS $$INSERT INTO Jbs_Q VALUES ('script'); INSERT INTO "Jbs_Q" VALUES ('script, quoted');$$;


statement ok
EXECUTE JOB jbs_case_bare;


statement ok
EXECUTE JOB jbs_case_one;


statement ok
EXECUTE JOB jbs_case_script;


query
SELECT via FROM jbs_q ORDER BY via;
----
via
bare
one
script


query
SELECT via FROM "Jbs_Q" ORDER BY via;
----
via
script, quoted


statement ok
CREATE JOB jbs_alias AFTER 1 HOUR AS $$CREATE TABLE jbs_alias_t AS SELECT 1 AS MyCol, 2 AS "KeepCase"; SELECT 1;$$;


statement ok
EXECUTE JOB jbs_alias;


query
SELECT column_name FROM information_schema.columns WHERE table_catalog = current_database() AND table_name = 'jbs_alias_t' ORDER BY ordinal_position;
----
column_name
mycol
KeepCase


statement ok
CREATE JOB jbs_parent AFTER 1 HOUR AS $outer$CREATE JOB jbs_child AFTER 1 HOUR AS $inner$INSERT INTO jbs_div SELECT 'child', (7 / 2)::TEXT; INSERT INTO Jbs_Q VALUES ('child');$inner$$outer$;


statement ok
CREATE JOB jbs_parent_bare AFTER 1 HOUR AS CREATE JOB jbs_child_bare AFTER 1 HOUR AS $$INSERT INTO jbs_div SELECT 'child bare', (7 / 2)::TEXT; INSERT INTO Jbs_Q VALUES ('child bare');$$;


statement ok
EXECUTE JOB jbs_parent;


statement ok
EXECUTE JOB jbs_child;


statement ok
EXECUTE JOB jbs_parent_bare;


statement ok
EXECUTE JOB jbs_child_bare;


query
SELECT via, v FROM jbs_div WHERE starts_with(via, 'child') ORDER BY via;
----
via	v
child	3
child bare	3


query
SELECT via FROM jbs_q WHERE starts_with(via, 'child') ORDER BY via;
----
via
child
child bare


statement ok
