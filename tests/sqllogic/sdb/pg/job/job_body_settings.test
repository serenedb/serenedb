statement ok
CREATE JOB jbs_float AFTER 1 HOUR AS $$INSERT INTO jbs_div SELECT 'float script', (7 / 2)::TEXT; SELECT 1;$$;


statement ok
EXECUTE JOB jbs_float_one;


statement ok
EXECUTE JOB jbs_float;


statement ok
