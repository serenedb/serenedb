query
SELECT job_name, schedule FROM duckdb_jobs() WHERE starts_with(job_name, 'jd_') ORDER BY job_name;
----
job_name	schedule
jd_babsky	EVERY INTERVAL '00:30:00'
jd_daily	EVERY INTERVAL '1 day' OFFSET INTERVAL '03:00:00'
jd_folded	EVERY INTERVAL '00:06:00'
jd_hourly	EVERY INTERVAL '01:00:00' OFFSET INTERVAL '00:05:00'
jd_monthly	EVERY INTERVAL '1 mon'
jd_quarter	EVERY INTERVAL '00:15:00'
jd_weekly	EVERY INTERVAL '7 days'


query
SELECT
  extract(minute FROM next_run AT TIME ZONE 'UTC') = 5
    AND extract(second FROM next_run AT TIME ZONE 'UTC') = 0
    AND next_run > now() AND next_run <= now() + INTERVAL '1 hour' AS aligned
FROM duckdb_jobs() WHERE job_name = 'jd_hourly';
----
aligned
t


query
SELECT
  extract(day FROM next_run AT TIME ZONE 'UTC') = 1
    AND extract(hour FROM next_run AT TIME ZONE 'UTC') = 0
    AND next_run > now() AS aligned
FROM duckdb_jobs() WHERE job_name = 'jd_monthly';
----
aligned
t


query
SELECT
  extract(hour FROM next_run AT TIME ZONE 'UTC') = 3
    AND extract(minute FROM next_run AT TIME ZONE 'UTC') = 0
    AND next_run > now() AND next_run <= now() + INTERVAL '1 day' AS aligned
FROM duckdb_jobs() WHERE job_name = 'jd_daily';
----
aligned
t


query
SELECT
  extract(isodow FROM next_run AT TIME ZONE 'UTC') = 1
    AND extract(hour FROM next_run AT TIME ZONE 'UTC') = 0
    AND next_run > now() AND next_run <= now() + INTERVAL '7 days' AS aligned
FROM duckdb_jobs() WHERE job_name = 'jd_weekly';
----
aligned
t


query
SELECT
  extract(minute FROM next_run AT TIME ZONE 'UTC')::int % 15 = 0
    AND extract(second FROM next_run AT TIME ZONE 'UTC') = 0 AS aligned
FROM duckdb_jobs() WHERE job_name = 'jd_quarter';
----
aligned
t


