statement ok
IMPORT DATABASE '${__TEST_DIR__}/jei';


query
SELECT schema_name, job_name, schedule, suspended, body FROM sdb_jobs() WHERE database_name = current_database() ORDER BY job_name;
----
schema_name	job_name	schedule	suspended	body
public	jei_clear	EVERY INTERVAL '01:00:00'	t	TRUNCATE jei_log
public	jei_hourly	EVERY INTERVAL '01:00:00' OFFSET INTERVAL '00:05:00'	f	INSERT INTO jei_log (VALUES (1))
jei_inner	jei_nested	AFTER INTERVAL '00:30:00' RANDOMIZE FOR INTERVAL '00:05:00'	f	SELECT 3
public	jei_paused	AFTER INTERVAL '02:00:00'	t	SELECT 1
jei	jei_spread	EVERY INTERVAL '1 day' OFFSET INTERVAL '02:00:00' RANDOMIZE FOR INTERVAL '01:00:00' CONCURRENT	f	SELECT 2


