statement ok
SET reindex_interval = 100;


statement ok
CREATE TABLE jri_t (id int, body text);


statement ok
CREATE INDEX jri_tidx ON jri_t USING inverted(id, body);


query
SELECT count(*) FROM duckdb_jobs() WHERE job_name LIKE 'jri%';
