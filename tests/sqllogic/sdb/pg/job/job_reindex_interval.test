statement ok
DROP JOB jri_clash;


statement ok
CREATE INDEX jri_clash ON jri_v USING inverted(id, body) WITH (reindex_interval=100);


statement ok
DROP VIEW jri_v CASCADE;


query
SELECT count(*) FROM duckdb_jobs() WHERE job_name LIKE 'jri%';
