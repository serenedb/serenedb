query
SELECT job_name, schedule, suspended, body FROM duckdb_jobs() WHERE starts_with(job_name, 'jrp_') ORDER BY job_name;
----
job_name	schedule	suspended	body
jrp_deadinside	AFTER INTERVAL '1 day'	t	SELECT 1
jrp_vedernikoff	EVERY INTERVAL '03:00:00' OFFSET INTERVAL '01:00:00'	t	INSERT INTO jrp_kostya (VALUES (1))


query
SELECT n FROM jrp_kostya;
----
n
1


