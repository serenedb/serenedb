query
SELECT job_name, body FROM sdb_jobs() WHERE starts_with(job_name, 'jrsb_') ORDER BY job_name;
----
job_name	body
jrsb_01	ALTER SUBSCRIPTION jrsb_sub ENABLE;
jrsb_02	ALTER SUBSCRIPTION jrsb_sub DISABLE;
jrsb_03	ALTER SUBSCRIPTION jrsb_sub CONNECTION 'host=localhost dbname=jrsb';
jrsb_04	ALTER SUBSCRIPTION jrsb_sub SET PUBLICATION jrsb_pub, jrsb_pub2 WITH (refresh = false);
jrsb_05	ALTER SUBSCRIPTION jrsb_sub ADD PUBLICATION jrsb_pub3;
jrsb_06	ALTER SUBSCRIPTION jrsb_sub DROP PUBLICATION jrsb_pub3 WITH (refresh = false);
jrsb_07	ALTER SUBSCRIPTION jrsb_sub REFRESH PUBLICATION WITH (copy_data = false);
jrsb_08	ALTER SUBSCRIPTION jrsb_sub SKIP (lsn = '0/14C0378');
jrsb_09	ALTER SUBSCRIPTION jrsb_sub RENAME TO jrsb_sub2;
jrsb_10	ALTER SUBSCRIPTION jrsb_sub SET (synchronous_commit = 'off');
jrsb_11	ALTER FUNCTION jrsb_f(INTEGER) RENAME TO jrsb_g;
jrsb_12	ALTER ROUTINE IF EXISTS jrsb_f RENAME TO jrsb_g;
jrsb_13	ALTER FUNCTION jrsb_f(INTEGER) SECURITY DEFINER IMMUTABLE STRICT;
jrsb_14	ALTER PROCEDURE jrsb_p() SECURITY INVOKER STABLE CALLED ON NULL INPUT;
jrsb_15	ALTER FUNCTION jrsb_f VOLATILE SET search_path TO public;
jrsb_16	ALTER FUNCTION jrsb_f(INTEGER) SET search_path FROM CURRENT;
jrsb_17	ALTER FUNCTION jrsb_f(INTEGER) RESET ALL;


