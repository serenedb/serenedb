CREATE JOB jsb_script AFTER 1 HOUR AS $$INSERT INTO jsb_log VALUES (1, 'first'); INSERT INTO jsb_log VALUES (2, 'it''s second'); UPDATE jsb_log SET note = upper(note) WHERE step = 1;$$;


statement ok
EXECUTE JOB jsb_script;


