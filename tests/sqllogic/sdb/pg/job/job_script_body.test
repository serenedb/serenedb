step	note
1	FIRST
2	it's second


query
SELECT body, replace(sql, current_database() || '.', '') AS sql FROM sdb_jobs() WHERE database_name = current_database() AND job_name = 'jsb_script';
----
body	sql
INSERT INTO jsb_log VALUES (1, 'first'); INSERT INTO jsb_log VALUES (2, 'it''s second'); UPDATE jsb_log SET note = upper(note) WHERE step = 1;	CREATE JOB public.jsb_script AFTER INTERVAL '01:00:00' AS 'INSERT INTO jsb_log VALUES (1, ''first''); INSERT INTO jsb_log VALUES (2, ''it''''s second''); UPDATE jsb_log SET note = upper(note) WHERE step = 1;';


