CREATE TABLE jss_log (step INT, note TEXT);


statement ok
CREATE JOB jss_drop_mid AFTER 1 HOUR AS $$INSERT INTO jss_log VALUES (1, 'before'); DROP JOB jss_drop_mid; INSERT INTO jss_log VALUES (2, 'after');$$;


statement ok
EXECUTE JOB jss_drop_mid;


query
SELECT step FROM jss_log WHERE step IN (1, 2) ORDER BY step;
----
step
1


query
SELECT (SELECT count(*) FROM sdb_jobs() WHERE database_name = current_database() AND job_name = 'jss_drop_mid') AS jobs,
       (SELECT string_agg(trigger || ' ' || success::TEXT, ',') FROM sdb_job_runs() WHERE database_name = current_database() AND job_name = 'jss_drop_mid') AS runs;
----
jobs	runs
0	manual true


