query
SELECT job_name, schedule, suspended, run_count, last_status
FROM sdb_jobs()
WHERE database_name = current_database() AND job_name IN ('jsd_suspend', 'jsd_rename', 'jsd_renamed', 'jsd_reschedule')
ORDER BY 1;
----
job_name	schedule	suspended	run_count	last_status
jsd_renamed	AFTER INTERVAL '01:00:00'	f	1	success
jsd_reschedule	AFTER INTERVAL '02:00:00'	f	1	success
jsd_suspend	AFTER INTERVAL '01:00:00'	t	1	success


