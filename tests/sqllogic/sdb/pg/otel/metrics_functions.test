query
SELECT round(otel_rate(value, ts) * (epoch(TIMESTAMP '2262-01-01') - epoch(TIMESTAMP '1678-01-01')), 6) AS rate,
       round(otel_irate(value, ts) * (epoch(TIMESTAMP '2262-01-01') - epoch(TIMESTAMP '1678-01-01')), 6) AS irate,
       round(otel_deriv(value, ts) * (epoch(TIMESTAMP '2262-01-01') - epoch(TIMESTAMP '1678-01-01')), 6) AS deriv,
       round(otel_predict_linear(value, ts, 0), 6) AS at_last
FROM (VALUES (TIMESTAMP_NS '1678-01-01 00:00:00', 0.0),
             (TIMESTAMP_NS '2262-01-01 00:00:00', 100.0)) AS t(ts, value);
----
rate	irate	deriv	at_last
100	100	100	100

