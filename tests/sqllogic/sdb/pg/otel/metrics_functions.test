       (TIMESTAMP_NS '2026-09-08 12:00:15', 'checkout', 'http.server.request.count', '{"code":"200"}', 130, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:30', 'checkout', 'http.server.request.count', '{"code":"200"}', 160, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:45', 'checkout', 'http.server.request.count', '{"code":"200"}', 190, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:01:00', 'checkout', 'http.server.request.count', '{"code":"200"}', 220, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:01:30', 'checkout', 'http.server.request.count', '{"code":"200"}', 280, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:00', 'checkout', 'http.server.request.count', '{"code":"500"}', 10, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:30', 'checkout', 'http.server.request.count', '{"code":"500"}', 2, 'Cumulative', true),
