statement ok
CREATE TABLE big_counter AS
SELECT i % 4 AS g, TIMESTAMP '2026-01-01' + to_seconds(i) AS ts, i::DOUBLE AS value
FROM range(1000000) t(i);

query
SELECT g, otel_increase(value, ts) AS increase, otel_rate(value, ts) AS rate
FROM big_counter
GROUP BY g
ORDER BY g;
----
g	increase	rate
0	999996	1
1	999996	1
2	999996	1
3	999996	1

statement ok
CREATE TABLE big_histograms AS
SELECT i, [2, 1] AS counts, CASE WHEN i = 999999 THEN [2.0] ELSE [1.0] END AS bounds
FROM range(1000000) t(i);

query
SELECT round(otel_histogram_quantile(0.5, counts, bounds), 6) AS p50
FROM big_histograms
WHERE i <> 999999;
----
p50
0.75

statement error
SELECT otel_histogram_quantile(0.5, counts, bounds)
FROM big_histograms;
----
db error: ERROR: otel_histogram_quantile(): all rows of a group must have the same quantile and explicit_bounds


