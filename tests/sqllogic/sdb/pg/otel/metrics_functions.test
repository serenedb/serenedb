query
SELECT otel_histogram_fraction(0, 4, h) AS f04,
       round(otel_histogram_fraction('-inf'::DOUBLE, 3, h), 6) AS below_3,
       round(otel_histogram_fraction(-3, 0, h), 6) AS negative,
       otel_histogram_fraction('-inf'::DOUBLE, 'inf'::DOUBLE, h) AS everything,
       round(otel_histogram_stddev(h), 6) AS stddev,
       round(otel_histogram_stdvar(h), 6) AS stdvar
FROM (SELECT otel_exponential_histogram(0, 1, 0, [1, 2, 4], 1, [2]) AS h);
----
f04	below_3	negative	everything	stddev	stdvar
0.3	0.516993	0.216993	1	3.228002	10.42

