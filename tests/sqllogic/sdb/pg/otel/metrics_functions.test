CREATE TABLE gauges (series VARCHAR, ts TIMESTAMP, value DOUBLE);

statement ok
INSERT INTO gauges VALUES
  ('a', TIMESTAMP '2026-01-01 00:00:20', 7),
  ('a', TIMESTAMP '2026-01-01 00:00:00', 5),
  ('a', TIMESTAMP '2026-01-01 00:00:10', 7),
  ('a', TIMESTAMP '2026-01-01 00:00:40', 10),
  ('a', TIMESTAMP '2026-01-01 00:00:30', 3),
  ('a', TIMESTAMP '2026-01-01 00:00:50', 'NaN'::DOUBLE),
  ('a', NULL, 100),
  ('b', TIMESTAMP '2026-01-01 00:00:00', 4),
  ('c', TIMESTAMP '2026-01-01 00:00:00', 2),
  ('c', TIMESTAMP '2026-01-01 00:00:30', 2);

query
SELECT series,
       otel_delta(value, ts) AS delta,
       otel_idelta(value, ts) AS idelta,
       round(otel_deriv(value, ts), 6) AS deriv,
       round(otel_predict_linear(value, ts, 60), 6) AS predicted,
       otel_changes(value, ts) AS changes,
       otel_resets(value, ts) AS resets
FROM gauges
GROUP BY series
ORDER BY series;
----
series	delta	idelta	deriv	predicted	changes	resets
a	5	7	0.06	11.2	3	1
b	NULL	NULL	NULL	NULL	0	0
c	0	0	0	2	0	0

query
SELECT round(otel_deriv(value, ts::TIMESTAMP_NS), 6) AS nanos,
       round(otel_predict_linear(value, ts::TIMESTAMPTZ, 60), 6) AS tz,
       otel_changes(value, ts::TIMESTAMP_NS) AS changes
FROM gauges
WHERE series = 'a';
----
nanos	tz	changes
0.06	11.2	3

query
SELECT otel_delta(value, ts) AS delta, otel_changes(value, ts) AS changes
FROM gauges
WHERE false;
----
delta	changes
NULL	NULL

query
SELECT ts,
       otel_changes(value, ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS changes,
       otel_idelta(value, ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS idelta
FROM gauges
WHERE series = 'a' AND ts <= TIMESTAMP '2026-01-01 00:00:40'
ORDER BY ts;
