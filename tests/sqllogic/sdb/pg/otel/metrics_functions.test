increase
NULL

query
SELECT round(histogram_quantile(q, [10, 20, 10, 0], [1, 2, 4]), 6) AS value
FROM (VALUES (0.25), (0.5), (0.95), (1.0)) AS t(q)
GROUP BY q
ORDER BY q;
----
value
1
1.5
3.6
4

query
SELECT histogram_quantile(0.99, [10, 20, 10, 10], [1, 2, 4]) AS inf_bucket,
       histogram_quantile(0.25, [5, 5, 0], [-1, 10]) AS nonpositive_first,
       histogram_quantile(1.5, [1, 1], [1]) AS above,
       histogram_quantile(-0.5, [1, 1], [1]) AS below,
       histogram_quantile('NaN'::DOUBLE, [1, 1], [1]) AS nan;
----
inf_bucket	nonpositive_first	above	below	nan
4	-1	Infinity	-Infinity	NaN

query
SELECT histogram_quantile(0.5, []::BIGINT[], []::DOUBLE[]) AS no_buckets,
       histogram_quantile(0.5, [0, 0], [1]) AS no_observations,
       histogram_quantile(0.5, [5], []::DOUBLE[]) AS no_bounds;
----
no_buckets	no_observations	no_bounds
NULL	NULL	NULL

query
SELECT round(histogram_quantile(0.5, counts, [1, 2, 4]), 6) AS value
FROM (VALUES ([5, 10, 5, 0]), ([5, 10, 5, 0]), (NULL)) AS t(counts);
