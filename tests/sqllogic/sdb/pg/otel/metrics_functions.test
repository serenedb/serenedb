statement ok
CREATE TABLE exp_series (series VARCHAR, ts TIMESTAMP, scale INTEGER, zero_count BIGINT,
                         positive_offset INTEGER, positive_bucket_counts BIGINT[],
                         negative_offset INTEGER, negative_bucket_counts BIGINT[]);

statement ok
INSERT INTO exp_series VALUES
  ('grow', TIMESTAMP '2026-01-01 00:00:30', 0, 2, 0, [3, 1, 2], 0, []),
  ('grow', TIMESTAMP '2026-01-01 00:00:00', 0, 1, 0, [1, 1], 0, []),
  ('rescaled', TIMESTAMP '2026-01-01 00:00:00', 1, 0, 0, [2, 2], 0, []),
  ('rescaled', TIMESTAMP '2026-01-01 00:00:30', 0, 0, 0, [5], 0, []),
  ('reset', TIMESTAMP '2026-01-01 00:00:00', 0, 0, 0, [5, 5], 0, []),
  ('reset', TIMESTAMP '2026-01-01 00:00:30', 0, 0, 0, [1, 1], 0, []),
  ('negative', TIMESTAMP '2026-01-01 00:00:00', 0, 0, 0, [], 2, [1]),
  ('negative', TIMESTAMP '2026-01-01 00:00:30', 0, 0, 0, [], 2, [4, 1]),
  ('single', TIMESTAMP '2026-01-01 00:00:00', 0, 0, 0, [1], 0, []);

query
SELECT series, h.scale, h.zero_count, h.positive_offset, h.positive_bucket_counts,
       h.negative_offset, h.negative_bucket_counts
FROM (
  SELECT series,
         otel_increase(otel_exponential_histogram(scale, zero_count, positive_offset, positive_bucket_counts,
                                                  negative_offset, negative_bucket_counts), ts) AS h
  FROM exp_series
  GROUP BY series
)
ORDER BY series;
----
series	scale	zero_count	positive_offset	positive_bucket_counts	negative_offset	negative_bucket_counts
grow	0	1	0	{2,0,2}	0	{}
negative	0	0	0	{}	2	{3,1}
rescaled	0	0	0	{1}	0	{}
reset	0	0	0	{1,1}	0	{}
single	NULL	NULL	NULL	NULL	NULL	NULL

query
SELECT (otel_increase(otel_exponential_histogram(scale, zero_count, positive_offset, positive_bucket_counts,
                                                 negative_offset, negative_bucket_counts),
                      ts::TIMESTAMP_NS)).positive_bucket_counts AS nanos,
       (otel_increase(otel_exponential_histogram(scale, zero_count, positive_offset, positive_bucket_counts,
                                                 negative_offset, negative_bucket_counts),
                      ts::TIMESTAMPTZ)).positive_bucket_counts AS tz
FROM exp_series
WHERE series = 'grow';
----
nanos	tz
{2,0,2}	{2,0,2}

query
SELECT series, h.zero_count, h.positive_bucket_counts
FROM (
  SELECT series, otel_increase(otel_exponential_histogram(0, zero, 0, counts, 0, []), ts) AS h
  FROM (VALUES ('dup', TIMESTAMP '2026-01-01 00:00:00', 0.0, [1.0]),
               ('dup', TIMESTAMP '2026-01-01 00:00:00', 0.0, [3.0]),
               ('dup', TIMESTAMP '2026-01-01 00:00:30', 0.0, [5.0]),
               ('skips', TIMESTAMP '2026-01-01 00:00:00', 0.0, [1.0]),
               ('skips', NULL, 0.0, [100.0]),
               ('skips', 'infinity'::TIMESTAMP, 0.0, [100.0]),
               ('skips', TIMESTAMP '2026-01-01 00:00:10', 0.0, ['NaN'::DOUBLE]),
               ('skips', TIMESTAMP '2026-01-01 00:00:30', 0.0, [4.0]),
               ('zero_drop', TIMESTAMP '2026-01-01 00:00:00', 5.0, [1.0]),
               ('zero_drop', TIMESTAMP '2026-01-01 00:00:30', 2.0, [2.0])) AS t(series, ts, zero, counts)
  GROUP BY series
)
ORDER BY series;
----
series	zero_count	positive_bucket_counts
dup	0	{2}
skips	0	{3}
zero_drop	2	{2}

