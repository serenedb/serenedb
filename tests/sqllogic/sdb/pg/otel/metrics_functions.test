INSERT INTO otel_metrics_sum ("timestamp", service_name, metric_name, attributes, value,
                              aggregation_temporality, is_monotonic)
VALUES (TIMESTAMP_NS '2026-09-08 12:00:00', 'checkout', 'http.server.request.count', '{"code":"200"}', 100, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:15', 'checkout', 'http.server.request.count', '{"code":"200"}', 130, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:30', 'checkout', 'http.server.request.count', '{"code":"200"}', 160, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:45', 'checkout', 'http.server.request.count', '{"code":"200"}', 190, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:01:00', 'checkout', 'http.server.request.count', '{"code":"200"}', 220, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:01:30', 'checkout', 'http.server.request.count', '{"code":"200"}', 280, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:00', 'checkout', 'http.server.request.count', '{"code":"500"}', 10, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:30', 'checkout', 'http.server.request.count', '{"code":"500"}', 2, 'Cumulative', true),
       (TIMESTAMP_NS '2026-09-08 12:00:45', 'checkout', 'http.server.request.count', '{"code":"500"}', 5, 'Cumulative', true);

statement ok
VACUUM (REFRESH_TABLE) otel_metrics_sum;

query
SELECT minute, service_name, round(sum(per_second), 6) AS requests_per_second
FROM (
  SELECT date_trunc('minute', "timestamp") AS minute, service_name,
         resource_attributes, attributes,
         otel_rate(value, "timestamp") AS per_second
  FROM otel_metrics_sum
  WHERE metric_name = 'http.server.request.count'
  GROUP BY ALL
)
GROUP BY ALL
ORDER BY ALL;
----
minute	service_name	requests_per_second
2026-09-08 12:00:00	checkout	2.111111
2026-09-08 12:01:00	checkout	2

