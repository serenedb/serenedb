query
SELECT series,
       delta(value, ts) AS delta,
       idelta(value, ts) AS idelta,
       round(deriv(value, ts), 6) AS deriv,
       round(predict_linear(value, ts, 60), 6) AS predicted,
       changes(value, ts) AS changes,
       resets(value, ts) AS resets
FROM gauges
GROUP BY series
ORDER BY series;
----
series	delta	idelta	deriv	predicted	changes	resets
a	5	7	0.06	11.2	3	1
b	NULL	NULL	NULL	NULL	0	0
c	0	0	0	2	0	0

