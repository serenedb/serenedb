query
SELECT minute,
       round(histogram_quantile(0.5, h), 6) AS p50,
       round(histogram_fraction('-inf'::DOUBLE, 2, h), 6) AS under_2
FROM (
  SELECT date_trunc('minute', "timestamp") AS minute, resource_attributes, attributes,
         increase(exponential_histogram(scale, zero_count, positive_offset, positive_bucket_counts,
                                        negative_offset, negative_bucket_counts), "timestamp") AS h
  FROM otel_metrics_exponential_histogram
  WHERE metric_name = 'rpc.duration'
  GROUP BY ALL
)
GROUP BY minute
ORDER BY minute;
----
minute	p50	under_2
2026-09-08 12:00:00	2.378414	0.333333

statement ok
CREATE TABLE big AS
SELECT i, TIMESTAMP '2026-01-01 00:00:00' + i * INTERVAL '1 second' AS ts
FROM range(0, 1000000) r(i);

query
SELECT histogram_quantile(0.5, h) AS p50,
       round(histogram_quantile(0.75, h), 6) AS p75,
       histogram_fraction('-inf'::DOUBLE, 2, h) AS under_2
FROM (
  SELECT CASE WHEN i % 2 = 0
              THEN exponential_histogram(0, 0, 0, [1, 1], 0, [])
              ELSE exponential_histogram(1, 0, 0, [1, 1, 1, 1], 0, [])
         END AS h
  FROM big
);
----
p50	p75	under_2
2	2.828427	0.5

query
SELECT round(deriv(3.0 * i, ts), 6) AS deriv,
       round(predict_linear(3.0 * i, ts, 10), 6) AS predicted,
       delta(3.0 * i, ts) AS delta
FROM big;
----
deriv	predicted	delta
3	3000027	2999997

query
SELECT changes(i // 10, ts) AS changes, resets(i % 1000, ts) AS resets
FROM big;
----
changes	resets
99999	999
