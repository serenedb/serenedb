query
SELECT histogram_fraction(0, 4, h) AS f04,
       round(histogram_fraction('-inf'::DOUBLE, 3, h), 6) AS below_3,
       round(histogram_fraction(-3, 0, h), 6) AS negative,
       histogram_fraction('-inf'::DOUBLE, 'inf'::DOUBLE, h) AS everything,
       round(histogram_stddev(h), 6) AS stddev,
       round(histogram_stdvar(h), 6) AS stdvar
