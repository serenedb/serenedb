statement ok
CREATE TABLE counters (series VARCHAR, ts TIMESTAMP_NS, value DOUBLE);

statement ok
INSERT INTO counters VALUES
  ('a', TIMESTAMP_NS '2026-01-01 00:00:30', 5),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:00', 10),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:20', 35),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:40', 25),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:10', 20),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:20', 30),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:50', NULL),
  ('a', NULL, 100),
  ('a', TIMESTAMP_NS '2026-01-01 00:01:00', 'NaN'::DOUBLE),
  ('b', TIMESTAMP_NS '2026-01-01 00:00:00', 7),
  ('c', TIMESTAMP_NS '2026-01-01 00:00:00', 1),
  ('c', TIMESTAMP_NS '2026-01-01 00:00:30', 4);

query
SELECT series,
       otel_increase(value, ts) AS increase,
       otel_rate(value, ts) AS rate,
       otel_irate(value, ts) AS irate
FROM counters
GROUP BY series
ORDER BY series;
----
series	increase	rate	irate
a	50	1.25	2
b	NULL	NULL	NULL
c	3	0.1	0.1

query
SELECT otel_rate(value, ts::TIMESTAMP) AS micros,
       otel_rate(value, ts::TIMESTAMPTZ) AS tz
FROM counters
WHERE series = 'a';
----
micros	tz
1.25	1.25

query
SELECT otel_increase(value, ts) AS increase, otel_rate(value, ts) AS rate
FROM counters
WHERE false;
----
increase	rate
NULL	NULL

query
SELECT ts,
       otel_increase(value, ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS delta
FROM counters
WHERE series = 'a' AND ts <= TIMESTAMP_NS '2026-01-01 00:00:40' AND value <> 30
ORDER BY ts;
----
ts	delta
2026-01-01 00:00:00	NULL
2026-01-01 00:00:10	10
2026-01-01 00:00:20	15
2026-01-01 00:00:30	5
2026-01-01 00:00:40	20

