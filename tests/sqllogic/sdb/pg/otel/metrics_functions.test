query
SELECT otel_histogram_quantile(0.5, h) AS p50
FROM (VALUES (otel_exponential_histogram(0, 0, 0, [1.0, 1.0], 0, [])),
             (otel_exponential_histogram(0, 'NaN'::DOUBLE, 0, [5.0], 0, [])),
             (otel_exponential_histogram(0, 0, 0, ['NaN'::DOUBLE], 0, []))) AS t(h);
----
p50
2

query
SELECT otel_histogram_quantile(0.5, h) AS p50, otel_histogram_fraction(0, 4, h) AS under_4
FROM (SELECT otel_exponential_histogram(0, NULL, NULL, [1, NULL, 1], 0, NULL) AS h);
