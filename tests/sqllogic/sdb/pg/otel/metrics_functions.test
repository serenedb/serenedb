statement ok
CREATE TABLE counters (series VARCHAR, ts TIMESTAMP_NS, value DOUBLE);

statement ok
INSERT INTO counters VALUES
  ('a', TIMESTAMP_NS '2026-01-01 00:00:30', 5),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:00', 10),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:20', 35),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:40', 25),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:10', 20),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:20', 30),
  ('a', TIMESTAMP_NS '2026-01-01 00:00:50', NULL),
  ('a', NULL, 100),
  ('a', TIMESTAMP_NS '2026-01-01 00:01:00', 'NaN'::DOUBLE),
  ('b', TIMESTAMP_NS '2026-01-01 00:00:00', 7),
  ('c', TIMESTAMP_NS '2026-01-01 00:00:00', 1),
  ('c', TIMESTAMP_NS '2026-01-01 00:00:30', 4);

query
SELECT series,
       increase(value, ts) AS increase,
       rate(value, ts) AS rate,
       irate(value, ts) AS irate
FROM counters
GROUP BY series
ORDER BY series;
----
series	increase	rate	irate
a	50	1.25	2
b	NULL	NULL	NULL
c	3	0.1	0.1

query
SELECT rate(value, ts::TIMESTAMP) AS micros,
       rate(value, ts::TIMESTAMPTZ) AS tz
FROM counters
WHERE series = 'a';
----
micros	tz
1.25	1.25

query
SELECT increase(value, ts) AS increase, rate(value, ts) AS rate
FROM counters
WHERE false;
----
increase	rate
NULL	NULL

query
SELECT ts,
       increase(value, ts) OVER (ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS delta
FROM counters
WHERE series = 'a' AND ts <= TIMESTAMP_NS '2026-01-01 00:00:40' AND value <> 30
ORDER BY ts;
----
ts	delta
2026-01-01 00:00:00	NULL
2026-01-01 00:00:10	10
2026-01-01 00:00:20	15
2026-01-01 00:00:30	5
2026-01-01 00:00:40	20

statement ok
CREATE TABLE histograms (ts TIMESTAMP_NS, counts BIGINT[]);

statement ok
INSERT INTO histograms VALUES
  (TIMESTAMP_NS '2026-01-01 00:00:20', [3, 4, 5]),
  (TIMESTAMP_NS '2026-01-01 00:00:00', [1, 2, 3]),
  (TIMESTAMP_NS '2026-01-01 00:00:30', [1, 0, 1]),
  (TIMESTAMP_NS '2026-01-01 00:00:10', [2, 4, 3]),
  (TIMESTAMP_NS '2026-01-01 00:00:40', NULL);

query
SELECT increase(counts, ts) AS increase
FROM histograms;
----
increase
{3,2,3}

query
SELECT increase(counts, ts) AS increase
FROM histograms
WHERE ts = TIMESTAMP_NS '2026-01-01 00:00:00';
----
increase
NULL

query
SELECT round(histogram_quantile(q, [10, 20, 10, 0], [1, 2, 4]), 6) AS value
FROM (VALUES (0.25), (0.5), (0.95), (1.0)) AS t(q)
GROUP BY q
ORDER BY q;
----
value
1
1.5
3.6
4

query
SELECT histogram_quantile(0.99, [10, 20, 10, 10], [1, 2, 4]) AS inf_bucket,
       histogram_quantile(0.25, [5, 5, 0], [-1, 10]) AS nonpositive_first,
       histogram_quantile(1.5, [1, 1], [1]) AS above,
       histogram_quantile(-0.5, [1, 1], [1]) AS below,
       histogram_quantile('NaN'::DOUBLE, [1, 1], [1]) AS nan;
----
inf_bucket	nonpositive_first	above	below	nan
4	-1	Infinity	-Infinity	NaN

query
SELECT histogram_quantile(0.5, []::BIGINT[], []::DOUBLE[]) AS no_buckets,
       histogram_quantile(0.5, [0, 0], [1]) AS no_observations,
       histogram_quantile(0.5, [5], []::DOUBLE[]) AS no_bounds;
----
no_buckets	no_observations	no_bounds
NULL	NULL	NULL

query
SELECT round(histogram_quantile(0.5, counts, [1, 2, 4]), 6) AS value
FROM (VALUES ([5, 10, 5, 0]), ([5, 10, 5, 0]), (NULL)) AS t(counts);
----
value
1.5

statement error
SELECT histogram_quantile(0.5, [1, 2, 3], [1, 2, 4]);
----
db error: ERROR: histogram_quantile(): bucket_counts must have one element more than explicit_bounds, got 3 and 3


statement error
SELECT histogram_quantile(0.5, counts, bounds)
FROM (VALUES ([1, 2], [1.0]), ([1, 2], [2.0])) AS t(counts, bounds);
----
db error: ERROR: histogram_quantile(): all rows of a group must have the same quantile and explicit_bounds


