VACUUM (REFRESH_TABLE) otel_metrics_histogram;

query
SELECT minute,
       histogram_quantile(0.5, buckets, explicit_bounds) AS p50,
       histogram_quantile(0.75, buckets, explicit_bounds) AS p75
FROM (
  SELECT date_trunc('minute', "timestamp") AS minute,
         resource_attributes, attributes, explicit_bounds,
         increase(bucket_counts, "timestamp") AS buckets
  FROM otel_metrics_histogram
  WHERE metric_name = 'http.server.duration'
  GROUP BY ALL
)
GROUP BY minute
ORDER BY minute;
----
minute	p50	p75
2026-09-08 12:00:00	10	325

query
SELECT round(histogram_fraction('-inf'::DOUBLE, 100, buckets, explicit_bounds), 6) AS under_100,
       round(histogram_stddev(buckets, explicit_bounds), 6) AS stddev,
       histogram_stdvar(buckets, explicit_bounds) AS stdvar
FROM (
  SELECT resource_attributes, attributes, explicit_bounds,
         increase(bucket_counts, "timestamp") AS buckets
  FROM otel_metrics_histogram
  WHERE metric_name = 'http.server.duration'
  GROUP BY ALL
);
----
under_100	stddev	stdvar
0.7	333.414532	111165.25

