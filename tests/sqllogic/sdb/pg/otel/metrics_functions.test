VACUUM (REFRESH_TABLE) otel_metrics_exponential_histogram;

query
SELECT minute,
       round(otel_histogram_quantile(0.5, h), 6) AS p50,
       round(otel_histogram_fraction('-inf'::DOUBLE, 2, h), 6) AS under_2
FROM (
  SELECT date_trunc('minute', "timestamp") AS minute, resource_attributes, attributes,
         otel_increase(otel_exponential_histogram(scale, zero_count, positive_offset, positive_bucket_counts,
                                                  negative_offset, negative_bucket_counts), "timestamp") AS h
  FROM otel_metrics_exponential_histogram
  WHERE metric_name = 'rpc.duration'
  GROUP BY ALL
)
GROUP BY minute
ORDER BY minute;
----
minute	p50	under_2
2026-09-08 12:00:00	2.378414	0.333333

statement ok
CREATE TABLE big AS
SELECT i, TIMESTAMP '2026-01-01 00:00:00' + i * INTERVAL '1 second' AS ts
FROM range(0, 1000000) r(i);

query
SELECT otel_histogram_quantile(0.5, h) AS p50,
       round(otel_histogram_quantile(0.75, h), 6) AS p75,
       otel_histogram_fraction('-inf'::DOUBLE, 2, h) AS under_2
FROM (
  SELECT CASE WHEN i % 2 = 0
              THEN otel_exponential_histogram(0, 0, 0, [1, 1], 0, [])
              ELSE otel_exponential_histogram(1, 0, 0, [1, 1, 1, 1], 0, [])
         END AS h
  FROM big
);
----
p50	p75	under_2
2	2.828427	0.5

query
SELECT round(otel_deriv(3.0 * i, ts), 6) AS deriv,
       round(otel_predict_linear(3.0 * i, ts, 10), 6) AS predicted,
       otel_delta(3.0 * i, ts) AS delta
FROM big;
----
deriv	predicted	delta
3	3000027	2999997

query
SELECT otel_changes(i // 10, ts) AS changes, otel_resets(i % 1000, ts) AS resets
FROM big;
----
changes	resets
99999	999

query
SELECT otel_increase([i, 2 * i], ts) AS buckets,
       (otel_increase(otel_exponential_histogram(0, 0, 0, [i], 0, []), ts)).positive_bucket_counts AS exponential
FROM big
WHERE i % 8 = 0;
----
buckets	exponential
{999992,1999984}	{999992}

query
SELECT i % 2 AS g,
       round(otel_predict_linear(2.0 * i, ts, 0), 6) AS predicted,
       otel_histogram_quantile(1, otel_exponential_histogram(0, 0, (i % 7)::INTEGER, [1.0], 0, [])) AS max,
       otel_histogram_quantile(0.5, [1, 1], [i % 2 + 1.0]) AS explicit
FROM big
GROUP BY g
ORDER BY g;
----
g	predicted	max	explicit
0	1999996	128	1
1	1999998	128	2

query
SELECT i,
       round(otel_predict_linear(2.0 * i, ts, 10) OVER w, 6) AS predicted,
       otel_histogram_quantile(1, otel_exponential_histogram(0, 0, i::INTEGER, [1.0], 0, [])) OVER w AS max
FROM big
WHERE i < 6
WINDOW w AS (ORDER BY i ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)
ORDER BY i;
----
i	predicted	max
0	NULL	2
1	22	4
2	24	8
3	26	16
4	28	32
5	30	64
