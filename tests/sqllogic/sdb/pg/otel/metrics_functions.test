----
db error: ERROR: otel_histogram_quantile(): all rows of a group must have the same quantile and explicit_bounds


statement error
SELECT otel_histogram_quantile(0.5, [1, 2, 3], [1.0, NULL]);
----
db error: ERROR: otel_histogram_quantile(): explicit_bounds must not contain NULL


query
SELECT round(otel_histogram_quantile(q, counts, bounds), 6) AS p50
FROM (VALUES (0.5, [1, 1, 0], [1.0, 2.0]),
             (NULL, [5, 5, 5], [1.0, 2.0]),
             (0.5, [3, 3, 3], NULL),
             (0.5, [NULL, 2, 0], [1.0, 2.0])) AS t(q, counts, bounds);
