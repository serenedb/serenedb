CREATE TABLE histograms (ts TIMESTAMP_NS, counts BIGINT[]);

statement ok
INSERT INTO histograms VALUES
  (TIMESTAMP_NS '2026-01-01 00:00:20', [3, 4, 5]),
  (TIMESTAMP_NS '2026-01-01 00:00:00', [1, 2, 3]),
  (TIMESTAMP_NS '2026-01-01 00:00:30', [1, 0, 1]),
  (TIMESTAMP_NS '2026-01-01 00:00:10', [2, 4, 3]),
  (TIMESTAMP_NS '2026-01-01 00:00:40', NULL);

query
SELECT otel_increase(counts, ts) AS increase
FROM histograms;
----
increase
{3,2,3}

query
SELECT otel_increase(counts, ts::TIMESTAMP) AS micros,
       otel_increase(counts, ts::TIMESTAMPTZ) AS tz
FROM histograms;
----
micros	tz
{3,2,3}	{3,2,3}

query
SELECT otel_increase(counts, ts) AS increase
FROM (VALUES (TIMESTAMP '2026-01-01 00:00:00', [1, NULL]),
             (TIMESTAMP '2026-01-01 00:00:10', [0, 0]),
             (TIMESTAMP '2026-01-01 00:00:10', [2, 5]),
             (TIMESTAMP '2026-01-01 00:00:20', [4, 6])) AS t(ts, counts);
----
increase
{3,6}

query
SELECT otel_increase(counts, ts) AS increase
FROM histograms
WHERE ts = TIMESTAMP_NS '2026-01-01 00:00:00';
----
increase
NULL

query
SELECT round(otel_histogram_quantile(q, [10, 20, 10, 0], [1, 2, 4]), 6) AS value
FROM (VALUES (0.25), (0.5), (0.95), (1.0)) AS t(q)
GROUP BY q
ORDER BY q;
----
value
1
1.5
3.6
4

query
SELECT otel_histogram_quantile(0.99, [10, 20, 10, 10], [1, 2, 4]) AS inf_bucket,
       otel_histogram_quantile(0.25, [5, 5, 0], [-1, 10]) AS nonpositive_first,
       otel_histogram_quantile(1.5, [1, 1], [1]) AS above,
       otel_histogram_quantile(-0.5, [1, 1], [1]) AS below,
       otel_histogram_quantile('NaN'::DOUBLE, [1, 1], [1]) AS nan;
----
inf_bucket	nonpositive_first	above	below	nan
4	-1	Infinity	-Infinity	NaN

query
SELECT otel_histogram_quantile(0.5, []::BIGINT[], []::DOUBLE[]) AS no_buckets,
       otel_histogram_quantile(0.5, [0, 0], [1]) AS no_observations,
       otel_histogram_quantile(0.5, [5], []::DOUBLE[]) AS no_bounds;
----
no_buckets	no_observations	no_bounds
NULL	NULL	NULL

query
SELECT round(otel_histogram_quantile(0.5, counts, [1, 2, 4]), 6) AS value
FROM (VALUES ([5, 10, 5, 0]), ([5, 10, 5, 0]), (NULL)) AS t(counts);
----
value
1.5

statement error
