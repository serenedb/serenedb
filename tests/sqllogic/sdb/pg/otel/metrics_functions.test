statement ok
VACUUM (REFRESH_TABLE) otel_metrics_sum;

query
SELECT minute, service_name, round(sum(per_second), 6) AS requests_per_second
FROM (
  SELECT date_trunc('minute', "timestamp") AS minute, service_name,
         resource_attributes, attributes,
         rate(value, "timestamp") AS per_second
  FROM otel_metrics_sum
  WHERE metric_name = 'http.server.request.count'
  GROUP BY ALL
)
GROUP BY ALL
ORDER BY ALL;
----
minute	service_name	requests_per_second
2026-09-08 12:00:00	checkout	2.111111
2026-09-08 12:01:00	checkout	2

statement ok
INSERT INTO otel_metrics_histogram ("timestamp", service_name, metric_name, attributes,
                                    bucket_counts, explicit_bounds, aggregation_temporality)
VALUES (TIMESTAMP_NS '2026-09-08 12:00:00', 'checkout', 'http.server.duration', '{}', [1, 1, 0, 0], [10.0, 100.0, 1000.0], 'Cumulative'),
       (TIMESTAMP_NS '2026-09-08 12:00:30', 'checkout', 'http.server.duration', '{}', [5, 3, 2, 0], [10.0, 100.0, 1000.0], 'Cumulative'),
       (TIMESTAMP_NS '2026-09-08 12:00:59', 'checkout', 'http.server.duration', '{}', [9, 5, 4, 2], [10.0, 100.0, 1000.0], 'Cumulative'),
       (TIMESTAMP_NS '2026-09-08 12:00:00', 'checkout', 'http.server.duration', '{"route":"/b"}', [0, 0, 0, 0], [10.0, 100.0, 1000.0], 'Cumulative'),
       (TIMESTAMP_NS '2026-09-08 12:00:40', 'checkout', 'http.server.duration', '{"route":"/b"}', [2, 0, 0, 0], [10.0, 100.0, 1000.0], 'Cumulative');

statement ok
VACUUM (REFRESH_TABLE) otel_metrics_histogram;

query
SELECT minute,
       histogram_quantile(0.5, buckets, explicit_bounds) AS p50,
       histogram_quantile(0.75, buckets, explicit_bounds) AS p75
FROM (
  SELECT date_trunc('minute', "timestamp") AS minute,
         resource_attributes, attributes, explicit_bounds,
         increase(bucket_counts, "timestamp") AS buckets
  FROM otel_metrics_histogram
  WHERE metric_name = 'http.server.duration'
  GROUP BY ALL
)
GROUP BY minute
ORDER BY minute;
----
minute	p50	p75
2026-09-08 12:00:00	10	325
