query
SELECT epoch_ns("timestamp") AS ts, epoch_ns(observed_timestamp) AS observed,
       trace_id, span_id, trace_flags, severity_text, severity_number,
       service_name, body, resource_schema_url, scope_name, scope_version
FROM otel_logs WHERE body @@ 'reset' ORDER BY 9, 1;
----
ts	observed	trace_id	span_id	trace_flags	severity_text	severity_number	service_name	body	resource_schema_url	scope_name	scope_version
1788868810000000123	1788868810000000456	0af7651916cd43dd8448eb211c80319c	b7ad6b7169203331	1	ERROR	17	checkout	connection reset by peer	https://opentelemetry.io/schemas/1.30.0	io.grpc.Client	1.62.2
1788868810000000123	1788868810000000456	0af7651916cd43dd8448eb211c80319c	b7ad6b7169203331	1	ERROR	17	checkout	connection reset by peer /api/v1/users?id=42 from 10.0.0.7:5432 (took 12ms)	https://opentelemetry.io/schemas/1.30.0	io.grpc.Client	1.62.2
1788915600000000000	NULL	NULL	NULL	0	WARN	13	checkout	connection reset while draining pool	NULL	NULL	NULL

