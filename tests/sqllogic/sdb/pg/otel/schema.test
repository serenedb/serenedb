                   coalesce(positive_bucket_counts::VARCHAR, '~'),
                   coalesce(negative_offset::VARCHAR, '~'),
                   coalesce(negative_bucket_counts::VARCHAR, '~'),
                   coalesce(min::VARCHAR, '~'),
                   coalesce(max::VARCHAR, '~'),
                   coalesce(aggregation_temporality, '~'),
                   coalesce(attributes::VARCHAR, '~'),
                   coalesce(exemplars::VARCHAR, '~')) AS row_key
  FROM otel_metrics_exponential_histogram GROUP BY 1 HAVING count(*) = 2
);
----
shapes_from_both_decoders
2

