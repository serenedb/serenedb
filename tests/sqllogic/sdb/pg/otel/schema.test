query
SELECT count(*) AS shapes_from_both_decoders FROM (
  SELECT concat_ws('|',
                        coalesce(epoch_ns("timestamp")::VARCHAR, '~'),
                        coalesce(epoch_ns(observed_timestamp)::VARCHAR, '~'),
                        coalesce(trace_id::VARCHAR, '~'),
                        coalesce(span_id::VARCHAR, '~'),
                        coalesce(trace_flags::VARCHAR, '~'),
                        coalesce(severity_text::VARCHAR, '~'),
                        coalesce(severity_number::VARCHAR, '~'),
                        coalesce(service_name::VARCHAR, '~'),
                        coalesce(event_name::VARCHAR, '~'),
                        coalesce(body::VARCHAR, '~'),
                        coalesce(resource_schema_url::VARCHAR, '~'),
                        coalesce(scope_schema_url::VARCHAR, '~'),
                        coalesce(scope_name::VARCHAR, '~'),
                        coalesce(scope_version::VARCHAR, '~'),
                        coalesce(resource_attributes::VARCHAR, '~'),
                        coalesce(scope_attributes::VARCHAR, '~'),
                        coalesce(log_attributes::VARCHAR, '~')) AS row_key
  FROM otel_logs GROUP BY 1 HAVING count(*) = 2
);
----
shapes_from_both_decoders
4

query
SELECT count(*) AS shapes_from_both_decoders FROM (
  SELECT concat_ws('|',
                        coalesce(epoch_ns("timestamp")::VARCHAR, '~'),
                        coalesce(epoch_ns(end_timestamp)::VARCHAR, '~'),
                        coalesce(trace_id::VARCHAR, '~'),
                        coalesce(span_id::VARCHAR, '~'),
                        coalesce(parent_span_id::VARCHAR, '~'),
                        coalesce(trace_state::VARCHAR, '~'),
                        coalesce(span_name::VARCHAR, '~'),
                        coalesce(span_kind::VARCHAR, '~'),
                        coalesce(service_name::VARCHAR, '~'),
                        coalesce(duration_ns::VARCHAR, '~'),
                        coalesce(status_code::VARCHAR, '~'),
                        coalesce(status_message::VARCHAR, '~'),
                        coalesce(span_attributes::VARCHAR, '~'),
                        coalesce(events::VARCHAR, '~'),
                        coalesce(links::VARCHAR, '~'),
                        coalesce(event_names::VARCHAR, '~'),
                        coalesce(link_trace_ids::VARCHAR, '~')) AS row_key
  FROM otel_traces GROUP BY 1 HAVING count(*) = 2
);
