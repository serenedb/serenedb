query
SELECT metric_name, date_trunc('minute', "timestamp") AS minute, sum(value) AS total
FROM otel_metrics_sum
WHERE metric_name @@ 'http.server.request_count'
  AND "timestamp" @@ ts_ge(TIMESTAMP_NS '2026-09-08 00:00:00')
GROUP BY 1, 2 ORDER BY 1, 2;
----
metric_name	minute	total
http.server.request_count	2026-09-08 12:00:00	42
http.server.request_count	2026-09-08 12:01:00	3

