INSERT INTO otel_logs ("timestamp", observed_timestamp, trace_id, span_id, trace_flags,
                       severity_text, severity_number, service_name, event_name, body,
                       resource_schema_url, scope_schema_url, scope_name, scope_version,
                       resource_attributes, scope_attributes, log_attributes)
VALUES (TIMESTAMP_NS '2026-09-08 12:00:10.000000123',
        TIMESTAMP_NS '2026-09-08 12:00:10.000000456',
        '0af7651916cd43dd8448eb211c80319c', 'b7ad6b7169203331', 1,
        'ERROR', 17, 'checkout', NULL,
        'connection reset by peer /api/v1/users?id=42 from 10.0.0.7:5432 (took 12ms)',
        'https://opentelemetry.io/schemas/1.30.0', NULL, 'io.grpc.Client', '1.62.2',
        '{"service.name":"checkout"}', NULL, '{"http.status_code":"502"}'),
       (TIMESTAMP_NS '2026-09-08 12:00:10.000000124',
        NULL, NULL, NULL, 0, 'INFO', 9, 'cart', NULL,
        'healthcheck ok', NULL, NULL, NULL, NULL, NULL, NULL, NULL),
       (TIMESTAMP_NS '2026-09-09 01:00:00',
        NULL, NULL, NULL, 0, 'WARN', 13, 'checkout', 'cache.evict',
        'connection reset while draining pool', NULL, NULL, NULL, NULL, NULL, NULL,
        '{"http.status_code":"503"}');

statement ok
VACUUM (REFRESH_TABLE) otel_logs;

query
SELECT epoch_ns("timestamp") AS ts FROM otel_logs ORDER BY 1;
----
ts
1788868810000000123
1788868810000000124
1788915600000000000

query
SELECT count(*) AS n FROM otel_logs
WHERE "timestamp" @@ ts_between(TIMESTAMP_NS '2026-09-08 12:00:10.000000123',
                                TIMESTAMP_NS '2026-09-08 12:00:10.000000124', true, false);
----
n
1

query
SELECT service_name, severity_text FROM otel_logs
WHERE body @@ websearch_to_tsquery('"connection reset" -healthcheck')
  AND "timestamp" @@ ts_between(TIMESTAMP_NS '2026-09-08 00:00:00',
                                TIMESTAMP_NS '2026-09-09 00:00:00', true, false)
ORDER BY BM25(otel_logs.tableoid) DESC;
----
service_name	severity_text
checkout	ERROR

query
SELECT unnest(ts_dict_agg(severity_text)) AS severity,
       unnest(ts_dict_count(severity_text)) AS n
FROM otel_logs ORDER BY 1;
----
severity	n
ERROR	1
INFO	1
WARN	1

query
SELECT unnest(ts_dict_agg(service_name)) AS service,
       unnest(ts_dict_count(service_name)) AS n
FROM otel_logs WHERE body @@ 'reset' ORDER BY 1;
----
service	n
checkout	2

query
SELECT service_name FROM otel_logs WHERE trace_id @@ '0af7651916cd43dd8448eb211c80319c';
----
service_name
checkout

query
SELECT severity_text FROM otel_logs WHERE severity_number @@ ts_ge(13) ORDER BY 1;
----
severity_text
ERROR
WARN

query
SELECT body FROM otel_logs
WHERE service_name @@ 'checkout' AND log_attributes ->> 'http.status_code' = '502';
----
body
connection reset by peer /api/v1/users?id=42 from 10.0.0.7:5432 (took 12ms)

query
SELECT event_name FROM otel_logs WHERE event_name @@ 'cache.evict';
----
event_name
cache.evict

query
SELECT date_trunc('day', "timestamp") AS day, count(*) AS n
FROM otel_logs GROUP BY 1 ORDER BY 1;
----
day	n
2026-09-08 00:00:00	2
2026-09-09 00:00:00	1

query
SELECT list_sort(ts_lexize('otel_body_dict', 'ERROR io.grpc.Client 10.0.0.7:5432 took 12ms')) AS tokens;
----
tokens
{10.0.0.7,12ms,5432,error,io.grpc.client,took}

