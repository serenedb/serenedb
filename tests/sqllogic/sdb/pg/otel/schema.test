INSERT INTO otel_traces ("timestamp", end_timestamp, trace_id, span_id, parent_span_id,
                         trace_state, span_name, span_kind, service_name, duration_ns,
                         status_code, status_message, resource_schema_url, scope_schema_url,
                         scope_name, scope_version, resource_attributes, scope_attributes,
                         span_attributes, events, links, event_names, link_trace_ids)
VALUES (TIMESTAMP_NS '2026-09-08 12:00:00.000000000',
        TIMESTAMP_NS '2026-09-08 12:00:00.150000000',
        '0af7651916cd43dd8448eb211c80319c', 'b7ad6b7169203331', NULL,
        'rojo=00f067aa0ba902b7', 'GET /checkout', 'Server', 'checkout', 150000000,
        'Error', 'upstream timed out', 'https://opentelemetry.io/schemas/1.30.0', NULL,
        'io.opentelemetry.http', '1.0.0', '{"service.name":"checkout"}', NULL,
        '{"http.method":"GET","http.route":"/checkout"}',
        '[{"timestamp":"2026-09-08T12:00:00.100000000Z","name":"exception","attributes":{"exception.type":"TimeoutError"}}]',
        '[{"trace_id":"1bc2d3e4f5a6b7c8d9e0f1a2b3c4d5e6","span_id":"00f067aa0ba902b7","trace_state":"","attributes":{}}]',
        ARRAY['exception'], ARRAY['1bc2d3e4f5a6b7c8d9e0f1a2b3c4d5e6']),
       (TIMESTAMP_NS '2026-09-08 12:00:00.010000000',
        TIMESTAMP_NS '2026-09-08 12:00:00.012000000',
        '0af7651916cd43dd8448eb211c80319c', 'c1ad6b7169203332', 'b7ad6b7169203331',
        NULL, 'SELECT orders', 'Client', 'checkout', 2000000,
        'Ok', NULL, NULL, NULL, NULL, NULL, NULL, NULL,
        '{"db.system":"postgresql"}', '[]', '[]',
        ARRAY[]::VARCHAR[], ARRAY[]::VARCHAR[]),
       (TIMESTAMP_NS '2026-09-08 12:00:05.000000000',
        TIMESTAMP_NS '2026-09-08 12:00:05.300000000',
        '9fa1c3e5b7d90123456789abcdef0123', 'd2be7c8270314443', NULL,
        NULL, 'POST /cart', 'Server', 'cart', 300000000,
        'Unset', NULL, NULL, NULL, NULL, NULL, NULL, NULL,
        '{}', '[]', '[]', ARRAY[]::VARCHAR[], ARRAY[]::VARCHAR[]);

