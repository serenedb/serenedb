query
SELECT has_function_privilege('bfgs_admin', 'sdb_secrets()', 'EXECUTE') AS exec,
       array_to_string(proacl, ',') AS acl,
       pg_get_acl('pg_proc'::regclass, oid, 0) IS NOT DISTINCT FROM proacl AS same
FROM pg_proc WHERE oid = 'sdb_secrets()'::regprocedure;
