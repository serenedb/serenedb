statement ok
CREATE ROLE clv_peek LOGIN PASSWORD 'clv_pw';


statement ok
CREATE ROLE clv_other;


statement ok
CREATE SCHEMA clv_hidden;


statement ok
CREATE TABLE clv_hidden.clv_secret_table (a int);


statement ok
GRANT SELECT ON clv_hidden.clv_secret_table TO clv_other;


statement ok
CREATE TABLE clv_ungranted (a int);


statement ok
COMMENT ON TABLE clv_ungranted IS 'clv ungranted';


statement ok
CREATE TABLE clv_granted (a int, b int);


statement ok
GRANT SELECT (a) ON clv_granted TO clv_peek;


statement ok
CREATE VIEW clv_ungranted_view AS SELECT 1 AS a;


statement ok
CREATE SEQUENCE clv_ungranted_seq;


statement ok
CREATE FUNCTION clv_func() RETURNS int LANGUAGE sql AS 'SELECT 1';


statement ok
REVOKE EXECUTE ON FUNCTION clv_func() FROM PUBLIC;


statement ok
CREATE TABLE clv_oids AS
SELECT 'clv_hidden.clv_secret_table'::regclass::oid AS secret,
       'clv_ungranted'::regclass::oid AS ungranted,
       'clv_ungranted_view'::regclass::oid AS view_oid,
       'clv_hidden'::regnamespace::oid AS schema_oid,
       'clv_func()'::regprocedure::oid AS func_oid;


statement ok
GRANT SELECT ON clv_oids TO clv_peek;


connection c_peek user=clv_peek password=clv_pw
