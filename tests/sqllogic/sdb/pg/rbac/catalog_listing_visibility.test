connection c_peek user=clv_peek password=clv_pw
query
SELECT secret::regclass::text = secret::text AS secret_by_number,
       ungranted::regclass::text = ungranted::text AS ungranted_by_number,
       schema_oid::regnamespace::text = schema_oid::text AS schema_by_number,
       func_oid::regprocedure::text = func_oid::text AS function_by_number
FROM clv_oids;
