secret_by_number	ungranted_by_number	schema_by_number	function_by_number
t	t	t	t


connection c_peek user=clv_peek password=clv_pw
query
SELECT pg_get_viewdef(view_oid) IS NULL AS viewdef,
       pg_describe_object('pg_class'::regclass, ungranted, 0) IS NULL AS described,
       obj_description(ungranted, 'pg_class') IS NULL AS comment,
       has_table_privilege(ungranted, 'SELECT') IS NULL AS privilege
FROM clv_oids;
----
viewdef	described	comment	privilege
t	t	t	t


