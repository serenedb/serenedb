statement ok
CREATE FUNCTION dicc_compared() RETURNS boolean LANGUAGE sql SECURITY DEFINER
AS $$ SELECT 'dicc_s.t'::regclass = 'dicc_s.t' AND 'dicc_s.t' = 'dicc_s.t'::regclass
  AND 'dicc_s.t'::regclass IN ('dicc_s.t') AND 'dicc_s.t'::regclass BETWEEN 'dicc_s.t' AND 'dicc_s.t'
  AND 'dicc_s.t'::regclass IS NOT DISTINCT FROM 'dicc_s.t' $$;


statement ok
ALTER FUNCTION dicc_compared() OWNER TO dicc_owner;


connection c_dicc user=dicc_caller password=dicc_pw
query
