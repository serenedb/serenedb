statement ok
CREATE OR REPLACE SECRET eai_no_model_${__DATABASE__} (
  TYPE openai,
  base_url 'http://127.0.0.1:9'
);


statement error
SELECT ai_generate('x', secret_name := 'eai_no_model_${__DATABASE__}');
