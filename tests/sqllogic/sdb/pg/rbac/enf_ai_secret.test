statement ok
CREATE OR REPLACE SECRET eai_model_${__DATABASE__} (
  TYPE openai,
  base_url 'http://127.0.0.1:9',
  model 'm'
);


statement ok
CREATE FUNCTION eai_definer() RETURNS text LANGUAGE sql SECURITY DEFINER
AS $$ SELECT ai_generate('x', secret_name := 'eai_model_${__DATABASE__}') $$;


connection c_ved user=eai_vedernikoff password=eai_pw
statement ok
