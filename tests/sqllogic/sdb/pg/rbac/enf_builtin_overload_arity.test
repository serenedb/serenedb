statement ok
DROP SCHEMA IF EXISTS ebo_quas CASCADE;


statement ok
CREATE SCHEMA ebo_quas;


statement ok
CREATE MACRO ebo_quas.generate_series(a, b, c, d) AS TABLE SELECT a + b + c + d AS total;


statement ok
CREATE MACRO ebo_quas.array_extract(a := 1, b := 2) AS 'pudge';


statement ok
CREATE MACRO ebo_quas.struct_extract(a := 1, b := 2) AS 'anchin';


statement ok
SET search_path = ebo_quas, public;


query
SELECT total FROM generate_series(1, 2, 3, 4);
----
total
10


query
SELECT count(*) AS n FROM generate_series(1, 3);
----
n
3


query
SELECT ([10, 20, 30])[2] AS item, ({'k': 7}).k AS field;
----
item	field
20	7


statement ok
RESET search_path;


statement ok
DROP SCHEMA ebo_quas CASCADE;
