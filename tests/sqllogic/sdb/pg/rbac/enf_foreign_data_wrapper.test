----
fdwacl
{postgres=U/postgres,efw_alice=U*/postgres,efw_bob=U/efw_alice}


query
SELECT grantor, grantee, object_name, privilege_type, is_grantable
FROM information_schema.usage_privileges
WHERE object_type = 'FOREIGN DATA WRAPPER' AND grantee LIKE 'efw%'
ORDER BY grantee;
----
grantor	grantee	object_name	privilege_type	is_grantable
postgres	efw_alice	postgres_fdw	USAGE	YES
efw_alice	efw_bob	postgres_fdw	USAGE	NO


query
SELECT d.classid::regclass::text AS classid, w.fdwname, d.deptype
FROM pg_shdepend d JOIN pg_foreign_data_wrapper w ON w.oid = d.objid
WHERE d.refobjid = (SELECT oid FROM pg_roles WHERE rolname = 'efw_bob');
----
classid	fdwname	deptype
pg_foreign_data_wrapper	postgres_fdw	a


