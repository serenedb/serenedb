fdwacl
{postgres=U/postgres,efw_alice=U*/postgres}


query
SELECT has_foreign_data_wrapper_privilege('efw_alice', 'postgres_fdw', 'USAGE') AS pg,
       has_foreign_data_wrapper_privilege('efw_alice', 'postgres_fdw', 'USAGE WITH GRANT OPTION') AS pg_option,
       has_foreign_data_wrapper_privilege('efw_alice', 'clickhouse_fdw', 'USAGE') AS ch,
       has_foreign_data_wrapper_privilege('efw_bob', 'postgres_fdw', 'USAGE') AS bob;
----
pg	pg_option	ch	bob
t	t	f	f


