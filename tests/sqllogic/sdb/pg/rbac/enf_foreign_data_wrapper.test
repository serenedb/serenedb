statement ok
CREATE SERVER efw_srv FOREIGN DATA WRAPPER duckdb_fdw OPTIONS (path '${__TEST_DIR__}/efw_srv.db');


query
SELECT s.srvowner::regrole::text AS owner, w.fdwname
FROM pg_foreign_server s JOIN pg_foreign_data_wrapper w ON w.oid = s.srvfdw
WHERE s.srvname = 'efw_srv';
----
owner	fdwname
postgres	duckdb_fdw


