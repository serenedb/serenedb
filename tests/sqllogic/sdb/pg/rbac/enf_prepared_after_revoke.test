statement ok
DETACH epr_src_${__DATABASE__};


statement ok
CREATE SERVER epr_srv_${__DATABASE__} FOREIGN DATA WRAPPER duckdb_fdw OPTIONS (path '${__TEST_DIR__}/epr_src.duckdb', read_only 'true');


statement ok
GRANT USAGE ON FOREIGN SERVER epr_srv_${__DATABASE__} TO epr_vedernikoff;


