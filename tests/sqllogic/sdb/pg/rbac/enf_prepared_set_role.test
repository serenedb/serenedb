EXECUTE epsr_q2;
----
db error: ERROR: permission denied for table epsr_t


statement error
EXECUTE epsr_q3;
----
db error: ERROR: permission denied for table epsr_log


statement error
EXECUTE epsr_q4;
----
db error: ERROR: permission denied for sequence epsr_seq


statement ok
RESET ROLE;


query
EXECUTE epsr_q1;
----
n
10


query
SELECT count(*) AS n FROM epsr_log;
