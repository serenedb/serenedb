CREATE TABLE esa_docs (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
CREATE TEXT SEARCH DICTIONARY esa_english AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE INDEX esa_idx ON esa_docs USING inverted(id, body esa_english);


