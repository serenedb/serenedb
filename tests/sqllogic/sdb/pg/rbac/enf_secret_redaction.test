control substitution on

statement ok
CREATE OR REPLACE SECRET esr_refresh_${__DATABASE__} (
    TYPE s3,
    KEY_ID 'esr_key_id',
    SECRET 'AccessKey4711',
    SESSION_TOKEN 'SessionToken4711',
    REFRESH 'auto',
    SCOPE 's3://esr-refresh-${__DATABASE__}'
);


query
SELECT
    secret_string LIKE '%AccessKey4711%' AS secret_shown,
    secret_string LIKE '%SessionToken4711%' AS session_token_shown,
    secret_string LIKE '%refresh_info=redacted%' AS refresh_info_redacted
FROM sdb_secrets()
WHERE name = 'esr_refresh_${__DATABASE__}';
----
secret_shown	session_token_shown	refresh_info_redacted
f	f	t


statement ok
CREATE OR REPLACE SECRET esr_proxy_s3_${__DATABASE__} (
    TYPE s3,
    KEY_ID 'esr_key_id',
    SECRET 'esr_access_key',
    HTTP_PROXY 'proxy.example.com:3128',
    HTTP_PROXY_USERNAME 'esr_proxy_user',
    HTTP_PROXY_PASSWORD 'ProxyPw4711',
    SCOPE 's3://esr-proxy-s3-${__DATABASE__}'
);


statement ok
CREATE OR REPLACE SECRET esr_proxy_r2_${__DATABASE__} (
    TYPE r2,
    KEY_ID 'esr_key_id',
    SECRET 'esr_access_key',
    ACCOUNT_ID 'esr_account',
    HTTP_PROXY 'proxy.example.com:3128',
    HTTP_PROXY_USERNAME 'esr_proxy_user',
    HTTP_PROXY_PASSWORD 'ProxyPw4711',
    SCOPE 'r2://esr-proxy-r2-${__DATABASE__}'
);


statement ok
CREATE OR REPLACE SECRET esr_proxy_gcs_${__DATABASE__} (
    TYPE gcs,
    KEY_ID 'esr_key_id',
    SECRET 'esr_access_key',
    HTTP_PROXY 'proxy.example.com:3128',
    HTTP_PROXY_USERNAME 'esr_proxy_user',
    HTTP_PROXY_PASSWORD 'ProxyPw4711',
    SCOPE 'gcs://esr-proxy-gcs-${__DATABASE__}'
);


query
SELECT
    type,
    secret_string LIKE '%ProxyPw4711%' AS password_shown,
    secret_string LIKE '%http_proxy_password=redacted%' AS password_redacted
FROM sdb_secrets()
WHERE name LIKE 'esr_proxy_%_${__DATABASE__}'
ORDER BY type;
----
type	password_shown	password_redacted
gcs	f	t
r2	f	t
s3	f	t


statement ok
DROP SECRET esr_proxy_gcs_${__DATABASE__};


statement ok
DROP SECRET esr_proxy_r2_${__DATABASE__};


statement ok
DROP SECRET esr_proxy_s3_${__DATABASE__};


statement ok
DROP SECRET esr_refresh_${__DATABASE__};
