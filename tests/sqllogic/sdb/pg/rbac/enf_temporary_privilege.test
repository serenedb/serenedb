control substitution on

statement ok
DROP TABLE IF EXISTS etp_votes;


statement ok
DROP ROLE IF EXISTS etp_vedernikoff;


statement ok
CREATE ROLE etp_vedernikoff LOGIN PASSWORD 'etp_pw';


statement ok
CREATE TABLE etp_votes (choice text);


statement ok
INSERT INTO etp_votes VALUES ('pudge'), ('pudge'), ('clickclack');


statement ok
GRANT SELECT ON etp_votes TO etp_vedernikoff;


connection c_etp user=etp_vedernikoff password=etp_pw
query
SELECT * FROM (PIVOT etp_votes ON choice USING count(*));
----
clickclack	pudge
1	2


