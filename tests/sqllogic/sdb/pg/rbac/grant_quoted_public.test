statement ok
CREATE TABLE gqp_t (x INTEGER);

statement ok
GRANT SELECT ON gqp_t TO "PUBLIC";

query
SELECT has_table_privilege('PUBLIC', 'gqp_t', 'SELECT') AS role,
  has_table_privilege('gqp_other_${__DATABASE__}', 'gqp_t', 'SELECT') AS other;
----
role	other
t	f

