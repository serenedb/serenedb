connection c_ved user=pfc_vedernikoff password=pfc_pw
query
SELECT
  count(*) FILTER (WHERE allowed) AS allowed,
  count(*) FILTER (WHERE member) AS member
FROM (
  SELECT has_table_privilege('public.pfc_granted', 'SELECT') AS allowed, pg_has_role('pfc_outsider_role', 'pfc_vedernikoff', 'USAGE') AS member
  FROM range(3000)
);
----
allowed	member
