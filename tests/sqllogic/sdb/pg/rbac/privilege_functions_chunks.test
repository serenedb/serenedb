connection c_ved user=pfc_vedernikoff password=pfc_pw
query
SELECT
  count(*) FILTER (WHERE member) AS member,
  count(*) FILTER (WHERE NOT member) AS other,
  count(*) FILTER (WHERE member IS NULL) AS unknown
FROM (
  SELECT pg_has_role(CASE i % 3 WHEN 0 THEN 'pfc_vedernikoff' WHEN 1 THEN 'pfc_outsider_role' END, 'MEMBER') AS member
  FROM range(3000) AS r(i)
);
