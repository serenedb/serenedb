CREATE TEXT SEARCH DICTIONARY rls_ixm_english AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);


statement ok
CREATE TABLE rls_ixm_docs (pk int PRIMARY KEY, author text, team text, level int, body text, tags text);


