statement ok
DROP TABLE IF EXISTS rls_ix_posts;


statement ok
DROP TEXT SEARCH DICTIONARY IF EXISTS rls_ix_english;


statement ok
DROP ROLE IF EXISTS rls_ix_arelav;


statement ok
DROP ROLE IF EXISTS rls_ix_babsky;


statement ok
CREATE ROLE rls_ix_arelav;


statement ok
CREATE ROLE rls_ix_babsky;


statement ok
CREATE TEXT SEARCH DICTIONARY rls_ix_english AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE TABLE rls_ix_posts (pk int PRIMARY KEY, author text, body text);


statement ok
INSERT INTO rls_ix_posts VALUES
  (1, 'rls_ix_arelav', 'arelav is a skuf'),
  (2, 'rls_ix_babsky', 'babsky calls every skuf to the meeting'),
  (3, 'rls_ix_arelav', 'clickclack deadinside'),
  (4, 'rls_ix_babsky', 'vedernikoff is no skuf');


statement ok
CREATE INDEX rls_ix_posts_idx ON rls_ix_posts USING inverted(body rls_ix_english) INCLUDE (pk, author);


statement ok
GRANT SELECT ON rls_ix_posts TO rls_ix_arelav;


statement ok
GRANT SELECT ON rls_ix_posts TO rls_ix_babsky;


statement ok
ALTER TABLE rls_ix_posts ENABLE ROW LEVEL SECURITY;


statement ok
CREATE POLICY rls_ix_author ON rls_ix_posts USING (author = current_user);


query
SELECT pk FROM rls_ix_posts_idx WHERE body @@ ts_phrase('skuf') ORDER BY pk;
----
pk
1
2
4


statement ok
SET ROLE rls_ix_arelav;


query
SELECT pk, body FROM rls_ix_posts_idx WHERE body @@ ts_phrase('skuf') ORDER BY pk;
----
pk	body
1	arelav is a skuf


query
EXPLAIN SELECT pk FROM rls_ix_posts_idx WHERE body @@ ts_phrase('skuf');
----
QUERY PLAN
╭─ IRESEARCH_SCAN ────────────────────────╮
│ Index: rls_ix_posts_idx                 │
│ Index Filter:                           │
│ ╭─ Term ──────────────╮                 │
│ │ Field: body(string) │                 │
│ │ Value: skuf         │                 │
│ ╰─────────────────────╯                 │
│ Column Filter: author = 'rls_ix_arelav' │
│ Projections: pk                         │
│ ~1 row                                  │
╰─────────────────────────────────────────╯


query
SELECT pk FROM iresearch_scan(current_database(), 'public', 'rls_ix_posts_idx') ORDER BY pk;
----
pk
1
3


query
SELECT count(*) FROM rls_ix_posts_idx WHERE body @@ ts_phrase('skuf') AND CASE WHEN pk = 4 THEN error('leak through the index') ELSE true END;
----
count
1


