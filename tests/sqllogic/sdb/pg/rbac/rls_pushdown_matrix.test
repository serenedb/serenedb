statement ok
DROP TABLE IF EXISTS rls_pm_vault;


statement ok
DROP TABLE IF EXISTS rls_pm_owners;


statement ok
DROP ROLE IF EXISTS rls_pm_arelav;


statement ok
CREATE ROLE rls_pm_arelav;


statement ok
CREATE TABLE rls_pm_vault (id int, owner text, squad text, points int, bonus int, note text, opened date);


statement ok
INSERT INTO rls_pm_vault SELECT n, CASE WHEN n % 2 = 0 THEN 'rls_pm_arelav' ELSE 'babsky' END, CASE n % 3 WHEN 0 THEN 'clickclack' WHEN 1 THEN 'deadinside' ELSE 'salam' END, (n * 7) % 50, CASE WHEN n % 4 = 0 THEN NULL ELSE n % 5 END, CASE WHEN n % 2 = 0 THEN n::text ELSE 'secret' END, DATE '2026-01-01' + n::int FROM generate_series(1, 40) AS g(n);


statement ok
CREATE TABLE rls_pm_owners (owner text, squad text);


statement ok
INSERT INTO rls_pm_owners VALUES ('rls_pm_arelav', 'clickclack'), ('rls_pm_arelav', 'salam'), ('babsky', 'deadinside');


statement ok
GRANT SELECT ON rls_pm_vault TO rls_pm_arelav;


statement ok
GRANT SELECT ON rls_pm_owners TO rls_pm_arelav;


statement ok
ALTER TABLE rls_pm_vault ENABLE ROW LEVEL SECURITY;


statement ok
CREATE POLICY rls_pm_own ON rls_pm_vault FOR SELECT USING (owner = current_user);


statement ok
SET ROLE rls_pm_arelav;


