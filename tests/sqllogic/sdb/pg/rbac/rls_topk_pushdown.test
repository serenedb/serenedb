INSERT INTO rls_tk_board SELECT n, CASE WHEN n % 3 = 0 THEN 'rls_tk_arelav' ELSE 'rls_tk_babsky' END, CASE n % 4 WHEN 0 THEN 'clickclack' WHEN 1 THEN 'deadinside' WHEN 2 THEN 'salam' ELSE 'skuf' END, (n * 37) % 101, CASE WHEN n % 3 = 0 THEN n::text ELSE 'hidden' END FROM generate_series(1, 300) AS g(n);


