CREATE FUNCTION sdbl_s.listed_tables() RETURNS text LANGUAGE sql SECURITY DEFINER
AS 'SELECT string_agg(table_name, '','' ORDER BY table_name) FROM information_schema.tables WHERE table_name IN (''sdbl_hidden'', ''sdbl_shown'')';


statement ok
CREATE FUNCTION sdbl_s.listed_columns() RETURNS text LANGUAGE sql SECURITY DEFINER
AS 'SELECT string_agg(column_name, '','' ORDER BY column_name) FROM information_schema.columns WHERE table_name IN (''sdbl_hidden'', ''sdbl_shown'')';


