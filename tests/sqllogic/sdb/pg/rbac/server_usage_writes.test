control substitution on

statement ok
DROP SERVER IF EXISTS suw_s;


statement ok
DROP ROLE IF EXISTS suw_bob;


statement ok
CREATE SERVER suw_s FOREIGN DATA WRAPPER duckdb_fdw OPTIONS (path '${__TEST_DIR__}/suw.duckdb');


statement ok
CREATE OR REPLACE TABLE suw_s.main.t (a int);


statement ok
CREATE ROLE suw_bob LOGIN PASSWORD 'suw_pw';


statement ok
GRANT USAGE ON FOREIGN SERVER suw_s TO suw_bob;


connection c_bob user=suw_bob password=suw_pw
query
SELECT count(*) AS n FROM suw_s.main.t;
----
n
0


connection c_bob user=suw_bob password=suw_pw
statement ok
INSERT INTO suw_s.main.t VALUES (1), (2);


connection c_bob user=suw_bob password=suw_pw
statement ok
UPDATE suw_s.main.t SET a = a * 10 WHERE a = 2;


connection c_bob user=suw_bob password=suw_pw
statement ok
DELETE FROM suw_s.main.t WHERE a = 1;


connection c_bob user=suw_bob password=suw_pw
query
SELECT a FROM suw_s.main.t ORDER BY a;
----
a
20


connection c_bob user=suw_bob password=suw_pw
query
SELECT has_table_privilege('suw_s.main.t', 'SELECT') AS can_select,
       has_table_privilege('suw_s.main.t', 'INSERT, UPDATE, DELETE') AS can_write,
       has_table_privilege('suw_s.main.t', 'SELECT WITH GRANT OPTION') AS can_grant;
----
can_select	can_write	can_grant
t	t	f


connection c_bob user=suw_bob password=suw_pw
statement error
GRANT SELECT ON suw_s.main.t TO PUBLIC;
----
db error: ERROR: permission denied for table t


connection c_bob user=suw_bob password=suw_pw
statement error
CREATE TABLE suw_s.main.t2 (a int);
----
db error: ERROR: permission denied for schema main


statement ok
REVOKE USAGE ON FOREIGN SERVER suw_s FROM suw_bob;


connection c_bob user=suw_bob password=suw_pw
statement error
INSERT INTO suw_s.main.t VALUES (3);
----
db error: ERROR: Table with name "suw_s.main.t" does not exist because schema "suw_s.main" does not exist.<slt:ignore>


statement ok
DROP SERVER suw_s;


statement ok
DROP ROLE suw_bob;
