control substitution on

statement ok
DROP ROLE IF EXISTS vfgnp_reader;


statement ok
CREATE ROLE vfgnp_reader;


statement ok
COPY (SELECT 1 AS id) TO '${__TEST_DIR__}/vfgnp_a.csv' (HEADER);


statement ok
COPY (SELECT 2 AS id) TO '${__TEST_DIR__}/vfgnp_b.csv' (HEADER);


statement ok
CREATE VIEW vfgnp_dot AS SELECT id FROM read_csv('${__TEST_DIR__}/./vfgnp_*.csv');


statement ok
CREATE VIEW vfgnp_parent AS SELECT id FROM read_csv('${__TEST_DIR__}/vfgnp_missing/../vfgnp_*.csv');


statement ok
GRANT SELECT ON vfgnp_dot, vfgnp_parent TO vfgnp_reader;


statement ok
SET ROLE vfgnp_reader;


query
SELECT id FROM vfgnp_dot ORDER BY id;
----
id
1
2


query
SELECT id FROM vfgnp_parent ORDER BY id;
----
id
1
2


statement error
SELECT id FROM read_csv('${__TEST_DIR__}/./vfgnp_*.csv');
----
db error: ERROR: permission denied to access "<slt:ignore>/./vfgnp_*.csv"
DETAIL: Only roles with privileges of the "pg_read_server_files" role may read server files and URLs.


statement ok
RESET ROLE;


statement ok
DROP VIEW vfgnp_dot;


statement ok
DROP VIEW vfgnp_parent;


statement ok
DROP ROLE vfgnp_reader;
