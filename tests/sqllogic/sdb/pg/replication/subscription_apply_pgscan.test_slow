control substitution on

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS rapp_${__DATABASE__} (TYPE postgres);


statement ok
CALL postgres_execute('rapp_${__DATABASE__}', 'SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name LIKE ''rapp\_%''');


statement ok
CALL postgres_execute('rapp_${__DATABASE__}', 'DO $$ BEGIN DROP PUBLICATION IF EXISTS rapp_text_pub; DROP PUBLICATION IF EXISTS rapp_bin_pub; DROP PUBLICATION IF EXISTS rapp_pub; DROP SCHEMA IF EXISTS rapp_text CASCADE; DROP SCHEMA IF EXISTS rapp_bin CASCADE; DROP TABLE IF EXISTS rapp_full, rapp_index, rapp_toast, rapp_conflict, rapp_owned, rapp_alter, rapp_tparent, rapp_tseq; DROP TYPE IF EXISTS rapp_mood; END $$');


statement ok
CALL postgres_execute('rapp_${__DATABASE__}', 'DO $$ DECLARE s text; BEGIN FOREACH s IN ARRAY ARRAY[''rapp_text'', ''rapp_bin''] LOOP EXECUTE format(''CREATE SCHEMA %I'', s); EXECUTE format(''CREATE TABLE %I.types (id int PRIMARY KEY, i2 smallint, i8 bigint, num numeric(12,3), f4 real, f8 double precision, b boolean, t text, vc varchar(10), bt bytea, d date, tm time, ts timestamp, tz timestamptz, iv interval, u uuid, j json, ai int[], at text[])'', s); EXECUTE format(''INSERT INTO %I.types VALUES (1, -32768, 9223372036854775807, -123456789.125, 1.5, -2.25e-10, true, ''''tab\there "quoted" \\ back'''', ''''short'''', ''''\x00ff10'''', ''''2024-02-29'''', ''''23:59:59.999999'''', ''''1999-12-31 23:59:59.5'''', ''''2024-01-01 00:00:00+00'''', ''''1 year 2 mons 3 days 04:05:06'''', ''''a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'''', ''''{"k": [1, 2, {"x": null}]}'''', ''''{1,NULL,3}'''', ''''{"a b",NULL,"c,d"}'''')'', s); END LOOP; CREATE PUBLICATION rapp_text_pub FOR TABLE rapp_text.types; CREATE PUBLICATION rapp_bin_pub FOR TABLE rapp_bin.types; END $$');


statement ok
CREATE SCHEMA rapp_text;


statement ok
CREATE SCHEMA rapp_bin;


statement ok
CREATE TABLE rapp_text.types (id INTEGER PRIMARY KEY, i2 SMALLINT, i8 BIGINT, num DECIMAL(12, 3), f4 REAL, f8 DOUBLE, b BOOLEAN, t TEXT, vc VARCHAR(10), bt BYTEA, d DATE, tm TIME, ts TIMESTAMP, tz TIMESTAMPTZ, iv INTERVAL, u UUID, j JSON, ai INTEGER[], at TEXT[]);


statement ok
CREATE TABLE rapp_bin.types (id INTEGER PRIMARY KEY, i2 SMALLINT, i8 BIGINT, num DECIMAL(12, 3), f4 REAL, f8 DOUBLE, b BOOLEAN, t TEXT, vc VARCHAR(10), bt BYTEA, d DATE, tm TIME, ts TIMESTAMP, tz TIMESTAMPTZ, iv INTERVAL, u UUID, j JSON, ai INTEGER[], at TEXT[]);


statement ok
CREATE SUBSCRIPTION rapp_text CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' PUBLICATION rapp_text_pub WITH (slot_name = 'rapp_text');


statement ok
CREATE SUBSCRIPTION rapp_bin CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' PUBLICATION rapp_bin_pub WITH (slot_name = 'rapp_bin', binary = true);


statement ok
CALL postgres_execute('rapp_${__DATABASE__}', 'DO $$ DECLARE s text; BEGIN FOREACH s IN ARRAY ARRAY[''rapp_text'', ''rapp_bin''] LOOP EXECUTE format(''INSERT INTO %I.types (id) VALUES (2)'', s); EXECUTE format(''INSERT INTO %I.types SELECT 3, i2, i8, num, f4, f8, b, t, vc, bt, d, tm, ts, tz, iv, u, j, ai, at FROM %I.types WHERE id = 1'', s, s); END LOOP; END $$');


query ok retry 120 backoff 250ms
SELECT (SELECT count(*) FROM rapp_text.types) AS text_rows, (SELECT count(*) FROM rapp_bin.types) AS bin_rows;
----
text_rows	bin_rows
3	3


query
SELECT id, i2, i8, num, f4, f8::TEXT AS f8, b, t, vc, bt, d, tm, ts::TEXT AS ts, tz, iv, u, j, ai, at FROM rapp_text.types ORDER BY id;
----
id	i2	i8	num	f4	f8	b	t	vc	bt	d	tm	ts	tz	iv	u	j	ai	at
1	-32768	9223372036854775807	-123456789.125	1.5	-2.25e-10	t	tab\\there "quoted" \\\\ back	short	\\x00ff10	2024-02-29	23:59:59.999999	1999-12-31 23:59:59.5	2024-01-01 00:00:00+00	1 year 2 mons 3 days 04:05:06	a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11	{"k": [1, 2, {"x": null}]}	{1,NULL,3}	{"a b",NULL,"c,d"}
2	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
3	-32768	9223372036854775807	-123456789.125	1.5	-2.25e-10	t	tab\\there "quoted" \\\\ back	short	\\x00ff10	2024-02-29	23:59:59.999999	1999-12-31 23:59:59.5	2024-01-01 00:00:00+00	1 year 2 mons 3 days 04:05:06	a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11	{"k": [1, 2, {"x": null}]}	{1,NULL,3}	{"a b",NULL,"c,d"}


query
SELECT count(*) AS differences FROM (SELECT id, i2, i8, num, f4, f8, b, t, vc, bt, d, tm, ts, tz, iv, u, j::TEXT, ai, at FROM rapp_text.types EXCEPT SELECT id, i2, i8, num, f4, f8, b, t, vc, bt, d, tm, ts, tz, iv, u, j::TEXT, ai, at FROM rapp_bin.types);
----
differences
0


statement ok
CALL postgres_execute('rapp_${__DATABASE__}', 'DO $$ BEGIN CREATE TABLE rapp_full (a int, b text); ALTER TABLE rapp_full REPLICA IDENTITY FULL; CREATE TABLE rapp_index (a int NOT NULL, b int NOT NULL, v text); CREATE UNIQUE INDEX rapp_index_ab ON rapp_index (a, b); ALTER TABLE rapp_index REPLICA IDENTITY USING INDEX rapp_index_ab; CREATE TABLE rapp_toast (id int PRIMARY KEY, big text, small int); CREATE TABLE rapp_conflict (id int PRIMARY KEY, v text); CREATE TABLE rapp_owned (id int PRIMARY KEY); CREATE TABLE rapp_alter (id int PRIMARY KEY, n int); INSERT INTO rapp_alter VALUES (1, 7); CREATE TYPE rapp_mood AS ENUM (''sad'', ''happy''); CREATE TABLE rapp_tparent (id int PRIMARY KEY); CREATE TABLE rapp_tseq (id int PRIMARY KEY, v text); CREATE PUBLICATION rapp_pub FOR TABLE rapp_full, rapp_index, rapp_toast, rapp_conflict, rapp_owned, rapp_alter, rapp_tparent, rapp_tseq; END $$');


statement ok
CREATE TABLE rapp_full (a INTEGER, b TEXT);


statement ok
CREATE TABLE rapp_index (a INTEGER NOT NULL, b INTEGER NOT NULL, v TEXT);


statement ok
CREATE TABLE rapp_toast (id INTEGER PRIMARY KEY, big TEXT, small INTEGER);


statement ok
CREATE TABLE rapp_conflict (id INTEGER PRIMARY KEY, v TEXT);


statement ok
CREATE TABLE rapp_alter (id INTEGER PRIMARY KEY, n BIGINT, m TEXT);


statement ok
CREATE TABLE rapp_tparent (id INTEGER PRIMARY KEY);


statement ok
CREATE TABLE rapp_tchild (id INTEGER, parent INTEGER REFERENCES rapp_tparent (id));


statement ok
CREATE TABLE rapp_tseq (id SERIAL PRIMARY KEY, v TEXT);


statement ok
