control substitution on

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS rauth_${__DATABASE__} (TYPE postgres);


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name LIKE ''rauth\_%''');


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'DO $$ DECLARE r text; BEGIN FOREACH r IN ARRAY ARRAY[''rauth_md5'', ''rauth_scram'', ''rauth_plain'', ''rauth_allow'', ''rauth_nossl'', ''rauth_tls''] LOOP EXECUTE format(''DROP PUBLICATION IF EXISTS %I'', r); EXECUTE format(''DROP TABLE IF EXISTS %I'', r); EXECUTE format(''DROP ROLE IF EXISTS %I'', r); END LOOP; DROP TABLE IF EXISTS rauth_pem; END $$');


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'DO $$ DECLARE r text; BEGIN FOREACH r IN ARRAY ARRAY[''rauth_md5'', ''rauth_scram'', ''rauth_plain'', ''rauth_allow'', ''rauth_nossl'', ''rauth_tls''] LOOP EXECUTE format(''CREATE TABLE %I (id integer PRIMARY KEY, v text)'', r); EXECUTE format(''INSERT INTO %I VALUES (1, %L)'', r, r); EXECUTE format(''CREATE PUBLICATION %I FOR TABLE %I'', r, r); END LOOP; END $$');


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'DO $$ BEGIN EXECUTE format(''CREATE ROLE rauth_md5 LOGIN REPLICATION PASSWORD %L'', ''md5'' || md5(''md5 secret'' || ''rauth_md5'')); CREATE ROLE rauth_scram LOGIN REPLICATION PASSWORD ''scram secret''; CREATE ROLE rauth_plain LOGIN REPLICATION PASSWORD ''plain secret''; CREATE ROLE rauth_tls LOGIN REPLICATION PASSWORD ''tls secret''; CREATE ROLE rauth_nossl LOGIN REPLICATION PASSWORD ''nossl secret''; CREATE ROLE rauth_allow; GRANT SELECT ON rauth_allow TO rauth_tls; GRANT SELECT ON rauth_nossl TO rauth_nossl; GRANT SELECT ON rauth_md5 TO rauth_md5; GRANT SELECT ON rauth_scram TO rauth_scram; GRANT SELECT ON rauth_plain TO rauth_plain; GRANT SELECT ON rauth_tls TO rauth_tls; END $$');


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'CREATE TABLE rauth_pem (pem text)');


statement ok
INSERT INTO rauth_${__DATABASE__}.public.rauth_pem SELECT content FROM read_text('${RESOURCES}/ca.pem');


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'DO $$ BEGIN COPY (SELECT unnest(string_to_array(rtrim(pem, E''\n''), E''\n'')) FROM rauth_pem) TO PROGRAM ''umask 077 && cat > rauth.pem''; EXECUTE format(''COPY (SELECT unnest(ARRAY[''''local all all trust'''', ''''host all rauth_md5 all md5'''', ''''host all rauth_scram all scram-sha-256'''', ''''host all rauth_plain all password'''', ''''hostnossl all rauth_tls all reject'''', ''''hostssl all rauth_tls all scram-sha-256'''', ''''hostssl all rauth_nossl all reject'''', ''''host all rauth_nossl all scram-sha-256'''', ''''host all all all trust'''', ''''local replication all trust'''', ''''host replication all all trust''''])) TO %L'', current_setting(''hba_file'')); END $$');


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'ALTER SYSTEM SET ssl_cert_file = ''rauth.pem''', use_transaction := false);


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'ALTER SYSTEM SET ssl_key_file = ''rauth.pem''', use_transaction := false);


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'ALTER SYSTEM SET ssl = on', use_transaction := false);


statement ok
CALL postgres_execute('rauth_${__DATABASE__}', 'SELECT pg_reload_conf()');


query ok retry 40 backoff 250ms
SELECT * FROM postgres_query('rauth_${__DATABASE__}', 'SELECT current_setting(''ssl'') AS ssl');
----
ssl
on


