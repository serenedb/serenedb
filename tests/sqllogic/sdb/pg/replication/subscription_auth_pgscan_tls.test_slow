statement ok
CREATE SUBSCRIPTION rauth_md5 CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=rauth_md5 password=''md5 secret'' sslmode=disable' PUBLICATION rauth_md5 WITH (slot_name = 'rauth_md5');


statement ok
CREATE SUBSCRIPTION rauth_scram CONNECTION 'postgresql://rauth_scram:scram%20secret@${PGHOST}:${PGPORT}/postgres?sslmode=prefer&application_name=rauth_app' PUBLICATION rauth_scram WITH (slot_name = 'rauth_scram');


statement ok
CREATE SUBSCRIPTION rauth_plain CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=rauth_plain password=''plain secret'' sslmode=disable connect_timeout=5' PUBLICATION rauth_plain WITH (slot_name = 'rauth_plain');


statement ok
CREATE SUBSCRIPTION rauth_tls CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=rauth_tls password=''tls secret'' sslmode=verify-ca sslrootcert=${RESOURCES}/ca.pem' PUBLICATION rauth_tls WITH (slot_name = 'rauth_tls', binary = true);


statement ok
CREATE SUBSCRIPTION rauth_nossl CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=rauth_nossl password=''nossl secret'' sslmode=prefer' PUBLICATION rauth_nossl WITH (slot_name = 'rauth_nossl');


statement ok
CREATE SUBSCRIPTION rauth_allow CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=rauth_tls password=''tls secret'' sslmode=allow' PUBLICATION rauth_allow WITH (slot_name = 'rauth_allow');


query ok retry 120 backoff 250ms
SELECT (SELECT v FROM rauth_md5) AS md5, (SELECT v FROM rauth_scram) AS scram, (SELECT v FROM rauth_plain) AS plain, (SELECT v FROM rauth_tls) AS tls, (SELECT v FROM rauth_nossl) AS nossl, (SELECT v FROM rauth_allow) AS allow;
