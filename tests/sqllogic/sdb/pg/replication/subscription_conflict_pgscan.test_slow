control substitution on

statement ok
ATTACH 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' AS rcon_${__DATABASE__} (TYPE postgres);


statement ok
CALL postgres_execute('rcon_${__DATABASE__}', 'SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name LIKE ''rcon\_%''');


statement ok
CALL postgres_execute('rcon_${__DATABASE__}', 'DO $$ BEGIN DROP PUBLICATION IF EXISTS rcon_pub; DROP TABLE IF EXISTS rcon_multi; END $$');


statement ok
CALL postgres_execute('rcon_${__DATABASE__}', 'DO $$ BEGIN CREATE TABLE rcon_multi (id int PRIMARY KEY, email text UNIQUE, code int); CREATE UNIQUE INDEX rcon_multi_code ON rcon_multi (code); INSERT INTO rcon_multi VALUES (50, ''e@x'', 5); CREATE PUBLICATION rcon_pub FOR TABLE rcon_multi; END $$');


statement ok
CREATE TABLE rcon_multi (id INTEGER PRIMARY KEY, email TEXT UNIQUE, code INTEGER);


statement ok
CREATE UNIQUE INDEX rcon_multi_code ON rcon_multi (code);


statement ok
CREATE SUBSCRIPTION rcon_sub CONNECTION 'host=${PGHOST} port=${PGPORT} dbname=postgres user=${PGUSER}' PUBLICATION rcon_pub WITH (slot_name = 'rcon_sub');


query ok retry 240 backoff 250ms
SELECT count(*) AS n FROM rcon_multi;
----
n
1


query
SELECT confl_multiple_unique_conflicts, stats_reset IS NULL AS never_reset FROM pg_stat_subscription_stats WHERE subname = 'rcon_sub';
----
confl_multiple_unique_conflicts	never_reset
0	t


