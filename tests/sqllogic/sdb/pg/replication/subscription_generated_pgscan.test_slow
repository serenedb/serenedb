statement ok
DROP SUBSCRIPTION rgen_sub_badsync;


statement ok
DROP SUBSCRIPTION rgen_sub_bad;


statement ok
DROP SUBSCRIPTION rgen_sub_stored;


statement ok
DROP SUBSCRIPTION rgen_sub_none;


statement ok
CALL postgres_execute('rgen_${__DATABASE__}', 'DO $$ BEGIN DROP PUBLICATION rgen_pub_stored; DROP PUBLICATION rgen_pub_bad; DROP PUBLICATION rgen_pub_none; DROP PUBLICATION rgen_pub_badsync; DROP TABLE rgen_plain, rgen_bad, rgen_local, rgen_badsync; END $$');


statement ok
DETACH rgen_${__DATABASE__};
