statement ok
CALL postgres_execute('rstr_${__DATABASE__}', 'CREATE EXTENSION IF NOT EXISTS dblink');


statement ok
CALL postgres_execute('rstr_${__DATABASE__}', 'SELECT dblink_connect(''rstr_long'', ''dbname=postgres user=${PGUSER}'') AS long_conn, dblink_connect(''rstr_outer'', ''dbname=postgres user=${PGUSER}'') AS outer_conn, dblink_connect(''rstr_other'', ''dbname=postgres user=${PGUSER}'') AS other_conn');


statement ok
CALL postgres_execute('rstr_${__DATABASE__}', 'SELECT dblink_send_query(''rstr_long'', ''BEGIN; INSERT INTO rstr_big SELECT g, ''''long'''' FROM generate_series(600001, 620000) g; SELECT pg_sleep(3); INSERT INTO rstr_big SELECT g, ''''long'''' FROM generate_series(620001, 640000) g; COMMIT;'')');


