statement ok
CALL postgres_execute('rstr_${__DATABASE__}', 'DO $$ BEGIN UPDATE rstr_big SET v = ''updated'' WHERE v = ''eager'' AND id % 2 = 0; DELETE FROM rstr_big WHERE v = ''eager'' AND id % 5 = 0; END $$');


query ok retry 240 backoff 250ms
