query
SELECT current_setting('lock_timeout') AS lock_timeout, current_setting('max_connections') AS max_connections;
----
lock_timeout	max_connections
0	0


query
SELECT count(*) AS not_showable
FROM pg_settings
WHERE category <> 'Customized Options' AND current_setting(name) IS NULL;
----
not_showable
0


statement ok
SET lock_timeout = '5s';


query
SELECT setting, source FROM pg_settings WHERE name = 'lock_timeout';
----
setting	source
5000	session


query
