query
SELECT name, context, setting
FROM pg_settings
WHERE name IN ('lock_timeout', 'max_connections', 'max_identifier_length', 'work_mem')
ORDER BY name;
----
name	context	setting
lock_timeout	user	0
max_connections	postmaster	0
max_identifier_length	internal	63
work_mem	user	4096
