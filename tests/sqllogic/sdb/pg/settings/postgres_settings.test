query
SELECT string_agg(name, ' ' ORDER BY lower(name)) AS settings
FROM pg_settings
WHERE category <> 'Customized Options'
----
settings
application_name bytea_output check_function_bodies client_encoding client_min_messages DateStyle default_table_access_method default_tablespace default_transaction_isolation default_transaction_read_only extra_float_digits idle_in_transaction_session_timeout in_hot_standby integer_datetimes IntervalStyle lc_messages lc_monetary lc_numeric lc_time lock_timeout maintenance_work_mem max_connections max_identifier_length max_prepared_transactions password_encryption row_security scram_iterations search_path server_encoding server_version server_version_num standard_conforming_strings statement_timeout synchronous_commit TimeZone transaction_deferrable transaction_isolation transaction_read_only transaction_timeout work_mem xmloption


