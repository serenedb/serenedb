query
SELECT
  current_setting('lock_timeout') AS lock_timeout,
  current_setting('idle_in_transaction_session_timeout') AS idle,
  current_setting('transaction_timeout') AS transaction_timeout,
  current_setting('check_function_bodies') AS check_function_bodies,
  current_setting('row_security') AS row_security,
  current_setting('default_tablespace') AS default_tablespace,
  current_setting('default_table_access_method') AS access_method,
  current_setting('synchronize_seqscans') AS synchronize_seqscans
----
lock_timeout	idle	transaction_timeout	check_function_bodies	row_security	default_tablespace	access_method	synchronize_seqscans
0	0	0	off	off	(empty)	heap	off


statement ok
RESET ALL


