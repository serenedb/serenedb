query
SELECT name, setting, context, min_val, max_val
FROM pg_settings
WHERE name = 'max_connections'
----
name	setting	context	min_val	max_val
max_connections	0	postmaster	0	4294967295


query
SELECT name, enumvals
FROM pg_settings
WHERE name IN ('transaction_isolation', 'default_transaction_isolation')
ORDER BY name
----
name	enumvals
default_transaction_isolation	{"repeatable read","read committed"}
transaction_isolation	{"repeatable read","read committed"}


query
SELECT short_desc FROM pg_settings WHERE name = 'statement_timeout'
----
short_desc
Sets the maximum allowed duration of any statement.


