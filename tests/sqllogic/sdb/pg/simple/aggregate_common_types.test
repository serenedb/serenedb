statement ok
SET disabled_optimizers = 'common_aggregate';

statement ok
CREATE OR REPLACE TABLE acs_off AS
SELECT 'avg beside its parts' AS shape, g::VARCHAR AS k, (count(*) || '|' || sum(v) || '|' || min(v) || '|' || max(v) || '|' || avg(v)) AS r FROM acs GROUP BY g
UNION ALL SELECT 'two averages', g::VARCHAR, (avg(v) || '|' || avg(v + 1) || '|' || count(v) || '|' || sum(v)) FROM acs GROUP BY g
UNION ALL SELECT 'repeated average', g::VARCHAR, (avg(v) || '|' || avg(v) || '|' || avg(f) || '|' || stddev(v)) FROM acs GROUP BY g
UNION ALL SELECT 'distinct beside average', g::VARCHAR, (count(*) || '|' || count(v) || '|' || count(DISTINCT v) || '|' || avg(v)) FROM acs GROUP BY g
UNION ALL SELECT 'filtered average', g::VARCHAR, (sum(v) FILTER (WHERE v % 2 = 0) || '|' || avg(v) FILTER (WHERE v % 2 = 0) || '|' || count(*)) FROM acs GROUP BY g
UNION ALL SELECT 'ungrouped', 'all', (avg(v) || '|' || avg(v) || '|' || count(*) || '|' || sum(v)) FROM acs
UNION ALL SELECT 'bucketed group', date_trunc('hour', ts)::VARCHAR, (avg(v) || '|' || count(*) || '|' || count(v)) FROM acs GROUP BY 2
UNION ALL SELECT 'order statistics', g::VARCHAR, (mode(v) || '|' || median(v) || '|' || avg(v) || '|' || median(v)) FROM acs GROUP BY g
UNION ALL SELECT 'having a count', g::VARCHAR, (count(*) || '|' || sum(v) || '|' || avg(v)) FROM acs GROUP BY g HAVING count(*) > 1
UNION ALL SELECT 'having an average', g::VARCHAR, (avg(v) || '|' || stddev(v) || '|' || count(v)) FROM acs GROUP BY g HAVING avg(v) > 1;

statement ok
SET disabled_optimizers = '';

statement ok
CREATE OR REPLACE TABLE acs_on AS
SELECT 'avg beside its parts' AS shape, g::VARCHAR AS k, (count(*) || '|' || sum(v) || '|' || min(v) || '|' || max(v) || '|' || avg(v)) AS r FROM acs GROUP BY g
UNION ALL SELECT 'two averages', g::VARCHAR, (avg(v) || '|' || avg(v + 1) || '|' || count(v) || '|' || sum(v)) FROM acs GROUP BY g
UNION ALL SELECT 'repeated average', g::VARCHAR, (avg(v) || '|' || avg(v) || '|' || avg(f) || '|' || stddev(v)) FROM acs GROUP BY g
UNION ALL SELECT 'distinct beside average', g::VARCHAR, (count(*) || '|' || count(v) || '|' || count(DISTINCT v) || '|' || avg(v)) FROM acs GROUP BY g
UNION ALL SELECT 'filtered average', g::VARCHAR, (sum(v) FILTER (WHERE v % 2 = 0) || '|' || avg(v) FILTER (WHERE v % 2 = 0) || '|' || count(*)) FROM acs GROUP BY g
UNION ALL SELECT 'ungrouped', 'all', (avg(v) || '|' || avg(v) || '|' || count(*) || '|' || sum(v)) FROM acs
UNION ALL SELECT 'bucketed group', date_trunc('hour', ts)::VARCHAR, (avg(v) || '|' || count(*) || '|' || count(v)) FROM acs GROUP BY 2
UNION ALL SELECT 'order statistics', g::VARCHAR, (mode(v) || '|' || median(v) || '|' || avg(v) || '|' || median(v)) FROM acs GROUP BY g
UNION ALL SELECT 'having a count', g::VARCHAR, (count(*) || '|' || sum(v) || '|' || avg(v)) FROM acs GROUP BY g HAVING count(*) > 1
UNION ALL SELECT 'having an average', g::VARCHAR, (avg(v) || '|' || stddev(v) || '|' || count(v)) FROM acs GROUP BY g HAVING avg(v) > 1;

query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes,
	(SELECT count(*) FROM (SELECT * FROM acs_off EXCEPT ALL SELECT * FROM acs_on)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM acs_on EXCEPT ALL SELECT * FROM acs_off)) AS gained
FROM acs_off;
----
rows	shapes	lost	gained
92	10	0	0
