query
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_arrow('${__TEST_DIR__}/adw_narrow.arrow'));
----
column_name	column_type
id	INTEGER
d32_4	DECIMAL(4,2)
d32_9	DECIMAL(9,3)
d64_4	DECIMAL(4,1)
d64_9	DECIMAL(9,2)
d64_18	DECIMAL(18,4)


query
SELECT id, coalesce(d32_4::VARCHAR, '-') AS d32_4, coalesce(d32_9::VARCHAR, '-') AS d32_9,
       coalesce(d64_4::VARCHAR, '-') AS d64_4, coalesce(d64_9::VARCHAR, '-') AS d64_9,
       coalesce(d64_18::VARCHAR, '-') AS d64_18
FROM read_arrow('${__TEST_DIR__}/adw_narrow.arrow')
ORDER BY id;
