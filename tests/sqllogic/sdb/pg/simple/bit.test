# serenedb-specific bit string behavior (PostgreSQL-shared cases live in
# any/pg/simple/bit.test): a bit string holds at least one bit.

statement error
SELECT substring(B'101010' FROM 9);
----
db error: ERROR: empty bit strings are not supported


statement error
SELECT substring(B'101010' FROM 2 FOR 0);
----
db error: ERROR: empty bit strings are not supported
