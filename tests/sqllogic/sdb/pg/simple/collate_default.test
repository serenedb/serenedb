CREATE TABLE collate_default_nullif(s VARCHAR COLLATE NOCASE);


statement ok
INSERT INTO collate_default_nullif VALUES ('A'), ('a'), ('b');


query
SELECT NULLIF(s, 'a') AS n, count(*) AS c FROM collate_default_nullif GROUP BY NULLIF(s, 'a') ORDER BY n NULLS FIRST;
----
n	c
NULL	2
b	1


statement ok
