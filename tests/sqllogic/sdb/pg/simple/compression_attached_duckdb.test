query
SELECT count(*) AS mismatches FROM (
  SELECT * FROM codecs_rle_${__DATABASE__}.main.runs
  EXCEPT ALL
  SELECT ((i // 5) % 100)::TINYINT, ((i // 20) % 1000)::SMALLINT, ((i // 40) % 200)::UTINYINT,
         ((i // 20) % 1000)::USMALLINT, ((i // 10) % 100000)::UINTEGER, ((i // 10) % 1000)::FLOAT,
         ((i // 3) % 1000)::FLOAT, ((i // 5) % 1000)::DOUBLE, ((i // 2) % 1000)::DOUBLE
  FROM range(200000) t(i));
----
mismatches
0


