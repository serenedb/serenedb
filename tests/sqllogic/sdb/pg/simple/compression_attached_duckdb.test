CREATE TABLE codecs_rle_${__DATABASE__}.main.runs (
  i8 TINYINT USING COMPRESSION rle,
  i16 SMALLINT USING COMPRESSION rle,
  u8 UTINYINT USING COMPRESSION rle,
  u16 USMALLINT USING COMPRESSION rle,
  u32 UINTEGER USING COMPRESSION rle,
  f32_long FLOAT USING COMPRESSION rle,
  f32_short FLOAT USING COMPRESSION rle,
  f64_long DOUBLE USING COMPRESSION rle,
  f64_short DOUBLE USING COMPRESSION rle);


statement ok
INSERT INTO codecs_rle_${__DATABASE__}.main.runs SELECT
  ((i // 5) % 100)::TINYINT,
  ((i // 20) % 1000)::SMALLINT,
  ((i // 40) % 200)::UTINYINT,
  ((i // 20) % 1000)::USMALLINT,
  ((i // 10) % 100000)::UINTEGER,
  ((i // 10) % 1000)::FLOAT,
  ((i // 3) % 1000)::FLOAT,
  ((i // 5) % 1000)::DOUBLE,
  ((i // 2) % 1000)::DOUBLE
FROM range(200000) t(i);


statement ok
