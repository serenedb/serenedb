# encodings without transcoding

query
SELECT convert('\x41e9'::bytea, 'WIN1252', 'WIN1252'), convert('\x41e9'::bytea, 'WIN1252', 'SQL_ASCII'), convert(''::bytea, 'EUC_JP', 'UTF8');
----
convert	convert	convert
\\x41e9	\\x41e9	\\x


statement error
SELECT convert('\x4100'::bytea, 'WIN1252', 'SQL_ASCII');
----
db error: ERROR: invalid byte sequence for encoding "WIN1252": 0x00


# unsupported transcoding

statement error
SELECT convert('\x41'::bytea, 'UTF8', 'WIN1252');
----
db error: ERROR: conversion between UTF8 and WIN1252 is not supported


statement error
SELECT convert_from('\x41'::bytea, 'EUC_JP');
----
db error: ERROR: conversion between EUC_JP and UTF8 is not supported


statement error
SELECT convert_to('A', 'KOI8R');
----
db error: ERROR: conversion between UTF8 and KOI8R is not supported
