query
SELECT 'tiny' AS t, a::VARCHAR AS v FROM oor_tiny
UNION ALL SELECT 'utiny', a::VARCHAR FROM oor_utiny
UNION ALL SELECT 'usmall', a::VARCHAR FROM oor_usmall
UNION ALL SELECT 'uint', a::VARCHAR FROM oor_uint
UNION ALL SELECT 'dec', a::VARCHAR FROM oor_dec
UNION ALL SELECT 'dec18', a::VARCHAR FROM oor_dec18
UNION ALL SELECT 'dec38', a::VARCHAR FROM oor_dec38
UNION ALL SELECT 'small_dec', a::VARCHAR FROM oor_small_dec
UNION ALL SELECT 'wide_dec', a::VARCHAR FROM oor_wide_dec
UNION ALL SELECT 'ts_ns', a::VARCHAR FROM oor_ts_ns
UNION ALL SELECT 'tz_ns', a::VARCHAR FROM oor_tz_ns
UNION ALL SELECT 'ts_s', a::VARCHAR FROM oor_ts_s
UNION ALL SELECT 'time', a::VARCHAR FROM oor_time
UNION ALL SELECT 'timetz', a::VARCHAR FROM oor_timetz
UNION ALL SELECT 'date', a::VARCHAR FROM oor_date
ORDER BY t, v;
----
t	v
dec	-999.99
dec	999.99
dec18	-999999999999999999
dec18	999999999999999999
dec38	-99999999999999999999999999999999999999
dec38	99999999999999999999999999999999999999
small_dec	12.3
tiny	-128
tiny	127
uint	4294967295
usmall	65535
utiny	0
utiny	255
wide_dec	999999999999999999.99

