UNION ALL SELECT 'huge', a::VARCHAR FROM oor_num_huge
UNION ALL SELECT 'uhuge', a::VARCHAR FROM oor_num_uhuge
UNION ALL SELECT 'ubig', a::VARCHAR FROM oor_num_ubig
