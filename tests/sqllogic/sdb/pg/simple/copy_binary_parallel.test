statement ok
CREATE TABLE cbp_edges AS
SELECT id::INTEGER AS id, repeat('x', len)::BYTEA AS payload
FROM (VALUES (1, 4194335), (2, 1398065), (3, 1398065), (4, 1398067), (5, 51), (6, 1398064), (7, 1398064),
             (8, 1398066), (9, 54), (10, 1398032), (11, 1398032), (12, 1398034), (13, 150), (14, 16), (15, 16)) v(id, len);


statement count 15
COPY (SELECT * FROM cbp_edges ORDER BY id) TO '${__TEST_DIR__}/cbp_edges.bin' (FORMAT binary);


