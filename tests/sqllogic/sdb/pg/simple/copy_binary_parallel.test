CREATE TABLE cbp_mixed AS
SELECT x::INTEGER AS id,
       decode(repeat('00020000000400000007000000024142', 5) || md5(x::VARCHAR) || md5((x + 1)::VARCHAR), 'hex') AS payload
FROM range(200000) t(x);


statement count 200000
COPY cbp_mixed TO '${__TEST_DIR__}/cbp_mixed.bin.zst' (FORMAT binary);


