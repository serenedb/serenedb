statement ok
CREATE TABLE cbp_times AS
SELECT x::INTEGER AS id,
       DATE '2000-01-01' + (x % 9000)::INTEGER AS d,
       CASE WHEN x % 7 = 0 THEN NULL ELSE (x / 8.0)::REAL END AS r,
       (x / 3.0)::DOUBLE PRECISION AS f,
       TIMESTAMP '2001-02-03 04:05:06' + x * INTERVAL '1 second' AS ts,
       CASE WHEN x % 9 = 0 THEN NULL ELSE TIMESTAMPTZ '2001-02-03 04:05:06+00' + x * INTERVAL '1 minute' END AS tz
FROM range(300000) t(x);


statement count 300000
COPY cbp_times TO '${__TEST_DIR__}/cbp_times.bin' (FORMAT binary);


statement ok
CREATE TABLE cbp_times_dst (id INTEGER, d DATE, r REAL, f DOUBLE PRECISION, ts TIMESTAMP, tz TIMESTAMPTZ);


statement count 300000
COPY cbp_times_dst FROM '${__TEST_DIR__}/cbp_times.bin' (FORMAT binary);


