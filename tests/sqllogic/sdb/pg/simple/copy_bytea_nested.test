CREATE TABLE cbn_src (id INTEGER, s STRUCT(b BYTEA, t VARCHAR), m MAP(VARCHAR, BYTEA));

statement ok
INSERT INTO cbn_src VALUES (1, {'b': '\x000102030405060708090a0b0c0d0e0f'::BYTEA, 't': 'x'}, MAP {'k1': 'abcdefghijklmnop\001'::BYTEA, 'k2': '\x'::BYTEA}), (2, {'b': 'q\\r'::BYTEA, 't': NULL}, MAP {'k1': NULL, 'k2': '\x0f0e0d0c0b0a09080706050403020100'::BYTEA}), (3, NULL, NULL);

