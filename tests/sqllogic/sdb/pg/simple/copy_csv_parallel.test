statement ok
CREATE TABLE cpar_lines (l TEXT);


statement count 3
COPY (SELECT * FROM (VALUES (1, 'a'), (2, 'b,c'), (3, NULL)) v(i, s) ORDER BY i)
TO '${__TEST_DIR__}/cpar_array.txt' (FORMAT csv, QUOTE '', ESCAPE '', PREFIX '[', SUFFIX ']', NEW_LINE '|', PRESERVE_ORDER true);


statement count 1
COPY cpar_lines FROM '${__TEST_DIR__}/cpar_array.txt' (FORMAT csv, DELIMITER E'\x01', QUOTE E'\x02');


query
SELECT l FROM cpar_lines;
----
l
[1,a|2,b,c|3,]


