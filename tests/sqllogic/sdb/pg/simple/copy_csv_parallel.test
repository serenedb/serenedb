control substitution on

statement ok
CREATE TABLE cpar_src AS
SELECT i AS id,
       CASE i % 6
         WHEN 0 THEN 'a,b' || repeat('z', i % 37)
         WHEN 1 THEN 'q"x' || repeat('"', i % 5)
         WHEN 2 THEN 'l1' || chr(10) || 'l2' || chr(13) || chr(10) || repeat('y', i % 11)
         WHEN 3 THEN ''
         WHEN 4 THEN repeat('w', i % 53)
       END AS t,
       i * 7 AS n
FROM generate_series(1, 1500000) g(i);


query
SELECT count(*) AS rows, count(t) AS texts, sum(length(t)) AS chars, sum(n) AS n FROM cpar_src;
----
rows	texts	chars	n
1500000	1250000	15999981	7875005250000


statement count 1500000
COPY cpar_src TO '${__TEST_DIR__}/cpar.csv' (FORMAT csv, HEADER);


statement ok
CREATE TABLE cpar_dst (id INTEGER, t TEXT, n BIGINT);


statement count 1500000
COPY cpar_dst FROM '${__TEST_DIR__}/cpar.csv' (FORMAT csv, HEADER);


query
SELECT count(*) AS rows, count(t) AS texts, sum(length(t)) AS chars, sum(n) AS n,
       sum(id) FILTER (WHERE t = '') AS empty_ids, sum(id) FILTER (WHERE t IS NULL) AS null_ids
FROM cpar_dst;
----
rows	texts	chars	n	empty_ids	null_ids
1500000	1250000	15999981	7875005250000	191037514150	187500500000


query
SELECT count(*) AS mismatches FROM cpar_src s JOIN cpar_dst d USING (id) WHERE s.t IS DISTINCT FROM d.t OR s.n <> d.n;
----
mismatches
0


