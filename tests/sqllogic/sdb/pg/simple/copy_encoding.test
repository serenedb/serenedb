COPY cenc_big FROM '${__TEST_DIR__}/cenc_emoji.txt' (FORMAT text, ENCODING 'UTF16LE');


statement count 1
COPY (SELECT repeat('€', 100000) AS t) TO '${__TEST_DIR__}/cenc_euro.txt' (FORMAT text, ENCODING 'UTF16BE');


statement count 1
COPY cenc_big FROM '${__TEST_DIR__}/cenc_euro.txt' (FORMAT text, ENCODING 'UTF16BE');


query
SELECT length(t) AS len, left(t, 2) AS head, t IN ('a' || repeat('😀', 300000), repeat('€', 100000)) AS same
FROM cenc_big ORDER BY len;
----
len	head	same
100000	€€	t
300001	a😀	t


