statement ok
SET sdb_rendering = 'duckdb';


skipif pg-wire-extended
query
SELECT ARRAY[1, 2] AS l, true AS b, ROW(1, 'a') AS r;
----
l	b	r
[1, 2]	true	(1, a)

onlyif pg-wire-extended
query
SELECT ARRAY[1, 2] AS l, true AS b, ROW(1, 'a') AS r;
----
l	b	r
{1,2}	t	(1,a)


skipif pg-wire-extended
query
SELECT ARRAY[1, 2] AS l, 'x y' AS s;
----
l	s
[1, 2]	x y


onlyif pg-wire-extended
query
SELECT ARRAY[1, 2] AS l, 'x y' AS s;
----
l	s
{1,2}	x y


