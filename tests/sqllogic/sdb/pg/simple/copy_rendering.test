control substitution on

statement ok
CREATE TABLE rendered (id int, l int[], b boolean, d date);


statement ok
INSERT INTO rendered VALUES (1, ARRAY[1, 2], true, '2024-01-02'), (2, ARRAY[3], false, '2024-03-04');


statement ok
COPY (SELECT * FROM rendered ORDER BY id) TO '${__TEST_DIR__}/rendered_pg.csv' (FORMAT csv);


statement ok
COPY (SELECT * FROM rendered ORDER BY id) TO '${__TEST_DIR__}/rendered_duckdb.csv' (FORMAT csv, RENDERING duckdb);


statement ok
COPY (SELECT * FROM rendered ORDER BY id) TO '${__TEST_DIR__}/rendered_duckdb.txt' (FORMAT text, RENDERING 'DuckDB');


query
SELECT replace(content, chr(10), '|') AS content FROM read_text('${__TEST_DIR__}/rendered_pg.csv');
----
content
1,"{1,2}",t,2024-01-02|2,{3},f,2024-03-04|


query
SELECT replace(content, chr(10), '|') AS content FROM read_text('${__TEST_DIR__}/rendered_duckdb.csv');
----
content
1,"[1, 2]",true,2024-01-02|2,[3],false,2024-03-04|


query
SELECT replace(replace(content, chr(10), '|'), chr(9), ' ') AS content FROM read_text('${__TEST_DIR__}/rendered_duckdb.txt');
----
content
1 [1, 2] true 2024-01-02|2 [3] false 2024-03-04|


statement ok
CREATE TABLE back (id int, l int[], b boolean, d date);


statement ok
COPY back FROM '${__TEST_DIR__}/rendered_duckdb.csv' (FORMAT csv, RENDERING duckdb);


statement ok
COPY back FROM '${__TEST_DIR__}/rendered_duckdb.txt' (FORMAT text, RENDERING duckdb);


query
SELECT id, l, b, d FROM back ORDER BY id, l;
----
id	l	b	d
1	{1,2}	t	2024-01-02
1	{1,2}	t	2024-01-02
2	{3}	f	2024-03-04
2	{3}	f	2024-03-04


