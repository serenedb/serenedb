statement ok
SET sdb_rendering = 'duckdb';


skipif pg-wire-extended
query
SELECT ARRAY[1, 2] AS l, true AS b, ROW(1, 'a') AS r;
----
l	b	r
[1, 2]	true	(1, a)

onlyif pg-wire-extended
query
SELECT ARRAY[1, 2] AS l, true AS b, ROW(1, 'a') AS r;
----
l	b	r
{1,2}	t	(1,a)


statement ok
RESET sdb_rendering;


query
SELECT ARRAY[1, 2] AS l, true AS b;
----
l	b
{1,2}	t


