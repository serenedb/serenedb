statement ok
CREATE TABLE ctdd_ignore (i INTEGER, d DECIMAL(15,2), b BIT(4));


statement ok
COPY (SELECT * FROM (VALUES (1, '1.5', '1010'), (2, 'abc', '1010'), (3, '2.5', '10x1'), (4, '3.5', '0101')) t) TO '${__TEST_DIR__}/ctdd_ignore.txt' (FORMAT text);


statement ok
COPY ctdd_ignore FROM '${__TEST_DIR__}/ctdd_ignore.txt' (FORMAT text, ON_ERROR ignore);


query
SELECT i, d, b FROM ctdd_ignore ORDER BY i;
----
i	d	b
1	1.50	1010
4	3.50	0101


