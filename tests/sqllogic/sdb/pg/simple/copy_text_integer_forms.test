query
SELECT (SELECT string_agg(v::TEXT, ',' ORDER BY rowid) FROM cif_i1) AS i1, (SELECT string_agg(v::TEXT, ',' ORDER BY rowid) FROM cif_u1) AS u1,
       (SELECT sum(v) FROM cif_u2) AS u2, (SELECT sum(v) FROM cif_u4) AS u4, (SELECT sum(v) FROM cif_u8) AS u8;
