control substitution on

statement ok
CREATE TABLE ctfp_src AS
SELECT x::INTEGER AS id, 'v' || x::VARCHAR || CASE WHEN x % 7 = 0 THEN e'\t\\' ELSE '' END AS label
FROM range(300000) t(x);


statement count 300000
COPY ctfp_src TO '${__TEST_DIR__}/ctfp.txt' (FORMAT text);


statement ok
CREATE TABLE ctfp_text (id INTEGER, label TEXT);


statement count 300000
COPY ctfp_text FROM '${__TEST_DIR__}/ctfp.txt' (FORMAT text);


query
SELECT count(*) AS n, count(DISTINCT id) AS ids, sum(id) AS total
FROM ctfp_text
JOIN ctfp_src USING (id, label);
----
n	ids	total
300000	300000	44999850000


statement count 300000
COPY (SELECT * FROM ctfp_src ORDER BY id) TO '${__TEST_DIR__}/ctfp_ordered.txt' (FORMAT text);


query
SELECT content = (
  SELECT string_agg(id::VARCHAR || chr(9) || replace(replace(label, e'\\', e'\\\\'), chr(9), e'\\t') || chr(10), '' ORDER BY id)
  FROM ctfp_src
) AS same
FROM read_text('${__TEST_DIR__}/ctfp_ordered.txt');
----
same
t


statement count 300000
COPY ctfp_src TO '${__TEST_DIR__}/ctfp_header.txt' (FORMAT text, HEADER);


query
SELECT replace(split_part(content, chr(10), 1), chr(9), '<tab>') AS first_line, length(content) - length(replace(content, chr(10), '')) AS lines
FROM read_text('${__TEST_DIR__}/ctfp_header.txt');
----
first_line	lines
id<tab>label	300001


statement count 300000
COPY ctfp_src TO '${__TEST_DIR__}/ctfp.bin' (FORMAT binary);


query
SELECT left(hex(content), 38) AS head, right(hex(content), 4) AS tail
FROM read_blob('${__TEST_DIR__}/ctfp.bin');
----
head	tail
5047434F50590AFF0D0A000000000000000000	FFFF


statement ok
CREATE TABLE ctfp_bin (id INTEGER, label TEXT);


statement count 300000
COPY ctfp_bin FROM '${__TEST_DIR__}/ctfp.bin' (FORMAT binary);


query
SELECT count(*) AS n, sum(id) AS total
FROM ctfp_bin
JOIN ctfp_src USING (id, label);
----
n	total
300000	44999850000


statement count 300000
COPY (SELECT * FROM ctfp_src ORDER BY id DESC) TO '${__TEST_DIR__}/ctfp_ordered.bin' (FORMAT binary);


