statement ok
SET threads = 1;


statement count 300000
COPY ctfp_src TO '${__TEST_DIR__}/ctfp_one_thread.txt' (FORMAT text);


statement ok
RESET threads;


query
SELECT list_sort(string_split(rtrim(content, chr(10)), chr(10))) = (
  SELECT list_sort(list(id::VARCHAR || chr(9) || replace(replace(label, e'\\', e'\\\\'), chr(9), e'\\t')))
  FROM ctfp_src
) AND content LIKE '%' || chr(10) AS same
FROM read_text('${__TEST_DIR__}/ctfp_one_thread.txt');
----
same
t


