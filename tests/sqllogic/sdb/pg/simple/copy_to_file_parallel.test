statement count 300000
COPY (SELECT * FROM ctfp_src ORDER BY id DESC) TO '${__TEST_DIR__}/ctfp_ordered.txt.gz' (FORMAT text);


query
SELECT count(*) AS n, count(*) FILTER (WHERE previous <> id + 1) AS misordered
FROM (
  SELECT id, lag(id) OVER (ORDER BY file_row_number) AS previous
  FROM read_csv('${__TEST_DIR__}/ctfp_ordered.txt.gz', delim = e'\t', quote = '', escape = '', header = false,
                file_row_number = true, columns = {'id': 'INTEGER', 'label': 'VARCHAR'})
);
----
n	misordered
300000	0


