query
SELECT hex(sdb_encode_key(-1::TINYINT)) AS neg, hex(sdb_encode_key(1::TINYINT)) AS pos, hex(sdb_encode_key(-2::SMALLINT)) AS small;
----
neg	pos	small
7F	81	7FFE


query
SELECT hex(sdb_encode_key(1::INTEGER)) AS i32, hex(sdb_encode_key(-1::BIGINT)) AS i64, hex(sdb_encode_key(1::UBIGINT)) AS u64;
----
i32	i64	u64
80000001	7FFFFFFFFFFFFFFF	0000000000000001


query
SELECT hex(sdb_encode_key('1970-01-02'::DATE)) AS d, hex(sdb_encode_key('1970-01-01 00:00:00.000001'::TIMESTAMP)) AS ts;
----
d	ts
80000001	8000000000000001


query
SELECT hex(sdb_encode_key(1::REAL)) AS one, hex(sdb_encode_key(-1::REAL)) AS minus_one;
----
one	minus_one
BF800000	407FFFFF


query
SELECT hex(sdb_encode_key('-0'::DOUBLE)) AS zero, hex(sdb_encode_key('NaN'::DOUBLE)) AS nan;
----
zero	nan
8000000000000000	FFF8000000000000
