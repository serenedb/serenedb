control substitution on

# Requires Azurite running (launched by run.sh for *_azurite.test_slow).
# Credentials are handled by DuckDB's azure extension via CREATE SECRET.

statement ok
CREATE OR REPLACE SECRET azurite_${__DATABASE__} (
  TYPE azure,
  CONNECTION_STRING '${AZURITE_CONNECTION_STRING}',
  SCOPE 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_'
);


statement ok
CREATE TABLE clickclack
(
  id INTEGER PRIMARY KEY,
  name TEXT
);


statement count 5
INSERT INTO clickclack VALUES (1, 'vedernikoff'), (2, 'pavelvi'), (3, 'babsky'), (4, 'pudge'), (5, 'mom');


statement count 5
COPY clickclack TO 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.csv'
WITH (FORMAT csv, HEADER true);


statement ok
CREATE TABLE az_csv_vedernikoff
(
  id INTEGER PRIMARY KEY,
  name TEXT
);


statement count 5
COPY az_csv_vedernikoff FROM 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.csv'
WITH (FORMAT csv, HEADER true);


query
SELECT *
FROM az_csv_vedernikoff
ORDER BY 1;
----
id	name
1	vedernikoff
2	pavelvi
3	babsky
4	pudge
5	mom


statement count 5
DELETE FROM az_csv_vedernikoff;


statement count 3
COPY az_csv_vedernikoff FROM 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.csv'
WITH (FORMAT csv, HEADER true)
WHERE id != 2 AND id != 4;


query
SELECT *
FROM az_csv_vedernikoff
ORDER BY 1;
----
id	name
1	vedernikoff
3	babsky
5	mom


statement count 5
COPY clickclack TO 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.tsv'
WITH (FORMAT csv, DELIMITER '	');


statement ok
CREATE TABLE az_tsv_vedernikoff
(
  id INTEGER PRIMARY KEY,
  name TEXT
);


statement count 5
COPY az_tsv_vedernikoff FROM 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.tsv'
WITH (FORMAT csv, DELIMITER '	');


query
SELECT *
FROM az_tsv_vedernikoff
ORDER BY 1;
----
id	name
1	vedernikoff
2	pavelvi
3	babsky
4	pudge
5	mom


statement count 5
COPY clickclack TO 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.parquet'
WITH (FORMAT parquet);


statement ok
CREATE TABLE az_parquet_vedernikoff
(
  id INTEGER PRIMARY KEY,
  name TEXT
);


statement count 5
COPY az_parquet_vedernikoff FROM 'az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.parquet'
WITH (FORMAT parquet);


query
SELECT *
FROM az_parquet_vedernikoff
ORDER BY 1;
----
id	name
1	vedernikoff
2	pavelvi
3	babsky
4	pudge
5	mom


# Direct table-function scans over az:// paths.

query
SELECT count(*) AS c, min(name) AS mn
FROM read_csv('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.csv');
----
c	mn
5	babsky


query
SELECT count(*) AS c, max(name) AS mx
FROM read_parquet('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.parquet');
----
c	mx
5	vedernikoff


# Globbing over the blobs this test wrote.

query
SELECT count(*) AS c
FROM glob('az://${AZURITE_BLOB_CONTAINER}/${__DATABASE__}_az_clickclack.*');
----
c
3
