statement ok
CREATE TABLE frl (id BIGINT, items VARCHAR[]);


statement ok
INSERT INTO frl SELECT i, ['company ' || (i % 50), 'x' || i] FROM range(1000) r(i);


query
EXPLAIN SELECT count(*) FROM frl
WHERE ((NOT (len(list_filter(items, lambda x: coalesce(regexp_matches(x, '(?i)^(the\s+)?company 1[0-9]\b'), FALSE))) > 0)) OR id IS NULL)
  AND ((len(list_filter(items, lambda x: x = 'x7')) > 0) OR id IS NULL);
----
