query
SELECT TRY_CAST({'a': 0, 'b': 0, 'c': 1} AS line) IS NULL AS a, {'a': 1, 'b': -1, 'c': 0}::line AS b,
       ROW(1, 2)::point AS c, '{"x": 1, "y": 2, "radius": 3}'::json::circle AS d;
----
a	b	c	d
t	{1,-1,0}	(1,2)	<(1,2),3>


query
SELECT CAST({'x': NULL::DOUBLE, 'y': 2::DOUBLE} AS point) IS NULL AS a,
       CAST({'points': [{'x': 0::DOUBLE, 'y': NULL::DOUBLE}]} AS polygon) IS NULL AS b,
       CAST({'points': [{'x': 0::DOUBLE, 'y': 0::DOUBLE}, NULL]} AS polygon) IS NULL AS c;
----
a	b	c
t	t	t


