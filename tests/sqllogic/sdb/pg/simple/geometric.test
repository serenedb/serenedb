query
SELECT box '(1,1),(0,0)' = box '(2,2),(1,1)' AS a, circle '<(0,0),1>' = circle '<(5,5),1>' AS b,
       line '{1,-1,0}' = line '{2,-2,0}' AS c, path '((0,0),(1,1))' = path '[(5,5),(6,6)]' AS d,
       point '(1,2)' = point '(1,2)' AS e, polygon '((0,0),(1,1))' = polygon '((0,0),(1,1))' AS f,
       lseg '[(0,0),(1,1)]' < lseg '[(0,0),(2,2)]' AS g, point '(1,2)' < point '(1,3)' AS h;
----
a	b	c	d	e	f	g	h
f	f	f	f	t	t	t	t


query
SELECT p, count(*) AS n FROM (VALUES (point '(2,1)'), (point '(1,2)'), (point '(1,2)'), (point '(1,1)')) t(p)
GROUP BY p
ORDER BY p;
----
p	n
(1,1)	1
(1,2)	2
(2,1)	1


query
