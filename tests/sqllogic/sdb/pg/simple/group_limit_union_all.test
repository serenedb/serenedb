query
SELECT count(*), bool_and(c = CASE WHEN k IN (2, 3) THEN 2 ELSE 1 END) FROM (SELECT k, count(*) AS c FROM (SELECT k FROM glua_1 UNION ALL SELECT k FROM glua_2) s GROUP BY k LIMIT 3) q
----
count	bool_and
3	t

query
SELECT count(*) FROM (SELECT DISTINCT k FROM (SELECT k FROM glua_1 UNION ALL SELECT k FROM glua_2) s LIMIT 3) q
