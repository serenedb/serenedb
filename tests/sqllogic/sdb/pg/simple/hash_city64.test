query
SELECT x, hash_city64(x) AS h, hash_city64(x, 1::BIGINT) IS NULL AS null_pair FROM (VALUES (1::BIGINT), (NULL)) v(x) ORDER BY x NULLS LAST;
----
x	h	null_pair
1	5925585971146611297	f
NULL	NULL	t


query
