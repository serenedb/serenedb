statement ok
COPY inet_parquet TO '${__TEST_DIR__}/inet_parquet.parquet' (FORMAT PARQUET);


query
SELECT id, i, c, l, pg_typeof(i) AS ti, pg_typeof(l) AS tl FROM read_parquet('${__TEST_DIR__}/inet_parquet.parquet') ORDER BY id;
----
id	i	c	l	ti	tl
1	2001:db8:85a3::8a2e:370:7334/64	2001:db8:85a3:8d3:1319:8a2e::/96	{::1/128,10.1.2.3/8}	text	text[]
2	::1/128	10.0.0.0/8	NULL	text	text[]
3	NULL	NULL	{NULL}	text	text[]


statement ok
CREATE TABLE inet_parquet_back (id int, i inet, c cidr, l inet[]);


statement ok
COPY inet_parquet_back FROM '${__TEST_DIR__}/inet_parquet.parquet' (FORMAT PARQUET);


query
SELECT b.id, b.i, b.c, b.i IS NOT DISTINCT FROM o.i AND b.c IS NOT DISTINCT FROM o.c AND b.l IS NOT DISTINCT FROM o.l AS same FROM inet_parquet o JOIN inet_parquet_back b USING (id) ORDER BY b.id;
----
id	i	c	same
1	2001:db8:85a3::8a2e:370:7334/64	2001:db8:85a3:8d3:1319:8a2e::/96	t
2	::1	10.0.0.0/8	t
3	NULL	NULL	t


