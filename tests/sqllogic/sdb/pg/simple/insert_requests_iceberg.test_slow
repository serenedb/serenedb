query
SELECT count(*) FILTER (WHERE request.type = 'HEAD') AS head,
       count(*) FILTER (WHERE request.type = 'PUT') AS put
FROM duckdb_logs_parsed('HTTP')
WHERE request.url LIKE '%${__DATABASE__}%' AND request.url LIKE '%.parquet';
