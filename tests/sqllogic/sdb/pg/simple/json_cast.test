control substitution on

query
SELECT ARRAY['a', 'b']::json AS a, json_valid(ARRAY['a', 'b']::json) AS b, ARRAY[1, 2]::json AS c,
       ARRAY[ARRAY['a']]::json AS d;
----
a	b	c	d
["a","b"]	t	[1,2]	[["a"]]


query
SELECT to_json('<a b="1">text</a>'::xml) AS x, to_json('12.34'::money) AS m, to_json(NULL::xml) AS n,
       to_json(point '(1,2)') AS p, to_json(path '[(0,0),(1,1)]') AS pa;
----
x	m	n	p	pa
"<a b=\\"1\\">text</a>"	12.34	NULL	{"x":1.0,"y":2.0}	{"closed":false,"points":[{"x":0.0,"y":0.0},{"x":1.0,"y":1.0}]}


query
SELECT to_json('[1,3)'::int4range) AS r, to_json('{[1,2),[5,6)}'::int4multirange) AS mr;
----
r	mr
{"nonempty":true,"lower_finite":true,"lower":1,"lower_exclusive":false,"upper_infinite":false,"upper":3,"upper_inclusive":false}	[{"nonempty":true,"lower_finite":true,"lower":1,"lower_exclusive":false,"upper_infinite":false,"upper":2,"upper_inclusive":false},{"nonempty":true,"lower_finite":true,"lower":5,"lower_exclusive":false,"upper_infinite":false,"upper":6,"upper_inclusive":false}]


query
SELECT json_build_object('x', '<a/>'::xml, 'm', '1'::money, 'p', point '(1,2)') AS o;
----
o
{"x":"<a/>","m":1.00,"p":{"x":1.0,"y":2.0}}


query
SELECT '<a b="1">text</a>'::xml::json AS x, json_valid('<a/>'::xml::json) AS v, point '(1,2)'::json AS p,
       '[1,3)'::int4range::json AS r;
----
x	v	p	r
"<a b=\\"1\\">text</a>"	t	{"x":1.0,"y":2.0}	{"nonempty":true,"lower_finite":true,"lower":1,"lower_exclusive":false,"upper_infinite":false,"upper":3,"upper_inclusive":false}


statement ok
CREATE TABLE json_types (id int, x xml, m money, p point, r int4range);


statement ok
INSERT INTO json_types VALUES (1, NULL, NULL, NULL, NULL), (2, '<a/>', '1.5', '(1,2)', '[1,3)');


statement count 2
COPY (SELECT * FROM json_types ORDER BY id) TO '${__TEST_DIR__}/json_types.json' (FORMAT JSON);


query
SELECT json FROM read_json_objects('${__TEST_DIR__}/json_types.json') ORDER BY json->>'id';
----
json
{"id":1,"x":null,"m":null,"p":null,"r":null}
{"id":2,"x":"<a/>","m":1.50,"p":{"x":1.0,"y":2.0},"r":{"nonempty":true,"lower_finite":true,"lower":1,"lower_exclusive":false,"upper_infinite":false,"upper":3,"upper_inclusive":false}}
