query
SELECT '[1,]'::json AS a, '{"a":1,}'::json AS b, '[NaN, Infinity]'::json AS c;
----
a	b	c
[1,]	{"a":1,}	[NaN, Infinity]


query
SELECT '[1,]'::json -> 5 AS a, '[1,]'::json ->> 0 AS b, '[1,]'::json #>> '{0}' AS c, json_strip_nulls('{"a":1,"b":null,}'::json) AS s, json_array_length('[1,2,]'::json) AS l;
----
a	b	c	s	l
NULL	1	1	{"a":1}	2


query
SELECT count(*) AS n FROM json_array_elements('[1,2,]'::json);
----
n
2


query
SELECT '[NaN]'::json -> 0 AS nan, '[1,]'::json ->> 'a' AS field, json_typeof('[1,]'::json) AS type, json_typeof('[NaN]'::json -> 0) AS nan_type, '[-Infinity,]'::json ->> 0 AS ninf;
----
nan	field	type	nan_type	ninf
NaN	NULL	array	number	-Infinity


statement ok
CREATE TABLE json_lenient (v json);


statement ok
INSERT INTO json_lenient VALUES ('[1,]'), ('{"a":[2,],}');


query
SELECT v -> 0 AS first, v -> 'a' ->> 0 AS a0 FROM json_lenient ORDER BY v::text;
----
first	a0
1	NULL
NULL	2


query
SELECT '{"a":[2,],}'::json -> 'a' AS a, '{"a":{"b":1,},}'::json -> 'a' AS b, '[[1,],]'::json -> 0 AS c, '{"a":[2,],}'::json #> '{a}' AS d, '{"a":[2,],}'::json ->> 'a' AS e, '{"a":{"b":[3,],},}'::json #>> '{a,b}' AS f;
----
a	b	c	d	e	f
[2,]	{"b":1,}	[1,]	[2,]	[2,]	[3,]


query
SELECT '[1,2,]'::json -> -1 AS a, '[1,2,]'::json -> 2 AS b, '[1,2,]'::json -> -3 AS c, '{"a":1,}'::json -> 'b' AS d, '{"a":"x,]",}'::json ->> 'a' AS e, '[1 , ]'::json ->> 0 AS f, E'{"a":1 ,\n}'::json ->> 'a' AS g;
----
a	b	c	d	e	f	g
2	NULL	NULL	NULL	x,]	1	1


query
SELECT json_typeof('NaN') AS a, json_typeof('nan') AS b, json_typeof('Infinity') AS c, json_typeof('-Infinity') AS d, json_typeof('inf') AS e, json_typeof('[1,]') AS f, json_typeof('{"a":nan}'::json -> 'a') AS g, json_typeof('null') AS h, json_typeof('{"a":1,}') AS i;
----
a	b	c	d	e	f	g	h	i
number	number	number	number	number	array	number	null	object


query
SELECT '[nan]'::json ->> 0 AS a, '[NaN]'::json -> 0 AS b, '{"a":INF,}'::json ->> 'a' AS c, '[-nan,]'::json ->> 0 AS d, '[null,]'::json ->> 0 AS e, '{"a":null,}'::json -> 'a' AS f;
----
a	b	c	d	e	f
nan	NaN	INF	-nan	NULL	null


