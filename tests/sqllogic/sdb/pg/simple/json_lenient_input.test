query
SELECT '[1,]'::json AS a, '{"a":1,}'::json AS b, '[NaN, Infinity]'::json AS c;
----
a	b	c
[1,]	{"a":1,}	[NaN, Infinity]


query
SELECT '[1,]'::json -> 5 AS a, '[1,]'::json ->> 0 AS b, '[1,]'::json #>> '{0}' AS c, json_strip_nulls('{"a":1,"b":null,}'::json) AS s, json_array_length('[1,2,]'::json) AS l;
----
a	b	c	s	l
NULL	1	1	{"a":1}	2


query
SELECT count(*) AS n FROM json_array_elements('[1,2,]'::json);
----
n
2


query
SELECT '[NaN]'::json -> 0 AS nan, '[1,]'::json ->> 'a' AS field, json_typeof('[1,]'::json) AS type, json_typeof('[NaN]'::json -> 0) AS nan_type, '[-Infinity,]'::json ->> 0 AS ninf;
----
nan	field	type	nan_type	ninf
NaN	NULL	array	number	-Infinity


statement ok
CREATE TABLE json_lenient (v json);


statement ok
INSERT INTO json_lenient VALUES ('[1,]'), ('{"a":[2,],}');


query
SELECT v -> 0 AS first, v -> 'a' ->> 0 AS a0 FROM json_lenient ORDER BY v::text;
----
first	a0
1	NULL
NULL	2
