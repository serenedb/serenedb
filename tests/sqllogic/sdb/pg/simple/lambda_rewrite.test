CREATE MACRO lr_pair(y) AS [y, y + 1]

statement ok
CREATE MACRO lr_use(p, u, v) AS p[1] + p[2] + u + u + v + v

statement ok
CREATE FUNCTION lr_use_volatile(p bigint[], u double precision) RETURNS double precision LANGUAGE sql RETURN p[1] + p[2] + u - u

