CREATE MACRO mn_va(a, b) AS [a[1] + b[1], a[2] + b[2], a[3] + b[3]]

statement ok
CREATE MACRO mn_vs(a, b) AS [a[1] - b[1], a[2] - b[2], a[3] - b[3]]

statement ok
CREATE MACRO mn_vm(a, s) AS [a[1] * s, a[2] * s, a[3] * s]

statement ok
CREATE MACRO mn_mix(a, b, t) AS mn_va(a, mn_vm(mn_vs(b, a), t))

query
SELECT list_transform(mn_mix(mn_mix(mn_mix(mn_mix([0.1, 0.2, 0.3]::DOUBLE[], [0.4, 0.5, 0.6]::DOUBLE[], h), [0.7, 0.8, 0.9]::DOUBLE[], h), [0.1, 0.1, 0.1]::DOUBLE[], h), [0.2, 0.2, 0.2]::DOUBLE[], h), lambda x: round(x, 6)) AS r FROM (SELECT range::DOUBLE / 4 AS h FROM range(3)) ORDER BY h
