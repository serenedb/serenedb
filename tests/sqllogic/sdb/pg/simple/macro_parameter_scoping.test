statement ok
CREATE TABLE mps_inner_t (c int);


statement ok
INSERT INTO mps_inner_t VALUES (5);


statement ok
CREATE MACRO mps_inner(v) AS (SELECT max(v) FROM mps_inner_t);


statement ok
CREATE MACRO mps_outer(x) AS (SELECT mps_inner(x + c) FROM mps_outer_t);


query
SELECT mps_outer(1) AS written_where_passed;
----
written_where_passed
105


