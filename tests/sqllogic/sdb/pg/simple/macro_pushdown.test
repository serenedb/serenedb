statement ok
CREATE TABLE mp (a BIGINT, b BIGINT)

statement ok
INSERT INTO mp SELECT g, g % 7 FROM generate_series(1, 1000) g

statement ok
CREATE MACRO mp_between(x, lo, hi) AS x > lo AND x < hi

statement ok
CREATE FUNCTION mp_fbetween(x bigint, lo bigint, hi bigint) RETURNS boolean LANGUAGE sql RETURN x > lo AND x < hi

statement ok
CREATE MACRO mp_eq(x, y) AS x = y AND x IS NOT NULL

statement ok
CREATE MACRO mp_sq(x) AS x * x + x

query
EXPLAIN SELECT a FROM mp WHERE mp_between(a + 1, 5, 10)
----
QUERY PLAN
╭─ SEQ_SCAN ─────────────────────────╮
│ Table: mp                          │
│ Type: Sequential Scan              │
│ Projections: a                     │
│ Column Filter: (a > 4) AND (a < 9) │
│ ~200 rows                          │
╰────────────────────────────────────╯

