hash-threshold 100

control substitution on

# The markdown extension over the pg wire. The extension's own suite runs at the
# DuckDB level (tests/duckdb/run.sh --suite markdown); what it cannot see is the
# wire mapping of the MARKDOWN type, the readers reaching a real file through
# serened, the .md replacement scan and COPY TO ... (FORMAT markdown).

# The MARKDOWN type is a VARCHAR alias, so it travels as text -- there is no
# markdown oid for a client to bind.

query
SELECT pg_typeof('x'::md) AS md_t, pg_typeof(md_to_html('# H')) AS html_t;
----
md_t	html_t
text	text


query
SELECT rtrim(md_to_html('# Hi'), chr(10)) AS html;
----
html
<h1>Hi</h1>


query
SELECT rtrim(md_to_text('# Title'), chr(10)) AS txt, md_valid('# ok') AS valid;
----
txt	valid
Title	t


query
SELECT (md_stats(E'# A\n## B\n[l](http://x)')).heading_count AS headings,
       (md_stats(E'# A\n## B\n[l](http://x)')).link_count AS links;
----
headings	links
2	1


query
SELECT (md_extract_links('see [a](http://a) and [b](http://b)'))[2].url AS second_url;
----
second_url
http://b


query
SELECT (md_extract_code_blocks(E'```sql\nSELECT 1;\n```'))[1].language AS lang;
----
lang
sql


# md_stats(doc, exact) takes its counts from cmark's AST instead of the line
# scanners. Covered here because md_stats_exact.test is skipped.

statement ok
CREATE TEMPORARY MACRO md_stats_doc() AS (E'# Title\nInline [a](http://a) and image ![i](http://i.png).\nRef [b][ref] and auto <http://c>.\nCode span `[x](http://x)`.\n\n```md\n[y](http://y)\n[z](http://z)\n```\n\n[ref]: http://b\n');


# The scanner counts the image, a code span and two fenced links; cmark does not.

query
SELECT (md_stats(md_stats_doc())).link_count AS scanned,
       (md_stats(md_stats_doc(), true)).link_count AS exact;
----
scanned	exact
5	3


# Exact mode agrees with the extractors; the scanner's surplus is the image.

query
SELECT (md_stats(md_stats_doc(), true)).link_count = len(md_extract_links(md_stats_doc())) AS links_agree,
       (md_stats(md_stats_doc(), true)).code_block_count = len(md_extract_code_blocks(md_stats_doc())) AS blocks_agree,
       (md_stats(md_stats_doc())).link_count - (md_stats(md_stats_doc(), true)).link_count
         >= len(md_extract_images(md_stats_doc())) AS image_surplus;
----
links_agree	blocks_agree	image_surplus
t	t	t


# Constructs the scanners cannot see.

query
SELECT (md_stats(E'```sql\nSELECT 1')).code_block_count AS unterminated_scanned,
       (md_stats(E'```sql\nSELECT 1', true)).code_block_count AS unterminated_exact,
       (md_stats(E'~~~py\nx', true)).code_block_count AS tilde_exact,
       (md_stats(E'Setext\n======\ntext', true)).heading_count AS setext_exact,
       (md_stats(E'    indented code', true)).code_block_count AS indented_exact;
----
unterminated_scanned	unterminated_exact	tilde_exact	setext_exact	indented_exact
0	1	1	1	1


# exact only moves the structural counts.

query
SELECT (md_stats(md_stats_doc())).word_count = (md_stats(md_stats_doc(), true)).word_count
   AND (md_stats(md_stats_doc())).char_count = (md_stats(md_stats_doc(), true)).char_count
   AND (md_stats(md_stats_doc())).line_count = (md_stats(md_stats_doc(), true)).line_count AS text_fields_same,
       md_stats(md_stats_doc(), false) = md_stats(md_stats_doc()) AS false_is_one_arg;
----
text_fields_same	false_is_one_arg
t	t


query
SELECT md_stats(NULL::VARCHAR, true) IS NULL AS null_doc,
       (md_stats('', true)).link_count AS empty_links;
----
null_doc	empty_links
t	0


# The flag is read per row.

query
SELECT f AS exact, (md_stats(md_stats_doc(), f)).link_count AS links
FROM (VALUES (false), (true)) t(f)
ORDER BY f;
----
exact	links
f	5
t	3


# Every md_* overload reaches pg_catalog.pg_proc, so \df and ORM introspection
# see the extension's functions like any other built-in.

query
SELECT count(*) > 0 AS in_pg_proc
FROM pg_catalog.pg_proc
WHERE proname = 'md_to_html';
----
in_pg_proc
t


# --- the readers, against a file serened writes and then reads back ---

statement count 1
COPY (SELECT E'# Doc Title\n\nText with a [link](http://example.com).\n\n## Sub\n\n```sql\nSELECT 1;\n```\n')
TO '${__TEST_DIR__}/md_doc.md' (FORMAT CSV, HEADER false, QUOTE '');


query
SELECT content LIKE '%Doc Title%' AS has_title
FROM read_markdown('${__TEST_DIR__}/md_doc.md');
----
has_title
t


query
SELECT title, level
FROM read_markdown_sections('${__TEST_DIR__}/md_doc.md')
ORDER BY start_line;
----
title	level
Doc Title	1
Sub	2


query
SELECT element_type
FROM read_markdown_blocks('${__TEST_DIR__}/md_doc.md')
WHERE kind = 'block' AND element_type = 'code';
----
element_type
code


# The extension installs a replacement scan, so a bare .md path is a table.

query
SELECT content LIKE '%Doc Title%' AS scanned
FROM '${__TEST_DIR__}/md_doc.md';
----
scanned
t


# --- COPY TO ... (FORMAT markdown), read back through the reader ---

statement count 2
COPY (SELECT 1 AS a, 'x' AS b UNION ALL SELECT 2 AS a, 'y' AS b)
TO '${__TEST_DIR__}/md_table.md' (FORMAT markdown);


query
SELECT content LIKE '%| a | b |%' AS has_header,
       content LIKE '%| 2 | y |%' AS has_row
FROM read_markdown('${__TEST_DIR__}/md_table.md');
----
has_header	has_row
t	t
