hash-threshold 100

control substitution on

# The markdown extension over the pg wire. The extension's own suite runs at the
# DuckDB level (tests/duckdb/run.sh --suite markdown); what it cannot see is the
# wire mapping of the MARKDOWN type, the readers reaching a real file through
# serened, the .md replacement scan and COPY TO ... (FORMAT markdown).

# The MARKDOWN type is a VARCHAR alias, so it travels as text -- there is no
# markdown oid for a client to bind.

query
SELECT pg_typeof('x'::md) AS md_t, pg_typeof(md_to_html('# H')) AS html_t;
----
md_t	html_t
text	text


query
SELECT rtrim(md_to_html('# Hi'), chr(10)) AS html;
----
html
<h1>Hi</h1>


query
SELECT rtrim(md_to_text('# Title'), chr(10)) AS txt, md_valid('# ok') AS valid;
----
txt	valid
Title	t


query
SELECT (md_stats(E'# A\n## B\n[l](http://x)')).heading_count AS headings,
       (md_stats(E'# A\n## B\n[l](http://x)')).link_count AS links;
----
headings	links
2	1


query
SELECT (md_extract_links('see [a](http://a) and [b](http://b)'))[2].url AS second_url;
----
second_url
http://b


query
SELECT (md_extract_code_blocks(E'```sql\nSELECT 1;\n```'))[1].language AS lang;
----
lang
sql


# Every md_* overload reaches pg_catalog.pg_proc, so \df and ORM introspection
# see the extension's functions like any other built-in.

query
SELECT count(*) > 0 AS in_pg_proc
FROM pg_catalog.pg_proc
WHERE proname = 'md_to_html';
----
in_pg_proc
t


# --- the readers, against a file serened writes and then reads back ---

statement count 1
COPY (SELECT E'# Doc Title\n\nText with a [link](http://example.com).\n\n## Sub\n\n```sql\nSELECT 1;\n```\n')
TO '${__TEST_DIR__}/md_doc.md' (FORMAT CSV, HEADER false, QUOTE '');


query
SELECT content LIKE '%Doc Title%' AS has_title
FROM read_markdown('${__TEST_DIR__}/md_doc.md');
----
has_title
t


query
SELECT title, level
FROM read_markdown_sections('${__TEST_DIR__}/md_doc.md')
ORDER BY start_line;
----
title	level
Doc Title	1
Sub	2


query
SELECT element_type
FROM read_markdown_blocks('${__TEST_DIR__}/md_doc.md')
WHERE kind = 'block' AND element_type = 'code';
----
element_type
code


# The extension installs a replacement scan, so a bare .md path is a table.

query
SELECT content LIKE '%Doc Title%' AS scanned
FROM '${__TEST_DIR__}/md_doc.md';
----
scanned
t


# --- COPY TO ... (FORMAT markdown), read back through the reader ---

statement count 2
COPY (SELECT 1 AS a, 'x' AS b UNION ALL SELECT 2 AS a, 'y' AS b)
TO '${__TEST_DIR__}/md_table.md' (FORMAT markdown);


query
SELECT content LIKE '%| a | b |%' AS has_header,
       content LIKE '%| 2 | y |%' AS has_row
FROM read_markdown('${__TEST_DIR__}/md_table.md');
----
has_header	has_row
t	t
