query
SELECT '1'::money = 1 AS a, '1'::money = 100::int8 AS b, '1'::money < 2 AS c, '1'::money IN (1, 2) AS d,
       '1.5'::money = 1.5 AS e, coalesce(NULL::money, 0) AS f;
----
a	b	c	d	e	f
t	f	t	t	t	$0.00


query
SELECT m FROM (SELECT '1'::money AS m UNION SELECT 2) t ORDER BY m;
----
m
$1.00
$2.00


query
SELECT pg_typeof(s * 7) AS s_type, s * 7 AS s7, pg_typeof(b * 7) AS b_type, b * 7 AS b7, pg_typeof(7 * b) AS rb_type
FROM (VALUES (2::int2, 3::int8)) t(s, b);
----
s_type	s7	b_type	b7	rb_type
smallint	14	bigint	21	bigint
