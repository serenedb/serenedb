statement ok
CREATE TABLE multirange_copy (id INT, m int4multirange, d datemultirange, t tsmultirange, n nummultirange);


statement count 3
INSERT INTO multirange_copy VALUES
  (1, '{[1,5), [7,9)}', '{[2020-01-01,2020-02-01)}', '{["2020-01-01 10:00","2020-01-02 10:00")}', '{[1.5,2.5]}'),
  (2, '{}', NULL, '{(,)}', '{(,3], [4,)}'),
  (3, '{(,0)}', '{}', '{}', '{}');


statement count 3
COPY multirange_copy TO '${__TEST_DIR__}/multirange_copy.csv' (FORMAT CSV, HEADER TRUE);


statement count 3
COPY multirange_copy TO '${__TEST_DIR__}/multirange_copy.parquet' (FORMAT PARQUET);


statement ok
CREATE TABLE multirange_csv (id INT, m int4multirange, d datemultirange, t tsmultirange, n nummultirange);


statement count 3
COPY multirange_csv FROM '${__TEST_DIR__}/multirange_copy.csv' (FORMAT CSV, HEADER TRUE);


statement ok
CREATE TABLE multirange_parquet (id INT, m int4multirange, d datemultirange, t tsmultirange, n nummultirange);


statement count 3
COPY multirange_parquet FROM '${__TEST_DIR__}/multirange_copy.parquet' (FORMAT PARQUET);


query
SELECT c.id, c.m, c.d, c.t, c.n, c.m = p.m AND c.t = p.t AND c.n = p.n AS same
FROM multirange_csv c JOIN multirange_parquet p ON c.id = p.id ORDER BY c.id;
----
id	m	d	t	n	same
1	{[1,5),[7,9)}	{[2020-01-01,2020-02-01)}	{["2020-01-01 10:00:00","2020-01-02 10:00:00")}	{[1.500,2.500]}	t
2	{}	NULL	{(,)}	{(,3.000],[4.000,)}	t
3	{(,0)}	{}	{}	{}	t


statement count 3
INSERT INTO multirange_parquet SELECT * FROM read_parquet('${__TEST_DIR__}/multirange_copy.parquet');


query
SELECT id, m, d, t, n, count(*) AS copies FROM multirange_parquet GROUP BY ALL ORDER BY id;
----
id	m	d	t	n	copies
1	{[1,5),[7,9)}	{[2020-01-01,2020-02-01)}	{["2020-01-01 10:00:00","2020-01-02 10:00:00")}	{[1.500,2.500]}	2
2	{}	NULL	{(,)}	{(,3.000],[4.000,)}	2
3	{(,0)}	{}	{}	{}	2


query
SELECT CAST([{'nonempty': true, 'lower_finite': true, 'lower': 5, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 7, 'upper_inclusive': false},
             {'nonempty': true, 'lower_finite': true, 'lower': 1, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 5, 'upper_inclusive': true}] AS int4multirange) AS a;
----
a
{[1,7)}


statement ok
SET TimeZone = 'UTC'


query
SELECT CAST([{'nonempty': true, 'lower_finite': true, 'lower': 7000000000, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 8000000000, 'upper_inclusive': false},
             {'nonempty': true, 'lower_finite': true, 'lower': 5000000000, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 7000000000, 'upper_inclusive': false}] AS int8multirange) AS a,
       CAST([{'nonempty': true, 'lower_finite': false, 'lower': TIMESTAMPTZ '2020-01-01 10:00:00+00', 'lower_exclusive': false,
              'upper_infinite': false, 'upper': TIMESTAMPTZ '2020-01-02 00:00:00+00', 'upper_inclusive': true}] AS tstzmultirange) AS b;
----
a	b
{[5000000000,8000000000)}	{(,"2020-01-02 00:00:00+00"]}


