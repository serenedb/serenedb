control substitution on

query
SELECT '{[1.25,2.5), [3,4]}'::nummultirange AS a, nummultirange(numrange(1, 2), numrange(1.5, 3)) AS b,
       '{[1.5,2]}'::nummultirange @> 1.75 AS c, range_agg(n) AS d
FROM (VALUES (numrange(1.25, 2)), (numrange(2, 2.5))) t(n);
----
a	b	c	d
{[1.250,2.500),[3.000,4.000]}	{[1.000,3.000)}	t	{[1.250,2.500)}


query
SELECT '{[1,3), [5,7)}'::int4multirange @> '{[2,3)}'::int4multirange AS a, '{[1,3), [5,7)}'::int4multirange @> '6' AS b,
       '{[1,3), [5,7)}'::int4multirange @> '[1,2)'::int4range AS c;
----
a	b	c
t	t	t


statement error
SELECT '{[1,3), [5,7)}'::int4multirange @> '{[2,3)}';
----
db error: ERROR: Could not convert string '{[2,3)}' to INT32


query
SELECT TRY_CAST('{[1,3)' AS int4multirange) IS NULL AS a, TRY_CAST('{[3,1)}' AS int4multirange) IS NULL AS b,
       TRY_CAST('{[1,x)}' AS int4multirange) IS NULL AS c, TRY_CAST('{[5,7), [1,3)}' AS int4multirange) AS d;
----
a	b	c	d
t	t	t	{[1,3),[5,7)}


query
SELECT unnest('{[1,3), [5,7)}'::int4multirange) AS r ORDER BY r;
----
r
[1,3)
[5,7)


