query
SELECT CAST([{'nonempty': true, 'lower_finite': true, 'lower': 5::BIGINT, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 6::BIGINT, 'upper_inclusive': false},
             {'nonempty': true, 'lower_finite': true, 'lower': 1::BIGINT, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 3::BIGINT, 'upper_inclusive': false},
             {'nonempty': true, 'lower_finite': true, 'lower': 2::BIGINT, 'lower_exclusive': false, 'upper_infinite': false,
              'upper': 4::BIGINT, 'upper_inclusive': false}] AS int4multirange) AS a,
       CAST(['[5,6)'::int4range, '[1,2)'::int4range]::int4range[2] AS int4multirange) AS b,
       '[{"nonempty": true, "lower_finite": true, "lower": 7, "lower_exclusive": false, "upper_infinite": false, "upper": 8, "upper_inclusive": false},
         {"nonempty": true, "lower_finite": true, "lower": 1, "lower_exclusive": false, "upper_infinite": false, "upper": 2, "upper_inclusive": false}]'::json::int4multirange AS c;
----
a	b	c
{[1,4),[5,6)}	{[1,2),[5,6)}	{[1,2),[7,8)}


