query
SELECT list_max(regexp_extract_all(content, '"row_groups_scanned": ?"?([0-9]+)', 1)::INTEGER[]) AS row_groups_scanned
FROM read_text('${__TEST_DIR__}/psp_desc.json');
----
row_groups_scanned
1


query
SELECT count(*) AS groups FROM (SELECT k, count(*) FROM read_parquet('${__TEST_DIR__}/psp.parquet') GROUP BY k LIMIT 3);
----
groups
3


query
SELECT count(*) AS n, min(k) AS lo, max(k) AS hi FROM read_parquet('${__TEST_DIR__}/psp.parquet') WHERE k > 20500;
----
n	lo	hi
19500	20501	40000


query
SELECT count(*) AS n, min(k) AS lo, max(k) AS hi
FROM read_parquet(['${__TEST_DIR__}/psp.parquet', '${__TEST_DIR__}/psp_high.parquet']) WHERE k > 20500;
----
n	lo	hi
59500	20501	80000


query
SELECT count(*) AS n FROM read_parquet('${__TEST_DIR__}/psp.parquet') WHERE s <> '';
----
n
26666


query
SELECT count(*) AS n FROM read_parquet('${__TEST_DIR__}/psp.parquet') WHERE length(s) = 0;
----
n
13334


query
SELECT count(*) AS n FROM read_parquet(['${__TEST_DIR__}/psp.parquet', '${__TEST_DIR__}/psp_high.parquet'])
WHERE octet_length(s) > 4;
----
n
58000


query
SELECT sum(strlen(s)) AS bytes FROM read_parquet(['${__TEST_DIR__}/psp.parquet', '${__TEST_DIR__}/psp_high.parquet']);
----
bytes
344592


query
SELECT sum(strlen(s)) AS bytes FROM read_parquet(['${__TEST_DIR__}/psp.parquet', '${__TEST_DIR__}/psp_high.parquet'])
WHERE s <> '';
----
bytes
