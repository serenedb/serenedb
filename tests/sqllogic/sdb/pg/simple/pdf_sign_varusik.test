control substitution on

query
SELECT field_name FROM pdf_sign('${RESOURCES}/tests/pdf/basic/varusik.pdf', '${__TEST_DIR__}/varusik_rsa_signed.pdf',
 '${RESOURCES}/tests/pdf/signing/varusik_rsa_cert.pem', '${RESOURCES}/tests/pdf/signing/varusik_rsa_key.pem',
 reason := 'varusik approves', location := 'banochka', signer_name := 'varusik');
----
field_name
Signature1

query
SELECT field_name, subfilter, signer_name, reason, location,
       signing_time IS NOT NULL AS has_date, covers_whole_file, verified
FROM pdf_signatures('${__TEST_DIR__}/varusik_rsa_signed.pdf');
----
field_name	subfilter	signer_name	reason	location	has_date	covers_whole_file	verified
Signature1	adbe.pkcs7.detached	varusik	varusik approves	banochka	t	t	t

query
SELECT count(*) AS pages FROM read_pdf('${__TEST_DIR__}/varusik_rsa_signed.pdf');
----
pages
2

query
SELECT field_name FROM pdf_sign('${RESOURCES}/tests/pdf/basic/varusik.pdf', '${__TEST_DIR__}/varusik_pkcs1_signed.pdf',
 '${RESOURCES}/tests/pdf/signing/varusik_rsa_cert.pem', '${RESOURCES}/tests/pdf/signing/varusik_rsa_pkcs1_key.pem',
 field_name := 'varusik');
