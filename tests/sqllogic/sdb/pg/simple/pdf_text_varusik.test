query
SELECT page, word, round(x0) AS x, font_name, font_size, source, confidence IS NULL AS native,
       x1 > x0 AND y1 > y0 AS bounds, label IS NULL AS unlabeled
FROM read_pdf_words('${RESOURCES}/tests/pdf/basic/varusik.pdf') ORDER BY page, y0, x0;
----
page	word	x	font_name	font_size	source	native	bounds	unlabeled
1	varusik	60	Helvetica	12	text	t	t	t
1	banochka	260	Helvetica	12	text	t	t	t
1	sopley	60	Helvetica	12	text	t	t	t
1	42	260	Helvetica	12	text	t	t	t
2	varusik	72	Helvetica	12	text	t	t	t
2	poesh	114	Helvetica	12	text	t	t	t

query
SELECT count(*) AS differences FROM (
  (SELECT * FROM read_pdf_words('${RESOURCES}/tests/pdf/basic/varusik.pdf')
   EXCEPT SELECT * FROM read_pdf_layout('${RESOURCES}/tests/pdf/basic/varusik.pdf'))
  UNION ALL
  (SELECT * FROM read_pdf_layout('${RESOURCES}/tests/pdf/basic/varusik.pdf')
   EXCEPT SELECT * FROM read_pdf_words('${RESOURCES}/tests/pdf/basic/varusik.pdf'))
) AS varusik;
----
differences
0

