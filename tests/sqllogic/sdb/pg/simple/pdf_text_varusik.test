statement ok
CREATE TEXT SEARCH DICTIONARY pdf_text_varusik_analyzer AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);

statement ok
CREATE VIEW pdf_text_varusik_words AS
SELECT * FROM read_pdf_words('${RESOURCES}/tests/pdf/basic/varusik*.pdf', password := 'varusik');

statement ok
CREATE INDEX pdf_text_varusik_words_idx ON pdf_text_varusik_words
USING inverted(word pdf_text_varusik_analyzer, page) INCLUDE(page);

query
SELECT page, word, count(DISTINCT filename) AS files, min(font_size) AS font_size, min(page_width) AS width
FROM pdf_text_varusik_words_idx WHERE word @@ ts_phrase('poesh') GROUP BY page, word;
----
page	word	files	font_size	width
2	poesh	2	12	612

statement ok
CREATE VIEW pdf_text_varusik_lines AS
SELECT * FROM read_pdf_lines('${RESOURCES}/tests/pdf/basic/partitions/*/*.pdf', hive_partitioning := true);

statement ok
CREATE INDEX pdf_text_varusik_lines_idx ON pdf_text_varusik_lines
USING inverted(text pdf_text_varusik_analyzer, page) INCLUDE(page);

query
SELECT varusik, page, line, text FROM pdf_text_varusik_lines_idx
WHERE text @@ ts_phrase('poesh') ORDER BY varusik;
----
varusik	page	line	text
one	2	1	varusik poesh
two	2	1	varusik poesh

statement ok
CREATE VIEW pdf_text_varusik_layout AS
SELECT * FROM read_pdf_layout('${RESOURCES}/tests/pdf/basic/varusik.pdf');

statement ok
CREATE INDEX pdf_text_varusik_layout_idx ON pdf_text_varusik_layout
USING inverted(word pdf_text_varusik_analyzer, page) INCLUDE(page);

query
SELECT page, word, font_name, font_size FROM pdf_text_varusik_layout_idx WHERE word @@ ts_phrase('poesh');
----
page	word	font_name	font_size
2	poesh	Helvetica	12

