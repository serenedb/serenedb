query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes,
	(SELECT count(*) FROM (SELECT * FROM narrow_off EXCEPT ALL SELECT * FROM narrow_on)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM narrow_on EXCEPT ALL SELECT * FROM narrow_off)) AS gained
FROM narrow_off;
----
rows	shapes	lost	gained
70	13	0	0

query
SELECT shape, json_serialize_plan(sql, optimize := true)::VARCHAR LIKE '%LOGICAL_EMPTY_RESULT%' AS pruned_to_nothing
FROM shapes ORDER BY 1;
