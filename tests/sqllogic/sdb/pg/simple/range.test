control substitution on

query
SELECT numrange(1.25, 2.5) AS a, '[1.5,2]'::numrange AS b, numrange(1, 2) @> 1.5 AS c, lower(numrange(1.25, NULL)) AS d,
       upper_inf(numrange(1.25, NULL)) AS e, numrange(1, 3) * numrange(2, 4) AS f, numrange(1, 2) -|- numrange(2, 3) AS g,
       numrange(1, 2, '()') @> 1 AS h;
----
a	b	c	d	e	f	g	h
[1.250,2.500)	[1.500,2.000]	t	1.250	t	[2.000,3.000)	t	f


query
SELECT int4range(1, 10) @> '[2,3)'::int4range AS a, '[2,3)'::int4range <@ int4range(1, 10) AS b, int4range(1, 10) @> '5' AS c;
----
a	b	c
t	t	t


statement error
SELECT int4range(1, 10) @> '[2,3)';
----
db error: ERROR: Could not convert string '[2,3)' to INT32<slt:ignore>


query
SELECT TRY_CAST('[1,2' AS int4range) IS NULL AS a, TRY_CAST('[5,1)' AS int4range) IS NULL AS b,
       TRY_CAST('[1,x)' AS int4range) IS NULL AS c, TRY_CAST('[1,2)' AS int4range) AS d;
----
a	b	c	d
t	t	t	[1,2)


statement ok
CREATE TABLE range_keys (r int4range);


statement error
CREATE INDEX range_keys_r ON range_keys (r);
----
db error: ERROR: Invalid Type [int4range]: Invalid type for index key.


statement error
CREATE TABLE range_unique (r tstzrange UNIQUE);
----
db error: ERROR: Invalid Type [tstzrange]: Invalid type for index key.


statement ok
CREATE TABLE range_copy (id INT, r int4range, d daterange, t tsrange, n numrange);


statement count 2
INSERT INTO range_copy VALUES (1, '[1,5)', '[2020-01-01,2020-02-01)', '["2020-01-01 10:00","2020-01-02 10:00")', '[1.5,2.5]'),
                              (2, 'empty', NULL, '(,)', '(,3]');


statement count 2
COPY range_copy TO '${__TEST_DIR__}/range_copy.csv' (FORMAT CSV, HEADER TRUE);


statement count 2
COPY range_copy TO '${__TEST_DIR__}/range_copy.parquet' (FORMAT PARQUET);


statement ok
CREATE TABLE range_csv (id INT, r int4range, d daterange, t tsrange, n numrange);


statement count 2
COPY range_csv FROM '${__TEST_DIR__}/range_copy.csv' (FORMAT CSV, HEADER TRUE);


statement ok
CREATE TABLE range_parquet (id INT, r int4range, d daterange, t tsrange, n numrange);


statement count 2
COPY range_parquet FROM '${__TEST_DIR__}/range_copy.parquet' (FORMAT PARQUET);


query
SELECT c.id, c.r, c.d, c.t, c.n, c.r = p.r AND c.t = p.t AND c.n = p.n AS same
FROM range_csv c JOIN range_parquet p ON c.id = p.id ORDER BY c.id;
----
id	r	d	t	n	same
1	[1,5)	[2020-01-01,2020-02-01)	["2020-01-01 10:00:00","2020-01-02 10:00:00")	[1.500,2.500]	t
2	empty	NULL	(,)	(,3.000]	t
