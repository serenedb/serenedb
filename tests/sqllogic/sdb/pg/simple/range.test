query
SELECT CAST({'nonempty': true, 'lower_finite': true, 'lower': 1::BIGINT, 'lower_exclusive': true, 'upper_infinite': false,
             'upper': 5::BIGINT, 'upper_inclusive': true} AS int4range) AS a,
       ROW(true, true, 1, false, false, 5, false)::int4range AS b,
       '[1,5)'::int4range::int8range AS c;
----
a	b	c
[2,6)	[1,5)	[1,5)


statement ok
SET TimeZone = 'UTC'


query
SELECT CAST({'nonempty': true, 'lower_finite': true, 'lower': 5000000000, 'lower_exclusive': true, 'upper_infinite': false,
             'upper': 6000000000, 'upper_inclusive': true} AS int8range) AS a,
       CAST({'nonempty': true, 'lower_finite': true, 'lower': TIMESTAMPTZ '2020-01-01 10:00:00+00', 'lower_exclusive': false,
             'upper_infinite': true, 'upper': TIMESTAMPTZ '2020-01-02 00:00:00+00', 'upper_inclusive': false} AS tstzrange) AS b;
----
a	b
[5000000001,6000000001)	["2020-01-01 10:00:00+00",)


statement ok
