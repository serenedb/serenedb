page
1
3

system ok
cp "$__TEST_DIR__/rendered/business_report.pdf" "$__TEST_DIR__/Quarterly résumé 2026.pdf"

query
SELECT count(*) AS pages, bool_and(ends_with(filename, 'Quarterly résumé 2026.pdf')) AS filename_preserved
FROM read_pdf('${__TEST_DIR__}/Quarterly résumé 2026.pdf');
----
pages	filename_preserved
4	t

statement ok
CREATE TABLE pdf_pages AS SELECT page, text FROM read_pdf('${__TEST_DIR__}/rendered/business_report.pdf');

query
SELECT page FROM pdf_pages WHERE contains(text, 'END-OF-REPORT') ORDER BY page;
----
page
4

statement ok
DROP TABLE pdf_pages;

