query
SELECT row_index, cells[1] AS first, cells[2] AS second, cells[3] AS third
FROM read_pdf_tables('${RESOURCES}/tests/pdf/basic/spaced_table.pdf')
ORDER BY row_index;
----
row_index	first	second	third
1	0	2,248	1,135
2	A	B	C

query
SELECT page, table_index, row_index, cells[1] AS item, cells[2] AS quantity,
       cells[3] AS price, cells[4] AS amount
FROM read_pdf_tables('${RESOURCES}/tests/pdf/rendered/business_report.pdf')
ORDER BY page, table_index, row_index;
----
page	table_index	row_index	item	quantity	price	amount
1	1	1	Item	Quantity	Unit price	Amount
1	1	2	vedernikov poesh banochku sopley	4	25.00	100.00
1	1	3	this is fine	3	12.50	37.50
1	1	4	Total EUR			137.50

query
SELECT count(*) AS rows, max(page) AS pages, max(row_index) AS rows_per_page,
       min(table_index) AS first_table, max(table_index) AS last_table,
       bool_and(cells[2]::BIGINT = row_index) AS values_preserved
FROM read_pdf_tables('${RESOURCES}/tests/pdf/basic/many_tables.pdf');
----
rows	pages	rows_per_page	first_table	last_table	values_preserved
2145	65	33	1	1	t

