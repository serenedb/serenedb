# \C matches any byte, so it can stop inside a UTF-8 character. A match that
# ends there is not text, and a tail after it must not take the rest of the
# character.

query
SELECT regexp_full_match('aé', '^(a)\C.*$') AS r;
----
r
f

query
SELECT regexp_replace('aé', '^(a)\C.*$', '[\1]') AS r;
----
r
aé

query
SELECT regexp_replace('aé', '^(a)\C.*$', '\1') AS r;
----
r
aé

query
SELECT regexp_replace('aé' || repeat('x', 100000), '^(a)\C.*$', '[\1]') = 'aé' || repeat('x', 100000) AS r;
----
r
t

query
SELECT regexp_match('aé', '^(a)\C.*$') IS NULL AS r;
----
r
t

query
SELECT regexp_count('aé', '^(a)\C.*$') AS r;
----
r
0

query
SELECT regexp_replace('aé', 'a(?:\C|(é)).*$', '[\1]') AS r;
----
r
[é]

query
SELECT regexp_extract('aé', 'a(?:\C|(é)).*$', 1) AS r;
----
r
é

query
SELECT regexp_match('aé', 'a(?:\C|(é)).*$') AS r;
----
r
{é}

statement error
SELECT regexp_replace('aéb', '^(a)\C.*', '[\1]');
----
db error: ERROR: Regular expression result is not valid UTF-8 - \C matched part of a character


statement error
SELECT regexp_replace('aéb', '^(a)\C(.*)', '[\1]');
----
db error: ERROR: Regular expression result is not valid UTF-8 - \C matched part of a character
