control substitution on

statement ok
CREATE OR REPLACE SECRET ssr_refresh_${__DATABASE__} (
    TYPE s3,
    KEY_ID 'ssr_key_id',
    SECRET 'AccessKey4711',
    SESSION_TOKEN 'SessionToken4711',
    REFRESH 'auto',
    SCOPE 's3://ssr-refresh-${__DATABASE__}'
);

statement ok
CREATE OR REPLACE SECRET ssr_refresh_info_${__DATABASE__} (
    TYPE s3,
    KEY_ID 'ssr_key_id',
    SECRET 'AccessKey4711',
    REFRESH_INFO MAP {'secret': 'AccessKey4711', 'session_token': 'SessionToken4711'},
    SCOPE 's3://ssr-refresh-info-${__DATABASE__}'
);

statement ok
CREATE OR REPLACE SECRET ssr_proxy_s3_${__DATABASE__} (
    TYPE s3,
    KEY_ID 'ssr_key_id',
    SECRET 'ssr_access_key',
    HTTP_PROXY 'proxy.example.com:3128',
    HTTP_PROXY_USERNAME 'ssr_proxy_user',
    HTTP_PROXY_PASSWORD 'ProxyPw4711',
    SCOPE 's3://ssr-proxy-${__DATABASE__}'
);

statement ok
CREATE OR REPLACE SECRET ssr_proxy_r2_${__DATABASE__} (
    TYPE r2,
    KEY_ID 'ssr_key_id',
    SECRET 'ssr_access_key',
    HTTP_PROXY_PASSWORD 'ProxyPw4711',
    SCOPE 'r2://ssr-proxy-${__DATABASE__}'
);

statement ok
CREATE OR REPLACE SECRET ssr_proxy_gcs_${__DATABASE__} (
    TYPE gcs,
    KEY_ID 'ssr_key_id',
    SECRET 'ssr_access_key',
    HTTP_PROXY_PASSWORD 'ProxyPw4711',
    SCOPE 'gcs://ssr-proxy-${__DATABASE__}'
);

query
SELECT
    replace(name, '_${__DATABASE__}', '') AS secret,
    secret_string LIKE '%AccessKey4711%' OR secret_string LIKE '%SessionToken4711%' OR secret_string LIKE '%ProxyPw4711%' AS shown,
    secret_string LIKE '%;refresh_info=redacted%' AS refresh_info_redacted,
    secret_string LIKE '%;http_proxy_password=redacted%' AS proxy_password_redacted
FROM sdb_secrets()
WHERE name LIKE 'ssr_%_${__DATABASE__}'
ORDER BY 1;
----
secret	shown	refresh_info_redacted	proxy_password_redacted
ssr_proxy_gcs	f	f	t
ssr_proxy_r2	f	f	t
ssr_proxy_s3	f	f	t
ssr_refresh	f	t	f
ssr_refresh_info	f	t	f

statement ok
DROP SECRET ssr_refresh_${__DATABASE__};

statement ok
DROP SECRET ssr_refresh_info_${__DATABASE__};

statement ok
DROP SECRET ssr_proxy_s3_${__DATABASE__};

statement ok
DROP SECRET ssr_proxy_r2_${__DATABASE__};

statement ok
DROP SECRET ssr_proxy_gcs_${__DATABASE__};
