query
SELECT count(*) AS n, bool_and(c = (SELECT count(*) FROM sac s WHERE s.k IS NOT DISTINCT FROM r.k)) AS exact FROM (SELECT k, count(*) AS c FROM sac GROUP BY k LIMIT 3) r;
----
n	exact
3	t


query
