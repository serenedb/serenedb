statement ok
CREATE TABLE sac (id BIGINT, v INTEGER) WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
INSERT INTO sac SELECT i, i FROM range(5000) t(i);


statement ok
VACUUM (FLUSH_TABLE) sac;


statement ok
ALTER TABLE sac ADD COLUMN k INTEGER;


statement ok
INSERT INTO sac SELECT i, i, i % 100 FROM range(5000, 10000) t(i);


statement ok
VACUUM (FLUSH_TABLE) sac;


query
SELECT id, k FROM sac ORDER BY k DESC, id LIMIT 3;
