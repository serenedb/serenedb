# ALTER TABLE on a search table. Maintenance options take effect on the running
# table, a shortened interval applies at once and a rolled-back ALTER leaves the
# old settings running. Codec options and ALTER COLUMN SET COMPRESSION apply to
# the segments written from then on; compaction rewrites the older ones.

statement ok
CREATE TABLE alt (id INT PRIMARY KEY, body TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO alt SELECT i, 'row ' || i FROM range(100) t(i);

statement ok
BEGIN;

statement ok
ALTER TABLE alt SET (refresh_interval = 100);

statement ok
ROLLBACK;

sleep 2s

query
SELECT count(*) AS n FROM alt;
----
n
0

statement ok
ALTER TABLE alt SET (refresh_interval = 100);

query ok retry 60 backoff 500ms
SELECT count(*) AS n FROM alt;
----
n
100

statement ok
ALTER TABLE alt SET (refresh_interval = 600000);

sleep 1s

statement ok
INSERT INTO alt SELECT i, 'row ' || i FROM range(100, 200) t(i);

sleep 2s

query
SELECT count(*) AS n FROM alt;
----
n
100

statement ok
ALTER TABLE alt SET (refresh_interval = 100);

query ok retry 20 backoff 500ms
SELECT count(*) AS n FROM alt;
----
n
200

# An inverted index on the table does not block altering it.
statement ok
CREATE INDEX alt_idx ON alt USING inverted(body);

statement ok
ALTER TABLE alt SET (refresh_interval = 0, compaction_interval = 500);

statement ok
ALTER TABLE alt RESET (compaction_interval);

statement ok
ALTER TABLE alt ALTER COLUMN body SET COMPRESSION dict_lz4;

query
SELECT reloptions FROM pg_class WHERE relname = 'alt';
----
reloptions
{refresh_interval=0,compaction_interval=1000,cleanup_interval_step=1,compaction_max_segments=10,compaction_max_segments_bytes=5368709120,compaction_floor_segment_bytes=2097152,row_group_size=122880,segment_memory_max=268435456}

statement ok
DROP TABLE alt;

# Column codecs. Two batches with the same values land in two segments; the
# second is written after the ALTER.
statement ok
CREATE TABLE alc (a INTEGER PRIMARY KEY, v TEXT, n INTEGER)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO alc SELECT a, 'event ' || (a % 3000) || ' completed for user ' || (a % 1000) || ' status ok', a FROM range(9000) t(a);

statement ok
VACUUM (REFRESH_TABLE) alc;

statement ok
ALTER TABLE alc ALTER COLUMN v SET COMPRESSION dict_zstd(compression_level = 19);

statement ok
INSERT INTO alc SELECT a, 'event ' || (a % 3000) || ' completed for user ' || (a % 1000) || ' status ok', a FROM range(9000, 18000) t(a);

statement ok
VACUUM (REFRESH_TABLE) alc;

query
SELECT row_group_id, compression
FROM pragma_storage_info('alc')
WHERE column_name = 'v' AND segment_type <> 'VALIDITY'
GROUP BY ALL ORDER BY ALL;
----
row_group_id	compression
0	DICT_FSST
1	DICT_ZSTD

statement ok
VACUUM (COMPACT_TABLE) alc;

query
SELECT count(DISTINCT row_group_id) AS segments, string_agg(DISTINCT compression, ',') AS compression
FROM pragma_storage_info('alc')
WHERE column_name = 'v' AND segment_type <> 'VALIDITY';
----
segments	compression
1	DICT_ZSTD

# A rolled-back SET COMPRESSION leaves the column's codec in place.
statement ok
BEGIN;

statement ok
ALTER TABLE alc ALTER COLUMN v SET COMPRESSION zxc;

statement ok
ROLLBACK;

statement ok
INSERT INTO alc SELECT a, 'x' || a, a FROM range(18000, 19000) t(a);

statement ok
VACUUM (REFRESH_TABLE) alc;

query
SELECT string_agg(DISTINCT compression, ',') AS compression
FROM pragma_storage_info('alc')
WHERE column_name = 'v' AND segment_type <> 'VALIDITY';
----
compression
DICT_ZSTD

# DEFAULT returns the column to auto.
statement ok
ALTER TABLE alc ALTER COLUMN v SET COMPRESSION DEFAULT;

query
SELECT reloptions FROM pg_class WHERE relname = 'alc';
----
reloptions
{refresh_interval=0,compaction_interval=0,cleanup_interval_step=1,compaction_max_segments=10,compaction_max_segments_bytes=5368709120,compaction_floor_segment_bytes=2097152,row_group_size=122880,segment_memory_max=268435456}

statement ok
INSERT INTO alc SELECT a, 'x' || a, a FROM range(19000, 20000) t(a);

statement ok
VACUUM (REFRESH_TABLE) alc;

query
SELECT compression FROM pragma_storage_info('alc')
WHERE column_name = 'v' AND segment_type <> 'VALIDITY'
  AND row_group_id = (SELECT max(row_group_id) FROM pragma_storage_info('alc'));
----
compression
FSST

query
SELECT count(*) AS mismatches FROM alc
WHERE v IS DISTINCT FROM CASE WHEN a < 18000 THEN 'event ' || (a % 3000) || ' completed for user ' || (a % 1000) || ' status ok' ELSE 'x' || a END;
----
mismatches
0

query
SELECT split_part(sql, ' WITH', 1) AS columns FROM duckdb_tables() WHERE table_name = 'alc';
----
columns
CREATE TABLE public.alc(a INTEGER PRIMARY KEY, v VARCHAR, n INTEGER)

# Rejections.
statement error
ALTER TABLE alc SET (compression_level = 3);
----
db error: ERROR: unrecognized parameter "compression_level"


statement error
ALTER TABLE alc SET (row_group_size = 4096);
----
db error: ERROR: option "row_group_size" cannot be changed with ALTER TABLE


statement error
ALTER TABLE alc ALTER COLUMN n SET COMPRESSION dict_lz4;
----
db error: ERROR: Can't compress column "n" with type 'INTEGER' (physical: INT32) using compression type 'DICT_LZ4'


statement error
ALTER TABLE alc ALTER COLUMN v SET COMPRESSION dict_fsst(compression_level = 2);
----
db error: ERROR: Column "v": compression 'dict_fsst' takes no compression_level


statement error
ALTER TABLE alc ALTER COLUMN v SET COMPRESSION lz4(compression_level = 13);
----
db error: ERROR: Column "v": compression_level 13 is out of range for 'lz4' (1 to 12)


statement error
ALTER TABLE alc ALTER COLUMN v SET COMPRESSION lz4(level = 3);
----
db error: ERROR: Unknown compression option 'level', expected compression_level


statement ok
DROP TABLE alc;

# On a transactional table the new codec applies at the next checkpoint, and
# the columnstore codecs stay search-table only.
statement ok
CREATE TABLE alt_tx (a INTEGER, b INTEGER);

statement ok
INSERT INTO alt_tx SELECT i, i // 1000 FROM range(100000) t(i);

statement ok
ALTER TABLE alt_tx ALTER COLUMN b SET COMPRESSION rle;

statement error
ALTER TABLE alt_tx ALTER COLUMN b SET COMPRESSION dict_lz4;
----
db error: ERROR: Column "b": compression 'dict_lz4' is only available on search tables (WITH (storage = 'search'))


statement ok
FORCE CHECKPOINT;

query
SELECT DISTINCT compression FROM pragma_storage_info('alt_tx') WHERE column_name = 'b' AND segment_type <> 'VALIDITY';
----
compression
RLE

query
SELECT sql FROM duckdb_tables() WHERE table_name = 'alt_tx';
----
sql
CREATE TABLE public.alt_tx(a INTEGER, b INTEGER USING COMPRESSION RLE);

statement ok
DROP TABLE alt_tx;
