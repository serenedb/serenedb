CREATE TABLE sac_vec (id INT PRIMARY KEY, emb FLOAT[2], a INT)
WITH (storage = 'search');


statement ok
CREATE INDEX sac_vec_idx ON sac_vec
  USING inverted (id, emb hnsw (metric = 'l2', quant = 'none')) INCLUDE (a);


statement ok
