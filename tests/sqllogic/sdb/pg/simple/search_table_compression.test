CREATE TABLE search_declared (a INTEGER PRIMARY KEY, v_uncompressed TEXT USING COMPRESSION uncompressed, v_zstd TEXT USING COMPRESSION zstd, v_dict_fsst TEXT USING COMPRESSION dict_fsst, v_rle INTEGER USING COMPRESSION rle, v_bitpacking INTEGER USING COMPRESSION bitpacking, v_alp DOUBLE USING COMPRESSION alp, v_alprd DOUBLE USING COMPRESSION alprd, v_roaring BOOLEAN USING COMPRESSION roaring)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO search_declared SELECT a, repeat('u' || a, 20), repeat('z' || a, 20), 'v' || (a % 7), a // 100, a, a / 10.0, a * 0.1234567891, a % 3 = 0 FROM range(5000) t(a);

statement ok
VACUUM (REFRESH_TABLE) search_declared;

query
SELECT column_name, string_agg(DISTINCT compression, ',') AS compression FROM pragma_storage_info('search_declared') WHERE column_name LIKE 'v\_%' GROUP BY column_name ORDER BY column_name;
----
column_name	compression
v_alp	ALP
v_alprd	ALPRD
v_bitpacking	BitPacking
v_dict_fsst	DICT_FSST
v_rle	RLE
v_roaring	Roaring
v_uncompressed	Uncompressed
v_zstd	ZSTD

query
SELECT count(*) FROM search_declared WHERE v_uncompressed IS DISTINCT FROM repeat('u' || a, 20) OR v_zstd IS DISTINCT FROM repeat('z' || a, 20) OR v_dict_fsst IS DISTINCT FROM 'v' || (a % 7) OR v_rle IS DISTINCT FROM a // 100 OR v_bitpacking IS DISTINCT FROM a OR v_alp IS DISTINCT FROM a / 10.0 OR v_alprd IS DISTINCT FROM a * 0.1234567891 OR v_roaring IS DISTINCT FROM a % 3 = 0;
----
count
0

