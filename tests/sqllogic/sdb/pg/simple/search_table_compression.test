# A refresh always writes the speed set (lz4 leaves); compaction re-encodes
# with the table's objective. Two flushed segments so the compaction merges.
statement ok
CREATE TABLE obj_balanced (a INTEGER PRIMARY KEY, host TEXT, body TEXT, url TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, compression_objective = 'balanced');

statement ok
CREATE TABLE obj_size (a INTEGER PRIMARY KEY, host TEXT, body TEXT, url TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, compression_objective = 'size');

statement ok
CREATE TABLE obj_speed (a INTEGER PRIMARY KEY, host TEXT, body TEXT, url TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, compression_objective = 'speed');

statement ok
INSERT INTO obj_balanced SELECT a, 'host-' || (a % 17), 'event ' || a || ' completed for user ' || (a % 1000) || ' on host-' || (a % 17) || ' status ok latency ' || (a % 500) || ' ms', 'https://example.org/section/' || (a % 500) || '/page?id=' || (a % 7) FROM range(10000) t(a);

statement ok
