query
SELECT (SELECT count(*) FROM obj_balanced WHERE url = 'https://example.org/section/42/page?id=0') AS balanced,
       (SELECT count(*) FROM obj_size WHERE url = 'https://example.org/section/42/page?id=0') AS size,
       (SELECT count(*) FROM obj_speed WHERE url = 'https://example.org/section/42/page?id=0') AS speed,
       (SELECT count(*) FROM obj_size s JOIN obj_balanced b USING (a) WHERE s.body IS DISTINCT FROM b.body OR s.url IS DISTINCT FROM b.url OR s.host IS DISTINCT FROM b.host) AS mismatches;
----
balanced	size	speed	mismatches
6	6	6	0

