# A refresh always writes the cheap leaves (fsst, lz4); compaction re-encodes
# with the full set. Two flushed segments so the compaction merges.
statement ok
CREATE TABLE obj_auto (a INTEGER PRIMARY KEY, host TEXT, body TEXT, url TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO obj_auto SELECT a, 'host-' || (a % 17), 'event ' || a || ' completed for user ' || (a % 1000) || ' on host-' || (a % 17) || ' status ok latency ' || (a % 500) || ' ms', 'https://example.org/section/' || (a % 500) || '/page?id=' || (a % 7) FROM range(10000) t(a);

statement ok
VACUUM (REFRESH_TABLE) obj_auto;

statement ok
INSERT INTO obj_auto SELECT a, 'host-' || (a % 17), 'event ' || a || ' completed for user ' || (a % 1000) || ' on host-' || (a % 17) || ' status ok latency ' || (a % 500) || ' ms', 'https://example.org/section/' || (a % 500) || '/page?id=' || (a % 7) FROM range(10000, 20000) t(a);

statement ok
VACUUM (REFRESH_TABLE) obj_auto;

query
SELECT column_name, string_agg(DISTINCT compression, ',') AS compression
FROM pragma_storage_info('obj_auto')
WHERE segment_type <> 'VALIDITY' AND column_name IN ('host', 'body', 'url')
GROUP BY column_name ORDER BY column_name;
----
column_name	compression
body	FSST
host	DICT_FSST
url	DICT_FSST

statement ok
VACUUM (COMPACT_TABLE) obj_auto;

