statement ok
INSERT INTO lvl_incl SELECT a, 'text ' || a, 'p' || (a % 13), repeat('q' || a, 6), repeat('r' || a, 6), 's' || (a % 17) FROM range(5000, 10000) t(a);

statement ok
VACUUM (FLUSH_TABLE) lvl_incl;

query
SELECT column_name, string_agg(DISTINCT compression, ',' ORDER BY compression) AS compression
FROM pragma_storage_info('lvl_incl')
WHERE column_name = 'p3' AND segment_type <> 'VALIDITY'
GROUP BY column_name;
----
column_name	compression
p3	DICT_FSST,LZ4

query
SELECT count(*) AS n, count(*) FILTER (WHERE p3 IS DISTINCT FROM repeat('r' || pk, 6)) AS mismatches FROM lvl_incl;
----
n	mismatches
10000	0

statement ok
DROP TABLE lvl_incl;

