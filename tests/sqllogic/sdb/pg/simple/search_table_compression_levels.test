statement error
CREATE TABLE lvl_bad (a INTEGER PRIMARY KEY, v TEXT USING COMPRESSION dict_zxc(compression_level = 8)) WITH (storage = 'search');
----
db error: ERROR: Column "v": compression_level 8 is out of range for 'dict_zxc' (1 to 7)


statement error
CREATE TABLE lvl_bad (a INTEGER PRIMARY KEY, v TEXT USING COMPRESSION lz4(compression_level = 0)) WITH (storage = 'search');
