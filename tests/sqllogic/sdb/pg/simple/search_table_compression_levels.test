# Rejections on INCLUDE columns, through the string form.
statement ok
CREATE TABLE lvl_incl_bad (pk INTEGER PRIMARY KEY, body TEXT, p TEXT)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement error
CREATE INDEX lvl_incl_bad_idx ON lvl_incl_bad USING inverted(body) INCLUDE (p included (compression = 'dict_fsst(compression_level=2)'));
----
db error: ERROR: Column "p": compression 'dict_fsst' takes no compression_level


statement error
CREATE INDEX lvl_incl_bad_idx ON lvl_incl_bad USING inverted(body) INCLUDE (p included (compression = 'lz4(compression_level=13)'));
----
db error: ERROR: Column "p": compression_level 13 is out of range for 'lz4' (1 to 12)


statement error
CREATE INDEX lvl_incl_bad_idx ON lvl_incl_bad USING inverted(body) INCLUDE (p included (compression = 'lz4(speed=1)'));
----
db error: ERROR: Column 'p': compression 'lz4(speed=1)': unknown option 'speed', expected compression_level


statement error
CREATE INDEX lvl_incl_bad_idx ON lvl_incl_bad USING inverted(body) INCLUDE (p included (compression = 'lz4(compression_level=1'));
----
db error: ERROR: Column 'p': compression 'lz4(compression_level=1': expected name(compression_level = N)


statement error
CREATE INDEX lvl_incl_bad_idx ON lvl_incl_bad USING inverted(body) INCLUDE (p included (compression = 'lz4(compression_level=x)'));
----
db error: ERROR: Column 'p': compression 'lz4(compression_level=x)': compression_level must be an integer between 1 and 255


statement ok
DROP TABLE lvl_incl_bad;

# Transactional tables: a level implies a columnstore codec, which they refuse;
# a duckdb codec never takes one.
statement error
CREATE TABLE lvl_plain (a INTEGER, v TEXT USING COMPRESSION dict_lz4(compression_level = 2));
----
db error: ERROR: Column "v": compression 'dict_lz4' is only available on search tables (WITH (storage = 'search'))


statement error
CREATE TABLE lvl_plain (a INTEGER, v TEXT USING COMPRESSION zstd(compression_level = 2));
----
db error: ERROR: Column "v": compression 'zstd' takes no compression_level


statement ok
CREATE TABLE lvl_plain (a INTEGER, v TEXT USING COMPRESSION zstd);

statement error
ALTER TABLE lvl_plain ADD COLUMN w TEXT USING COMPRESSION dict_zstd(compression_level = 4);
----
db error: ERROR: Column "w": compression 'dict_zstd' is only available on search tables (WITH (storage = 'search'))


statement ok
DROP TABLE lvl_plain;
