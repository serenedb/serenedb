query
SELECT count(*) AS mismatches FROM (
  (SELECT a, k, l FROM df_s WHERE k BETWEEN 'k-100' AND 'k-1005' EXCEPT SELECT a, k, l FROM df_d WHERE k BETWEEN 'k-100' AND 'k-1005')
  UNION ALL
  (SELECT a, k, l FROM df_d WHERE k BETWEEN 'k-100' AND 'k-1005' EXCEPT SELECT a, k, l FROM df_s WHERE k BETWEEN 'k-100' AND 'k-1005')
  UNION ALL
  (SELECT a, k, p FROM df_s WHERE k = 'k-42' EXCEPT SELECT a, k, p FROM df_d WHERE k = 'k-42')
);
----
mismatches
0

query
SELECT count(*) AS mismatches FROM (
  (SELECT a, k, l, p FROM df_s WHERE a % 997 = 3 EXCEPT SELECT a, k, l, p FROM df_d WHERE a % 997 = 3)
  UNION ALL
  (SELECT a, k, l, p FROM df_d WHERE a % 997 = 3 EXCEPT SELECT a, k, l, p FROM df_s WHERE a % 997 = 3)
);
----
mismatches
0

