statement ok
CREATE TABLE df_s (a INTEGER PRIMARY KEY,
                   k TEXT USING COMPRESSION dict_fsst,
                   l TEXT USING COMPRESSION dict_lz4,
                   p TEXT USING COMPRESSION fsst)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, segment_target = 65536);

statement ok
CREATE TABLE df_d (a INTEGER PRIMARY KEY, k TEXT, l TEXT, p TEXT);

statement ok
INSERT INTO df_d SELECT a,
  CASE WHEN a % 11 = 0 THEN NULL WHEN a % 13 = 0 THEN '' ELSE 'k-' || (a % 3000) END,
  CASE WHEN a % 7 = 0 THEN NULL ELSE 'l-' || (a % 500) END,
  CASE WHEN a % 17 = 0 THEN NULL ELSE 'row ' || a || ' of the plain column' END
  FROM range(60000) t(a);

statement ok
INSERT INTO df_s SELECT * FROM df_d;

statement ok
VACUUM (REFRESH_TABLE) df_s;

query
SELECT column_name, string_agg(DISTINCT compression, ',') AS compression, count(*) > 1 AS several
FROM pragma_storage_info('df_s')
WHERE column_name IN ('k', 'l', 'p') AND segment_type <> 'VALIDITY'
GROUP BY column_name ORDER BY column_name;
----
column_name	compression	several
k	DICT_FSST	t
l	DICT_LZ4	t
p	FSST	t

query
