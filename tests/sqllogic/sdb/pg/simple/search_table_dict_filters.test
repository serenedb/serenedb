query
SELECT column_name, bool_and(segment_info LIKE '%sorted: true%') AS every_sorted, bool_or(segment_info LIKE '%sorted: true%') AS any_sorted
FROM pragma_storage_info('df_s', include_segment_info = true)
WHERE column_name IN ('k', 'l') AND segment_type <> 'VALIDITY'
GROUP BY column_name ORDER BY column_name;
----
column_name	every_sorted	any_sorted
k	t	t
l	f	f

statement ok
CREATE VIEW df_v AS SELECT a::INTEGER AS a, CASE WHEN a % 11 = 0 THEN NULL WHEN a % 13 = 0 THEN '' ELSE repeat(md5(((hash(a) % 4000) - (hash(a) % 4000) % 4)::TEXT), 6) || '/' || ((hash(a) % 4000) % 4) END AS v FROM range(60000) t(a);

statement ok
CREATE TABLE df_f (a INTEGER PRIMARY KEY,
                   z TEXT USING COMPRESSION dict_lz4,
                   s TEXT USING COMPRESSION dict_zstd,
                   x TEXT USING COMPRESSION dict_zxc)
  WITH (compaction_interval = 0, row_group_size = 16384);

statement ok
SET threads = 1;

statement ok
INSERT INTO df_f SELECT a, v, v, v FROM df_v;

statement ok
RESET threads;

statement ok
VACUUM (FLUSH_TABLE) df_f;

query
SELECT column_name, string_agg(DISTINCT compression, ',') AS compression, count(*) > 1 AS several,
       bool_and(segment_info LIKE '%sorted: true%') AS every_sorted
FROM pragma_storage_info('df_f', include_segment_info = true)
WHERE column_name IN ('z', 's', 'x') AND segment_type <> 'VALIDITY'
GROUP BY column_name ORDER BY column_name;
----
column_name	compression	several	every_sorted
s	DICT_ZSTD	t	t
x	DICT_ZXC	t	t
z	DICT_LZ4	t	t

