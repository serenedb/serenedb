query
SELECT count(*) AS mismatches FROM (
  (SELECT a, z, s, x FROM df_f WHERE z BETWEEN '4' AND 'c' EXCEPT SELECT a, v, v, v FROM df_v WHERE v BETWEEN '4' AND 'c')
  UNION ALL
  (SELECT a, v, v, v FROM df_v WHERE v BETWEEN '4' AND 'c' EXCEPT SELECT a, z, s, x FROM df_f WHERE x BETWEEN '4' AND 'c')
  UNION ALL
  (SELECT a, z, s, x FROM df_f WHERE s >= 'c' EXCEPT SELECT a, v, v, v FROM df_v WHERE v >= 'c')
  UNION ALL
  (SELECT a, z, s, x FROM df_f WHERE a % 997 = 3 EXCEPT SELECT a, v, v, v FROM df_v WHERE a % 997 = 3)
);
