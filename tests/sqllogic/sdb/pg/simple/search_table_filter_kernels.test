SET enable_profiling = 'json'


statement ok
SET profiling_output = '${__TEST_DIR__}/fk_uinteger_topn.json'


query
SELECT u FROM fk ORDER BY u DESC LIMIT 3;
----
u
16383
16382
16381


statement ok
SET profiling_output = '${__TEST_DIR__}/fk_varchar_topn.json'


query
SELECT s FROM fk ORDER BY s LIMIT 3;
----
s
000000_a_suffix_longer_than_twelve_bytes
000001_a_suffix_longer_than_twelve_bytes
000002_a_suffix_longer_than_twelve_bytes


statement ok
SET profiling_output = '${__TEST_DIR__}/fk_string_in.json'


query
SELECT count(*) AS n FROM fk WHERE s IN ('000005_a_suffix_longer_than_twelve_bytes', '010000_a_suffix_longer_than_twelve_bytes', '999999_a_suffix_longer_than_twelve_bytes');
----
n
2


statement ok
