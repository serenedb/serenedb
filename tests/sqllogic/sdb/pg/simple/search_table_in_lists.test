# An IN list of two to 32 constants is a filter of the scan itself, with no filter above it, for every codec; a longer
# list stays a mark join above the scan with an optional filter in it. One row group, one thread.

statement ok
SET threads = 1


statement ok
CREATE TABLE inl (id INTEGER PRIMARY KEY,
                  s TEXT USING COMPRESSION dict_fsst,
                  l TEXT USING COMPRESSION dict_lz4,
                  p TEXT USING COMPRESSION fsst,
                  r BIGINT USING COMPRESSION rle,
                  c BIGINT USING COMPRESSION bitpacking)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO inl
SELECT i,
       CASE WHEN (i // 8) % 13 = 0 THEN NULL ELSE 'svc-' || ((i // 8) * 7919 % 17) END,
       CASE WHEN (i // 8) % 13 = 0 THEN NULL ELSE 'svc-' || ((i // 8) * 7919 % 17) END,
       CASE WHEN (i // 8) % 13 = 0 THEN NULL ELSE 'svc-' || ((i // 8) * 7919 % 17) END,
       CASE WHEN (i // 16) % 37 = 0 THEN NULL ELSE (i // 16) * 7919 % 50 END,
       7
FROM range(49152) t(i);


statement ok
VACUUM (FLUSH_TABLE) inl;


query
SELECT column_name, compression, count(*) AS segments, sum(count) AS rows
FROM pragma_storage_info('inl')
WHERE column_name IN ('s', 'l', 'p', 'r', 'c') AND segment_type <> 'VALIDITY'
GROUP BY ALL ORDER BY column_name;
----
column_name	compression	segments	rows
c	Constant	1	49152
l	DICT_LZ4	1	49152
p	FSST	1	49152
r	RLE	1	49152
s	DICT_FSST	1	49152


query
SELECT count(*) FROM inl WHERE s IN ('svc-1', 'svc-5', 'svc-16');
----
count
8016


query
EXPLAIN SELECT count(*) FROM inl WHERE s IN ('svc-1', 'svc-5', 'svc-16');
