VACUUM (REFRESH_TABLE) list_dict;

statement ok
VACUUM (COMPACT_TABLE) list_dict;

query
SELECT count(*) FROM list_dict
WHERE a < 20000 AND (attrs IS DISTINCT FROM (CASE WHEN a % 11 = 0 THEN NULL WHEN a % 17 = 0 THEN map([], [])::MAP(VARCHAR, VARCHAR) ELSE MAP {'service': 'svc-' || (a // 997 % 7), 'host': 'h-' || (a % 13)} END)
   OR tags IS DISTINCT FROM (CASE WHEN a % 9 = 0 THEN NULL ELSE ['t' || (a % 5), 'u' || (a % 3)] END)
   OR nested IS DISTINCT FROM (CASE WHEN a % 13 = 0 THEN NULL ELSE [[a % 3, a % 2], [a % 4], []] END));
