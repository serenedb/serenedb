INSERT INTO list_dict SELECT a,
  CASE WHEN a % 11 = 0 THEN NULL ELSE MAP {'service': 'svc-' || (a // 997 % 7), 'host': 'h-' || (a % 13)} END,
  ['t' || (a % 5)],
  [[a % 3]]
FROM range(20000, 30000) t(a);

