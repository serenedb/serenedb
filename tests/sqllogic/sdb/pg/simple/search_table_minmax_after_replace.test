CREATE TABLE stmar_default (id BIGINT, x BIGINT)

statement ok
INSERT INTO stmar_default SELECT i, i FROM generate_series(1, 1000) g(i)

statement ok
UPDATE stmar_default SET x = 500 WHERE id IN (1, 1000)

statement ok
VACUUM (FLUSH_TABLE) stmar_default

query
SELECT min(x), max(x) FROM stmar_default
----
min	max
