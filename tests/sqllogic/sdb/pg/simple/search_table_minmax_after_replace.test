CREATE TABLE stmar_flush (id BIGINT, x BIGINT) WITH (compaction_interval = 0)

statement ok
INSERT INTO stmar_flush VALUES (1, 1), (2, 10)

statement ok
UPDATE stmar_flush SET x = 5 WHERE id = 1

statement ok
VACUUM (FLUSH_TABLE) stmar_flush

query
SELECT min(x), max(x) FROM stmar_flush
----
min	max
