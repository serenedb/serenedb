statement ok
CREATE TABLE stnc (id INTEGER PRIMARY KEY, a "NULL", b INTEGER)
WITH (compaction_interval = 0);


statement ok
INSERT INTO stnc SELECT i, NULL, 7 FROM range(3000) t(i);


statement ok
VACUUM (FLUSH_TABLE) stnc;


statement ok
INSERT INTO stnc SELECT i, NULL, 7 FROM range(3000, 6000) t(i);


statement ok
VACUUM (FLUSH_TABLE) stnc;


statement ok
VACUUM (COMPACT_TABLE) stnc;


query
SELECT count(*) AS total, count(a) AS non_null, min(b) AS b_min, max(b) AS b_max FROM stnc;
----
total	non_null	b_min	b_max
6000	0	7	7
