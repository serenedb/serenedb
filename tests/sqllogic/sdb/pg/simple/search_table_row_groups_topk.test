query
SELECT id, body FROM (SELECT id, body, BM25(rgk_idx.tableoid) AS s FROM rgk_idx WHERE body @@ 'rare' ORDER BY BM25(rgk_idx.tableoid) DESC LIMIT 10) r ORDER BY id;
