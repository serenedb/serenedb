query
SELECT (SELECT count(*) || ':' || sum(v) FROM slr WHERE k IN (0, 31, 63)) = (SELECT count(*) || ':' || sum(v) FROM slr_d WHERE k IN (0, 31, 63)) AS a,
       (SELECT count(*) || ':' || sum(v) FROM slr WHERE k >= 62 OR k <= 1) = (SELECT count(*) || ':' || sum(v) FROM slr_d WHERE k >= 62 OR k <= 1) AS b,
       (SELECT max(id) || ':' || min(id) FROM slr WHERE k = 40 AND v = 3) = (SELECT max(id) || ':' || min(id) FROM slr_d WHERE k = 40 AND v = 3) AS c;
----
a	b	c
t	t	t


query
SELECT id FROM slr WHERE k = 20 ORDER BY id DESC LIMIT 3;
