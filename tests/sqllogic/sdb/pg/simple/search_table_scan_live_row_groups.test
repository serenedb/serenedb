control substitution on

statement ok
CREATE TABLE slr (id BIGINT PRIMARY KEY, k INTEGER, v INTEGER)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, row_group_size = 4096);


statement ok
CREATE TABLE slr_d (id BIGINT PRIMARY KEY, k INTEGER, v INTEGER);


statement ok
SET threads = 1


statement ok
INSERT INTO slr_d SELECT i, i // 4096, i % 7 FROM range(262144) t(i);


statement ok
INSERT INTO slr SELECT * FROM slr_d ORDER BY id;


statement ok
VACUUM (REFRESH_TABLE) slr;


query
SELECT count(*) AS segments, sum(docs) AS docs FROM sdb_segments('slr');
----
segments	docs
1	262144


statement ok
SET threads = 4


statement ok
SET enable_profiling = 'json'


statement ok
