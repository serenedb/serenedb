# A scan that scores every row of an index keeps the rows the other scans keep
statement ok
CREATE TEXT SEARCH DICTIONARY ssw AS split_text(case := 'lower') WITH (frequency);


statement ok
CREATE TABLE ssx (id BIGINT PRIMARY KEY, body TEXT) WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
CREATE INDEX ssx_idx ON ssx USING inverted (id, body ssw) INCLUDE (body);


statement ok
INSERT INTO ssx SELECT i, 'word' || (i % 7)::VARCHAR FROM range(40000) t(i);


statement ok
VACUUM (FLUSH_TABLE) ssx;


query
SELECT count(*) AS n, sum(bm25(tableoid)) AS score, sum(id) AS ids FROM ssx_idx USING SAMPLE 400 ROWS (system, 7);
----
n	score	ids
400	0	8008000


query
SELECT count(*) AS n, sum(bm25(tableoid)) AS score, sum(id) AS ids FROM ssx_idx USING SAMPLE 10% (system, 7);
----
n	score	ids
2048	0	52427776


# A row group whose rows are all deleted is no partition: the partitions precomputed from statistics and the row
# groups a Top-N or an OFFSET skips are counted without it
statement ok
CREATE TABLE ssd (id BIGINT PRIMARY KEY, k INTEGER) WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
INSERT INTO ssd SELECT i, i FROM range(10240) t(i);


statement ok
VACUUM (FLUSH_TABLE) ssd;


statement ok
DELETE FROM ssd WHERE id < 2048;


statement ok
DELETE FROM ssd WHERE id = 5000;


query
SELECT count(*) AS n, min(k) AS lo, max(k) AS hi FROM ssd WHERE k >= 1000;
----
n	lo	hi
8191	2048	10239


query
EXPLAIN SELECT count(*), min(k), max(k) FROM ssd WHERE k >= 1000;
