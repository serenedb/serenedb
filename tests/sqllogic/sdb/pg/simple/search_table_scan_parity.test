control substitution on

statement ok
CREATE TABLE ssp (id BIGINT PRIMARY KEY, k INTEGER, s TEXT, t TEXT)
  WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
SET threads = 1


statement ok
INSERT INTO ssp
SELECT i, 40000 - i, CASE WHEN i % 3 = 0 THEN '' ELSE 'v' || i::VARCHAR END, lpad((40000 - i)::VARCHAR, 6, '0')
FROM range(40000) t(i);


statement ok
VACUUM (FLUSH_TABLE) ssp;


statement ok
SET threads = 4


statement ok
SET enable_profiling = 'json'


statement ok
SET profiling_output = '${__TEST_DIR__}/ssp_limit.json'


query
