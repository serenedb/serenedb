statement ok
DELETE FROM ssp WHERE id % 3 = 0;


query
SELECT count(*) AS n, sum(k) AS s, count(*) FILTER (WHERE (40000 - k) % 3 = 0) AS deleted
FROM (SELECT k FROM ssp USING SAMPLE 400 ROWS (system, 7));
----
n	s	deleted
400	7994974	0


# A sample keeps the same rows whether the scan reads a column or only counts rows
statement ok
CREATE TABLE ssr (id BIGINT PRIMARY KEY, k INTEGER) WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
INSERT INTO ssr SELECT i, i FROM range(40000) t(i);


statement ok
VACUUM (FLUSH_TABLE) ssr;


