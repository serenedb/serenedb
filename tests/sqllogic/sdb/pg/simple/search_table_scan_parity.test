# A sample of fewer rows than vectors skips whole vectors
query
SELECT count(*) AS n FROM ssp USING SAMPLE 5 ROWS (system, 7);
----
n
5


query
SELECT count(*) AS n, sum(k) AS s FROM (SELECT k FROM ssp USING SAMPLE 5 ROWS (system, 7));
----
n	s
5	91865


# A Top-N over a sample orders the sampled rows, not the table
query
SELECT k FROM ssp USING SAMPLE 10% (system, 7) ORDER BY k LIMIT 3;
----
k
13377
13378
13379


