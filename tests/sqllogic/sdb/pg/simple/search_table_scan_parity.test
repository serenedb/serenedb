# A caller's filter that can throw enters the scan of a secure view's table behind the view's own filter only: the
# scan evaluates it on the rows the view keeps, never on the other owners' notes it would fail on
statement ok
CREATE TABLE notes (id BIGINT PRIMARY KEY, owner INTEGER, note TEXT)
  WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
INSERT INTO notes
SELECT i, i % 2, CASE WHEN i % 2 = 0 THEN i::VARCHAR ELSE 'secret ' || i::VARCHAR END
FROM range(10000) t(i);


statement ok
VACUUM (FLUSH_TABLE) notes;


statement ok
CREATE SECURE VIEW own_notes AS SELECT * FROM notes WHERE owner = 0;


query
SELECT count(*) AS n FROM own_notes WHERE note::INTEGER >= 100;
----
n
4950


statement error
SELECT count(*) FROM notes WHERE note::INTEGER >= 100;
----
db error: ERROR: Could not convert string 'secret <slt:ignore>
