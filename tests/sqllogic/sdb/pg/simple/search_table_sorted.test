CREATE TABLE srt (k INTEGER, ts TIMESTAMP, body VARCHAR, n INTEGER)
  SORTED BY (k DESC, ts)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

query
SELECT split_part(sql, ' WITH', 1) AS definition FROM duckdb_tables() WHERE table_name = 'srt';
----
definition
CREATE TABLE public.srt(k INTEGER, ts TIMESTAMP, body VARCHAR, n INTEGER) SORTED BY (k DESC NULLS FIRST, ts ASC NULLS LAST)

