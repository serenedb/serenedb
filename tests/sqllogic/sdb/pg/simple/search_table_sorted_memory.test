SET threads = 1;

statement ok
CREATE TABLE stm_wide (k INTEGER, payload VARCHAR) SORTED BY (k)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0, segment_memory_max = 1048576);

statement ok
INSERT INTO stm_wide SELECT i, repeat('x', 20000) FROM range(0, 100) t(i);

statement ok
INSERT INTO stm_wide SELECT i, repeat('x', 20000) FROM range(100, 200) t(i);

statement ok
INSERT INTO stm_wide SELECT i, repeat('x', 20000) FROM range(200, 300) t(i);

statement ok
INSERT INTO stm_wide SELECT i, repeat('x', 20000) FROM range(300, 400) t(i);

statement ok
VACUUM (REFRESH_TABLE) stm_wide;

query
SELECT count(*) AS segments, sum(docs) AS docs, max(docs) AS largest FROM sdb_segments('stm_wide');
----
segments	docs	largest
4	400	100

