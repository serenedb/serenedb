CREATE TABLE srtn_list (id INTEGER, k INTEGER[])
  SORTED BY (k)
  WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0);

statement ok
INSERT INTO srtn_list SELECT i, CASE WHEN i = 4321 THEN NULL ELSE [i % 7, (i * 7919) % 5000] END FROM range(5000) t(i);

statement ok
VACUUM (REFRESH_TABLE) srtn_list;

statement ok
INSERT INTO srtn_list SELECT i, [i % 7, i] FROM range(5000, 7000) t(i);

statement ok
VACUUM (REFRESH_TABLE) srtn_list;

query
SELECT count(DISTINCT rowid >> 32) > 1 AS several_segments FROM srtn_list;
----
several_segments
t

statement ok
VACUUM (COMPACT_TABLE) srtn_list;

query
SELECT count(DISTINCT rowid >> 32) AS segments, count(*) AS n, count(*) FILTER (WHERE k IS NULL) AS null_keys FROM srtn_list;
----
segments	n	null_keys
1	7000	1

query
SELECT count(*) AS wrong FROM srtn_list
WHERE k IS DISTINCT FROM CASE WHEN id = 4321 THEN NULL WHEN id < 5000 THEN [id % 7, (id * 7919) % 5000] ELSE [id % 7, id] END;
----
wrong
0

query
SELECT count(*) AS misplaced FROM (
  SELECT row_number() OVER (ORDER BY rowid) AS physical,
         row_number() OVER (ORDER BY k ASC NULLS LAST) AS logical
  FROM srtn_list) WHERE physical <> logical;
----
misplaced
