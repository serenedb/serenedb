outcome	inputs
merged	1024

query
SELECT bool_and(outcome = 'merged') AS merged, max(cardinality(inputs)) AS widest FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'sts_background') AND type = 'merge';
----
merged	widest
t	1024

