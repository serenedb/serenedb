CREATE TABLE stmar_ndv (id BIGINT, v BIGINT) WITH (compaction_interval = 0)

statement ok
CREATE INDEX stmar_ndv_idx ON stmar_ndv USING inverted (id)
  INCLUDE (v included (distinct = 'exact'))

statement ok
INSERT INTO stmar_ndv VALUES (1, 1), (2, 2), (3, 3)

statement ok
VACUUM (FLUSH_TABLE) stmar_ndv

statement ok
INSERT INTO stmar_ndv VALUES (4, 4), (5, 5)

statement ok
VACUUM (FLUSH_TABLE) stmar_ndv

query
SELECT (stats(v)).approx_unique::BIGINT AS ndv FROM stmar_ndv LIMIT 1
----
ndv
5

statement ok
