# The same bound over a sorted text dictionary: t is v as text of five digits, so it sorts like v. Each vector resolves the
# bound of its moment on the dictionary: the first frame's 16,384 rows, then one vector from each of the other two.
statement ok
CREATE TABLE topn_text (id INTEGER PRIMARY KEY,
                        t TEXT USING COMPRESSION dict_fsst)
  WITH (compaction_interval = 0);


statement ok
INSERT INTO topn_text SELECT id, lpad(v::TEXT, 5, '0') FROM topn_bound;


statement ok
VACUUM (FLUSH_TABLE) topn_text;


query
SELECT compression, count(*) AS segments, sum(count) AS rows
FROM pragma_storage_info('topn_text')
WHERE column_name = 't' AND segment_type <> 'VALIDITY'
GROUP BY ALL;
----
compression	segments	rows
DICT_FSST	1	49152


query
SELECT t FROM topn_text ORDER BY t DESC LIMIT 1;
----
t
50000


query
EXPLAIN ANALYZE SELECT t FROM topn_text ORDER BY t DESC LIMIT 1;
----
