CREATE TABLE tnf_gap (id BIGINT, ts BIGINT, k TEXT)
WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
SET threads = 1


statement ok
INSERT INTO tnf_gap SELECT i, CASE WHEN i / 2048 <> 3 THEN i END,
  CASE WHEN i % 4 = 0 THEN 'even' ELSE 'odd' END
FROM range(0, 10240) t(i);


statement ok
VACUUM (FLUSH_TABLE) tnf_gap;


statement ok
RESET threads


