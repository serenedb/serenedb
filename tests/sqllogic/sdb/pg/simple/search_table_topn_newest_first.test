statement ok
CREATE TABLE tnf_vec (id BIGINT, ts TIMESTAMP, v BIGINT, emb FLOAT[2])
WITH (compaction_interval = 0, row_group_size = 2048);


statement ok
CREATE INDEX tnf_vec_emb ON tnf_vec USING inverted(emb hnsw (metric = 'l2'));


statement ok
SET threads = 1


statement ok
INSERT INTO tnf_vec SELECT i, TIMESTAMP '2026-01-01 00:00:00' + i * INTERVAL '1 second', 100000 - i,
  [(i % 50)::FLOAT, (i % 37)::FLOAT]::FLOAT[2]
FROM range(0, 20480) t(i);


statement ok
VACUUM (FLUSH_TABLE) tnf_vec;


statement ok
RESET threads


statement ok
SET sdb_ann_force_exact = true


