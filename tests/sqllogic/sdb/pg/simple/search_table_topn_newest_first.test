CREATE TABLE tnf_idx (id BIGINT, ts TIMESTAMP, body TEXT)
WITH (compaction_interval = 0, row_group_size = 32768);


statement ok
CREATE INDEX tnf_idx_body ON tnf_idx USING inverted(body);


statement ok
SET threads = 1


statement ok
INSERT INTO tnf_idx SELECT i, TIMESTAMP '2026-01-01 00:00:00' + i * INTERVAL '1 second',
  CASE WHEN i % 3 = 0 THEN 'alpha' ELSE 'gamma' END
FROM range(0, 98304) t(i);


statement ok
VACUUM (FLUSH_TABLE) tnf_idx;


statement ok
RESET threads


query
