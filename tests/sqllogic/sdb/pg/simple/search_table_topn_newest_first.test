statement ok
CREATE TABLE tnf (id BIGINT, ts TIMESTAMP, k TEXT, v BIGINT)
WITH (compaction_interval = 0, row_group_size = 32768);


statement ok
SET threads = 1


statement ok
INSERT INTO tnf SELECT i,
  CASE WHEN i % 997 <> 5 THEN TIMESTAMP '2026-01-01 00:00:00' + (i - i % 3) * INTERVAL '1 second' END,
  CASE WHEN i % 5 = 0 THEN 'cart' ELSE 'other' END,
  (i * 7919) % 100003
FROM range(0, 100000) t(i);


statement ok
VACUUM (FLUSH_TABLE) tnf;


statement ok
INSERT INTO tnf SELECT i,
  CASE WHEN i % 997 <> 5 THEN TIMESTAMP '2026-01-01 00:00:00' + (i - i % 3) * INTERVAL '1 second' END,
  CASE WHEN i % 5 = 0 THEN 'cart' ELSE 'other' END,
  (i * 7919) % 100003
FROM range(100000, 150000) t(i);


statement ok
VACUUM (FLUSH_TABLE) tnf;


statement ok
RESET threads


