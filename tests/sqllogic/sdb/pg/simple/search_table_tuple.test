statement ok
CREATE TABLE tuple_search WITH (storage = 'search', refresh_interval = 0, compaction_interval = 0) AS
SELECT id::INTEGER AS id, payload
FROM (VALUES (1, ROW('alpha', 10)), (2, NULL), (3, ROW(NULL, 30)), (4, ROW('delta', NULL))) AS v(id, payload);

statement ok
VACUUM (REFRESH_TABLE) tuple_search;

query
SELECT id, payload[1] AS name, payload[2] AS score FROM tuple_search ORDER BY id;
----
id	name	score
1	alpha	10
2	NULL	NULL
3	NULL	30
4	delta	NULL

query
SELECT id FROM tuple_search WHERE payload IS NULL ORDER BY id;
----
id
2

query
SELECT id FROM tuple_search WHERE payload IS NOT NULL ORDER BY id;
----
id
1
3
4

query
SELECT id FROM tuple_search WHERE payload = ROW('alpha', 10) ORDER BY id;
----
id
1

query
SELECT column_path, segment_type FROM pragma_storage_info('tuple_search') WHERE column_name = 'payload' ORDER BY column_path, segment_type;
----
column_path	segment_type
[1, 0]	VALIDITY
[1, 1]	VARCHAR
[1, 2, 0]	VALIDITY
[1, 2]	INTEGER

statement ok
DROP TABLE tuple_search;
