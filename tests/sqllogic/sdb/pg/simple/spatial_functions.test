POLYGON

query
SELECT ST_CoverageInvalidEdges_Agg(g, 0.0) IS NOT NULL AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY)) t(g);
----
