query
SELECT ST_Hilbert('POINT(1 1)'::GEOMETRY, {'min_x': 0.0, 'min_y': 0.0, 'max_x': 4.0, 'max_y': 4.0}::BOX_2D) > 0 AS v;
----
v
t

