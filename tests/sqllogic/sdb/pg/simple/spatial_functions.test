# duckdb-spatial functions that are NOT portable to PostGIS, so they cannot live
# in any/pg/geometry/. Three reasons appear here:
#
#   * DuckDB-only names or semantics -- ST_Hilbert, ST_QuadKey, ST_Extent_Approx,
#     ST_NGeometries/ST_NInteriorRings (aliases PostGIS lacks), the *_GEOS
#     suffixed variants, and the POINT_2D/LINESTRING_2D/POLYGON_2D/BOX_2D
#     struct types with their casts.
#   * Text output whose formatting diverges -- ST_AsText spacing, and
#     ST_GeometryType returning POINT where PostGIS returns ST_Point.
#   * Encodings with no PostGIS equivalent in this build -- GeoJSON, HEXWKB,
#     SVG and MVT.
#
# The PROJ and GDAL entry points are deliberately absent from this build and are
# covered by spatial_geos.test instead.

# --- scalar functions ---

query
SELECT ST_GeometryType('POINT(1 1)'::GEOMETRY)::TEXT AS v;
----
v
POINT

query
SELECT ST_AsGeoJSON('POINT(1 1)'::GEOMETRY) AS v;
----
v
{"type":"Point","coordinates":[1.0,1.0]}

query
SELECT ST_AsHEXWKB('POINT(1 1)'::GEOMETRY) AS v;
----
v
0101000000000000000000F03F000000000000F03F

query
SELECT ST_AsSVG('POINT(1 1)'::GEOMETRY, false, 15) AS v;
----
v
cx="1" cy="-1"

query
SELECT ST_AsText(ST_GeomFromHEXWKB(ST_AsHEXWKB('POINT(1 1)'::GEOMETRY))) AS v;
----
v
POINT (1 1)

query
SELECT ST_AsText(ST_GeomFromHEXEWKB(ST_AsHEXWKB('POINT(1 1)'::GEOMETRY))) AS v;
----
v
POINT (1 1)

query
SELECT ST_NGeometries('MULTIPOLYGON(((0 0,2 0,2 2,0 2,0 0)),((3 3,5 3,5 5,3 5,3 3)))'::GEOMETRY) AS v;
----
v
2

query
SELECT ST_NInteriorRings('POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,4 2,4 4,2 4,2 2))'::GEOMETRY) AS v;
----
v
1

query
SELECT ST_ZMFlag('POINT ZM(1 2 3 4)'::GEOMETRY) AS v;
----
v
3

query
SELECT ST_MMin('POINT ZM(1 2 3 4)'::GEOMETRY) AS v;
----
v
