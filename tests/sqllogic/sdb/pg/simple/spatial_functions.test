# --- aggregates ---

query
SELECT ST_Extent_Agg(g)::TEXT AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY), ('POINT(1 1)'::GEOMETRY)) t(g);
----
v
POLYGON ((0 0, 0 4, 4 4, 4 0, 0 0))

query
SELECT ST_AsText(ST_Envelope_Agg(g)) AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY), ('POINT(1 1)'::GEOMETRY)) t(g);
----
v
POLYGON ((0 0, 0 4, 4 4, 4 0, 0 0))

query
SELECT ST_Area(ST_Union_Agg(g)) AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY), ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY)) t(g);
----
v
16

query
SELECT ST_Area(ST_MemUnion_Agg(g)) AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY), ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY)) t(g);
----
v
16

query
SELECT ST_Area(ST_Intersection_Agg(g)) AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY), ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY)) t(g);
----
v
16

query
SELECT ST_GeometryType(ST_CoverageUnion_Agg(g))::TEXT AS v FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0))'::GEOMETRY)) t(g);
----
