SELECT round(ST_Area_Spheroid('POLYGON((0 0,1 0,1 1,0 1,0 0))'::GEOMETRY))::BIGINT AS v;
----
v
12308778361

query
SELECT round(ST_Perimeter_Spheroid('POLYGON((0 0,1 0,1 1,0 1,0 0))'::GEOMETRY))::BIGINT AS v;
----
v
443771

query
SELECT round(ST_Length_Spheroid('LINESTRING(0 0,1 1)'::GEOMETRY))::BIGINT AS v;
----
v
156900

query
SELECT round(ST_Distance_Spheroid('POINT(0 0)'::GEOMETRY,'POINT(1 1)'::GEOMETRY))::BIGINT AS v;
----
v
156900

query
SELECT ST_DWithin_Spheroid('POINT(0 0)'::GEOMETRY,'POINT(1 1)'::GEOMETRY,200000) AS v;
----
v
t

query
SELECT DuckDB_Proj_Version() AS v;
----
v
9.3.1

query
SELECT DuckDB_PROJ_Compiled_Version() AS v;
----
v
Rel. 9.3.1, December 1st, 2023

# --- GDAL module: ST_Read / ST_Read_Meta over a real GeoJSON fixture ---
#
# GDAL is built with GDAL_BUILD_OPTIONAL_DRIVERS=OFF, so only the allowlisted
# drivers exist (pinned in spatial_geos.test). GeoJSON is one of them.

control substitution on

query
SELECT count(*) AS v FROM ST_Read('${RESOURCES}/tests/spatial/points.geojson');
----
v
3

query
SELECT name, ST_AsText(geom) AS wkt
FROM ST_Read('${RESOURCES}/tests/spatial/points.geojson')
ORDER BY name;
----
name	wkt
alpha	POINT (1 2)
beta	POINT (3 4)
gamma	POINT (5 6)

query
SELECT count(*) AS v
FROM ST_Read_Meta('${RESOURCES}/tests/spatial/points.geojson');
----
v
1

query
SELECT round(sum(n))::BIGINT AS v
FROM ST_Read('${RESOURCES}/tests/spatial/points.geojson');
----
v
6

# An existing file that no enabled driver can open must report an error, not
# return an empty result. Upstream skipped it via a try/catch that never fired
# (GDALDataset::Open returns nullptr instead of throwing), so this dereferenced
# null and killed the server. The message is GDAL's own, so only the failure is
# pinned here -- it embeds an absolute path.

query error
SELECT * FROM ST_Read_Meta('${RESOURCES}/tests/spatial/not-spatial.txt');

query error
SELECT * FROM ST_Read('${RESOURCES}/tests/spatial/not-spatial.txt');

# A path that matches nothing is the same error every other reader gives
# (read_csv, read_parquet). Upstream globbed with FileGlobOptions::ALLOW_EMPTY,
# which made ST_Read_Meta the one reader that answered a typo with zero rows.

query error
SELECT * FROM ST_Read_Meta('/nonexistent-sdb-spatial.geojson');
----
db error: ERROR: No files found that match the pattern "/nonexistent-sdb-spatial.geojson"


query error
SELECT * FROM ST_Read_Meta('/nonexistent-sdb-spatial-dir/*.geojson');
----
db error: ERROR: No files found that match the pattern "/nonexistent-sdb-spatial-dir/*.geojson"


# A glob that does match still reads, so the stricter option did not break globbing.

query
SELECT count(*) AS v FROM ST_Read_Meta('${RESOURCES}/tests/spatial/*.geojson');
----
v
1
