# --- table functions ---

query
SELECT count(*) AS v FROM ST_GeneratePoints({'min_x': 0.0, 'min_y': 0.0, 'max_x': 10.0, 'max_y': 10.0}::BOX_2D, 5, 42);
----
v
5

