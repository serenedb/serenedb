CREATE FUNCTION sfn_dbl(x double precision) RETURNS double precision LANGUAGE sql AS 'SELECT x + x'

query
SELECT sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(i::double precision)))))))))))))))))))))))) AS r FROM range(2) t(i) ORDER BY 1
----
r
0
16777216

