PREPARE sfn_nested AS SELECT sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(sfn_dbl(i::double precision)))))))))))))))))))))))) AS r FROM range(2) t(i) ORDER BY 1

query
