statement ok
CREATE FUNCTION sfn_ts_struct_s(x bigint) RETURNS STRUCT(t TIMESTAMP_S) LANGUAGE sql RETURN {'t': make_timestamp_ns(x)}

statement ok
CREATE FUNCTION sfn_ts_struct_ms(x bigint) RETURNS STRUCT(t TIMESTAMP_MS) LANGUAGE sql RETURN {'t': make_timestamp_ns(x)}

statement ok
CREATE FUNCTION sfn_ts_struct_ns(x bigint) RETURNS STRUCT(t TIMESTAMP_NS) LANGUAGE sql RETURN {'t': make_timestamp(x)}

statement ok
CREATE MACRO sfn_pick_struct(s STRUCT(t TIMESTAMP)) AS (SELECT 'struct' WHERE s IS NOT NULL), (s VARCHAR) AS (SELECT 'text' WHERE s IS NOT NULL)

statement ok
CREATE FUNCTION sfn_void() RETURNS void LANGUAGE sql AS 'SELECT 1'

query
SELECT sfn_pick_num(sfn_num(1.5)) AS n, sfn_pick_struct(sfn_ts_struct_s(1)) AS s, sfn_pick_struct(sfn_ts_struct_ms(1)) AS ms, sfn_pick_struct(sfn_ts_struct_ns(1)) AS ns, sfn_pick_num(sfn_void()) IS NULL AS v
----
n	s	ms	ns	v
numeric	struct	struct	struct	t

statement ok
RESET statement_timeout

