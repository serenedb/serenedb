CREATE FUNCTION sfn_vec(v double precision[]) RETURNS double precision[] LANGUAGE sql AS 'SELECT ARRAY[v[1] + v[2], v[2] + v[3], v[3] + v[1]]'

query
SELECT sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(sfn_vec(ARRAY[i::double precision, 1.0, 2.0])))))))))))))))) AS r FROM range(1) t(i)
----
r
{65537,65535,65536}

statement ok
CREATE FUNCTION sfn_rand() RETURNS double precision LANGUAGE sql AS 'SELECT random()'

query
SELECT count(DISTINCT sfn_rand()) > 1 AS r FROM range(100)
----
r
t

statement ok
CREATE FUNCTION sfn_window(x int) RETURNS bigint LANGUAGE sql AS 'SELECT row_number() OVER ()'

query
SELECT sfn_window(7) AS r
----
r
1

query
SELECT proname, prosrc FROM pg_proc WHERE proname IN ('sfn_dbl', 'sfn_window') ORDER BY 1
----
proname	prosrc
sfn_dbl	SELECT x + x
sfn_window	SELECT row_number() OVER ()

