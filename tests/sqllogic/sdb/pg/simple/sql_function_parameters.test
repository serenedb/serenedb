statement ok
CREATE FUNCTION sfp_fixed(OUT a INTEGER[3]) RETURNS INTEGER[3] LANGUAGE sql AS 'SELECT [1, 2, 3]::INTEGER[3]';


query
SELECT sfp_fixed() AS a;
----
a
{1,2,3}


statement ok
DROP FUNCTION sfp_fixed;


