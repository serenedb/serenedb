CREATE TABLE ref_a AS
SELECT 'subquery date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT date_trunc('hour', ts) AS k, v FROM g) GROUP BY k)
UNION ALL SELECT 'cte date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (WITH x AS (SELECT date_trunc('hour', ts) AS k, v FROM g) SELECT k, count(*) AS c, sum(v) AS s FROM x GROUP BY k)
UNION ALL SELECT 'cte chain date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (WITH x AS (SELECT date_trunc('hour', ts) AS k, v FROM g), y AS (SELECT * FROM x) SELECT k, count(*) AS c, sum(v) AS s FROM y GROUP BY k)
UNION ALL SELECT 'filtered subquery date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT date_trunc('hour', ts) AS k, v FROM g) WHERE v > 100 GROUP BY k)
UNION ALL SELECT 'subquery filter inside date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT date_trunc('hour', ts) AS k, v FROM g WHERE v % 3 = 0) GROUP BY k)
UNION ALL SELECT 'multi ref date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT date_trunc('hour', ts) AS k, v FROM g) GROUP BY k HAVING min(k) IS NOT NULL OR min(k) IS NULL)
UNION ALL SELECT 'alias reused date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT date_trunc('hour', ts) AS k, date_trunc('hour', ts) AS k2, v FROM g) GROUP BY k)
UNION ALL SELECT 'select star date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT *, date_trunc('hour', ts) AS k FROM g) GROUP BY k)
UNION ALL SELECT 'union all date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, count(*) AS c, sum(v) AS s FROM (SELECT date_trunc('hour', ts) AS k, v FROM g UNION ALL SELECT date_trunc('hour', ts), v FROM g) GROUP BY k)
UNION ALL SELECT 'distinct date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, 1 AS c, 0 AS s FROM (SELECT DISTINCT date_trunc('hour', ts) AS k FROM g))
UNION ALL SELECT 'distinct alias date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, 1 AS c, 0 AS s FROM (SELECT DISTINCT k FROM (SELECT date_trunc('hour', ts) AS k, v FROM g)))
UNION ALL SELECT 'distinct filtered date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, 1 AS c, 0 AS s FROM (SELECT DISTINCT date_trunc('hour', ts) AS k FROM g WHERE v > 100))
UNION ALL SELECT 'distinct ordered date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, 1 AS c, 0 AS s FROM (SELECT DISTINCT date_trunc('hour', ts) AS k FROM g ORDER BY k))
UNION ALL SELECT 'distinct on date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, 1 AS c, 0 AS s FROM (SELECT DISTINCT ON (date_trunc('hour', ts)) date_trunc('hour', ts) AS k FROM g ORDER BY date_trunc('hour', ts)))
UNION ALL SELECT 'distinct with sev date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, 1 AS c, 0 AS s FROM (SELECT DISTINCT date_trunc('hour', ts) AS k1, sev AS k2 FROM g))
