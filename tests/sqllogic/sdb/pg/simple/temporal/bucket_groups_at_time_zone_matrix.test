UNION ALL SELECT 'America/St_Johns sf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz AT TIME ZONE 'America/St_Johns', '%Y-%m-%d %H') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns sf month' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz AT TIME ZONE 'America/St_Johns', '%Y-%m') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns label' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(tstz AT TIME ZONE 'America/St_Johns') || '-Q' || quarter(tstz AT TIME ZONE 'America/St_Johns') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns naive to tz hour' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts AT TIME ZONE 'America/St_Johns') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns naive to tz day date' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (ts AT TIME ZONE 'America/St_Johns')::DATE AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns double' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', (ts AT TIME ZONE 'UTC') AT TIME ZONE 'America/St_Johns') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns epoch' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz AT TIME ZONE 'America/St_Johns') / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'America/St_Johns monthname' AS shape, k::VARCHAR AS k, c, s FROM (SELECT monthname(tstz AT TIME ZONE 'America/St_Johns') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1);

