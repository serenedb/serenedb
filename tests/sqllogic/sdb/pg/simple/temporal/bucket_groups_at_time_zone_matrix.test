statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE g AS SELECT tstz, (tstz AT TIME ZONE 'UTC')::TIMESTAMP AS ts, v FROM (SELECT TIMESTAMPTZ '2025-03-07 00:00:00+00' + INTERVAL (i * 53) MINUTE AS tstz, i AS v FROM range(0, 1500) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 53) MINUTE, 10000 + i FROM range(0, 1500) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-12-30 12:00:00+00' + INTERVAL (i * 53) MINUTE, 20000 + i FROM range(0, 300) t(i) UNION ALL SELECT TIMESTAMPTZ '1969-12-25 00:00:00+00' + INTERVAL (i * 173) MINUTE, 30000 + i FROM range(0, 600) t(i));

statement ok
INSERT INTO g VALUES (NULL, NULL, -1), (TIMESTAMPTZ 'infinity', TIMESTAMP 'infinity', -2);

statement ok
CREATE TABLE gf AS SELECT * FROM g WHERE isfinite(tstz) OR tstz IS NULL;

statement ok
CREATE TABLE g25 AS SELECT * FROM gf WHERE v BETWEEN 0 AND 19999;

statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_1 AS
SELECT 'UTC dt hour' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC dt hour inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC dt day' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC dt day inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC dt week' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('week', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC dt week inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('week', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC dt month' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('month', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC dt month inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('month', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC dt quarter' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('quarter', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC dt quarter inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('quarter', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC dt year' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('year', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC dt year inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('year', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC date' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (tstz AT TIME ZONE 'UTC')::DATE AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC date inf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (tstz AT TIME ZONE 'UTC')::DATE AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'UTC timezone day' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', timezone('UTC', tstz)) AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC tb 6h' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '6 hours', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC tb 1d' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC sf' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz AT TIME ZONE 'UTC', '%Y-%m-%d %H') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC sf month' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz AT TIME ZONE 'UTC', '%Y-%m') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC label' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(tstz AT TIME ZONE 'UTC') || '-Q' || quarter(tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC naive to tz hour' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC naive to tz day date' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (ts AT TIME ZONE 'UTC')::DATE AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC double' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', (ts AT TIME ZONE 'UTC') AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC epoch' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz AT TIME ZONE 'UTC') / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
UNION ALL SELECT 'UTC monthname' AS shape, k::VARCHAR AS k, c, s FROM (SELECT monthname(tstz AT TIME ZONE 'UTC') AS k, count(*) AS c, sum(v) AS s FROM gf GROUP BY 1)
