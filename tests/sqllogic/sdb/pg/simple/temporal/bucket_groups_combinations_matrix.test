UNION ALL SELECT 'date_trunc(''hour'', ts)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('hour', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''hour'', tstz)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('hour', tstz)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''hour'', ts)::TIME @cmbn' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('hour', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmbn GROUP BY 1)
UNION ALL SELECT 'date_trunc(''day'', ts)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('day', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''day'', tstz)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('day', tstz)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''day'', ts)::TIME @cmbn' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('day', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmbn GROUP BY 1)
UNION ALL SELECT 'date_trunc(''month'', ts)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('month', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''month'', tstz)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('month', tstz)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''month'', ts)::TIME @cmbn' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('month', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmbn GROUP BY 1)
UNION ALL SELECT 'ts::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT ts::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'tstz::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT tstz::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'time_bucket(INTERVAL ''15 minutes'', ts)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', ts)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'time_bucket(INTERVAL ''15 minutes'', tstz)::TIME @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz)::TIME AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'floor(epoch(tstz) / 3600) * 3600 @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT floor(epoch(tstz) / 3600) * 3600 AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''day'', tstz)::DATE @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('day', tstz)::DATE AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'last_day(tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT last_day(tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1);

