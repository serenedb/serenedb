query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes, (SELECT count(*) FROM (SELECT * FROM ref_cmb EXCEPT ALL SELECT * FROM got_cmb)) AS ref_minus_got, (SELECT count(*) FROM (SELECT * FROM got_cmb EXCEPT ALL SELECT * FROM ref_cmb)) AS got_minus_ref FROM ref_cmb;
