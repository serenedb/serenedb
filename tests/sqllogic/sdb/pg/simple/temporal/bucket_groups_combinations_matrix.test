UNION ALL SELECT 'date_trunc(''milliseconds'', d) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('milliseconds', d) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
