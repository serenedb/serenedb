SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE cmb AS SELECT TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE AS ts, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS tstz, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::DATE AS d, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMP_NS AS tns, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMP_MS AS tms, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMP_S AS tsec, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIME AS tm, i AS v FROM range(600) t(i);

statement ok
CREATE TABLE cmbn AS SELECT TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 3) MILLISECOND AS ts, (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 3) MILLISECOND)::TIMESTAMPTZ AS tstz, (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 3) MILLISECOND)::TIME AS tm, i AS v FROM range(600) t(i);

statement ok
CREATE TABLE cmbw AS SELECT TIMESTAMP '2019-02-27 23:30:00' + INTERVAL (i * 41) HOUR AS ts, (TIMESTAMP '2019-02-27 23:30:00' + INTERVAL (i * 41) HOUR)::TIMESTAMPTZ AS tstz, (TIMESTAMP '2019-02-27 23:30:00' + INTERVAL (i * 41) HOUR)::DATE AS d, i AS v FROM range(600) t(i);

statement ok
CREATE TABLE cmbx AS SELECT ts, ts::TIMESTAMPTZ AS tstz, v FROM (VALUES (TIMESTAMP '2025-03-30 01:59:59.999999', 1), (TIMESTAMP '2025-03-30 02:00:00', 2), (TIMESTAMP '2025-10-26 02:30:00', 3), (TIMESTAMP '1969-12-31 23:59:59.999999', 4), (TIMESTAMP '1970-01-01 00:00:00', 5), (TIMESTAMP '1900-01-01 00:00:00', 6), (TIMESTAMP '2299-12-31 00:00:00', 7), (NULL, 8)) t(ts, v);

statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
SET disabled_optimizers = 'compressed_materialization';

