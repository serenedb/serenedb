CREATE OR REPLACE TABLE ref_cmb AS
SELECT 'date_trunc(''microseconds'', ts) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', ts) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', d) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', d) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', tns) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', tns) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', tms) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', tms) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', tsec) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', tsec) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', ts) @cmbn' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', ts) AS k0, count(*) AS c, sum(v) AS s FROM cmbn GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', ts) @cmbw' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', ts) AS k0, count(*) AS c, sum(v) AS s FROM cmbw GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', d) @cmbw' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', d) AS k0, count(*) AS c, sum(v) AS s FROM cmbw GROUP BY 1)
