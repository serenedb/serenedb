INSERT INTO got_cmb
SELECT 'dayname(tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT dayname(tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'monthname(tstz) || '' '' || year(tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT monthname(tstz) || ' ' || year(tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''hour'', ts AT TIME ZONE ''America/Havana'') @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('hour', ts AT TIME ZONE 'America/Havana') AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''day'', timezone(''Asia/Kolkata'', tstz)) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('day', timezone('Asia/Kolkata', tstz)) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'strftime(tstz, ''%H:%M'') @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT strftime(tstz, '%H:%M') AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'strftime(tstz, ''%H'') @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT strftime(tstz, '%H') AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'year(tstz), month(tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') || '|' || coalesce(k1::VARCHAR, 'null') AS k, c, s FROM (SELECT year(tstz) AS k0, month(tstz) AS k1, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1, 2)
UNION ALL SELECT 'date_trunc(''month'', tstz), date_trunc(''day'', tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') || '|' || coalesce(k1::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('month', tstz) AS k0, date_trunc('day', tstz) AS k1, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1, 2);

