SELECT 'dayname(tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT dayname(tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
