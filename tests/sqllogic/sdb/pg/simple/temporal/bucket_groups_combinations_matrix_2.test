UNION ALL SELECT 'date_trunc(''month'', tstz), date_trunc(''day'', tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') || '|' || coalesce(k1::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('month', tstz) AS k0, date_trunc('day', tstz) AS k1, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1, 2);

