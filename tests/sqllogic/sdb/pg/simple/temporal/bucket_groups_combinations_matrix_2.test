CREATE OR REPLACE TABLE ref_cmb AS
SELECT 'date_trunc(''microseconds'', tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''microseconds'', tstz) @cmbx' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('microseconds', tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmbx GROUP BY 1)
UNION ALL SELECT 'date_trunc(''milliseconds'', tstz) @cmb' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('milliseconds', tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmb GROUP BY 1)
UNION ALL SELECT 'date_trunc(''milliseconds'', tstz) @cmbx' AS shape, coalesce(k0::VARCHAR, 'null') AS k, c, s FROM (SELECT date_trunc('milliseconds', tstz) AS k0, count(*) AS c, sum(v) AS s FROM cmbx GROUP BY 1)
