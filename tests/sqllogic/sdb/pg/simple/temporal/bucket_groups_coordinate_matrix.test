SET TimeZone = 'Africa/Monrovia';

query
SELECT 'Africa/Monrovia', date_trunc('day', TIMESTAMPTZ '2025-06-15 12:00:00+00')::VARCHAR, (TIMESTAMPTZ '2025-06-15 12:00:00+00')::DATE::VARCHAR, strftime(TIMESTAMPTZ '2025-06-15 12:00:00+00', '%Y-%m-%d %H:%M %z'), count(*) FROM (SELECT year(tstz), month(tstz), count(*) FROM dst GROUP BY 1, 2);
----
?column?	date_trunc	text	strftime	count
Africa/Monrovia	2025-06-15 00:00:00+00	2025-06-15	2025-06-15 12:00 +00	6

statement ok
