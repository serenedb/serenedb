UNION ALL SELECT 'tstz year(tstz), quarter(tstz), month(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, quarter(tstz) AS k2, month(tstz) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'tstz year(tstz)::VARCHAR, month(tstz)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz)::VARCHAR AS k1, month(tstz)::VARCHAR AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
