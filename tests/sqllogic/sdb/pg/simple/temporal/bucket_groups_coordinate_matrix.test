SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE g AS SELECT TIMESTAMP '2023-11-28 00:00:00' + INTERVAL (i * 17) MINUTE AS ts, (TIMESTAMP '2023-11-28 00:00:00' + INTERVAL (i * 17) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2023-11-28' + (i % 700)::INTEGER)::DATE AS d, (i % 5)::SMALLINT AS sev, i AS v FROM range(60000) t(i);

statement ok
INSERT INTO g VALUES (NULL, NULL, NULL, NULL, -1);

statement ok
CREATE TABLE dst AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 41) MINUTE AS tstz, i AS v FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 41) MINUTE, 1000 + i FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-12-31 12:00:00+00' + INTERVAL (i * 41) MINUTE, 2000 + i FROM range(0, 100) t(i));

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_c AS
SELECT 'ts year(ts), month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts month(ts), year(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT month(ts) AS k1, year(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), quarter(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, quarter(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), month(ts), day(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, day(ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'ts year(ts), month(ts), day(ts), hour(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR || '/' || k4::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, day(ts) AS k3, hour(ts) AS k4, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3, 4))
UNION ALL SELECT 'ts year(ts), month(ts), day(ts), hour(ts), minute(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR || '/' || k4::VARCHAR || '/' || k5::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, day(ts) AS k3, hour(ts) AS k4, minute(ts) AS k5, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3, 4, 5))
UNION ALL SELECT 'ts isoyear(ts), week(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT isoyear(ts) AS k1, week(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts isoyear(ts), week(ts), isodow(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT isoyear(ts) AS k1, week(ts) AS k2, isodow(ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'ts year(ts), dayofyear(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, dayofyear(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), monthname(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, monthname(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), month(ts), dayname(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, dayname(ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'ts strftime(ts, ''%Y''), month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y') AS k1, month(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts date_part(''year'', ts), date_part(''month'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT date_part('year', ts) AS k1, date_part('month', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts extract(year FROM ts), extract(month FROM ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT extract(year FROM ts) AS k1, extract(month FROM ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), strftime(ts, ''%m'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, strftime(ts, '%m') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), week(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, week(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), month(ts), hour(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, hour(ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'ts month(ts), day(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT month(ts) AS k1, day(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), decade(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, decade(ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts decade(ts), year(ts), month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT decade(ts) AS k1, year(ts) AS k2, month(ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'ts year(ts), quarter(ts), month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, quarter(ts) AS k2, month(ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'ts year(ts)::VARCHAR, month(ts)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts)::VARCHAR AS k1, month(ts)::VARCHAR AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'ts year(ts), month(ts), sev' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, sev AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'tstz year(tstz), month(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz month(tstz), year(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT month(tstz) AS k1, year(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), quarter(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, quarter(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), month(tstz), day(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, day(tstz) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'tstz year(tstz), month(tstz), day(tstz), hour(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR || '/' || k4::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, day(tstz) AS k3, hour(tstz) AS k4, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3, 4))
UNION ALL SELECT 'tstz year(tstz), month(tstz), day(tstz), hour(tstz), minute(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR || '/' || k4::VARCHAR || '/' || k5::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, day(tstz) AS k3, hour(tstz) AS k4, minute(tstz) AS k5, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3, 4, 5))
UNION ALL SELECT 'tstz isoyear(tstz), week(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT isoyear(tstz) AS k1, week(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz isoyear(tstz), week(tstz), isodow(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT isoyear(tstz) AS k1, week(tstz) AS k2, isodow(tstz) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'tstz year(tstz), dayofyear(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, dayofyear(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), monthname(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, monthname(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), month(tstz), dayname(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, dayname(tstz) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'tstz strftime(tstz, ''%Y''), month(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT strftime(tstz, '%Y') AS k1, month(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz date_part(''year'', tstz), date_part(''month'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT date_part('year', tstz) AS k1, date_part('month', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz extract(year FROM tstz), extract(month FROM tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT extract(year FROM tstz) AS k1, extract(month FROM tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), strftime(tstz, ''%m'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, strftime(tstz, '%m') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), week(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, week(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), month(tstz), hour(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, hour(tstz) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'tstz month(tstz), day(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT month(tstz) AS k1, day(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'tstz year(tstz), decade(tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, decade(tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
