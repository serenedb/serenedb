UNION ALL SELECT 'd year(d), strftime(d, ''%m'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(d) AS k1, strftime(d, '%m') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'd year(d), week(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(d) AS k1, week(d) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'd year(d), month(d), hour(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(d) AS k1, month(d) AS k2, hour(d) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'd month(d), day(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT month(d) AS k1, day(d) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'd year(d), decade(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(d) AS k1, decade(d) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'd decade(d), year(d), month(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT decade(d) AS k1, year(d) AS k2, month(d) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'd year(d), quarter(d), month(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(d) AS k1, quarter(d) AS k2, month(d) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'd year(d)::VARCHAR, month(d)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(d)::VARCHAR AS k1, month(d)::VARCHAR AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'd year(d), month(d), sev' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(d) AS k1, month(d) AS k2, sev AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'alias' AS shape, k::VARCHAR AS k, c, s FROM (SELECT y::VARCHAR || '/' || m::VARCHAR AS k, c, s FROM (SELECT year(ts) AS y, month(ts) AS m, count(*) AS c, sum(v) AS s FROM g GROUP BY y, m))
UNION ALL SELECT 'subquery alias' AS shape, k::VARCHAR AS k, c, s FROM (SELECT y::VARCHAR || '/' || m::VARCHAR AS k, c, s FROM (SELECT y, m, count(*) AS c, sum(v) AS s FROM (SELECT year(ts) AS y, month(ts) AS m, v FROM g) GROUP BY y, m))
UNION ALL SELECT 'cte alias' AS shape, k::VARCHAR AS k, c, s FROM (WITH x AS (SELECT year(ts) AS y, month(ts) AS m, v FROM g) SELECT y::VARCHAR || '/' || m::VARCHAR AS k, c, s FROM (SELECT y, m, count(*) AS c, sum(v) AS s FROM x GROUP BY y, m))
UNION ALL SELECT 'filtered' AS shape, k::VARCHAR AS k, c, s FROM (SELECT y::VARCHAR || '/' || m::VARCHAR AS k, c, s FROM (SELECT year(ts) AS y, month(ts) AS m, count(*) AS c, sum(v) AS s FROM g WHERE v % 3 = 0 GROUP BY y, m))
UNION ALL SELECT 'distinct' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k, 1 AS c, 0 AS s FROM (SELECT DISTINCT year(ts)::VARCHAR || '/' || month(ts)::VARCHAR AS k FROM g))
UNION ALL SELECT 'distinct pair' AS shape, k::VARCHAR AS k, c, s FROM (SELECT y::VARCHAR || '/' || m::VARCHAR AS k, 1 AS c, 0 AS s FROM (SELECT DISTINCT year(ts) AS y, month(ts) AS m FROM g))
UNION ALL SELECT 'two inputs' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(d) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2))
UNION ALL SELECT 'mixed with date_trunc' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(ts) AS k1, month(ts) AS k2, date_trunc('day', ts) AS k3, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2, 3))
UNION ALL SELECT 'with having' AS shape, k::VARCHAR AS k, c, s FROM (SELECT y::VARCHAR || '/' || m::VARCHAR AS k, c, s FROM (SELECT year(ts) AS y, month(ts) AS m, count(*) AS c, sum(v) AS s FROM g GROUP BY y, m HAVING count(*) > 100))
UNION ALL SELECT 'dst year month' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2))
UNION ALL SELECT 'dst year month day' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, day(tstz) AS k3, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2, 3))
UNION ALL SELECT 'dst year month day hour' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR || '/' || k3::VARCHAR || '/' || k4::VARCHAR AS k, c, s FROM (SELECT year(tstz) AS k1, month(tstz) AS k2, day(tstz) AS k3, hour(tstz) AS k4, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2, 3, 4))
UNION ALL SELECT 'dst isoyear week' AS shape, k::VARCHAR AS k, c, s FROM (SELECT k1::VARCHAR || '/' || k2::VARCHAR AS k, c, s FROM (SELECT isoyear(tstz) AS k1, week(tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2));

