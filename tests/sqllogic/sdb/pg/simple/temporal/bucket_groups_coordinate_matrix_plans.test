statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE g AS SELECT TIMESTAMP '2023-11-28 00:00:00' + INTERVAL (i * 17) MINUTE AS ts, (TIMESTAMP '2023-11-28 00:00:00' + INTERVAL (i * 17) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2023-11-28' + (i % 700)::INTEGER)::DATE AS d, (i % 5)::SMALLINT AS sev, i AS v FROM range(60000) t(i);

statement ok
INSERT INTO g VALUES (NULL, NULL, NULL, NULL, -1);

statement ok
CREATE TABLE dst AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 41) MINUTE AS tstz, i AS v FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 41) MINUTE, 1000 + i FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-12-31 12:00:00+00' + INTERVAL (i * 41) MINUTE, 2000 + i FROM range(0, 100) t(i));

query
EXPLAIN SELECT year(ts), month(ts), count(*) FROM g GROUP BY 1, 2;
----
QUERY PLAN
╭─ PROJECTION ─────────────────────────────────────────────╮
│ Projections:                                             │
│ "year"(__internal_date_trunc_month_unbucket(#0, 1, 0)),  │
│ "month"(__internal_date_trunc_month_unbucket(#0, 1, 0)), │
│ #1                                                       │
│ ~30,000 rows                                             │
╰─────────────────────────────┬────────────────────────────╯
╭─ PERFECT_HASH_GROUP_BY ─────┴────────────────────────────╮
