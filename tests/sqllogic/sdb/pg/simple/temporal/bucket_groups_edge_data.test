SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE edge_inf AS SELECT ts, ts::TIMESTAMPTZ AS tstz, v FROM (VALUES (TIMESTAMP 'infinity', 1), (TIMESTAMP '-infinity', 2), (TIMESTAMP '2025-06-01 12:34:56', 3), (NULL, 4)) t(ts, v);

statement ok
CREATE TABLE edge_one AS SELECT TIMESTAMP '2025-06-01 12:34:56.789012' AS ts, TIMESTAMPTZ '2025-06-01 12:34:56.789012+00' AS tstz, 1 AS v;

statement ok
CREATE TABLE edge_empty AS SELECT ts, ts::TIMESTAMPTZ AS tstz, v FROM (SELECT TIMESTAMP '2025-06-01' AS ts, 1 AS v) WHERE 1 = 0;

statement ok
CREATE TABLE edge_old AS SELECT ts, ts::TIMESTAMPTZ AS tstz, v FROM (VALUES (TIMESTAMP '0001-01-01 00:00:00', 1), (TIMESTAMP '0044-03-15 12:00:00', 2), (TIMESTAMP '1000-06-06 06:06:06', 3), (TIMESTAMP '9999-12-31 23:59:59', 4), (TIMESTAMP '2025-01-01 00:00:00', 5)) t(ts, v);

statement ok
CREATE TABLE edge_dst AS SELECT ts, ts::TIMESTAMPTZ AS tstz, ts::TIME AS tm, v FROM (VALUES (TIMESTAMP '2025-03-30 01:00:00', 1), (TIMESTAMP '2025-03-30 03:00:00', 2), (TIMESTAMP '2025-10-26 02:00:00', 3), (TIMESTAMP '2025-10-26 03:00:00', 4), (TIMESTAMP '2025-06-15 12:00:00', 5)) t(ts, v);

statement ok
CREATE TABLE edge_rows AS SELECT TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 97) SECOND AS ts, (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 97) SECOND)::TIMESTAMPTZ AS tstz, (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 97) SECOND)::TIME AS tm, (i % 97)::INTEGER AS id, i AS v FROM range(3000) t(i);

query
EXPLAIN SELECT strftime(ts, '%H:%M') AS k, count(*) AS c FROM edge_inf GROUP BY 1;
