statement ok
CREATE OR REPLACE TABLE ref_edge AS
SELECT 'dt hour' AS shape, k::VARCHAR AS k, c FROM (SELECT date_trunc('hour', ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'dt day tz', k::VARCHAR, c FROM (SELECT date_trunc('day', tstz) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'tb 15 min', k::VARCHAR, c FROM (SELECT time_bucket(INTERVAL '15 minutes', ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'tb 15 min tz', k::VARCHAR, c FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'strftime hm', k::VARCHAR, c FROM (SELECT strftime(ts, '%H:%M') AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'strftime hm tz', k::VARCHAR, c FROM (SELECT strftime(tstz, '%H:%M') AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'cast time', k::VARCHAR, c FROM (SELECT date_trunc('hour', ts)::TIME AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'time column', k::VARCHAR, c FROM (SELECT time_bucket(INTERVAL '15 minutes', tm) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'monthname', k::VARCHAR, c FROM (SELECT monthname(ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'last_day tz', k::VARCHAR, c FROM (SELECT last_day(tstz) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'label', k::VARCHAR, c FROM (SELECT year(ts) || '-Q' || quarter(ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'epoch bin', k::VARCHAR, c FROM (SELECT floor(epoch(ts) / 3600) * 3600 AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'coordinates', k::VARCHAR || '|' || k2::VARCHAR, c FROM (SELECT year(ts) AS k, month(ts) AS k2, count(*) AS c FROM edge_rows GROUP BY 1, 2)
UNION ALL SELECT 'ms', k::VARCHAR, c FROM (SELECT date_trunc('millisecond', ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1);

statement ok
SET disabled_optimizers = '';

statement ok
CREATE OR REPLACE TABLE got_edge AS
SELECT 'dt hour' AS shape, k::VARCHAR AS k, c FROM (SELECT date_trunc('hour', ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'dt day tz', k::VARCHAR, c FROM (SELECT date_trunc('day', tstz) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'tb 15 min', k::VARCHAR, c FROM (SELECT time_bucket(INTERVAL '15 minutes', ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'tb 15 min tz', k::VARCHAR, c FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'strftime hm', k::VARCHAR, c FROM (SELECT strftime(ts, '%H:%M') AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'strftime hm tz', k::VARCHAR, c FROM (SELECT strftime(tstz, '%H:%M') AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'cast time', k::VARCHAR, c FROM (SELECT date_trunc('hour', ts)::TIME AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'time column', k::VARCHAR, c FROM (SELECT time_bucket(INTERVAL '15 minutes', tm) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'monthname', k::VARCHAR, c FROM (SELECT monthname(ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'last_day tz', k::VARCHAR, c FROM (SELECT last_day(tstz) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'label', k::VARCHAR, c FROM (SELECT year(ts) || '-Q' || quarter(ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'epoch bin', k::VARCHAR, c FROM (SELECT floor(epoch(ts) / 3600) * 3600 AS k, count(*) AS c FROM edge_rows GROUP BY 1)
UNION ALL SELECT 'coordinates', k::VARCHAR || '|' || k2::VARCHAR, c FROM (SELECT year(ts) AS k, month(ts) AS k2, count(*) AS c FROM edge_rows GROUP BY 1, 2)
UNION ALL SELECT 'ms', k::VARCHAR, c FROM (SELECT date_trunc('millisecond', ts) AS k, count(*) AS c FROM edge_rows GROUP BY 1);

query
SELECT count(*) AS rows, (SELECT count(*) FROM (SELECT * FROM ref_edge EXCEPT ALL SELECT * FROM got_edge)) AS ref_minus_got, (SELECT count(*) FROM (SELECT * FROM got_edge EXCEPT ALL SELECT * FROM ref_edge)) AS got_minus_ref FROM ref_edge;
----
rows	ref_minus_got	got_minus_ref
6818	0	0

