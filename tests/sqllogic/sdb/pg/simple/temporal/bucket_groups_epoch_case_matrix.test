UNION ALL SELECT 'case CASE WHEN price < 100 THEN ''low'' WHEN price < 500 THEN ''mid'' ELSE ''high'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN 'low' WHEN price < 500 THEN 'mid' ELSE 'high' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN ''low'' WHEN price < 500 THEN ''mid'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN 'low' WHEN price < 500 THEN 'mid' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN ''a'' WHEN price < 500 THEN ''b'' ELSE ''a'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN 'a' WHEN price < 500 THEN 'b' ELSE 'a' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN service = ''checkout'' THEN 1 WHEN sev > 2 THEN 2 ELSE 3 END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN service = 'checkout' THEN 1 WHEN sev > 2 THEN 2 ELSE 3 END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN ''low'' ELSE NULL END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN 'low' ELSE NULL END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price IS NULL THEN ''none'' WHEN price < 100 THEN ''low'' ELSE ''high'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price IS NULL THEN 'none' WHEN price < 100 THEN 'low' ELSE 'high' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN delta < 0 THEN -1 WHEN delta = 0 THEN 0 ELSE 1 END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN delta < 0 THEN -1 WHEN delta = 0 THEN 0 ELSE 1 END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN delta < -100 THEN -100.5 WHEN delta < 100 THEN 0.5 ELSE 100.5 END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN delta < -100 THEN -100.5 WHEN delta < 100 THEN 0.5 ELSE 100.5 END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
