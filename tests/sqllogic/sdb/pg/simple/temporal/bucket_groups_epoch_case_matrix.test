UNION ALL SELECT 'old floor(epoch(ts) / 3600) * 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM old GROUP BY 1)
UNION ALL SELECT 'old to_timestamp(floor(epoch(ts) / 3600) * 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 3600) * 3600) AS k, count(*) AS c, sum(v) AS s FROM old GROUP BY 1)
