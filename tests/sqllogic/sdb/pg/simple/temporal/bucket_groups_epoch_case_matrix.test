UNION ALL SELECT 'case CASE WHEN price < 100 THEN ''low'' ELSE NULL END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN 'low' ELSE NULL END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price IS NULL THEN ''none'' WHEN price < 100 THEN ''low'' ELSE ''high'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price IS NULL THEN 'none' WHEN price < 100 THEN 'low' ELSE 'high' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN delta < 0 THEN -1 WHEN delta = 0 THEN 0 ELSE 1 END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN delta < 0 THEN -1 WHEN delta = 0 THEN 0 ELSE 1 END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN delta < -100 THEN -100.5 WHEN delta < 100 THEN 0.5 ELSE 100.5 END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN delta < -100 THEN -100.5 WHEN delta < 100 THEN 0.5 ELSE 100.5 END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN DATE ''2020-01-01'' ELSE DATE ''2021-01-01'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN DATE '2020-01-01' ELSE DATE '2021-01-01' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN TRUE ELSE FALSE END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN TRUE ELSE FALSE END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE sev WHEN 0 THEN ''zero'' WHEN 1 THEN ''one'' ELSE ''many'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE sev WHEN 0 THEN 'zero' WHEN 1 THEN 'one' ELSE 'many' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case ''bin:'' !! CASE WHEN price < 100 THEN ''low'' ELSE ''high'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT 'bin:' || CASE WHEN price < 100 THEN 'low' ELSE 'high' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case (CASE WHEN price < 100 THEN 1 ELSE 2 END) * 10' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (CASE WHEN price < 100 THEN 1 ELSE 2 END) * 10 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN price ELSE 0 END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN price ELSE 0 END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN price < 100 THEN ''low'' ELSE service END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN price < 100 THEN 'low' ELSE service END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN ts < TIMESTAMP ''2025-01-15'' THEN ''early'' WHEN ts < TIMESTAMP ''2025-02-15'' THEN ''mid'' ELSE ''late'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN ts < TIMESTAMP '2025-01-15' THEN 'early' WHEN ts < TIMESTAMP '2025-02-15' THEN 'mid' ELSE 'late' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'case CASE WHEN date_trunc(''day'', ts) = DATE ''2025-01-01'' THEN ''newyear'' ELSE ''other'' END' AS shape, k::VARCHAR AS k, c, s FROM (SELECT CASE WHEN date_trunc('day', ts) = DATE '2025-01-01' THEN 'newyear' ELSE 'other' END AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1);

