SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE g AS SELECT TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE AS ts, (TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2024-12-28' + (i % 300)::INTEGER)::DATE AS d, (i % 1000)::DOUBLE AS price, (i % 1000 - 500)::INTEGER AS delta, CASE i % 5 WHEN 0 THEN 'checkout' WHEN 1 THEN 'cart' ELSE 'web' END AS service, (i % 5)::SMALLINT AS sev, i AS v FROM range(50000) t(i);

statement ok
INSERT INTO g VALUES (NULL, NULL, NULL, NULL, NULL, NULL, NULL, -1);

statement ok
CREATE TABLE old AS SELECT TIMESTAMP '1969-12-25 00:00:00' + INTERVAL (i * 173) MINUTE AS ts, i AS v FROM range(4000) t(i);

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_e AS
SELECT 'ts floor(epoch(ts) / 3600) * 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts floor(epoch(ts) / 86400) * 86400' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 86400) * 86400 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts to_timestamp(floor(epoch(ts) / 3600) * 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 3600) * 3600) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts to_timestamp(floor(epoch(ts) / 900) * 900)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 900) * 900) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts floor(date_part(''epoch'', ts) / 3600) * 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(date_part('epoch', ts) / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts floor(extract(epoch FROM ts) / 300) * 300' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(extract(epoch FROM ts) / 300) * 300 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts to_timestamp(floor(extract(epoch FROM ts) / 300) * 300)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(extract(epoch FROM ts) / 300) * 300) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts epoch_ms(ts) // 3600000 * 3600000' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_ms(ts) // 3600000 * 3600000 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts epoch_ms(epoch_ms(ts) // 3600000 * 3600000)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_ms(epoch_ms(ts) // 3600000 * 3600000) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts epoch_us(ts) // 3600000000' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_us(ts) // 3600000000 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts make_timestamp(epoch_us(ts) // 3600000000 * 3600000000)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT make_timestamp(epoch_us(ts) // 3600000000 * 3600000000) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts to_timestamp(floor(epoch(ts) / 3600) * 3600 + 1800)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 3600) * 3600 + 1800) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts to_timestamp(floor(epoch(ts) / 604800) * 604800)::DATE' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 604800) * 604800)::DATE AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts to_timestamp(floor(epoch(ts) / 86400) * 86400)::DATE' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 86400) * 86400)::DATE AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts floor(epoch(ts) / 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 3600) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts ceil(epoch(ts) / 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT ceil(epoch(ts) / 3600) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts round(epoch_ms(ts) / 3600000)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT round(epoch_ms(ts) / 3600000) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts (epoch(ts) / 3600)::BIGINT' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (epoch(ts) / 3600)::BIGINT AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts floor(epoch(ts) / 3600) * 3600 / 60' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 3600) * 3600 / 60 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts epoch(ts) // 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch(ts) // 3600 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'ts floor(epoch(ts) / 1.5)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 1.5) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(epoch(tstz) / 3600) * 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz) / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(epoch(tstz) / 86400) * 86400' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz) / 86400) * 86400 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz to_timestamp(floor(epoch(tstz) / 3600) * 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(tstz) / 3600) * 3600) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz to_timestamp(floor(epoch(tstz) / 900) * 900)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(tstz) / 900) * 900) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(date_part(''epoch'', tstz) / 3600) * 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(date_part('epoch', tstz) / 3600) * 3600 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(extract(epoch FROM tstz) / 300) * 300' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(extract(epoch FROM tstz) / 300) * 300 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz to_timestamp(floor(extract(epoch FROM tstz) / 300) * 300)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(extract(epoch FROM tstz) / 300) * 300) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz epoch_ms(tstz) // 3600000 * 3600000' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_ms(tstz) // 3600000 * 3600000 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz epoch_ms(epoch_ms(tstz) // 3600000 * 3600000)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_ms(epoch_ms(tstz) // 3600000 * 3600000) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz epoch_us(tstz) // 3600000000' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_us(tstz) // 3600000000 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz make_timestamp(epoch_us(tstz) // 3600000000 * 3600000000)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT make_timestamp(epoch_us(tstz) // 3600000000 * 3600000000) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz to_timestamp(floor(epoch(tstz) / 3600) * 3600 + 1800)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(tstz) / 3600) * 3600 + 1800) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz to_timestamp(floor(epoch(tstz) / 604800) * 604800)::DATE' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(tstz) / 604800) * 604800)::DATE AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz to_timestamp(floor(epoch(tstz) / 86400) * 86400)::DATE' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(tstz) / 86400) * 86400)::DATE AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(epoch(tstz) / 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz) / 3600) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz ceil(epoch(tstz) / 3600)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT ceil(epoch(tstz) / 3600) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz round(epoch_ms(tstz) / 3600000)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT round(epoch_ms(tstz) / 3600000) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz (epoch(tstz) / 3600)::BIGINT' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (epoch(tstz) / 3600)::BIGINT AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(epoch(tstz) / 3600) * 3600 / 60' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz) / 3600) * 3600 / 60 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz epoch(tstz) // 3600' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch(tstz) // 3600 AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
UNION ALL SELECT 'tstz floor(epoch(tstz) / 1.5)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz) / 1.5) AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
