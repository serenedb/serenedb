UNION ALL SELECT 'd (epoch(d) / 3600)::BIGINT' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (epoch(d) / 3600)::BIGINT AS k, count(*) AS c, sum(v) AS s FROM g GROUP BY 1)
