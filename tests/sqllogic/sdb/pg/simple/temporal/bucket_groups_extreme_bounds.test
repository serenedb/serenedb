query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes,
	(SELECT count(*) FROM (SELECT * FROM ext_off EXCEPT ALL SELECT * FROM ext_on)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM ext_on EXCEPT ALL SELECT * FROM ext_off)) AS gained
FROM ext_on;
----
rows	shapes	lost	gained
160	23	0	0

query
SELECT shape, count(*) AS keys, min(c) AS min_rows, max(c) AS max_rows, sum(s) AS total
FROM ext_on GROUP BY 1 ORDER BY 1;
