statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE ext AS SELECT ts, ts::TIMESTAMPTZ AS tstz, v FROM (VALUES
	(TIMESTAMP '-290307-12-31 23:59:59', 1),
	(TIMESTAMP '-4712-01-01 00:00:00', 2),
	(TIMESTAMP '1899-12-31 23:00:00', 3),
	(TIMESTAMP '2025-03-30 02:30:00', 4),
	(TIMESTAMP '2025-03-30 03:30:00', 5),
	(TIMESTAMP '2300-01-01 00:00:00', 6),
	(TIMESTAMP '294246-01-01 00:00:00', 7),
	(NULL, 8)) t(ts, v);

statement ok
SET disabled_optimizers = '';

statement ok
CREATE OR REPLACE TABLE ext_on AS
SELECT 'hour' AS shape, (date_trunc('hour', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'day' AS shape, (date_trunc('day', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'month' AS shape, (date_trunc('month', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'year' AS shape, (date_trunc('year', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'decade' AS shape, (date_trunc('decade', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'millennium' AS shape, (date_trunc('millennium', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'quarter hour' AS shape, (time_bucket(INTERVAL '15 minutes', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'bucket day' AS shape, (time_bucket(INTERVAL '1 day', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'bucket month' AS shape, (time_bucket(INTERVAL '1 month', ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'bin offset' AS shape, (time_bucket(INTERVAL '6 hours', ts, INTERVAL '17 minutes'))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'strftime date' AS shape, (strftime(ts, '%Y-%m-%d'))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'strftime time' AS shape, (strftime(ts, '%H:%M'))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'year part' AS shape, (year(ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'coordinates' AS shape, (year(ts) || '-' || month(ts))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'cast date' AS shape, (ts::DATE)::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'cast time' AS shape, (date_trunc('hour', ts)::TIME)::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'epoch bin' AS shape, (epoch(ts) // 900)::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'zoned hour' AS shape, (date_trunc('hour', tstz))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'zoned day' AS shape, (date_trunc('day', tstz))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'zoned month' AS shape, (date_trunc('month', tstz))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'zoned cast date' AS shape, (tstz::DATE)::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'zoned strftime' AS shape, (strftime(tstz, '%Y-%m-%d'))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2
UNION ALL SELECT 'zoned bucket day' AS shape, (time_bucket(INTERVAL '1 day', tstz))::VARCHAR AS k, count(*) AS c, sum(v) AS s
	FROM ext GROUP BY 1, 2;

statement ok
SET disabled_optimizers = 'compressed_materialization,expression_rewriter';

statement ok
