query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes,
	(SELECT count(*) FROM (SELECT * FROM off_havana EXCEPT ALL SELECT * FROM on_havana)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM on_havana EXCEPT ALL SELECT * FROM off_havana)) AS gained
FROM on_havana;
