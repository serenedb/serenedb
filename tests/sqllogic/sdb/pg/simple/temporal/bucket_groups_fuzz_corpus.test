UNION ALL SELECT 51 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (time_bucket(INTERVAL '2 months', tstz, 'America/Havana', TIMESTAMPTZ '2025-01-01 00:00:00+00'))::DATE AS k0, count(*), min(v), max(v) FROM fz GROUP BY 1) q
