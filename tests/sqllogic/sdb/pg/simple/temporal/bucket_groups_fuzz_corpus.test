UNION ALL SELECT 282 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, count(*) FROM (SELECT ((tstz AT TIME ZONE 'Europe/Berlin'))::DATE AS k0 FROM fzx UNION ALL SELECT ((tstz AT TIME ZONE 'Europe/Berlin'))::DATE AS k0 FROM fzx) GROUP BY 1) q
UNION ALL SELECT 283 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT tstz AS k0, strftime(ts, '%d/%m/%Y') AS k1, date_trunc('week', date_trunc('minute', tstz)) AS k2, avg(v), stddev(v), count(*), count(v) FROM fzx GROUP BY 1, 2, 3 HAVING count(*) > 1) q
UNION ALL SELECT 284 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT ts::TIME AS k0, (date_bin(INTERVAL '2 days', ts, TIMESTAMP '2025-01-01 00:00:07') AT TIME ZONE 'Etc/UTC') AS k1, (floor(epoch_ms(ts) / 60) * 7) AS k2 FROM fzx) q
UNION ALL SELECT 285 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (date_trunc('minute', ts) AT TIME ZONE 'America/Havana') AS k0, (date_trunc('quarter', ts) + INTERVAL '2 months') AS k1, count(*), min(v), max(v) FROM fzx GROUP BY 1, 2) q
UNION ALL SELECT 286 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT date_bin(INTERVAL '5 seconds', date_trunc('year', (tstz AT TIME ZONE 'Etc/UTC')), TIMESTAMP '2025-01-01 00:00:07') AS k0 FROM fzx) q
UNION ALL SELECT 287 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ((date_trunc('century', (ts::DATE)::TIMESTAMP))::VARCHAR) AS k0, time_bucket(INTERVAL '5 seconds', (ts + INTERVAL '30 minutes')) AS k1, count(*), min(v), max(v) FROM fzn GROUP BY 1, 2) q
UNION ALL SELECT 288 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts AS k0, date_trunc('quarter', date_bin(INTERVAL '2 days', date_trunc('minute', ts), TIMESTAMP '2025-01-01 00:00:07')) AS k1, count(*) FROM fzx GROUP BY 1, 2 HAVING count(*) > 1) q
UNION ALL SELECT 289 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT d AS k0, count(*), sum(v), avg(v) FROM fzw GROUP BY 1) q
UNION ALL SELECT 290 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT time_bucket(INTERVAL '1 week', ts) AS k0, count(*), sum(v), min(v), max(v), avg(v) FROM fzw GROUP BY 1) q
UNION ALL SELECT 291 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, any_value(v) FROM (SELECT ts::TIME AS k0, v FROM fzx) GROUP BY 1) q
UNION ALL SELECT 292 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT monthname(date_trunc('month', tms)) AS k0, date_bin(INTERVAL '3 hours', tms, TIMESTAMP '2025-01-01 00:00:07') AS k1, (d)::TIMESTAMP AS k2 FROM fz) q
UNION ALL SELECT 293 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT time_bucket(INTERVAL '15 minutes', tm) AS k0 FROM fzn) q
UNION ALL SELECT 294 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts::TIME AS k0, avg(v), stddev(v), count(*), count(v) FROM fzx GROUP BY 1 HAVING count(*) > 1) q
UNION ALL SELECT 295 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, median(v), avg(v), count(DISTINCT v % 5) FROM (SELECT d AS k0, v FROM fzw) GROUP BY 1) q
UNION ALL SELECT 296 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (tstz)::TIME AS k0, count(*), sum(v), avg(v) FROM fzx GROUP BY 1) q;

query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes,
	(SELECT count(*) FROM (SELECT * FROM off_lord_howe EXCEPT ALL SELECT * FROM on_lord_howe)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM on_lord_howe EXCEPT ALL SELECT * FROM off_lord_howe)) AS gained
FROM on_lord_howe;
