UNION ALL SELECT 55 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, count(*) FROM (SELECT time_bucket(INTERVAL '3 hours', tstz) AS k0, d AS k1 FROM fzw UNION ALL SELECT time_bucket(INTERVAL '3 hours', tstz) AS k0, d AS k1 FROM fzw) GROUP BY 1, 2) q
UNION ALL SELECT 56 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('century', tms) AS k0, count(*), sum(v), min(v), max(v), avg(v) FROM fz GROUP BY 1) q
UNION ALL SELECT 57 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ('b' || (month(tns))::VARCHAR) AS k0, (tstz + INTERVAL '1 day') AS k1, date_trunc('month', time_bucket(INTERVAL '1 year', date_trunc('second', tstz))) AS k2, avg(v), stddev(v), count(*), count(v) FROM fz GROUP BY 1, 2, 3) q
UNION ALL SELECT 58 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT time_bucket(INTERVAL '1 month', date_trunc('week', date_bin(INTERVAL '15 minutes', tms, TIMESTAMP '2025-01-01 00:00:07'))) AS k0, any_value(v) FROM fz GROUP BY 1) q
