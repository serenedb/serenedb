# 297 shapes from fuzz_groups seed 77

statement ok
CREATE OR REPLACE TABLE fz AS SELECT TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE AS ts,
 (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS tstz,
 (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::DATE AS d,
 (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIME AS tm,
 (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMP_NS AS tns,
 (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMP_MS AS tms,
 (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMP_S AS tsec, i AS v FROM range(1500) t(i);

statement ok
CREATE OR REPLACE TABLE fzn AS SELECT TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 3) MILLISECOND AS ts,
 (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 3) MILLISECOND)::TIMESTAMPTZ AS tstz,
 (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i * 3) MILLISECOND)::TIME AS tm, i AS v FROM range(1500) t(i);

statement ok
CREATE OR REPLACE TABLE fzw AS SELECT TIMESTAMP '2019-02-27 23:30:00' + INTERVAL (i * 41) HOUR AS ts,
 (TIMESTAMP '2019-02-27 23:30:00' + INTERVAL (i * 41) HOUR)::TIMESTAMPTZ AS tstz,
 (TIMESTAMP '2019-02-27 23:30:00' + INTERVAL (i * 41) HOUR)::DATE AS d, i AS v FROM range(1500) t(i);

statement ok
CREATE OR REPLACE TABLE fzx AS SELECT ts, ts::TIMESTAMPTZ AS tstz, v FROM (VALUES
 (TIMESTAMP '2025-03-30 01:59:59.999999', 1), (TIMESTAMP '2025-03-30 02:00:00', 2),
 (TIMESTAMP '2025-10-26 02:30:00', 3), (TIMESTAMP '1969-12-31 23:59:59.999999', 4),
 (TIMESTAMP '1970-01-01 00:00:00', 5), (TIMESTAMP '1900-01-01 00:00:00', 6),
 (TIMESTAMP '2299-12-31 00:00:00', 7), (TIMESTAMP '0044-03-15 12:00:00', 8), (NULL, 9)) t(ts, v);

statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
SET disabled_optimizers = '';

statement ok
CREATE OR REPLACE TABLE on_berlin AS
SELECT 0 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('quarter', date_trunc('decade', ts)) AS k0, count(*) FROM fzw WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 1 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts::DATE AS k0, any_value(v) FROM fzx GROUP BY 1) q
UNION ALL SELECT 2 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (date_trunc('minute', tsec))::DATE AS k0, median(v), avg(v), count(DISTINCT v % 5) FROM fz WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 3 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, count(*) FROM (SELECT (ts::DATE)::TIMESTAMP AS k0, (tstz + INTERVAL '1 month') AS k1 FROM fzn UNION ALL SELECT (ts::DATE)::TIMESTAMP AS k0, (tstz + INTERVAL '1 month') AS k1 FROM fzn) GROUP BY 1, 2) q
UNION ALL SELECT 4 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT v AS k0, time_bucket(INTERVAL '90 seconds', date_trunc('microseconds', ts)) AS k1 FROM fz) q
UNION ALL SELECT 5 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('month', date_trunc('quarter', date_trunc('month', ts))) AS k0, (date_trunc('millennium', (ts + INTERVAL '30 minutes')))::DATE AS k1, sum(v) FILTER (WHERE v % 2 = 0) FROM fzw GROUP BY 1, 2) q
UNION ALL SELECT 6 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (tsec + INTERVAL '2 months') AS k0, avg(v), avg(v + 1), count(v) FROM fz GROUP BY 1 ORDER BY 1) q
UNION ALL SELECT 7 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT ts::DATE AS k0 FROM fzx) q
UNION ALL SELECT 8 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('year', time_bucket(INTERVAL '150 milliseconds', tstz, 'Europe/Berlin')) AS k0, count(*) FROM fzw GROUP BY 1 ORDER BY 1) q
UNION ALL SELECT 9 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('century', d) AS k0, date_trunc('month', date_trunc('decade', tsec)) AS k1, count(*), sum(v), min(v), max(v) FROM fz WHERE v % 3 <> 0 GROUP BY 1, 2) q
UNION ALL SELECT 10 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, count(*), sum(v), min(v), max(v) FROM (SELECT date_trunc('hour', tstz) AS k0, ((date_bin(INTERVAL '3 hours', time_bucket(INTERVAL '3 months', tms), TIMESTAMP '2025-01-01 00:00:07'))::VARCHAR) AS k1, v FROM fz) GROUP BY 1, 2) q
UNION ALL SELECT 11 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ((epoch(ts))::VARCHAR || '-' || ((v * 10))::VARCHAR) AS k0, median(v), avg(v), count(DISTINCT v % 5) FROM fz GROUP BY 1) q
UNION ALL SELECT 12 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (date_trunc('century', ts))::TIME AS k0, median(v), avg(v), count(DISTINCT v % 5) FROM fzn GROUP BY 1) q
UNION ALL SELECT 13 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('week', tstz) AS k0, count(*) FROM fzn WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 14 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts::TIME AS k0, date_bin(INTERVAL '5 seconds', ts, TIMESTAMP '2025-01-01 00:00:07') AS k1, sum(v) FILTER (WHERE v % 2 = 0) FROM fzw GROUP BY 1, 2 ORDER BY 1) q
UNION ALL SELECT 15 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts AS k0, avg(v), stddev(v), count(*), count(v) FROM fzw GROUP BY 1) q
UNION ALL SELECT 16 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, count(*) FROM (SELECT (ts + INTERVAL '1 day') AS k0 FROM fzn UNION ALL SELECT (ts + INTERVAL '1 day') AS k0 FROM fzn) GROUP BY 1) q
UNION ALL SELECT 17 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT epoch(time_bucket(INTERVAL '90 seconds', tstz)) AS k0 FROM fzn) q
UNION ALL SELECT 18 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (tstz)::TIME AS k0, count(*), sum(v), min(v), max(v), avg(v) FROM fzw GROUP BY 1) q
UNION ALL SELECT 19 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, avg(v) FROM (SELECT ts::TIME AS k0, tstz AS k1, v FROM fzx) GROUP BY 1, 2) q
UNION ALL SELECT 20 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (ts)::DATE AS k0, tstz AS k1, avg(v), avg(v + 1), count(v) FROM fzx GROUP BY 1, 2 HAVING count(*) > 1) q
UNION ALL SELECT 21 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('month', time_bucket(INTERVAL '5 seconds', tms)) AS k0, count(*), min(v), max(v) FROM fz GROUP BY 1 ORDER BY 1) q
UNION ALL SELECT 22 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('decade', tstz) AS k0, sum(v) FILTER (WHERE v % 2 = 0) FROM fzn GROUP BY 1) q
UNION ALL SELECT 23 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT tsec AS k0, date_bin(INTERVAL '15 minutes', tsec, TIMESTAMP '2025-01-01 00:00:07') AS k1, dayname(tns) AS k2, avg(v), avg(v + 1), count(v) FROM fz GROUP BY 1, 2, 3 HAVING count(*) > 1) q
UNION ALL SELECT 24 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT tstz AS k0, count(*), sum(v), min(v), max(v), avg(v) FROM fzn GROUP BY 1) q
UNION ALL SELECT 25 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT tm AS k0 FROM fz) q
UNION ALL SELECT 26 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ((day(tstz) // 10) + -28) AS k0, count(*), sum(v), min(v), max(v), avg(v) FROM fz WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 27 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT monthname(date_trunc('millennium', ts)) AS k0, (tstz AT TIME ZONE 'Europe/Berlin') AS k1, count(*), sum(v) FROM fzw GROUP BY 1, 2) q
UNION ALL SELECT 28 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (time_bucket(INTERVAL '7 minutes', (ts + INTERVAL '2 months')) + INTERVAL '2 months') AS k0, date_bin(INTERVAL '3 hours', date_trunc('microseconds', date_trunc('day', ts)), TIMESTAMP '2025-01-01 00:00:07') AS k1, count(*), sum(v), avg(v) FROM fzn GROUP BY 1, 2) q
UNION ALL SELECT 29 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, count(*), sum(v), min(v), max(v) FROM (SELECT ('b' || (isoyear(date_trunc('day', tsec)))::VARCHAR) AS k0, v AS k1, v FROM fz) GROUP BY 1, 2) q
UNION ALL SELECT 30 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT dayname(date_trunc('hour', tstz)) AS k0, time_bucket(INTERVAL '7 minutes', tm) AS k1, tm AS k2, count(*) FROM fz WHERE v % 3 <> 0 GROUP BY 1, 2, 3) q
UNION ALL SELECT 31 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT minute((ts::DATE)::TIMESTAMP) AS k0, dayname(date_trunc('decade', date_trunc('year', ts))) AS k1, count(*), sum(v), min(v), max(v), avg(v) FROM fzx GROUP BY 1, 2) q
UNION ALL SELECT 32 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT tm AS k0, epoch_ms((ts + INTERVAL '30 minutes')) AS k1, avg(v), avg(v + 1), count(v) FROM fzn GROUP BY 1, 2) q
UNION ALL SELECT 33 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_bin(INTERVAL '1 hour', date_trunc('hour', (ts + INTERVAL '2 months')), TIMESTAMP '2025-01-01 00:00:07') AS k0, count(*) FROM fzn GROUP BY 1) q
UNION ALL SELECT 34 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('quarter', date_trunc('month', tstz)) AS k0, time_bucket(INTERVAL '3 hours', tstz, 'Etc/UTC') AS k1, median(v), avg(v), count(DISTINCT v % 5) FROM fzx GROUP BY 1, 2) q
UNION ALL SELECT 35 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_bin(INTERVAL '5 seconds', tms, TIMESTAMP '2025-01-01 00:00:07') AS k0, date_trunc('week', date_trunc('microseconds', tms)) AS k1, (date_trunc('hour', (tstz + INTERVAL '1 day')) + INTERVAL '1 day') AS k2, sum(v) FILTER (WHERE v % 2 = 0) FROM fz GROUP BY 1, 2, 3) q
UNION ALL SELECT 36 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, count(*) FROM (SELECT (d)::TIMESTAMP AS k0, v FROM fz) GROUP BY 1) q
UNION ALL SELECT 37 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts::TIME AS k0, (time_bucket(INTERVAL '1 year', tstz))::DATE AS k1, count(*) FROM fzx GROUP BY 1, 2) q
UNION ALL SELECT 38 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT strftime(tstz, '%j') AS k0, count(*), sum(v), min(v), max(v), avg(v) FROM fzn WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 39 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('microseconds', tstz) AS k0, count(*), sum(v), avg(v) FROM fz GROUP BY 1) q
UNION ALL SELECT 40 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT time_bucket(INTERVAL '1 year', date_trunc('second', tstz), 'Pacific/Kiritimati') AS k0, count(*) FROM fzw GROUP BY 1) q
UNION ALL SELECT 41 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT time_bucket(INTERVAL '150 milliseconds', ((ts::DATE)::TIMESTAMP AT TIME ZONE 'Asia/Kolkata')) AS k0, median(v), avg(v), count(DISTINCT v % 5) FROM fzn GROUP BY 1) q
UNION ALL SELECT 42 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('second', (ts + INTERVAL '2 months')) AS k0, avg(v) FROM fzn GROUP BY 1 ORDER BY 1) q
