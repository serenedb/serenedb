query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes,
	(SELECT count(*) FROM (SELECT * FROM off_berlin EXCEPT ALL SELECT * FROM on_berlin)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM on_berlin EXCEPT ALL SELECT * FROM off_berlin)) AS gained
FROM on_berlin;
