CREATE OR REPLACE TABLE on_havana AS
SELECT 0 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('quarter', date_trunc('decade', ts)) AS k0, count(*) FROM fzw WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 1 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ts::DATE AS k0, any_value(v) FROM fzx GROUP BY 1) q
UNION ALL SELECT 2 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (date_trunc('minute', tsec))::DATE AS k0, median(v), avg(v), count(DISTINCT v % 5) FROM fz WHERE v % 3 <> 0 GROUP BY 1) q
UNION ALL SELECT 3 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, count(*) FROM (SELECT (ts::DATE)::TIMESTAMP AS k0, (tstz + INTERVAL '1 month') AS k1 FROM fzn UNION ALL SELECT (ts::DATE)::TIMESTAMP AS k0, (tstz + INTERVAL '1 month') AS k1 FROM fzn) GROUP BY 1, 2) q
UNION ALL SELECT 4 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT v AS k0, time_bucket(INTERVAL '90 seconds', date_trunc('microseconds', ts)) AS k1 FROM fz) q
UNION ALL SELECT 5 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('month', date_trunc('quarter', date_trunc('month', ts))) AS k0, (date_trunc('millennium', (ts + INTERVAL '30 minutes')))::DATE AS k1, sum(v) FILTER (WHERE v % 2 = 0) FROM fzw GROUP BY 1, 2) q
UNION ALL SELECT 6 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT (tsec + INTERVAL '2 months') AS k0, avg(v), avg(v + 1), count(v) FROM fz GROUP BY 1 ORDER BY 1) q
UNION ALL SELECT 7 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT DISTINCT ts::DATE AS k0 FROM fzx) q
UNION ALL SELECT 8 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('year', time_bucket(INTERVAL '150 milliseconds', tstz, 'Europe/Berlin')) AS k0, count(*) FROM fzw GROUP BY 1 ORDER BY 1) q
UNION ALL SELECT 9 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT date_trunc('century', d) AS k0, date_trunc('month', date_trunc('decade', tsec)) AS k1, count(*), sum(v), min(v), max(v) FROM fz WHERE v % 3 <> 0 GROUP BY 1, 2) q
UNION ALL SELECT 10 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT k0, k1, count(*), sum(v), min(v), max(v) FROM (SELECT date_trunc('hour', tstz) AS k0, ((date_bin(INTERVAL '3 hours', time_bucket(INTERVAL '3 months', tms), TIMESTAMP '2025-01-01 00:00:07'))::VARCHAR) AS k1, v FROM fz) GROUP BY 1, 2) q
UNION ALL SELECT 11 AS shape, to_json(q)::VARCHAR AS k FROM (SELECT ((epoch(ts))::VARCHAR || '-' || ((v * 10))::VARCHAR) AS k0, median(v), avg(v), count(DISTINCT v % 5) FROM fz GROUP BY 1) q
