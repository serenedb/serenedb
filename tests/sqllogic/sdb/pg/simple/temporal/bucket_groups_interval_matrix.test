statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE iv AS SELECT TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 17) SECOND AS ts, (TIMESTAMP '2025-03-29 12:00:00' + INTERVAL (i * 17) SECOND)::TIMESTAMPTZ AS tstz, i AS v FROM range(20000) t(i);

statement ok
INSERT INTO iv VALUES (NULL, NULL, -1);

statement ok
CREATE TABLE ivw AS SELECT TIMESTAMP '2023-11-01 00:00:00' + INTERVAL (i * 3671) SECOND AS ts, (TIMESTAMP '2023-11-01 00:00:00' + INTERVAL (i * 3671) SECOND)::TIMESTAMPTZ AS tstz, i AS v FROM range(20000) t(i);

statement ok
INSERT INTO ivw VALUES (NULL, NULL, -1);

statement ok
CREATE TABLE ivn AS SELECT TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i) SECOND AS ts, (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i) SECOND)::TIMESTAMPTZ AS tstz, i AS v FROM range(20000) t(i);

statement ok
INSERT INTO ivn VALUES (NULL, NULL, -1);

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_iv AS
SELECT 'iv time_bucket(INTERVAL ''10 seconds'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '10 seconds', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''90 seconds'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 seconds', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''7 minutes'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '7 minutes', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''15 minutes'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''45 minutes'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '45 minutes', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''1 hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 hour', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''3 hours'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '3 hours', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''150 milliseconds'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '150 milliseconds', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''2 days'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '2 days', ts) AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''1 month'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 month', ts) AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''4 months'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '4 months', ts) AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''15 minutes'', ts, INTERVAL ''5 minutes'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', ts, INTERVAL '5 minutes') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''90 seconds'', ts, INTERVAL ''-20 seconds'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 seconds', ts, INTERVAL '-20 seconds') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''90 seconds'', ts, TIMESTAMP ''2025-01-01 00:00:07'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 seconds', ts, TIMESTAMP '2025-01-01 00:00:07') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''7 minutes'', ts, DATE ''2024-12-30'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '7 minutes', ts, DATE '2024-12-30') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''5 months'', ts, TIMESTAMP ''2024-02-17 00:00:00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '5 months', ts, TIMESTAMP '2024-02-17 00:00:00') AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'iv date_bin(INTERVAL ''90 seconds'', ts, TIMESTAMP ''2025-01-01 00:00:07'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '90 seconds', ts, TIMESTAMP '2025-01-01 00:00:07') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv date_bin(INTERVAL ''7 minutes'', ts, TIMESTAMP ''2024-12-31 23:58:00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '7 minutes', ts, TIMESTAMP '2024-12-31 23:58:00') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv date_bin(INTERVAL ''1 hour 30 minutes'', ts, TIMESTAMP ''2025-01-01 00:00:00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '1 hour 30 minutes', ts, TIMESTAMP '2025-01-01 00:00:00') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'ivn date_trunc(''second'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('second', ts) AS k, count(*) AS c, sum(v) AS s FROM ivn GROUP BY 1)
UNION ALL SELECT 'iv date_trunc(''minute'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('minute', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv date_trunc(''hour'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv floor(epoch(ts) / 900) * 900' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(ts) / 900) * 900 AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv epoch_ms(ts) // 60000' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_ms(ts) // 60000 AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv to_timestamp(floor(epoch(ts) / 900) * 900)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 900) * 900) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL (v % 3 + 1) MINUTE, ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL (v % 3 + 1) MINUTE, ts) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''90 seconds'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 seconds', tstz) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''7 minutes'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '7 minutes', tstz) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''15 minutes'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''1 hour'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 hour', tstz) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''1 day'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz) AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''1 month'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 month', tstz) AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''15 minutes'', tstz, INTERVAL ''5 minutes'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz, INTERVAL '5 minutes') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''90 seconds'', tstz, TIMESTAMPTZ ''2025-01-01 00:00:07+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 seconds', tstz, TIMESTAMPTZ '2025-01-01 00:00:07+00') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv date_trunc(''minute'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('minute', tstz) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv date_trunc(''hour'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz) AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''15 minutes'', tstz, ''America/Havana'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz, 'America/Havana') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'iv time_bucket(INTERVAL ''45 minutes'', tstz, ''Australia/Lord_Howe'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '45 minutes', tstz, 'Australia/Lord_Howe') AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''1 day'', tstz, ''America/Havana'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz, 'America/Havana') AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'ivw time_bucket(INTERVAL ''1 month'', tstz, ''Pacific/Kiritimati'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 month', tstz, 'Pacific/Kiritimati') AS k, count(*) AS c, sum(v) AS s FROM ivw GROUP BY 1)
UNION ALL SELECT 'iv floor(epoch(tstz) / 900) * 900' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(epoch(tstz) / 900) * 900 AS k, count(*) AS c, sum(v) AS s FROM iv GROUP BY 1)
;

