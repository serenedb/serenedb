statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE lab AS SELECT TIMESTAMP '2023-11-15 00:00:00' + INTERVAL (i * 173) MINUTE AS ts, (TIMESTAMP '2023-11-15 00:00:00' + INTERVAL (i * 173) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2023-11-15' + (i % 900)::INTEGER)::DATE AS d, i AS v FROM range(0, 6000) t(i);

statement ok
INSERT INTO lab VALUES (NULL, NULL, NULL, -1);

statement ok
CREATE TABLE lab_inf AS SELECT * FROM lab;

statement ok
INSERT INTO lab_inf VALUES (TIMESTAMP 'infinity', TIMESTAMPTZ 'infinity', DATE 'infinity', -2), (TIMESTAMP '-infinity', TIMESTAMPTZ '-infinity', DATE '-infinity', -3);

statement ok
CREATE TABLE old AS SELECT TIMESTAMP '1890-01-01 00:00:00' + INTERVAL (i * 977) HOUR AS ts, (TIMESTAMP '1890-01-01 00:00:00' + INTERVAL (i * 977) HOUR)::TIMESTAMPTZ AS tstz, (DATE '1890-01-01' + (i * 37)::INTEGER)::DATE AS d, i AS v FROM range(0, 4000) t(i);

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_lab AS
SELECT 'ts year(ts) !! ''-Q'' !! quarter(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-Q' || quarter(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''Q'' !! quarter(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || 'Q' || quarter(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts ''['' !! year(ts) !! ''-Q'' !! quarter(ts) !! '']''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT '[' || year(ts) || '-Q' || quarter(ts) || ']' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts)::VARCHAR !! ''-'' !! month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts)::VARCHAR || '-' || month(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''/'' !! dayofyear(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '/' || dayofyear(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts isoyear(ts) !! ''-W'' !! week(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT isoyear(ts) || '-W' || week(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts isoyear(ts) !! ''-W'' !! week(ts) !! ''-'' !! isodow(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT isoyear(ts) || '-W' || week(ts) || '-' || isodow(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! month(ts) !! ''-'' !! day(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || month(ts) || '-' || day(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! month(ts) !! ''-'' !! day(ts) !! '' '' !! hour(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || month(ts) || '-' || day(ts) || ' ' || hour(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! month(ts) !! ''-'' !! day(ts) !! '' '' !! hour(ts) !! '':'' !! minute(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || month(ts) || '-' || day(ts) || ' ' || hour(ts) || ':' || minute(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts monthname(ts) !! '' '' !! year(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT monthname(ts) || ' ' || year(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! '' '' !! monthname(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || ' ' || monthname(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts dayname(ts) !! '', '' !! strftime(ts, ''%Y-%m-%d'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT dayname(ts) || ', ' || strftime(ts, '%Y-%m-%d') AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts strftime(ts, ''%Y'') !! '' Q'' !! quarter(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y') || ' Q' || quarter(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts strftime(ts, ''%Y-%m'') !! ''/'' !! day(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y-%m') || '/' || day(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts decade(ts) !! ''s''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT decade(ts) || 's' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts century(ts)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT century(ts)::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts millennium(ts) !! ''M''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT millennium(ts) || 'M' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts ''FY'' !! year(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT 'FY' || year(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts date_part(''quarter'', ts) !! ''/'' !! date_part(''year'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_part('quarter', ts) || '/' || date_part('year', ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts datepart(''year'', ts) !! ''.'' !! datepart(''month'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT datepart('year', ts) || '.' || datepart('month', ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts yearweek(ts) !! ''''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT yearweek(ts) || '' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts yearweek(ts)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT yearweek(ts)::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts concat(year(ts), ''-'', quarter(ts))' AS shape, k::VARCHAR AS k, c, s FROM (SELECT concat(year(ts), '-', quarter(ts)) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts concat(''y'', year(ts), ''m'', month(ts))' AS shape, k::VARCHAR AS k, c, s FROM (SELECT concat('y', year(ts), 'm', month(ts)) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! quarter(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || quarter(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts quarter(ts) !! ''-'' !! month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT quarter(ts) || '-' || month(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts ''Q'' !! quarter(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT 'Q' || quarter(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! week(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || week(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts isoyear(ts) !! ''-'' !! month(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT isoyear(ts) || '-' || month(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''x'' !! monthname(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || 'x' || monthname(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts monthname(ts) !! year(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT monthname(ts) || year(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! day(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || day(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! month(ts) !! ''-'' !! dayname(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || month(ts) || '-' || dayname(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! month(ts) !! '' '' !! hour(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || month(ts) || ' ' || hour(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! dayofweek(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || dayofweek(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts concat(year(ts), ''-'', lpad(month(ts)::VARCHAR, 2, ''0''))' AS shape, k::VARCHAR AS k, c, s FROM (SELECT concat(year(ts), '-', lpad(month(ts)::VARCHAR, 2, '0')) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'ts year(ts) !! ''-'' !! month(ts) !! ''-'' !! day(ts) !! '' '' !! hour(ts) !! '':'' !! minute(ts) !! '':'' !! second(ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(ts) || '-' || month(ts) || '-' || day(ts) || ' ' || hour(ts) || ':' || minute(ts) || ':' || second(ts) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd year(d) !! ''-Q'' !! quarter(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(d) || '-Q' || quarter(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd year(d) !! ''Q'' !! quarter(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(d) || 'Q' || quarter(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd ''['' !! year(d) !! ''-Q'' !! quarter(d) !! '']''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT '[' || year(d) || '-Q' || quarter(d) || ']' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd year(d)::VARCHAR !! ''-'' !! month(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(d)::VARCHAR || '-' || month(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd year(d) !! ''/'' !! dayofyear(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(d) || '/' || dayofyear(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd isoyear(d) !! ''-W'' !! week(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT isoyear(d) || '-W' || week(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd isoyear(d) !! ''-W'' !! week(d) !! ''-'' !! isodow(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT isoyear(d) || '-W' || week(d) || '-' || isodow(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
