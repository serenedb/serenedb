UNION ALL SELECT 'd datepart(''year'', d) !! ''.'' !! datepart(''month'', d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT datepart('year', d) || '.' || datepart('month', d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd yearweek(d) !! ''''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT yearweek(d) || '' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
