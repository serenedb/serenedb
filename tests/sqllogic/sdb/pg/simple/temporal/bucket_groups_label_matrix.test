UNION ALL SELECT 'd strftime(d, ''%Y-%m'') !! ''/'' !! day(d)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(d, '%Y-%m') || '/' || day(d) AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
UNION ALL SELECT 'd decade(d) !! ''s''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT decade(d) || 's' AS k, count(*) AS c, sum(v) AS s FROM lab GROUP BY 1)
