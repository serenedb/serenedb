SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE g AS SELECT TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE AS ts, (TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2024-12-28' + (i % 300)::INTEGER)::DATE AS d, (i % 1000)::DOUBLE AS price, (i % 5)::SMALLINT AS sev, i AS v FROM range(50000) t(i);

statement ok
INSERT INTO g VALUES (NULL, NULL, NULL, NULL, NULL, -1);

statement ok
CREATE TABLE dst AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 41) MINUTE AS tstz, i AS v FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 41) MINUTE, 1000 + i FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-11-01 12:00:00+00' + INTERVAL (i * 41) MINUTE, 2000 + i FROM range(0, 100) t(i));

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_n AS
SELECT 'g date_trunc(''day'', ts) vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''hour'', ts) vs date_trunc(''day'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('hour', ts) AS k1, date_trunc('day', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''month'', ts) vs date_trunc(''day'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', ts) AS k1, date_trunc('day', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''month'', ts) vs date_trunc(''week'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', ts) AS k1, date_trunc('week', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''week'', ts) vs date_trunc(''day'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('week', ts) AS k1, date_trunc('day', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''year'', ts) vs date_trunc(''quarter'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('year', ts) AS k1, date_trunc('quarter', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''quarter'', ts) vs date_trunc(''month'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('quarter', ts) AS k1, date_trunc('month', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''decade'', ts) vs date_trunc(''year'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('decade', ts) AS k1, date_trunc('year', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''century'', ts) vs date_trunc(''decade'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('century', ts) AS k1, date_trunc('decade', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs time_bucket(INTERVAL ''6 hours'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, time_bucket(INTERVAL '6 hours', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g time_bucket(INTERVAL ''2 hours'', ts) vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '2 hours', ts) AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g time_bucket(INTERVAL ''1 day'', ts) vs time_bucket(INTERVAL ''15 minutes'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '1 day', ts) AS k1, time_bucket(INTERVAL '15 minutes', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g time_bucket(INTERVAL ''90 minutes'', ts) vs time_bucket(INTERVAL ''30 minutes'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '90 minutes', ts) AS k1, time_bucket(INTERVAL '30 minutes', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g time_bucket(INTERVAL ''90 minutes'', ts) vs time_bucket(INTERVAL ''1 hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '90 minutes', ts) AS k1, time_bucket(INTERVAL '1 hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs strftime(ts, ''%Y-%m-%d %H'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, strftime(ts, '%Y-%m-%d %H') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g strftime(ts, ''%Y-%m'') vs date_trunc(''day'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT strftime(ts, '%Y-%m') AS k1, date_trunc('day', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g strftime(ts, ''%Y-%m-%d'') vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT strftime(ts, '%Y-%m-%d') AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts)::DATE vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts)::DATE AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''week'', ts)::DATE vs date_trunc(''day'', ts)::DATE' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('week', ts)::DATE AS k1, date_trunc('day', ts)::DATE AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) + INTERVAL ''6 hours'' vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) + INTERVAL '6 hours' AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g epoch_ms(date_trunc(''day'', ts)) vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT epoch_ms(date_trunc('day', ts)) AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs date_trunc(''hour'', ts)::TIMESTAMP_MS' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, date_trunc('hour', ts)::TIMESTAMP_MS AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g concat(year(ts), ''-Q'', quarter(ts)) vs date_trunc(''month'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT concat(year(ts), '-Q', quarter(ts)) AS k1, date_trunc('month', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g concat(year(ts), ''-Q'', quarter(ts)) vs strftime(ts, ''%Y-%m'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT concat(year(ts), '-Q', quarter(ts)) AS k1, strftime(ts, '%Y-%m') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g monthname(ts) vs date_trunc(''day'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT monthname(ts) AS k1, date_trunc('day', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs sev' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, sev AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g sev vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT sev AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs floor(price / 100)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, floor(price / 100) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', d) vs date_trunc(''month'', d)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', d) AS k1, date_trunc('month', d) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''month'', d) vs d' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', d) AS k1, d AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', tstz) vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', tstz) AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
