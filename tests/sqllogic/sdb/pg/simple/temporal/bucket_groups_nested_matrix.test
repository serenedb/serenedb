UNION ALL SELECT 'g concat(year(ts), ''-Q'', quarter(ts)) vs date_trunc(''month'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT concat(year(ts), '-Q', quarter(ts)) AS k1, date_trunc('month', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g concat(year(ts), ''-Q'', quarter(ts)) vs strftime(ts, ''%Y-%m'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT concat(year(ts), '-Q', quarter(ts)) AS k1, strftime(ts, '%Y-%m') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g monthname(ts) vs date_trunc(''day'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT monthname(ts) AS k1, date_trunc('day', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs sev' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, sev AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g sev vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT sev AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs floor(price / 100)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, floor(price / 100) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', ts) vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', ts) AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', d) vs date_trunc(''month'', d)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', d) AS k1, date_trunc('month', d) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''month'', d) vs d' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', d) AS k1, d AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''day'', tstz) vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', tstz) AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''month'', tstz) vs date_trunc(''day'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', tstz) AS k1, date_trunc('day', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_trunc(''month'', tstz)::DATE vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', tstz)::DATE AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g time_bucket(INTERVAL ''1 day'', tstz, ''Asia/Tokyo'') vs time_bucket(INTERVAL ''1 hour'', tstz, ''Asia/Tokyo'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz, 'Asia/Tokyo') AS k1, time_bucket(INTERVAL '1 hour', tstz, 'Asia/Tokyo') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_bin(INTERVAL ''1 day'', ts, TIMESTAMP ''2000-01-01'') vs date_bin(INTERVAL ''1 hour'', ts, TIMESTAMP ''2000-01-01'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_bin(INTERVAL '1 day', ts, TIMESTAMP '2000-01-01') AS k1, date_bin(INTERVAL '1 hour', ts, TIMESTAMP '2000-01-01') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_bin(INTERVAL ''1 day'', ts, TIMESTAMP ''2000-01-01 06:00'') vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_bin(INTERVAL '1 day', ts, TIMESTAMP '2000-01-01 06:00') AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g floor(epoch(ts) / 86400) * 86400 vs floor(epoch(ts) / 3600) * 3600' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT floor(epoch(ts) / 86400) * 86400 AS k1, floor(epoch(ts) / 3600) * 3600 AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g to_timestamp(floor(epoch(ts) / 86400) * 86400) vs to_timestamp(floor(epoch(ts) / 3600) * 3600)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT to_timestamp(floor(epoch(ts) / 86400) * 86400) AS k1, to_timestamp(floor(epoch(ts) / 3600) * 3600) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'dst date_trunc(''day'', tstz) vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', tstz) AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst date_trunc(''month'', tstz) vs date_trunc(''day'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('month', tstz) AS k1, date_trunc('day', tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst date_trunc(''week'', tstz) vs date_trunc(''day'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('week', tstz) AS k1, date_trunc('day', tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst date_trunc(''day'', tstz) vs date_trunc(''minute'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', tstz) AS k1, date_trunc('minute', tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst time_bucket(INTERVAL ''1 day'', tstz, ''America/Havana'') vs time_bucket(INTERVAL ''1 hour'', tstz, ''America/Havana'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz, 'America/Havana') AS k1, time_bucket(INTERVAL '1 hour', tstz, 'America/Havana') AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst time_bucket(INTERVAL ''7 days'', tstz, ''Europe/Berlin'') vs time_bucket(INTERVAL ''1 day'', tstz, ''Europe/Berlin'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT time_bucket(INTERVAL '7 days', tstz, 'Europe/Berlin') AS k1, time_bucket(INTERVAL '1 day', tstz, 'Europe/Berlin') AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst date_trunc(''day'', tstz) vs time_bucket(INTERVAL ''1 hour'', tstz, ''Europe/Berlin'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_trunc('day', tstz) AS k1, time_bucket(INTERVAL '1 hour', tstz, 'Europe/Berlin') AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2)
UNION ALL SELECT 'dst strftime(tstz, ''%Y-%m-%d'') vs date_trunc(''hour'', tstz)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT strftime(tstz, '%Y-%m-%d') AS k1, date_trunc('hour', tstz) AS k2, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1, 2);

