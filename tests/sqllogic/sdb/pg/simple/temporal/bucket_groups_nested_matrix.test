UNION ALL SELECT 'g date_bin(INTERVAL ''1 day'', ts, TIMESTAMP ''2000-01-01'') vs date_bin(INTERVAL ''1 hour'', ts, TIMESTAMP ''2000-01-01'')' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_bin(INTERVAL '1 day', ts, TIMESTAMP '2000-01-01') AS k1, date_bin(INTERVAL '1 hour', ts, TIMESTAMP '2000-01-01') AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
UNION ALL SELECT 'g date_bin(INTERVAL ''1 day'', ts, TIMESTAMP ''2000-01-01 06:00'') vs date_trunc(''hour'', ts)' AS shape, k1::VARCHAR AS k1, k2::VARCHAR AS k2, c, s FROM (SELECT date_bin(INTERVAL '1 day', ts, TIMESTAMP '2000-01-01 06:00') AS k1, date_trunc('hour', ts) AS k2, count(*) AS c, sum(v) AS s FROM g GROUP BY 1, 2)
