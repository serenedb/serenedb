SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE num AS SELECT i AS x, (i * 1.5)::DOUBLE AS d, (i * 0.25)::FLOAT AS f, ((i % 1000)::DECIMAL(9,2) / 7)::DECIMAL(12,4) AS dec, (i % 200 - 100)::TINYINT AS t8, (i % 20000 - 10000)::SMALLINT AS s16, (i * 1000003)::BIGINT AS big, (i * 7)::HUGEINT * 1000000007 AS huge, (i % 200)::UTINYINT AS u8, (i * 3)::UINTEGER AS u32, TIMESTAMP '2025-01-01' + INTERVAL (i) MINUTE AS ts, (TIMESTAMP '2025-03-29 00:00:00' + INTERVAL (i) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2025-01-01' + (i % 500)::INTEGER)::DATE AS dt, (i % 300 - 100)::INTEGER AS neg, i AS v FROM range(20000) t(i);

statement ok
INSERT INTO num VALUES (NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, -1);

statement ok
CREATE TABLE numx AS SELECT (i - 5000) * 0.37 AS d, (i - 5000)::BIGINT * 1000003 AS big, ((i - 5000) * 0.01)::DECIMAL(10,2) AS dec, i AS v FROM range(10000) t(i);

statement ok
CREATE TABLE nan AS SELECT d, v FROM numx UNION ALL SELECT 'nan'::DOUBLE, -1 UNION ALL SELECT 'inf'::DOUBLE, -2 UNION ALL SELECT '-inf'::DOUBLE, -3;

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_num AS
SELECT 'num floor(d / 100) * 100' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(d / 100) * 100 AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'num floor(d / 100)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT floor(d / 100) AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'num x // 100' AS shape, k::VARCHAR AS k, c, s FROM (SELECT x // 100 AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
