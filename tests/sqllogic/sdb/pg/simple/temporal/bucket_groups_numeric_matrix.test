UNION ALL SELECT 'dt last_day(ts)::TIMESTAMP' AS shape, k::VARCHAR AS k, c, s FROM (SELECT last_day(ts)::TIMESTAMP AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt last_day(ts) + 1' AS shape, k::VARCHAR AS k, c, s FROM (SELECT last_day(ts) + 1 AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt last_day(ts)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT last_day(ts)::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt epoch_ms(date_trunc(''hour'', tstz))' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch_ms(date_trunc('hour', tstz)) AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt epoch(date_trunc(''day'', tstz))' AS shape, k::VARCHAR AS k, c, s FROM (SELECT epoch(date_trunc('day', tstz)) AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''day'', tstz)::TIMESTAMP' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', tstz)::TIMESTAMP AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''hour'', tstz)::TIMESTAMP' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz)::TIMESTAMP AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''day'', tstz)::DATE' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', tstz)::DATE AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''day'', tstz) + INTERVAL ''12 hours''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', tstz) + INTERVAL '12 hours' AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''hour'', tstz) + INTERVAL ''30 minutes''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz) + INTERVAL '30 minutes' AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''hour'', tstz)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz)::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt time_bucket(INTERVAL ''1 day'', tstz, ''Asia/Tokyo'') + INTERVAL ''1 hour''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz, 'Asia/Tokyo') + INTERVAL '1 hour' AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt (date_trunc(''hour'', ts) + INTERVAL ''30 minutes'')::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT (date_trunc('hour', ts) + INTERVAL '30 minutes')::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt concat(''d'', date_trunc(''day'', ts)::DATE)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT concat('d', date_trunc('day', ts)::DATE) AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''month'', dt)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('month', dt)::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''week'', dt) + INTERVAL ''1 day''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('week', dt) + INTERVAL '1 day' AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt time_bucket(INTERVAL ''7 days'', dt)::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '7 days', dt)::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''hour'', ts)::TIMESTAMPTZ' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts)::TIMESTAMPTZ AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''day'', ts)::TIMESTAMPTZ' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', ts)::TIMESTAMPTZ AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''day'', ts)::TIMESTAMPTZ::VARCHAR' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', ts)::TIMESTAMPTZ::VARCHAR AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt TRY_CAST(date_trunc(''day'', ts) AS DATE)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT TRY_CAST(date_trunc('day', ts) AS DATE) AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt date_trunc(''hour'', ts) + INTERVAL ''30 minutes'' + INTERVAL ''15 minutes''' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts) + INTERVAL '30 minutes' + INTERVAL '15 minutes' AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt strftime(date_trunc(''hour'', ts), ''%H'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(date_trunc('hour', ts), '%H') AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1)
UNION ALL SELECT 'dt -epoch(date_trunc(''hour'', ts))' AS shape, k::VARCHAR AS k, c, s FROM (SELECT -epoch(date_trunc('hour', ts)) AS k, count(*) AS c, sum(v) AS s FROM num GROUP BY 1);

