statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE pp AS SELECT TIMESTAMP '2025-03-28 00:00:00' + INTERVAL (i * 137) SECOND AS ts,
	(TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 137) SECOND) AS tstz,
	i % 7 AS v FROM range(4000) t(i);

statement ok
PREPARE unit_param AS SELECT date_trunc($1, ts) AS k, count(*) AS c, sum(v) AS s FROM pp GROUP BY 1 ORDER BY 1;

statement ok
PREPARE filter_param AS SELECT date_trunc('hour', ts) AS k, count(*) AS c FROM pp WHERE ts >= $1 GROUP BY 1 ORDER BY 1;

statement ok
PREPARE trunc_filter_param AS SELECT date_trunc('hour', ts) AS k, count(*) AS c FROM pp WHERE date_trunc('day', ts) = $1 GROUP BY 1 ORDER BY 1;

statement ok
PREPARE zoned_param AS SELECT time_bucket(INTERVAL '1 day', tstz, $1)::VARCHAR AS k, count(*) AS c FROM pp GROUP BY 1 ORDER BY 1;

statement ok
PREPARE width_param AS SELECT time_bucket($1, ts) AS k, count(*) AS c FROM pp GROUP BY 1 ORDER BY 1;

