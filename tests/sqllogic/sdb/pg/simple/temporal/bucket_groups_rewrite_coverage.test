	('half hour zone wall clock hour: declines', 'SELECT date_trunc(''hour'', tstz) k, count(*) c FROM cov GROUP BY 1'),
	('half hour zone instant bucket', 'SELECT time_bucket(INTERVAL ''30 minutes'', tstz) k, count(*) c FROM cov GROUP BY 1'),
	('half hour zone time of day', 'SELECT strftime(tstz, ''%H:%M'') k, count(*) c FROM cov GROUP BY 1')) t(shape, sql);

