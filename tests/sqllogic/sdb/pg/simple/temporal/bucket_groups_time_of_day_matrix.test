query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes, (SELECT count(*) FROM (SELECT * FROM ref_tod EXCEPT ALL SELECT * FROM got_tod)) AS ref_minus_got, (SELECT count(*) FROM (SELECT * FROM got_tod EXCEPT ALL SELECT * FROM ref_tod)) AS got_minus_ref FROM ref_tod;
