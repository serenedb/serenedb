CREATE OR REPLACE TABLE ref_tod AS
SELECT 'tod strftime(ts, ''%H'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%H') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(ts, ''%H:%M'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%H:%M') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(ts, ''%H:%M:%S'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%H:%M:%S') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(ts, ''%I %p'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%I %p') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(ts, ''%I'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%I') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(tstz, ''%H'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz, '%H') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(tstz, ''%H:%M'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz, '%H:%M') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(tstz, ''hour %H of the day'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz, 'hour %H of the day') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(tstz, ''%I:%M %p'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz, '%I:%M %p') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod strftime(tstz, ''%H:%M %z'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz, '%H:%M %z') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''hour'', ts)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''minute'', ts)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('minute', ts)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''day'', ts)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', ts)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''hour'', tstz)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''minute'', tstz)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('minute', tstz)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''day'', tstz)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', tstz)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''15 minutes'', ts)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', ts)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''30 minutes'', tstz)::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '30 minutes', tstz)::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''15 minutes'', tstz, ''America/Havana'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', tstz, 'America/Havana')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod ts::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT ts::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''15 minutes'', tm)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', tm) AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''1 hour'', tm)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 hour', tm) AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''90 minutes'', tm)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 minutes', tm) AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''7 minutes'', tm)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '7 minutes', tm) AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''6 hours'', tm)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '6 hours', tm) AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'msn date_trunc(''millisecond'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('millisecond', ts) AS k, count(*) AS c, sum(v) AS s FROM msn GROUP BY 1)
UNION ALL SELECT 'msn date_trunc(''microsecond'', ts)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('microsecond', ts) AS k, count(*) AS c, sum(v) AS s FROM msn GROUP BY 1)
UNION ALL SELECT 'msn date_trunc(''millisecond'', tstz)' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('millisecond', tstz) AS k, count(*) AS c, sum(v) AS s FROM msn GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''1 day'', tstz, ''America/Havana'', TIMESTAMPTZ ''2025-01-01 05:00:00+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 day', tstz, 'America/Havana', TIMESTAMPTZ '2025-01-01 05:00:00+00') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''1 month'', tstz, ''America/Havana'', TIMESTAMPTZ ''2024-02-15 05:00:00+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 month', tstz, 'America/Havana', TIMESTAMPTZ '2024-02-15 05:00:00+00') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''90 minutes'', tstz, ''Europe/Berlin'', TIMESTAMPTZ ''2025-01-01 00:07:00+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '90 minutes', tstz, 'Europe/Berlin', TIMESTAMPTZ '2025-01-01 00:07:00+00') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''2 days'', tstz, ''Australia/Lord_Howe'', TIMESTAMPTZ ''2025-03-01 00:00:00+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '2 days', tstz, 'Australia/Lord_Howe', TIMESTAMPTZ '2025-03-01 00:00:00+00') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''3 months'', tstz, ''Pacific/Kiritimati'', TIMESTAMPTZ ''2024-05-01 00:00:00+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '3 months', tstz, 'Pacific/Kiritimati', TIMESTAMPTZ '2024-05-01 00:00:00+00') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''45 minutes'', tstz, ''Asia/Kathmandu'', TIMESTAMPTZ ''2025-06-01 00:00:00+00'')' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '45 minutes', tstz, 'Asia/Kathmandu', TIMESTAMPTZ '2025-06-01 00:00:00+00') AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_bin(INTERVAL ''3 hours'', ts, TIMESTAMP ''2025-01-01 00:00:07'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '3 hours', ts, TIMESTAMP '2025-01-01 00:00:07')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_bin(INTERVAL ''7 minutes'', ts, TIMESTAMP ''2025-01-01 00:00:07'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '7 minutes', ts, TIMESTAMP '2025-01-01 00:00:07')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_bin(INTERVAL ''1 hour'', ts, TIMESTAMP ''2025-01-01 00:00:00'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '1 hour', ts, TIMESTAMP '2025-01-01 00:00:00')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''15 minutes'', ts, INTERVAL ''5 minutes'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', ts, INTERVAL '5 minutes')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''15 minutes'', ts, INTERVAL ''15 minutes'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '15 minutes', ts, INTERVAL '15 minutes')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''1 hour'', ts, TIMESTAMP ''2025-01-01 00:17:00'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '1 hour', ts, TIMESTAMP '2025-01-01 00:17:00')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod time_bucket(INTERVAL ''30 minutes'', tstz, INTERVAL ''10 minutes'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '30 minutes', tstz, INTERVAL '10 minutes')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'tod date_trunc(''hour'', ts + INTERVAL ''20 minutes'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts + INTERVAL '20 minutes')::TIME AS k, count(*) AS c, sum(v) AS s FROM tod GROUP BY 1)
UNION ALL SELECT 'msn date_bin(INTERVAL ''150 milliseconds'', ts, TIMESTAMP ''2025-01-01 00:00:00.007'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_bin(INTERVAL '150 milliseconds', ts, TIMESTAMP '2025-01-01 00:00:00.007')::TIME AS k, count(*) AS c, sum(v) AS s FROM msn GROUP BY 1)
UNION ALL SELECT 'msn time_bucket(INTERVAL ''150 milliseconds'', ts, INTERVAL ''7 milliseconds'')::TIME' AS shape, k::VARCHAR AS k, c, s FROM (SELECT time_bucket(INTERVAL '150 milliseconds', ts, INTERVAL '7 milliseconds')::TIME AS k, count(*) AS c, sum(v) AS s FROM msn GROUP BY 1)
;

