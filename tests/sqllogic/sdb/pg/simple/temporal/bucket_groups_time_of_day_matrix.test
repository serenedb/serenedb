query
SELECT strftime(TIMESTAMP '2025-03-25 13:07:42', '%H:%M') AS naive, strftime(TIMESTAMPTZ '2025-03-30 00:30:00+00', '%H:%M') AS zoned, date_trunc('hour', TIMESTAMP '2025-03-25 13:07:42')::TIME::VARCHAR AS cast_time, time_bucket(INTERVAL '15 minutes', TIME '13:07:42')::VARCHAR AS time_bucket;
