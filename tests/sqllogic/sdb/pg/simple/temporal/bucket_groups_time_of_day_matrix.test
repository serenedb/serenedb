CREATE TABLE tod AS SELECT TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE AS ts, (TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS tstz, (TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE)::TIME AS tm, i AS v FROM range(20000) t(i);

statement ok
INSERT INTO tod VALUES (NULL, NULL, NULL, -1);

statement ok
CREATE TABLE msn AS SELECT TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i) MILLISECOND AS ts, (TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (i) MILLISECOND)::TIMESTAMPTZ AS tstz, i AS v FROM range(20000) t(i);

statement ok
INSERT INTO msn VALUES (NULL, NULL, -1);

statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
SET disabled_optimizers = 'compressed_materialization';

