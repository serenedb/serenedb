query
SELECT time_bucket(INTERVAL '1 day', TIMESTAMPTZ '2025-03-30 12:00:00+00', 'America/Havana', TIMESTAMPTZ '2025-01-01 05:00:00+00')::VARCHAR AS day_bucket, time_bucket(INTERVAL '1 month', TIMESTAMPTZ '2025-03-30 12:00:00+00', 'America/Havana', TIMESTAMPTZ '2024-02-15 05:00:00+00')::VARCHAR AS month_bucket, time_bucket(INTERVAL '90 minutes', TIMESTAMPTZ '2025-03-30 12:20:00+00', 'America/Havana', TIMESTAMPTZ '2025-01-01 00:07:00+00')::VARCHAR AS micros_bucket;
----
day_bucket	month_bucket	micros_bucket
2025-03-30 06:00:00+02	2025-03-01 06:00:00+01	2025-03-30 14:07:00+02

query
SELECT time_bucket(INTERVAL '1 day', TIMESTAMPTZ '2025-04-06 10:00:00+00', 'Australia/Lord_Howe', TIMESTAMPTZ '2025-03-01 00:00:00+00')::VARCHAR AS lord_howe, time_bucket(INTERVAL '2 months', TIMESTAMPTZ '2025-07-15 10:00:00+00', 'Pacific/Kiritimati', TIMESTAMPTZ '2024-05-01 00:00:00+00')::VARCHAR AS kiritimati;
