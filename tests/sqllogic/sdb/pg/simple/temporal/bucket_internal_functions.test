query
SELECT __internal_date_trunc_bucket(TIMESTAMP '2025-03-09 07:41:23.456789', 3600000000, 0) AS naive,
	__internal_date_trunc_bucket(TIMESTAMPTZ '2025-03-09 07:41:23.456789+00', 3600000000, 0) AS zoned,
	__internal_date_trunc_bucket(TIMESTAMP_NS '2025-03-09 07:41:23.456789123', 3600000000, 0) AS nanos,
	__internal_date_trunc_bucket(TIME '07:41:23.456789', 3600000000, 0) AS timed,
	__internal_date_trunc_month_bucket(TIMESTAMP '2025-03-09 07:41:23.456789', 3, 0) AS quarter,
	__internal_time_of_day_bucket(TIMESTAMP '2025-03-09 07:41:23.456789', 3600000000) AS slot;
