naive	zoned	timed	quarter	month	month_name	day_name	moy	dow
2025-08-26 00:00:00	2025-08-26 00:00:00+00	07:00:00	0055-01-01 00:00:00	0055-01-01 00:00:00+00	March	Sunday	3	0

statement ok
CREATE TABLE bi AS SELECT TIMESTAMP '2025-03-09 00:00:00' + INTERVAL (i * 937) SECOND AS ts,
	(TIMESTAMPTZ '2025-03-09 00:00:00+00' + INTERVAL (i * 937) SECOND) AS tstz,
	(TIMESTAMP_NS '2025-03-09 00:00:00' + INTERVAL (i * 937) SECOND)::TIMESTAMP_NS AS tsns,
	(TIME '00:00:00' + INTERVAL (i * 937) SECOND) AS tm,
	(i % 4) AS grp FROM range(400) t(i);

query
SELECT count(*) AS rows,
	count(*) FILTER (WHERE __internal_date_trunc_unbucket(__internal_date_trunc_bucket(ts, 3600000000, 0), 3600000000, 0)
		<> date_trunc('hour', ts)) AS naive_mismatch,
	count(*) FILTER (WHERE __internal_date_trunc_unbucket_tz(__internal_date_trunc_bucket(tstz, 3600000000, 0), 3600000000, 0)
		<> date_trunc('hour', tstz)) AS zoned_mismatch,
	count(*) FILTER (WHERE __internal_date_trunc_unbucket(__internal_date_trunc_bucket(tsns, 3600000000, 0), 3600000000, 0)
		<> date_trunc('hour', tsns)::TIMESTAMP) AS nanos_mismatch,
	count(*) FILTER (WHERE __internal_date_trunc_unbucket_time(__internal_date_trunc_bucket(tm, 3600000000, 0), 3600000000, 0)
		<> time_bucket(INTERVAL '1 hour', tm)) AS timed_mismatch,
	count(*) FILTER (WHERE __internal_date_trunc_month_unbucket(__internal_date_trunc_month_bucket(ts, 1, 0), 1, 0)
		<> date_trunc('month', ts)) AS month_mismatch
FROM bi;
----
rows	naive_mismatch	zoned_mismatch	nanos_mismatch	timed_mismatch	month_mismatch
400	0	0	0	0	0

statement ok
CREATE TABLE bw AS SELECT ts, tstz, grp, 3600000000 * (1 + grp) AS width, grp * 60000000 AS anchor FROM bi;

query
SELECT width, count(*) AS rows, count(DISTINCT __internal_date_trunc_bucket(ts, width, anchor)) AS naive,
	count(DISTINCT __internal_date_trunc_bucket(tstz, width, anchor)) AS zoned
FROM bw GROUP BY 1 ORDER BY 1;
----
width	rows	naive	zoned
3600000000	100	100	100
7200000000	100	52	52
10800000000	100	35	35
14400000000	100	26	26

query
SELECT count(*) AS rows, sum(__internal_date_trunc_bucket(ts, width, anchor)) AS total FROM bw WHERE width > 0;
----
rows	total
400	100790586

statement error
