483751	483751	483751	7	8100	7

query
SELECT __internal_date_trunc_unbucket(487824, 3600000000, 0) AS naive,
	__internal_date_trunc_unbucket_tz(487824, 3600000000, 0) AS zoned,
	__internal_date_trunc_unbucket_time(7, 3600000000, 0) AS timed,
	__internal_date_trunc_month_unbucket(220, 3, 0) AS quarter,
	__internal_date_trunc_month_unbucket_tz(660, 1, 0) AS month,
	__internal_month_name(3) AS month_name, __internal_day_name(0) AS day_name,
	__internal_month_of_year(TIMESTAMP '2025-03-09 07:41:23.456789') AS moy, __internal_day_of_week(DATE '2025-03-09') AS dow;
