statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE ci AS SELECT i AS v, TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE AS ts,
 (TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE)::DATE AS d FROM range(500) t(i);

statement ok
INSERT INTO ci VALUES (-1, NULL, NULL), (-2, TIMESTAMP 'infinity', DATE 'infinity'),
 (-3, TIMESTAMP '-infinity', DATE '-infinity');

statement ok
SET disabled_optimizers = 'expression_rewriter';

statement ok
CREATE OR REPLACE TABLE ref_ci AS
