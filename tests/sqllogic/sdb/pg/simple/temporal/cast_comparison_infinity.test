	(SELECT count(*) FROM (SELECT * FROM ref_ci EXCEPT ALL SELECT * FROM got_ci)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM got_ci EXCEPT ALL SELECT * FROM ref_ci)) AS gained
FROM ref_ci;
