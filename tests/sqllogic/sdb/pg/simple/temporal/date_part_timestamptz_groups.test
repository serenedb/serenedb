statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE tp AS SELECT (TIMESTAMP '2023-11-15 00:00:00' + INTERVAL (i * 977) MINUTE)::TIMESTAMPTZ AS tstz, i AS v FROM range(0, 1500) t(i);

statement ok
INSERT INTO tp VALUES (NULL, -1);

statement ok
CREATE TABLE tp_inf AS SELECT * FROM tp;

statement ok
INSERT INTO tp_inf VALUES (TIMESTAMPTZ 'infinity', -2);

statement ok
SET TimeZone = 'Europe/Berlin';

query
EXPLAIN SELECT year(tstz) AS y, month(tstz) AS m, count(*) AS c FROM tp GROUP BY 1, 2;
----
QUERY PLAN
╭─ PROJECTION ───────────────────────────────────────────────╮
│ Projections:                                               │
│ __internal_decompress_integral_bigint(#0, 2023),           │
│ CAST(#1 AS BIGINT), #2                                     │
│ ~750 rows                                                  │
╰──────────────────────────────┬─────────────────────────────╯
╭─ PERFECT_HASH_GROUP_BY ──────┴─────────────────────────────╮
│ Groups: #0, #1                                             │
│ Aggregates: count_star()                                   │
│ ~750 rows                                                  │
╰──────────────────────────────┬─────────────────────────────╯
╭─ PROJECTION ─────────────────┴─────────────────────────────╮
│ Projections:                                               │
│ __internal_compress_integral_utinyint("year"(tstz), 2023), │
│ CAST(m AS TINYINT)                                         │
│ ~1,501 rows                                                │
╰──────────────────────────────┬─────────────────────────────╯
╭─ SEQ_SCAN ───────────────────┴─────────────────────────────╮
│ Table: tp                                                  │
│ Type: Sequential Scan                                      │
│ Projections: tstz                                          │
│ ~1,501 rows                                                │
╰────────────────────────────────────────────────────────────╯

