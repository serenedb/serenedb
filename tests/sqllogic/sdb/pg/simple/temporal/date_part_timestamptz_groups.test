query
SELECT coalesce(year(tstz)::VARCHAR, 'null') AS y, coalesce(month(tstz)::VARCHAR, 'null') AS m, count(*) AS c FROM tp GROUP BY 1, 2 ORDER BY 1, 2 LIMIT 4;
----
y	m	c
2023	11	24
2023	12	46
2024	1	45
2024	10	46

