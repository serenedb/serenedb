2025	538
2026	353
null	2

statement ok
SET TimeZone = 'Pacific/Kiritimati';

query
SELECT min(year(tstz)) AS ylo, max(year(tstz)) AS yhi, min(hour(tstz)) AS hlo, max(hour(tstz)) AS hhi, min(timezone_hour(tstz)) AS tlo, max(timezone_hour(tstz)) AS thi, count(DISTINCT dayofweek(tstz)) AS dows FROM tp;
----
ylo	yhi	hlo	hhi	tlo	thi	dows
2023	2026	0	23	14	14	7

