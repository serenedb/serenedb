2024-04-01 00:00:00	793
null	2

query
SELECT coalesce(date_trunc(u, ts)::VARCHAR, 'null') AS h, count(*) AS c FROM events, (VALUES ('hour')) t(u) WHERE v < 3 GROUP BY 1 ORDER BY 1;
