CREATE TABLE epochs AS SELECT TIMESTAMP '1995-06-15 12:00:00' + INTERVAL (i * 11) DAY AS ts, i AS v FROM range(0, 1000) t(i);

statement ok
INSERT INTO epochs VALUES (NULL, -1), ('2024-02-29 10:00:00', -2), ('2023-12-31 23:59:59.999999', -3), ('2000-01-01 00:00:00', -4), ('1999-12-31 23:59:59', -5), ('2001-01-01 00:00:00', -6), ('2000-02-29 00:00:00', -8);

