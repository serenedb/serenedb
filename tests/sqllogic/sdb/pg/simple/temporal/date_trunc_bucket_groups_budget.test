statement ok
CREATE TABLE ld AS SELECT TIMESTAMP '2023-11-15 00:00:00' + INTERVAL (i * 977) MINUTE AS ts, (TIMESTAMP '2023-11-15 00:00:00' + INTERVAL (i * 977) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2023-11-15' + (i % 500)::INTEGER)::DATE AS d, i AS v FROM range(0, 1500) t(i);

statement ok
INSERT INTO ld VALUES (NULL, NULL, NULL, -1);

statement ok
SET TimeZone = 'Europe/Berlin';

query
EXPLAIN SELECT last_day(tstz) AS d, count(*) AS c FROM ld GROUP BY 1;
