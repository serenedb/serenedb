statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE hours AS SELECT TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (i * 37) MINUTE AS ts, (i % 1000)::INTEGER AS v FROM range(0, 30000) t(i);

query
EXPLAIN SELECT date_trunc('hour', ts) AS h, count(*) AS c FROM hours GROUP BY 1;
----
QUERY PLAN
╭─ PROJECTION ───────────────────────────────────────╮
│ Projections:                                       │
│ __internal_date_trunc_unbucket(#0, 3600000000, 0), │
│ #1                                                 │
│ ~15,000 rows                                       │
╰──────────────────────────┬─────────────────────────╯
╭─ PERFECT_HASH_GROUP_BY ──┴─────────────────────────╮
│ Groups: #0                                         │
│ Aggregates: count_star()                           │
│ ~15,000 rows                                       │
╰──────────────────────────┬─────────────────────────╯
╭─ PROJECTION ─────────────┴─────────────────────────╮
│ Projections:                                       │
│ __internal_date_trunc_bucket(ts, 3600000000, 0)    │
│ ~30,000 rows                                       │
╰──────────────────────────┬─────────────────────────╯
╭─ SEQ_SCAN ───────────────┴─────────────────────────╮
│ Table: hours                                       │
│ Type: Sequential Scan                              │
│ Projections: ts                                    │
│ ~30,000 rows                                       │
╰────────────────────────────────────────────────────╯

query
EXPLAIN SELECT date_trunc('hour', ts) AS h, count(*) AS c, sum(v) AS s, avg(v) AS a, min(v) AS lo, max(v) AS hi FROM hours GROUP BY 1;
