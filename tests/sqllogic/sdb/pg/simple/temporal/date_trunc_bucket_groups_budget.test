query
SELECT count(*) AS groups, sum(c) AS rows_total, min(h)::VARCHAR AS first, max(h)::VARCHAR AS last FROM (SELECT date_trunc('hour', ts) AS h, count(*) AS c FROM hours GROUP BY 1);
