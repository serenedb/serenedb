statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE prec AS SELECT ts::TIMESTAMP_NS AS ts_ns, ts::TIMESTAMP_MS AS ts_ms, ts::TIMESTAMP_S AS ts_s, ts, ts::TIMESTAMPTZ AS tstz, ts::DATE AS d, i AS v FROM (SELECT TIMESTAMP '2024-12-23 00:00:00' + INTERVAL (i * 37) MINUTE AS ts, i FROM range(0, 1500) t(i));

statement ok
INSERT INTO prec VALUES (NULL, NULL, NULL, NULL, NULL, NULL, -1);

statement ok
CREATE TABLE nsb AS SELECT ts_ns, ts_ns::TIMESTAMP_MS AS ts_ms, ts_ns::TIMESTAMP_S AS ts_s, 1 AS v FROM (VALUES (TIMESTAMP_NS '2025-01-01 23:59:59.9999996'), (TIMESTAMP_NS '2025-01-01 23:59:59.9999994'), (TIMESTAMP_NS '2025-01-02 00:00:00.0000004'), (TIMESTAMP_NS '2025-01-31 23:59:59.9999995'), (TIMESTAMP_NS '2025-02-01 00:00:00.0000005'), (TIMESTAMP_NS '1969-12-31 23:59:59.9999996'), (TIMESTAMP_NS '1969-12-31 23:59:59.9999985'), (TIMESTAMP_NS '1970-01-01 00:00:00.0000004'), (TIMESTAMP_NS '1969-12-28 23:59:59.9999999'), (NULL)) t(ts_ns);

statement ok
CREATE TABLE wide AS SELECT TIMESTAMP '1950-06-01 00:00:00' + INTERVAL (i * 29) DAY AS ts, i AS v FROM range(0, 1400) t(i);

