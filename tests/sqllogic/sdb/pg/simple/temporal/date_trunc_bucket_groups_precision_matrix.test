CREATE TABLE prec AS SELECT ts::TIMESTAMP_NS AS ts_ns, ts::TIMESTAMP_MS AS ts_ms, ts::TIMESTAMP_S AS ts_s, ts, ts::TIMESTAMPTZ AS tstz, ts::DATE AS d, i AS v FROM (SELECT TIMESTAMP '2024-12-23 00:00:00' + INTERVAL (i * 37) MINUTE + INTERVAL (i % 7) SECOND AS ts, i FROM range(0, 1500) t(i));

