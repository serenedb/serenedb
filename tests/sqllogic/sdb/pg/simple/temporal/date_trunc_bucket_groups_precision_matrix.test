CREATE TABLE nsb AS SELECT ts_ns, ts_ns::TIMESTAMP_MS AS ts_ms, ts_ns::TIMESTAMP_S AS ts_s, v FROM (SELECT TIMESTAMP_NS '2025-01-01 23:59:59.9999996' + INTERVAL (i) MICROSECOND AS ts_ns, i AS v FROM range(-3, 4) t(i) UNION ALL SELECT TIMESTAMP_NS '1969-12-31 23:59:59.9999996' + INTERVAL (i) MICROSECOND, 100 + i FROM range(-3, 4) t(i) UNION ALL SELECT TIMESTAMP_NS '2025-01-31 23:59:59.9999995' + INTERVAL (i) MICROSECOND, 200 + i FROM range(-3, 4) t(i) UNION ALL SELECT TIMESTAMP_NS '2025-01-01 00:00:00.0000004' + INTERVAL (i) MICROSECOND, 300 + i FROM range(-3, 4) t(i) UNION ALL SELECT TIMESTAMP_NS '1969-12-28 23:59:59.9999999' + INTERVAL (i) MICROSECOND, 400 + i FROM range(-3, 4) t(i) UNION ALL SELECT TIMESTAMP_NS '1970-01-01 00:00:00.0000005', 500 UNION ALL SELECT TIMESTAMP_NS '1969-12-31 23:59:59.9999985', 501 UNION ALL SELECT NULL, 502);

