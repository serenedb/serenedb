UNION ALL SELECT 'f6 ts %Y-%m-%d %H:%M:%S' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y-%m-%d %H:%M:%S') AS k, count(*) AS c, sum(v) AS s FROM tb GROUP BY 1)
