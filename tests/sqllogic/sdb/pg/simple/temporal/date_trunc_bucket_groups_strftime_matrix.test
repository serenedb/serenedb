statement ok
SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE tb AS SELECT TIMESTAMP '2024-12-23 00:00:00' + INTERVAL (i * 37) MINUTE AS ts, (TIMESTAMP '2024-12-23 00:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2024-12-23' + (i % 400)::INTEGER)::DATE AS d, i AS v FROM range(0, 1500) t(i);

statement ok
INSERT INTO tb VALUES (NULL, NULL, NULL, -1);

statement ok
CREATE TABLE tb_inf AS SELECT * FROM tb;

statement ok
INSERT INTO tb_inf VALUES (TIMESTAMP 'infinity', TIMESTAMPTZ 'infinity', DATE 'infinity', -2), (TIMESTAMP '-infinity', TIMESTAMPTZ '-infinity', DATE '-infinity', -3);

statement ok
CREATE TABLE tb_wide AS SELECT TIMESTAMP '1950-06-01 00:00:00' + INTERVAL (i * 29) DAY AS ts, (TIMESTAMP '1950-06-01 00:00:00' + INTERVAL (i * 29) DAY)::TIMESTAMPTZ AS tstz, (DATE '1950-06-01' + (i * 29)::INTEGER)::DATE AS d, i AS v FROM range(0, 1400) t(i);

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
CREATE TABLE ref_tb AS
SELECT 'f1 ts %Y' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y') AS k, count(*) AS c, sum(v) AS s FROM tb GROUP BY 1)
UNION ALL SELECT 'f2 ts %Y-%m' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y-%m') AS k, count(*) AS c, sum(v) AS s FROM tb GROUP BY 1)
UNION ALL SELECT 'f3 ts %Y-%m-%d' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y-%m-%d') AS k, count(*) AS c, sum(v) AS s FROM tb GROUP BY 1)
UNION ALL SELECT 'f4 ts %Y-%m-%d %H' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(ts, '%Y-%m-%d %H') AS k, count(*) AS c, sum(v) AS s FROM tb GROUP BY 1)
