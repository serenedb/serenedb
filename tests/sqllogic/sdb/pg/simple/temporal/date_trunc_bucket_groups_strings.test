2025-10-26 02	3
2025-10-26 03	2

query
SELECT coalesce(monthname(tstz), 'null') AS m, coalesce(dayname(tstz), 'null') AS d, count(*) AS c FROM tb_inf WHERE v BETWEEN 0 AND 40 OR v < 0 GROUP BY 1, 2 ORDER BY 1, 2;
