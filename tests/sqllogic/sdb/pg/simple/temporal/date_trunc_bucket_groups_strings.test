statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE tb AS SELECT TIMESTAMP '2025-09-28 00:00:00' + INTERVAL (i * 37) MINUTE AS ts, (TIMESTAMP '2025-09-28 00:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2025-09-28' + (i % 400)::INTEGER)::DATE AS d, i AS v FROM range(0, 1500) t(i);

statement ok
INSERT INTO tb VALUES (NULL, NULL, NULL, -1);

statement ok
CREATE TABLE tb_inf AS SELECT * FROM tb;

statement ok
INSERT INTO tb_inf VALUES (TIMESTAMP 'infinity', TIMESTAMPTZ 'infinity', DATE 'infinity', -2);

statement ok
SET TimeZone = 'Europe/Berlin';

