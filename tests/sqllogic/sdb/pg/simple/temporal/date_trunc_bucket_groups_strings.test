SELECT strftime(tstz, '%Y-%m-%d %H') AS h, count(*) AS c FROM tb WHERE tstz >= '2025-10-25 23:30:00+00' AND tstz < '2025-10-26 03:00:00+00' GROUP BY 1 ORDER BY 1;
