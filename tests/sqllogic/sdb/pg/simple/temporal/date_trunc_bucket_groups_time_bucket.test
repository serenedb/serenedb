SELECT coalesce((tstz::DATE)::VARCHAR, 'null') AS d, count(*) AS c FROM tb WHERE tstz >= '2025-10-24 22:00:00+00' AND tstz < '2025-10-27 23:00:00+00' OR tstz IS NULL GROUP BY 1 ORDER BY 1;
