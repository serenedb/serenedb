query
EXPLAIN SELECT time_bucket(INTERVAL '1 day', tstz, CASE WHEN v % 2 = 0 THEN 'Europe/Berlin' ELSE 'UTC' END) AS b, count(*) AS c FROM dst GROUP BY 1;
