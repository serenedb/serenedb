statement ok
SET TimeZone = 'Asia/Tokyo';

statement ok
CREATE TABLE dst AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 41) MINUTE AS tstz, i AS v FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 41) MINUTE, 1000 + i FROM range(0, 400) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-04-04 00:00:00+00' + INTERVAL (i * 41) MINUTE, 2000 + i FROM range(0, 200) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-09-05 00:00:00+00' + INTERVAL (i * 41) MINUTE, 3000 + i FROM range(0, 200) t(i));

statement ok
INSERT INTO dst VALUES (NULL, -1);

statement ok
CREATE TABLE old AS SELECT TIMESTAMPTZ '1998-12-25 00:00:00+00' + INTERVAL (i * 173) MINUTE AS tstz, i AS v FROM range(0, 1200) t(i);

query
EXPLAIN SELECT time_bucket(INTERVAL '7 days', tstz, 'Europe/Berlin') AS b, count(*) AS c FROM dst GROUP BY 1;
