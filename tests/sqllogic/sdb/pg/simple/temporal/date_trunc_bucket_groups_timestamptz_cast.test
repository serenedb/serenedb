query
SELECT coalesce(date_trunc('minute', tz_ns::TIMESTAMP_NS)::VARCHAR, 'null') AS m, count(*) AS c, sum(v) AS s FROM tzc GROUP BY 1 ORDER BY 1 LIMIT 4;
----
m	c	s
2025-09-23 00:00:00	9	36
2025-09-23 00:01:00	9	117
2025-09-23 00:02:00	8	172
2025-09-23 00:03:00	9	270

query
SELECT coalesce(date_trunc('minute', tz_ns::TIMESTAMP_NS)::VARCHAR, 'null') AS m, count(*) AS c FROM tzc GROUP BY 1 EXCEPT SELECT coalesce(date_trunc('minute', tz::TIMESTAMP)::VARCHAR, 'null') AS m, count(*) AS c FROM tzc GROUP BY 1;
----
m	c

query
