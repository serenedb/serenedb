statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE tzc AS SELECT ts::TIMESTAMPTZ_NS AS tz_ns, ts AS tz, i AS v FROM (SELECT TIMESTAMPTZ '2025-09-23 00:00:00+00' + INTERVAL (i * 7) SECOND + INTERVAL (i % 1000) MICROSECOND AS ts, i FROM range(0, 3000) t(i));

statement ok
INSERT INTO tzc VALUES (NULL, NULL, -1);

statement ok
CREATE TABLE tzb (tz_ns TIMESTAMPTZ_NS, v INTEGER);

statement ok
INSERT INTO tzb VALUES ('1969-12-31 23:59:59.9999996+00', 1), ('1969-12-31 23:59:59.9999994+00', 2), ('2025-09-23 00:00:59.9999995+00', 3), ('2025-09-23 00:00:59.9999994+00', 4), ('2025-09-23 00:01:00+00', 5), (NULL, 6);

statement ok
CREATE TABLE tzinf (tz_ns TIMESTAMPTZ_NS, v INTEGER);

statement ok
INSERT INTO tzinf VALUES ('2025-09-23 00:00:01+00', 1), ('infinity', 2), ('-infinity', 3), ('2025-09-23 00:02:01+00', 4);

query
EXPLAIN SELECT date_trunc('minute', tz_ns::TIMESTAMP_NS) AS m, count(*) AS c FROM tzc GROUP BY 1;
----
QUERY PLAN
╭─ PROJECTION ──────────────────────────────────────────────────────────────────────────────╮
│ Projections:                                                                              │
│ __internal_date_trunc_unbucket(#0, 60000000, 0), #1                                       │
│ ~1,500 rows                                                                               │
╰─────────────────────────────────────────────┬─────────────────────────────────────────────╯
╭─ PERFECT_HASH_GROUP_BY ─────────────────────┴─────────────────────────────────────────────╮
