query
SELECT date_trunc('hour', ts)::VARCHAR AS h, count(*) AS c, min(v) AS lo FROM tz_fall WHERE ts >= '2025-10-25 23:30:00+00' AND ts < '2025-10-26 03:00:00+00' GROUP BY 1 ORDER BY 1;
----
h	c	lo
2025-10-26 01:00:00+02	1	1089
2025-10-26 02:00:00+01	3	1090
2025-10-26 03:00:00+01	2	1093

query
SELECT date_trunc('hour', ts)::VARCHAR AS h, count(*) AS c FROM tz_spring WHERE ts >= '2025-03-29 23:30:00+00' AND ts < '2025-03-30 03:00:00+00' GROUP BY 1 ORDER BY 1;
----
h	c
2025-03-30 00:00:00+01	1
2025-03-30 01:00:00+01	2
2025-03-30 03:00:00+02	2
2025-03-30 04:00:00+02	1

query
SELECT coalesce(date_trunc('day', ts)::VARCHAR, 'null') AS d, count(*) AS c FROM tz_fall WHERE ts >= '2025-10-24 22:00:00+00' AND ts < '2025-10-27 23:00:00+00' OR ts IS NULL GROUP BY 1 ORDER BY 1;
----
d	c
2025-10-25 00:00:00+02	39
2025-10-26 00:00:00+02	41
2025-10-27 00:00:00+01	38
null	1

query
