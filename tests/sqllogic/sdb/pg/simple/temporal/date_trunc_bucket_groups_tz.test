statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE tz_fall AS SELECT (TIMESTAMP '2025-09-28 00:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS ts, i AS v FROM range(0, 1500) t(i);

statement ok
INSERT INTO tz_fall VALUES (NULL, -1);

statement ok
CREATE TABLE tz_spring AS SELECT (TIMESTAMP '2025-03-15 00:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS ts, i AS v FROM range(0, 1500) t(i);

statement ok
CREATE TABLE tz_minutes AS SELECT (TIMESTAMP '2025-10-25 12:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS ts, i AS v FROM range(0, 100) t(i);

query
SELECT date_trunc('hour', ts)::VARCHAR AS h, count(*) AS c FROM tz_fall WHERE ts >= '2025-10-25 23:30:00+00' AND ts < '2025-10-26 03:00:00+00' GROUP BY 1 ORDER BY 1;
----
h	c
2025-10-25 23:00:00+00	1
2025-10-26 00:00:00+00	2
2025-10-26 01:00:00+00	1
2025-10-26 02:00:00+00	2

statement ok
