CREATE TABLE old AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '1998-12-25 00:00:00+00' + INTERVAL (i * 173) MINUTE AS tstz, i AS v FROM range(0, 300) t(i) UNION ALL SELECT TIMESTAMPTZ '1969-12-20 00:00:00+00' + INTERVAL (i * 173) MINUTE, 1000 + i FROM range(0, 300) t(i));

statement ok
CREATE TABLE naive AS SELECT (tstz AT TIME ZONE 'UTC')::TIMESTAMP AS ts, (tstz AT TIME ZONE 'UTC')::DATE AS d, v FROM dst WHERE tstz IS NOT NULL;

