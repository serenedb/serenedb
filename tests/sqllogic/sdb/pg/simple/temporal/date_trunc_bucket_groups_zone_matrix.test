query
SELECT shape, k, c, s FROM (SELECT * FROM got_8 EXCEPT ALL SELECT * FROM ref_8) ORDER BY 1, 2;
----
shape	k	c	s

query
SELECT shape, k, c, s FROM (SELECT * FROM ref_8 EXCEPT ALL SELECT * FROM got_8) ORDER BY 1, 2;
----
shape	k	c	s

query
SELECT count(*) AS rows, count(DISTINCT shape) AS shapes FROM got_8;
----
rows	shapes
29206	73

