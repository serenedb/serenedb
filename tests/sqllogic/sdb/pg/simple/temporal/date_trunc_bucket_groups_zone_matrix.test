SELECT TIMESTAMPTZ '2022-09-20 12:00:00+00' + INTERVAL (i * 53) MINUTE, 17000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2019-02-15 12:00:00+00' + INTERVAL (i * 53) MINUTE, 18000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2020-12-26 12:00:00+00' + INTERVAL (i * 53) MINUTE, 19000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2019-10-05 12:00:00+00' + INTERVAL (i * 53) MINUTE, 20000 + i FROM range(0, 100) t(i)) t(tstz, v);

