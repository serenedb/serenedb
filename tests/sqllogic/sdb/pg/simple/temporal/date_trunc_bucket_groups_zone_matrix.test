UNION ALL SELECT 'old cast date' AS shape, k::VARCHAR AS k, c, s FROM (SELECT tstz::DATE AS k, count(*) AS c, sum(v) AS s FROM old GROUP BY 1)
UNION ALL SELECT 'ym' AS shape, k::VARCHAR AS k, c, s FROM (SELECT year(tstz) * 100 + month(tstz) AS k, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1)
UNION ALL SELECT 'hour part' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_part('hour', tstz) AS k, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1)
UNION ALL SELECT 'dow' AS shape, k::VARCHAR AS k, c, s FROM (SELECT dayofweek(tstz) AS k, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1)
UNION ALL SELECT 'naive to tz hour' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', ts::TIMESTAMPTZ) AS k, count(*) AS c, sum(v) AS s FROM naive GROUP BY 1)
UNION ALL SELECT 'naive to tz day' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', ts::TIMESTAMPTZ) AS k, count(*) AS c, sum(v) AS s FROM naive GROUP BY 1)
UNION ALL SELECT 'date to tz day' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('day', d::TIMESTAMPTZ) AS k, count(*) AS c, sum(v) AS s FROM naive GROUP BY 1)
UNION ALL SELECT 'tz to naive hour' AS shape, k::VARCHAR AS k, c, s FROM (SELECT date_trunc('hour', tstz::TIMESTAMP) AS k, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1)
UNION ALL SELECT 'tz to naive day' AS shape, k::VARCHAR AS k, c, s FROM (SELECT strftime(tstz::TIMESTAMP, '%Y-%m-%d') AS k, count(*) AS c, sum(v) AS s FROM dst GROUP BY 1)
