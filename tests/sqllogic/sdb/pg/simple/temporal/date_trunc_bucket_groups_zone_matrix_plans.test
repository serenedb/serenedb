statement ok
SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE dst AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '2025-03-07 00:00:00+00' + INTERVAL (i * 53) MINUTE, 0 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 53) MINUTE, 1000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-04-04 00:00:00+00' + INTERVAL (i * 53) MINUTE, 2000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-09-05 00:00:00+00' + INTERVAL (i * 53) MINUTE, 3000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-03 00:00:00+00' + INTERVAL (i * 53) MINUTE, 4000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 53) MINUTE, 5000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-31 12:00:00+00' + INTERVAL (i * 53) MINUTE, 6000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-12-30 12:00:00+00' + INTERVAL (i * 53) MINUTE, 7000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-02-28 12:00:00+00' + INTERVAL (i * 53) MINUTE, 8000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-03-29 00:00:00+00' + INTERVAL (i * 53) MINUTE, 9000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2011-12-29 00:00:00+00' + INTERVAL (i * 53) MINUTE, 10000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '1993-08-19 00:00:00+00' + INTERVAL (i * 53) MINUTE, 11000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2018-05-03 12:00:00+00' + INTERVAL (i * 53) MINUTE, 12000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2016-04-30 12:00:00+00' + INTERVAL (i * 53) MINUTE, 13000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2021-10-28 12:00:00+00' + INTERVAL (i * 53) MINUTE, 14000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2022-10-27 12:00:00+00' + INTERVAL (i * 53) MINUTE, 15000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-03-22 12:00:00+00' + INTERVAL (i * 53) MINUTE, 16000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2022-09-20 12:00:00+00' + INTERVAL (i * 53) MINUTE, 17000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2019-02-15 12:00:00+00' + INTERVAL (i * 53) MINUTE, 18000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2020-12-26 12:00:00+00' + INTERVAL (i * 53) MINUTE, 19000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2019-10-05 12:00:00+00' + INTERVAL (i * 53) MINUTE, 20000 + i FROM range(0, 100) t(i)) t(tstz, v);

statement ok
INSERT INTO dst VALUES (NULL, -1);

statement ok
CREATE TABLE old AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '1998-12-25 00:00:00+00' + INTERVAL (i * 173) MINUTE AS tstz, i AS v FROM range(0, 300) t(i) UNION ALL SELECT TIMESTAMPTZ '1969-12-20 00:00:00+00' + INTERVAL (i * 173) MINUTE, 1000 + i FROM range(0, 300) t(i));

statement ok
CREATE TABLE naive AS SELECT (tstz AT TIME ZONE 'UTC')::TIMESTAMP AS ts, (tstz AT TIME ZONE 'UTC')::DATE AS d, v FROM dst WHERE tstz IS NOT NULL;

statement ok
SET TimeZone = 'Europe/Berlin';

query
EXPLAIN SELECT date_trunc('hour', tstz) AS h, count(*) AS c FROM old GROUP BY 1;
----
QUERY PLAN
╭─ HASH_GROUP_BY ──────────╮
│ Groups: #0               │
│ Aggregates: count_star() │
│ ~300 rows                │
╰─────────────┬────────────╯
╭─ PROJECTION ┴────────────╮
│ Projections: h           │
│ ~600 rows                │
╰─────────────┬────────────╯
╭─ SEQ_SCAN ──┴────────────╮
│ Table: old               │
│ Type: Sequential Scan    │
│ Projections: tstz        │
│ ~600 rows                │
╰──────────────────────────╯

