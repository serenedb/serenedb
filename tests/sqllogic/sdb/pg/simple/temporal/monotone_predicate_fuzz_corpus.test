query
SELECT count(*) AS shapes, sum(c) AS matched,
	(SELECT count(*) FROM (SELECT * FROM p_off_kathmandu EXCEPT ALL SELECT * FROM p_on_kathmandu)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM p_on_kathmandu EXCEPT ALL SELECT * FROM p_off_kathmandu)) AS gained
FROM p_on_kathmandu;
