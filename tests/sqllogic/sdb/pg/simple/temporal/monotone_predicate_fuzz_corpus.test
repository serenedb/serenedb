CREATE OR REPLACE TABLE p_off_havana AS
SELECT 0 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE tstz IS NOT NULL
UNION ALL SELECT 1 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE CASE WHEN (time_bucket(INTERVAL '1 day', ts) + INTERVAL '1 day') = TIMESTAMP '2025-04-01 00:00:00' THEN 1 ELSE 0 END = 1
UNION ALL SELECT 2 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE date_trunc('quarter', d) IN (NULL::DATE, DATE '1600-06-01', DATE '2400-06-01')
UNION ALL SELECT 3 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE (date_trunc('hour', time_bucket(INTERVAL '7 minutes', time_bucket(INTERVAL '2 days', tstz))) <= TIMESTAMPTZ '-infinity') OR (v % 7 = 0)
UNION ALL SELECT 4 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE date_trunc('quarter', tstz) BETWEEN NULL::TIMESTAMPTZ AND TIMESTAMPTZ '2025-01-01 00:00:00'
UNION ALL SELECT 5 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE floor(f / 900) * 60 IS NULL
UNION ALL SELECT 6 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE last_day(ts) >= DATE 'infinity'
UNION ALL SELECT 7 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE epoch_ms(((ts + INTERVAL '30 minutes') + INTERVAL '-1 day')) = -1
UNION ALL SELECT 8 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE tstz BETWEEN NULL::TIMESTAMPTZ AND NULL::TIMESTAMPTZ
UNION ALL SELECT 9 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE time_bucket(INTERVAL '7 minutes', tstz) < TIMESTAMPTZ '2025-01-01 00:00:00'
UNION ALL SELECT 10 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE NOT (date_trunc('year', ts) <= TIMESTAMP '2400-06-01 12:00:00')
UNION ALL SELECT 11 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE date_bin(INTERVAL '3 hours', time_bucket(INTERVAL '2 days', ts), TIMESTAMP '2025-01-01 00:00:07') > TIMESTAMP '2025-04-01 00:00:00'
