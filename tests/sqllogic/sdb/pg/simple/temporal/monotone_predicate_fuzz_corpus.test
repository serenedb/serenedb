CREATE OR REPLACE TABLE p_on_havana AS
SELECT 0 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE tstz IS NOT NULL
UNION ALL SELECT 1 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE CASE WHEN (time_bucket(INTERVAL '1 day', ts) + INTERVAL '1 day') = TIMESTAMP '2025-04-01 00:00:00' THEN 1 ELSE 0 END = 1
UNION ALL SELECT 2 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
	coalesce(min(v), -1) AS lo, coalesce(max(v), -1) AS hi FROM pf WHERE date_trunc('quarter', d) IN (NULL::DATE, DATE '1600-06-01', DATE '2400-06-01')
UNION ALL SELECT 3 AS shape, count(*) AS c, coalesce(sum(v), 0) AS s,
