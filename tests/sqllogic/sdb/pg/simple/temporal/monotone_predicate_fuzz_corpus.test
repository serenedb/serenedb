statement ok
CREATE OR REPLACE TABLE pf AS
SELECT i AS v, TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE AS ts,
 (TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE)::TIMESTAMPTZ AS tstz,
 (TIMESTAMP '2025-03-25 00:00:00' + INTERVAL (i * 37) MINUTE)::DATE AS d,
 ((i - 500) * 7.5)::DOUBLE AS f, ((i % 60000) - 30000)::SMALLINT AS s,
 (i - 1000000)::INTEGER AS n FROM range(2000) t(i);

statement ok
INSERT INTO pf VALUES (-1, NULL, NULL, NULL, NULL, NULL, NULL), (-2, TIMESTAMP 'infinity', TIMESTAMPTZ 'infinity',
 DATE 'infinity', 'infinity'::DOUBLE, 32767, 2147483647), (-3, TIMESTAMP '-infinity', TIMESTAMPTZ '-infinity',
 DATE '-infinity', '-infinity'::DOUBLE, -32768, -2147483648),
 (-4, TIMESTAMP '1600-06-01 12:00:00', TIMESTAMPTZ '1600-06-01 12:00:00+00', DATE '1600-06-01', 0.0, 0, 0),
 (-5, TIMESTAMP '2400-06-01 12:00:00', TIMESTAMPTZ '2400-06-01 12:00:00+00', DATE '2400-06-01', 1e18, 7, 7);

