query
SELECT count(*) AS shapes, sum(c) AS matched,
	(SELECT count(*) FROM (SELECT * FROM p_off_berlin EXCEPT ALL SELECT * FROM p_on_berlin)) AS lost,
	(SELECT count(*) FROM (SELECT * FROM p_on_berlin EXCEPT ALL SELECT * FROM p_off_berlin)) AS gained
FROM p_on_berlin;
