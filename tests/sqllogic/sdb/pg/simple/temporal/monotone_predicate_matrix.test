CREATE TABLE ref_europe_berlin AS
SELECT 'Europe/Berlin date_trunc(''day'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Europe/Berlin' AND date_trunc('day', tstz) = date_trunc('day', TIMESTAMPTZ '2025-10-26 01:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Europe/Berlin date_trunc(''hour'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Europe/Berlin' AND date_trunc('hour', tstz) = date_trunc('hour', TIMESTAMPTZ '2025-10-26 01:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Europe/Berlin date_trunc(''week'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Europe/Berlin' AND date_trunc('week', tstz) = date_trunc('week', TIMESTAMPTZ '2025-10-26 01:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Europe/Berlin tstz::DATE = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Europe/Berlin' AND tstz::DATE = (TIMESTAMPTZ '2025-10-26 01:00:00+00' - INTERVAL '1 day')::DATE
UNION ALL SELECT 'Europe/Berlin time_bucket(INTERVAL ''1 day'', tstz, ''Europe/Berlin'') = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Europe/Berlin' AND time_bucket(INTERVAL '1 day', tstz, 'Europe/Berlin') = time_bucket(INTERVAL '1 day', TIMESTAMPTZ '2025-10-26 01:00:00+00' - INTERVAL '1 day', 'Europe/Berlin')
UNION ALL SELECT 'Europe/Berlin time_bucket(INTERVAL ''6 hours'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Europe/Berlin' AND time_bucket(INTERVAL '6 hours', tstz) = time_bucket(INTERVAL '6 hours', TIMESTAMPTZ '2025-10-26 01:00:00+00' - INTERVAL '1 day')
