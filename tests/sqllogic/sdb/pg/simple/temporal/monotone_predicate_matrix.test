CREATE TABLE ref_p AS
SELECT 'date_trunc(''day'', ts) = TIMESTAMP ''2025-01-15''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) = TIMESTAMP '2025-01-15'
UNION ALL SELECT 'date_trunc(''hour'', ts) = TIMESTAMP ''2025-01-15''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('hour', ts) = TIMESTAMP '2025-01-15'
UNION ALL SELECT 'date_trunc(''month'', ts) = TIMESTAMP ''2025-01-15''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('month', ts) = TIMESTAMP '2025-01-15'
UNION ALL SELECT 'time_bucket(INTERVAL ''15 minutes'', ts) = TIMESTAMP ''2025-01-15''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE time_bucket(INTERVAL '15 minutes', ts) = TIMESTAMP '2025-01-15'
UNION ALL SELECT 'time_bucket(INTERVAL ''1 day'', ts, TIMESTAMP ''2000-01-01 06:00'') = TIMESTAMP ''2025-01-15''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE time_bucket(INTERVAL '1 day', ts, TIMESTAMP '2000-01-01 06:00') = TIMESTAMP '2025-01-15'
UNION ALL SELECT 'date_bin(INTERVAL ''2 hours'', ts, TIMESTAMP ''2000-01-01 01:00'') = TIMESTAMP ''2025-01-15''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_bin(INTERVAL '2 hours', ts, TIMESTAMP '2000-01-01 01:00') = TIMESTAMP '2025-01-15'
