UNION ALL SELECT 'not in' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) NOT IN (TIMESTAMP '2025-01-15', TIMESTAMP '2025-01-17')
UNION ALL SELECT 'or context' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) = TIMESTAMP '2025-01-15' OR sev = 3
UNION ALL SELECT 'or nulled' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE year(ts) = 2025 OR sev = 3
UNION ALL SELECT 'and context' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE year(ts) = 2025 AND floor(price / 100) = 3
UNION ALL SELECT 'not context' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE NOT (date_trunc('day', ts) = TIMESTAMP '2025-01-15')
UNION ALL SELECT 'not nulled' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE NOT (year(ts) = 2024)
UNION ALL SELECT 'nested not' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE NOT (year(ts) = 2025 OR sev = 3)
UNION ALL SELECT 'case in filter' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE CASE WHEN date_trunc('day', ts) = TIMESTAMP '2025-01-15' THEN sev = 1 ELSE sev = 2 END
UNION ALL SELECT 'coalesce in filter' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE coalesce(year(ts) = 2025, false)
UNION ALL SELECT 'is distinct' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) IS DISTINCT FROM TIMESTAMP '2025-01-15'
UNION ALL SELECT 'is not distinct' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) IS NOT DISTINCT FROM TIMESTAMP '2025-01-15'
UNION ALL SELECT 'reversed' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE TIMESTAMP '2025-01-15' = date_trunc('day', ts)
UNION ALL SELECT 'reversed lt' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE TIMESTAMP '2025-01-15' < date_trunc('day', ts)
UNION ALL SELECT 'cast const' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) = '2025-01-15'::TIMESTAMP
UNION ALL SELECT 'string const' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) = '2025-01-15'
UNION ALL SELECT 'date const' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE date_trunc('day', ts) = DATE '2025-01-15'
UNION ALL SELECT 'having' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM g WHERE 1 = 1;

