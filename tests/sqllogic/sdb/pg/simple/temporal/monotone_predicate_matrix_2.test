CREATE TABLE got_pacific_kiritimati AS
SELECT 'Pacific/Kiritimati date_trunc(''day'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Pacific/Kiritimati' AND date_trunc('day', tstz) = date_trunc('day', TIMESTAMPTZ '1994-12-31 10:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Pacific/Kiritimati date_trunc(''hour'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Pacific/Kiritimati' AND date_trunc('hour', tstz) = date_trunc('hour', TIMESTAMPTZ '1994-12-31 10:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Pacific/Kiritimati date_trunc(''week'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Pacific/Kiritimati' AND date_trunc('week', tstz) = date_trunc('week', TIMESTAMPTZ '1994-12-31 10:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Pacific/Kiritimati tstz::DATE = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Pacific/Kiritimati' AND tstz::DATE = (TIMESTAMPTZ '1994-12-31 10:00:00+00' - INTERVAL '1 day')::DATE
