CREATE TABLE ref_africa_cairo AS
SELECT 'Africa/Cairo date_trunc(''day'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Africa/Cairo' AND date_trunc('day', tstz) = date_trunc('day', TIMESTAMPTZ '2023-10-26 21:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Africa/Cairo date_trunc(''hour'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Africa/Cairo' AND date_trunc('hour', tstz) = date_trunc('hour', TIMESTAMPTZ '2023-10-26 21:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Africa/Cairo date_trunc(''week'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Africa/Cairo' AND date_trunc('week', tstz) = date_trunc('week', TIMESTAMPTZ '2023-10-26 21:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'Africa/Cairo tstz::DATE = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Africa/Cairo' AND tstz::DATE = (TIMESTAMPTZ '2023-10-26 21:00:00+00' - INTERVAL '1 day')::DATE
UNION ALL SELECT 'Africa/Cairo time_bucket(INTERVAL ''1 day'', tstz, ''Africa/Cairo'') = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'Africa/Cairo' AND time_bucket(INTERVAL '1 day', tstz, 'Africa/Cairo') = time_bucket(INTERVAL '1 day', TIMESTAMPTZ '2023-10-26 21:00:00+00' - INTERVAL '1 day', 'Africa/Cairo')
