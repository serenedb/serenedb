SET TimeZone = 'Europe/Berlin';

statement ok
CREATE TABLE g AS SELECT TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE AS ts, (TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE)::TIMESTAMPTZ AS tstz, (DATE '2024-12-28' + (i % 300)::INTEGER)::DATE AS d, (i % 1000)::DOUBLE AS price, (i % 5)::SMALLINT AS sev, i AS v, (TIMESTAMP '2024-12-28 00:00:00' + INTERVAL (i * 7) MINUTE)::TIMESTAMP_MS AS tsms FROM range(50000) t(i);

statement ok
INSERT INTO g VALUES (NULL, NULL, NULL, NULL, NULL, -1, NULL), ('infinity', 'infinity', 'infinity', 'inf', 1, -2, NULL), ('-infinity', '-infinity', '-infinity', '-inf', 2, -3, NULL), (TIMESTAMP '2025-01-15 12:00:00', TIMESTAMPTZ '2025-01-15 12:00:00+00', DATE '2025-01-15', 'nan', 3, -4, TIMESTAMP '2025-01-15 12:00:00');

statement ok
CREATE TABLE zt AS SELECT zone, make_timestamptz(epoch_us(t) + (m - 576) * 300000000 + (m * 7919) % 300000000) AS tstz, m AS v FROM (VALUES ('Antarctica/Casey', TIMESTAMPTZ '2010-03-04 15:00:00+00'), ('Antarctica/Casey', TIMESTAMPTZ '2012-02-21 17:00:00+00'), ('America/Havana', TIMESTAMPTZ '2025-11-02 05:00:00+00'), ('America/Havana', TIMESTAMPTZ '2025-03-09 05:00:00+00'), ('Europe/Berlin', TIMESTAMPTZ '2025-10-26 01:00:00+00'), ('Europe/Berlin', TIMESTAMPTZ '2025-03-30 01:00:00+00'), ('Australia/Lord_Howe', TIMESTAMPTZ '2025-04-05 15:00:00+00'), ('Pacific/Kiritimati', TIMESTAMPTZ '1994-12-31 10:00:00+00'), ('Africa/Cairo', TIMESTAMPTZ '2023-10-26 21:00:00+00'), ('America/Sao_Paulo', TIMESTAMPTZ '2018-02-18 02:00:00+00')) a(zone, t), range(0, 1153) r(m);

statement ok
SET TimeZone = 'America/Havana';

statement ok
SET disabled_optimizers = 'expression_rewriter';

statement ok
CREATE TABLE ref_america_havana AS
SELECT 'America/Havana date_trunc(''day'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND date_trunc('day', tstz) = date_trunc('day', TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'America/Havana date_trunc(''hour'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND date_trunc('hour', tstz) = date_trunc('hour', TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'America/Havana date_trunc(''week'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND date_trunc('week', tstz) = date_trunc('week', TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'America/Havana tstz::DATE = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND tstz::DATE = (TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')::DATE
UNION ALL SELECT 'America/Havana time_bucket(INTERVAL ''1 day'', tstz, ''America/Havana'') = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND time_bucket(INTERVAL '1 day', tstz, 'America/Havana') = time_bucket(INTERVAL '1 day', TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day', 'America/Havana')
UNION ALL SELECT 'America/Havana time_bucket(INTERVAL ''6 hours'', tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND time_bucket(INTERVAL '6 hours', tstz) = time_bucket(INTERVAL '6 hours', TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'America/Havana year(tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND year(tstz) = year(TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')
UNION ALL SELECT 'America/Havana last_day(tstz) = - INTERVAL ''1 day''' AS shape, count(*) AS c, coalesce(sum(v), 0) AS s FROM zt WHERE zone = 'America/Havana' AND last_day(tstz) = last_day(TIMESTAMPTZ '2025-11-02 05:00:00+00' - INTERVAL '1 day')
