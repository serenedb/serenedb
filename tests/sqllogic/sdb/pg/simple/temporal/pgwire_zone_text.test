control substitution on

statement ok
CREATE TABLE wire AS SELECT * FROM (VALUES
	(0, TIMESTAMPTZ '1600-01-01 12:00:00+00'),
	(1, TIMESTAMPTZ '1850-07-04 12:00:00+00'),
	(2, TIMESTAMPTZ '1899-12-31 23:30:00+00'),
	(3, TIMESTAMPTZ '1900-01-01 00:30:00+00'),
	(4, TIMESTAMPTZ '1901-06-01 00:00:00+00'),
	(5, TIMESTAMPTZ '1937-07-01 12:00:00+00'),
	(6, TIMESTAMPTZ '1969-12-31 23:59:59.999999+00'),
	(7, TIMESTAMPTZ '1970-01-01 00:00:00+00'),
	(8, TIMESTAMPTZ '2025-03-30 00:30:00+00'),
	(9, TIMESTAMPTZ '2025-03-30 01:30:00+00'),
	(10, TIMESTAMPTZ '2025-06-01 12:00:00+00'),
	(11, TIMESTAMPTZ '2025-10-26 00:30:00+00'),
	(12, TIMESTAMPTZ '2025-10-26 01:30:00+00'),
	(13, TIMESTAMPTZ '2299-12-31 12:00:00+00'),
	(14, TIMESTAMPTZ '2300-06-01 00:00:00+00'),
	(15, TIMESTAMPTZ '2400-01-01 00:00:00+00')) t(i, t);

statement ok
CREATE TABLE walls AS SELECT * FROM (VALUES
	(0, TIMESTAMP '1600-01-01 12:00:00'),
	(1, TIMESTAMP '1899-12-31 23:30:00'),
	(2, TIMESTAMP '1900-01-01 00:30:00'),
	(3, TIMESTAMP '1970-01-01 00:00:00'),
	(4, TIMESTAMP '2025-03-30 02:30:00'),
	(5, TIMESTAMP '2025-03-30 03:30:00'),
	(6, TIMESTAMP '2025-06-01 12:00:00'),
	(7, TIMESTAMP '2025-10-26 01:30:00'),
	(8, TIMESTAMP '2025-10-26 02:30:00'),
	(9, TIMESTAMP '2299-12-31 12:00:00'),
	(10, TIMESTAMP '2300-06-01 00:00:00')) t(i, t);

statement ok
SET TimeZone = 'Europe/Berlin';

statement count 16
COPY wire TO '${__TEST_DIR__}/europe_berlin.txt' (FORMAT text);

statement ok
CREATE OR REPLACE TABLE rendered_europe_berlin (i INTEGER, rendered VARCHAR);

statement count 16
COPY rendered_europe_berlin FROM '${__TEST_DIR__}/europe_berlin.txt' (FORMAT text);

query
SELECT i, rendered FROM rendered_europe_berlin ORDER BY i;
----
i	rendered
0	1600-01-01 12:53:28+00:53:28
1	1850-07-04 12:53:28+00:53:28
2	1900-01-01 00:30:00+01
3	1900-01-01 01:30:00+01
4	1901-06-01 01:00:00+01
5	1937-07-01 13:00:00+01
6	1970-01-01 00:59:59.999999+01
7	1970-01-01 01:00:00+01
8	2025-03-30 01:30:00+01
9	2025-03-30 03:30:00+02
10	2025-06-01 14:00:00+02
11	2025-10-26 02:30:00+02
12	2025-10-26 02:30:00+01
13	2299-12-31 13:00:00+01
14	2300-06-01 02:00:00+02
15	2400-01-01 01:00:00+01

statement count 11
COPY walls TO '${__TEST_DIR__}/europe_berlin_walls.txt' (FORMAT text);

statement ok
CREATE OR REPLACE TABLE zoneless_europe_berlin (i INTEGER, t TIMESTAMPTZ);

statement count 11
COPY zoneless_europe_berlin FROM '${__TEST_DIR__}/europe_berlin_walls.txt' (FORMAT text);

query
SELECT i, epoch_us(t) AS instant, (t = (SELECT t FROM walls w WHERE w.i = z.i) AT TIME ZONE 'Europe/Berlin') AS matches_wall_clock
FROM zoneless_europe_berlin z ORDER BY i;
----
i	instant	matches_wall_clock
0	-11676056008000000	t
1	-2208994200000000	t
2	-2208990600000000	t
3	-3600000000	t
4	1743298200000000	t
5	1743298200000000	t
6	1748772000000000	t
7	1761435000000000	t
8	1761442200000000	t
9	10413745200000000	t
10	10426831200000000	t

