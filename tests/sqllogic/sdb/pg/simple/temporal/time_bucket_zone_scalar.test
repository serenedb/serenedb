query
SELECT tstz::VARCHAR AS t, time_bucket(INTERVAL '1 day', tstz, 'America/Santiago')::VARCHAR AS d1, time_bucket(INTERVAL '7 days', tstz, 'America/Santiago')::VARCHAR AS d7, time_bucket(INTERVAL '1 month', tstz, 'America/Santiago')::VARCHAR AS m1, time_bucket(INTERVAL '90 minutes', tstz, 'America/Santiago')::VARCHAR AS m90 FROM dst WHERE v % 1000 % 7 = 0 AND v >= 0 ORDER BY v;
