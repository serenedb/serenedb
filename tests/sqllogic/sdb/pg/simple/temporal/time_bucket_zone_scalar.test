SET TimeZone = 'Etc/UTC';

statement ok
CREATE TABLE dst AS SELECT tstz, v FROM (SELECT TIMESTAMPTZ '2025-03-07 00:00:00+00' + INTERVAL (i * 53) MINUTE, 0 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-03-28 00:00:00+00' + INTERVAL (i * 53) MINUTE, 1000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-04-04 00:00:00+00' + INTERVAL (i * 53) MINUTE, 2000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-09-05 00:00:00+00' + INTERVAL (i * 53) MINUTE, 3000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-03 00:00:00+00' + INTERVAL (i * 53) MINUTE, 4000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-24 00:00:00+00' + INTERVAL (i * 53) MINUTE, 5000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-10-31 12:00:00+00' + INTERVAL (i * 53) MINUTE, 6000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-12-30 12:00:00+00' + INTERVAL (i * 53) MINUTE, 7000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-02-28 12:00:00+00' + INTERVAL (i * 53) MINUTE, 8000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2025-03-29 00:00:00+00' + INTERVAL (i * 53) MINUTE, 9000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2011-12-29 00:00:00+00' + INTERVAL (i * 53) MINUTE, 10000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '1993-08-19 00:00:00+00' + INTERVAL (i * 53) MINUTE, 11000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2018-05-03 12:00:00+00' + INTERVAL (i * 53) MINUTE, 12000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2016-04-30 12:00:00+00' + INTERVAL (i * 53) MINUTE, 13000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2021-10-28 12:00:00+00' + INTERVAL (i * 53) MINUTE, 14000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2022-10-27 12:00:00+00' + INTERVAL (i * 53) MINUTE, 15000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2024-03-22 12:00:00+00' + INTERVAL (i * 53) MINUTE, 16000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2022-09-20 12:00:00+00' + INTERVAL (i * 53) MINUTE, 17000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2019-02-15 12:00:00+00' + INTERVAL (i * 53) MINUTE, 18000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2020-12-26 12:00:00+00' + INTERVAL (i * 53) MINUTE, 19000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '2019-10-05 12:00:00+00' + INTERVAL (i * 53) MINUTE, 20000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '1969-12-20 00:00:00+00' + INTERVAL (i * 53) MINUTE, 21000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '1998-12-25 00:00:00+00' + INTERVAL (i * 53) MINUTE, 22000 + i FROM range(0, 100) t(i) UNION ALL SELECT TIMESTAMPTZ '1994-12-29 12:00:00+00' + INTERVAL (i * 53) MINUTE, 23000 + i FROM range(0, 100) t(i)) t(tstz, v);

statement ok
INSERT INTO dst VALUES (NULL, -1), (TIMESTAMPTZ 'infinity', -2), (TIMESTAMPTZ '-infinity', -3);

statement ok
CREATE TABLE rnd AS SELECT TIMESTAMPTZ '1900-01-01 00:00:00+00' + INTERVAL ((hash(i) % 3504000)::INTEGER) HOUR + INTERVAL ((hash(i * 7 + 1) % 3600)::INTEGER) SECOND AS tstz, i AS v FROM range(20000) t(i);

query
SELECT 'Europe/Berlin' AS zone, width, count(*) AS c, count(DISTINCT b) AS d, min(b)::VARCHAR AS lo, max(b)::VARCHAR AS hi, sum(epoch_us(b)::HUGEINT) AS s FROM (SELECT '15 minutes' AS width, time_bucket(INTERVAL '15 minutes', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '90 minutes' AS width, time_bucket(INTERVAL '90 minutes', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '1 hour' AS width, time_bucket(INTERVAL '1 hour', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '6 hours' AS width, time_bucket(INTERVAL '6 hours', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '1 day' AS width, time_bucket(INTERVAL '1 day', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '3 days' AS width, time_bucket(INTERVAL '3 days', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '7 days' AS width, time_bucket(INTERVAL '7 days', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '1 month' AS width, time_bucket(INTERVAL '1 month', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '3 months' AS width, time_bucket(INTERVAL '3 months', tstz, 'Europe/Berlin') AS b FROM rnd UNION ALL SELECT '1 year' AS width, time_bucket(INTERVAL '1 year', tstz, 'Europe/Berlin') AS b FROM rnd) w GROUP BY 1, 2 ORDER BY 2;
