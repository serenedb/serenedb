query
SELECT time_bucket(INTERVAL '1 day', tstz, CASE WHEN v % 2 = 0 THEN 'Europe/Berlin' ELSE 'Asia/Tokyo' END)::VARCHAR AS b, count(*) AS c FROM dst WHERE v BETWEEN 0 AND 30 GROUP BY 1 ORDER BY 1;
----
b	c
