statement ok
CREATE TABLE anchors(zone VARCHAR, t TIMESTAMPTZ);

statement ok
INSERT INTO anchors VALUES
  ('America/Havana', TIMESTAMPTZ '2025-03-09 05:00:00+00'), ('America/Havana', TIMESTAMPTZ '2025-11-02 05:00:00+00'),
  ('Europe/Berlin', TIMESTAMPTZ '2025-03-30 01:00:00+00'), ('Europe/Berlin', TIMESTAMPTZ '2025-10-26 01:00:00+00'),
  ('Pacific/Kiritimati', TIMESTAMPTZ '1994-12-31 10:00:00+00'),
  ('Australia/Lord_Howe', TIMESTAMPTZ '2025-04-05 15:00:00+00'), ('Australia/Lord_Howe', TIMESTAMPTZ '2025-10-04 15:30:00+00'),
  ('Europe/Amsterdam', TIMESTAMPTZ '1937-06-30 23:40:28+00'),
  ('Africa/Monrovia', TIMESTAMPTZ '1972-01-07 00:44:30+00'),
  ('Asia/Kolkata', TIMESTAMPTZ '2025-06-15 12:00:00+00'),
  ('Etc/UTC', TIMESTAMPTZ '2025-06-15 12:00:00+00'),
  ('America/Santiago', TIMESTAMPTZ '2025-04-06 03:00:00+00'), ('America/Santiago', TIMESTAMPTZ '2025-09-07 04:00:00+00'),
  ('America/St_Johns', TIMESTAMPTZ '2025-03-09 05:30:00+00'), ('America/St_Johns', TIMESTAMPTZ '2025-11-02 04:30:00+00');

statement ok
CREATE TABLE p AS SELECT zone, make_timestamptz(epoch_us(t) + o.us) AS ts, t AS anchor FROM anchors, (VALUES (-5400000000), (-1800000000), (-1000000), (-1), (0), (1), (999999), (1800000000), (5400000000), (90000000000), (-90000000000), (2678400000000), (-2678400000000), (-86400000000), (86400000000)) o(us);

statement ok
INSERT INTO p SELECT zone, ts, ts FROM (VALUES ('Europe/Berlin', TIMESTAMPTZ '1850-06-01 12:00:00+00'), ('Europe/Berlin', TIMESTAMPTZ '2150-06-01 12:00:00+00'), ('America/Havana', TIMESTAMPTZ '1900-01-01 00:00:00+00'), ('America/Havana', TIMESTAMPTZ '2036-12-31 23:59:59.999999+00'), ('Europe/Berlin', NULL), ('Europe/Berlin', 'infinity'::TIMESTAMPTZ), ('Europe/Berlin', '-infinity'::TIMESTAMPTZ)) v(zone, ts);

statement ok
CREATE TABLE fmts(fmt VARCHAR);

statement ok
INSERT INTO fmts VALUES ('%Y-%m-%d %H:%M:%S.%f %z %Z'), ('%a %d %b %Y %I:%M %p %j %U %W %u %w'), ('%G-%V %g %y %-m/%-d %-H %-I %-M %-S %g'), ('%c | %x | %X | %%');

statement ok
CREATE TABLE parts(part VARCHAR);

statement ok
INSERT INTO parts VALUES ('microsecond'), ('millisecond'), ('second'), ('minute'), ('hour'), ('day'), ('week'), ('month'), ('quarter'), ('year'), ('decade'), ('century'), ('isoyear');

statement ok
SET TimeZone = 'America/Havana';

query
SELECT ts::VARCHAR AS ts, strftime(ts, '%Y-%m-%d %H:%M:%S.%f %z %Z %a %j %G-%V %U %W') AS f FROM p WHERE zone = 'America/Havana' ORDER BY ts NULLS FIRST;
