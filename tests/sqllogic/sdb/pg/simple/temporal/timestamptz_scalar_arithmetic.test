query
SELECT fmt, count(*) AS n, md5(string_agg(strftime(ts, fmt), '|' ORDER BY ts NULLS FIRST)) AS digest FROM p, fmts WHERE zone = 'Pacific/Kiritimati' GROUP BY fmt ORDER BY fmt;
