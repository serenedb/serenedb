hour	15	144071	144072
isoyear	15	15	15
microsecond	15	518669999999999	518670000000001
millisecond	15	518669999998	518669999999
minute	15	8644498	8644498
month	15	195	195
quarter	15	61	60
second	15	518669998	518669999
week	15	854	854
