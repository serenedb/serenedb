SELECT part, count(*) AS n, sum(date_diff(part, anchor - INTERVAL '400 days 5 hours', ts)) AS diff_sum, sum(date_sub(part, ts, anchor + INTERVAL '400 days 5 hours')) AS sub_sum FROM p, parts WHERE zone = 'Asia/Kolkata' GROUP BY part ORDER BY part;
