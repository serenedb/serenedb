SET TimeZone = 'Europe/Berlin';

query
SELECT strftime('infinity'::TIMESTAMPTZ, '%Y'), strftime('-infinity'::TIMESTAMPTZ, '%Y'), strftime(NULL::TIMESTAMPTZ, '%Y'), ('infinity'::TIMESTAMPTZ + INTERVAL '1 day')::VARCHAR, ('-infinity'::TIMESTAMPTZ - INTERVAL '1 month')::VARCHAR, (NULL::TIMESTAMPTZ + INTERVAL '1 day')::VARCHAR, date_diff('day', 'infinity'::TIMESTAMPTZ, TIMESTAMPTZ '2025-01-01 00:00:00+00'), date_sub('hour', TIMESTAMPTZ '2025-01-01 00:00:00+00', '-infinity'::TIMESTAMPTZ), date_diff('day', NULL::TIMESTAMPTZ, TIMESTAMPTZ '2025-01-01 00:00:00+00');
