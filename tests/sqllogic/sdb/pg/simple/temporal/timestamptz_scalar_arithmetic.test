query
SELECT ts::VARCHAR AS ts, date_sub('decade', anchor - INTERVAL '4000 days', ts) AS sdec, date_diff('decade', anchor - INTERVAL '4000 days', ts) AS ddec, date_diff('century', anchor - INTERVAL '4000 days', ts) AS dcen, date_diff('millennium', ts, anchor + INTERVAL '4000 days') AS dmil, date_sub('century', ts, anchor + INTERVAL '4000 days') AS scen, strftime(ts::TIMESTAMPTZ_NS, '%Y-%m-%d %H:%M:%S.%f %z %Z') AS fns, strftime(ts::TIMESTAMPTZ_NS, '%S.%n') AS nns FROM p WHERE zone = 'Pacific/Kiritimati' ORDER BY ts NULLS FIRST;
----
