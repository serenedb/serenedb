query
SELECT fmt, count(*) AS n, md5(string_agg(strftime(ts, fmt), '|' ORDER BY ts NULLS FIRST)) AS digest FROM p, fmts WHERE zone = 'Asia/Kolkata' GROUP BY fmt ORDER BY fmt;
----
fmt	n	digest
%G-%V %g %y %-m/%-d %-H %-I %-M %-S %g	15	79b62669e7d52bcbf3a6abb4ff3b8f16
%Y-%m-%d %H:%M:%S.%f %z %Z	15	a86c718e99069d5df67103dcbba0360d
%a %d %b %Y %I:%M %p %j %U %W %u %w	15	0babdefa59af8e7c375e343171f84040
%c | %x | %X | %%	15	8d66d074be19cdd6f113b85ef45eb1f6

query
SELECT fmt, count(*) FILTER (WHERE strftime(ts, fmt) IS DISTINCT FROM CASE fmt WHEN '%Y-%m-%d %H:%M:%S.%f %z %Z' THEN strftime(ts, '%Y-%m-%d %H:%M:%S.%f %z %Z') WHEN '%a %d %b %Y %I:%M %p %j %U %W %u %w' THEN strftime(ts, '%a %d %b %Y %I:%M %p %j %U %W %u %w') WHEN '%G-%V %g %y %-m/%-d %-H %-I %-M %-S %g' THEN strftime(ts, '%G-%V %g %y %-m/%-d %-H %-I %-M %-S %g') ELSE strftime(ts, '%c | %x | %X | %%') END) AS mismatches FROM p, fmts GROUP BY fmt ORDER BY fmt;
----
fmt	mismatches
%G-%V %g %y %-m/%-d %-H %-I %-M %-S %g	0
%Y-%m-%d %H:%M:%S.%f %z %Z	0
%a %d %b %Y %I:%M %p %j %U %W %u %w	0
%c | %x | %X | %%	0

query
SELECT part, count(*) FILTER (WHERE date_diff(part, anchor - INTERVAL '400 days 5 hours', ts) IS DISTINCT FROM CASE part WHEN 'microsecond' THEN date_diff('microsecond', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'millisecond' THEN date_diff('millisecond', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'second' THEN date_diff('second', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'minute' THEN date_diff('minute', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'hour' THEN date_diff('hour', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'day' THEN date_diff('day', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'week' THEN date_diff('week', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'month' THEN date_diff('month', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'quarter' THEN date_diff('quarter', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'year' THEN date_diff('year', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'decade' THEN date_diff('decade', anchor - INTERVAL '400 days 5 hours', ts) WHEN 'century' THEN date_diff('century', anchor - INTERVAL '400 days 5 hours', ts) ELSE date_diff('isoyear', anchor - INTERVAL '400 days 5 hours', ts) END) AS mismatches FROM p, parts GROUP BY part ORDER BY part;
----
part	mismatches
century	0
day	0
decade	0
hour	0
isoyear	0
microsecond	0
millisecond	0
minute	0
month	0
quarter	0
second	0
week	0
year	0

query
SELECT part, count(*) FILTER (WHERE date_sub(part, ts, anchor + INTERVAL '400 days 5 hours') IS DISTINCT FROM CASE part WHEN 'microsecond' THEN date_sub('microsecond', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'millisecond' THEN date_sub('millisecond', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'second' THEN date_sub('second', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'minute' THEN date_sub('minute', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'hour' THEN date_sub('hour', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'day' THEN date_sub('day', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'week' THEN date_sub('week', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'month' THEN date_sub('month', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'quarter' THEN date_sub('quarter', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'year' THEN date_sub('year', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'decade' THEN date_sub('decade', ts, anchor + INTERVAL '400 days 5 hours') WHEN 'century' THEN date_sub('century', ts, anchor + INTERVAL '400 days 5 hours') ELSE date_sub('isoyear', ts, anchor + INTERVAL '400 days 5 hours') END) AS mismatches FROM p, parts GROUP BY part ORDER BY part;
----
part	mismatches
century	0
day	0
decade	0
hour	0
isoyear	0
microsecond	0
millisecond	0
minute	0
month	0
quarter	0
second	0
week	0
year	0

