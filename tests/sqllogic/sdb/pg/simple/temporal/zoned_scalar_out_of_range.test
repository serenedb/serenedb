statement ok
CREATE TABLE oor AS SELECT * FROM (VALUES
	(0, TIMESTAMPTZ '0044-03-15 12:00:00+00'),
	(1, TIMESTAMPTZ '1000-06-06 06:06:06+00'),
	(2, TIMESTAMPTZ '1600-01-01 12:00:00+00'),
	(3, TIMESTAMPTZ '1850-07-04 12:00:00+00'),
	(4, TIMESTAMPTZ '1899-12-31 23:30:00+00'),
	(5, TIMESTAMPTZ '1900-01-01 00:00:00+00'),
	(6, TIMESTAMPTZ '1901-06-01 00:00:00+00'),
	(7, TIMESTAMPTZ '1969-12-31 23:59:59.999999+00'),
	(8, TIMESTAMPTZ '2025-03-30 00:30:00+00'),
	(9, TIMESTAMPTZ '2299-12-31 12:00:00+00'),
	(10, TIMESTAMPTZ '2300-06-01 00:00:00+00'),
	(11, TIMESTAMPTZ '2400-01-01 00:00:00+00'),
	(12, TIMESTAMPTZ 'infinity'),
	(13, TIMESTAMPTZ '-infinity'),
	(14, NULL::TIMESTAMPTZ)) t(i, t);

statement ok
SET TimeZone = 'Europe/Berlin';

query
