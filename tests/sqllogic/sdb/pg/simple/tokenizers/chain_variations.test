# --- stored dictionaries at every position ---

statement ok
CREATE TEXT SEARCH DICTIONARY dict_head AS words | stem_words('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY dict_middle AS lower($1) | words | stem_words('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY dict_tail AS split_csv(',') | en_stem;

statement ok
CREATE TEXT SEARCH DICTIONARY dict_qualified AS public.words | public.en_stem;

query
SELECT ts_lexize('dict_head', 'Running Flies') AS h,
       ts_lexize('dict_middle', 'Running Flies') AS m,
       ts_lexize('dict_tail', 'Running,Flies') AS t,
       ts_lexize('dict_qualified', 'Running Flies') AS q;
----
h	m	t	q
{run,fli}	{run,fli}	{run,fli}	{run,fli}

statement ok
CREATE TEXT SEARCH DICTIONARY dict_of_sql AS sql_middle | upper($1);

query
SELECT ts_lexize('dict_of_sql', 'running , flies');
----
ts_lexize
{RUN,FLI}

# --- spelling variations ---

statement ok
CREATE TEXT SEARCH DICTIONARY spell_upper AS SPLIT_TEXT(CASE := 'lower') | STEM_WORDS('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY spell_quoted AS "split_text"(case := 'lower') | "stem_words"('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY spell_arrow AS split_text(case => 'lower') | stem_words(locale => 'en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY spell_positional AS split_text('lower') | stem_words('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY spell_null AS split_text('lower', NULL) | stem_words('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY spell_mixed AS split_text('lower', break := 'alpha') | stem_words('en_US.UTF-8');

query
SELECT count(*) AS same FROM (
  SELECT ts_lexize(d, 'The Runners were Running') = ts_lexize('en_stem', 'The Runners were Running') AS eq
  FROM (VALUES ('spell_upper'), ('spell_quoted'), ('spell_arrow'), ('spell_positional'), ('spell_null'), ('spell_mixed')) AS t(d)
) WHERE eq;
----
same
6

# --- features on chains ---

statement ok
CREATE TEXT SEARCH DICTIONARY feat_chain AS split_csv(',') | (x -> lower(trim(x))) | stem_words('en_US.UTF-8') WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY feat_identity AS $1 WITH (frequency);

statement ok
CREATE TEXT SEARCH DICTIONARY feat_union AS [split_csv(','), lower($1)] WITH (frequency, position, norm);

statement error Unsupported index features
CREATE TEXT SEARCH DICTIONARY feat_bad AS split_csv(',') | upper($1) WITH (frequency, position, offset);

# --- functions and dictionaries agree ---

statement ok
CREATE TEXT SEARCH DICTIONARY sc_stop AS split_csv(',') | remove_stopwords(['b']);

query
SELECT stem_words(split_text(v, case := 'lower'), 'en_US.UTF-8') = ts_lexize('en_stem', v) AS a,
       remove_stopwords(split_csv(v, ','), ['b']) = ts_lexize('sc_stop', v) AS b
FROM (VALUES ('Running,Flies b'), ('a,b,c')) AS t(v);
----
a	b
t	t
t	t

# --- indexing over chains with sql and lambda stages ---

statement ok
CREATE TABLE chain_docs (id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO chain_docs VALUES (1, ' Running , flies '), (2, 'Lazy , dogs'), (3, NULL);

statement ok
CREATE INDEX chain_docs_idx ON chain_docs USING inverted (id, body feat_chain);

statement ok
VACUUM (REFRESH_TABLE) chain_docs;

query
SELECT id FROM chain_docs_idx WHERE body @@ 'fli' ORDER BY id;
----
id
1

query
SELECT id FROM chain_docs_idx WHERE body @@ ts_phrase('running', 'flies') ORDER BY id;
----
id
1

query
SELECT id FROM chain_docs_idx WHERE body @@ ts_tokenize('DOGS') ORDER BY id;
----
id
2

# --- errors ---

statement error text search dictionary "input" does not exist
CREATE TEXT SEARCH DICTIONARY err_bare_input AS input;

statement error does not read input
CREATE TEXT SEARCH DICTIONARY err_old_placeholder AS lower(input);

statement error does not read input
CREATE TEXT SEARCH DICTIONARY err_other_param AS split_csv(',') | upper($2);

statement error parameters are not allowed
CREATE TEXT SEARCH DICTIONARY err_extra_param AS split_csv(',') | (upper($1) || $2);

statement error is not a constant
CREATE TEXT SEARCH DICTIONARY err_param_option AS split_text(case := $1);

statement error a lambda stage takes exactly one parameter
CREATE TEXT SEARCH DICTIONARY err_lambda_two AS split_csv(',') | ((x, y) -> upper(x));

statement error cannot be nested inside an SQL expression
CREATE TEXT SEARCH DICTIONARY err_lambda_template AS split_csv(',') | (x -> stem_words(x));

statement error cannot be nested inside an SQL expression
CREATE TEXT SEARCH DICTIONARY err_sql_template AS lower(stem_words($1));

statement error does not take an analyzer argument
CREATE TEXT SEARCH DICTIONARY err_nested_call AS stem_words(split_csv(','), 'en_US.UTF-8');

statement error requires a nested analyzer as its first argument
CREATE TEXT SEARCH DICTIONARY err_wrapper_no_child AS generate_shingles(2, 2);

statement error a list stage must hold analyzers
CREATE TEXT SEARCH DICTIONARY err_list_constant AS [split_csv(','), 'x'];

statement error
CREATE TEXT SEARCH DICTIONARY err_sql_unknown_fn AS whaaat($1);

statement error
CREATE TEXT SEARCH DICTIONARY err_sql_type AS split_csv(',') | length($1);

statement ok
DROP TABLE chain_docs CASCADE;
