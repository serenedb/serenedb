statement ok
CREATE TEXT SEARCH DICTIONARY words AS split_text(case := 'lower');

statement ok
CREATE TEXT SEARCH DICTIONARY en_stem AS split_text(case := 'lower') | stem_words('en_US.UTF-8');

# --- $1 stages at every position of a chain ---

statement ok
CREATE TEXT SEARCH DICTIONARY sql_head AS lower($1) | split_csv(',');

query
SELECT ts_lexize('sql_head', 'RED,Green');
----
ts_lexize
{red,green}

statement ok
CREATE TEXT SEARCH DICTIONARY sql_middle AS split_csv(',') | trim($1) | stem_words('en_US.UTF-8');

query
SELECT ts_lexize('sql_middle', 'running , flies');
----
ts_lexize
{run,fli}

statement ok
CREATE TEXT SEARCH DICTIONARY sql_tail AS split_csv(',') | upper($1);

query
SELECT ts_lexize('sql_tail', 'red,green');
----
ts_lexize
{RED,GREEN}

statement ok
CREATE TEXT SEARCH DICTIONARY sql_fanout AS split_csv(';') | string_split($1, ',') | upper($1);

query
SELECT ts_lexize('sql_fanout', 'a,b;c');
----
ts_lexize
{A,B,C}

statement ok
CREATE TEXT SEARCH DICTIONARY sql_twice AS split_csv(',') | ($1 || '/' || $1);

query
SELECT ts_lexize('sql_twice', 'a,b');
----
