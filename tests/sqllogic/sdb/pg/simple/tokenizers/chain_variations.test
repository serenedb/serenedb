# --- grouping ---

statement ok
CREATE TEXT SEARCH DICTIONARY group_left AS (split_csv(',') | lower($1)) | stem_words('en_US.UTF-8');

statement ok
CREATE TEXT SEARCH DICTIONARY group_right AS split_csv(',') | (lower($1) | stem_words('en_US.UTF-8'));

statement ok
CREATE TEXT SEARCH DICTIONARY group_flat AS split_csv(',') | lower($1) | stem_words('en_US.UTF-8');

query
SELECT ts_lexize('group_left', 'Cats,RUNNING') = ts_lexize('group_flat', 'Cats,RUNNING') AS l,
       ts_lexize('group_right', 'Cats,RUNNING') = ts_lexize('group_flat', 'Cats,RUNNING') AS r;
----
l	r
t	t

# --- wrappers over chains, dictionaries, lambdas and unions ---

statement ok
CREATE TEXT SEARCH DICTIONARY shingle_chain AS generate_shingles(split_csv(' ') | normalize_tokens(case := 'lower'), 2, 2);

query
SELECT array_length(ts_lexize('shingle_chain', 'Quick Brown Fox'), 1) AS n,
       'quick' = ANY(ts_lexize('shingle_chain', 'Quick Brown Fox')) AS lowered;
----
n	lowered
5	t

statement ok
CREATE TEXT SEARCH DICTIONARY shingle_dict AS generate_shingles(words, 2, 2);

query
SELECT ts_lexize('shingle_dict', 'Quick Brown Fox') = ts_lexize('shingle_chain', 'Quick Brown Fox') AS same;
----
same
t

statement ok
CREATE TEXT SEARCH DICTIONARY shingle_lambda AS generate_shingles((v -> string_split(lower(v), ' ')), mingram := 2, maxgram := 2);

query
SELECT ts_lexize('shingle_lambda', 'Quick Brown Fox') = ts_lexize('shingle_chain', 'Quick Brown Fox') AS same;
----
same
t

statement ok
CREATE TEXT SEARCH DICTIONARY shingle_sql AS generate_shingles(string_split(lower($1), ' '), 2, 2);

query
SELECT ts_lexize('shingle_sql', 'Quick Brown Fox') = ts_lexize('shingle_chain', 'Quick Brown Fox') AS same;
----
same
t

statement error pipeline: stage 0 produces a per-document store blob
CREATE TEXT SEARCH DICTIONARY shingle_then_filter AS generate_shingles(split_csv(' '), 2, 2) | remove_stopwords(['quick']);

statement ok
CREATE TEXT SEARCH DICTIONARY shingle_then_filter AS generate_shingles(split_csv(' '), 2, 2, storetokens := false) | remove_stopwords(['quick']);

query
SELECT array_length(ts_lexize('shingle_then_filter', 'quick brown fox'), 1) AS n,
       'quick' = ANY(ts_lexize('shingle_then_filter', 'quick brown fox')) AS has_quick;
----
n	has_quick
4	f

