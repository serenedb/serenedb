CREATE TEXT SEARCH DICTIONARY opt_pipe AS
    split_csv(',')
    | split_text(case := 'lower') | stem_words('en_US.UTF-8')
    | remove_stopwords(['the'])
    WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY expr_pipe AS
    split_csv(',') | split_text(case := 'lower') | stem_words('en_US.UTF-8') | remove_stopwords(['the'])
    WITH (frequency, position);

query
SELECT ts_lexize('expr_pipe', 'The,Quick,Foxes');
----
ts_lexize
{quick,fox}

query
SELECT ts_lexize('opt_pipe', 'The,Quick,Foxes') = ts_lexize('expr_pipe', 'The,Quick,Foxes') AS same;
----
same
t

