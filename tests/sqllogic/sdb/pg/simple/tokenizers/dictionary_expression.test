CREATE TEXT SEARCH DICTIONARY <name> AS <analyzer> [WITH (frequency, position, norm, offset)]
<analyzer> := <template>(<arguments>) | <analyzer> | <analyzer> | [<analyzer>, ...] | <sql expression over $1> | <dictionary name>

split_text(case := 'none', break := 'alpha')
  as a function: split_text(value, case := 'none', break := 'alpha')
  case   Text case conversion: none, lower, upper
  break  Token boundary detection mode: all, graphic, alpha, sentence, line, paragraph

generate_ngrams(mingram := 2, maxgram := 3, preserveoriginal := false, inputtype := 'utf8', startmarker := '', endmarker := '', mode := 'all')
  as a function: generate_ngrams(value, mingram := 2, maxgram := 3, preserveoriginal := false, inputtype := 'utf8', startmarker := '', endmarker := '', mode := 'all')
  mingram           Minimum n-gram length
  maxgram           Maximum n-gram length
  preserveoriginal  Emit the original token alongside n-grams
  inputtype         Input stream encoding: binary, utf8
  startmarker       Prefix marker appended at n-gram boundary
  endmarker         Suffix marker appended at n-gram boundary
  mode              Mode of generation: all, only_prefix, only_suffix, only_prefix_and_suffix

find_nearest_words(modellocation := '', topk := 1)
  as a function: find_nearest_words(value, modellocation := '', topk := 1)
  modellocation  Path to the ML model file
  topk           Number of top results to return

stem_words(locale := '')
  as a function: stem_words(value, locale := '')
  locale  ICU locale string (e.g. en_US.UTF-8)

remove_stopwords(stopwords := [], stopwordspath := '', hex := false)
  as a function: remove_stopwords(value, stopwords := [], stopwordspath := '', hex := false)
  stopwords      Inline stop words: a list of strings, or a comma-separated string of double-quoted words
  stopwordspath  Path to a stop-word file, or to a directory whose files are all loaded
  hex            Treat stop words as hex-encoded strings

classify_text(modellocation := '', topk := 1, threshold := 0)
  as a function: classify_text(value, modellocation := '', topk := 1, threshold := 0)
  modellocation  Path to the ML model file
  topk           Number of top results to return
  threshold      Minimum confidence score [0.0..1.0]

collate_tokens(locale := '')
  as a function: collate_tokens(value, locale := '')
  locale  ICU locale string (e.g. en_US.UTF-8)

split_csv(delimiter)
  as a function: split_csv(value, delimiter)
  delimiter  Token delimiter character or string

split_by_delimiters(delimiters)
  as a function: split_by_delimiters(value, delimiters)
  delimiters  Delimiters: a list of strings, or a comma-separated string of double-quoted delimiters (e.g. '",", "|", "!"')

generate_wildcard_ngrams(<analyzer>, ngramsize := 3)
  as a function: generate_wildcard_ngrams(value, ngramsize := 3)
  ngramsize  N-gram size for wildcard prefix indexing (minimum 2)

normalize_tokens(locale := '', case := 'none', accent := true, form := 'nfc')
  as a function: normalize_tokens(value, locale := '', case := 'none', accent := true, form := 'nfc')
  locale  ICU locale for case conversion; omit for locale-independent simple case
  case    Text case conversion: none, lower, upper
  accent  Preserve accent marks
  form    Unicode normalization form: nfc, nfkc

split_text_icu(locale, break := 'alpha')
  as a function: split_text_icu(value, locale, break := 'alpha')
  locale  ICU locale string (e.g. en_US.UTF-8)
  break   Token boundary detection mode: all, graphic, alpha, sentence

split_by_non_alpha(case := 'none')
  as a function: split_by_non_alpha(value, case := 'none')
  case  Text case conversion: none, lower, upper

<analyzer> | <analyzer>
  chain: each stage re-analyzes the tokens of the previous one

split_by_pattern(pattern, group := -1)
  as a function: split_by_pattern(value, pattern, group := -1)
  pattern  RE2 regular expression pattern for matching or splitting
  group    Capture group to extract: -1=split, 0=whole match, N>0=Nth group

expand_path(delimiter := '/', replacement := '', reverse := false, skip := 0)
  as a function: expand_path(value, delimiter := '/', replacement := '', reverse := false, skip := 0)
  delimiter    Path separator character or string (UTF-8)
  replacement  Replacement for delimiter in tokens
  reverse      Use reverse tokenization for domain-like hierarchies
  skip         Number of initial tokens to skip

[<analyzer>, <analyzer>, ...]
  union: every branch analyzes the same input, the tokens are merged

encode_geopoint(latitude := [], longitude := [], maxcells := 20, minlevel := 4, maxlevel := 23, levelmod := 1, optimizeforspace := false)
  as a function: encode_geopoint(value, latitude := [], longitude := [], maxcells := 20, minlevel := 4, maxlevel := 23, levelmod := 1, optimizeforspace := false)
  latitude          Path to the latitude field, slash-separated ('lat', 'loc/lat') or a list of segments (['loc', 'lat']); empty (the default) treats the indexed JSON value as a [lat, lng] array directly. latitude and longitude must both be set or both left empty.
  longitude         Path to the longitude field, slash-separated ('lng', 'loc/lng') or a list of segments; see latitude for empty-default semantics.
  maxcells          Maximum number of S2 cells
  minlevel          Minimum S2 cell level (0-30)
  maxlevel          Maximum S2 cell level (0-30), ~1m precision at level 23
  levelmod          S2 level modifier (1, 2, or 3)
  optimizeforspace  Optimize S2 index for space rather than speed

encode_geojson(type := 'shape', coding := 'source', maxcells := 20, minlevel := 4, maxlevel := 23, levelmod := 1, optimizeforspace := false)
  as a function: encode_geojson(value, type := 'shape', coding := 'source', maxcells := 20, minlevel := 4, maxlevel := 23, levelmod := 1, optimizeforspace := false)
  type              GeoJson shape type: shape, centroid, point
  coding            Encoding format: source, s2point, s2latlngf64, s2latlngu32
  maxcells          Maximum number of S2 cells
  minlevel          Minimum S2 cell level (0-30)
  maxlevel          Maximum S2 cell level (0-30), ~1m precision at level 23
  levelmod          S2 level modifier (1, 2, or 3)
  optimizeforspace  Optimize S2 index for space rather than speed

keyword()

sql(expression)
  any SQL expression that reads its input as $1 is a sql stage as well
  expression  DuckDB scalar expression over its input $1 (VARCHAR), returning VARCHAR or BLOB (one token per value) or a list of them (token list); built-in functions only, no subqueries, no volatile functions

generate_shingles(<analyzer>, mingram := 2, maxgram := 2, outputunigrams := true, outputunigramsifnoshingles := false, storetokens := true, frequentwords := [], fillertoken := '')
  as a function: generate_shingles(value, mingram := 2, maxgram := 2, outputunigrams := true, outputunigramsifnoshingles := false, storetokens := true, frequentwords := [], fillertoken := '')
  mingram                     Minimum shingle (word n-gram) size (minimum 2)
  maxgram                     Maximum shingle (word n-gram) size (>= mingram)
  outputunigrams              Index individual tokens alongside the shingles
  outputunigramsifnoshingles  Index unigrams only when the input is too short to form a shingle
  storetokens                 Persist the per-document token stream (verification source for phrases longer than maxgram). When false the index stores terms only
  frequentwords               Frequent words (typically stopwords): a list of strings, or a comma-separated string of double-quoted words. When non-empty, shingles of mingram stay dense while wider sizes are indexed only for spans containing one of these words (adaptive width escalation)
  fillertoken                 Token standing in for positions the base analyzer removed (e.g. stopwords) in the stored token stream; never indexed as a term. Default '_'

expand_solr_synonyms(synonyms)
  as a function: expand_solr_synonyms(value, synonyms)
  synonyms  Inline Solr-format synonyms file content: one rule per line, comma-separated terms; `=>` separates LHS from RHS for one-way mappings

expand_wordnet_synonyms(synonyms)
  as a function: expand_wordnet_synonyms(value, synonyms)
  synonyms  Inline WordNet Prolog database content: one `s(synset,w_num,'word',ss_type,sense_number,tag_count).` record per line

generate_sparse_ngrams(maxngramlength := 16, covering := false)
  as a function: generate_sparse_ngrams(value, maxngramlength := 16, covering := false)
  maxngramlength  Maximum emitted n-gram length (minimum 3)
  covering        Emit the minimal covering n-gram chain (query side) instead of all sparse n-grams (index side)

<dictionary name>
  a stored dictionary as a stage: its analyzer is copied as it stands when the new dictionary is created

WITH (frequency, position, norm, offset)
  norm       Enables norm feature in index
  offset     Enables offset feature in index
  position   Enables position feature in index
  frequency  Enables frequency feature in index


