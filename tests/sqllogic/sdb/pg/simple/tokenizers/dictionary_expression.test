statement ok
CREATE TEXT SEARCH DICTIONARY expr_text AS split_text(case := 'lower') | stem_words('en_US.UTF-8');

query
SELECT ts_lexize('expr_text', 'The Runners were Running');
----
ts_lexize
{the,runner,were,run}

query
SELECT ts_lexize('opt_text', 'The Runners were Running') = ts_lexize('expr_text', 'The Runners were Running') AS same;
----
same
t

