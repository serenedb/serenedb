CREATE TABLE expr_docs (id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO expr_docs VALUES (1, 'The,Quick,Foxes'), (2, 'Lazy,Dogs');

statement ok
CREATE INDEX expr_docs_idx ON expr_docs USING inverted (id, body expr_pipe);

statement ok
VACUUM (REFRESH_TABLE) expr_docs;

query
SELECT id FROM expr_docs_idx WHERE body @@ 'fox';
----
id
1

