query
SELECT filter_tokens('abc', min_length := 2, max_length := 3) AS t;
----
t
{abc}


query
SELECT filter_tokens('abcd', min_length := 2, max_length := 3) AS t;
----
t
{}


query
SELECT filter_tokens(['日本語', 'straße', 'ab'], min_length := 3, max_length := 3) AS t;
