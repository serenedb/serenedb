t
{日本語}


query
SELECT filter_tokens(['日本語', 'straße', 'ab'], min_length := 3) AS t;
----
t
{日本語,straße}


query
SELECT filter_tokens(['日本語', 'straße', 'ab'], max_length := 5) AS t;
----
t
{日本語,ab}


query
SELECT filter_tokens(['abc', 'https://example.com', 'de'], lambda x: x NOT LIKE 'http%') AS t;
----
t
{abc,de}


query
SELECT filter_tokens(split_text('The quick brown fox', case := 'lower'), lambda x: x <> 'the') AS t;
----
t
{quick,brown,fox}


query
SELECT filter_tokens(filter_tokens(['a', 'abc', 'abcdefgh'], max_length := 5), lambda x: x LIKE 'a%') AS t;
----
t
{a,abc}


statement error the lambda must return BOOLEAN
SELECT filter_tokens(['a'], lambda x: length(x));


statement ok
CREATE TEXT SEARCH DICTIONARY ft_words AS
    split_text(case := 'lower') | filter_tokens(lambda x: x NOT IN ('the', 'over'), min_length := 2, max_length := 8)
    WITH (frequency, position, offset)


query
SELECT ts_lexize('ft_words', 'A quick brown fox jumps over the extraordinarily lazy dog');
----
ts_lexize
{quick,brown,fox,jumps,lazy,dog}


query
SELECT ts_offsets('ft_words', 'A quick brown fox', 'brown'::TSQUERY) AS offsets;
----
offsets
{8,13}


statement ok
CREATE TEXT SEARCH DICTIONARY ft_positional AS
    split_text() | filter_tokens(2, 3)


query
SELECT ts_lexize('ft_positional', 'a bb ccc dddd');
----
ts_lexize
{bb,ccc}


statement ok
CREATE TEXT SEARCH DICTIONARY ft_input AS
    split_text() | filter_tokens(lambda input: input <> 'bb')


query
SELECT ts_lexize('ft_input', 'a bb ccc');
----
ts_lexize
{a,ccc}


statement ok
CREATE TEXT SEARCH DICTIONARY ft_nulls AS
    split_text() | filter_tokens(lambda x: CASE WHEN x = 'keep' THEN true END)


query
SELECT ts_lexize('ft_nulls', 'drop keep other');
----
ts_lexize
{keep}


statement ok
CREATE TABLE ft_docs(id INT, body TEXT);


statement ok
INSERT INTO ft_docs VALUES
    (1, 'see https://example.com for the details'),
    (2, 'https only here'),
    (3, 'details elsewhere');


statement ok
CREATE TEXT SEARCH DICTIONARY ft_no_urls AS
    split_text_csv(' ') | filter_tokens(lambda x: x NOT LIKE 'http%')


statement ok
CREATE INDEX ft_docs_idx ON ft_docs USING inverted(id, body ft_no_urls);


query
SELECT id FROM ft_docs_idx WHERE body @@ 'details' ORDER BY id;
----
id
1
3


query
SELECT id FROM ft_docs_idx WHERE body @@ 'here' ORDER BY id;
----
id
2


