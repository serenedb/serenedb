control substitution on


# ERROR CASES

# --- Invalid template value ---

statement error
CREATE TEXT SEARCH DICTIONARY eng_err_bad_template AS
    edge_ngram_typo(mingram := 2, maxgram := 3)
----
db error: ERROR: "edge_ngram_typo" is not a text search template and does not read input
HINT: an SQL stage must reference the input as $1, e.g. edge_ngram_typo($1)


# --- Option not applicable (locale belongs to text/stem/...) ---

statement error
CREATE TEXT SEARCH DICTIONARY eng_err_locale AS
    generate_ngrams(2, 3, mode := 'only_prefix', locale := 'en_US.UTF-8')
----
db error: ERROR: generate_ngrams(): unknown option "locale"
HINT: known names: mingram, maxgram, preserveoriginal, inputtype, startmarker, endmarker, mode


# --- Basic mingram / maxgram ---

statement ok
CREATE TEXT SEARCH DICTIONARY edge_ngram_basic AS
    generate_ngrams(2, 4, mode := 'only_prefix')


query
SELECT ts_lexize('edge_ngram_basic', 'hello');
----
ts_lexize
{he,hel,hell}


# --- Basic mingram / maxgram all ---

statement ok
CREATE TEXT SEARCH DICTIONARY edge_ngram_basic_all AS
    generate_ngrams(2, 4, mode := 'all')


query
SELECT ts_lexize('edge_ngram_basic_all', 'hello');
----
ts_lexize
{he,hel,hell,el,ell,ello,ll,llo,lo}


# --- Case preserved ---

statement ok
CREATE TEXT SEARCH DICTIONARY edge_ngram_case_preserved AS
    generate_ngrams(2, 3, mode := 'only_prefix')


query
SELECT ts_lexize('edge_ngram_case_preserved', 'HeLLo');
----
ts_lexize
{He,HeL}


# --- preserveoriginal: emit full input after max-length prefixes ---

statement ok
CREATE TEXT SEARCH DICTIONARY edge_ngram_preserve_original AS
    generate_ngrams(1, 2, mode := 'only_prefix', preserveoriginal := true)


query
SELECT ts_lexize('edge_ngram_preserve_original', 'abcd');
----
ts_lexize
{a,ab,abcd}


# --- only suffix ---

statement ok
CREATE TEXT SEARCH DICTIONARY edge_ngram_only_suffix AS
    generate_ngrams(1, 2, mode := 'only_suffix', preserveoriginal := true)


query
SELECT ts_lexize('edge_ngram_only_suffix', 'abcd');
----
ts_lexize
{abcd,cd,d}

# --- only_prefix_and_suffix ---

statement ok
CREATE TEXT SEARCH DICTIONARY edge_ngram_only_prefix_and_suffix AS
    generate_ngrams(1, 2, mode := 'only_prefix_and_suffix', preserveoriginal := true)


query
SELECT ts_lexize('edge_ngram_only_prefix_and_suffix', 'abcd');
----
ts_lexize
{a,ab,abcd,cd,d}
