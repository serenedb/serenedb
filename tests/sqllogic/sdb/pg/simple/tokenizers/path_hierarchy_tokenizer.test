control substitution on


# ERROR CASES

# --- Delimiter option not applicable to other tokenizers ---

statement error
CREATE TEXT SEARCH DICTIONARY path_err1 AS
    split_text(delimiter := '/')
----
db error: ERROR: split_text(): unknown option "delimiter"
HINT: known names: case, break


# --- Replacement option not applicable to other tokenizers ---

statement error
CREATE TEXT SEARCH DICTIONARY path_err2 AS
    split_text(replacement := '-')
----
db error: ERROR: split_text(): unknown option "replacement"
HINT: known names: case, break


# --- Reverse option not applicable to other tokenizers ---

statement error
CREATE TEXT SEARCH DICTIONARY path_err3 AS
    split_text(reverse := true)
----
db error: ERROR: split_text(): unknown option "reverse"
HINT: known names: case, break


# --- Skip option not applicable to other tokenizers ---

statement error
CREATE TEXT SEARCH DICTIONARY path_err4 AS
    split_text(skip := 1)
----
db error: ERROR: split_text(): unknown option "skip"
HINT: known names: case, break


# PATH HIERARCHY TOKENIZER

# --- Basic forward hierarchy: default delimiter "/" ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_forward AS
    expand_path()


query
SELECT ts_lexize('path_forward', '/a/b/c');
----
ts_lexize
{/a,/a/b,/a/b/c}

# --- Forward hierarchy: empty delimiter -> "/" ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_forward_empty_delim AS
    expand_path('')

query
SELECT ts_lexize('path_forward_empty_delim', '/a/b/c');
----
ts_lexize
{/a,/a/b,/a/b/c}

# --- Path without leading slash ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_no_leading AS
    expand_path('/')


query
SELECT ts_lexize('path_no_leading', 'a/b/c');
----
ts_lexize
{a,a/b,a/b/c}


# --- Custom delimiter: colon ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_colon AS
    expand_path(':')


query
SELECT ts_lexize('path_colon', 'a:b:c');
----
ts_lexize
{a,a:b,a:b:c}


# --- Custom delimiter: dot (for domain-like paths) ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_dot AS
    expand_path('.')


query
SELECT ts_lexize('path_dot', 'com.example.www');
----
ts_lexize
{com,com.example,com.example.www}


# --- Custom delimiter with replacement ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_replace AS
    expand_path('/', replacement := '-')


query
SELECT ts_lexize('path_replace', '/a/b/c');
----
ts_lexize
{-a,-a-b,-a-b-c}


# --- Reverse mode: for domain hierarchies ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_reverse AS
    expand_path('/', reverse := true)


query
SELECT ts_lexize('path_reverse', '/a/b/c');
----
ts_lexize
{/a/b/c,a/b/c,b/c,c}


# --- Reverse with custom delimiter: domain names ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_domain AS
    expand_path('.', reverse := true)


query
SELECT ts_lexize('path_domain', 'com.example.www');
----
ts_lexize
{com.example.www,example.www,www}


# --- Skip first token: forward hierarchy ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_skip1 AS
    expand_path('/', skip := 1)


query
SELECT ts_lexize('path_skip1', '/a/b/c/d');
----
ts_lexize
{/b,/b/c,/b/c/d}


# --- Skip multiple tokens: forward hierarchy ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_skip2 AS
    expand_path('/', skip := 2)


query
SELECT ts_lexize('path_skip2', '/a/b/c/d');
----
ts_lexize
{/c,/c/d}


# --- Skip with reverse mode ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_skip_reverse AS
    expand_path('.', reverse := true, skip := 1)


query
SELECT ts_lexize('path_skip_reverse', 'com.example.www.api');
----
ts_lexize
{com.example.www.,example.www.,www.}


# --- Multi-character delimiter ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_multi_delim AS
    expand_path('::')


query
SELECT ts_lexize('path_multi_delim', 'a::b::c');
----
ts_lexize
{a,a::b,a::b::c}


# --- Custom replacement with multi-char delimiter ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_multi_replace AS
    expand_path('::', replacement := '/')


query
SELECT ts_lexize('path_multi_replace', 'a::b::c');
----
ts_lexize
{a,a/b,a/b/c}


# --- Single path element ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_single AS
    expand_path('/')


query
SELECT ts_lexize('path_single', '/root');
----
ts_lexize
{/root}


# --- Empty path ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_empty AS
    expand_path('/')


query
SELECT ts_lexize('path_empty', '');
----
ts_lexize
{}


# --- Path with trailing delimiter ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_trailing AS
    expand_path('/')


query
SELECT ts_lexize('path_trailing', '/a/b/');
----
ts_lexize
{/a,/a/b,/a/b/}


# --- Long path ---

statement ok
CREATE TEXT SEARCH DICTIONARY path_long AS
    expand_path('/')


query
SELECT ts_lexize('path_long', '/level1/level2/level3/level4/level5');
----
ts_lexize
{/level1,/level1/level2,/level1/level2/level3,/level1/level2/level3/level4,/level1/level2/level3/level4/level5}
