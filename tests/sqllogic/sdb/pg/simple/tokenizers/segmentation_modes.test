# Segmentation modes of split_text: alpha, all and graphic.

statement ok
CREATE TEXT SEARCH DICTIONARY seg_dict AS
    split_text(case := 'lower', break := 'alpha');

query
SELECT ts_lexize('seg_dict', 'The Quick fox-trot.');
----
ts_lexize
{the,quick,fox,trot}

statement ok
CREATE TEXT SEARCH DICTIONARY seg_all AS
    split_text(case := 'upper', break := 'all');

query
SELECT ts_lexize('seg_all', 'The Quick fox-trot.');
----
ts_lexize
{THE," ",QUICK," ",FOX,-,TROT,.}

statement ok
CREATE TEXT SEARCH DICTIONARY seg_graphic AS
    split_text(break := 'graphic');

query
SELECT ts_lexize('seg_graphic', 'The Quick fox-trot.');
----
ts_lexize
{The,Quick,fox,-,trot,.}
