statement ok
CREATE TEXT SEARCH DICTIONARY sp_synonyms AS
    split_text(case := 'lower') | expand_solr_synonyms('car, automobile, auto')
    WITH (frequency, position)


statement ok
CREATE TABLE sp_cars (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
INSERT INTO sp_cars VALUES
    (1, 'a red car here'),
    (2, 'red paint on a car'),
    (3, 'the red automobile');


statement ok
CREATE INDEX sp_cars_idx ON sp_cars USING inverted (id, body sp_synonyms);


statement ok
VACUUM (REFRESH_TABLE) sp_cars;


query
SELECT id FROM sp_cars_idx WHERE body @@ ts_phrase('red car') ORDER BY id;
----
id
1
3


query
SELECT id FROM sp_cars_idx WHERE body @@ phraseto_tsquery('red auto') ORDER BY id;
----
id
1
3


query
SELECT id FROM sp_cars_idx WHERE body @@ websearch_to_tsquery('"red automobile"') ORDER BY id;
----
id
1
3


query
SELECT id FROM sp_cars_idx WHERE body @@ ts_phrase('car') ORDER BY id;
----
id
1
2
3


query
SELECT id, BM25(sp_cars_idx.tableoid) > 0 AS scored FROM sp_cars_idx
WHERE body @@ ts_phrase('car', slop := 1) ORDER BY id;
----
id	scored
1	t
2	t
3	t


