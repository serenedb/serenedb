CREATE TEXT SEARCH DICTIONARY sp_grams AS
    split_text(case := 'lower') | generate_ngrams(2, 3) | filter_tokens(min_length := 3)
    WITH (frequency, position)


statement ok
CREATE TABLE sp_words (id INTEGER PRIMARY KEY, body VARCHAR);


statement ok
