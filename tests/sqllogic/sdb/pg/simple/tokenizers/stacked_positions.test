CREATE TEXT SEARCH DICTIONARY sp_oneway AS
    split_text(case := 'lower') | expand_solr_synonyms('car => automobile, auto')
    WITH (frequency, position)


statement ok
CREATE TABLE sp_oneway_cars (id INTEGER PRIMARY KEY, body VARCHAR);


