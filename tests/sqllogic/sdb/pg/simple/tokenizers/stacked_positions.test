query
SELECT c.id, abs(c.s - r.s) < 1e-6 AS same
FROM (SELECT id, BM25(sp_cars_idx.tableoid) AS s FROM sp_cars_idx WHERE body @@ 'car') c
JOIN (SELECT id, BM25(sp_cars_idx.tableoid) AS s FROM sp_cars_idx WHERE body @@ 'red') r
ON c.id = r.id
ORDER BY c.id;
----
id	same
1	t
2	t
3	t


