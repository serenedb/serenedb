control substitution on


# ERROR CASES

# --- Missing required parameter: template ---

statement error does not read input
CREATE TEXT SEARCH DICTIONARY t_err1 AS 'en_US.UTF-8'


# --- Invalid template value ---

statement error
CREATE TEXT SEARCH DICTIONARY t_err2 AS
    whaaat(locale := 'en_US.UTF-8')
----
db error: ERROR: "whaaat" is not a text search template and does not read input
HINT: an SQL stage must reference the input as $1, e.g. whaaat($1)



# --- Duplicate option ---

statement error given more than once
CREATE TEXT SEARCH DICTIONARY t_err3 AS
    split_text('lower', case := 'upper')


# --- Invalid case value ---

statement error
CREATE TEXT SEARCH DICTIONARY t_err4 AS
    split_text(case := 'invalid') | stem_words('en_US.UTF-8')
----
db error: ERROR: invalid value in "case" parameter
HINT: Text case conversion: none, lower, upper



# --- Option not supported by tokenizer ---

statement error
CREATE TEXT SEARCH DICTIONARY t_err5 AS
    generate_ngrams(locale := 'en_US.UTF-8')
----
db error: ERROR: generate_ngrams(): unknown option "locale"
HINT: known names: mingram, maxgram, preserveoriginal, inputtype, startmarker, endmarker, mode



statement error
CREATE TEXT SEARCH DICTIONARY t_err6 AS
    stem_words(stopwords := ['a', 'the'])
----
db error: ERROR: stem_words(): unknown option "stopwords"
HINT: known names: locale



statement error
CREATE TEXT SEARCH DICTIONARY t_err7 AS
    split_text(accent := true)
----
db error: ERROR: split_text(): unknown option "accent"
HINT: known names: case, break



statement error
CREATE TEXT SEARCH DICTIONARY t_err8 AS
    split_text(ngramsize := 5)
----
db error: ERROR: split_text(): unknown option "ngramsize"
HINT: known names: case, break



statement error
CREATE TEXT SEARCH DICTIONARY t_err9 AS
    normalize_tokens('en_US.UTF-8', delimiter := ',')
----
db error: ERROR: normalize_tokens(): unknown option "delimiter"
HINT: known names: locale, case, accent, form



statement error
CREATE TEXT SEARCH DICTIONARY t_err10 AS
    collate_tokens('en_US.UTF-8', mingram := 2)
----
db error: ERROR: collate_tokens(): unknown option "mingram"
HINT: known names: locale



