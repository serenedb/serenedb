# --- ts_lexize on non-existent dictionary ---

query error
SELECT ts_lexize('other_tokenizer', 'a QUICK Brown Fox');
----
db error: ERROR: text search dictionary "other_tokenizer" does not exist


# TEXT TEMPLATE

# --- Basics: default case (lower), default stemming (true) ---

statement ok
CREATE TEXT SEARCH DICTIONARY t1 AS
    split_text() | stem_words('en_US.UTF-8')


query
SELECT ts_lexize('t1', 'a QUICK Brown FoX');
----
ts_lexize
{a,QUICK,Brown,FoX}


# --- ts_lexize array overload ---
# Concatenates tokens from each element in input order.

query
SELECT ts_lexize('t1', ARRAY['a QUICK Brown', 'FoX jumps']);
----
ts_lexize
{a,QUICK,Brown,FoX,jump}


# Empty array -> empty result (no tokens to concatenate).
query
SELECT ts_lexize('t1', ARRAY[]::VARCHAR[]);
----
ts_lexize
{}


# Single-element array equals the scalar form.
query
SELECT ts_lexize('t1', ARRAY['a QUICK Brown FoX']);
----
ts_lexize
{a,QUICK,Brown,FoX}


# NULL elements are skipped (treated as empty contribution).
query
SELECT ts_lexize('t1', ARRAY['Alpha Beta', NULL, 'Gamma']);
----
ts_lexize
{Alpha,Beta,Gamma}


# NULL array yields NULL output (per SPECIAL_HANDLING).
query
SELECT ts_lexize('t1', NULL::VARCHAR[]) IS NULL;
----
?column?
t


# NULL dict name yields NULL output.
query
SELECT ts_lexize(NULL::VARCHAR, ARRAY['Hello']) IS NULL;
----
?column?
t


# Non-existent dict raises -- same error as the scalar overload.
statement error
SELECT ts_lexize('does_not_exist', ARRAY['Hello']);


# --- case = upper ---

statement ok
CREATE TEXT SEARCH DICTIONARY t2 AS
    split_text(case := 'upper') | stem_words('en_US.UTF-8')


query
SELECT ts_lexize('t2', 'a QUICK Brown FoX');
----
ts_lexize
{A,QUICK,BROWN,FOX}


# --- case = none, stemming = false: preserves original case ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_case_none AS
    split_text()


query
SELECT ts_lexize('text_case_none', 'Hello World');
----
ts_lexize
{Hello,World}


# --- stemming = false: words are not reduced to their root ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_no_stem AS
    split_text(case := 'lower')


query
SELECT ts_lexize('text_no_stem', 'running quickly');
----
ts_lexize
{running,quickly}


# --- stemming = true (explicit): reduces words to their root ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_with_stem AS
    split_text(case := 'lower') | stem_words('en_US.UTF-8')


query
SELECT ts_lexize('text_with_stem', 'running');
----
ts_lexize
{run}


# --- accent = false (default): strips diacritics ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_no_accent AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)


query
SELECT ts_lexize('text_no_accent', 'café résumé');
----
ts_lexize
{cafe,resume}


# --- accent = true: preserves diacritics ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_with_accent AS
    split_text(case := 'lower')


query
SELECT ts_lexize('text_with_accent', 'café résumé');
----
ts_lexize
{café,résumé}


# --- Russian locale with case = upper ---

statement ok
CREATE TEXT SEARCH DICTIONARY t3 AS
    split_text(case := 'upper') | stem_words('ru_RU.UTF-16')


query
SELECT ts_lexize('t3', 'БЫстрая Коричневая лИса');
----
ts_lexize
{БЫСТРАЯ,КОРИЧНЕВАЯ,ЛИСА}


# --- Inline stopwords with whitespace trimming ---

statement ok
CREATE TEXT SEARCH DICTIONARY t4 AS
    split_text(case := 'lower') | remove_stopwords(['a', 'and', 'of']) | stem_words('en_US.UTF-8')


query
SELECT ts_lexize('t4', 'A thing of some KIND and ANoTher');
----
ts_lexize
{thing,some,kind,anoth}


# --- Edge ngrams from text tokenizer (mingram, maxgram) ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_edge_ngram AS
    split_text(case := 'lower') | generate_ngrams(2, 4, mode := 'only_prefix')


query
SELECT ts_lexize('text_edge_ngram', 'hello');
----
ts_lexize
{he,hel,hell}

# --- Edge ngrams from text tokenizer (mingram, maxgram(default)) ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_edge_ngram_no_maxgram AS
    split_text(case := 'lower') | generate_ngrams(2, 3, mode := 'only_prefix')


query
SELECT ts_lexize('text_edge_ngram_no_maxgram', 'hello');
----
ts_lexize
{he,hel}


# --- Edge ngrams interact with stemming: stem first, then ngram ---

statement ok
CREATE TEXT SEARCH DICTIONARY text_stem_ngram AS
    split_text(case := 'lower') | stem_words('en_US.UTF-8') | generate_ngrams(2, 3, mode := 'only_prefix')


query
SELECT ts_lexize('text_stem_ngram', 'running');
----
ts_lexize
{ru,run}


