# PIPELINE TEMPLATE

# --- Invalid step template ---
statement error
CREATE TEXT SEARCH DICTIONARY pipe_err1 AS
    invalid_tokenizer()
----
db error: ERROR: "invalid_tokenizer" is not a text search template and does not read input
HINT: an SQL stage must reference the input as $1, e.g. invalid_tokenizer($1)


statement ok
CREATE TEXT SEARCH DICTIONARY pipe_pipe AS
    normalize_tokens('en_US.UTF-8', case := 'lower')
    | split_csv('|')
    | normalize_tokens('en_US.UTF-8', case := 'upper')
    | remove_stopwords(['A'])


query
SELECT ts_lexize('pipe_pipe', 'a|quick|Brown|FOX!');
----
ts_lexize
{QUICK,BROWN,FOX!}


# --- Three-step: delimiter -> text with correct stopwords -> norm ---
statement ok
CREATE TEXT SEARCH DICTIONARY pipe_correct_stopwords AS
    split_csv('A')
    | split_text(case := 'lower')
    | normalize_tokens('en_US.UTF-8', accent := false)
    | remove_stopwords(['fox'])
    | stem_words('en_US.UTF-8')
    | normalize_tokens('en_US.UTF-8', case := 'upper')

query
SELECT ts_lexize('pipe_correct_stopwords', 'QuickABrownAFOXAjUmps');
----
ts_lexize
{QUICK,BROWN,JUMP}


# --- Single-step pipeline with text tokenizer ---
statement ok
CREATE TEXT SEARCH DICTIONARY pipe_single_text AS
    split_text(case := 'lower') | stem_words('en_US.UTF-8')

query
SELECT ts_lexize('pipe_single_text', 'QuIck broWn fox jumps');
----
ts_lexize
{quick,brown,fox,jump}


