ts_lexize
{quick}


# --- Text then norm (source-modifying tokenizer) ---
statement ok
CREATE TEXT SEARCH DICTIONARY pipe_text_norm AS
    split_text() | stem_words('en_US.UTF-8')
    | normalize_tokens('en_US.UTF-8', case := 'lower')

query
SELECT ts_lexize('pipe_text_norm', 'QuIck broWn fox jumps');
----
ts_lexize
{quick,brown,fox,jump}


# --- NGram then norm (lowercasing ngrams) ---
statement ok
CREATE TEXT SEARCH DICTIONARY pipe_ngram_norm AS
    generate_ngrams(2, 3) | normalize_tokens('en_US.UTF-8', case := 'lower')

query
SELECT ts_lexize('pipe_ngram_norm', 'QuIck');
----
ts_lexize
{qu,qui,ui,uic,ic,ick,ck}


# --- Two-step: delimiter then text ---
statement ok
CREATE TEXT SEARCH DICTIONARY pipe_delim_text AS
    split_csv('.')
    | split_text(case := 'upper')

query
SELECT ts_lexize('pipe_delim_text', 'Hello.World.Foo.baR');
----
ts_lexize
{HELLO,WORLD,FOO,BAR}


