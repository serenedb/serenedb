statement ok
CREATE TEXT SEARCH DICTIONARY fn_words AS split_text(case := 'lower');

query
SELECT split_text('The Quick fox-trot.', case := 'lower') AS t;
----
t
{the,quick,fox,trot}

query
SELECT split_text('The Quick fox-trot.', 'lower') = ts_lexize('fn_words', 'The Quick fox-trot.') AS same;
----
same
t

query
SELECT split_text('The Quick fox-trot.') AS t;
----
t
{The,Quick,fox,trot}

query
SELECT split_text('Hello world. Second sentence!', break := 'sentence') AS t;
----
t
{"Hello world.","Second sentence!"}

query
SELECT SPLIT_TEXT('A b', Case := 'upper') AS t;
----
t
{A,B}

query
SELECT split_text('A b', case := NULL) AS t;
----
t
{A,b}

query
SELECT split_text(NULL::VARCHAR) IS NULL AS n;
----
n
t

query
SELECT split_text(['Quick Fox', 'lazy DOG'], case := 'lower') AS t;
----
t
{quick,fox,lazy,dog}

query
SELECT split_text([NULL, 'One two']::VARCHAR[]) AS t;
----
t
{One,two}

query
SELECT split_text_csv('red,green,blue', ',') AS t;
----
t
{red,green,blue}

query
SELECT split_by_delimiters('a,b;c', [',', ';']) AS t;
----
t
{a,b,c}

query
SELECT split_by_non_alpha('Hello, World! 123_abc', case := 'lower') AS t;
----
t
{hello,world,123,abc}

query
SELECT stem_words(split_text('The runners were running', case := 'lower'), 'en_US.UTF-8') AS t;
----
t
{the,runner,were,run}

query
SELECT normalize_tokens(['Café', 'ÉCOLE'], 'en_US.UTF-8', case := 'lower', accent := false) AS t;
----
t
{cafe,ecole}

query
SELECT remove_stopwords(['the', 'cat', 'is', 'a', 'hunter'], ['the', 'is', 'a']) AS t;
----
t
{cat,hunter}

statement ok
CREATE TEXT SEARCH DICTIONARY fn_ngram AS generate_ngrams(2, 3);

query
SELECT generate_ngrams('abcd', 2, 3) = ts_lexize('fn_ngram', 'abcd') AS same;
----
same
t

query
SELECT generate_ngrams('search', 2, 4, mode := 'only_prefix') AS t;
----
t
{se,sea,sear}

statement ok
CREATE TEXT SEARCH DICTIONARY fn_english AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false) | remove_stopwords(['the']) | stem_words('en_US.UTF-8');

query
SELECT stem_words(remove_stopwords(normalize_tokens(split_text('The Runners were Running', case := 'lower'), 'en_US.UTF-8', accent := false), ['the']), 'en_US.UTF-8')
       = ts_lexize('fn_english', 'The Runners were Running') AS same;
----
same
t

query
SELECT array_length(generate_shingles(split_text_csv('quick brown fox', ' '), 2, 2), 1) AS n;
----
n
5

query
SELECT generate_shingles('quick brown fox', 2, 2) AS t;
----
t
{"quick brown fox"}

# An empty token stream has no shingles, as in a dictionary; an empty element is still a token.

query
SELECT generate_shingles([]::VARCHAR[], 2, 2, store_tokens := false) AS empty_list,
       generate_shingles(remove_stopwords(['the'], ['the']), 2, 2, store_tokens := false) AS emptied,
       list_transform(generate_shingles(['', 'b'], 2, 2, store_tokens := false), x -> hex(x::BLOB)) AS kept;
----
empty_list	emptied	kept
{}	{}	{"",2062,62}

# A NULL list yields NULL, for both wrappers; an empty list yields no terms.

query
SELECT generate_shingles(NULL::VARCHAR[], 2, 2) IS NULL AS null_shingles,
       generate_wildcard_ngrams(NULL::VARCHAR[], 3) IS NULL AS null_wildcard,
       generate_wildcard_ngrams([]::VARCHAR[], 3) AS empty_wildcard;
----
null_shingles	null_wildcard	empty_wildcard
t	t	{}

# token_separator reaches the function form: an explicit '' is not folded away.

query
SELECT generate_shingles(['a', 'b'], 2, 2, store_tokens := false) AS spaced,
       generate_shingles(['a', 'b'], 2, 2, store_tokens := false, token_separator := '') AS joined,
       generate_shingles(['a', 'b'], 2, 2, store_tokens := false, token_separator := ' ') AS explicit_space;
----
spaced	joined	explicit_space
{a,"a b",b}	{a,ab,b}	{a,"a b",b}

statement ok
CREATE TEXT SEARCH DICTIONARY fn_wild AS generate_wildcard_ngrams(keyword(), 3);

query
SELECT generate_wildcard_ngrams('search', 3) = ts_lexize('fn_wild', 'search') AS same;
----
same
t

query
SELECT typeof(collate_tokens('abc', 'en_US.UTF-8')) AS t;
----
t
BLOB[]

query
SELECT typeof(encode_geopoint('{"lat": 1.5, "lng": 2.5}'::JSON, ['lat'], ['lng'])) AS t, array_length(encode_geopoint('{"lat": 1.5, "lng": 2.5}'::JSON, ['lat'], ['lng']), 1) > 0 AS has_terms;
----
t	has_terms
BLOB[]	t

statement ok
CREATE TABLE fn_docs (id INTEGER, body VARCHAR);

statement ok
INSERT INTO fn_docs VALUES (1, 'The Runners'), (2, NULL), (3, 'were Running');

query
SELECT id, stem_words(split_text(body, case := 'lower'), 'en_US.UTF-8') AS t FROM fn_docs ORDER BY id;
----
id	t
1	{the,runner}
2	NULL
3	{were,run}

statement error must be a constant
SELECT split_text(v, case := c) FROM (VALUES ('A', 'lower')) AS t(v, c);

statement error
SELECT split_text('a', locale := 'en');
