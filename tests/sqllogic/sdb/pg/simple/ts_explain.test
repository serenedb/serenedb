WHERE body @@ 'crème' AND ip = '10.0.0.1'::INET
ORDER BY BM25(explain_labels_idx.tableoid) DESC, id;
----
id	why
1	{"clauses":[{"column":"ip","expression":"boost * value","inputs":{"value":{"value":1}},"scorer":"constant(value=1)","term":"10.0.0.1","value":1},{"column":"body","expression":"boost * idf * tf","inputs":{"idf":{"expression":"log(1 + (N - df + 0.5) / (df + 0.5))","inputs":{"N":{"value":2},"df":{"value":2}},"value":0.18232156},"tf":{"expression":"freq / (freq + k1 * (1 - b + b * dl / avgdl))","inputs":{"avgdl":{"expression":"L / N","inputs":{"L":{"value":3},"N":{"value":2}},"value":1.5},"b":{"value":0.75},"dl":{"note":"the column records no lengths, so every row counts as 1","value":1},"freq":{"value":1},"k1":{"value":1.2}},"value":0.52631575}},"scorer":"bm25(k1=1.2, b=0.75)","term":"crème","value":0.09595872}],"expression":"sum","value":1.0959587}

