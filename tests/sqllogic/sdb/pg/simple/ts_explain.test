statement ok
CREATE TABLE explain_docs (id INTEGER PRIMARY KEY, body VARCHAR, tag VARCHAR, emb FLOAT[2]);

statement ok
CREATE TEXT SEARCH DICTIONARY explain_en AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);

statement ok
CREATE INDEX explain_idx ON explain_docs USING inverted (id, body explain_en, tag);

statement ok
INSERT INTO explain_docs VALUES
    (1, 'the quick brown fox', 'animal', [1, 0]),
    (2, 'fox fox fox in the henhouse', 'animal', [0, 1]),
    (3, 'a clever fox outwits two hounds in the meadow', 'story', [1, 1]),
    (4, 'quick brown dog runs', 'animal', [2, 0]),
    (5, 'the lazy dog sleeps all day', 'story', [0, 2]);

query
SELECT id, ts_explain(explain_idx.tableoid) AS why
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY BM25(explain_idx.tableoid) DESC, id
LIMIT 1;
----
id	why
2	{"value":0.38217354,"description":"weight(body:fox) [bm25(k1=1.2, b=0.75)], computed as boost * idf * tf from:","details":[{"value":0.5389965,"description":"idf, computed as log(1 + (N - n + 0.5) / (n + 0.5)) from:","details":[{"value":3,"description":"n, number of rows containing the term","details":[]},{"value":5,"description":"N, number of rows with the column","details":[]}]},{"value":0.7090465,"description":"tf, computed as freq / (freq + k1 * (1 - b + b * dl / avgdl)) from:","details":[{"value":3,"description":"freq, occurrences of the term in the row","details":[]},{"value":1.2,"description":"k1, term saturation parameter","details":[]},{"value":0.75,"description":"b, length normalization parameter","details":[]},{"value":6,"description":"dl, length of the column in the row","details":[]},{"value":5.8,"description":"avgdl, average length of the column, computed as L / N from:","details":[{"value":29,"description":"L, total length of the column over all rows","details":[]},{"value":5,"description":"N, number of rows with the column","details":[]}]}]}]}

query
SELECT id, (ts_explain(explain_idx.tableoid)->>'value')::FLOAT = BM25(explain_idx.tableoid) AS same
FROM explain_idx
WHERE body @@ 'fox quick dog'
ORDER BY id;
----
id	same
1	t
2	t
3	t
4	t
5	t

query
SELECT id, (why->>'value')::FLOAT = score AS same
FROM (
    SELECT id, BM25(explain_idx.tableoid) AS score, ts_explain(explain_idx.tableoid) AS why
    FROM explain_idx
    WHERE body @@ 'fox quick dog'
    ORDER BY score DESC
    LIMIT 2
) t
ORDER BY id;
----
id	same
1	t
4	t

