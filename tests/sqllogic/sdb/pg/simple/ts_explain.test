query
SELECT id, ts_explain(explain_labels_idx.tableoid) AS why
FROM explain_labels_idx
WHERE n = 42 OR big = 9000000000 OR d = 1.5 OR net = '10.0.0.0/8'::CIDR OR txt = 'Crème'
    OR doc->>'host' = 'web-01' OR LOWER(txt) = 'crème' OR g = 420
ORDER BY constant(explain_labels_idx.tableoid, 1) DESC, id;
