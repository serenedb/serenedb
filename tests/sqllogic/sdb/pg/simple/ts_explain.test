query
SELECT id,
       ts_explain(explain_idx.tableoid)->>'description' AS phrase,
       json_array_length(ts_explain(explain_idx.tableoid)->'details'->0->'details') AS idfs
FROM explain_idx
WHERE body @@ ts_phrase('quick brown')
ORDER BY BM25(explain_idx.tableoid) DESC, id;
