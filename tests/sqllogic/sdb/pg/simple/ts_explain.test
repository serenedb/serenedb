4	2	l2_norm(emb) = sqrt(sum(emb[i]^2)), computed from the row's stored vector

statement ok
CREATE INDEX explain_hnsw ON explain_docs USING inverted (id, emb hnsw (metric = 'cosine'));

query
SELECT id, ts_explain(explain_hnsw.tableoid) AS why
FROM explain_hnsw
ORDER BY emb <=> [1, 0.9]::FLOAT[2]
LIMIT 1;
----
id	why
3	{"value":0.0013821721,"description":"cosine_distance(emb, query) = 1 - sum(emb[i] * query[i]) / (sqrt(sum(emb[i]^2)) * sqrt(sum(query[i]^2))), found by an hnsw search over sq8 codes","details":[{"value":0.0013821721,"description":"exact, the distance computed from the row's stored vector","details":[]},{"value":2,"description":"dims, dimensions of the vectors","details":[]},{"value":1,"description":"k, the number of nearest rows the search returns","details":[]},{"value":200,"description":"ef_search, candidates the search keeps in its beam","details":[]},{"value":2,"description":"rescore_width, how far a code score may be off and still be read again at full precision","details":[]}]}
