PREPARE explain_term(VARCHAR) AS
SELECT id, ts_explain(explain_idx.tableoid).term::VARCHAR AS term
FROM explain_idx
WHERE body @@ $1
ORDER BY BM25(explain_idx.tableoid) DESC, id
LIMIT 1;

query
EXECUTE explain_term('dog');
----
id	term
4	dog

query
EXECUTE explain_term('henhouse');
----
id	term
2	henhouse

statement ok
DEALLOCATE explain_term;

query
SELECT a.id,
       ts_explain(a.tableoid).value::FLOAT = BM25(a.tableoid) AS left_same,
       ts_explain(b.tableoid).value::FLOAT = BM25(b.tableoid) AS right_same
FROM explain_idx a
JOIN explain_idx b ON a.id = b.id
WHERE a.body @@ 'fox' AND b.body @@ 'the'
ORDER BY a.id;
----
id	left_same	right_same
1	t	t
2	t	t
3	t	t

query
SELECT id, ts_explain_json(ts_explain(explain_idx.tableoid)) AS lucene
FROM explain_idx
WHERE body @@ 'brown' OR (body @@ 'dog')::score(NULL)
ORDER BY BM25(explain_idx.tableoid) DESC, id DESC
LIMIT 1;
----
id	lucene
4	{"value":0.45580956,"description":"sum of:","details":[{"value":0.45580956,"description":"weight(body:brown) [bm25(k1=1.2, b=0.75)], computed as boost * idf * tf from:","details":[{"value":0.87546873,"description":"idf, computed as log(1 + (N - df + 0.5) / (df + 0.5)) from:","details":[{"value":5,"description":"N, number of rows with the column","details":[]},{"value":2,"description":"df, number of rows containing the term","details":[]}]},{"value":0.52064633,"description":"tf, computed as freq / (freq + k1 * (1 - b + b * dl / avgdl)) from:","details":[{"value":5.8,"description":"avgdl, average length of the column, computed as L / N from:","details":[{"value":29,"description":"L, total length of the column over all rows","details":[]},{"value":5,"description":"N, number of rows with the column","details":[]}]},{"value":0.75,"description":"b, length normalization parameter","details":[]},{"value":4,"description":"dl, length of the column in the row","details":[]},{"value":1,"description":"freq, occurrences of the term in the row","details":[]},{"value":1.2,"description":"k1, term saturation parameter","details":[]}]}]},{"value":0,"description":"match(body:dog), matches without scoring","details":[]}]}

