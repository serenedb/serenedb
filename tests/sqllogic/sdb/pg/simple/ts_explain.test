statement ok
CREATE TABLE explain_docs (id INTEGER PRIMARY KEY, body VARCHAR, tag VARCHAR, emb FLOAT[2]);

statement ok
CREATE TEXT SEARCH DICTIONARY explain_en AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position, norm);

statement ok
CREATE INDEX explain_idx ON explain_docs USING inverted (id, body explain_en, tag);

statement ok
INSERT INTO explain_docs VALUES
    (1, 'the quick brown fox', 'animal', [1, 0]),
    (2, 'fox fox fox in the henhouse', 'animal', [0, 1]),
    (3, 'a clever fox outwits two hounds in the meadow', 'story', [1, 1]),
    (4, 'quick brown dog runs', 'animal', [2, 0]),
    (5, 'the lazy dog sleeps all day', 'story', [0, 2]);

query
SELECT id, ts_explain(explain_idx.tableoid) AS why
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY BM25(explain_idx.tableoid) DESC, id
LIMIT 1;
----
id	why
2	{"column":"body","expression":"boost * idf * tf","inputs":{"idf":{"expression":"log(1 + (N - df + 0.5) / (df + 0.5))","inputs":{"N":{"value":5},"df":{"value":3}},"value":0.5389965},"tf":{"expression":"freq / (freq + k1 * (1 - b + b * dl / avgdl))","inputs":{"avgdl":{"expression":"L / N","inputs":{"L":{"value":29},"N":{"value":5}},"value":5.8},"b":{"value":0.75},"dl":{"value":6},"freq":{"value":3},"k1":{"value":1.2}},"value":0.7090465}},"scorer":"bm25(k1=1.2, b=0.75)","term":"fox","value":0.38217354}

query
SELECT id,
       ts_explain(explain_idx.tableoid).inputs.idf.value::FLOAT AS idf,
       ts_explain(explain_idx.tableoid).inputs.tf.inputs.freq.value::INTEGER AS freq
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY BM25(explain_idx.tableoid) DESC, id;
----
id	idf	freq
2	0.5389965	3
1	0.5389965	1
3	0.5389965	1

query
SELECT id, ts_explain(explain_idx.tableoid).value::FLOAT = BM25(explain_idx.tableoid) AS same
FROM explain_idx
WHERE body @@ 'fox quick dog'
ORDER BY id;
----
id	same
1	t
2	t
3	t
4	t
5	t

query
SELECT id, why.value::FLOAT = score AS same
FROM (
    SELECT id, BM25(explain_idx.tableoid) AS score, ts_explain(explain_idx.tableoid) AS why
    FROM explain_idx
    WHERE body @@ 'fox quick dog'
    ORDER BY score DESC
    LIMIT 2
) t
ORDER BY id;
----
id	same
1	t
4	t

query
SELECT id,
       ts_explain(explain_idx.tableoid).value::FLOAT = TFIDF(explain_idx.tableoid, true) AS same,
       ts_explain(explain_idx.tableoid).scorer::VARCHAR AS scorer,
       ts_explain(explain_idx.tableoid).expression::VARCHAR AS expression
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY id;
----
id	same	scorer	expression
1	t	tfidf(with_norms=true)	boost * idf * tf * norm
2	t	tfidf(with_norms=true)	boost * idf * tf * norm
3	t	tfidf(with_norms=true)	boost * idf * tf * norm

query
SELECT id,
       ts_explain(explain_idx.tableoid).value::FLOAT = lm_dirichlet(explain_idx.tableoid, 10) AS same,
       ts_explain(explain_idx.tableoid).scorer::VARCHAR AS scorer,
       ts_explain(explain_idx.tableoid).expression::VARCHAR AS expression
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY id;
----
id	same	scorer	expression
1	t	lm_dirichlet(mu=10)	boost * max(0, log(1 + freq / (mu * p)) - log(1 + dl / mu))
2	t	lm_dirichlet(mu=10)	boost * max(0, log(1 + freq / (mu * p)) - log(1 + dl / mu))
3	t	lm_dirichlet(mu=10)	boost * max(0, log(1 + freq / (mu * p)) - log(1 + dl / mu))

query
SELECT id,
       ts_explain(explain_idx.tableoid).expression::VARCHAR AS root,
       json_array_length(ts_explain(explain_idx.tableoid).clauses::JSON) AS clauses,
       ts_explain(explain_idx.tableoid).clauses[1].term::VARCHAR AS first
FROM explain_idx
WHERE body @@ 'fox quick'
ORDER BY BM25(explain_idx.tableoid) DESC, id;
----
id	root	clauses	first
1	sum	2	fox
4	sum	1	quick
2	sum	1	fox
3	sum	1	fox

