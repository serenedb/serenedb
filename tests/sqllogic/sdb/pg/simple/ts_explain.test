CREATE TEXT SEARCH DICTIONARY explain_kw AS keyword() WITH (frequency);

statement ok
CREATE TABLE explain_labels (
    id INTEGER PRIMARY KEY, body VARCHAR, ip INET, flag BOOLEAN, doc JSON, n INTEGER, big BIGINT, d DOUBLE,
    net CIDR, txt VARCHAR, g INTEGER GENERATED ALWAYS AS (n * 10) STORED);

statement ok
CREATE INDEX explain_labels_idx ON explain_labels USING inverted (
    id, body explain_plain, ip, flag, (doc->'v') explain_kw, n, big, d, net, txt, (doc->>'host'), (LOWER(txt)), g);

