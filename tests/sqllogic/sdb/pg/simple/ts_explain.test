3	{"column":"emb","expression":"sqrt(sum((emb[i] - query[i])^2))","inputs":{"dims":{"value":2},"exact":{"value":0.8},"radius":{"note":"the search returns distances below it","value":0.9}},"note":"found by an ivf search over sq8 codes","scorer":"l2_distance","value":0.8}

