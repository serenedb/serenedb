SELECT id,
       ts_explain(explain_idx.tableoid)->>'description' AS root,
       json_array_length(ts_explain(explain_idx.tableoid)->'details') AS clauses
FROM explain_idx
WHERE body @@ 'fox quick'
ORDER BY BM25(explain_idx.tableoid) DESC, id;
