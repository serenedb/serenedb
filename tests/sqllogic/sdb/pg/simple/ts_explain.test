statement ok
PREPARE explain_term(VARCHAR) AS
SELECT id, ts_explain(explain_idx.tableoid)->>'description' AS description
FROM explain_idx
WHERE body @@ $1
ORDER BY BM25(explain_idx.tableoid) DESC, id
LIMIT 1;

query
EXECUTE explain_term('dog');
----
id	description
4	weight(body:dog) [bm25(k1=1.2, b=0.75)], computed as boost * idf * tf from:

query
EXECUTE explain_term('henhouse');
----
id	description
2	weight(body:henhouse) [bm25(k1=1.2, b=0.75)], computed as boost * idf * tf from:

statement ok
DEALLOCATE explain_term;

query
SELECT a.id,
       (ts_explain(a.tableoid)->>'value')::FLOAT = BM25(a.tableoid) AS left_same,
       (ts_explain(b.tableoid)->>'value')::FLOAT = BM25(b.tableoid) AS right_same
FROM explain_idx a
JOIN explain_idx b ON a.id = b.id
WHERE a.body @@ 'fox' AND b.body @@ 'the'
ORDER BY a.id;
----
id	left_same	right_same
1	t	t
2	t	t
3	t	t

