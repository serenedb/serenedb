query
EXPLAIN SELECT id, ts_explain(explain_idx.tableoid)
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY BM25(explain_idx.tableoid) DESC
LIMIT 1;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────╮
│ Index: explain_idx                       │
│ Lookup: search                           │
│ Index Filter:                            │
│ ╭─ Term ──────────────╮                  │
│ │ Field: body(string) │                  │
│ │ Value: fox          │                  │
│ ╰─────────────────────╯                  │
│ Score: bm25(k1=1.2, b=0.75), explained   │
│ Top: 1                                   │
│ Projections: id,                         │
│              sdb_inverted_index_explain  │
│ ~1 row                                   │
╰──────────────────────────────────────────╯

statement ok
CREATE INDEX explain_vec ON explain_docs USING inverted (id, emb ivf (metric = 'l2'));

query
SELECT id, emb <-> [1, 0.2]::FLOAT[2] AS distance, ts_explain(explain_vec.tableoid) AS why
FROM explain_vec
ORDER BY emb <-> [1, 0.2]::FLOAT[2]
LIMIT 2;
----
id	distance	why
1	0.2	{"value":0.2,"description":"l2_distance(emb, query) = sqrt(sum((emb[i] - query[i])^2)), found by an ivf search over sq8 codes","details":[{"value":0.2,"description":"exact, the distance computed from the row's stored vector","details":[]},{"value":2,"description":"dims, dimensions of the vectors","details":[]},{"value":2,"description":"k, the number of nearest rows the search returns","details":[]},{"value":2,"description":"rescore_width, how far a code score may be off and still be read again at full precision","details":[]}]}
3	0.8	{"value":0.8,"description":"l2_distance(emb, query) = sqrt(sum((emb[i] - query[i])^2)), found by an ivf search over sq8 codes","details":[{"value":0.8,"description":"exact, the distance computed from the row's stored vector","details":[]},{"value":2,"description":"dims, dimensions of the vectors","details":[]},{"value":2,"description":"k, the number of nearest rows the search returns","details":[]},{"value":2,"description":"rescore_width, how far a code score may be off and still be read again at full precision","details":[]}]}

query
EXPLAIN SELECT id, ts_explain(explain_vec.tableoid)
FROM explain_vec
ORDER BY emb <-> [1, 0.2]::FLOAT[2]
LIMIT 2;
----
QUERY PLAN
╭─ IRESEARCH_SCAN ─────────────────────────╮
│ Index: explain_vec                       │
│ Lookup: search                           │
│ Score:                                   │
│ l2_distance(emb, FLOAT[2]), explained    │
│ Top: 2                                   │
│ Projections: id,                         │
│              sdb_inverted_index_explain  │
│ ~5 rows                                  │
╰──────────────────────────────────────────╯

query
