query
EXPLAIN SELECT id, ts_explain(explain_idx.tableoid)
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY BM25(explain_idx.tableoid) DESC
LIMIT 1;
----
QUERY PLAN
╭─ PROJECTION ─────────────────────────────╮
│ Projections: #0, CAST(#1 AS JSON)        │
│ ~1 row                                   │
╰─────────────────────┬────────────────────╯
╭─ IRESEARCH_SCAN ────┴────────────────────╮
│ Index: explain_idx                       │
│ Lookup: search                           │
│ Index Filter:                            │
│ ╭─ Term ──────────────╮                  │
│ │ Field: body(string) │                  │
│ │ Value: fox          │                  │
│ ╰─────────────────────╯                  │
│ Score: bm25(k1=1.2, b=0.75), explained   │
│ Top: 1                                   │
│ Projections: id,                         │
│              sdb_inverted_index_explain  │
│ ~1 row                                   │
╰──────────────────────────────────────────╯

statement ok
CREATE INDEX explain_vec ON explain_docs USING inverted (id, emb ivf (metric = 'l2'));

query
SELECT id, emb <-> [1, 0.2]::FLOAT[2] AS distance, ts_explain(explain_vec.tableoid) AS why
FROM explain_vec
ORDER BY emb <-> [1, 0.2]::FLOAT[2]
LIMIT 2;
----
id	distance	why
1	0.2	{"column":"emb","expression":"sqrt(sum((emb[i] - query[i])^2))","inputs":{"dims":{"value":2},"exact":{"value":0.2},"k":{"value":2},"rescore_width":{"value":2}},"note":"found by an ivf search over sq8 codes","scorer":"l2_distance","value":0.2}
3	0.8	{"column":"emb","expression":"sqrt(sum((emb[i] - query[i])^2))","inputs":{"dims":{"value":2},"exact":{"value":0.8},"k":{"value":2},"rescore_width":{"value":2}},"note":"found by an ivf search over sq8 codes","scorer":"l2_distance","value":0.8}

query
EXPLAIN SELECT id, ts_explain(explain_vec.tableoid)
FROM explain_vec
ORDER BY emb <-> [1, 0.2]::FLOAT[2]
LIMIT 2;
----
QUERY PLAN
╭─ PROJECTION ─────────────────────────────╮
│ Projections: #0, CAST(#1 AS JSON)        │
│ ~2 rows                                  │
╰─────────────────────┬────────────────────╯
╭─ IRESEARCH_SCAN ────┴────────────────────╮
│ Index: explain_vec                       │
│ Lookup: search                           │
│ Score:                                   │
│ l2_distance(emb, FLOAT[2]), explained    │
│ Top: 2                                   │
│ Projections: id,                         │
│              sdb_inverted_index_explain  │
│ ~5 rows                                  │
╰──────────────────────────────────────────╯

