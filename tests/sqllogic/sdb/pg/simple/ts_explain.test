query
SELECT id,
       (ts_explain(explain_idx.tableoid)->>'value')::FLOAT = lm_dirichlet(explain_idx.tableoid, 10) AS same,
       ts_explain(explain_idx.tableoid)->>'description' AS description
FROM explain_idx
WHERE body @@ 'fox'
ORDER BY id;
----
id	same	description
