query
SELECT id, ts_explain(xf_idx.tableoid) AS why
FROM xf_idx
WHERE body @@ 'fox'
    OR (g @@ ts_ngram('hello', 0.5))::score(NULL)
    OR (body @@ ts_starts_with('do'))::score(NULL)
    OR (body @@ ts_levenshtein('fix', 1))::score(NULL)
ORDER BY BM25(xf_idx.tableoid) DESC, id;
