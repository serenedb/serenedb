statement ok
CREATE TEXT SEARCH DICTIONARY xf_text AS split_text(case := 'lower') WITH (frequency, position, norm);

statement ok
CREATE TEXT SEARCH DICTIONARY xf_syn AS
    split_text(case := 'lower') | expand_solr_synonyms('car, automobile, auto')
    WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY xf_geo AS encode_geojson();

statement ok
CREATE TEXT SEARCH DICTIONARY xf_wild AS generate_wildcard_ngrams(keyword(), 3);

statement ok
CREATE TEXT SEARCH DICTIONARY xf_gram AS generate_ngrams(2, 2) WITH (frequency, position);

statement ok
CREATE TABLE xf (id INTEGER PRIMARY KEY, body VARCHAR, car VARCHAR, geo JSON, w VARCHAR, net CIDR, g VARCHAR, opt VARCHAR);

statement ok
CREATE INDEX xf_idx ON xf USING inverted (id, body xf_text, car xf_syn, geo xf_geo, w xf_wild, net, g xf_gram, opt);

statement ok
INSERT INTO xf VALUES
    (1, 'red fox', 'a red car here', '{"type":"Point","coordinates":[37.6,55.71]}', 'percent_alpha_one', '10.0.0.0/8', 'hello', 'x'),
    (2, 'red dog', 'the red automobile', '{"type":"Point","coordinates":[10,10]}', 'beta_two', '192.168.0.0/16', 'help', NULL),
    (3, 'blue fox', 'blue paint', '{"type":"Point","coordinates":[37.61,55.72]}', 'alpha', '10.1.0.0/16', 'world', 'y');

query
SELECT scorer, why
FROM (
    (SELECT 'bm25' AS scorer, BM25(xf_idx.tableoid) AS score, ts_explain(xf_idx.tableoid) AS why FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'tfidf', TFIDF(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'raw_tf', raw_tf(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'raw_dl', raw_dl(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'lm_jm', lm_jm(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'lm_dirichlet', lm_dirichlet(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'indri_dirichlet', indri_dirichlet(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'dfi', dfi(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'idf', idf(xf_idx.tableoid), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
    UNION ALL
    (SELECT 'constant', constant(xf_idx.tableoid, 2), ts_explain(xf_idx.tableoid) FROM xf_idx WHERE body @@ ts_between(NULL, NULL, true, true) ORDER BY id LIMIT 1)
)
ORDER BY scorer;
----
scorer	why
bm25	{"note":"the match has no term frequency, so the clause scores 0","scorer":"bm25(k1=1.2, b=0.75)","value":0}
constant	{"expression":"boost * value","inputs":{"value":{"value":2}},"scorer":"constant(value=2)","value":2}
dfi	{"note":"the match has no term frequency, so the clause scores 0","scorer":"dfi(measure=standardized)","value":0}
idf	{"expression":"boost * idf","inputs":{"idf":{"expression":"log(1 + (N - df + 0.5) / (df + 0.5))","value":0.6931472}},"scorer":"idf()","value":0.6931472}
indri_dirichlet	{"note":"the match has no term frequency, so the clause scores 0","scorer":"indri_dirichlet(mu=2000)","value":0}
lm_dirichlet	{"note":"the match has no term frequency, so the clause scores 0","scorer":"lm_dirichlet(mu=2000)","value":0}
lm_jm	{"note":"the match has no term frequency, so the clause scores 0","scorer":"lm_jm(lambda=0.1)","value":0}
raw_dl	{"note":"the match has no term frequency, so the clause scores 0","scorer":"raw_dl()","value":0}
raw_tf	{"note":"the match has no term frequency, so the clause scores 0","scorer":"raw_tf()","value":0}
tfidf	{"note":"the match has no term frequency, so the clause scores 0","scorer":"tfidf(with_norms=false)","value":0}

query
SELECT id, ts_explain(xf_idx.tableoid) AS why
FROM xf_idx
WHERE ST_Intersects(geo, '{"type":"Polygon","coordinates":[[[37.5,55.6],[37.7,55.6],[37.7,55.8],[37.5,55.8],[37.5,55.6]]]}')
ORDER BY constant(xf_idx.tableoid, 2) DESC, id;
----
id	why
1	{"column":"geo","expression":"boost * value","inputs":{"value":{"value":2}},"scorer":"constant(value=2)","value":2}
3	{"column":"geo","expression":"boost * value","inputs":{"value":{"value":2}},"scorer":"constant(value=2)","value":2}

query
SELECT id, ts_explain(xf_idx.tableoid) AS why
FROM xf_idx
WHERE ST_Distance_Between(geo, '{"type":"Point","coordinates":[37.6,55.71]}', 0, 5000)
