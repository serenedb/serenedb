3	{"column":"geo","expression":"boost * value","inputs":{"value":{"value":2}},"scorer":"constant(value=2)","value":2}

query
SELECT id, ts_explain(xf_idx.tableoid) AS why
FROM xf_idx
WHERE (w @@ ts_like('%alpha%') ^ 2)::score('constant(3)')
ORDER BY BM25(xf_idx.tableoid) DESC, id;
