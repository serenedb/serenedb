query
SELECT id, round(dfi(xf_idx.tableoid), 4) AS score, regexp_replace(ts_explain(xf_idx.tableoid)::JSON::VARCHAR, '(\.[0-9]{4})[0-9]+', '\1', 'g') AS why
FROM xf_idx
WHERE g @@ ts_ngram('hezz', 0.3)
ORDER BY score DESC, id;
----
id	score	why
1	1.3219	{"column":"g","expression":"boost * log2(1 + (freq - expected) / sqrt(expected))","inputs":{"expected":{"expression":"p * dl","inputs":{"dl":{"note":"the column records no lengths, so every row counts as 1","value":1}},"value":0.25},"freq":{"value":1},"p":{"expression":"(ttf + 1) / (L + 1)","inputs":{"L":{"value":11},"ttf":{"value":2}},"value":0.25}},"scorer":"dfi(measure=standardized)","term":"he","value":1.3219}
2	1.3219	{"column":"g","expression":"boost * log2(1 + (freq - expected) / sqrt(expected))","inputs":{"expected":{"expression":"p * dl","inputs":{"dl":{"note":"the column records no lengths, so every row counts as 1","value":1}},"value":0.25},"freq":{"value":1},"p":{"expression":"(ttf + 1) / (L + 1)","inputs":{"L":{"value":11},"ttf":{"value":2}},"value":0.25}},"scorer":"dfi(measure=standardized)","term":"he","value":1.3219}

