statement ok
CREATE TEXT SEARCH DICTIONARY xf_freq AS split_text(case := 'lower') WITH (frequency);

statement ok
CREATE TABLE xf_same (id INTEGER PRIMARY KEY, f VARCHAR);

statement ok
CREATE INDEX xf_same_idx ON xf_same USING inverted (id, f xf_freq);

statement ok
INSERT INTO xf_same VALUES (1, 'alpha alps'), (2, 'alpine'), (3, 'beta');

query
SELECT id, ts_explain(xf_same_idx.tableoid) AS why
FROM xf_same_idx
WHERE f @@ ts_starts_with('al')
ORDER BY BM25(xf_same_idx.tableoid) DESC, id;
