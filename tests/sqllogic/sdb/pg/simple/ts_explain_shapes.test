statement ok
CREATE TEXT SEARCH DICTIONARY tx_full AS split_text(case := 'lower') WITH (frequency, position, norm);

statement ok
CREATE TEXT SEARCH DICTIONARY tx_freq AS split_text(case := 'lower') WITH (frequency);

statement ok
CREATE TEXT SEARCH DICTIONARY tx_none AS split_text(case := 'lower');

statement ok
CREATE TEXT SEARCH DICTIONARY tx_nonorm AS split_text(case := 'lower') WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY tx_bigram AS generate_ngrams(2, 2) WITH (frequency, position);

statement ok
CREATE TABLE tx (id INTEGER PRIMARY KEY, body VARCHAR, tag VARCHAR, n INTEGER, a VARCHAR, b VARCHAR, c VARCHAR, g VARCHAR, emb FLOAT[2]);

statement ok
CREATE INDEX tx_idx ON tx USING inverted (id, body tx_full, tag, n, a tx_freq, b tx_none, c tx_nonorm, g tx_bigram);

statement ok
INSERT INTO tx VALUES
    (1, 'the quick brown fox jumps over the lazy dog', 'animal', 1, 'red fox fox', 'red fox fox', 'red fox fox', 'hello', [1, 0]),
    (2, 'fox fox fox in the henhouse', 'animal', 2, 'fox', 'fox', 'fox', 'help', [0, 1]),
    (3, 'a clever fox outwits two hounds in the meadow', 'story', 3, 'clever dog', 'clever dog', 'clever dog', 'world', [1, 1]),
    (4, 'quick brown dog runs fast', 'animal', 4, 'quick dog', 'quick dog', 'quick dog', 'held', [2, 0]),
    (5, 'the lazy dog sleeps all day', 'story', 5, 'lazy dog', 'lazy dog', 'lazy dog', 'hell', [0, 2]),
    (6, 'brown bread and brown sugar', 'food', 6, 'bread', 'bread', 'bread', 'bell', [3, 1]);

statement ok
INSERT INTO tx VALUES
    (7, 'common quick fox and common dog', 'animal', 7, 'common fox', 'common fox', 'common fox', 'yellow', [1, 3]),
    (8, 'common words common ground', 'story', 8, 'common', 'common', 'common', 'mellow', [2, 2]),
    (9, 'common fax machine', 'office', 9, 'common fax', 'common fax', 'common fax', 'fellow', NULL);

statement ok
CREATE INDEX tx_vl2 ON tx USING inverted (id, emb ivf (metric = 'l2'));

statement ok
CREATE INDEX tx_vnone ON tx USING inverted (id, emb ivf (metric = 'l2', quant = 'none'));

statement ok
CREATE INDEX tx_vcos ON tx USING inverted (id, emb hnsw (metric = 'cosine'));

statement ok
CREATE INDEX tx_vip ON tx USING inverted (id, emb hnsw (metric = 'ip'));

statement ok
CREATE INDEX tx_vl1 ON tx USING inverted (id, emb ivf (metric = 'l1'));

statement ok
CREATE INDEX tx_hy ON tx USING inverted (id, body tx_full, emb ivf (metric = 'l2'));

query
SELECT id, BM25(tx_idx.tableoid) AS score, ts_explain(tx_idx.tableoid) AS why
FROM tx_idx
WHERE body @@ 'fox' AND body @@ 'quick'
ORDER BY score DESC, id
LIMIT 2;
----
id	score	why
7	0.83371466	{"clauses":[{"column":"body","formula":"boost * idf * tf","inputs":{"idf":{"formula":"log(1 + (N - df + 0.5) / (df + 0.5))","inputs":{"N":{"value":9},"df":{"value":3}},"value":1.0498221},"tf":{"formula":"freq / (freq + k1 * (1 - b + b * dl / avgdl))","inputs":{"avgdl":{"formula":"L / N","inputs":{"L":{"value":53},"N":{"value":9}},"value":5.888889},"b":{"value":0.75},"dl":{"value":6},"freq":{"value":1},"k1":{"value":1.2}},"value":0.4510638}},"scorer":"bm25(k1=1.2, b=0.75)","term":"quick","value":0.47353673},{"column":"body","formula":"boost * idf * tf","inputs":{"idf":{"formula":"log(1 + (N - df + 0.5) / (df + 0.5))","inputs":{"N":{"value":9},"df":{"value":4}},"value":0.7985077},"tf":{"formula":"freq / (freq + k1 * (1 - b + b * dl / avgdl))","inputs":{"avgdl":{"formula":"L / N","inputs":{"L":{"value":53},"N":{"value":9}},"value":5.888889},"b":{"value":0.75},"dl":{"value":6},"freq":{"value":1},"k1":{"value":1.2}},"value":0.4510638}},"scorer":"bm25(k1=1.2, b=0.75)","term":"fox","value":0.36017793}],"formula":"sum","value":0.83371466}
1	0.69084257	{"clauses":[{"column":"body","formula":"boost * idf * tf","inputs":{"idf":{"formula":"log(1 + (N - df + 0.5) / (df + 0.5))","inputs":{"N":{"value":9},"df":{"value":3}},"value":1.0498221},"tf":{"formula":"freq / (freq + k1 * (1 - b + b * dl / avgdl))","inputs":{"avgdl":{"formula":"L / N","inputs":{"L":{"value":53},"N":{"value":9}},"value":5.888889},"b":{"value":0.75},"dl":{"value":9},"freq":{"value":1},"k1":{"value":1.2}},"value":0.37376586}},"scorer":"bm25(k1=1.2, b=0.75)","term":"quick","value":0.3923877},{"column":"body","formula":"boost * idf * tf","inputs":{"idf":{"formula":"log(1 + (N - df + 0.5) / (df + 0.5))","inputs":{"N":{"value":9},"df":{"value":4}},"value":0.7985077},"tf":{"formula":"freq / (freq + k1 * (1 - b + b * dl / avgdl))","inputs":{"avgdl":{"formula":"L / N","inputs":{"L":{"value":53},"N":{"value":9}},"value":5.888889},"b":{"value":0.75},"dl":{"value":9},"freq":{"value":1},"k1":{"value":1.2}},"value":0.37376586}},"scorer":"bm25(k1=1.2, b=0.75)","term":"fox","value":0.29845488}],"formula":"sum","value":0.69084257}

