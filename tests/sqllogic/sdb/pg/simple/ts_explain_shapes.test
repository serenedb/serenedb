query
SELECT id, BM25(tx_hy.tableoid) AS score, emb <-> [1, 0.2]::FLOAT[2] AS distance, ts_explain(tx_hy.tableoid) AS why
FROM tx_hy
WHERE body @@ 'fox'
ORDER BY distance, id
LIMIT 2;
