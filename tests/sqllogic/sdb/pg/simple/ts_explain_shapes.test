query
SELECT scorer, count(*) AS matched, count(why::VARCHAR) AS texts
FROM (
    (SELECT 'bm25' AS scorer, BM25(tx_idx.tableoid) AS score, ts_explain(tx_idx.tableoid) AS why FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'tfidf', TFIDF(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'idf', idf(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'lm_jm', lm_jm(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'lm_dirichlet', lm_dirichlet(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'indri_dirichlet', indri_dirichlet(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'dfi', dfi(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'raw_tf', raw_tf(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'raw_dl', raw_dl(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'raw_boost', raw_boost(tx_idx.tableoid), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'constant', constant(tx_idx.tableoid, 2.5), ts_explain(tx_idx.tableoid) FROM tx_idx WHERE body @@ 'fox')
    UNION ALL
    (SELECT 'l2_distance', emb <-> [1, 0.2]::FLOAT[2], ts_explain(tx_vl2.tableoid) FROM tx_vl2 ORDER BY emb <-> [1, 0.2]::FLOAT[2] LIMIT 3)
)
GROUP BY scorer
ORDER BY scorer;
----
scorer	matched	texts
bm25	4	4
constant	4	4
dfi	4	4
idf	4	4
indri_dirichlet	4	4
l2_distance	3	3
lm_dirichlet	4	4
lm_jm	4	4
raw_boost	4	4
raw_dl	4	4
raw_tf	4	4
tfidf	4	4
