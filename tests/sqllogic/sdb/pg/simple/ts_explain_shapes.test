query
SELECT id, branch, why.scorer::VARCHAR AS scorer, why.value::FLOAT AS value
FROM (
    (SELECT id, 'text' AS branch, ts_explain(tx_hy.tableoid) AS why
     FROM tx_hy
     WHERE body @@ 'fox'
     ORDER BY BM25(tx_hy.tableoid) DESC
     LIMIT 2)
    UNION ALL
    (SELECT id, 'vector' AS branch, ts_explain(tx_hy.tableoid) AS why
     FROM tx_hy
     ORDER BY emb <-> [1, 0.2]::FLOAT[2]
     LIMIT 2)
)
ORDER BY branch, id;
----
id	branch	scorer	value
2	text	bm25(k1=1.2, b=0.75)	0.5680659
7	text	bm25(k1=1.2, b=0.75)	0.36017793
1	vector	l2_distance	0.2
3	vector	l2_distance	0.8

