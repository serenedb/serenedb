query
SELECT *
FROM (
    SELECT id, emb <=> [1, 0.2]::FLOAT[2] AS score, ts_explain(tx_vcos.tableoid) AS why
    FROM tx_vcos
    ORDER BY emb <=> [1, 0.2]::FLOAT[2]
    LIMIT 3
)
ORDER BY score, id;
