statement ok
CREATE TEXT SEARCH DICTIONARY tsow_wild AS generate_wildcard_ngrams(split_text_csv(' '), 3) WITH (frequency, position)

statement ok
CREATE TABLE tsow_docs (id INT PRIMARY KEY, body TEXT)

statement ok
CREATE INDEX tsow_docs_idx ON tsow_docs USING inverted (id, body tsow_wild)

statement ok
INSERT INTO tsow_docs VALUES (1, 'quick brown fox'), (2, 'slow quail')

query
SELECT id, ts_offsets(body) = ts_offsets('tsow_wild', body, ts_like('qu%')) AS same
FROM tsow_docs_idx WHERE body @@ ts_like('qu%') ORDER BY id
----
id	same
1	t
2	t

query
SELECT id, ts_offsets(body) = ts_offsets('tsow_wild', body, ts_like('q%k')) AS same
FROM tsow_docs_idx WHERE body @@ ts_like('q%k') ORDER BY id
----
id	same
1	t

query
SELECT id, ts_offsets(body) = ts_offsets('tsow_wild', body, ts_regexp('qu.*')) AS same
FROM tsow_docs_idx WHERE body @@ ts_regexp('qu.*') ORDER BY id
----
id	same
1	t
2	t

query
SELECT id, ts_offsets(body) = ts_offsets('tsow_wild', body, ts_regexp('q.*k')) AS same
FROM tsow_docs_idx WHERE body @@ ts_regexp('q.*k') ORDER BY id
----
id	same
1	t
