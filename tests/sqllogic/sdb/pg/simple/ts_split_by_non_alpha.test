control substitution on


# split_by_non_alpha(text, case := 'lower') -- splits on runs of non-alphanumeric
# characters, equivalent to a `[^A-Za-z0-9]+` split.


# --- Basic split (default: keep case) ---

query
SELECT split_by_non_alpha('Hello, World! 123_abc');
----
split_by_non_alpha
{Hello,World,123,abc}


# --- Lowercasing each token: case := 'lower' ---

query
SELECT split_by_non_alpha('Hello, World! 123_abc', case := 'lower');
----
split_by_non_alpha
{hello,world,123,abc}


# --- The default case keeps each token as written ---

query
SELECT split_by_non_alpha('MixedCase WORDS');
----
split_by_non_alpha
{MixedCase,WORDS}


# --- Alphanumeric runs are kept intact (digits are not separators) ---

query
SELECT split_by_non_alpha('a1b2c3');
----
split_by_non_alpha
{a1b2c3}


# --- Leading, trailing and repeated separators emit no empty tokens ---

query
SELECT split_by_non_alpha('  ...foo--bar..  ');
----
split_by_non_alpha
{foo,bar}


# --- Underscores split (only [A-Za-z0-9] is kept) ---

query
SELECT split_by_non_alpha('snake_case_Name', case := 'lower');
----
split_by_non_alpha
{snake,case,name}


# --- Non-ASCII bytes act as separators (matches [^A-Za-z0-9]+) ---

query
SELECT split_by_non_alpha('café déjà');
----
split_by_non_alpha
{caf,d,j}


# --- All-separator input yields an empty array ---

query
SELECT split_by_non_alpha('---!!!   ');
----
split_by_non_alpha
{}


# --- Empty input yields an empty array ---

query
SELECT split_by_non_alpha('');
----
split_by_non_alpha
{}


# --- NULL input yields NULL ---

query
SELECT split_by_non_alpha(NULL);
----
split_by_non_alpha
NULL


# --- Per-row over a table, including a NULL row ---

statement ok
CREATE TABLE docs(id INT, body TEXT);


statement ok
INSERT INTO docs VALUES (1, 'The Quick-Brown FOX'), (2, '42 widgets!'), (3, NULL);


query
SELECT split_by_non_alpha(body, case := 'lower') FROM docs ORDER BY id;
----
split_by_non_alpha
{the,quick,brown,fox}
{42,widgets}
NULL


query
SELECT split_by_non_alpha(body, case := 'lower', break := 'letters') FROM docs ORDER BY id;
----
split_by_non_alpha
{the,quick,brown,fox}
{widgets}
NULL


query
SELECT split_by_non_alpha('Hello World', break := 'ALNUM');
----
split_by_non_alpha
{Hello,World}


query
SELECT split_by_non_alpha('snake_case kebab-case  x=1;y', break := 'whitespace');
----
split_by_non_alpha
{snake_case,kebab-case,x=1;y}


query
SELECT split_by_non_alpha('Grüße Welt' || chr(160) || '北京123' || chr(12288) || 'ÜBER—bar', case := 'lower', break := 'whitespace');
----
split_by_non_alpha
{grüße,welt,北京123,über—bar}


query
SELECT split_by_non_alpha('a' || chr(8203) || 'b' || chr(8195) || chr(13) || chr(10) || 'c', break := 'whitespace') =
       ['a' || chr(8203) || 'b', 'c'] AS same;
----
same
t


statement error
CREATE TEXT SEARCH DICTIONARY non_alpha_bad_break AS
    split_by_non_alpha(break := 'word')
----
db error: ERROR: invalid value in "break" parameter
HINT: Token boundary mode: ascii, ascii_bytes, alnum, letters, whitespace


statement error
CREATE TEXT SEARCH DICTIONARY non_alpha_old_option AS
    split_by_non_alpha(keep_non_ascii := true)
----
db error: ERROR: split_by_non_alpha(): unknown option "keep_non_ascii"
HINT: known names: case, break
