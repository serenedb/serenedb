statement ok
CREATE TABLE cm_cp AS
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(0, 55296) t(c)
    UNION ALL
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(57344, 1114112) t(c);


query
SELECT count(*) FILTER (WHERE t <> s) AS changed, md5(string_agg(t, ',' ORDER BY c)) AS digest FROM (SELECT c, s, normalize_tokens(s, locale := '', case := 'lower')[1] AS t FROM cm_cp);
----
changed	digest
2599	e15bf7d264e5e4df9268b7a77e8d8606


