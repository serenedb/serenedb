query
SELECT string_agg(w, ' ' ORDER BY collate_tokens(w, 'en'), w) AS ordered FROM co_words WHERE locale = 'en';
----
ordered
_ - % 1 10 2 a A á Á à â ä æ b B co-op Co-op coop cote coté côte côté ñ ø resume résumé Résumé ss ß zebra Zebra


query
