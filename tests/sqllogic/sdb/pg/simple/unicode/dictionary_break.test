statement ok
CREATE TABLE db_lines AS SELECT * FROM (VALUES
    (1, 'th', 'การค้นพบสิ่งต่าง ๆ ในเรื่องของดาราศาสตร์ที่เผยแพร่โดยนักดาราศาสตร์สมัครเล่นนั้นมีความสำคัญมาก และดาราศาสตร์ก็เป็นหนึ่งในวิทยาศาสตร์จำนวนน้อยสาขาที่นักดาราศาสตร์สมัครเล่นยังคงมีบทบาท โดยเฉพาะการค้นพบหรือการสังเกตการณ์ปรากฏการณ์ที่เกิดขึ้นเพียงชั่วคราว'),
    (2, 'th', 'การค้นพบสำคัญทางดาราศาสตร์ประสบความสำเร็จมากขึ้นเมื่อมีเทคโนโลยีใหม่ ๆ เช่น การถ่ายภาพ และสเปกโตรสโคป เราทราบว่าดวงดาวต่าง ๆ ที่แท้เป็นดาวฤกษ์ที่มีลักษณะคล้ายคลึงกับดวงอาทิตย์ของเรานั่นเอง แต่มีอุณหภูมิ มวล และขนาดที่แตกต่างกันไป'),
    (3, 'th', 'ในทางดาราศาสตร์ สารสนเทศส่วนใหญ่ได้จากการตรวจหาและวิเคราะห์โฟตอนซึ่งเป็นการแผ่รังสีแม่เหล็กไฟฟ้า แต่อาจได้จากข้อมูลที่มากับรังสีคอสมิก นิวตริโน ดาวตก และในอนาคตอันใกล้อาจได้จากคลื่นความโน้มถ่วง'),
    (4, 'th', 'วัตถุดาราศาสตร์ที่สามารถสังเกตได้ในช่วงคลื่นวิทยุมีมากมาย รวมไปถึงซูเปอร์โนวา แก๊สระหว่างดาว พัลซาร์ และนิวเคลียสดาราจักรกัมมันต์'),
    (5, 'th', 'การสังเกตการณ์อื่นนอกเหนือจากสเปกตรัมแม่เหล็กไฟฟ้า'),
    (6, 'th', 'นอกเหนือจากการสังเกตการณ์ดาราศาสตร์โดยการแผ่รังสีคลื่นแม่เหล็กไฟฟ้าแล้ว ยังมีการสังเกตการณ์อื่น ๆ ที่ทำได้บนโลกเพื่อศึกษาวัตถุในระยะไกลมาก ๆ'),
    (7, 'th', 'การเฝ้าสังเกตการณ์อีกแบบหนึ่งคือการสังเกตการณ์คลื่นความโน้มถ่วง ตัวอย่างหอสังเกตการณ์ลักษณะนี้ เช่น Laser Interferometer Gravitational Observatory (LIGO) แต่การตรวจหาคลื่นความโน้มถ่วงยังเป็นไปได้ยากอยู่'),
    (8, 'th', 'ตัวอย่างหัวข้อการศึกษาดาราศาสตร์เชิงทฤษฎี มีดังนี้'),
    (9, 'th', 'พื้นผิวรอบนอกของดวงอาทิตย์ที่เรามองเห็นเรียกว่า โฟโตสเฟียร์ เหนือพื้นผิวนี้เป็นชั้นบาง ๆ เรียกชื่อว่า โครโมสเฟียร์ จากนั้นเป็นชั้นเปลี่ยนผ่านซึ่งมีอุณหภูมิเพิ่มสูงขึ้นอย่างมาก ชั้นนอกสุดมีอุณหภูมิสูงที่สุด เรียกว่า โคโรนา'),
    (10, 'th', 'ลมสุริยะเกิดจากอนุภาคของพลาสมาที่ไหลออกจากดวงอาทิตย์ ซึ่งจะแผ่ออกไปจนกระทั่งถึงแนว heliopause เมื่อลมสุริยะทำปฏิกิริยากับสนามแม่เหล็กของโลก ทำให้เกิดแนวการแผ่รังสีแวนอัลเลนและออโรร่า ในตำแหน่งที่เส้นแรงสนามแม่เหล็กโลกไหลเวียนในชั้นบรรยากาศ'),
    (11, 'th', 'ดาราจักรส่วนใหญ่จะถูกจัดกลุ่มตามรูปร่างลักษณะที่ปรากฏ เข้าตามหลักเกณฑ์ของการจัดประเภทดาราจักร ซึ่งมีกลุ่มใหญ่ ๆ ได้แก่ ดาราจักรชนิดก้นหอย ดาราจักรชนิดรี และดาราจักรไร้รูปแบบ'),
    (12, 'th', 'ดาราจักรไร้รูปแบบมักมีรูปร่างปรากฏไม่แน่ไม่นอน ไม่ใช่ทั้งดาราจักรชนิดรีหรือชนิดก้นหอย ประมาณหนึ่งในสี่ของจำนวนดาราจักรทั้งหมดที่พบเป็นดาราจักรชนิดไร้รูปแบบนี้ รูปร่างอันแปลกประหลาดของดาราจักรมักทำให้เกิดปฏิกิริยาแรงโน้มถ่วงแปลก ๆ ขึ้นด้วย'),
    (13, 'th', 'จักรวาลวิทยา (; มาจากคำในภาษากรีกว่า κοσμος "cosmos" หมายถึง เอกภพ และ λογος หมายถึง การศึกษา) เป็นการศึกษาเกี่ยวกับเอกภพทั้งหมดในภาพรวม'),
    (14, 'th', 'เมื่อมีอะตอมแรกเกิดขึ้น จึงมีการแผ่รังสีผ่านอวกาศ ปลดปล่อยพลังงานออกมาดั่งที่ทุกวันนี้เรามองเห็นเป็นรังสีไมโครเวฟพื้นหลังของจักรวาล เอกภพขยายตัวผ่านช่วงเวลาของยุคมืดเพราะไม่ค่อยมีแหล่งกำเนิดพลังงานของดาวฤกษ์'),
    (15, 'th', 'ศาสตร์ที่เกี่ยวข้องกับสาขาอื่น'),
    (16, 'th', 'การศึกษาดาราศาสตร์และฟิสิกส์ดาราศาสตร์ที่ก้าวหน้ามากขึ้น ทำให้มีความเกี่ยวข้องกับวิทยาศาสตร์สาขาอื่นมากยิ่งขึ้น ดังนี้'),
    (17, 'th', 'โบราณดาราศาสตร์ (Archaeoastronomy) เป็นการศึกษาเกี่ยวกับวิทยาการดาราศาสตร์ในยุคโบราณหรือยุคดั้งเดิม โดยพิจารณาถึงสภาพสังคมและวัฒนธรรม อาศัยหลักฐานในทางโบราณคดีและมานุษยวิทยาเข้ามาช่วย'),
    (18, 'th', 'ชีววิทยาดาราศาสตร์ (Astrobiology) เป็นการศึกษาการมาถึงและวิวัฒนาการของระบบชีววิทยาในเอกภพ ที่สำคัญคือการศึกษาและตรวจหาความเป็นไปได้ของสิ่งมีชีวิตในโลกอื่น'),
    (19, 'th', 'ดาราศาสตร์ เป็นสาขาวิชาหนึ่งทางวิทยาศาสตร์ที่บุคคลทั่วไปสามารถมีส่วนร่วมได้อย่างมากที่สุด'),
    (20, 'th', 'เว็บไซต์อย่างเป็นทางการ "ปีดาราศาสตร์สากล 2009"'),
    (21, 'th', 'โครงการเครือข่ายสารสนเทศดาราศาสตร์สำหรับโรงเรียน'),
    (22, 'th', 'ศูนย์วิทยาศาสตร์เพื่อการศึกษา (ท้องฟ้าจำลองกรุงเทพ)'),
    (23, 'th', 'โครงการลีซ่า โครงการเรียนรู้เรื่องวิทยาศาสตร์โลกและอวกาศ โดยหอดูดาวเกิดแก้ว สนับสนุนโดยสำนักงานกองทุนสนับสนุนการวิจัย'),
    (24, 'th', 'เว็บไซต์ทางการ กล้องโทรทรรศน์อวกาศฮับเบิล'),
    (25, 'th', 'โดยทั่วไปภูมิศาสตร์มักถูกแบ่งออกเป็นสองสาขาหลักคือภูมิศาสตร์มนุษย์และภูมิศาสตร์กายภาพ ภูมิศาสตร์มนุษย์เกี่ยวข้องกับการศึกษาถึงผู้คน ชุมชน วัฒนธรรม เศรษฐกิจ และปฏิสัมพันธ์กับสิ่งแวดล้อม'),
    (26, 'lo', 'ອົງການໄປສະນີແລະໂທລະຄົມມະນາຄົມແຫ່ງຊາດ'),
    (27, 'lo', 'ຂ່າວດີຂ່າວໃໝ່ທີ່ບໍ່ເຄີຍມີມາກອ່ນ ພາກວິຊາພູມີສາດ'),
    (28, 'lo', 'ບົດທີ່ ໑ ສະຖານະພາບທົ່ວໄປຂອງໂປຣແກຣມ ERDAS IMAGINE'),
    (29, 'lo', 'ບົດທີ່ ໒ ການທຳງານເທິງວິວເວີ Viewer'),
    (30, 'lo', 'ບົດທີ່ ໓ ການນຳເຂົ້າແລະສົ່ງອອກຂໍ້ມູນ'),
    (31, 'lo', 'ບົດທີ ໔ ການກະກຽມຂໍ້ມູນກອ່ນການປະມວນຜົນ'),
    (32, 'lo', 'ຄຳວ່າ "ລາວ" ທີ່ໝາຍເຖິງປະເທດລາວນັ້ນ, ມີຫຼາຍມູນເຫດດັ່ງນີ້:'),
    (33, 'lo', 'ຄຳວ່າລາວ ກຳເນີດເກີດຂຶ້ນມາພ້ອມໆກັບການກຳເກີດມີສັງຄົມລາວ ຫຼື ກຳເນີດເກີດຂຶ້ນພ້ອມໆກັບການກຳເນີດຄົນລາວ.'),
    (34, 'lo', 'ຄຳວ່າລາວ ອາດມາຈາກພາສາປາລີ ລາວ ເຊິ່ງໝາຍເຖິງໝາກນ້ຳເຕົ້າ'),
    (35, 'lo', 'ຄຳວ່າລາວ ອາດມາຈາກການເອີ້ນຊົນເຜົ່າລາວ ເຊິ່ງເປັນຊົນເຜົ່າດັ່ງເດີມ ດຳລົງຊີວິດຢູ່ກ່ອນມີປະເທດລາວ'),
    (36, 'lo', 'ຄົນລາວ ກຳເນີດຈາກຊົນເຜົ່າໝຶ່ງຢູ່ແຂວງຢູນນ່ານ ເຊິ່ງມີນາມເດີມວ່າ ເກົ້າຫຼວງ (ມາຈາກຄຳວ່າ ເກົ້າຫຼົງ ເປັນມັງກອນ ຫຼື ນາກ ເກົ້າອົງ ຫຼື ຊາຍທັງເກົ້າ). ຕໍ່ມາໄດ້ຍ້າຍມາເລື້ອຍລົງມາທາງພາກໃຕ້ເລື້ອຍໆ ແລະ ຖືກເອີ້ນສັ່ນໆວ່າ ຫຼວງ ແລະ ສຸດທ້າຍກໍກາຍມາເປັນ ລາວ'),
    (37, 'lo', 'ແຕ່ກ່ອນ ຄົນທ້ອງຖິ່ນຈະຢູ່ຕາມລຳນ້ຳ, ສ່ວນຄົນລາວຍ້າຍແຕ່ພາກເໜືອມາຢູ່ ຈະອາໄສຢູ່ຕາມບ່ອນສູງກ່ວາ, ຄົນທ້ອງຖິ່ນເອີ້ນຄົນລາວທີ່ມາຢູ່ນີ້ ແມ່ນຄົນດາວ, ເພາະເວລາເບິ່ງຈາກລຸ່ມຂຶ້ນເທິງ ຈະຕິດພັນກັບດວງດາວຢູ່ທ້ອງຟ້າ'),
    (38, 'lo', 'ຄົນຈີນບາງພວກບາງຫມູ່ໃນເຂດຢູນນານຂອງຈີນມັກອອກສຽງຕົວ "ດ"​ເປັນຕົວ"ລ"​ແລະອອກສຽງຕົວ "ລ"​ເປັນຕົວ "ດ"​ດ້ວຍເຫດນີ້ຈຶ່ງເອີ້ນພວກທີ່ຢູ່ທີ່ສູງອັນມີທ້ອງຟ້າດາວວະດິງສາພ້ຽນຈາກດາວກາຍເປັນລາວອັນພາໃຫ້ມີຄຳວ່າລາວ'),
    (39, 'lo', 'ໃນພາສາອັງກິດ ຄຳວ່າລາວ ທີ່ໝາຍເຖິງປະເທດລາວ ສະກົດວ່າ "Laos" ແລະ ລາວທີ່ໝາຍເຖິງຄົນລາວ ໃຊ້ "Lao" ແລະ ບາງເທື່ອຈະມີການໃຊ້ຄຳວ່າ "Laotian" ເນື່ອງຈາກບໍ່ໃຫ້ສັບສົນກັບຄຳວ່າ "Lao ethnic group"'),
    (40, 'lo', 'ຢູ່ໃນປ່າກໍມີເຄື່ອງປ່າຂອງດົງປະເພດຕ່າງໆ ທີ່ໂລກຕ້ອງການຫຼາຍເຊັ່ນ: ຄັ່ງ, ຍານ, ໝາກແໜ່ງ, ຢາງແປກ, ຫວາຍ, ຕົ້ນໄມ້ເປັນຢາ ແລະ ອື່ນໆ ນອກນັ້ນ ຍັງມີສັດປ່າທີ່ຫາຍາກ ແລະ ໃກ້ຈະສູນພັນເຊັ່ນ: ຊ້າງ, ເສືອ, ໝີ, ເມີຍ, ກະທິງ, ກວາງ, ເຍືອງ, ເສົາຫຼາ ໆລໆ.'),
    (41, 'lo', 'ປ່າໄມ້ທີ່ອຸດົມສົມບູນຂອງປະເທດລາວແບ່ງອອກເປັນ 5 ປະເພດດັ່ງນີ້:'),
    (42, 'lo', 'ປະເທດລາວມີທໍ່ສົ່ງນໍ້າມັນເປຕະໂລນ ຍາວທັງໝົດ 136 ກິໂລແມັດ.'),
    (43, 'lo', 'ເບິ່ງບົດຄວາມທີ່ວ່າ ປະຫວັດສາດລາວ ແລະ ອານາຈັກລາວລ້ານຊ້າງ'),
    (44, 'lo', 'ດ້າ​ນຮີດຄອງ​, ປະເພນີ, ວັດທະນະທຳ, ​ເປັ​ນໄລຍະ​ຮຸ່ງ​ເຮືອງ​ເຫຼືອງ​ເຫຼື້ອມດ້າ​ນວັດທະນະທຳ​ທີ່​ໂດດ​ເດັ່​ນທີ່​ສຸດ.'),
    (45, 'lo', 'ດ້ານ​ການ​ທະຫານ: ​ໄດ້​ປັບປຸງ​ກອງທັບ​ບັນດາ​ຫົວ​ເມືອງ​ໃຫ້​ເຂັ້ມ​ແຂງ.'),
    (46, 'lo', 'ລາຊະວົງຕະກູນຟູ(ຊົນເຜົ່າຈີນຫໍໍ້)ປະຫວັດສາດພາກເໜືອສຸຸດຂອງປະເທດລາວ.'),
    (47, 'lo', 'ເມື່ອປະມານຫນຶ່ງພັນກວ່າປີກໍ່ມີຄົນຈີນຫໍ້ມາຮອດພາກເໜືອຂອງປະເທດລາວແລະເຂດອ້ອມແອ້ມແຕ່ບໍ່ມີຜູ້ໃດປົກຄອງມາກ່ອນມີແຕ່ຕະກູນຟູ ໄດ້ສ້າງຕັ້ງການບໍລິຫານແລະຄຸ້ມຄອງຢູ່ພາກເໜືອຂອງປະເທດລາວແລະເຂດອ້ອມແອ້ມປະມານ200ກ່ວາປີ.'),
    (48, 'lo', 'ສະໄໝຕົກເປັນຫົວເມືອງຂຶ້ນ ປະກາດເອກະລາດ ແລະ ສົງຄາມກາງເມືອງ'),
    (49, 'lo', 'ໄລຍະ 60 ປີ ທີ່​ລາວ​ເປັນ​ເມືອງ​ຂຶ້ນຝຣັ່ງ'),
    (50, 'lo', 'ສະໄໝເປັນສາທາລະນະລັດ ປະຊາທິປະໄຕປະຊາຊົນລາວ'),
    (51, 'km', 'សមាធិ គឺការតាំងចិត្តមាំក្នុងអារម្មណ៍តែមួយ ឬការដឹងច្បាស់នូវអារម្មណ៍នោះៗដោយសច្ចភាព។ សមាធិមានពីរយ៉ាងគឺ សមថកម្មដ្ឋាន និងវិបស្សនាកម្មដ្ឋាន។'),
    (52, 'km', 'សមថកម្មដ្ឋាន គឺជាការគ្រៀកចិត្ត​ឬចងចិត្តឲ្យជាប់ក្នុងអារម្មណ៍តែមួយមិនបណ្តោយឲ្យចិត្តត្រាច់ចរទៅរកអារម្មណ៍ផ្សេងៗ។ សមថសមាធិមាន៣កំរិតតាមកម្លាំងនៃការប្រតិបត្តិ៖'),
    (53, 'km', 'ខណិកសមាធិ គឺសមាធិដែលចិត្តមានអារម្មណ៍តែមួយ ឬចិត្តស្ងប់កើតឡើងមួយជួរខណៈ តែមិនបានយូរប៉ុន្នានក៏រលត់ទៅ។'),
    (54, 'km', 'ឧបចារសមាធិ គឺសមាធិដែលចិត្តស្ងប់រំងាប់ប្រាសចាកនិវរណៈទាំង៥តែមិនជាអារម្មណ៍របស់អង្គឈានមានបឋមជ្ឈានជាដើមនោះទេ ប៉ុន្តែអារម្មណ៍របស់ឧបចារសមាធិនេះគឺជាអារម្មណ៍សមាធិដែលចិត្តស្ថិតក្នុងសភាពជិតបានឈានសមាបត្តិហ្នឹងឯង។'),
    (55, 'km', 'សាខានៃភាសាវិទ្យា​ដែល​ទាក់​ទង​នឹង​មុខវិទ្យា​ដទៃ'),
    (56, 'km', 'ភាសាវិទូនិង​បុគ្គល​គួរ​កត់​សម្គាល់​ក្នុង​ភាសាវិទ្យា'),
    (57, 'km', 'បណ្ឌិតសភាចារ្យ ច័ន្ទ សំណព្វ (ភាសាវិទូ)'),
    (58, 'km', 'ស្ថាប័ន​ជាតិ​និង​អន្តរជាតិ​ដែល​ទាក់ទង​នឹង​ភាសាវិទ្យា'),
    (59, 'km', 'វិទ្យាស្ថាន​ជាតិ​ភាសាខ្មែរ​ជា​ផ្នែក​មួយ​នៃ​រាជបណ្ឌិត្យសភា​កម្ពុជា។'),
    (60, 'km', 'គណៈកម្មាធិការ​ជាតិ​ភាសាខ្មែរ (លែងមាន)'),
    (61, 'km', 'ស្ថាប័ន​នេះ​ កើត​ចេញ​ពី​អនុក្រឹត្យ​លេខ ១៨ អនក្រ.បក ចុះថ្ងៃទី៥ មីនា ឆ្នាំ២០០៧ ហើយ​រលាយ​ទៅវិញ​ស្របពេលដែល​ក្រុមប្រឹក្សាជាតិភាសាខ្មែរកកើត។'),
    (62, 'km', 'ភ្ជាប់ទៅគេហទំព័រ របស់MayoClinic និយាយពីរោគសញ្ញានិងជម្ងឺជាច្រើនប្រភេទជាភាសាអង់គ្លេស'),
    (63, 'km', 'PubMed គេហទំព័រដែលមានប្រមូលផ្តុំនូវអត្ថបទបោះពុម្ពប្រភេទ Journals, ទស្សនាវដ្តី និង សៀវភៅផ្នែកពេទ្យជាច្រើនពាន់ក្បាល'),
    (64, 'km', 'Family Doctors វេជ្ជបណ្ឌិតប្រចាំគ្រួសារ'),
    (65, 'km', 'គេហទំព័រនៃទីក្រុងញូវយកដែលនិយាយអំពីបញ្ហាសុខភាព ជាភាសាអង់គ្លេស និង អេស្បាញ NOA Health'),
    (66, 'km', 'ហ័រម៉ូននិងការប្រើប្រាស់ក្នុងវិស័យវេជ្ជសាស្ត្រ'),
    (67, 'km', 'សេដ្ថកិច្ចទីផ្សារសេរី (Capitalisim)គឺជាទំរង់សេដ្ឋកិច្ចមួយដែលមានប្រវិត្តចេញពីបណ្តាប្រទេសលោកខាងលិច។'),
    (68, 'km', 'ប្រទេស​ឥណ្ឌា មាន​ផ្ទៃដី ៣,២៨៧,៥៩០ គីឡូម៉ែត្រ​ក្រឡា ធំ​ជាង​គេ​ទី​៧លើ​ពិភពលោក​ ស្ថិត​នៅ​ភូមិភាគអាស៊ីខាងត្បូង ខាងលិច​ជាប់នឹង សមុទ្រ​អារ៉ាប់ ខាងកើត​ជាប់នឹង ឈូងសមុទ្របេងហ្គាល់ និង​ខាងត្បូង​ជាប់​ មហាសមុទ្រឥណ្ឌា ចន្លោះ​ប្រទេស មីយ៉ាន់ម៉ា និងប៉ាគីស្ថាន។'),
    (69, 'km', 'តំបន់​ខ្ពង់រាប​ស្ថិតនៅ​ភាគ​ខាងត្បូង (ខ្ពង់រាប​ដេកង់) តំបន់​ទំនាប​ស្ថិតនៅ​តាមទន្លេ​គង្គា តំបន់​វាលខ្សាច់​រហោឋាន​នៅ​ភាគ​ខាងលិច និង​ខាងជើង​គឺ​ជួរភ្នំហិមាល័យ។'),
    (70, 'km', 'ប្រទេស​ឥណ្ឌា សំបូរ​នូវធនធានធម្មជាតិ យ៉ាង​ច្រើន​ដូច​ជា៖ ធ្យូងថ្ម រ៉ែដែក ម៉ង់ហ្កាណែស មីកា រ៉ែ​បុកស៊ីត ទីតាន ក្រូម ឧស្ម័នធម្មជាតិ ប្រេងកាត ពេជ្រ ថ្មកំបោរ និង​​ដី​ដាំ​ដំណាំ​ដែល​មាន​ជីរ​ជាតិ។'),
    (71, 'km', 'ភាពរាំងស្ងួត ទឹកជំនន់ ភ្លៀងមូសុង ខ្យល់ព្យុះ គ្រោះរញ្ជួយដី . . . ។'),
    (72, 'km', 'ឥណ្ឌា​បាន​​ស្គាល់​ភាពរុងរឿង​សារ​ជា​ថ្មី​ម្តង​ទៀត ហើយ​ចាប់​បើក​នូវ​យុគមាស​របស់​ខ្លួន ដោយ​រាជវង្ស​កុប្តៈ (Gupta) នៅ​រវាង​សតវត្ស​ទី​៤ និង​ទី​៦ នៃ​គ្រិស្ត​សករាជ ដែល​នៅ​​សម័យ​នោះ​ត្រូវ​បាន​គេ​មើល​ឃើញ​នូវ​ការ​រីកចំរើន​ទាំង វិទ្យាសាស្ត្រ សិល្បៈ និង​វប្បធម៌។'),
    (73, 'km', 'ទំនាក់ទំនង​អន្តរជាតិ និង​យោធា​'),
    (74, 'km', 'ប្រជាជន​ឥណ្ឌា​ ប្រមាណ​ ៦៤.៨​% ចេះ​អាន​ និង​​ សរសេរ​អក្សរ​ ក្នុង​នោះ​ បុរស​ ៧៣.៣​% ចេះ​អាន​ និង​សរសេរ​អក្សរ​ ចំណែក​ឯ​ស្ត្រី​មាន​តែ ៥៣.៧​%​ ប៉ុណ្ណោះ ​។'),
    (75, 'km', 'រដ្ឋសមាជិកនៃសមាគមប្រជាជាតិនៃសហធនរដ្ឋ'),
    (76, 'my', 'အီလက်ထရွန်းနစ်၏ ဘာသာရပ်ခွဲများ'),
    (77, 'my', 'အီလက်ထရွန်းနစ်တွင် အောက်ပါ ဘာသာရပ်ခွဲများ ရှိသည်။'),
    (78, 'my', 'ပတ်လမ်းများ ဒီဇိုင်းပြုလုပ်ခြင်း'),
    (79, 'my', 'အီလက်ထရွန်းနစ် စမ်းသပ်ကိရိယာများ'),
    (80, 'my', 'အမ်မီတာ (Ammeter) - (ဥပမာ ဂါဗနိုမီတာ) လျှပ်စီးအားကို တိုင်းတာသည်။'),
    (81, 'my', 'အုမ်းမီတာ (Ohmmeter) - (ဥပမာ ဝိစတုန်း ဘရစ်ချ်) ခုခံအားကို တိုင်းတာသည်။'),
    (82, 'my', 'ဗို့မီတာ (Voltmeter) - ဗို့အားကိုတိုင်းတာသည်။'),
    (83, 'my', 'မာလ်တီမီတာ (Multimeter) - အထက်ပါအရာအားလုံးကို တိုင်းတာသည်။'),
    (84, 'my', 'အော်ဆီလိုစကုပ် (Oscilloscope) - ခုခံအားမှအပ အချိန်နှင့်အမျှပြောင်းလဲနေသော အထက်ပါအရာအားလုံးကို တိုင်းတာသည်။'),
    (85, 'my', 'လောဂျစ်ခွဲခြမ်းစိတ်ဖြာကိရိယာ (Logic Analyzer) - ဒီဂျစ်တယ် ပတ်လမ်းများကို စမ်းသပ်ရာတွင် အသုံးပြုသည်။'),
    (86, 'my', 'ဖြာထွက်ရောင်ခြည်ခွဲခြမ်းစိတ်ဖြာကိရိယာ (Spectrum Analyzer)(SA) - အချက်ပြလှိုင်းများမှ ဖြာထွက်ရောင်ခြည်၏ စွမ်းအင်ကို တိုင်းတာရာတွင် အသုံးပြုသည်။'),
    (87, 'my', 'အီလက်ထရိုမီတာ (Electrometer) - ဓာတ်အားကို တိုင်းတာရာတွင် အသုံးပြုသည်။'),
    (88, 'my', 'ကြိမ်နှုန်းရေတွက်စက် (Frequency Counter)- ကြိမ်နှုန်းကို တိုင်းတာရာတွင် အသုံးပြုသည်။'),
    (89, 'my', '(Time-Domain Reflectometer)- ရှည်လျားသော ဝိုင်ယာကြိုးများ ကောင်းမွန်မှု ရှိမရှိကို တိုင်းတာရာတွင် အသုံးပြုသည်။'),
    (90, 'my', 'အီလက်ထရွန်းနစ် အစိတ်အပိုင်းများ'),
    (91, 'my', 'အီလက်ထရွန်းနစ် အစိတ်အပိုင်းများ'),
    (92, 'my', 'အီလက်ထရွန်းနစ်ကိရိယာများနှင့် ပတ်လမ်းများ'),
    (93, 'my', 'အီလက်ထရွန်းနစ် ဆိုင်ရာ သိကောင်းစရာ'),
    (94, 'my', 'အီလက်ထရွန်းနစ်ဟု ဆိုရာ၌ အီလက်ထရွန်များ၏ ပြုမူပုံ အကြောင်းကို ဆိုလိုခြင်း ဖြစ်၏။ အထူးသဖြင့် အီလက်ထရွန် များ ဖြတ်သန်းသွားရာ၌ ပြုမူပုံအကြောင်းနှင့် ထိုသို့ ပြုမူနိုင်'),
    (95, 'my', 'ရန် စီမံထားသောကိရိယာ အကြောင်းတို့ ပါဝင်သည်။ ထို့ပြင် အနီအောက်ရောင်ခြည်၊ ခရမ်းလွန် ရောင်ခြည် စသည့် ဓာတ် ရောင်ခြည်များအပေါ်တွင် အခြေခံထား၍'),
    (96, 'my', 'ပြုလုပ်သောကိရိယာများ၏ အကြောင်းလည်း ပါဝင်လေသည်။ အီလက်ထရွန်သည် အလင်း၏အသွားနှုန်းအတိုင်း တစ် စက္ကန့်လျှင် ၁၈၆ဝဝဝ မိုင်ခန့် သွားနိုင်သည်။ အီလက်ထရွန်း'),
    (97, 'my', 'အီလက်ထရွန်းနစ် ကိရိယာများကို စက်ရုံများတွင် အသုံး ပြုခြင်းဖြင့် လူ့မျက်စိဖြင့်လည်းကောင်း၊ လက်ဖြင့်လည်းကောင်း မမြင်နိုင် မစမ်းသပ်နို်င်သော စက်၏ချို့ယွင်းချက်များကို'),
    (98, 'my', 'ချက်ချင်း သိနိုင်ပေသည်။ စက်မှုလုပ်ငန်းတွင် ဖြစ်သော အနည်းငယ် ပြောင်းလဲချက်ကလေးကိုပင် မှတ်သားယူနိုင်ပေ သည်။ မကြာသေးမီက တီထွင်လိုက်သော ဖိုတိုအီလက်ထရစ်'),
    (99, 'my', 'စက်ဖြင့် အထည်ချောကိုလုပ်ရာ၌ ထိုအထည်သည် လိုအပ်သော အရွယ်အစားနှင့် ပုံသဏ္ဌာန်အရ ညီမညီ ကို စစ်ဆေးကြည့်ရှုရန် စက်ရုံများတွင် ဖိုတိုအီလက်ထရစ်ဆဲကို'),
    (100, 'my', 'အသုံးပြုသည်။ ဖိုတိုအီလက်ထရစ်ဆဲသည် မျက်စိ၊ လက် တို့ဖြင့် စမ်းသပ်စစ်ဆေးကြည့်ခြင်းထက် ပို၍မှန်ကန် တိကျ သည့်အပြင်၊ မှားယွင်းသည့် နေရာကိုလည်း ချက်ချင်း သိနိုင်'),
    (101, 'zh', '数学在许多领域都有应用，包括科學、工程、醫學、經濟學和金融學等。數學對這些領域的應用通常被稱為應用數學，有時亦會激起新的'),
    (102, 'zh', ' 布莱金厄省（2002年9月6日）'),
    (103, 'zh', '作者司馬遷以其“究天人之际，通古今之变，成一家之言”（《報任少卿書》）的史识，对後世史学和文学的发展皆产生了深远影响。《'),
    (104, 'zh', '臺灣也有使用所謂的異體字，例如“-{臺}-”與“-{台}-”、“-{體}-”與“-{体}-”以及“-{學}-”與“-{学'),
    (105, 'zh', ' 博斯查—荷兰（1831—1911）'),
    (106, 'zh', '本届奥运会耗资430亿美元，故此要開發市場。奥运会市场开发由国际奥委会的市场开发计划和举办城市奥组委的市场开发计划组成。'),
    (107, 'zh', '嘉庆四年二月二十一日，总管张进喜传旨交如意馆绘画太上皇帝圣容一轴，大边上花纹按照安佑宫供奉的圣祖和世宗圣容挂轴上的大边花'),
    (108, 'zh', '亚当斯的成长环境趋于温和，自认应该维护传统。清教徒对当地文化、法律、传统影响极大，亚当斯的父母都是信徒。他出生时宿命论之'),
    (109, 'zh', '伦敦是英国全国铁路（National Rail）系统的中心，有70%的铁路始发或终抵于伦敦。与市郊铁路相似，区域和城际铁'),
    (110, 'zh', ' 1916年：吳成家，台灣日治、戰後時期作曲家（1981年逝世）'),
    (111, 'zh', '柳兒始終守口如瓶不肯透露，她的行為打動了杜蘭朵公主，杜蘭朵公主就問柳兒「什麼力量驅使你如此堅強？」柳兒回答「是愛。」。杜'),
    (112, 'zh', '抗体上的抗原結合位可與抗原結合而将其聚集在一起，即凝集反應。由于抗体至少拥有两个抗原结合位，因此理论上它可以与不只一个相'),
    (113, 'zh', '林彥俊，前中國男子團體NINE PERCENT成員'),
    (114, 'zh', '元嘉二十九年（452年），劉義隆以北魏太武帝去世，命蕭思話督冀州刺史張永攻碻磝，可是自七月開始攻城起一直都無法攻破，至八'),
    (115, 'zh', ' 1275年：在有關免除阿姆斯特爾河大壩通行費的文件中，第一次提到「阿姆斯特丹」的名稱。'),
    (116, 'zh', ' 937年：南吴君主楊溥被迫让位给徐知诰，后者建立南唐政权。'),
    (117, 'zh', '樂善齋本全譯《紅樓夢》，余117冊，1884年，或為李鍾泰主導翻譯，世界最早全譯本。'),
    (118, 'zh', '西元前212年起，羅馬轉入反攻狀態，直攻迦太基，漢尼拔被逼回師去援救。結果漢尼拔因千里馳援，致使兵力下降，而其兵士亦顯得'),
    (119, 'zh', ' 2005年：弗里茨·飞利浦，荷兰企业家，飞利浦集团第四任总裁（1905年出生）'),
    (120, 'zh', '2003年4月，中华人民共和国教育部同意长沙交通学院和长沙电力学院合并，建立长沙理工大学。同年，该校成立独立学院长沙理工'),
    (121, 'zh', '1617年瑞典和俄羅斯議和，簽訂斯托爾博沃和約。1619年波蘭獲得了斯摩棱斯克和切爾尼戈夫。'),
    (122, 'zh', '柱础是柱的基座。在中国古建筑中用于檐柱、金柱、中柱、山柱的底端与台基之间。其功用有三：将柱子的重量分布在较大的面积传到地'),
    (123, 'zh', '早年受到高橋留美子的短篇「」「微笑標的」很深的影響，因此會決定要成為漫畫家。大學時期學過中國拳法。'),
    (124, 'zh', ' 1985年：-{zh-hk:基斯坦奴·朗拿度;zh-cn:克里斯蒂亚诺·罗纳尔多;zh-tw:克里斯蒂亞諾·羅納度}-'),
    (125, 'zh', '南通港是长江下游重要港口，现有天生、南通、狼山3个港区和青龙、启东两个港站。南通港现有码头岸线总长4110.8米，有万吨'),
    (126, 'zh', '皇帝：汉献帝（189年－220年）'),
    (127, 'zh', '柔然 - 予成，柔然可汗（464年-485年）'),
    (128, 'zh', ' 二月，王延政在建州稱帝，國號大殷，改元天德。'),
    (129, 'zh', '王錫侯，大清國江西書生，《字貫》案被處斬'),
    (130, 'zh', '由于深得郑周永喜爱的长子郑梦弼于1982年死于交通事故。1996年，郑周永的次子郑梦九出任为现代集团的会长。但1997年'),
    (131, 'zh', ' Blackmon, Douglas A. Slavery by Another Name: The Re-Enslav'),
    (132, 'zh', '1913年老亨利·摩根索被任命为驻奥斯曼帝国大使。摩根索在他任内尽全力缓解土耳其当局行动所造成的恶果。他给威尔逊发了一封'),
    (133, 'zh', '政务院专家工作办公室（1953年8月成立）'),
    (134, 'zh', '9月，閻錫山抵達重慶謁見蔣共商國是。9月23日，蔣召集李宗仁、閻錫山、吳鐵城、-{于}-右任等會商召開中國國民黨五中全會'),
    (135, 'zh', '1923年回国，任北京大学教授和英文系主任。1924年后为《语丝》主要撰稿人之一。1926年出任北京女子师范大学教务长，'),
    (136, 'zh', '1984年-1997年，人民文学出版社出版了38卷本的《茅盾全集》。2001年新版43卷'),
    (137, 'zh', '周信芳出身梨园世家，祖籍浙江省宁波府慈谿县慈城镇（今属宁波市江北区），1895年1月14日出生在江苏省清河县清江浦（在今'),
    (138, 'zh', '自2005年起，美國在台協會的職員包括了美軍現役軍人（美國陸軍、美國海軍、美國空軍軍官），2008年起則首度派遣美國海軍'),
    (139, 'ja', 'アンドレ＝マリ・アンペールがこの記号を自身の著作で使い、これが広く読まれたため、この記号が "Ampère''s and"'),
    (140, 'ja', ' ヴァルハラゲームスタジオ（ソレイユに吸収合併）'),
    (141, 'ja', '1月 - 明仁天皇（当時）、宮古島を初訪問。'),
    (142, 'ja', ' 連続テレビ小説 あさが来た（NHK、2015年 - 2016年）'),
    (143, 'ja', '1979年 『ベイビー・アイ・メイク・ア・モーション』（作詞：岩沢律、歌：レイジー）'),
    (144, 'ja', '趣味は音楽鑑賞。好きなアーティストにさねよしいさ子、モーツァルト、スコット・ジョプリンを挙げている。スポーツ観戦も趣味。'),
    (145, 'ja', ' 2月13日 - 阿部力、俳優'),
    (146, 'ja', 'ミンスキーはローブナー賞には批判的である。'),
    (147, 'ja', ' アブハジア社会主義ソビエト共和国1921年 - 1931年'),
    (148, 'ja', ' 本作品と『超力戦隊オーレンジャー』のクロスオーバー作品（スーパー戦隊Vシネマ作品）。'),
    (149, 'ja', ' 2006年ごろからアシスタントを務めた。2010年に病気療養で一時休職後、最終話まで務めている。'),
    (150, 'ja', ' 1957年 - みぶ真也、俳優、怪談タレント'),
    (151, 'ja', ' 苺ましまろ - 佐鳴湖が登場する漫画・アニメ作品'),
    (152, 'ja', ' 1994年 - 原爆切手発行問題: アメリカ合衆国郵便公社が原爆切手発行の中止を決定。'),
    (153, 'ja', ' 頭のいい「雨の木」/身がわり山羊の反撃/『芽むしり仔撃ち』裁判'),
    (154, 'ja', ' 1982年 - 向井理、俳優'),
    (155, 'ja', ' 1779年 - アメリカ独立戦争: 。'),
    (156, 'ja', ' 10月26日 - 岡田浩暉、歌手・俳優'),
    (157, 'ja', ' 運命が変わり、龍の滅びなかった新たなタルキールが舞台。カンに変わり“龍王”が自身の名を冠する氏族を統べており、対抗色3'),
    (158, 'ja', 'レジナルド・グッドオール (Reginald Goodall, 1901/7/13 - 1990/5/5)'),
    (159, 'ja', 'しかし、通常に16ビットアドレスをデコードしてI/Oのハードを構成してしまうと、アドレス指定にBCレジスタを指定しないO'),
    (160, 'ja', ' 2022年：「映画批評家が選ぶベストテン」第6位'),
    (161, 'ja', '現在はほとんどの機種にペンタプリズム（廉価機種ではペンタミラー）が装着されている（アイレベル）。ただし、これは一眼レフの'),
    (162, 'ja', ' 10月28日 - フランシス・ベーコン、画家（+ 1992年）'),
    (163, 'ja', ' 10月31日 - 灰谷健次郎、児童文学作家（+ 2006年）'),
    (164, 'ja', ' 3月27日 - デビッド・ホステトラー、元プロ野球選手'),
    (165, 'ja', ' 「鎖国」（海禁）政策のもとで、長崎の唐人屋敷における清、長崎出島におけるオランダとの交易が幕府によって行われた。また、'),
    (166, 'ja', '日本とチリは日本・チリ経済連携協定（2007年9月3日発効）を締結している。また、ともに環太平洋パートナーシップに関する'),
    (167, 'ja', ' Long Term Predictor (LTP)'),
    (168, 'ja', 'たとえば「時間は矢のように飛び去る」という候補のほうは残し、「時間蠅は矢を好む」という候補のほうはダメだと判断して排除す'),
    (169, 'ja', '社会保険庁（厚生労働省） - 2009年（平成21年）12月31日廃止。新たに特殊法人である日本年金機構が発足した。'),
    (170, 'ja', 'こうした薬剤の分類や呼び分けは、医師・研究者や治療する疾病の分野によってやや異なることがある。一般向けに出版されている書'),
    (171, 'ja', ' 開会式欄の「－」は、会期の冒頭で衆議院が解散され開会式が行われなかったことを表す。なお、参議院の緊急集会については、開'),
    (172, 'ja', '代表的な方法として、以下の二つがある。'),
    (173, 'ja', ' 成務天皇（第13代）： 10750日（61年）→5375日（30.0年）'),
    (174, 'ja', ' 1,676 mm (5 ft 6 in) - 南アジア、南アメリカの一部など'),
    (175, 'ja', 'ワイアナエ (Wai‘anae) '),
    (176, 'ja', ' 5月13日 - ヴォイチェフ・アダルベルト・ジヴヌィ、音楽家（+ 1842年）'),
    (177, 'mixed', 'ภาษาไทยทดสอบการแบ่งคำ then latin'),
    (178, 'mixed', '中文测试 mixed with English 文本 and 日本語のテキスト'),
    (179, 'mixed', 'ພາສາລາວ ແລະ ภาษาไทย 2024'),
    (180, 'mixed', 'ភាសាខ្មែរ១២៣ និង English'),
    (181, 'mixed', 'မြန်မာဘာသာ ၁၂၃ Myanmar'),
    (182, 'mixed', 'カタカナーとひらがな、漢字。'),
    (183, 'mixed', 'ｶﾀｶﾅｰ ﾊﾝｶｸ'),
    (184, 'mixed', '한국어 문장은 띄어 씁니다'),
    (185, 'mixed', 'ᥐᥑᥒ ᨀᨁᨂ ꪀꪁꪂ'),
    (186, 'mixed', 'Ｆｕｌｌｗｉｄｔｈ ＡＢＣ １２３'),
    (187, 'mixed', 'ゝゞ〱〲ヽヾ'),
    (188, 'mixed', '゛゜ ー ｰ'),
    (189, 'mixed', 'ไทย๑๒๓.๔๕'),
    (190, 'mixed', 'ຫົວ​ຂໍ້')
) t(id, lang, s);


query
SELECT id, split_text_icu(s, 'th') AS words FROM db_lines WHERE lang = 'th' ORDER BY id;
----
id	words
1	{การ,ค้น,พบ,สิ่ง,ต่าง,ๆ,ใน,เรื่อง,ของ,ดาราศาสตร์,ที่,เผย,แพร่,โดย,นัก,ดาราศาสตร์,สมัคร,เล่น,นั้น,มี,ความ,สำคัญ,มาก,และ,ดาราศาสตร์,ก็,เป็น,หนึ่ง,ใน,วิทยาศาสตร์,จำนวน,น้อย,สาขา,ที่,นัก,ดาราศาสตร์,สมัคร,เล่น,ยัง,คง,มี,บทบาท,โดย,เฉพาะ,การ,ค้น,พบ,หรือ,การ,สังเกตการณ์,ปรากฏการณ์,ที่,เกิด,ขึ้น,เพียง,ชั่วคราว}
