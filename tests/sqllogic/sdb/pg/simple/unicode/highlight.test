statement ok
CREATE TABLE hl_docs AS SELECT * FROM (VALUES
    (1, 'การค้นพบสิ่งต่าง ๆ ในเรื่องของดาราศาสตร์ที่เผยแพร่โดยนักดาราศาสตร์สมัครเล่นนั้นมีความสำคัญมาก และดาราศาสตร์ก็เป็นหนึ่งในวิทยาศาสตร์จำนวนน้อยสาขาที่นักดาราศาสตร์สมัครเล่นยังคงมีบทบาท โดยเฉพาะการค้นพบหรือการสังเกตการณ์ปรากฏการณ์ที่เกิดขึ้นเพียงชั่วคราว การค้นพบสำคัญทางดาราศาสตร์ประสบความสำเร็จมากขึ้นเมื่อมีเทคโนโลยีใหม่ ๆ เช่น การถ่ายภาพ และสเปกโตรสโคป เราทราบว่าดวงดาวต่าง ๆ ที่แท้เป็นดาวฤกษ์ที่มีลักษณะคล้ายคลึงกับดวงอาทิตย์ของเรานั่นเอง แต่มีอุณหภูมิ มวล และขนาดที่แตกต่างกันไป', 36, 45),
    (2, 'ในทางดาราศาสตร์ สารสนเทศส่วนใหญ่ได้จากการตรวจหาและวิเคราะห์โฟตอนซึ่งเป็นการแผ่รังสีแม่เหล็กไฟฟ้า แต่อาจได้จากข้อมูลที่มากับรังสีคอสมิก นิวตริโน ดาวตก และในอนาคตอันใกล้อาจได้จากคลื่นความโน้มถ่วง วัตถุดาราศาสตร์ที่สามารถสังเกตได้ในช่วงคลื่นวิทยุมีมากมาย รวมไปถึงซูเปอร์โนวา แก๊สระหว่างดาว พัลซาร์ และนิวเคลียสดาราจักรกัมมันต์', 36, 45),
    (3, 'การสังเกตการณ์อื่นนอกเหนือจากสเปกตรัมแม่เหล็กไฟฟ้า นอกเหนือจากการสังเกตการณ์ดาราศาสตร์โดยการแผ่รังสีคลื่นแม่เหล็กไฟฟ้าแล้ว ยังมีการสังเกตการณ์อื่น ๆ ที่ทำได้บนโลกเพื่อศึกษาวัตถุในระยะไกลมาก ๆ', 36, 45),
    (4, 'ອົງການໄປສະນີແລະໂທລະຄົມມະນາຄົມແຫ່ງຊາດ ຂ່າວດີຂ່າວໃໝ່ທີ່ບໍ່ເຄີຍມີມາກອ່ນ ພາກວິຊາພູມີສາດ', 36, 45),
    (5, 'ບົດທີ່ ໑ ສະຖານະພາບທົ່ວໄປຂອງໂປຣແກຣມ ERDAS IMAGINE ບົດທີ່ ໒ ການທຳງານເທິງວິວເວີ Viewer', 32, 41),
    (6, 'ບົດທີ່ ໓ ການນຳເຂົ້າແລະສົ່ງອອກຂໍ້ມູນ ບົດທີ ໔ ການກະກຽມຂໍ້ມູນກອ່ນການປະມວນຜົນ', 32, 41),
    (7, 'សមាធិ គឺការតាំងចិត្តមាំក្នុងអារម្មណ៍តែមួយ ឬការដឹងច្បាស់នូវអារម្មណ៍នោះៗដោយសច្ចភាព។ សមាធិមានពីរយ៉ាងគឺ សមថកម្មដ្ឋាន និងវិបស្សនាកម្មដ្ឋាន។ សមថកម្មដ្ឋាន គឺជាការគ្រៀកចិត្ត​ឬចងចិត្តឲ្យជាប់ក្នុងអារម្មណ៍តែមួយមិនបណ្តោយឲ្យចិត្តត្រាច់ចរទៅរកអារម្មណ៍ផ្សេងៗ។ សមថសមាធិមាន៣កំរិតតាមកម្លាំងនៃការប្រតិបត្តិ៖', 34, 43),
    (8, 'ខណិកសមាធិ គឺសមាធិដែលចិត្តមានអារម្មណ៍តែមួយ ឬចិត្តស្ងប់កើតឡើងមួយជួរខណៈ តែមិនបានយូរប៉ុន្នានក៏រលត់ទៅ។ ឧបចារសមាធិ គឺសមាធិដែលចិត្តស្ងប់រំងាប់ប្រាសចាកនិវរណៈទាំង៥តែមិនជាអារម្មណ៍របស់អង្គឈានមានបឋមជ្ឈានជាដើមនោះទេ ប៉ុន្តែអារម្មណ៍របស់ឧបចារសមាធិនេះគឺជាអារម្មណ៍សមាធិដែលចិត្តស្ថិតក្នុងសភាពជិតបានឈានសមាបត្តិហ្នឹងឯង។', 34, 43),
    (9, 'សាខានៃភាសាវិទ្យា​ដែល​ទាក់​ទង​នឹង​មុខវិទ្យា​ដទៃ ភាសាវិទូនិង​បុគ្គល​គួរ​កត់​សម្គាល់​ក្នុង​ភាសាវិទ្យា', 36, 45),
    (10, 'အီလက်ထရွန်းနစ်၏ ဘာသာရပ်ခွဲများ အီလက်ထရွန်းနစ်တွင် အောက်ပါ ဘာသာရပ်ခွဲများ ရှိသည်။', 36, 45),
    (11, 'ပတ်လမ်းများ ဒီဇိုင်းပြုလုပ်ခြင်း အီလက်ထရွန်းနစ် စမ်းသပ်ကိရိယာများ', 34, 43),
    (12, 'အမ်မီတာ (Ammeter) - (ဥပမာ ဂါဗနိုမီတာ) လျှပ်စီးအားကို တိုင်းတာသည်။ အုမ်းမီတာ (Ohmmeter) - (ဥပမာ ဝိစတုန်း ဘရစ်ချ်) ခုခံအားကို တိုင်းတာသည်။', 26, 29),
    (13, '数学在许多领域都有应用，包括科學、工程、醫學、經濟學和金融學等。數學對這些領域的應用通常被稱為應用數學，有時亦會激起新的。 布莱金厄省（2002年9月6日）', 36, 45),
    (14, '作者司馬遷以其“究天人之际，通古今之变，成一家之言”（《報任少卿書》）的史识，对後世史学和文学的发展皆产生了深远影响。《。臺灣也有使用所謂的異體字，例如“-{臺}-”與“-{台}-”、“-{體}-”與“-{体}-”以及“-{學}-”與“-{学', 36, 45),
    (15, ' 博斯查—荷兰（1831—1911）。本届奥运会耗资430亿美元，故此要開發市場。奥运会市场开发由国际奥委会的市场开发计划和举办城市奥组委的市场开发计划组成。', 26, 31),
    (16, '嘉庆四年二月二十一日，总管张进喜传旨交如意馆绘画太上皇帝圣容一轴，大边上花纹按照安佑宫供奉的圣祖和世宗圣容挂轴上的大边花。亚当斯的成长环境趋于温和，自认应该维护传统。清教徒对当地文化、法律、传统影响极大，亚当斯的父母都是信徒。他出生时宿命论之', 36, 45),
    (17, 'アンドレ＝マリ・アンペールがこの記号を自身の著作で使い、これが広く読まれたため、この記号が "Ampère''s and"。 ヴァルハラゲームスタジオ（ソレイユに吸収合併）', 36, 45),
    (18, '1月 - 明仁天皇（当時）、宮古島を初訪問。。 連続テレビ小説 あさが来た（NHK、2015年 - 2016年）', 28, 37),
    (19, '1979年 『ベイビー・アイ・メイク・ア・モーション』（作詞：岩沢律、歌：レイジー）。趣味は音楽鑑賞。好きなアーティストにさねよしいさ子、モーツァルト、スコット・ジョプリンを挙げている。スポーツ観戦も趣味。', 26, 35),
    (20, ' 2月13日 - 阿部力、俳優。ミンスキーはローブナー賞には批判的である。', 22, 31)
) t(id, doc, hit_start, hit_end);


query
