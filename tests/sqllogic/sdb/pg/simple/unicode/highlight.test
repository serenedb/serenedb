query
SELECT id, ts_highlight(doc, ARRAY[hit_start, hit_end], 'StartSel=[, StopSel=]') AS passage FROM hl_docs ORDER BY id;
----
id	passage
1	การค้นพบสิ่ง[ต่าง] ๆ ในเรื่องของดาราศาสตร์ที่เผยแพร่โดยนักดาราศาสตร์สมัครเล่นนั้นมีความสำคัญมาก และดาราศาสตร์ก็เป็นหนึ่งในวิทยาศาสตร์จำนวนน้อยสาขาที่นัก
2	ในทาง[ดาราศาสตร์] สารสนเทศส่วนใหญ่ได้จากการตรวจหาและวิเคราะห์โฟตอนซึ่งเป็นการแผ่รังสีแม่เหล็กไฟฟ้า แต่อาจได้จากข้อมูลที่มากับรังสีคอสมิก นิวตริโน
3	การ[สังเกตการณ์อื่น]นอกเหนือจากสเปกตรัมแม่เหล็กไฟฟ้า นอกเหนือจากการสังเกตการณ์ดาราศาสตร์โดยการแผ่รังสีคลื่นแม่เหล็กไฟฟ้าแล้ว ยังมีการสังเกตการณ์อื่น ๆ ที่ทำได้บนโลกเพื่อศึกษาวัตถุในระยะ
4	ອົງການໄປສະນີ[ແລະ]ໂທລະຄົມມະນາຄົມແຫ່ງຊາດ ຂ່າວດີຂ່າວໃໝ່ທີ່ບໍ່ເຄີຍມີມາກອ່ນ ພາກວິຊາພູມີສາດ
5	ບົດທີ່ ໑ [ສະຖານະພາບ]ທົ່ວໄປຂອງໂປຣແກຣມ ERDAS IMAGINE ບົດທີ່ ໒ ການທຳງານເທິງວິວເວີ Viewer
6	ບົດທີ່ ໓ ການ[ນຳເຂົ້າ]ແລະສົ່ງອອກຂໍ້ມູນ ບົດທີ ໔ ການກະກຽມຂໍ້ມູນກອ່ນການປະມວນຜົນ
7	សមាធិ គឺការ[តាំងចិត្ត]មាំក្នុងអារម្មណ៍តែមួយ ឬការដឹងច្បាស់នូវអារម្មណ៍នោះៗដោយសច្ចភាព
8	ខណិកសមាធិ គឺ[សមាធិ]ដែលចិត្តមានអារម្មណ៍តែមួយ ឬចិត្តស្ងប់កើតឡើងមួយជួរខណៈ តែមិនបានយូរប៉ុន្នានក៏រលត់ទៅ
9	សាខានៃ[ភាសាវិទ្យា]​ដែល​ទាក់​ទង​នឹង​មុខវិទ្យា​ដទៃ ភាសាវិទូនិង​បុគ្គល​គួរ​កត់​សម្គាល់​ក្នុង​ភាសាវិទ្យា
10	အီလက်ထရွန်း[နစ်]၏ ဘာသာရပ်ခွဲများ အီလက်ထရွန်းနစ်တွင် အောက်ပါ ဘာသာရပ်ခွဲများ ရှိသည်
11	ပတ်လမ်းများ [ဒီဇိုင်း]ပြုလုပ်ခြင်း အီလက်ထရွန်းနစ် စမ်းသပ်ကိရိယာများ
