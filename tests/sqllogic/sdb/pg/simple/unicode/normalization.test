query
SELECT part, count(*) AS cases, md5(string_agg(array_to_string(list_transform(range(1, length(t) + 1), lambda i: printf('%04X', unicode(substr(t, i::INTEGER, 1)))), ' '), ',' ORDER BY id)) AS digest FROM (SELECT id, part, normalize_tokens(s, form := 'nfc')[1] AS t FROM nm_cases) GROUP BY part ORDER BY part;
----
part	cases	digest
0	45	fdb5e5ccac77d65b6cefb47f3ca9f9eb
2	1936	17c52d39b95d1e7938a9c0e75f49aec4
3	194	72aad0382cee35fc0c3d4625de293325
4	735	94af4336fac6c98d99e856bdb2830ec9
5	38	c7305a07be5a1a8b1e77f824e6928096


