statement ok
CREATE TABLE nm_cp AS
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(0, 55296) t(c)
    UNION ALL
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(57344, 1114112) t(c);


query
SELECT count(*) FILTER (WHERE t <> s) AS changed, md5(string_agg(t, ',' ORDER BY c)) AS digest FROM (SELECT c, s, normalize_tokens(s, form := 'nfc', accent := true)[1] AS t FROM nm_cp);
----
changed	digest
1120	d821b663a8434404410dc7f9205ff0cb


