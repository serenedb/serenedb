statement ok
CREATE TABLE rp_cp AS
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(0, 55296) t(c)
    UNION ALL
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(57344, 1114112) t(c);


query
SELECT count(*) AS n, min(c) AS lo, max(c) AS hi, sum(c) AS total, sum(c::BIGINT * c) AS squares FROM rp_cp WHERE regexp_full_match(s, '\p{NFKD_QC=N}');
----
n	lo	hi	total	squares
17086	160	195101	955815805	75992249435485


