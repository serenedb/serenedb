statement ok
CREATE TABLE rp_cp AS
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(0, 55296) t(c)
    UNION ALL
    SELECT c::INTEGER AS c, chr(c::INTEGER) AS s FROM range(57344, 1114112) t(c);


query
SELECT count(*) AS n, min(c) AS lo, max(c) AS hi, sum(c) AS total, sum(c::BIGINT * c) AS squares FROM rp_cp WHERE regexp_full_match(s, '\p{gcm=Lu}');
----
n	lo	hi	total	squares
1886	65	125217	89399941	8847081614423


