statement ok
DROP TABLE sb_cases;


statement ok
CREATE TABLE sb_abbreviations AS SELECT * FROM (VALUES
    (1, 'en', 'Mr. Smith arrived. He sat down.'),
    (2, 'en', 'See e.g. the list. It is short.'),
    (3, 'en', 'The U.S. economy grew. Prices rose.'),
    (4, 'en', 'He holds a Ph.D. in physics. She does not.'),
    (5, 'en', 'Call me at 5 p.m. tomorrow. Thanks.'),
    (6, 'en', 'Dr. Who? No. Mr. Who!'),
    (7, 'en', 'It was approx. ten. Fine.'),
    (8, 'en', 'Mrs. Jones vs. Mr. Brown. Done.'),
    (9, 'en', 'No. 5 is next. Wait.'),
    (10, 'en', 'etc. and so on. The end.'),
    (11, 'de', 'Das ist z.B. ein Test. Noch einer.'),
    (12, 'de', 'Herr Dr. Müller kam. Er ging.'),
    (13, 'de', 'Vgl. Abs. 3. Fertig.'),
    (14, 'de', 'Am 3. Okt. war Feiertag. Schön.'),
    (15, 'de', 'Die Fa. Meier GmbH. Weiter.'),
    (16, 'es', 'El Sr. García llegó. Se fue.'),
    (17, 'es', 'Vea pág. 5. Gracias.'),
    (18, 'es', 'La Sra. López y el Dr. Ruiz. Fin.'),
    (19, 'fr', 'M. Dupont est arrivé. Il est parti.'),
    (20, 'fr', 'Voir p. 12. Merci.'),
    (21, 'fr', 'Mme. Martin et Dr. Durand. Fin.'),
    (22, 'it', 'Il Sig. Rossi è arrivato. Se n''è andato.'),
    (23, 'it', 'Vedi pag. 4. Grazie.'),
    (24, 'it', 'Il Dott. Bianchi. Fine.'),
    (25, 'pt', 'O Sr. Silva chegou. Ele saiu.'),
    (26, 'pt', 'Veja pág. 7. Obrigado.'),
    (27, 'pt', 'A Dra. Souza e o Prof. Lima. Fim.'),
    (28, 'ru', 'Это т.е. пример. Ещё один.'),
    (29, 'ru', 'Г. Иванов пришёл. Ушёл.'),
    (30, 'ru', 'См. стр. 5. Спасибо.'),
    (31, 'el', 'Αυτό είναι μια πρόταση; Και αυτή.'),
    (32, 'el', 'Τι; Ναι. Όχι!')
) t(id, lang, s);


query
SELECT id, split_text_icu(s, 'en', break := 'sentence') AS sentences FROM sb_abbreviations WHERE lang = 'en' ORDER BY id;
----
id	sentences
1	{Mr.,"Smith arrived.","He sat down."}
2	{"See e.g. the list.","It is short."}
3	{"The U.S. economy grew.","Prices rose."}
4	{"He holds a Ph.D. in physics.","She does not."}
5	{"Call me at 5 p.m. tomorrow.",Thanks.}
6	{Dr.,Who?,No.,Mr.,Who!}
7	{"It was approx. ten.",Fine.}
8	{Mrs.,"Jones vs.",Mr.,Brown.,Done.}
9	{"No. 5 is next.",Wait.}
10	{"etc. and so on.","The end."}


