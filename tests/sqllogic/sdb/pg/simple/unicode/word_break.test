query
SELECT id, array_to_string(list_transform(split_text_icu(s, 'en', break := 'all'), lambda x: length(x)), ',') AS segments, array_to_string(list_transform(split_text_icu(s, 'en'), lambda x: length(x)), ',') AS words FROM wb_cases ORDER BY id;
