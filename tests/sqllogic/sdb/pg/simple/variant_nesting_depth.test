statement ok
CREATE TABLE vnd_explain AS
SELECT (repeat('{"inputs":{"a":', 200000) || '{}' || repeat('}}', 200000))::JSON AS doc;

statement error
SELECT ts_explain_json(doc::VARIANT) FROM vnd_explain;
