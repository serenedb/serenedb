statement ok
CREATE TABLE vnd_one AS
SELECT (repeat('{"a":', 100000) || '1' || repeat('}', 100000))::JSON AS doc;

query
SELECT doc::VARIANT IS NULL AS is_null FROM vnd_one;
----
is_null
f

statement ok
CREATE TABLE vnd_two AS
SELECT (repeat('[', 100000) || '1' || repeat(']', 100000))::JSON AS doc
UNION ALL
SELECT '[1]'::JSON;

query
SELECT doc::VARIANT IS NULL AS is_null FROM vnd_two ORDER BY length(doc::VARCHAR);
----
is_null
f
f

