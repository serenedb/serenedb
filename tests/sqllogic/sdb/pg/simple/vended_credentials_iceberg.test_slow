control substitution on

# A table that vends storage credentials registers one internal secret, and
# keeps exactly that one however many times it is read or written. The secret
# name used to carry the transaction id, so every transaction added another
# secret with the same scope; secret lookup breaks scope ties on the name, so
# a stale credential could outrank the fresh one.
#
# sigv4 is what makes the fixture reach the credential branch at all -- with
# AUTHORIZATION_TYPE 'none' the catalog returns no credentials and no internal
# secret is ever created. Isolation is per-${__DATABASE__}, like the sibling
# iceberg tests: duckdb_secrets() is process-global and shared with the other
# tests running against this serened.


statement ok
CREATE OR REPLACE SECRET iceberg_vend_${__DATABASE__} (
  TYPE S3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/warehouse/${__DATABASE__}/'
);


statement ok
SET s3_use_ssl=false;


statement ok
DETACH DATABASE IF EXISTS iceberg_vend_${__DATABASE__};

statement ok
ATTACH '${ICEBERG_WAREHOUSE}' AS iceberg_vend_${__DATABASE__} (
  TYPE ICEBERG,
  ENDPOINT '${ICEBERG_REST_URL}',
  AUTHORIZATION_TYPE 'sigv4',
  SIGV4_SERVICE 'custom',
  SIGV4_REGION 'us-east-1',
  SECRET 'iceberg_vend_${__DATABASE__}'
);


statement ok
CREATE SCHEMA iceberg_vend_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE iceberg_vend_${__DATABASE__}.${__DATABASE__}.vended_${__DATABASE__} (id INTEGER);

statement count 2
INSERT INTO iceberg_vend_${__DATABASE__}.${__DATABASE__}.vended_${__DATABASE__} VALUES (1), (2);


statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vended_${__DATABASE__};

query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE name LIKE '\_\_internal\_ic%vended\_${__DATABASE__}%' ESCAPE '\';
----
secrets
1


