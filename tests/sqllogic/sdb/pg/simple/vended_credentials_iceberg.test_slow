control substitution on

# Internal credential secrets: one per table per transaction, named after the
# catalog, schema and table, and gone once the transaction ends.
#
# The name has to carry the catalog: it is what keeps two catalogs that hold a
# table of the same name from overwriting each other's credential. The secrets
# are registered with SecretPersistType::TRANSACTION, so duckdb hangs them off
# the MetaTransaction and drops them when it ends -- one session's credential is
# never visible to another, and nothing has to sweep them.
#
# sigv4 is what makes the fixture vend at all -- with AUTHORIZATION_TYPE 'none'
# the catalog returns no credentials and no internal secret is ever created, so
# a test written that way passes against broken code. duckdb_secrets() is
# process-global and shared with the other tests on this serened, hence the
# per-${__DATABASE__} table names.


statement ok
CREATE OR REPLACE SECRET iceberg_vend_${__DATABASE__} (
  TYPE S3,
  KEY_ID '${MINIO_ACCESS_KEY}',
  SECRET '${MINIO_SECRET_KEY}',
  ENDPOINT '${MINIO_HOST}:${MINIO_PORT}',
  URL_STYLE 'path',
  USE_SSL false,
  SCOPE 's3://${MINIO_BUCKET}/warehouse/${__DATABASE__}/'
);


statement ok
SET s3_use_ssl=false;


statement ok
DETACH DATABASE IF EXISTS iceberg_vend_${__DATABASE__};

statement ok
ATTACH '${ICEBERG_WAREHOUSE}' AS iceberg_vend_${__DATABASE__} (
  TYPE ICEBERG,
  ENDPOINT '${ICEBERG_REST_URL}',
  AUTHORIZATION_TYPE 'sigv4',
  SIGV4_SERVICE 'custom',
  SIGV4_REGION 'us-east-1',
  SECRET 'iceberg_vend_${__DATABASE__}'
);


statement ok
CREATE SCHEMA iceberg_vend_${__DATABASE__}.${__DATABASE__};

statement ok
CREATE TABLE iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__} (id INTEGER);

statement ok
CREATE TABLE iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_b_${__DATABASE__} (id INTEGER);

statement count 2
INSERT INTO iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__} VALUES (1), (2);

statement count 1
INSERT INTO iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_b_${__DATABASE__} VALUES (9);


# A reader holds exactly one credential for the table, it is transaction-scoped,
# and its name carries the catalog alias -- without the catalog, a same-named
# table in another catalog would take this entry over.
statement ok
BEGIN;

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}')
  AND contains(name, 'iceberg_vend_${__DATABASE__}')
  AND storage = 'transaction';
----
secrets
1

# It belongs to this transaction alone: another session cannot see it.
connection onlooker user=postgres
query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}');
----
secrets
0

# Reading it again inside the same transaction replaces that one credential
# rather than adding another beside it. A name that varied per registration
# would leave a pile of same-scope secrets here, and the one a scan picks is
# decided by a name comparison -- so a stale entry could win.
statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}');
----
secrets
1

statement ok
COMMIT;


# Ending the transaction clears it. This is the leak: a read-only transaction
# used to leave its credential behind, and they accumulated per transaction.
query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}');
----
secrets
0


statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}');
----
secrets
0


# A rollback clears them too.
statement ok
BEGIN;

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

statement ok
ROLLBACK;

query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}');
----
secrets
0


# Two tables read in one transaction keep separate credentials, each scoped to
# its own path.
statement ok
BEGIN;

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_b_${__DATABASE__};

query
SELECT count(DISTINCT name) AS secrets, count(DISTINCT scope) AS scopes FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND (contains(name, 'vend_a_${__DATABASE__}') OR contains(name, 'vend_b_${__DATABASE__}'));
----
secrets	scopes
2	2

statement ok
COMMIT;


# Two transactions reading the same table at the same time: each owns its own
# entry, so neither conflicts with the other on creating it.
connection reader_one user=postgres
statement ok
BEGIN;

connection reader_one user=postgres
statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

connection reader_two user=postgres
statement ok
BEGIN;

connection reader_two user=postgres
statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

connection reader_one user=postgres
statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

connection reader_one user=postgres
statement ok
COMMIT;

connection reader_two user=postgres
statement ok
SELECT count(*) FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

connection reader_two user=postgres
statement ok
COMMIT;

query
SELECT count(*) AS secrets FROM duckdb_secrets()
WHERE contains(name, '__internal_ic_')
  AND contains(name, 'vend_a_${__DATABASE__}');
----
secrets
0


query
SELECT id FROM iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__} ORDER BY id;
----
id
1
2


statement ok
DROP TABLE iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_a_${__DATABASE__};

statement ok
DROP TABLE iceberg_vend_${__DATABASE__}.${__DATABASE__}.vend_b_${__DATABASE__};

statement ok
DROP SCHEMA iceberg_vend_${__DATABASE__}.${__DATABASE__};

statement ok
DETACH DATABASE iceberg_vend_${__DATABASE__};

statement ok
DROP SECRET iceberg_vend_${__DATABASE__};
