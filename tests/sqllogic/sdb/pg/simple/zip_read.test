statement ok
CREATE TABLE zip_import(id INTEGER, value INTEGER);

statement count 3
COPY zip_import FROM 'zip://${__TEST_DIR__}/zip_deflate.zip/nested/data.csv' (FORMAT CSV, HEADER);

query
