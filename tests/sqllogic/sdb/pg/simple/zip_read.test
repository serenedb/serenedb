control substitution on

statement ok
COPY (SELECT * FROM (VALUES (1, 2), (2, 4), (3, 6)) t(id, value))
TO '${__TEST_DIR__}/zip_data.csv' (FORMAT CSV, HEADER);

statement ok
COPY (SELECT * FROM (VALUES (1, 2), (2, 4), (3, 6)) t(id, value))
TO '${__TEST_DIR__}/zip_data.jsonl' (FORMAT JSON);

statement ok
COPY (SELECT * FROM (VALUES (1, 2), (2, 4), (3, 6)) t(id, value))
TO '${__TEST_DIR__}/zip_data.parquet' (FORMAT PARQUET);

system ok
python3 - "$__TEST_DIR__" <<'PY'
import pathlib, sys, zipfile
root = pathlib.Path(sys.argv[1])
for name, method in [('store', zipfile.ZIP_STORED), ('deflate', zipfile.ZIP_DEFLATED)]:
    with zipfile.ZipFile(root / ('zip_' + name + '.zip'), 'w', compression=method) as archive:
        for extension in ['csv', 'jsonl', 'parquet']:
            archive.write(root / ('zip_data.' + extension), 'nested/data.' + extension)
        archive.writestr('data.json', '[{"id":1,"value":2},{"id":2,"value":4},{"id":3,"value":6}]')
PY

query
SELECT * FROM read_csv('zip://${__TEST_DIR__}/zip_store.zip/nested/data.csv') ORDER BY id;
----
id	value
1	2
2	4
3	6

