control substitution on

# Setup-dependent compatibility claims for core-sql-compatibility.md.
# These features need prerequisite objects (tables, indexes), so they are
# authored with explicit setup rather than auto-probed in isolation.

# --- Indexes (CREATE INDEX family) ---

statement ok
CREATE TABLE sc_idx_t (a INTEGER, b INTEGER);

# ddl_index: CREATE INDEX
statement ok
CREATE INDEX sc_idx_1 ON sc_idx_t (a);

# ddl_index: Multicolumn Indexes
statement ok
CREATE INDEX sc_idx_2 ON sc_idx_t (a, b);

# ddl_index: Ordered Indexes
statement ok
CREATE INDEX sc_idx_3 ON sc_idx_t (a DESC);

# ddl_index: Unique Indexes
statement ok
CREATE UNIQUE INDEX sc_idx_4 ON sc_idx_t (b);

# --- Partial indexes (WHERE predicate; inverted-only -> Partial) ---

statement ok
CREATE TABLE sc_idx_part_t (a INTEGER, t TEXT);

# ddl_index: Partial Indexes
statement ok
CREATE INDEX sc_idx_part ON sc_idx_part_t USING inverted(t) WHERE a > 5;

statement ok
CREATE INDEX sc_idx_part_plain ON sc_idx_part_t (a) WHERE a > 5;


# --- Foreign Keys (syntax accepted; not enforced -> Partial) ---

statement ok
CREATE TABLE sc_fk_p (id INTEGER PRIMARY KEY);

# ddl_create: Foreign Keys
statement ok
CREATE TABLE sc_fk_c (a INTEGER REFERENCES sc_fk_p (id));

# --- ALTER TABLE rename ---

statement ok
CREATE TABLE sc_ren (a INTEGER, b INTEGER);

# ddl_alter: RENAME COLUMN
statement ok
ALTER TABLE sc_ren RENAME COLUMN a TO a2;

# ddl_alter: RENAME TO
statement ok
ALTER TABLE sc_ren RENAME TO sc_ren2;

# --- ALTER TABLE columns and constraints ---

statement ok
CREATE TABLE sc_alter (a INTEGER, b INTEGER, c INTEGER);

statement ok
CREATE TABLE sc_alter_pk (a INTEGER, CONSTRAINT sc_alter_pk_key PRIMARY KEY (a));

# ddl_alter: ADD COLUMN
statement ok
ALTER TABLE sc_alter ADD COLUMN d INTEGER;

# ddl_alter: DROP COLUMN
statement ok
ALTER TABLE sc_alter DROP COLUMN d;

# ddl_alter: ADD CHECK
statement ok
ALTER TABLE sc_alter ADD CHECK (a > 0);

# ddl_alter: ADD CONSTRAINT
statement ok
ALTER TABLE sc_alter ADD CONSTRAINT sc_alter_chk CHECK (b > 0);

statement ok
ALTER TABLE sc_alter ADD CONSTRAINT sc_alter_uq UNIQUE (b);

# ddl_alter: ADD FOREIGN KEY
statement error
ALTER TABLE sc_alter ADD FOREIGN KEY (a) REFERENCES sc_alter_pk (a);
----
db error: ERROR: unsupported constraint type in ALTER TABLE statement


# ddl_alter: DROP CONSTRAINT
statement ok
ALTER TABLE sc_alter_pk DROP CONSTRAINT sc_alter_pk_key;

# ddl_alter: ALTER COLUMN
statement ok
ALTER TABLE sc_alter ALTER COLUMN a SET NOT NULL;

# ddl_alter: SET DEFAULT
statement ok
ALTER TABLE sc_alter ALTER COLUMN a SET DEFAULT 1;

# ddl_alter: DROP DEFAULT
statement ok
ALTER TABLE sc_alter ALTER COLUMN a DROP DEFAULT;

# ddl_alter: COLUMN TYPE
statement ok
ALTER TABLE sc_alter ALTER COLUMN c TYPE BIGINT;

statement error
ALTER TABLE sc_alter ALTER COLUMN a TYPE BIGINT;
----
db error: ERROR: Cannot change the type of a column that has a CHECK constraint specified


# --- Index access methods and expressions ---

statement ok
CREATE TABLE sc_idx_kinds (a INTEGER, b INTEGER, t TEXT);

# ddl_index: GIN
statement error
CREATE INDEX sc_idx_gin ON sc_idx_kinds USING gin (t);
----
db error: ERROR: Unknown index type: gin


# ddl_index: BRIN
statement error
CREATE INDEX sc_idx_brin ON sc_idx_kinds USING brin (a);
----
db error: ERROR: Unknown index type: brin


# ddl_index: Indexes on Expressions
statement ok
CREATE INDEX sc_idx_expr ON sc_idx_kinds ((a + b));

# ddl_index: Partial Indexes (a plain partial UNIQUE index keys every row)
statement ok
CREATE TABLE sc_idx_part_u (a INTEGER);

statement ok
CREATE UNIQUE INDEX sc_idx_part_u_idx ON sc_idx_part_u (a) WHERE a > 5;

statement error
INSERT INTO sc_idx_part_u VALUES (1), (1);
----
db error: ERROR: PRIMARY KEY or UNIQUE constraint violation: duplicate key "1, false"


# --- Data Manipulation ---

statement ok
CREATE TABLE sc_dml (a INTEGER, b INTEGER);

# dml: INSERT
statement ok
INSERT INTO sc_dml VALUES (1, 2);

# dml: UPDATE
statement ok
UPDATE sc_dml SET b = 3 WHERE a = 1;

# dml: DELETE
statement ok
DELETE FROM sc_dml WHERE a = 1;

# dml: RETURNING
statement ok
INSERT INTO sc_dml VALUES (5, 6) RETURNING a;

# dml: COPY TO
statement ok
COPY sc_dml TO '${__TEST_DIR__}/sc_dml_copy.csv';

# dml: COPY FROM
statement ok
COPY sc_dml FROM '${__TEST_DIR__}/sc_dml_copy.csv';

# dml: ON CONFLICT (syntax accepted)
statement ok
CREATE TABLE sc_oc (a INTEGER PRIMARY KEY, b INTEGER);

statement ok
INSERT INTO sc_oc VALUES (1, 1) ON CONFLICT (a) DO NOTHING;

# --- Text Search: SereneDB native full-text search (inverted index) ---

statement ok
CREATE TABLE sc_ts_t (id INTEGER, body TEXT);

statement ok
INSERT INTO sc_ts_t VALUES (1, 'a fat cat'), (2, 'a fat dog sat');

statement ok
CREATE TEXT SEARCH DICTIONARY sc_ts_en AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE INDEX sc_ts_idx ON sc_ts_t USING inverted(id, body sc_ts_en);

# op_tsearch: @@
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ ts_phrase('cat');

# op_tsearch: ||
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ (ts_phrase('cat') || ts_phrase('dog'));

# op_tsearch: &&
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ (ts_phrase('cat') && ts_phrase('fat'));

# op_tsearch: !!
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ (ts_phrase('cat') && !! ts_phrase('dog'));

# op_tsearch: plainto_tsquery
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ plainto_tsquery('cat');

# op_tsearch: phraseto_tsquery
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ phraseto_tsquery('fat cat');

# op_tsearch: websearch_to_tsquery
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ websearch_to_tsquery('cat');

# op_tsearch: to_tsquery
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ to_tsquery('cat');

# op_tsearch: tsquery_phrase
statement ok
SELECT id FROM sc_ts_idx WHERE body @@ tsquery_phrase(ts_phrase('fat'), ts_phrase('cat'));

# --- Re-verified: formerly crash-flagged (TRUNCATE, sequences) ---

# dml: TRUNCATE
statement ok
CREATE TABLE sc_trunc (a INTEGER);

statement ok
INSERT INTO sc_trunc VALUES (1), (2);

statement ok
TRUNCATE sc_trunc;

# op_seq_cond: CREATE SEQUENCE + nextval/setval/currval
statement ok
CREATE SEQUENCE sc_seq;

# op_seq_cond: nextval
statement ok
SELECT nextval('sc_seq');

# op_seq_cond: setval
statement ok
SELECT setval('sc_seq', 10);

# op_seq_cond: currval
statement ok
SELECT currval('sc_seq');
