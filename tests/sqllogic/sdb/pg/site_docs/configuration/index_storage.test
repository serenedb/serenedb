# DOCS_TEST: example_cache_settings

query
SELECT name
FROM duckdb_settings()
WHERE name IN ('enable_external_file_cache', 'external_file_cache_min_memory', 'external_file_cache_spill_size', 'memory_limit', 'max_temp_directory_size', 'temp_directory')
ORDER BY name;
----
name
enable_external_file_cache
external_file_cache_min_memory
external_file_cache_spill_size
max_temp_directory_size
memory_limit
temp_directory
