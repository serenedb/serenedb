# DOCS_TEST: view

# DOCS_TEST_RAW
#| CREATE VIEW tickets AS
#|     SELECT * FROM read_parquet('/data/tickets.parquet');
#|
#| SELECT priority, count(*) AS tickets
#| FROM tickets
#| GROUP BY priority
#| ORDER BY priority;

# DOCS_TEST_BODY

statement ok
CREATE VIEW tickets AS
    SELECT * FROM read_parquet('${__TEST_DIR__}/tickets.parquet');

query
SELECT priority, count(*) AS tickets
FROM tickets
GROUP BY priority
ORDER BY priority;
----
priority	tickets
high	2
low	2
medium	1

# DOCS_TEST: load_table

# DOCS_TEST_RAW
#| CREATE TABLE urgent_tickets AS
#|     SELECT * FROM '/data/tickets.parquet' WHERE priority = 'high';
#|
#| INSERT INTO urgent_tickets
#|     SELECT * FROM '/data/tickets.parquet' WHERE priority = 'medium';
#|
#| SELECT count(*) FROM urgent_tickets;

# DOCS_TEST_BODY

statement ok
CREATE TABLE urgent_tickets AS
    SELECT * FROM '${__TEST_DIR__}/tickets.parquet' WHERE priority = 'high';

statement ok
INSERT INTO urgent_tickets
    SELECT * FROM '${__TEST_DIR__}/tickets.parquet' WHERE priority = 'medium';

query
SELECT count(*) FROM urgent_tickets;
----
count
3

