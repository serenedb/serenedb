# DOCS_TEST: example_005

# DOCS_TEST_RAW
#| SELECT name, setting
#| FROM pg_config
#| WHERE name LIKE 'SERENEDB%'
#| ORDER BY name;
#| ----
#| name	setting
#| SERENEDB_COMMIT	3f9c2a7d41b0e8c56d2f1a9b7e4c3d2a1f0e9b8c
#| SERENEDB_VERSION	26.11.0

# DOCS_TEST_BODY

query
SELECT name, setting
FROM pg_config
WHERE name LIKE 'SERENEDB%'
ORDER BY name;
----
name	setting
SERENEDB_COMMIT	<slt:ignore>
SERENEDB_VERSION	<slt:ignore>

# DOCS_TEST: example_006

# DOCS_TEST_BODY

query
SELECT name, license, license_file
FROM serenedb_licenses
WHERE name IN ('DuckDB', 'Zstandard')
ORDER BY name;
----
name	license	license_file
DuckDB	MIT	third_party/duckdb/LICENSE
Zstandard	BSD-3-Clause OR GPL-2.0-only	third_party/zstd/LICENSE

