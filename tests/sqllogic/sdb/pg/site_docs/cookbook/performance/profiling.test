# DOCS_TEST: example_005

statement ok
CREATE TEXT SEARCH DICTIONARY profiling_words AS
    split_text(case := 'lower')
    WITH (frequency, position);

statement ok
CREATE TABLE articles (id INTEGER PRIMARY KEY, body VARCHAR, year INTEGER);

statement ok
INSERT INTO articles
SELECT i,
       CASE WHEN i % 7 = 0 THEN 'new york city'
            WHEN i % 5 = 0 THEN 'new york town'
            WHEN i % 3 = 0 THEN 'york city'
            ELSE 'other words here' END,
       2000 + i % 30
FROM range(0, 100000) t(i);

statement ok
CREATE INDEX articles_idx ON articles USING inverted (id, body profiling_words) INCLUDE (year);

