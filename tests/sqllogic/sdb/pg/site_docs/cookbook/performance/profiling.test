# DOCS_TEST_BODY

statement ok
EXPLAIN ANALYZE
SELECT id
FROM articles_idx
WHERE body @@ ts_phrase('new york') AND (body @@ 'city' OR body @@ 'town')
ORDER BY bm25(articles_idx.tableoid) DESC
LIMIT 10;
