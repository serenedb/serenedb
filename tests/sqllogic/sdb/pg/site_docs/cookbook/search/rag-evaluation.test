# DOCS_TEST: setup

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY en AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);

statement ok
CREATE TABLE chunks (id INTEGER PRIMARY KEY, body VARCHAR, emb FLOAT[3]);

statement ok
CREATE INDEX chunks_idx ON chunks
    USING inverted (id, body en, emb hnsw (metric = 'l2'));

statement ok
INSERT INTO chunks VALUES
(1, 'To reset your password, open Settings and choose Reset password.', [0.0, 1.0, 0.0]),
(2, 'Accounts lock after five failed sign-in attempts; an admin can unlock them.', [0.1, 0.9, 0.1]),
(3, 'Password rules: at least 12 characters, one number and one symbol.', [0.0, 0.8, 0.0]),
(4, 'Refunds for annual plans are prorated by the unused months.', [1.0, 0.0, 0.0]),
(5, 'Invoices are emailed on the first day of each billing cycle.', [0.9, 0.1, 0.0]),
(6, 'Cancel a subscription at any time; the plan stays active until the period ends.', [0.8, 0.0, 0.1]),
(7, 'Reports with many widgets can take a minute to load; narrow the date range.', [0.0, 0.1, 1.0]),
(8, 'Cache query results to make dashboards open faster.', [0.0, 0.0, 0.9]),
(9, 'Error E1042 means the API key has expired; create a new key.', [0.2, 0.6, 0.2]);

statement ok
CREATE TABLE queries (qid INTEGER PRIMARY KEY, text VARCHAR, emb FLOAT[3]);

statement ok
