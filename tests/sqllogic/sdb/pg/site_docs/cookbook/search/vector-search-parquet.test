# DOCS_TEST: glob_view

statement ok
COPY (SELECT * FROM '${__TEST_DIR__}/tickets.parquet' WHERE id <= 3)
TO '${__TEST_DIR__}/batch_1.parquet' (FORMAT parquet);

# DOCS_TEST_RAW
#| CREATE VIEW all_tickets AS
#|     SELECT id, body, emb::FLOAT[3] AS emb
#|     FROM read_parquet('s3://⟨my-bucket⟩/tickets/*.parquet');
#|
#| CREATE INDEX all_tickets_idx ON all_tickets
#|     USING inverted (id, body english_dict, emb ivf (metric = 'cosine'));

# DOCS_TEST_BODY

statement ok
CREATE VIEW all_tickets AS
    SELECT id, body, emb::FLOAT[3] AS emb
    FROM read_parquet('${__TEST_DIR__}/batch_*.parquet');

statement ok
CREATE INDEX all_tickets_idx ON all_tickets
    USING inverted (id, body english_dict, emb ivf (metric = 'cosine'));

# DOCS_TEST: reindex

statement ok
COPY (SELECT * FROM '${__TEST_DIR__}/tickets.parquet' WHERE id > 3)
TO '${__TEST_DIR__}/batch_2.parquet' (FORMAT parquet);

# DOCS_TEST_BODY

statement ok
REINDEX INDEX all_tickets_idx;

query
SELECT id
FROM all_tickets_idx
ORDER BY emb <=> [0.0, 0.0, 1.0]::FLOAT[3]
LIMIT 1;
