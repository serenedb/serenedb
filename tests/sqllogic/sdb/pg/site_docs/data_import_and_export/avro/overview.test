#| COPY fruit TO 'fruit_bzip2.avro' (CODEC 'bzip2');

# DOCS_TEST_BODY

statement error
COPY fruit TO '${__TEST_DIR__}/fruit_bzip2.avro' (CODEC 'bzip2');
