db error: ERROR: Unknown codec bzip2, the supported codecs are null, deflate, snappy and zstandard


# DOCS_TEST: name_error

# DOCS_TEST_RAW
#| COPY (SELECT 12 AS "unit price") TO 'prices.avro';

# DOCS_TEST_BODY

statement error
COPY (SELECT 12 AS "unit price") TO '${__TEST_DIR__}/prices.avro';
----
db error: ERROR: Invalid Avro identifier "unit price": field names have to match the regex [A-Za-z_][A-Za-z0-9_]*, or set SANITIZE_FIELD_NAMES


# DOCS_TEST: sanitize_field_names

# DOCS_TEST_RAW
#| COPY (SELECT 12 AS "unit price") TO 'prices.avro' (SANITIZE_FIELD_NAMES true);
#|
#| SELECT *
#| FROM read_avro('prices.avro');

# DOCS_TEST_BODY

statement ok
COPY (SELECT 12 AS "unit price") TO '${__TEST_DIR__}/prices.avro' (SANITIZE_FIELD_NAMES true);

query
SELECT *
FROM read_avro('${__TEST_DIR__}/prices.avro');
----
unit_x20price
12

# DOCS_TEST: field_ids

# DOCS_TEST_RAW
#| COPY (SELECT 1 AS id, 'gala' AS variety)
#|     TO 'ids.avro' (ROOT_NAME 'fruit', FIELD_IDS {id: {__duckdb_field_id: 1, __duckdb_nullable: false}, variety: 2});
#|
#| SELECT value AS schema
#| FROM avro_metadata('ids.avro')
#| WHERE key = 'avro.schema';

# DOCS_TEST_BODY

statement ok
COPY (SELECT 1 AS id, 'gala' AS variety)
    TO '${__TEST_DIR__}/ids.avro' (ROOT_NAME 'fruit', FIELD_IDS {id: {__duckdb_field_id: 1, __duckdb_nullable: false}, variety: 2});

query
SELECT value AS schema
FROM avro_metadata('${__TEST_DIR__}/ids.avro')
WHERE key = 'avro.schema';
----
schema
{"type":"record","name":"fruit","fields":[{"name":"id","type":"int","field-id":1},{"name":"variety","type":["null","string"],"field-id":2}]}

# DOCS_TEST: field_ids_null

# DOCS_TEST_RAW
#| COPY (SELECT NULL::INTEGER AS id)
#|     TO 'ids_null.avro' (FIELD_IDS {id: {__duckdb_field_id: 1, __duckdb_nullable: false}});

# DOCS_TEST_BODY

statement error
COPY (SELECT NULL::INTEGER AS id)
    TO '${__TEST_DIR__}/ids_null.avro' (FIELD_IDS {id: {__duckdb_field_id: 1, __duckdb_nullable: false}});
----
db error: ERROR: Cannot insert NULL to non-nullable field of type INTEGER


# DOCS_TEST: metadata

# DOCS_TEST_RAW
#| COPY fruit TO 'fruit_meta.avro' (METADATA {'source': 'orchard', 'season': 'autumn'});
#|
#| SELECT key, value
#| FROM avro_metadata('fruit_meta.avro')
#| WHERE key NOT LIKE 'avro.%'
#| ORDER BY key;

# DOCS_TEST_BODY

statement ok
COPY fruit TO '${__TEST_DIR__}/fruit_meta.avro' (METADATA {'source': 'orchard', 'season': 'autumn'});

query
SELECT key, value
FROM avro_metadata('${__TEST_DIR__}/fruit_meta.avro')
WHERE key NOT LIKE 'avro.%'
ORDER BY key;
----
key	value
season	autumn
source	orchard
