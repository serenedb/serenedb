# DOCS_TEST: example_021

statement ok
COPY (SELECT * FROM (VALUES
    ('apple', 50),
    ('banana', 150),
    ('cherry', 250)
) AS t("name", "price") ORDER BY price) TO '${__TEST_DIR__}/data_import_and_export_json_loading_json_example_021_1_prices_json.json' (FORMAT json);

# DOCS_TEST_RAW
#| EXPLAIN
#| SELECT name
#| FROM read_json('prices.json')
#| WHERE price > 100;

# DOCS_TEST_BODY

query
EXPLAIN
SELECT name
FROM read_json('${__TEST_DIR__}/data_import_and_export_json_loading_json_example_021_1_prices_json.json')
WHERE price > 100;
----
QUERY PLAN
╭─ READ_JSON ────────────────╮
│ Function: READ_JSON        │
│ Projections: name          │
│ Column Filter: price > 100 │
│ ~1 row                     │
╰────────────────────────────╯

# DOCS_TEST: example_022

statement ok
COPY (
    SELECT E'{"id": 1, "customer": {"name": "Ana", "city": "Paris"}}\n{"id": 2, "customer": {"name": "Ben", "city": "Rome"}}\n{"id": 3, "customer": {"name": "Eva", "city": "Paris"}}' AS line
) TO '${__TEST_DIR__}/data_import_and_export_json_loading_json_example_022_1_orders_json.json' (FORMAT csv, HEADER false, DELIMITER '|', QUOTE '');

# DOCS_TEST_RAW
#| SELECT id, customer.name AS name
#| FROM read_json('orders.json')
#| WHERE customer.city = 'Paris'
#| ORDER BY id;

# DOCS_TEST_BODY

query
SELECT id, customer.name AS name
FROM read_json('${__TEST_DIR__}/data_import_and_export_json_loading_json_example_022_1_orders_json.json')
WHERE customer.city = 'Paris'
ORDER BY id;
----
id	name
1	Ana
3	Eva

