control substitution on

# DOCS_TEST: example_001

statement ok
COPY (SELECT E'---\ntitle: Hello\nauthor: Ana\n---\n\n# Hello\n\nFirst post.') TO '${__TEST_DIR__}/data_import_and_export_markdown_overview_example_001_post.md' (FORMAT csv, HEADER false, QUOTE '');

# DOCS_TEST_RAW
#| SELECT metadata['title'] AS title, metadata['author'] AS author
#| FROM read_markdown('post.md');

# DOCS_TEST_BODY

query
SELECT metadata['title'] AS title, metadata['author'] AS author
FROM read_markdown('${__TEST_DIR__}/data_import_and_export_markdown_overview_example_001_post.md');
----
title	author
Hello	Ana

