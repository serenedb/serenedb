COPY (SELECT E'---\ntitle: Hello\nauthor: Ana\n---\n\n# Hello\n\nFirst post.') TO '${__TEST_DIR__}/data_import_and_export_markdown_overview_example_002_post.md' (FORMAT csv, HEADER false, QUOTE '');

