FROM otel_logs
WHERE body @@ phraseto_tsquery('downstream_remote_disconnect');
----
timestamp	severity_text	body
2026-09-08 12:00:10	ERROR	upstream reset: downstream_remote_disconnect

# DOCS_TEST: attribute_filter

# DOCS_TEST_BODY

query
SELECT "timestamp", severity_text, body
FROM otel_logs
WHERE (log_attributes ->> 'error.type') @@ 'downstream_remote_disconnect';
----
timestamp	severity_text	body
2026-09-08 12:00:10	ERROR	upstream reset: downstream_remote_disconnect

query
SELECT "timestamp", severity_text, body
FROM otel_logs
WHERE (log_attributes ->> 'error.type') @@ 'remote';
----
timestamp	severity_text	body
2026-09-08 12:00:13	WARN	remote peer closed the stream

# DOCS_TEST: attribute_counts

# DOCS_TEST_BODY

query
SELECT log_attributes ->> 'error.type' AS error_type, count(*) AS n
FROM otel_logs
WHERE log_attributes ->> 'error.type' IS NOT NULL
GROUP BY ALL
ORDER BY n DESC, error_type;
----
error_type	n
timeout	2
downstream_remote_disconnect	1
remote	1

# DOCS_TEST: body_compression

# DOCS_TEST_BODY

query
SELECT DISTINCT compression
FROM pragma_storage_info('otel_logs')
WHERE column_name = 'body';
----
compression
ZSTD

# DOCS_TEST_END

query
SELECT "timestamp"
FROM otel_logs
WHERE body @@ 'downstream_remote_disconnect'
ORDER BY "timestamp";
----
timestamp
2026-09-08 12:00:10
2026-09-08 12:00:13

statement error
SELECT unnest(ts_dict_agg((log_attributes ->> 'error.type'))) AS error_type
FROM otel_logs;
----
db error: ERROR: ts_dict_agg() argument must be an indexed column


include ../../otel/schema.inc

statement ok
INSERT INTO otel_logs ("timestamp", body) VALUES (now()::TIMESTAMP_NS, 'just now');

statement ok
VACUUM (REFRESH_TABLE) otel_logs;

# DOCS_TEST: retention

# DOCS_TEST_BODY

statement ok
CREATE JOB otel_logs_retention EVERY 1 HOUR AS
    DELETE FROM otel_logs
    WHERE "timestamp" @@ ts_lt(now()::TIMESTAMP_NS - INTERVAL '30 days');

statement ok
CREATE JOB otel_traces_retention EVERY 1 HOUR AS
    DELETE FROM otel_traces
    WHERE "timestamp" @@ ts_lt(now()::TIMESTAMP_NS - INTERVAL '30 days');

statement ok
CREATE JOB otel_metrics_sum_retention EVERY 1 HOUR AS
    DELETE FROM otel_metrics_sum
    WHERE "timestamp" @@ ts_lt(now()::TIMESTAMP_NS - INTERVAL '90 days');

# DOCS_TEST_END

statement ok
EXECUTE JOB otel_logs_retention;

statement ok
EXECUTE JOB otel_traces_retention;

statement ok
EXECUTE JOB otel_metrics_sum_retention;

statement ok
VACUUM (REFRESH_TABLE) otel_logs;

query
SELECT body FROM otel_logs ORDER BY body;
----
body
just now
