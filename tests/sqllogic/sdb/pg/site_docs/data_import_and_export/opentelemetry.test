statement ok
VACUUM (REFRESH_TABLE) otel_logs;

# DOCS_TEST: body_tokens

# DOCS_TEST_BODY

query
SELECT ts_lexize('otel_body_dict', 'upstream reset: downstream_remote_disconnect') AS shipped,
       ts_lexize('otel_words', 'upstream reset: downstream_remote_disconnect') AS split;
----
shipped	split
{upstream,reset,downstream_remote_disconnect}	{upstream,reset,downstream,remote,disconnect}

# DOCS_TEST: body_part

# DOCS_TEST_BODY

query
SELECT "timestamp", severity_text, body
FROM otel_logs
WHERE body @@ 'remote'
ORDER BY "timestamp";
----
timestamp	severity_text	body
2026-09-08 12:00:10	ERROR	upstream reset: downstream_remote_disconnect
2026-09-08 12:00:13	WARN	remote peer closed the stream

# DOCS_TEST: body_phrase

# DOCS_TEST_BODY

query
