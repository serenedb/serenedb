statement ok
SET ROLE doc_rls_alice;

query
EXPLAIN SELECT id FROM doc_rls_orders WHERE amount > 50;
----
QUERY PLAN
╭─ SEQ_SCAN ───────────────────────────────╮
│ Table: doc_rls_orders                    │
│ Type: Sequential Scan                    │
│ Projections: id                          │
│ Column Filter: tenant = 'doc_rls_alice', │
│                amount > 50               │
│ ~2 rows                                  │
╰──────────────────────────────────────────╯

