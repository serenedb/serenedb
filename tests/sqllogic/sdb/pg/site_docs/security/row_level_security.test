statement ok
CREATE VIEW doc_rls_large_orders AS SELECT id, tenant, amount FROM doc_rls_orders WHERE amount >= 100;

statement ok
GRANT SELECT ON doc_rls_large_orders TO doc_rls_alice;

statement ok
ALTER VIEW doc_rls_large_orders ENABLE ROW LEVEL SECURITY;

statement ok
CREATE POLICY doc_rls_large_tenant ON doc_rls_large_orders USING (tenant = current_user);

statement error
CREATE POLICY doc_rls_large_insert ON doc_rls_large_orders FOR INSERT WITH CHECK (amount > 0);
----
db error: ERROR: policies on views can only be created FOR SELECT or FOR ALL<slt:ignore>

statement ok
SET ROLE doc_rls_alice;

query
SELECT id, amount FROM doc_rls_large_orders ORDER BY id;
