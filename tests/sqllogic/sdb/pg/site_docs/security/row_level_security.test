# DOCS_TEST: example_001

statement ok
DROP TABLE IF EXISTS doc_rls_orders;

statement ok
DROP ROLE IF EXISTS doc_rls_alice;

statement ok
DROP ROLE IF EXISTS doc_rls_bob;

statement ok
DROP ROLE IF EXISTS doc_rls_auditor;

statement ok
CREATE ROLE doc_rls_alice;

statement ok
CREATE ROLE doc_rls_bob;

statement ok
CREATE TABLE doc_rls_orders (id int, tenant text, amount int, note text);

statement ok
INSERT INTO doc_rls_orders VALUES
  (1, 'doc_rls_alice', 100, 'first'),
  (2, 'doc_rls_bob', 250, 'second'),
  (3, 'doc_rls_alice', 75, 'third');

statement ok
GRANT SELECT, INSERT, UPDATE, DELETE ON doc_rls_orders TO doc_rls_alice;

statement ok
GRANT SELECT, INSERT, UPDATE, DELETE ON doc_rls_orders TO doc_rls_bob;

# DOCS_TEST_BODY

statement ok
