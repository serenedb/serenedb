# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
CREATE POLICY doc_rls_tenant ON doc_rls_orders USING (tenant = current_user);

statement ok
SET ROLE doc_rls_alice;

query
SELECT id, amount FROM doc_rls_orders ORDER BY id;
