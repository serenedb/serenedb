3	75

statement ok
RESET ROLE;

# DOCS_TEST: example_003

# DOCS_TEST_BODY

statement ok
CREATE POLICY doc_rls_small ON doc_rls_orders AS RESTRICTIVE USING (amount < 90);

statement ok
SET ROLE doc_rls_alice;

query
SELECT id, amount FROM doc_rls_orders ORDER BY id;
----
id	amount
3	75

statement ok
RESET ROLE;

statement ok
DROP POLICY doc_rls_small ON doc_rls_orders;

