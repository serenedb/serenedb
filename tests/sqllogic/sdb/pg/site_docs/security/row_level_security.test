RESET ROLE;

# DOCS_TEST: example_010

statement ok
DROP TABLE IF EXISTS doc_rls_totals;

statement ok
CREATE TABLE doc_rls_totals (id int PRIMARY KEY, tenant text, total int);

statement ok
INSERT INTO doc_rls_totals VALUES (1, 'doc_rls_alice', 0), (2, 'doc_rls_bob', 0);

statement ok
GRANT SELECT, INSERT, UPDATE ON doc_rls_totals TO doc_rls_alice;

statement ok
ALTER TABLE doc_rls_totals ENABLE ROW LEVEL SECURITY;

statement ok
CREATE POLICY doc_rls_totals_tenant ON doc_rls_totals USING (tenant = current_user);

# DOCS_TEST_BODY

statement ok
SET ROLE doc_rls_alice;

query
MERGE INTO doc_rls_totals t
USING (SELECT tenant, sum(amount) AS total FROM doc_rls_orders GROUP BY tenant) s ON t.tenant = s.tenant
WHEN MATCHED THEN UPDATE SET total = s.total
RETURNING t.id, t.total;
----
id	total
1	185

statement error
INSERT INTO doc_rls_totals VALUES (2, 'doc_rls_alice', 0) ON CONFLICT (id) DO UPDATE SET total = excluded.total;
----
db error: ERROR: target row violates row-level security policy for table "doc_rls_totals"


statement error
INSERT INTO doc_rls_totals VALUES (2, 'doc_rls_bob', 0) ON CONFLICT (id) DO NOTHING;
----
db error: ERROR: new row violates row-level security policy for table "doc_rls_totals"


statement ok
INSERT INTO doc_rls_totals VALUES (2, 'doc_rls_alice', 0) ON CONFLICT (id) DO NOTHING;

statement ok
RESET ROLE;

