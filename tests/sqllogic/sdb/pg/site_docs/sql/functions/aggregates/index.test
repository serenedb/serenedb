query
SELECT otel_histogram_fraction('-inf'::DOUBLE, 2, [10, 20, 10, 0], [1.0, 2.0, 4.0]) AS at_most_2,
       round(otel_histogram_stddev([10, 20, 10, 0], [1.0, 2.0, 4.0]), 6) AS stddev;
----
at_most_2	stddev
0.75	0.892679

# DOCS_TEST: exponential_histogram
# DOCS_TEST_BODY

query
SELECT round(otel_histogram_quantile(0.5, h), 6) AS p50,
       otel_histogram_fraction(0, 4, h) AS above_0_up_to_4
FROM (SELECT otel_exponential_histogram(0, 1, 0, [1, 2, 4], 1, [2]) AS h);
----
p50	above_0_up_to_4
2.828427	0.3

# DOCS_TEST: exponential_increase

statement ok
CREATE TABLE rpc (ts TIMESTAMP, scale INTEGER, zero_count BIGINT,
                  positive_offset INTEGER, positive_bucket_counts BIGINT[],
                  negative_offset INTEGER, negative_bucket_counts BIGINT[]);

statement ok
INSERT INTO rpc VALUES
    (TIMESTAMP '2026-01-01 00:00:00', 0, 1, 0, [1, 1], 0, []),
    (TIMESTAMP '2026-01-01 00:01:00', 0, 2, 0, [3, 1, 2], 0, []);

# DOCS_TEST_BODY

query
SELECT h.zero_count, h.positive_offset, h.positive_bucket_counts,
       round(otel_histogram_quantile(0.5, h), 6) AS p50
FROM (
    SELECT otel_increase(otel_exponential_histogram(scale, zero_count, positive_offset, positive_bucket_counts,
                                                    negative_offset, negative_bucket_counts), ts) AS h
    FROM rpc
)
GROUP BY ALL;
----
zero_count	positive_offset	positive_bucket_counts	p50
1	0	{2,0,2}	1.681793
