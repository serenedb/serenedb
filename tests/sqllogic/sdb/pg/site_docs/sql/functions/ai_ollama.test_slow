# DOCS_TEST: classify_descriptions

# DOCS_TEST_RAW
#| SELECT id, ai_classify(body, [{label: 'praise', description: 'the customer is satisfied'},
#|                               {label: 'complaint', description: 'the customer reports a problem'}],
#|                        secret_name := 'local_chat') AS kind
#| FROM reviews
#| ORDER BY id;
#| ----
#| id	kind
#| 1	praise
#| 2	complaint
#| 3	NULL
#| 4	praise

# DOCS_TEST_BODY

query
SELECT count(*) FILTER (WHERE k IN ('praise', 'complaint')) AS labelled
FROM (
    SELECT ai_classify(body, [{label: 'praise', description: 'the customer is satisfied'},
                              {label: 'complaint', description: 'the customer reports a problem'}],
                       secret_name := 'local_chat_${__DATABASE__}') AS k
    FROM reviews
    WHERE body IS NOT NULL
) t;
----
labelled
3

# DOCS_TEST: classify_labels

# DOCS_TEST_RAW
#| SELECT id, ai_classify_labels(body, ['price', 'quality', 'durability'],
#|                               secret_name := 'local_chat') AS topics
#| FROM reviews
#| ORDER BY id;
#| ----
#| id	topics
#| 1	{price,quality}
#| 2	{quality}
#| 3	NULL
#| 4	{quality}

# DOCS_TEST_BODY

query
SELECT count(*) FILTER (WHERE list_has_all(['price', 'quality', 'durability'], l)) AS valid
FROM (
    SELECT ai_classify_labels(body, ['price', 'quality', 'durability'],
                              secret_name := 'local_chat_${__DATABASE__}') AS l
    FROM reviews
    WHERE body IS NOT NULL
) t;
----
valid
3

# DOCS_TEST: score

# DOCS_TEST_RAW
#| SELECT id, ai_score(body, 'the review is positive about the product',
#|                     secret_name := 'local_chat') AS score
#| FROM reviews
#| ORDER BY id;
#| ----
#| id	score
#| 1	1
#| 2	0
#| 3	NULL
#| 4	1

# DOCS_TEST_BODY

query
SELECT count(*) FILTER (WHERE s BETWEEN 0 AND 1) AS scored,
       avg(s) FILTER (WHERE id <> 2) > 0.5 AS positive_high,
       max(s) FILTER (WHERE id = 2) < 0.5 AS negative_low
FROM (
    SELECT id, ai_score(body, 'the review is positive about the product',
                        secret_name := 'local_chat_${__DATABASE__}') AS s
    FROM reviews
    WHERE body IS NOT NULL
) t;
----
scored	positive_high	negative_low
3	t	t

# DOCS_TEST: rerank

# DOCS_TEST_RAW
#| SELECT id, body
#| FROM reviews
#| WHERE body IS NOT NULL
#| ORDER BY ai_rerank('product stopped working', body, secret_name := 'local_chat') DESC
#| LIMIT 2;

# DOCS_TEST_BODY

query
SELECT count(*) FILTER (WHERE r BETWEEN 0 AND 1) AS ranked
FROM (
    SELECT ai_rerank('product stopped working', body,
                     secret_name := 'local_chat_${__DATABASE__}') AS r
    FROM reviews
    WHERE body IS NOT NULL
) t;
----
ranked
3

