# DOCS_TEST: generate

# DOCS_TEST_RAW
#| SELECT ai_generate('What is 2 + 2? Reply with just the number.',
#|                    secret_name := 'local_chat') AS answer;
#| ----
#| answer
#| 4

# DOCS_TEST_BODY

query
SELECT ai_generate('What is 2 + 2? Reply with just the number.',
                   secret_name := 'local_chat_${__DATABASE__}') LIKE '%4%' AS answered;
----
answered
t

# DOCS_TEST: generate_system_prompt

# DOCS_TEST_RAW
#| SELECT ai_generate('Explain what a B-tree is.',
#|                    system_prompt := 'You are a database expert. Answer in one sentence.',
#|                    secret_name := 'local_chat') AS answer;

# DOCS_TEST_BODY

query
SELECT length(ai_generate('Explain what a B-tree is.',
                          system_prompt := 'You are a database expert. Answer in one sentence.',
                          secret_name := 'local_chat_${__DATABASE__}')) > 0 AS answered;
----
answered
t

statement ok
CREATE TABLE reviews (id INTEGER PRIMARY KEY, body VARCHAR);

statement ok
INSERT INTO reviews VALUES
    (1, 'Great value, works perfectly.'),
    (2, 'Broke after two days, terrible.'),
    (3, NULL),
    (4, 'Absolutely love it!');

# DOCS_TEST: classify

# DOCS_TEST_RAW
#| SELECT id, ai_classify(body, ['positive', 'negative', 'neutral'],
#|                        secret_name := 'local_chat') AS sentiment
#| FROM reviews
#| ORDER BY id;
#| ----
#| id	sentiment
#| 1	positive
#| 2	negative
#| 3	NULL
#| 4	positive

# DOCS_TEST_BODY

query
SELECT count(*) FILTER (WHERE s IN ('positive', 'negative', 'neutral')) AS labelled,
       count(*) FILTER (WHERE s IS NULL) AS unlabelled,
       count(*) FILTER (WHERE s = CASE id WHEN 2 THEN 'negative' ELSE 'positive' END) >= 2 AS mostly_right
FROM (
    SELECT id, ai_classify(body, ['positive', 'negative', 'neutral'],
                           secret_name := 'local_chat_${__DATABASE__}') AS s
    FROM reviews
    WHERE body IS NOT NULL
) t;
----
labelled	unlabelled	mostly_right
3	0	t

query
SELECT ai_classify(NULL, ['positive', 'negative'], secret_name := 'local_chat_${__DATABASE__}') IS NULL AS is_null;
----
is_null
t

# DOCS_TEST: extract

# DOCS_TEST_RAW
#| SELECT ai_extract('The package arrived late and was damaged.', 'the main complaint',
#|                   secret_name := 'local_chat') AS complaint;
#| ----
#| complaint
#| late

# DOCS_TEST_BODY

query
SELECT length(ai_extract('The package arrived late and was damaged.', 'the main complaint',
                         secret_name := 'local_chat_${__DATABASE__}')) > 0 AS extracted;
----
extracted
t

# DOCS_TEST: extract_schema

# DOCS_TEST_RAW
#| SELECT ai_extract('John Smith, 42, lives in Berlin.',
#|                   '{"name": "full name", "age": "age in years", "city": "city of residence"}',
#|                   secret_name := 'local_chat') AS person;
#| ----
#| person
#| {"name":"John Smith","age":"42","city":"Berlin"}

# DOCS_TEST_BODY

query
SELECT json_keys(p) AS keys, typeof(p) AS type,
       p->>'age' LIKE '%42%' AS age, p->>'city' ILIKE '%berlin%' AS city
FROM (
    SELECT ai_extract('John Smith, 42, lives in Berlin.',
                      '{"name": "full name", "age": "age in years", "city": "city of residence"}',
                      secret_name := 'local_chat_${__DATABASE__}') AS p
) t;
----
keys	type	age	city
{name,age,city}	JSON	t	t

# DOCS_TEST: filter

# DOCS_TEST_RAW
#| SELECT id, body
#| FROM reviews
#| WHERE ai_filter(body, 'the customer is unhappy', secret_name := 'local_chat');
#| ----
#| id	body
#| 2	Broke after two days, terrible.

# DOCS_TEST_BODY

query
SELECT count(*) FILTER (WHERE f IS NOT NULL) AS decided, count(*) FILTER (WHERE f IS NULL) AS skipped
FROM (
    SELECT ai_filter(body, 'the customer is unhappy', secret_name := 'local_chat_${__DATABASE__}') AS f
    FROM reviews
) t;
----
decided	skipped
3	1

