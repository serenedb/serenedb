control substitution on

# DOCS_TEST: example_001

# DOCS_TEST_BODY

query
SELECT strftime(DATE '1992-03-02', '%d/%m/%Y');
----
strftime
02/03/1992

# DOCS_TEST: example_002

# DOCS_TEST_BODY

query
SELECT strftime(TIMESTAMP '1992-03-02 20:32:45', '%A, %-d %B %Y - %I:%M:%S %p');
----
strftime
Monday, 2 March 1992 - 08:32:45 PM

# DOCS_TEST: example_003

# DOCS_TEST_BODY

query
SELECT strptime('02/03/1992', '%d/%m/%Y');
----
strptime
1992-03-02 00:00:00

# DOCS_TEST: example_004

# DOCS_TEST_BODY

query
SELECT strptime('Monday, 2 March 1992 - 08:32:45 PM', '%A, %-d %B %Y - %I:%M:%S %p');
----
strptime
1992-03-02 20:32:45

# DOCS_TEST: example_005

# DOCS_TEST_BODY

query error
SELECT strptime('02/50/1992', '%d/%m/%Y') AS x;
----
db error: ERROR: Could not parse string "02/50/1992" according to format specifier "%d/%m/%Y"
02/50/1992
   ^
Error: Month out of range, expected a value between 1 and 12


# DOCS_TEST: example_008

# DOCS_TEST_BODY

query
SELECT try_strptime('02/50/1992', '%d/%m/%Y') AS x;
----
x
NULL

# DOCS_TEST: example_006

statement ok
CREATE TABLE dates ("d" DATE, "ts" TIMESTAMP);

statement ok
COPY (SELECT * FROM (VALUES
    ('02/03/1992', 'Monday, 2 March 1992 - 08:32:45 PM')
) AS t("d", "ts")) TO '${__TEST_DIR__}/sql_functions_dateformat_example_006_1_test_csv.csv' (FORMAT CSV, HEADER false, DELIMITER ',');

statement ok
COPY dates FROM '${__TEST_DIR__}/sql_functions_dateformat_example_006_1_test_csv.csv' (DATEFORMAT '%d/%m/%Y', TIMESTAMPFORMAT '%A, %-d %B %Y - %I:%M:%S %p');

# DOCS_TEST_RAW
#| COPY dates FROM 'test.csv' (DATEFORMAT '%d/%m/%Y', TIMESTAMPFORMAT '%A, %-d %B %Y - %I:%M:%S %p');
#| SELECT * FROM dates;
#| ----
#| 1992-03-02	1992-03-02 20:32:45

# DOCS_TEST_BODY

query
SELECT * FROM dates;
----
d	ts
1992-03-02	1992-03-02 20:32:45

# DOCS_TEST: example_007

statement ok
COPY (SELECT * FROM (VALUES
    ('02/03/1992', 'Monday, 2 March 1992 - 08:32:45 PM')
) AS t("d", "ts")) TO '${__TEST_DIR__}/sql_functions_dateformat_example_007_1_test_csv.csv' (FORMAT CSV, HEADER true, DELIMITER ',');

# DOCS_TEST_RAW
#| SELECT *
#| FROM read_csv('test.csv', dateformat = '%m/%d/%Y', timestampformat = '%A, %-d %B %Y - %I:%M:%S %p');

# DOCS_TEST_BODY

query
SELECT *
FROM read_csv('${__TEST_DIR__}/sql_functions_dateformat_example_007_1_test_csv.csv', dateformat = '%m/%d/%Y', timestampformat = '%A, %-d %B %Y - %I:%M:%S %p');
----
d	ts
1992-02-03	1992-03-02 20:32:45

# DOCS_TEST: to_char_timestamp

# DOCS_TEST_BODY

query
SELECT to_char(TIMESTAMP '2024-03-05 14:07:09', 'FMDay, FMDD FMMonth YYYY, HH12:MI AM') AS result;
----
result
Tuesday, 5 March 2024, 02:07 PM

# DOCS_TEST: to_char_timestamptz

# DOCS_TEST_BODY

query
SELECT to_char(TIMESTAMPTZ '2024-03-05 14:07:09+00', 'YYYY-MM-DD HH24:MI:SS TZ OF') AS result;
----
result
2024-03-05 14:07:09 UTC +00

# DOCS_TEST: to_char_interval

# DOCS_TEST_BODY

query
SELECT to_char(INTERVAL '1 day 02:03:04', 'DD "days" HH24:MI:SS') AS result;
----
result
01 days 02:03:04

# DOCS_TEST: to_date

# DOCS_TEST_BODY

query
SELECT to_date('05 Mar 2024', 'DD Mon YYYY') AS result;
----
result
2024-03-05

# DOCS_TEST: to_timestamp

# DOCS_TEST_BODY

query
SELECT to_timestamp('2024-03-05 02:07:09 PM +02', 'YYYY-MM-DD HH12:MI:SS AM TZH') AS result;
----
result
2024-03-05 12:07:09+00

# DOCS_TEST: to_date_out_of_range

# DOCS_TEST_BODY

query error
SELECT to_date('2024-13-05', 'YYYY-MM-DD');
----
db error: ERROR: date/time field value out of range: "2024-13-05"
