query
SELECT (2).ifnull(0);
----
coalesce
2


# DOCS_TEST: example_008

# DOCS_TEST_BODY

query
SELECT DISTINCT ON(function_name)
    function_name,
    function_type,
    return_type,
    parameter_types
FROM sdb_functions()
WHERE function_type = 'scalar'
  AND function_name LIKE 'b%'
ORDER BY function_name;
----
function_name	function_type	return_type	parameter_types
bar	scalar	VARCHAR	{DOUBLE,DOUBLE,DOUBLE,DOUBLE}
base64	scalar	VARCHAR	{BLOB}
bin	scalar	VARCHAR	{VARCHAR}
binom	scalar	HUGEINT	{INTEGER,INTEGER}
bit_count	scalar	TINYINT	{TINYINT}
bit_length	scalar	BIGINT	{VARCHAR}
bit_position	scalar	INTEGER	{BIT,BIT}
bitstring	scalar	BIT	{VARCHAR,INTEGER}
bitstring_byte_comparable	scalar	BLOB	{BIT}
bm25	scalar	FLOAT	{BIGINT}
bound_box	scalar	box	{box,box}
box	scalar	box	{point}
box_above	scalar	BOOLEAN	{box,box}
box_above_eq	scalar	BOOLEAN	{box,box}
box_add	scalar	box	{box,point}
box_below	scalar	BOOLEAN	{box,box}
box_below_eq	scalar	BOOLEAN	{box,box}
box_center	scalar	point	{box}
box_contain	scalar	BOOLEAN	{box,box}
box_contain_pt	scalar	BOOLEAN	{box,point}
box_contained	scalar	BOOLEAN	{box,box}
box_distance	scalar	DOUBLE	{box,box}
box_div	scalar	box	{box,point}
box_eq	scalar	BOOLEAN	{box,box}
box_ge	scalar	BOOLEAN	{box,box}
box_gt	scalar	BOOLEAN	{box,box}
box_intersect	scalar	box	{box,box}
box_le	scalar	BOOLEAN	{box,box}
box_left	scalar	BOOLEAN	{box,box}
box_lt	scalar	BOOLEAN	{box,box}
box_mul	scalar	box	{box,point}
box_overabove	scalar	BOOLEAN	{box,box}
box_overbelow	scalar	BOOLEAN	{box,box}
box_overlap	scalar	BOOLEAN	{box,box}
box_overleft	scalar	BOOLEAN	{box,box}
box_overright	scalar	BOOLEAN	{box,box}
box_right	scalar	BOOLEAN	{box,box}
box_same	scalar	BOOLEAN	{box,box}
box_sub	scalar	box	{box,point}
broadcast	scalar	INET	{INET}
btrim	scalar	VARCHAR	{VARCHAR}
