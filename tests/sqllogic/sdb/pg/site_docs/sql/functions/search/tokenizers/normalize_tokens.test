# DOCS_TEST: example_001

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY norm_dict AS
    normalize_tokens('en_US.UTF-8', case := 'lower', accent := false);

query
SELECT ts_lexize('norm_dict', 'CAFÉ');
----
ts_lexize
{cafe}

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY norm_upper AS
    normalize_tokens('en_US.UTF-8', case := 'upper', accent := true);

query
SELECT ts_lexize('norm_upper', 'café');
----
ts_lexize
{CAFÉ}

# DOCS_TEST: function_form

# DOCS_TEST_BODY

query
SELECT normalize_tokens(['Café', 'ÉCOLE'], 'en_US.UTF-8', case := 'lower', accent := false) AS tokens;
----
tokens
{cafe,ecole}

# DOCS_TEST: fold

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY norm_fold AS
    normalize_tokens(case := 'fold');

query
SELECT ts_lexize('norm_fold', 'STRASSE') = ts_lexize('norm_fold', 'Straße') AS same;
----
same
t

query
SELECT ts_lexize('norm_fold', 'Straße');
----
ts_lexize
{strasse}

# DOCS_TEST: nfkc_cf

# DOCS_TEST_BODY

query
SELECT normalize_tokens(['ＦＵＬＬ Straße ﬁ', '①'], form := 'nfkc_cf') AS tokens;
----
tokens
{"full strasse fi",1}
