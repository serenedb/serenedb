statement ok
CREATE TEXT SEARCH DICTIONARY multi_delim AS
    split_by_delimiters([':', ';', ' ', '.', '|']);

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY tok_multi_delim AS
    split_by_delimiters([':', ';', ' ']);

query
SELECT ts_lexize('tok_multi_delim', 'key:value; key2:value2');
----
ts_lexize
{key,value,key2,value2}

