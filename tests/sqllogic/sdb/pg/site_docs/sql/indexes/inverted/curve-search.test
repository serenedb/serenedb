control substitution on

# DOCS_TEST: points

# DOCS_TEST_BODY

statement ok
CREATE TABLE measurements(id INTEGER PRIMARY KEY, x BIGINT, y DOUBLE);

statement ok
INSERT INTO measurements VALUES (1, 5, 10), (2, 50, 100);

statement ok
CREATE INDEX measurements_xy ON measurements USING inverted(
  id, (curve(x, y))) INCLUDE (x, y);

statement ok
VACUUM (REFRESH_TABLE) measurements;

query
SELECT id FROM measurements_xy
WHERE curve(x, y) @@ ts_between(ROW(0, 0), ROW(10, 20), true, true);
----
id
1

query
SELECT id FROM measurements_xy
WHERE x BETWEEN 0 AND 10 AND y BETWEEN 0 AND 20;
----
id
1

# DOCS_TEST: shapes

# DOCS_TEST_BODY

statement ok
CREATE TABLE floorplan(id INTEGER PRIMARY KEY, shape GEOMETRY('SDB:CARTESIAN'));

statement ok
INSERT INTO floorplan VALUES (1, 'POLYGON((0 0,0 10,10 10,10 0,0 0))');

statement ok
CREATE INDEX floorplan_xy ON floorplan USING inverted(
  id, shape cartesian(max_cells=64, max_level=64));

statement ok
VACUUM (REFRESH_TABLE) floorplan;

query
SELECT id FROM floorplan_xy
WHERE ST_Intersects(shape, 'POINT(5 5)'::GEOMETRY('SDB:CARTESIAN'));
----
id
1

# DOCS_TEST_END

statement ok
DROP TABLE measurements;

statement ok
DROP TABLE floorplan;

# DOCS_TEST: normalized

# DOCS_TEST_BODY

statement ok
CREATE TABLE sensors(id INTEGER PRIMARY KEY, channel INTEGER, reading DOUBLE);

statement ok
INSERT INTO sensors VALUES (1, 3, 1000.25), (2, 40, 1000.75), (3, 7, 1001.5);

statement ok
CREATE INDEX sensors_curve ON sensors USING inverted(id,
  (curve(channel, reading, lower := ROW(0, 1000), upper := ROW(64, 1001)))) INCLUDE (channel, reading);

statement ok
VACUUM (REFRESH_TABLE) sensors;

query
SELECT id FROM sensors_curve
WHERE curve(channel, reading, lower := ROW(0, 1000), upper := ROW(64, 1001))
  @@ ts_between(ROW(0, 1000), ROW(10, 2000), true, true)
ORDER BY id;
----
id
1
3

# DOCS_TEST_END

statement ok
DROP TABLE sensors;
