# DOCS_TEST: example_001

statement ok
CREATE TEXT SEARCH DICTIONARY logs_en AS
    split_text(case := 'lower') | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency);

statement ok
CREATE TABLE my_logs (id INTEGER PRIMARY KEY, msg VARCHAR);

statement ok
CREATE INDEX logs_idx ON my_logs USING inverted (id, msg logs_en);

statement ok
INSERT INTO my_logs VALUES (1, 'disk full'), (2, 'connection reset');

# DOCS_TEST_BODY

statement ok
VACUUM (REFRESH_TABLE) my_logs;

query
SELECT id FROM logs_idx WHERE msg @@ 'disk' ORDER BY id;
----
id
1

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
VACUUM (COMPACT_TABLE) my_logs;

# DOCS_TEST: example_003

# DOCS_TEST_BODY

statement ok
VACUUM (RECOMPUTE_STATS_TABLE) my_logs;

# DOCS_TEST: example_004

# DOCS_TEST_BODY

query
SELECT index_name, table_name
FROM sdb_indexes()
WHERE table_name = 'my_logs';
----
index_name	table_name
logs_idx	my_logs

# DOCS_TEST: example_005

# DOCS_TEST_BODY

query
SELECT indexname
FROM pg_indexes
WHERE tablename = 'my_logs'
ORDER BY indexname;
----
indexname
logs_idx
my_logs_pkey

# DOCS_TEST: example_006

statement ok
CREATE TABLE my_events (id INTEGER PRIMARY KEY, msg VARCHAR) WITH (storage = 'search');

# DOCS_TEST_BODY

statement ok
ALTER INDEX logs_idx SET (compaction_interval = 0);

statement ok
ALTER TABLE my_events SET (compaction_interval = 0);

statement ok
VACUUM (COMPACT_TABLE) my_events;

statement ok
ALTER TABLE my_events RESET (compaction_interval);

statement ok
ALTER INDEX logs_idx RESET (compaction_interval);

# DOCS_TEST: example_007

statement ok
CREATE TABLE my_metrics (id INTEGER PRIMARY KEY, msg VARCHAR)
WITH (storage = 'search', compaction_interval = 0);

statement ok
INSERT INTO my_metrics VALUES (1, 'cpu high');

statement ok
VACUUM (REFRESH_TABLE) my_metrics;

statement ok
INSERT INTO my_metrics VALUES (2, 'disk low');

statement ok
VACUUM (REFRESH_TABLE) my_metrics;

# DOCS_TEST_BODY

query
SELECT count(*) AS segments, sum(docs) AS docs FROM sdb_segments('my_metrics');
----
segments	docs
2	2

query
EXPLAIN CALL sdb_compact('my_metrics', mode := 'compact', target_segments := 1);
----
QUERY PLAN
╭─ SEGMENT_REWRITE ─────────────────────╮
│ Table: public.my_metrics              │
│ Mode: compact                         │
│ Segments: 2                           │
│ Merges: 1                             │
│ Merge 1:                              │
│ 2 segments -> 1, compact to 1 segment │
│ Merge 1 Inputs: _1, _2                │
│ Merge 1 Docs: 2 (2 live), rowid 1..2  │
│ Merge 1 Bytes:                        │
│ <slt:ignore> -> est <slt:ignore>│
│ Merge 1 Columns:                      │
│ 3, <slt:ignore>, largest msg <slt:ignore>│
│ Merge 1 Postings: 1 field             │
╰───────────────────────────────────────╯

query
SELECT outcome, input_docs, output_docs
FROM sdb_compact('my_metrics', mode := 'compact', target_segments := 1);
----
outcome	input_docs	output_docs
merged	2	2

query
SELECT type, origin, outcome, input_docs, output_docs
FROM sdb_compact_history
WHERE relation_id = (SELECT oid FROM pg_class WHERE relname = 'my_metrics')
ORDER BY id;
----
type	origin	outcome	input_docs	output_docs
flush	NULL	NULL	NULL	1
flush	NULL	NULL	NULL	1
merge	sql	merged	2	2
