# DOCS_TEST: example_007

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY ta_pipeline AS
    split_csv(',') | normalize_tokens('en_US.UTF-8', case := 'lower');

query
SELECT ts_lexize('ta_pipeline', 'RED,Green,BLUE');
----
ts_lexize
{red,green,blue}
