# DOCS_TEST: example_010

statement ok
CREATE TABLE doc (id INTEGER PRIMARY KEY, emb FLOAT[2]);

statement ok
CREATE INDEX doc_idx ON doc
    USING inverted(id, emb hnsw (metric = 'l2', quant = 'none'));

statement ok
INSERT INTO doc VALUES (1, [0, 0]), (2, [1, 1]), (3, [5, 5]);

statement ok
VACUUM (REFRESH_TABLE) doc;

# DOCS_TEST_BODY

statement ok
PREPARE nearest AS
    SELECT id
    FROM doc_idx
    ORDER BY emb <-> $1::FLOAT[2]
    LIMIT $2::INTEGER;

query
EXECUTE nearest([1, 1]::FLOAT[2], 2);
----
id
2
1

