# DOCS_TEST_RAW
#| ATTACH 'file.db' (READ_ONLY);

# DOCS_TEST_BODY

# Re-attaching a just-detached file in a DIFFERENT access mode is refused while
# the old attachment object is still alive: any in-flight statement on another
# connection that listed all catalogs (Catalog::GetAllSchemas) pins every
# attachment for that statement's duration, and the pinned READ_WRITE object
# keeps the file open, so the engine hands it back and refuses the mode change
# ("already attached in READ_WRITE mode"). On a shared server the doc example's
# claim is "can be attached read-only", not "instantly", so retry until the
# concurrent readers drain.
statement ok retry 40 backoff 250ms
ATTACH '${__TEST_DIR__}/db17_${__DATABASE__}.db' AS db16_${__DATABASE__} (READ_ONLY);

statement ok
DETACH db16_${__DATABASE__};

