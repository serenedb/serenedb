#| SELECT rtrim(content, chr(10)) AS content
#| FROM read_text('rendered.csv');
#|
#| CREATE TABLE rendered (id INTEGER, l INTEGER[], b BOOLEAN);
#|
#| COPY rendered FROM 'rendered.csv' (FORMAT csv, RENDERING duckdb);
#|
#| SELECT *
#| FROM rendered;

# DOCS_TEST_BODY

statement ok
COPY (SELECT 1 AS id, ARRAY[1, 2] AS l, true AS b) TO '${__TEST_DIR__}/copy_index_rendered.csv' (FORMAT csv, RENDERING duckdb);

query
SELECT rtrim(content, chr(10)) AS content
FROM read_text('${__TEST_DIR__}/copy_index_rendered.csv');
----
content
1,"[1, 2]",true

statement ok
CREATE TABLE rendered (id INTEGER, l INTEGER[], b BOOLEAN);

statement ok
COPY rendered FROM '${__TEST_DIR__}/copy_index_rendered.csv' (FORMAT csv, RENDERING duckdb);

query
SELECT *
FROM rendered;
----
id	l	b
1	{1,2}	t
