# DOCS_TEST: value_error

statement ok
CREATE TABLE readings (sensor INTEGER, reading DOUBLE);

statement ok
COPY (
    SELECT sensor, reading
    FROM (VALUES (1, '1', '20.5'), (2, 'x', '21.0'), (3, '3', 'abc'), (4, '4', '19.75')) AS t(n, sensor, reading)
    ORDER BY n
) TO '${__TEST_DIR__}/copy_index_readings.csv' (FORMAT csv);

# DOCS_TEST_RAW
#| COPY readings FROM 'readings.csv' (FORMAT csv);

# DOCS_TEST_BODY

statement error
COPY readings FROM '${__TEST_DIR__}/copy_index_readings.csv' (FORMAT csv);
----
db error: ERROR: invalid input syntax for type integer: "x"


