# DOCS_TEST: csv_nulls

statement ok
COPY (
    SELECT content
    FROM (VALUES (1, '1,,'), (2, '2,"",'), (3, '3,N,"N"')) AS t(n, content)
    ORDER BY n
) TO '${__TEST_DIR__}/copy_index_notes.csv' (FORMAT text);

# DOCS_TEST_RAW
#| CREATE TABLE notes (id INTEGER, title TEXT, body TEXT);
#|
#| COPY notes FROM 'notes.csv' (FORMAT csv);
#|
#| SELECT id, title, title IS NULL AS title_is_null, body, body IS NULL AS body_is_null
#| FROM notes
#| ORDER BY id;

# DOCS_TEST_BODY

statement ok
CREATE TABLE notes (id INTEGER, title TEXT, body TEXT);

statement ok
COPY notes FROM '${__TEST_DIR__}/copy_index_notes.csv' (FORMAT csv);

query
SELECT id, title, title IS NULL AS title_is_null, body, body IS NULL AS body_is_null
FROM notes
ORDER BY id;
----
id	title	title_is_null	body	body_is_null
1	NULL	t	NULL	t
2	(empty)	f	NULL	t
3	N	f	N	f

# DOCS_TEST: csv_force_null

statement ok
TRUNCATE notes;

# DOCS_TEST_RAW
#| COPY notes FROM 'notes.csv' (FORMAT csv, NULL 'N', FORCE_NOT_NULL (title), FORCE_NULL (body));
#|
#| SELECT id, title, title IS NULL AS title_is_null, body, body IS NULL AS body_is_null
#| FROM notes
#| ORDER BY id;

# DOCS_TEST_BODY

statement ok
COPY notes FROM '${__TEST_DIR__}/copy_index_notes.csv' (FORMAT csv, NULL 'N', FORCE_NOT_NULL (title), FORCE_NULL (body));

query
SELECT id, title, title IS NULL AS title_is_null, body, body IS NULL AS body_is_null
FROM notes
ORDER BY id;
----
id	title	title_is_null	body	body_is_null
1	(empty)	f	(empty)	f
2	(empty)	f	(empty)	f
3	N	f	NULL	t

# DOCS_TEST: default_marker

statement ok
COPY (
    SELECT content
    FROM (VALUES (1, '1,shipped,5'), (2, '2,default,default'), (3, '3,"default",2')) AS t(n, content)
    ORDER BY n
) TO '${__TEST_DIR__}/copy_index_orders.csv' (FORMAT text);

# DOCS_TEST_RAW
#| CREATE TABLE orders (id INTEGER, status TEXT DEFAULT 'new', quantity INTEGER DEFAULT 1);
#|
#| COPY orders FROM 'orders.csv' (FORMAT csv, DEFAULT 'default');
#|
#| SELECT *
#| FROM orders
#| ORDER BY id;

# DOCS_TEST_BODY

statement ok
CREATE TABLE orders (id INTEGER, status TEXT DEFAULT 'new', quantity INTEGER DEFAULT 1);

statement ok
COPY orders FROM '${__TEST_DIR__}/copy_index_orders.csv' (FORMAT csv, DEFAULT 'default');

query
SELECT *
FROM orders
ORDER BY id;
----
id	status	quantity
1	shipped	5
2	new	1
3	default	2

