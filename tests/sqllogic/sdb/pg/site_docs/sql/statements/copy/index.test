CREATE TABLE cities (name TEXT, population INTEGER);

statement ok
COPY (SELECT 'Berlin' AS name, 3850809 AS population) TO '${__TEST_DIR__}/copy_index_cities.csv' (FORMAT csv, HEADER);

statement ok
COPY cities FROM '${__TEST_DIR__}/copy_index_cities.csv' (FORMAT csv, HEADER MATCH);

