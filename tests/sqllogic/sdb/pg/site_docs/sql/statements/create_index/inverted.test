# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY lower_words AS split_text(case := 'lower');

statement ok
CREATE OR REPLACE INDEX products_idx ON products USING inverted (id, name lower_words);

query
SELECT id, name FROM products_idx WHERE name @@ 'trail' ORDER BY id;
