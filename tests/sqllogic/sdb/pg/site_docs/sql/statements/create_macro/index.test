1	#1
2	#2

# DOCS_TEST: example_039

# DOCS_TEST_BODY

statement ok
CREATE FUNCTION split_name(full_name text, OUT first_name text, OUT last_name text) LANGUAGE sql AS $$SELECT split_part(full_name, ' ', 1), split_part(full_name, ' ', 2)$$;

query
SELECT * FROM split_name('Ada Lovelace');
----
first_name	last_name
Ada	Lovelace

query
SELECT split_name('Ada Lovelace') AS name;
----
name
(Ada,Lovelace)

