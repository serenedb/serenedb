# DOCS_TEST: example_031

# DOCS_TEST_BODY

statement ok
CREATE OR REPLACE FUNCTION fibo(n) AS (SELECT 1);

statement ok
CREATE OR REPLACE FUNCTION fibo(n) AS (
    CASE
        WHEN n <= 1 THEN 1
        ELSE fibo(n - 1)
    END
);

query error
SELECT fibo(3);
----
db error: ERROR: stack depth limit exceeded


