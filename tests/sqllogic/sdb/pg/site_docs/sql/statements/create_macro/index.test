statement ok
CREATE TABLE menu (item text, price int);

statement ok
INSERT INTO menu VALUES ('tea', 3), ('cake', 5), ('pie', 4);

statement ok
CREATE FUNCTION cheaper_than(price int) RETURNS SETOF text LANGUAGE sql AS 'SELECT item FROM menu WHERE price < cheaper_than.price ORDER BY item';

query
SELECT * FROM cheaper_than(5);
----
cheaper_than
pie
tea

