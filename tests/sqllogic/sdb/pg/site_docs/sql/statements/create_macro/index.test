# DOCS_TEST: example_038

# DOCS_TEST_BODY

statement ok
CREATE FUNCTION numbered(n int) RETURNS TABLE (i int, label text) LANGUAGE sql AS 'SELECT g, ''#'' || g FROM generate_series(1, n) g';

query
