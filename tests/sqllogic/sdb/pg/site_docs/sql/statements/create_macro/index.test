# DOCS_TEST_BODY

statement ok
CREATE FUNCTION count_below(n bigint) RETURNS bigint LANGUAGE sql AS 'SELECT count(*) * 100 + sum(n) + n FROM generate_series(1, 10) g WHERE g < n';

query
SELECT count_below(4) AS result;
----
result
316

# DOCS_TEST: example_041

# DOCS_TEST_BODY

statement ok
CREATE MACRO doubled_if_positive(d, x) AS CASE WHEN d > 0 THEN x + x END;

query
SELECT
    d,
    doubled_if_positive(d, 10 / d) AS result
FROM (VALUES (0), (2), (5)) t(d)
ORDER BY d;
----
d	result
0	NULL
2	10
5	4

