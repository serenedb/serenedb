# DOCS_TEST: example_001

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY geojson_shape (
    template = 'geojson'
);

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY geojson_s2 (
    template = 'geojson',
    coding = 's2point'
);

# DOCS_TEST: example_003

# DOCS_TEST_BODY

query
SELECT hex(cell) AS cell
FROM unnest(ts_lexize(
    'geojson_s2',
    '{"type":"Point","coordinates":[13.405,52.52]}'
)) AS cell;
