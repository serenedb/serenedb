# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY geopoint_dict (
    template = 'geopoint',
    latitude = 'lat',
    longitude = 'lng'
);

# DOCS_TEST: example_002

# DOCS_TEST_BODY

query
SELECT hex(cell) AS cell
FROM unnest(ts_lexize(
    'geopoint_dict',
    '{"lat":52.52,"lng":13.405}'
)) AS cell;
