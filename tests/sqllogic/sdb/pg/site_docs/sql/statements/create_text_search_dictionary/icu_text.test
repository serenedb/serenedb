# DOCS_TEST: example_001

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY icu_words (
    template = 'icu_text',
    locale = 'en_US.UTF-8'
);

query
SELECT ts_lexize('icu_words', '中文测试 hello');
----
ts_lexize
{中文,测试,hello}

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY icu_sentences (
    template = 'icu_text',
    locale = 'en_US.UTF-8',
    BREAK = 'sentence'
);

query
SELECT ts_lexize('icu_sentences', 'Hello world. Second sentence!');
----
ts_lexize
{"Hello world.","Second sentence!"}
