# DOCS_TEST: example_001

statement ok
CREATE TABLE documents (
    id INTEGER PRIMARY KEY,
    title VARCHAR,
    body VARCHAR
);

statement ok
INSERT INTO documents VALUES
    (1, 'Intro to Search', 'A practical guide to searching and ranking documents.'),
    (2, 'Scaling Analytics', 'Processing billions of rows with fast running queries.');

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY english_dict AS
    split_text(case := 'lower') | stem_words('en_US.UTF-8')
    WITH (frequency, position);

statement ok
CREATE INDEX idx_docs ON documents
    USING inverted (id, title english_dict, body english_dict);

# DOCS_TEST: example_002

statement ok
VACUUM (REFRESH_TABLE) documents;

# DOCS_TEST_BODY

query
SELECT id FROM idx_docs WHERE body @@ 'searching';
----
id
1

# DOCS_TEST: example_003

# DOCS_TEST_BODY

query
SELECT ts_lexize('english_dict', 'running engines');
----
ts_lexize
{run,engin}

# DOCS_TEST: example_004

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY english_expr AS
    split_csv(',') | split_text(case := 'lower') | stem_words('en_US.UTF-8') | remove_stopwords(['the'])
    WITH (frequency, position);

query
SELECT ts_lexize('english_expr', 'The,Quick,Foxes');
----
ts_lexize
{quick,fox}

# DOCS_TEST: example_005

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY split_stem AS
    string_split(lower($1), ',') | stem_words('en_US.UTF-8');

query
SELECT ts_lexize('split_stem', 'Cats,RUNNING');
----
ts_lexize
{cat,run}

# DOCS_TEST: example_006

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY exact_and_grams AS [keyword(), generate_ngrams(2, 2)] WITH (frequency);

query
SELECT ts_lexize('exact_and_grams', 'abcd');
----
ts_lexize
{abcd,ab,bc,cd}

# DOCS_TEST: example_007

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY english_no_run AS english_dict | remove_stopwords(['run']);

query
SELECT ts_lexize('english_no_run', 'running engines');
----
ts_lexize
{engin}
