ts_lexize
{red,green,blue}

# DOCS_TEST: example_008

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY pipe_expr_long AS
    normalize_tokens(case := 'lower') | split_csv('|') | normalize_tokens(case := 'upper') | remove_stopwords(['A']);

query
SELECT ts_lexize('pipe_expr_long', 'a|B|c');
----
ts_lexize
{B,C}
