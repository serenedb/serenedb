# DOCS_TEST: example_001

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY sql_words AS
    regexp_split_to_array(lower($1), '\W+');

query
SELECT ts_lexize('sql_words', 'Hello, World! FOO bar');
----
ts_lexize
{hello,world,foo,bar}

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY sql_norm AS
    upper(trim($1));

query
SELECT ts_lexize('sql_norm', '  hello  ');
----
ts_lexize
{HELLO}

# DOCS_TEST: example_003

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY sql_pipe AS
    string_split(lower($1), ' ') | remove_stopwords(['the']);

query
SELECT ts_lexize('sql_pipe', 'The Quick Fox');
----
ts_lexize
{quick,fox}

# DOCS_TEST_END

# a stored sql dictionary as a stage keeps its expression

statement ok
CREATE TEXT SEARCH DICTIONARY sql_copy AS
    sql_words;

query
SELECT ts_lexize('sql_copy', 'A-B c');
----
ts_lexize
{a,b,c}

# NULL result rejects the value (ts_lexize surfaces rejection as an error)

statement ok
CREATE TEXT SEARCH DICTIONARY sql_nullif AS
    nullif(lower($1), 'skip');

query
SELECT ts_lexize('sql_nullif', 'keep');
----
ts_lexize
{keep}

statement error error while preparing tokenizer
SELECT ts_lexize('sql_nullif', 'SKIP');

# A sql tokenizer expression may not call text-search functions: they would
# re-enter the tokenizer machinery (unbounded recursion when self-referencing).

statement error is not allowed in a sql tokenizer expression
CREATE TEXT SEARCH DICTIONARY sql_recurse AS
    ts_lexize('sql_recurse', $1);

statement ok
DROP TEXT SEARCH DICTIONARY sql_nullif;

