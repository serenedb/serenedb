# DOCS_TEST: example_001

# DOCS_TEST_BODY

statement ok
-- member 1 keeps the value verbatim, member 2 emits 2-grams
CREATE TEXT SEARCH DICTIONARY union_dict AS
    [keyword(), generate_ngrams(2, 2)];

query
SELECT ts_lexize('union_dict', 'abcd');
----
ts_lexize
{abcd,ab,bc,cd}

# DOCS_TEST: example_002

# DOCS_TEST_BODY

statement ok
-- member 1 splits into words, member 2 keeps the whole phrase
CREATE TEXT SEARCH DICTIONARY union_word_phrase AS
    [split_csv(' '), keyword()];

query
SELECT ts_lexize('union_word_phrase', 'hello world');
----
ts_lexize
{hello,"hello world",world}

