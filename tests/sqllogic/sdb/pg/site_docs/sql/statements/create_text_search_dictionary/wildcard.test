CREATE TABLE terms_expr (id INTEGER PRIMARY KEY, term VARCHAR);

statement ok
INSERT INTO terms_expr VALUES
    (1, 'search'),
    (2, 'research'),
    (3, 'seabird'),
    (4, 'plain');

# DOCS_TEST_BODY

statement ok
CREATE TEXT SEARCH DICTIONARY wildcard_expr AS generate_wildcard_ngrams(split_csv(' '), 3);

