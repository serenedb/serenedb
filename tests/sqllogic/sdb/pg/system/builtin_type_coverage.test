query
SELECT t.oid, t.typname, t.typrelid::regclass::text AS relation,
       a.oid AS array_oid, a.typname AS array_name, c.reltype = t.oid AS reltype
FROM pg_type t
JOIN pg_type a ON a.oid = t.typarray AND a.typelem = t.oid
JOIN pg_class c ON c.oid = t.typrelid
WHERE t.oid IN ('pg_class'::regtype, 'pg_statistic'::regtype,
                'information_schema._pg_foreign_tables'::regtype)
ORDER BY t.oid
----
oid	typname	relation	array_oid	array_name	reltype
83	pg_class	pg_class	273	_pg_class	t
10029	pg_statistic	pg_statistic	10028	_pg_statistic	t
13618	_pg_foreign_tables	information_schema._pg_foreign_tables	13617	__pg_foreign_tables	t


query
SELECT format_type('_pg_class'::regtype, NULL) AS array_type,
       83::regtype::text AS row_type,
       'pg_statistic[]'::regtype::oid AS statistic_array,
       (SELECT format_type(atttypid, atttypmod) || ' ' || attalign
        FROM pg_attribute
        WHERE attrelid = 'pg_statistic_ext_data'::regclass
          AND attname = 'stxdexpr') AS stxdexpr
----
array_type	row_type	statistic_array	stxdexpr
pg_class[]	pg_class	10028	pg_statistic[] d


statement ok
CREATE TYPE btc_mood AS ENUM ('ok')


query
SELECT count(*) AS unreferenced
FROM pg_proc p
WHERE p.oid < 16384
  AND NOT EXISTS (
    SELECT 1 FROM pg_type t
    WHERE p.oid IN (t.typinput::oid, t.typoutput::oid, t.typreceive::oid,
                    t.typsend::oid, t.typmodin::oid, t.typmodout::oid,
                    t.typanalyze::oid, t.typsubscript::oid))
  AND NOT EXISTS (SELECT 1 FROM pg_am a WHERE a.amhandler::oid = p.oid)
  AND NOT EXISTS (
    SELECT 1 FROM pg_language l
    WHERE p.oid IN (l.lanplcallfoid, l.laninline, l.lanvalidator))
----
unreferenced
0


