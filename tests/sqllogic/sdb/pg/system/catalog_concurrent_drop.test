# --- DROP VIEW against the same view's cascade: both wanted it gone ---
#
# Wanting the same outcome is no excuse: the first drop holds the entry and the
# cascade that would have removed it a second time is refused like any other
# second writer.

statement ok
CREATE TABLE ccd_dropview(a INTEGER, b TEXT);


statement ok
CREATE VIEW ccd_dropview_v AS SELECT * FROM ccd_dropview;


connection s1
statement ok
BEGIN;


connection s1
statement ok
DROP VIEW ccd_dropview_v;


connection s2
statement error
DROP TABLE ccd_dropview CASCADE;
----
db error: ERROR: could not serialize access due to concurrent DDL on the same object


connection s1
statement ok
COMMIT;


connection s2
statement ok
DROP TABLE ccd_dropview CASCADE;


query
SELECT count(*) AS n FROM pg_class
WHERE relname IN ('ccd_dropview', 'ccd_dropview_v');
----
n
0


# --- the other direction: the drop commits first ---
#
# A transaction pins its catalog read view at its first write. A drop that
# commits after that point is invisible to it, so it resolves the target
# happily and the entry write is what discovers the loss.

statement ok
CREATE TABLE ccd_pin(a INTEGER);


statement ok
CREATE TABLE ccd_late(a INTEGER, b TEXT);


connection s3
statement ok
BEGIN;


connection s3
statement ok
COMMENT ON TABLE ccd_pin IS 'pins the read view';


connection s4
statement ok
DROP TABLE ccd_late;


connection s3
statement error
COMMENT ON TABLE ccd_late IS 'doomed';
----
db error: ERROR: could not serialize access due to concurrent DDL on the same object


connection s3
statement error
SELECT 1;
----
db error: ERROR: current transaction is aborted, commands ignored until end of transaction block


connection s3
statement ok
ROLLBACK;


# The rollback leaves the connection usable and the drop is the only outcome.
connection s3
query
SELECT count(*) AS n FROM pg_class
WHERE relname IN ('ccd_late', 'ccd_pin');
----
n
1


statement ok
DROP TABLE ccd_pin;


# --- the same direction for a role ---
#
# Roles live in their own attachment, which starts its transaction the first
# time a statement touches it -- after the drop, here. duckdb's own conflict
# check cannot see the loss from that read view, so the install refuses the
# resurrection itself and names the object.

statement ok
CREATE TABLE ccd_rolepin(a INTEGER);


statement ok
CREATE ROLE ccd_gone;


connection s5
statement ok
BEGIN;


connection s5
statement ok
COMMENT ON TABLE ccd_rolepin IS 'pins the read view';


connection s6
statement ok
DROP ROLE ccd_gone;


connection s5
statement error
ALTER ROLE ccd_gone NOSUPERUSER;
----
db error: ERROR: could not serialize access due to concurrent delete of "ccd_gone"


connection s5
statement ok
ROLLBACK;


connection s5
query
SELECT count(*) AS n FROM pg_authid WHERE rolname = 'ccd_gone';
----
n
0


# --- the same direction for an index build ---
#
# The build reaches the rows before the entry does, so the refusal comes from
# the store rather than from the set. Same class, same retry.

statement ok
CREATE TABLE ccd_idxlate(a INTEGER, b TEXT);


connection s7
statement ok
BEGIN;


connection s7
statement ok
COMMENT ON TABLE ccd_rolepin IS 'pins the read view again';


connection s8
statement ok
DROP TABLE ccd_idxlate;


connection s7
statement error
CREATE INDEX ccd_idxlate_i ON ccd_idxlate(a);
----
db error: ERROR: could not serialize access due to concurrent update of table "ccd_idxlate"


connection s7
statement ok
ROLLBACK;


statement ok
DROP TABLE ccd_rolepin;


# --- a drop that is already committed when the statement resolves ---
#
# The transaction still sees the table it read, so the binder resolves it; the
# rename re-resolves the name against what is committed and finds nothing.
# Renaming a version nothing holds any more would resurrect it, so the answer
# is the one the statement asked about: the name is gone.

statement ok
CREATE TABLE ccd_plain(a INTEGER);


connection s9
statement ok
BEGIN;


connection s9
query
SELECT count(*) AS n FROM ccd_plain;
----
n
0


connection s10
statement ok
DROP TABLE ccd_plain;


connection s9
statement error
ALTER TABLE ccd_plain RENAME TO ccd_plain_x;
----
db error: ERROR: relation "ccd_plain" does not exist


connection s9
statement ok
ROLLBACK;


