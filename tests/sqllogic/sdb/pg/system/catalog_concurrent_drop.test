# A catalog mutation and a concurrent DROP of its target.
#
# The entry a statement writes goes into its CatalogSet on that statement's own
# transaction, so whichever session writes the object first holds it, and the
# other one is refused there and then with 40001. We do not take PostgreSQL's
# ACCESS EXCLUSIVE lock, so the two cannot be ordered after the fact; 40001 is
# the class PG 18 raises when a snapshot-isolated transaction's target moved
# under it, and the class a client already knows to retry.
#
# Both directions are here. In the first family the open transaction mutates
# first and the DROP is what loses. In the second the DROP commits first,
# against a transaction whose read view was pinned before it, and the mutation
# is what loses -- which is the direction that used to reach the install past
# the point of no return.
#
# Either way the server stays up, the loser's transaction aborts, and the
# connection takes new work straight after.

# --- ALTER TABLE ... RENAME ---

statement ok
CREATE TABLE ccd_rename(a INTEGER, b TEXT);


connection s1
statement ok
BEGIN;


connection s1
statement ok
ALTER TABLE ccd_rename RENAME TO ccd_rename_x;


connection s2
statement error
DROP TABLE ccd_rename;
----
db error: ERROR: could not serialize access due to concurrent DDL on the same object


# The refused drop left its connection usable.
connection s2
query
SELECT 1 AS ok;
----
ok
1


connection s1
statement ok
COMMIT;


connection s1
query
SELECT relname FROM pg_class
WHERE relname IN ('ccd_rename', 'ccd_rename_x');
----
relname
ccd_rename_x


statement ok
DROP TABLE ccd_rename_x;


# --- COMMENT ON TABLE ---

statement ok
CREATE TABLE ccd_comment(a INTEGER, b TEXT);


connection s1
statement ok
BEGIN;


connection s1
statement ok
COMMENT ON TABLE ccd_comment IS 'kept';


connection s2
statement error
DROP TABLE ccd_comment;
----
db error: ERROR: could not serialize access due to concurrent DDL on the same object


connection s1
statement ok
COMMIT;


query
SELECT comment FROM duckdb_tables() WHERE table_name = 'ccd_comment';
----
comment
kept


statement ok
DROP TABLE ccd_comment;


# --- COMMENT ON COLUMN ---

statement ok
CREATE TABLE ccd_colcomment(a INTEGER, b TEXT);


connection s1
statement ok
BEGIN;


connection s1
statement ok
COMMENT ON COLUMN ccd_colcomment.a IS 'kept';


connection s2
statement error
DROP TABLE ccd_colcomment;
----
db error: ERROR: could not serialize access due to concurrent DDL on the same object


connection s1
statement ok
ROLLBACK;


# The holder rolled back, so the object is free and the drop now succeeds.
connection s2
statement ok
DROP TABLE ccd_colcomment;


# --- ALTER TABLE ... RENAME COLUMN ---
#
# The table entry owns its rows, so reshaping them is a write of that entry and
# not of anything underneath it. The concurrent DROP is refused where every
# other second writer is.

statement ok
CREATE TABLE ccd_renamecol(a INTEGER, b TEXT);


connection s1
statement ok
BEGIN;


connection s1
statement ok
ALTER TABLE ccd_renamecol RENAME COLUMN b TO b2;


connection s2
statement error
DROP TABLE ccd_renamecol;
----
db error: ERROR: could not serialize access due to concurrent DDL on the same object


connection s1
statement ok
COMMIT;


statement ok
DROP TABLE ccd_renamecol;


