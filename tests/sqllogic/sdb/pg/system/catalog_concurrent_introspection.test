# Catalog walks that run side by side must never hold one catalog set while
# they lock another. has_table_privilege(oid) walks every schema's sets for the
# oid; pg_index and pg_class resolve each index's table; ALTER TABLE ... RENAME
# rewrites the table's indexes while it holds the table set. The oid walk used
# to hold the schema set across each schema's sets and the index walks looked
# the table up from inside the index set, so any two of them could lock the
# same pair of sets in opposite orders; once they met, every later statement
# naming a relation hung. Nothing forces the overlap, so the two long oid
# loops keep the schema set busy while the other statements cycle.


statement ok
CREATE TABLE cci_t1(a INTEGER)


statement ok
CREATE INDEX cci_i1 ON cci_t1(a)


statement ok
