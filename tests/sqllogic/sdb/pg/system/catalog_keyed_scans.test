statement ok
DROP SCHEMA IF EXISTS pudge_keyed CASCADE


statement ok
CREATE SCHEMA pudge_keyed


statement ok
CREATE TABLE pudge_keyed.pudgekey_hook (id INT PRIMARY KEY, name TEXT UNIQUE, note TEXT DEFAULT 'meat', CHECK (id > 0))


statement ok
CREATE TABLE pudge_keyed.pudgekey_rot (id INT REFERENCES pudge_keyed.pudgekey_hook(id), x INT)


statement ok
CREATE INDEX pudgekey_x_idx ON pudge_keyed.pudgekey_rot (x)


statement ok
CREATE SEQUENCE pudge_keyed.pudgekey_flesh


statement ok
CREATE VIEW pudge_keyed.pudgekey_dismember AS SELECT id FROM pudge_keyed.pudgekey_hook


statement ok
CREATE TYPE pudge_keyed.pudgekey_heap AS (a INT)


statement ok
CREATE TYPE pudge_keyed.pudgekey_mood AS ENUM ('hungry', 'full')


statement ok
CREATE MACRO pudge_keyed.pudgekey_fresh(x) AS x + 1


statement ok
COMMENT ON TABLE pudge_keyed.pudgekey_hook IS 'meat hook'


statement ok
CREATE TEXT SEARCH DICTIONARY pudge_keyed.pudgekey_chopa AS keyword()


statement ok
CREATE TABLE pudge_keyed.pudgekey_log (what TEXT)


statement ok
CREATE TRIGGER pudgekey_cut AFTER INSERT ON pudge_keyed.pudgekey_hook FOR EACH STATEMENT INSERT INTO pudge_keyed.pudgekey_log VALUES ('cut')


query
WITH keyed AS (SELECT * FROM pg_class WHERE oid = 'pudge_keyed.pudgekey_hook'::regclass),
     whole AS (SELECT * FROM pg_class WHERE oid::text = 'pudge_keyed.pudgekey_hook'::regclass::oid::text)
SELECT (SELECT count(*) FROM keyed) > 0 AS found,
       (SELECT count(*) FROM (SELECT * FROM keyed EXCEPT ALL SELECT * FROM whole))
     + (SELECT count(*) FROM (SELECT * FROM whole EXCEPT ALL SELECT * FROM keyed)) AS diff;
----
found	diff
t	0


