query
WITH keyed AS (SELECT a.* FROM pg_class c JOIN pg_attribute a ON a.attrelid = c.oid
               WHERE c.relname = 'pudgekey_hook'),
     whole AS (SELECT a.* FROM pg_class c JOIN pg_attribute a ON a.attrelid::text = c.oid::text
               WHERE c.relname || '' = 'pudgekey_hook')
SELECT (SELECT count(*) FROM keyed) > 0 AS found,
       (SELECT count(*) FROM (SELECT * FROM keyed EXCEPT ALL SELECT * FROM whole))
     + (SELECT count(*) FROM (SELECT * FROM whole EXCEPT ALL SELECT * FROM keyed)) AS diff;
----
found	diff
