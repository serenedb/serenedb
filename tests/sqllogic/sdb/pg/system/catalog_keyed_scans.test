query
WITH keyed AS (SELECT * FROM pg_type WHERE typname = '_pg_user_mappings'),
     whole AS (SELECT * FROM pg_type WHERE typname || '' = '_pg_user_mappings')
SELECT (SELECT count(*) FROM keyed) AS found,
       (SELECT count(*) FROM (SELECT * FROM keyed EXCEPT ALL SELECT * FROM whole))
     + (SELECT count(*) FROM (SELECT * FROM whole EXCEPT ALL SELECT * FROM keyed)) AS diff;
----
found	diff
2	0


