  INSERT INTO cmr_ua VALUES ('before')


connection s1
statement ok
CREATE TRIGGER cmr_uta AFTER UPDATE ON cmr_ut FOR EACH STATEMENT
  INSERT INTO cmr_ua VALUES ('after')


