SELECT c.column_name, c.ordinal_position = a.attnum AS pos_ok, c.udt_name = t.typname AS udt_ok, (c.is_nullable = 'NO') = a.attnotnull AS null_ok
FROM information_schema.columns c
JOIN pg_attribute a ON a.attrelid = 'invoker_isc_orbs'::regclass AND a.attname = c.column_name
JOIN pg_type t ON t.oid = a.atttypid
WHERE c.table_name = 'invoker_isc_orbs' AND c.ordinal_position <= 4 ORDER BY c.ordinal_position;
----
column_name	pos_ok	udt_ok	null_ok
id	t	t	t
quas	t	t	t
wex	t	t	t
exort	t	t	t


