query
SELECT count(*) AS infos, count(integer_value) AS with_integer, count(character_value) AS with_character
FROM information_schema.sql_implementation_info;
----
infos	with_integer	with_character
12	5	7


query
SELECT implementation_info_id, implementation_info_name, integer_value,
       CASE WHEN implementation_info_id = '18' AND strpos(version(), character_value) > 0
            THEN 'server version' ELSE character_value END AS character_value,
       comments
FROM information_schema.sql_implementation_info
ORDER BY implementation_info_id::text;
----
implementation_info_id	implementation_info_name	integer_value	character_value	comments
10003	CATALOG NAME	NULL	Y	NULL
10004	COLLATING SEQUENCE	NULL	C.UTF-8	NULL
13	SERVER NAME	NULL	(empty)	NULL
17	DBMS NAME	NULL	SereneDB	NULL
18	DBMS VERSION	NULL	server version	NULL
2	DATA SOURCE NAME	NULL	(empty)	NULL
23	CURSOR COMMIT BEHAVIOR	1	NULL	close cursors and retain prepared statements
26	DEFAULT TRANSACTION ISOLATION	4	NULL	REPEATABLE READ; user-settable
28	IDENTIFIER CASE	3	NULL	stored in mixed case - case sensitive
46	TRANSACTION CAPABLE	2	NULL	both DML and DDL
85	NULL COLLATION	4	NULL	nulls sort at the end
94	SPECIAL CHARACTERS	NULL	(empty)	all non-ASCII characters allowed


query
SELECT character_value
FROM information_schema.sql_implementation_info
WHERE implementation_info_name = 'DBMS NAME';
----
character_value
SereneDB


