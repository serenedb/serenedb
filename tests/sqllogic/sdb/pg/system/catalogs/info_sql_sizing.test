statement ok
DROP ROLE IF EXISTS sven_sql_sizing_cleave;


statement ok
CREATE ROLE sven_sql_sizing_cleave LOGIN PASSWORD 'sven_sql_sizing_pw';


query
SELECT c.relkind, n.nspname, c.relnatts
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname = 'sql_sizing';
----
relkind	nspname	relnatts
r	information_schema	4


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'information_schema.sql_sizing'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
sizing_id	information_schema.cardinal_number	f
sizing_name	information_schema.character_data	f
supported_value	information_schema.cardinal_number	f
comments	information_schema.character_data	f


query
SELECT count(*) AS sizings, count(supported_value) AS with_value, count(comments) AS with_comments
FROM information_schema.sql_sizing;
----
sizings	with_value	with_comments
23	19	9


query
SELECT sizing_id, sizing_name, supported_value, comments
FROM information_schema.sql_sizing
ORDER BY sizing_id;
