query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_amop'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
amopfamily	oid	t
amoplefttype	oid	t
amoprighttype	oid	t
amopstrategy	smallint	t
amoppurpose	"char"	t
amopopr	oid	t
amopmethod	oid	t
amopsortfamily	oid	t


query
SELECT c.oid, c.relname, c.relkind, c.relnamespace::regnamespace::text AS nsp, c.relnatts, c.reltype::regtype::text AS rowtype, c.relisshared
FROM pg_class c
WHERE c.oid = 'pg_amop'::regclass;
----
oid	relname	relkind	nsp	relnatts	rowtype	relisshared
2602	pg_amop	r	pg_catalog	9	pg_amop	f


query
SELECT t.typname, t.typtype, t.typrelid = 'pg_amop'::regclass AS linked, a.typname AS array_name
FROM pg_type t JOIN pg_type a ON a.oid = t.typarray
WHERE t.typname = 'pg_amop';
----
typname	typtype	linked	array_name
pg_amop	c	t	_pg_amop


query
SELECT count(*) AS n FROM pg_amop;
----
n
0


query
SELECT amopfamily, amoplefttype, amoprighttype, amopstrategy FROM pg_amop ORDER BY 1;
----
amopfamily	amoplefttype	amoprighttype	amopstrategy


query
SELECT amopfamily, amoplefttype, amoprighttype, amopstrategy FROM pg_amop WHERE amopfamily = 1976;
----
amopfamily	amoplefttype	amoprighttype	amopstrategy


query
SELECT amopfamily, amoplefttype, amoprighttype, amopstrategy FROM pg_amop WHERE amopopr IN (96, 97);
----
amopfamily	amoplefttype	amoprighttype	amopstrategy


query
SELECT count(*) AS n FROM pg_catalog.pg_amop x JOIN pg_type t ON t.oid = 23;
----
n
0
