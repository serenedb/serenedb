query
SELECT relname, relkind, relnatts, relnamespace::regnamespace::text AS nsp FROM pg_class WHERE oid = 2604;
----
relname	relkind	relnatts	nsp
pg_attrdef	r	4	pg_catalog


query
SELECT attname, atttypid::regtype::text AS typ, attnotnull FROM pg_attribute WHERE attrelid = 'pg_attrdef'::regclass AND attnum > 0 ORDER BY attnum;
----
attname	typ	attnotnull
oid	oid	t
adrelid	oid	t
adnum	smallint	t
adbin	pg_node_tree	t


statement ok
CREATE TABLE tango_adf_tree (id int, hp int DEFAULT 115, name text, regen numeric DEFAULT 7.5, eaten bool DEFAULT false, born timestamp DEFAULT now(), dbl int GENERATED ALWAYS AS (hp * 2) STORED, plain int, sum int DEFAULT 1 + 2);


query
SELECT d.adnum, a.attname, d.adrelid::regclass::text AS rel
FROM pg_attrdef d JOIN pg_attribute a ON a.attrelid = d.adrelid AND a.attnum = d.adnum
WHERE d.adrelid = 'tango_adf_tree'::regclass ORDER BY d.adnum;
----
adnum	attname	rel
2	hp	tango_adf_tree
4	regen	tango_adf_tree
5	eaten	tango_adf_tree
6	born	tango_adf_tree
7	dbl	tango_adf_tree
9	sum	tango_adf_tree


query
SELECT adnum, pg_get_expr(adbin, adrelid) AS expr FROM pg_attrdef
WHERE adrelid = 'tango_adf_tree'::regclass AND adnum IN (2, 4, 5, 6, 9) ORDER BY adnum;
----
adnum	expr
2	115
4	7.5
5	false
6	now()
9	(1 + 2)


query
SELECT pg_get_expr(adbin, adrelid, true) AS expr FROM pg_attrdef WHERE adrelid = 'tango_adf_tree'::regclass AND adnum = 4;
----
expr
7.5


query
SELECT pg_typeof(adbin)::text AS typ FROM pg_attrdef WHERE adrelid = 'tango_adf_tree'::regclass AND adnum = 2;
----
typ
pg_node_tree


query
SELECT count(*) AS n, count(DISTINCT oid) AS oids FROM pg_attrdef WHERE adrelid = 'tango_adf_tree'::regclass;
----
n	oids
6	6


query
SELECT a.attname FROM pg_attribute a
WHERE a.attrelid = 'tango_adf_tree'::regclass AND a.atthasdef
  AND NOT EXISTS (SELECT 1 FROM pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum);
----
attname


query
SELECT a.attname FROM pg_attribute a
WHERE a.attrelid = 'tango_adf_tree'::regclass AND a.attnum > 0 AND NOT a.atthasdef
  AND EXISTS (SELECT 1 FROM pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum)
ORDER BY a.attnum;
----
attname


query
SELECT count(*) AS diff FROM (
  SELECT oid, adrelid, adnum FROM pg_attrdef WHERE adrelid = 'tango_adf_tree'::regclass
  EXCEPT
  SELECT oid, adrelid, adnum FROM pg_attrdef WHERE adrelid::text = 'tango_adf_tree'::regclass::oid::text
) s;
----
diff
0


