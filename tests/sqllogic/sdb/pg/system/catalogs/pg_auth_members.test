query
SELECT roleid::regrole::text AS role, member::regrole::text AS member, admin_option
FROM pg_auth_members
WHERE member IN (SELECT oid FROM pg_roles WHERE rolname LIKE 'meepo\_aum\_%')
ORDER BY 1, 2;
----
role	member	admin_option
meepo_aum_clone	meepo_aum_prime	f
meepo_aum_net	meepo_aum_clone	f


