query
SELECT count(*) FROM pg_auth_members m
LEFT JOIN pg_authid r ON r.oid = m.roleid
LEFT JOIN pg_authid u ON u.oid = m.member
WHERE r.oid IS NULL OR u.oid IS NULL;
