collname
default
C


query
SELECT '"C"'::regcollation::text AS c, 950::regcollation::text AS by_oid, '"POSIX"'::regcollation::oid AS posix, 'default'::regcollation::oid AS dflt, 100::regcollation::text AS dflt_name, to_regcollation('invoker_col_nope') IS NULL AS missing;
----
c	by_oid	posix	dflt	dflt_name	missing
"C"	"C"	951	100	"default"	t


