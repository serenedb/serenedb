query
SELECT t.typname, c.collname
FROM pg_type t JOIN pg_collation c ON c.oid = t.typcollation
WHERE t.oid IN (19, 25, 1043, 13312)
ORDER BY t.oid;
----
typname	collname
name	C
text	default
varchar	default
sql_identifier	C


query
SELECT count(*) AS dangling
FROM pg_type t
WHERE t.typcollation <> 0 AND NOT EXISTS (SELECT 1 FROM pg_collation c WHERE c.oid = t.typcollation);
----
dangling
0


query
SELECT (SELECT count(*) FROM pg_collation) - 3 = (SELECT count(*) FROM pragma_collations()) AS every_duckdb_collation,
       (SELECT count(*) FROM pg_collation WHERE oid >= 17384 AND collname NOT IN (SELECT collname FROM pragma_collations())) AS unknown
----
every_duckdb_collation	unknown
t	0


query
SELECT collname, collnamespace::regnamespace::text AS nsp, collprovider, collisdeterministic, collcollate, collctype, colllocale
FROM pg_collation
WHERE collname IN ('nocase', 'noaccent', 'nfc', 'de')
ORDER BY collname;
----
collname	nsp	collprovider	collisdeterministic	collcollate	collctype	colllocale
de	pg_catalog	i	f	NULL	NULL	de
nfc	pg_catalog	b	f	NULL	NULL	NULL
noaccent	pg_catalog	b	f	NULL	NULL	NULL
nocase	pg_catalog	b	f	NULL	NULL	NULL


query
SELECT 'nocase'::regcollation::text AS by_name, ('nocase'::regcollation::oid)::regcollation::text AS by_oid
----
by_name	by_oid
nocase	nocase


statement ok
CREATE TABLE invoker_col_spells (name text, code varchar(10), n int, folded text COLLATE nocase, german text COLLATE de, bytes text COLLATE "C", stacked text COLLATE "nocase.noaccent");


query
SELECT a.attname, a.attcollation::regcollation::text AS coll
FROM pg_attribute a
WHERE a.attrelid = 'invoker_col_spells'::regclass AND a.attnum > 0
ORDER BY a.attnum;
----
attname	coll
name	"default"
code	"default"
n	-
folded	nocase
german	de
bytes	"C"
stacked	-


query
SELECT column_name, collation_name
FROM information_schema.columns
WHERE table_name = 'invoker_col_spells' AND collation_name IS NOT NULL
ORDER BY ordinal_position;
----
column_name	collation_name
folded	nocase
german	de
bytes	C


statement ok
DROP TABLE invoker_col_spells;
