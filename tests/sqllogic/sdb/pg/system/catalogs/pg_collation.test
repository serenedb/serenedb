statement ok
DROP TABLE IF EXISTS invoker_col_spells;


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_collation'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
collname	name	t
collnamespace	oid	t
collowner	oid	t
collprovider	"char"	t
collisdeterministic	boolean	t
collencoding	integer	t
collcollate	text	f
collctype	text	f
colllocale	text	f
collicurules	text	f
collversion	text	f


query
SELECT oid, collname, collnamespace::regnamespace::text AS nsp, collprovider, collisdeterministic, collencoding, collcollate, collctype, colllocale IS NULL AS no_locale, collicurules IS NULL AS no_rules, collversion IS NULL AS no_version
FROM pg_collation
WHERE oid IN (100, 950, 951)
ORDER BY oid;
----
oid	collname	nsp	collprovider	collisdeterministic	collencoding	collcollate	collctype	no_locale	no_rules	no_version
100	default	pg_catalog	d	t	-1	NULL	NULL	t	t	t
950	C	pg_catalog	c	t	-1	C	C	t	t	t
951	POSIX	pg_catalog	c	t	-1	POSIX	POSIX	t	t	t


query
SELECT count(*) = count(DISTINCT oid) AS oids_unique, count(*) = count(DISTINCT (collname, collnamespace, collencoding)) AS names_unique
FROM pg_collation;
----
oids_unique	names_unique
t	t


query
SELECT count(*) AS bad_owner FROM pg_collation c WHERE NOT EXISTS (SELECT 1 FROM pg_authid a WHERE a.oid = c.collowner);
----
bad_owner
0


