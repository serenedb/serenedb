query
SELECT name, setting <> '' AS set FROM pg_config ORDER BY name;
----
name	set
BINDIR	t
CC	t
CFLAGS	t
CONFIGURE	t
CXX	t
CXXFLAGS	t
LDFLAGS	t
SDB_COMMIT	t
SDB_VERSION	t
SYSCONFDIR	t
VERSION	t


query
SELECT setting = 'PostgreSQL ' || current_setting('server_version') AS matches
FROM pg_config WHERE name = 'VERSION';
----
matches
t


query
SELECT (SELECT setting FROM pg_config WHERE name = 'VERSION') || ' (SereneDB ' ||
       (SELECT setting FROM pg_config WHERE name = 'SDB_VERSION') || ')' =
       version() AS matches;
----
matches
t


query
SELECT setting ~ '^[0-9a-f]{40}(-dirty)?$' AS commit
FROM pg_config WHERE name = 'SDB_COMMIT';
----
commit
t


query
SELECT library_version = (SELECT setting FROM pg_config WHERE name = 'SDB_VERSION') AS version,
       source_id = (SELECT setting FROM pg_config WHERE name = 'SDB_COMMIT') AS commit,
       codename IS NULL AS no_codename
FROM pragma_version();
----
version	commit	no_codename
t	t	t


query
SELECT setting LIKE '-DCMAKE_BUILD_TYPE=%' AND setting LIKE '% -DSDB_ALLOC=%'
  AS options
FROM pg_config WHERE name = 'CONFIGURE';
----
options
t


query
SELECT count(*) AS n FROM pg_config() WHERE name = 'SDB_COMMIT';
----
n
1
