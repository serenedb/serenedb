statement ok
CREATE TABLE pudge_con_flesh (a INT, b INT, c INT, CONSTRAINT pudge_con_flesh_order CHECK (c > a AND b > 0), CONSTRAINT pudge_con_flesh_always CHECK (true));


query
SELECT conname, conkey FROM pg_constraint WHERE conrelid = 'pudge_con_flesh'::regclass ORDER BY 1;
----
conname	conkey
pudge_con_flesh_always	NULL
pudge_con_flesh_order	{3,1,2}


