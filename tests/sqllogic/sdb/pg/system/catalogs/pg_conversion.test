query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_conversion'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
conname	name	t
connamespace	oid	t
conowner	oid	t
conforencoding	integer	t
contoencoding	integer	t
conproc	regproc	t
condefault	boolean	t


query
SELECT c.oid, c.relname, c.relkind, c.relnamespace::regnamespace::text AS nsp, c.relnatts, c.reltype::regtype::text AS rowtype, c.relisshared
FROM pg_class c
WHERE c.oid = 'pg_conversion'::regclass;
----
oid	relname	relkind	nsp	relnatts	rowtype	relisshared
2607	pg_conversion	r	pg_catalog	8	pg_conversion	f


query
SELECT t.typname, t.typtype, t.typrelid = 'pg_conversion'::regclass AS linked, a.typname AS array_name
FROM pg_type t JOIN pg_type a ON a.oid = t.typarray
WHERE t.typname = 'pg_conversion';
----
typname	typtype	linked	array_name
pg_conversion	c	t	_pg_conversion


query
SELECT count(*) AS n FROM pg_conversion;
----
n
0


query
SELECT conname, conforencoding, contoencoding, conproc FROM pg_conversion ORDER BY 1;
----
conname	conforencoding	contoencoding	conproc


query
SELECT conname, conforencoding, contoencoding, conproc FROM pg_conversion WHERE conname = 'utf8_to_iso_8859_1';
----
conname	conforencoding	contoencoding	conproc


query
SELECT conname, conforencoding, contoencoding, conproc FROM pg_conversion WHERE conforencoding IN (6, 8);
----
conname	conforencoding	contoencoding	conproc


query
SELECT count(*) AS n FROM pg_catalog.pg_conversion x JOIN pg_type t ON t.oid = 23;
----
n
0
