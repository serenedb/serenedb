statement ok
GRANT CONNECT, CREATE ON DATABASE chopa_dat_meat TO chopa_dat_roshan;


statement ok
GRANT TEMPORARY ON DATABASE chopa_dat_meat TO chopa_dat_courier WITH GRANT OPTION;


query
SELECT CASE WHEN a.grantee = 0 THEN 'public' ELSE a.grantee::regrole::text END AS grantee,
       a.grantor::regrole::text AS grantor, a.privilege_type, a.is_grantable
FROM pg_database d, aclexplode(d.datacl) a
WHERE d.datname = 'chopa_dat_meat'
ORDER BY 1, 3;
----
grantee	grantor	privilege_type	is_grantable
chopa_dat_courier	postgres	TEMPORARY	t
chopa_dat_roshan	postgres	CONNECT	f
chopa_dat_roshan	postgres	CREATE	f
postgres	postgres	CONNECT	f
postgres	postgres	CREATE	f
postgres	postgres	TEMPORARY	f
public	postgres	CONNECT	f
public	postgres	TEMPORARY	f


query
SELECT has_database_privilege('chopa_dat_roshan', 'chopa_dat_meat', 'CREATE') AS meat_create,
       has_database_privilege('chopa_dat_courier', 'chopa_dat_meat', 'CREATE') AS courier_create,
       has_database_privilege('chopa_dat_courier', 'chopa_dat_meat', 'TEMPORARY WITH GRANT OPTION') AS courier_temp,
       has_database_privilege('chopa_dat_roshan', 'chopa_dat_aegis', 'CREATE') AS aegis_create;
----
meat_create	courier_create	courier_temp	aegis_create
t	f	t	t


