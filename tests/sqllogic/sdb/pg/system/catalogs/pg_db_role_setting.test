query
SELECT setdatabase, setrole::regrole::text AS role, setconfig
FROM pg_db_role_setting
WHERE setrole IN (SELECT oid FROM pg_authid WHERE rolname LIKE 'invoker\_drs\_%')
ORDER BY 2;
