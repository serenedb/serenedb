query
SELECT r.rolname, r.rolconfig = s.setconfig AS same_config
FROM pg_roles r JOIN pg_db_role_setting s ON s.setrole = r.oid AND s.setdatabase = 0
WHERE r.rolname LIKE 'invoker\_drs\_%' ORDER BY r.rolname;
----
rolname	same_config
invoker_drs_quas	t
invoker_drs_wex	t


