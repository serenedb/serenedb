oid	relname	relkind	nsp	relnatts
2964	pg_db_role_setting	r	pg_catalog	3


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute WHERE attrelid = 'pg_db_role_setting'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
setdatabase	oid	t
setrole	oid	t
setconfig	text[]	f


