CREATE SCHEMA chopa_dep_lair;


statement ok
CREATE TYPE chopa_dep_lair.mood AS ENUM ('fed', 'hungry');


statement ok
CREATE TABLE chopa_dep_lair.meat (id SERIAL PRIMARY KEY, kg INT UNIQUE, m chopa_dep_lair.mood);


statement ok
CREATE INDEX chopa_dep_kg_idx ON chopa_dep_lair.meat (kg);


statement ok
CREATE VIEW chopa_dep_lair.v AS SELECT id, kg FROM chopa_dep_lair.meat;


statement ok
CREATE SEQUENCE chopa_dep_lair.seq OWNED BY chopa_dep_lair.meat.kg;


statement ok
CREATE FUNCTION chopa_dep_lair.eat(x INT) RETURNS INT LANGUAGE sql AS 'SELECT x + 1';


query
SELECT d.refclassid::regclass::text AS refclass,
       CASE d.refclassid
         WHEN 'pg_namespace'::regclass THEN d.refobjid::regnamespace::text
         WHEN 'pg_type'::regclass THEN d.refobjid::regtype::text
       END AS ref,
       d.objsubid, d.refobjsubid, d.deptype
FROM pg_depend d
WHERE d.classid = 'pg_class'::regclass AND d.objid = 'chopa_dep_lair.meat'::regclass
ORDER BY 1, 2, 3;
----
refclass	ref	objsubid	refobjsubid	deptype
pg_namespace	chopa_dep_lair	0	0	n
pg_type	chopa_dep_lair.mood	3	0	n


query
SELECT d.classid::regclass::text AS class,
       CASE d.classid
         WHEN 'pg_class'::regclass THEN d.objid::regclass::text
         WHEN 'pg_type'::regclass THEN d.objid::regtype::text
         WHEN 'pg_constraint'::regclass THEN (SELECT conname::text FROM pg_constraint WHERE oid = d.objid)
         WHEN 'pg_attrdef'::regclass THEN 'default'
       END AS obj,
       d.objsubid, d.refobjsubid, d.deptype
FROM pg_depend d
WHERE d.refclassid = 'pg_class'::regclass
  AND d.refobjid = 'chopa_dep_lair.meat'::regclass
  AND d.classid <> 'pg_rewrite'::regclass
  AND d.objid <> 'chopa_dep_lair.seq'::regclass
ORDER BY 1, 2, 4;
----
class	obj	objsubid	refobjsubid	deptype
pg_attrdef	default	0	1	a
pg_class	chopa_dep_lair.chopa_dep_kg_idx	0	2	a
pg_class	chopa_dep_lair.meat_id_seq	0	1	a
pg_constraint	meat_id_not_null	0	1	a
pg_constraint	meat_kg_key	0	2	a
pg_constraint	meat_pkey	0	1	a
pg_type	chopa_dep_lair.meat	0	0	i


