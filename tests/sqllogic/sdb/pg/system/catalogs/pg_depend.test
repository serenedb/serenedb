query
SELECT r.ev_class::regclass::text AS view, d.refobjid::regclass::text AS ref, d.refobjsubid, d.deptype
FROM pg_rewrite r
JOIN pg_depend d ON d.classid = 'pg_rewrite'::regclass AND d.objid = r.oid
WHERE r.ev_class IN ('chopa_dep_lair.v'::regclass, 'chopa_dep_lair.v2'::regclass, 'chopa_dep_lair.v3'::regclass)
  AND d.deptype = 'n'
ORDER BY 1, 2, 3;
----
