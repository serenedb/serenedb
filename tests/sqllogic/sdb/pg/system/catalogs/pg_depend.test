oid	relkind	relnatts	relisshared	reltype	nsp
2608	r	7	f	10051	pg_catalog


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_depend'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
classid	oid	t
objid	oid	t
objsubid	integer	t
refclassid	oid	t
refobjid	oid	t
refobjsubid	integer	t
deptype	"char"	t


