INSERT INTO chin_enm_wards VALUES ('off'), ('safe'), ('Roshan Pit'), ('mid');


query
SELECT w.lane::text AS lane, e.enumsortorder
FROM chin_enm_wards w JOIN pg_enum e ON e.enumlabel = w.lane::text AND e.enumtypid = 'chin_enm_lane'::regtype
ORDER BY w.lane;
----
lane	enumsortorder
safe	1
mid	2
off	3
Roshan Pit	4


