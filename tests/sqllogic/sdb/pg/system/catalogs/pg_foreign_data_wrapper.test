query
SELECT oid::int AS oid, relname, relkind, relnatts FROM pg_class WHERE oid = 'pg_catalog.pg_foreign_data_wrapper'::regclass;
----
oid	relname	relkind	relnatts
2328	pg_foreign_data_wrapper	r	7


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_foreign_data_wrapper'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
fdwname	name	t
fdwowner	oid	t
fdwhandler	oid	t
fdwvalidator	oid	t
fdwacl	aclitem[]	f
fdwoptions	text[]	f


query
SELECT oid::int AS oid, fdwname, fdwowner::regrole::text AS owner, fdwhandler, fdwvalidator, fdwacl::text[] AS fdwacl, fdwoptions
FROM pg_foreign_data_wrapper
ORDER BY fdwname;
