query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_foreign_data_wrapper'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
fdwname	name	t
fdwowner	oid	t
fdwhandler	oid	t
fdwvalidator	oid	t
fdwacl	aclitem[]	f
fdwoptions	text[]	f


