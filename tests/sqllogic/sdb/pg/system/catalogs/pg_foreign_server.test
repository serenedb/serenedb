query
SELECT has_server_privilege('chopa_srv_memory', 'USAGE') AS by_name, has_server_privilege(oid, 'USAGE') AS by_oid,
       has_server_privilege('chopa_srv_hook', oid, 'USAGE') AS hook_by_oid,
       has_server_privilege('chopa_srv_hook', 'chopa_srv_memory', 'USAGE') AS hook_by_name,
       has_server_privilege('chopa_srv_hook', 'pg_class'::regclass::oid, 'USAGE') AS not_a_server
FROM pg_foreign_server WHERE srvname = 'chopa_srv_memory';
