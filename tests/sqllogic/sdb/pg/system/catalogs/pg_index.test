query
SELECT indexrelid::regclass::text AS idx, indrelid::regclass::text AS rel, indnatts, indnkeyatts, indisunique, indnullsnotdistinct, indisprimary, indisexclusion, indimmediate, indisclustered, indisvalid, indcheckxmin, indisready, indislive, indisreplident, array_to_string(indkey, ' ') AS indkey, array_to_string(indcollation, ' ') AS indcollation, array_to_string(indoption, ' ') AS indoption, indexprs IS NULL AS no_exprs, indpred IS NULL AS no_pred
FROM pg_index WHERE indrelid = 'roshan_idx_pit'::regclass ORDER BY 1;
