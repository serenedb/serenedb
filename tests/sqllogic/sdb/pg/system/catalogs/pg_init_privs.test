query
SELECT oid, relname, relkind, relnamespace::regnamespace::text AS nsp, relnatts
FROM pg_class WHERE oid = 'pg_init_privs'::regclass;
----
oid	relname	relkind	nsp	relnatts
3394	pg_init_privs	r	pg_catalog	5


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute WHERE attrelid = 'pg_init_privs'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
objoid	oid	t
classoid	oid	t
objsubid	integer	t
privtype	"char"	t
initprivs	aclitem[]	t


query
SELECT count(*) >= 0 AS readable FROM pg_init_privs;
----
readable
t


query
SELECT count(*) FROM pg_init_privs WHERE privtype NOT IN ('i', 'e');
----
count
0


query
SELECT objoid::regclass::text AS relation, objsubid, privtype, initprivs
FROM pg_init_privs
WHERE classoid = 'pg_class'::regclass
  AND objoid IN ('pg_class'::regclass, 'pg_authid'::regclass, 'pg_tables'::regclass, 'sdb_settings'::regclass)
ORDER BY 1;
----
relation	objsubid	privtype	initprivs
pg_authid	0	i	{postgres=arwdDxtm/postgres}
pg_class	0	i	{postgres=arwdDxtm/postgres,=r/postgres}
pg_tables	0	i	{postgres=arwdDxtm/postgres,=r/postgres}
sdb_settings	0	i	{postgres=arwdDxtm/postgres,=r/postgres}


query
SELECT objoid::regnamespace::text AS schema, privtype, initprivs
FROM pg_init_privs WHERE classoid = 'pg_namespace'::regclass
ORDER BY 1;
----
schema	privtype	initprivs
pg_catalog	i	{postgres=UC/postgres,=U/postgres}
public	i	{postgres=UC/postgres,=U/postgres}


query
SELECT (SELECT count(*) FROM pg_init_privs WHERE classoid = 'pg_class'::regclass) =
       (SELECT count(*) FROM pg_class WHERE relnamespace = 'pg_catalog'::regnamespace) AS every_catalog_relation;
----
every_catalog_relation
t


