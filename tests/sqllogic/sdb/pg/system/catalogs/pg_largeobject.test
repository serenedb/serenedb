query
SELECT oid, relname, relkind, relnamespace::regnamespace::text AS nsp, relnatts
FROM pg_class WHERE oid = 'pg_largeobject'::regclass;
----
oid	relname	relkind	nsp	relnatts
2613	pg_largeobject	r	pg_catalog	3


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute WHERE attrelid = 'pg_largeobject'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
loid	oid	t
pageno	integer	t
data	bytea	t


query
SELECT count(*) >= 0 AS readable FROM pg_largeobject;
