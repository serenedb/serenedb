query
SELECT oid, relname, relkind, relnamespace::regnamespace::text AS nsp, relnatts
FROM pg_class WHERE oid = 'pg_largeobject_metadata'::regclass;
----
oid	relname	relkind	nsp	relnatts
2995	pg_largeobject_metadata	r	pg_catalog	3


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute WHERE attrelid = 'pg_largeobject_metadata'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
lomowner	oid	t
lomacl	aclitem[]	f


query
SELECT count(*) >= 0 AS readable FROM pg_largeobject_metadata;
