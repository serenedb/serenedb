query
SELECT oid, relname, relkind, relnamespace::regnamespace::text AS nsp, relnatts
FROM pg_class WHERE oid = 'pg_namespace'::regclass;
----
oid	relname	relkind	nsp	relnatts
2615	pg_namespace	r	pg_catalog	4


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute WHERE attrelid = 'pg_namespace'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
nspname	name	t
nspowner	oid	t
nspacl	aclitem[]	f


query
SELECT oid, nspname FROM pg_namespace WHERE oid IN (11, 2200, 13293) ORDER BY oid;
----
oid	nspname
11	pg_catalog
2200	public
13293	information_schema


query
SELECT oid, nspname FROM pg_namespace WHERE nspname IN ('pg_catalog', 'public', 'information_schema') ORDER BY oid;
----
oid	nspname
11	pg_catalog
2200	public
13293	information_schema


query
SELECT oid, nspname FROM pg_namespace WHERE nspname || '' IN ('pg_catalog', 'public', 'information_schema') ORDER BY oid;
----
oid	nspname
11	pg_catalog
2200	public
13293	information_schema


query
SELECT 'pg_catalog'::regnamespace::oid AS pg_catalog, 'public'::regnamespace::oid AS public,
       'information_schema'::regnamespace::oid AS information_schema;
----
pg_catalog	public	information_schema
11	2200	13293


query
SELECT nspname, nspowner::regrole::text AS owner, nspacl
FROM pg_namespace WHERE nspname IN ('pg_catalog', 'information_schema') ORDER BY oid;
----
nspname	owner	nspacl
pg_catalog	postgres	{postgres=UC/postgres,=U/postgres}
information_schema	postgres	{postgres=UC/postgres,=U/postgres}


query
SELECT count(*) FROM pg_namespace WHERE nspname LIKE 'rubick\_nsp\_%';
----
count
0


