statement ok
CREATE SCHEMA rubick_nsp_steal;


statement ok
CREATE SCHEMA rubick_nsp_telekinesis AUTHORIZATION rubick_nsp_grand_magus;


statement ok
CREATE SCHEMA IF NOT EXISTS rubick_nsp_steal;


query
SELECT nspname, nspowner::regrole::text AS owner, nspacl
FROM pg_namespace WHERE nspname LIKE 'rubick\_nsp\_%' ORDER BY nspname;
----
nspname	owner	nspacl
rubick_nsp_steal	postgres	NULL
rubick_nsp_telekinesis	rubick_nsp_grand_magus	NULL


query
SELECT nspname FROM pg_namespace WHERE oid = 'rubick_nsp_telekinesis'::regnamespace;
----
nspname
rubick_nsp_telekinesis


query
SELECT nspname FROM pg_namespace WHERE oid IN (SELECT 'rubick_nsp_telekinesis'::regnamespace::oid);
----
nspname
rubick_nsp_telekinesis


query
SELECT n.oid = 'rubick_nsp_steal'::regnamespace AS same_oid FROM pg_namespace n WHERE n.nspname = 'rubick_nsp_steal';
----
same_oid
t


query
SELECT count(*) FROM pg_namespace a JOIN pg_namespace b ON a.oid = b.oid
WHERE a.nspname LIKE 'rubick\_nsp\_%' AND a.nspname = b.nspname;
----
count
2


statement ok
ALTER SCHEMA rubick_nsp_steal OWNER TO rubick_nsp_grand_magus;


statement ok
GRANT USAGE ON SCHEMA rubick_nsp_steal TO rubick_nsp_apprentice;


statement ok
GRANT CREATE ON SCHEMA rubick_nsp_steal TO rubick_nsp_apprentice WITH GRANT OPTION;


query
SELECT nspname, nspowner::regrole::text AS owner, nspacl
FROM pg_namespace WHERE nspname = 'rubick_nsp_steal';
----
nspname	owner	nspacl
rubick_nsp_steal	rubick_nsp_grand_magus	{rubick_nsp_grand_magus=UC/rubick_nsp_grand_magus,rubick_nsp_apprentice=UC*/rubick_nsp_grand_magus}


query
SELECT a.grantee::regrole::text AS grantee, a.grantor::regrole::text AS grantor, a.privilege_type, a.is_grantable
FROM pg_namespace n, aclexplode(n.nspacl) a
WHERE n.nspname = 'rubick_nsp_steal'
ORDER BY 1, 3;
----
grantee	grantor	privilege_type	is_grantable
rubick_nsp_apprentice	rubick_nsp_grand_magus	CREATE	t
rubick_nsp_apprentice	rubick_nsp_grand_magus	USAGE	f
rubick_nsp_grand_magus	rubick_nsp_grand_magus	CREATE	f
rubick_nsp_grand_magus	rubick_nsp_grand_magus	USAGE	f


query
SELECT has_schema_privilege('rubick_nsp_apprentice', 'rubick_nsp_steal', 'USAGE') AS steal_usage,
       has_schema_privilege('rubick_nsp_apprentice', 'rubick_nsp_telekinesis', 'USAGE') AS tk_usage;
----
steal_usage	tk_usage
t	f


