query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_opfamily'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
opfmethod	oid	t
opfname	name	t
opfnamespace	oid	t
opfowner	oid	t


query
SELECT c.oid, c.relname, c.relkind, c.relnamespace::regnamespace::text AS nsp, c.relnatts, c.reltype::regtype::text AS rowtype, c.relisshared
FROM pg_class c
WHERE c.oid = 'pg_opfamily'::regclass;
----
oid	relname	relkind	nsp	relnatts	rowtype	relisshared
2753	pg_opfamily	r	pg_catalog	5	pg_opfamily	f


query
SELECT t.typname, t.typtype, t.typrelid = 'pg_opfamily'::regclass AS linked, a.typname AS array_name
FROM pg_type t JOIN pg_type a ON a.oid = t.typarray
WHERE t.typname = 'pg_opfamily';
----
typname	typtype	linked	array_name
pg_opfamily	c	t	_pg_opfamily


query
SELECT count(*) AS n FROM pg_opfamily;
----
n
0


query
SELECT opfmethod, opfname, opfnamespace FROM pg_opfamily ORDER BY 1;
----
opfmethod	opfname	opfnamespace


query
SELECT opfmethod, opfname, opfnamespace FROM pg_opfamily WHERE opfmethod = 403;
----
opfmethod	opfname	opfnamespace


query
SELECT opfmethod, opfname, opfnamespace FROM pg_opfamily WHERE oid IN (1976, 1994);
----
opfmethod	opfname	opfnamespace


query
SELECT count(*) AS n FROM pg_catalog.pg_opfamily x JOIN pg_type t ON t.oid = 23;
----
n
0
