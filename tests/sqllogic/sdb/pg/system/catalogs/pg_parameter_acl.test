query
SELECT oid, relname, relkind, relnamespace::regnamespace::text AS nsp, relnatts
FROM pg_class WHERE oid = 'pg_parameter_acl'::regclass;
----
oid	relname	relkind	nsp	relnatts
6243	pg_parameter_acl	r	pg_catalog	3


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute WHERE attrelid = 'pg_parameter_acl'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
parname	text	t
paracl	aclitem[]	f


query
SELECT count(*) >= 0 AS readable FROM pg_parameter_acl;
----
readable
t


