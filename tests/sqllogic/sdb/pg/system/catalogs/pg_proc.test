CREATE FUNCTION rubick_prc_steal(dist int4, dmg int4) RETURNS int4 LANGUAGE sql AS 'SELECT dist * dmg';


statement ok
CREATE FUNCTION rubick_prc_lift() RETURNS text LANGUAGE sql AS $$SELECT 'lifted'$$;


query
SELECT proname, pronamespace::regnamespace::text AS nsp, proowner::regrole::text AS owner, prolang, procost, prorows, provariadic, prosupport::text AS prosupport, prokind, prosecdef, proleakproof, proisstrict, proretset, provolatile, proparallel, pronargs, pronargdefaults, prorettype::regtype::text AS rettype, proargnames, proconfig IS NULL AS no_config, proacl IS NULL AS no_acl
FROM pg_proc
WHERE proname IN ('rubick_prc_steal', 'rubick_prc_lift')
ORDER BY proname;
----
proname	nsp	owner	prolang	procost	prorows	provariadic	prosupport	prokind	prosecdef	proleakproof	proisstrict	proretset	provolatile	proparallel	pronargs	pronargdefaults	rettype	proargnames	no_config	no_acl
rubick_prc_lift	public	postgres	14	100	0	0	-	f	f	f	f	f	v	u	0	0	text	NULL	t	t
rubick_prc_steal	public	postgres	14	100	0	0	-	f	f	f	f	f	v	u	2	0	integer	{dist,dmg}	t	t


query
SELECT p.oid::regprocedure::text AS sig, p.oid::regproc::text AS name, pg_get_function_arguments(p.oid) AS args, pg_get_function_identity_arguments(p.oid) AS identity, pg_get_function_result(p.oid) AS result
FROM pg_proc p
WHERE p.proname IN ('rubick_prc_steal', 'rubick_prc_lift')
ORDER BY p.proname;
----
sig	name	args	identity	result
rubick_prc_lift()	rubick_prc_lift	(empty)	(empty)	text
rubick_prc_steal(integer,integer)	rubick_prc_steal	dist integer, dmg integer	dist integer, dmg integer	integer


query
SELECT 'rubick_prc_steal'::regproc = 'rubick_prc_steal(int4,int4)'::regprocedure AS same, to_regprocedure('rubick_prc_steal(integer,integer)') IS NOT NULL AS found, to_regprocedure('rubick_prc_steal(text)') IS NULL AS wrong_sig;
----
same	found	wrong_sig
t	t	t


query
SELECT p.proname, t.typname
FROM pg_proc p JOIN pg_type t ON t.oid = p.prorettype
WHERE p.proname LIKE 'rubick\_prc\_%'
ORDER BY p.proname;
----
proname	typname
rubick_prc_lift	text
rubick_prc_steal	int4


query
SELECT count(*) AS diff
FROM (
  (SELECT oid, proname, pronargs FROM pg_proc WHERE oid IN ('rubick_prc_steal'::regproc, 'rubick_prc_lift'::regproc)
   EXCEPT
   SELECT oid, proname, pronargs FROM pg_proc WHERE proname IN ('rubick_prc_steal', 'rubick_prc_lift'))
  UNION ALL
  (SELECT oid, proname, pronargs FROM pg_proc WHERE proname IN ('rubick_prc_steal', 'rubick_prc_lift')
   EXCEPT
   SELECT oid, proname, pronargs FROM pg_proc WHERE oid IN ('rubick_prc_steal'::regproc, 'rubick_prc_lift'::regproc))
) d;
----
diff
0


query
SELECT rubick_prc_steal(3, 4) AS stolen, rubick_prc_lift() AS lifted;
----
stolen	lifted
12	lifted


