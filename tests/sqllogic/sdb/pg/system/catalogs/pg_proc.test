query
SELECT p.proname, p.prokind, p.proretset, p.pronargs, p.proargnames, l.lanname
FROM pg_proc p JOIN pg_language l ON l.oid = p.prolang
WHERE p.proname IN ('rubick_prc_echo', 'rubick_prc_spells')
ORDER BY p.proname;
----
proname	prokind	proretset	pronargs	proargnames	lanname
rubick_prc_echo	f	f	1	{a}	sql
rubick_prc_spells	f	t	1	{n}	sql


