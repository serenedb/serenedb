query
SELECT
  (SELECT count(*) FROM pg_proc WHERE proname LIKE 'rubick\_prc\_%') AS by_name,
  (SELECT count(*) FROM pg_proc WHERE oid IN (SELECT steal FROM rubick_prc_saved UNION ALL SELECT lift FROM rubick_prc_saved)) AS by_oid,
  to_regproc('rubick_prc_steal') IS NULL AS gone;
----
by_name	by_oid	gone
0	0	t


