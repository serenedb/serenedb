query
SELECT a.attname, t.typname, a.attnotnull
FROM pg_attribute a
JOIN pg_type t ON t.oid = a.atttypid
WHERE a.attrelid = 'pg_catalog.pg_publication_rel'::regclass AND a.attnum > 0
ORDER BY a.attnum;
----
attname	typname	attnotnull
oid	oid	t
prpubid	oid	t
prrelid	oid	t
prqual	pg_node_tree	f
prattrs	int2vector	f


