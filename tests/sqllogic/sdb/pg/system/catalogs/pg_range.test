query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_range'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
rngtypid	oid	t
rngsubtype	oid	t
rngmultitypid	oid	t
rngcollation	oid	t
rngsubopc	oid	t
rngcanonical	regproc	t
rngsubdiff	regproc	t


query
SELECT c.oid, c.relname, c.relkind, c.relnamespace::regnamespace::text AS nsp, c.relnatts, c.reltype::regtype::text AS rowtype, c.relisshared
FROM pg_class c
WHERE c.oid = 'pg_range'::regclass;
----
oid	relname	relkind	nsp	relnatts	rowtype	relisshared
3541	pg_range	r	pg_catalog	7	pg_range	f


query
SELECT t.typname, t.typtype, t.typrelid = 'pg_range'::regclass AS linked, a.typname AS array_name
FROM pg_type t JOIN pg_type a ON a.oid = t.typarray
WHERE t.typname = 'pg_range';
----
typname	typtype	linked	array_name
pg_range	c	t	_pg_range


query
SELECT count(*) AS n FROM pg_range;
----
n
0


query
SELECT rngtypid, rngsubtype, rngmultitypid FROM pg_range ORDER BY 1;
----
rngtypid	rngsubtype	rngmultitypid


query
SELECT rngtypid, rngsubtype, rngmultitypid FROM pg_range WHERE rngtypid = 3904;
----
rngtypid	rngsubtype	rngmultitypid


query
SELECT rngtypid, rngsubtype, rngmultitypid FROM pg_range WHERE rngtypid IN (3904, 3906, 3926);
----
rngtypid	rngsubtype	rngmultitypid


query
SELECT count(*) AS n FROM pg_catalog.pg_range x JOIN pg_type t ON t.oid = 23;
----
n
0


query
SELECT t.oid, t.typname, t.typtype, t.typcategory, t.typarray, t.typinput::text AS typinput
FROM pg_type t
WHERE t.typtype IN ('r', 'm')
ORDER BY t.oid;
----
oid	typname	typtype	typcategory	typarray	typinput
