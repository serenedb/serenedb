query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_replication_origin'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
roident	oid	t
roname	text	t


