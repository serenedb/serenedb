statement ok
DROP ROLE IF EXISTS sven_repo_cleave;


statement ok
CREATE ROLE sven_repo_cleave LOGIN PASSWORD 'sven_repo_cleave_pw';


query
SELECT oid::int AS oid, relname, relkind, relnatts FROM pg_class WHERE oid = 'pg_catalog.pg_replication_origin'::regclass;
----
oid	relname	relkind	relnatts
6000	pg_replication_origin	r	2


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_replication_origin'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
roident	oid	t
roname	text	t


control substitution on

statement ok
SELECT pg_replication_origin_create('sven_repo_cleave_${__DATABASE__}');


query
SELECT roident = pg_replication_origin_oid('sven_repo_cleave_${__DATABASE__}') AS same_ident
FROM pg_replication_origin WHERE roname = 'sven_repo_cleave_${__DATABASE__}';
----
same_ident
t


query
SELECT roident FROM pg_replication_origin WHERE roname = 'sven_repo_cleave';
----
roident


query
SELECT roname FROM pg_replication_origin WHERE roident = 0;
----
roname


connection sven_conn user=sven_repo_cleave password=sven_repo_cleave_pw
query
