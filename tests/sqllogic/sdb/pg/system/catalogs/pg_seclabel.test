query
SELECT oid, relkind, relnatts, relisshared, reltype, relnamespace::regnamespace::text AS nsp
FROM pg_class
WHERE relname = 'pg_seclabel';
----
oid	relkind	relnatts	relisshared	reltype	nsp
3596	r	5	f	10092	pg_catalog


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_seclabel'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
objoid	oid	t
classoid	oid	t
objsubid	integer	t
provider	text	t
label	text	t


