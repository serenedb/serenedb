CREATE SEQUENCE tango_seq_fake_pk_seq;


query
SELECT c.relname, count(s.seqrelid) AS listed
FROM pg_class c LEFT JOIN pg_sequence s ON s.seqrelid = c.oid
WHERE c.relkind = 'S' AND c.relname IN ('tango_seq_search_pk_seq', 'tango_seq_fake_pk_seq')
GROUP BY c.relname ORDER BY c.relname;
----
relname	listed
tango_seq_fake_pk_seq	1


