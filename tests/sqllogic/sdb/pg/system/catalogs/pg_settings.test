query
SELECT name, setting, source, boot_val, reset_val
FROM pg_settings
WHERE name IN ('bytea_output', 'IntervalStyle', 'DateStyle', 'extra_float_digits')
ORDER BY lower(name);
----
name	setting	source	boot_val	reset_val
bytea_output	escape	session	hex	hex
DateStyle	SQL, DMY	session	ISO, MDY	ISO, MDY
extra_float_digits	2	session	1	1
IntervalStyle	iso_8601	session	postgres	postgres


query
SELECT name, setting = current_setting(name) AS same
FROM pg_settings
WHERE name IN ('bytea_output', 'IntervalStyle', 'DateStyle', 'extra_float_digits',
               'standard_conforming_strings', 'server_version_num', 'client_encoding')
ORDER BY lower(name);
----
name	same
bytea_output	t
client_encoding	t
DateStyle	t
extra_float_digits	t
IntervalStyle	t
server_version_num	t
standard_conforming_strings	t


