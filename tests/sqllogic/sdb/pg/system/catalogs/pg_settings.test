query
SELECT pg_get_viewdef('pg_catalog.pg_settings'::regclass) LIKE '%pg_show_all_settings()%' AS from_function,
       (SELECT count(*) FROM pg_show_all_settings()) = (SELECT count(*) FROM pg_settings) AS same_rows;
----
from_function	same_rows
t	t


query
SELECT name, unit, category, short_desc, context, vartype, min_val, max_val, enumvals
FROM pg_settings
WHERE name IN ('DateStyle', 'IntervalStyle', 'bytea_output', 'client_min_messages',
               'statement_timeout', 'work_mem', 'standard_conforming_strings',
               'server_version_num', 'extra_float_digits', 'max_identifier_length',
               'block_size', 'default_transaction_isolation')
ORDER BY lower(name);
----
name	unit	category	short_desc	context	vartype	min_val	max_val	enumvals
bytea_output	NULL	Customized Options	Sets the output format for bytea.	user	string	NULL	NULL	NULL
client_min_messages	NULL	Customized Options	Sets the message levels that are sent to the client.	user	string	NULL	NULL	NULL
DateStyle	NULL	Customized Options	Sets the display format for date and time values.	user	string	NULL	NULL	NULL
default_transaction_isolation	NULL	Customized Options	Sets the transaction isolation level of each new transaction.	user	string	NULL	NULL	NULL
extra_float_digits	NULL	Customized Options	Sets the number of digits displayed for floating-point values.	user	integer	NULL	NULL	NULL
IntervalStyle	NULL	Customized Options	Sets the display format for interval values.	user	string	NULL	NULL	NULL
max_identifier_length	NULL	Customized Options	Shows the maximum identifier length. SereneDB keeps longer identifiers in full.	internal	integer	NULL	NULL	NULL
server_version_num	NULL	Customized Options	Shows the server version as an integer.	internal	integer	NULL	NULL	NULL
standard_conforming_strings	NULL	Customized Options	Causes '...' strings to treat backslashes literally.	user	bool	NULL	NULL	NULL
statement_timeout	NULL	Customized Options	Aborts any statement that takes more than the specified amount of time (milliseconds without a unit). 0 disables the timeout.	user	string	NULL	NULL	NULL


query
SELECT name, boot_val
FROM pg_settings
WHERE name IN ('DateStyle', 'IntervalStyle', 'bytea_output', 'client_min_messages',
               'statement_timeout', 'work_mem', 'standard_conforming_strings',
               'server_version_num', 'extra_float_digits', 'max_identifier_length',
               'block_size')
ORDER BY lower(name);
----
name	boot_val
bytea_output	hex
client_min_messages	notice
DateStyle	ISO, MDY
extra_float_digits	1
IntervalStyle	postgres
max_identifier_length	63
server_version_num	180006
standard_conforming_strings	on
statement_timeout	0


query
SELECT name, setting, boot_val, vartype
FROM pg_settings
WHERE name IN ('lc_messages', 'lc_monetary', 'lc_numeric', 'lc_time',
               'default_text_search_config', 'server_version')
ORDER BY name;
----
name	setting	boot_val	vartype
server_version	18.6	18.6	string


query
SELECT name, setting
FROM pg_settings
WHERE name IN ('block_size', 'client_encoding', 'server_encoding', 'integer_datetimes',
               'in_hot_standby', 'max_identifier_length', 'server_version_num')
ORDER BY name;
----
name	setting
client_encoding	UTF8
in_hot_standby	off
integer_datetimes	on
max_identifier_length	63
server_encoding	UTF8
server_version_num	180006


query
SELECT count(*) = count(DISTINCT name) AS unique_names,
       count(*) FILTER (WHERE name IS NULL OR short_desc IS NULL OR context IS NULL
                        OR vartype IS NULL OR category IS NULL) AS incomplete
FROM pg_settings;
----
unique_names	incomplete
t	0


