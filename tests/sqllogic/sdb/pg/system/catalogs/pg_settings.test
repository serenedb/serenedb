query
SELECT count(*) AS mismatched
FROM (
  (SELECT * FROM pg_settings
   WHERE name IN ('bytea_output', 'IntervalStyle', 'DateStyle', 'work_mem', 'lc_time'))
  EXCEPT
  (SELECT * FROM pg_settings
   WHERE name || '' IN ('bytea_output', 'IntervalStyle', 'DateStyle', 'work_mem', 'lc_time'))
) AS diff;
----
mismatched
0


