FROM pg_shdepend d
WHERE d.refobjid = 'roshan_shd_owner'::regrole AND d.deptype = 'o'
  AND d.classid = 'pg_class'::regclass AND d.objid = 'roshan_shd_pit.aegis'::regclass;
