query
SELECT oid, relkind, relnatts, reltype, relnamespace::regnamespace::text AS nsp
FROM pg_class
WHERE relname = 'pg_shdepend';
----
oid	relkind	relnatts	reltype	nsp
1214	r	7	10060	pg_catalog


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_shdepend'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
dbid	oid	t
classid	oid	t
objid	oid	t
objsubid	integer	t
refclassid	oid	t
refobjid	oid	t
deptype	"char"	t


