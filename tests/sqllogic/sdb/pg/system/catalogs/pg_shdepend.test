FROM pg_shdepend d
WHERE d.refobjid = 'roshan_shd_owner'::regrole
  AND d.objid IN ('roshan_shd_pit.aegis'::regclass::oid, 'roshan_shd_pit'::regnamespace::oid)
ORDER BY 1, 2;
