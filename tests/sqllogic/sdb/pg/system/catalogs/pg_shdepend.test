deptype
o


query
SELECT d.refobjid::regrole::text AS role, d.deptype
FROM pg_shdepend d JOIN pg_default_acl a ON a.oid = d.objid
WHERE d.classid = 'pg_default_acl'::regclass
  AND d.dbid = (SELECT oid FROM pg_database WHERE datname = current_database())
  AND a.defaclrole = 'roshan_shd_owner'::regrole
  AND a.defaclnamespace = 'roshan_shd_pit'::regnamespace
ORDER BY 1;
----
role	deptype
roshan_shd_owner	o
roshan_shd_reader	a


