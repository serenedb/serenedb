statement ok
ALTER TYPE roshan_shd_pit.drop OWNER TO roshan_shd_owner;


query
SELECT d.dbid = (SELECT oid FROM pg_database WHERE datname = current_database()) AS this_db,
       d.classid::regclass::text AS class,
       CASE d.classid
         WHEN 'pg_class'::regclass THEN d.objid::regclass::text
         WHEN 'pg_namespace'::regclass THEN d.objid::regnamespace::text
         WHEN 'pg_type'::regclass THEN d.objid::regtype::text
       END AS obj,
       d.objsubid, d.refclassid::regclass::text AS refclass,
       d.refobjid::regrole::text AS role, d.deptype
FROM pg_shdepend d
WHERE d.refobjid = 'roshan_shd_owner'::regrole
ORDER BY 2, 3;
----
this_db	class	obj	objsubid	refclass	role	deptype
t	pg_class	roshan_shd_pit.aegis	0	pg_authid	roshan_shd_owner	o
t	pg_class	roshan_shd_pit.lair	0	pg_authid	roshan_shd_owner	o
t	pg_class	roshan_shd_pit.respawn	0	pg_authid	roshan_shd_owner	o
t	pg_namespace	roshan_shd_pit	0	pg_authid	roshan_shd_owner	o
t	pg_type	roshan_shd_pit.drop	0	pg_authid	roshan_shd_owner	o


