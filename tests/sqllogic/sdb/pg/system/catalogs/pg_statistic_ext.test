query
SELECT oid, relkind, relnatts, relisshared, relpersistence, reltype
FROM pg_class
WHERE relname = 'pg_statistic_ext';
----
oid	relkind	relnatts	relisshared	relpersistence	reltype
3381	r	9	f	p	10031


query
SELECT attname, atttypid, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_statistic_ext'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	atttypid	attnotnull
oid	26	t
stxrelid	26	t
stxname	19	t
stxnamespace	26	t
stxowner	26	t
stxkeys	22	t
stxstattarget	21	f
stxkind	1002	t
stxexprs	194	f


query
SELECT attname, format_type(atttypid, atttypmod) AS type
FROM pg_attribute
WHERE attrelid = 'pg_statistic_ext'::regclass AND attnum > 0 AND attname <> 'stxkeys'
ORDER BY attnum;
----
attname	type
oid	oid
stxrelid	oid
stxname	name
stxnamespace	oid
stxowner	oid
stxstattarget	smallint
stxkind	"char"[]
stxexprs	pg_node_tree


