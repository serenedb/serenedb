query
SELECT oid, relkind, relnatts, relisshared, reltype, relnamespace::regnamespace::text AS nsp
FROM pg_class
WHERE relname = 'pg_trigger';
----
oid	relkind	relnatts	relisshared	reltype	nsp
2620	r	19	f	10037	pg_catalog


query
SELECT attname, atttypid, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_trigger'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	atttypid	attnotnull
oid	26	t
tgrelid	26	t
tgparentid	26	t
tgname	19	t
tgfoid	26	t
tgtype	21	t
