query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_ts_config'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
cfgname	name	t
cfgnamespace	oid	t
cfgowner	oid	t
cfgparser	oid	t


