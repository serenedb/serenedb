oid	relname	relkind	relnatts
3603	pg_ts_config_map	r	4


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_ts_config_map'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
mapcfg	oid	t
maptokentype	integer	t
mapseqno	integer	t
mapdict	oid	t


statement ok
