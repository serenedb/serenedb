dictname


statement ok
CREATE TEXT SEARCH DICTIONARY pudge_tsd_hook AS keyword() WITH (frequency);


statement ok
CREATE SCHEMA pudge_tsd_ns;


statement ok
CREATE TEXT SEARCH DICTIONARY pudge_tsd_ns.pudge_tsd_rot AS split_text_csv(' ');


query
SELECT d.dictname, n.nspname, d.dictowner = (SELECT oid FROM pg_roles WHERE rolname = current_user) AS mine, d.dictinitoption IS NULL AS no_initoption
FROM pg_ts_dict d
JOIN pg_namespace n ON n.oid = d.dictnamespace
WHERE d.dictname LIKE 'pudge_tsd%'
ORDER BY d.dictname;
----
dictname	nspname	mine	no_initoption
pudge_tsd_hook	public	t	t
pudge_tsd_rot	pudge_tsd_ns	t	t


query
SELECT oid::regdictionary::text AS dict FROM pg_ts_dict WHERE dictname LIKE 'pudge_tsd%' ORDER BY 1;
----
dict
pudge_tsd_hook
pudge_tsd_ns.pudge_tsd_rot


query
