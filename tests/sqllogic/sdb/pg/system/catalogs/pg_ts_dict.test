query
SELECT oid::int AS oid, relname, relkind, relnatts FROM pg_class WHERE oid = 'pg_catalog.pg_ts_dict'::regclass;
----
oid	relname	relkind	relnatts
3600	pg_ts_dict	r	6


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_ts_dict'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
dictname	name	t
dictnamespace	oid	t
dictowner	oid	t
dicttemplate	oid	t
dictinitoption	text	f


query
SELECT dictname FROM pg_ts_dict WHERE dictname LIKE 'pudge_tsd%';
