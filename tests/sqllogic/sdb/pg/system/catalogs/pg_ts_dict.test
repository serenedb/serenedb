dictname
pudge_tsd_rot


query
SELECT 'PUDGE_TSD_HOOK'::regdictionary::text AS upper_name, '"pudge_tsd_hook"'::regdictionary::text AS quoted, 'public.pudge_tsd_hook'::regdictionary::text AS qualified;
----
upper_name	quoted	qualified
pudge_tsd_hook	pudge_tsd_hook	pudge_tsd_hook


