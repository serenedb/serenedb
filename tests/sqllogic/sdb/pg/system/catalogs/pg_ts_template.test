query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'pg_catalog.pg_ts_template'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
oid	oid	t
tmplname	name	t
tmplnamespace	oid	t
tmplinit	regproc	t
tmpllexize	regproc	t


