query
SELECT count(*) AS diff
FROM (
  (SELECT oid, typname, typtype, typelem, typarray, typrelid, typinput FROM pg_type
   WHERE oid IN ('pudge_typ_mood'::regtype, '_pudge_typ_hook'::regtype, 'pudge_typ_meat'::regtype, 'pudge_typ_dmg'::regtype, 16, 25, 1007, 13307)
   EXCEPT
   SELECT oid, typname, typtype, typelem, typarray, typrelid, typinput FROM pg_type
   WHERE oid::int8 + 0 IN ('pudge_typ_mood'::regtype::int8, '_pudge_typ_hook'::regtype::int8, 'pudge_typ_meat'::regtype::int8, 'pudge_typ_dmg'::regtype::int8, 16, 25, 1007, 13307))
  UNION ALL
  (SELECT oid, typname, typtype, typelem, typarray, typrelid, typinput FROM pg_type
   WHERE oid::int8 + 0 IN ('pudge_typ_mood'::regtype::int8, '_pudge_typ_hook'::regtype::int8, 'pudge_typ_meat'::regtype::int8, 'pudge_typ_dmg'::regtype::int8, 16, 25, 1007, 13307)
   EXCEPT
   SELECT oid, typname, typtype, typelem, typarray, typrelid, typinput FROM pg_type
   WHERE oid IN ('pudge_typ_mood'::regtype, '_pudge_typ_hook'::regtype, 'pudge_typ_meat'::regtype, 'pudge_typ_dmg'::regtype, 16, 25, 1007, 13307))
) d;
----
diff
0


