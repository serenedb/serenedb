query
SELECT oid, typname, typnamespace, typlen, typbyval, typtype, typcategory, typispreferred, typisdefined, typdelim, typrelid, typsubscript::text AS typsubscript, typelem, typarray, typinput::text AS typinput, typoutput::text AS typoutput, typreceive::text AS typreceive, typsend::text AS typsend, typmodin::text AS typmodin, typmodout::text AS typmodout, typanalyze::text AS typanalyze, typalign, typstorage, typnotnull, typbasetype, typtypmod, typndims, typcollation
FROM pg_type
WHERE oid IN (16, 23, 25, 83, 1007, 1043, 1700)
ORDER BY oid;
