query
SELECT n.nspname, t.typtype, count(*) AS n
FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace
WHERE t.oid < 16384 AND NOT (n.nspname = 'pg_catalog' AND t.typtype = 'b')
GROUP BY n.nspname, t.typtype
ORDER BY n.nspname, t.typtype;
----
