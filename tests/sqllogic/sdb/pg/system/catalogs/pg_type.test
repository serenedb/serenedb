query
SELECT
  (SELECT count(*) FROM pg_type t WHERE t.typinput <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typinput)) AS d_in,
  (SELECT count(*) FROM pg_type t WHERE t.typoutput <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typoutput)) AS d_out,
  (SELECT count(*) FROM pg_type t WHERE t.typreceive <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typreceive)) AS d_recv,
  (SELECT count(*) FROM pg_type t WHERE t.typsend <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typsend)) AS d_send,
  (SELECT count(*) FROM pg_type t WHERE t.typmodin <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typmodin)) AS d_modin,
  (SELECT count(*) FROM pg_type t WHERE t.typmodout <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typmodout)) AS d_modout,
  (SELECT count(*) FROM pg_type t WHERE t.typanalyze <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typanalyze)) AS d_analyze,
  (SELECT count(*) FROM pg_type t WHERE t.typsubscript <> 0 AND NOT EXISTS (SELECT 1 FROM pg_proc p WHERE p.oid = t.typsubscript)) AS d_subscript,
  (SELECT count(*) FROM pg_type t WHERE (t.oid < 16384 OR t.typname LIKE '%pudge\_typ\_%') AND (t.typinput = 0 OR t.typoutput = 0)) AS no_io;
----
d_in	d_out	d_recv	d_send	d_modin	d_modout	d_analyze	d_subscript	no_io
0	0	0	0	0	0	0	0	0


query
SELECT
  (SELECT count(*) FROM pg_type t WHERE t.typarray <> 0 AND NOT EXISTS (SELECT 1 FROM pg_type a WHERE a.oid = t.typarray AND a.typelem = t.oid)) AS bad_array,
  (SELECT count(*) FROM pg_type t WHERE t.typnamespace NOT IN (SELECT oid FROM pg_namespace)) AS bad_namespace,
  (SELECT count(*) FROM pg_type t WHERE t.typrelid <> 0 AND NOT EXISTS (SELECT 1 FROM pg_class c WHERE c.oid = t.typrelid AND c.reltype = t.oid)) AS bad_relid,
  (SELECT count(*) FROM pg_type t WHERE t.typcollation <> 0 AND NOT EXISTS (SELECT 1 FROM pg_collation c WHERE c.oid = t.typcollation)) AS bad_collation,
  (SELECT count(*) FROM pg_type t WHERE t.typbasetype <> 0 AND NOT EXISTS (SELECT 1 FROM pg_type b WHERE b.oid = t.typbasetype)) AS bad_base,
  (SELECT count(*) - count(DISTINCT oid) FROM pg_type) AS dup_oid,
  (SELECT count(*) - count(DISTINCT (typname, typnamespace)) FROM pg_type) AS dup_name;
----
bad_array	bad_namespace	bad_relid	bad_collation	bad_base	dup_oid	dup_name
0	0	0	0	0	0	0


query
SELECT a.typname
FROM pg_type a
