1043	varchar	11	-1	f	b	S	f	t	,	0	-	0	1015	varcharin	varcharout	varcharrecv	varcharsend	varchartypmodin	varchartypmodout	-	i	x	f	0	-1	0	100
1700	numeric	11	-1	f	b	N	f	t	,	0	-	0	1231	numeric_in	numeric_out	numeric_recv	numeric_send	numerictypmodin	numerictypmodout	-	i	m	f	0	-1	0	0


