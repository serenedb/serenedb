CREATE ROLE sven_metrics_cleave LOGIN PASSWORD 'sven_metrics_pw';


query
SELECT c.relkind, n.nspname, c.relnatts
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname = 'sdb_metrics';
----
relkind	nspname	relnatts
r	pg_catalog	4


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'sdb_metrics'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
metric	text	f
value	bigint	f
description	text	f
relation_id	oid	f


query
SELECT metric, description
FROM sdb_metrics
WHERE relation_id IS NULL
ORDER BY metric;
----
metric	description
catalog_wal_appended_bytes	bytes appended to the catalog wal since start
catalog_wal_size_on_disk	current catalog wal file size in bytes
cleanup_active	Search cleanup tasks currently running
cleanup_pending	Search cleanup tasks waiting to run
compaction_active	Search compaction tasks currently running
compaction_pending	Search compaction tasks waiting to run
http_connections	Open HTTP client connections
pg_connections	Open pg-wire client connections


query
SELECT count(*) FILTER (WHERE value IS NULL OR value < 0) AS bad_values,
       count(*) FILTER (WHERE metric IS NULL OR description IS NULL) AS unnamed
FROM sdb_metrics;
----
bad_values	unnamed
0	0


query
SELECT value >= 1 AS counts_me FROM sdb_metrics WHERE metric = 'pg_connections';
----
counts_me
t


statement ok
CREATE TABLE sven_storm_hammer (id BIGINT PRIMARY KEY, body TEXT) WITH (compaction_interval = 0);


statement ok
CREATE INDEX sven_storm_hammer_idx ON sven_storm_hammer USING inverted (body);


statement ok
INSERT INTO sven_storm_hammer VALUES (1, 'pudge hook'), (2, 'sven cleave'), (3, 'roshan aegis');


query
SELECT metric, value
FROM sdb_metrics
WHERE relation_id = 'sven_storm_hammer'::regclass
  AND metric IN ('num_failed_cleanups', 'num_failed_consolidations')
ORDER BY metric;
----
metric	value
num_failed_cleanups	0
num_failed_consolidations	0


query
SELECT sum(value) AS docs
FROM sdb_metrics
WHERE relation_id = 'sven_storm_hammer'::regclass
  AND metric IN ('num_docs', 'num_buffered_docs');
----
docs
3


query
SELECT metric, description
FROM sdb_metrics
WHERE relation_id = 'sven_storm_hammer'::regclass
ORDER BY metric;
----
metric	description
avg_cleanup_time_ms	average time of the last few cleanups, in ms
avg_consolidation_time_ms	average time of the last few consolidations, in ms
index_size	on-disk index size in bytes
num_buffered_docs	documents held in memory, not yet written to a segment
num_docs	documents in the index (including deleted)
num_failed_cleanups	failed cleanup operations
num_failed_consolidations	failed consolidation operations
num_files	files backing the index
num_live_docs	live (non-deleted) documents
num_segments	index segments


query
SELECT count(*) AS storage_less_index_rows
FROM sdb_metrics
WHERE relation_id = 'sven_storm_hammer_idx'::regclass;
----
storage_less_index_rows
0


statement ok
DELETE FROM sven_storm_hammer WHERE id = 3;


query
SELECT metric, value
FROM sdb_metrics
WHERE relation_id = 'sven_storm_hammer'::regclass AND metric = 'num_live_docs';
----
metric	value
num_live_docs	2


query
SELECT count(*) FILTER (WHERE metric IN ('index_size', 'num_files') AND value > 0) AS sized
FROM sdb_metrics
WHERE relation_id = 'sven_storm_hammer'::regclass;
----
sized
2


