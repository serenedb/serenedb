statement ok
DROP ROLE IF EXISTS courier_licenses_reader;


statement ok
CREATE ROLE courier_licenses_reader LOGIN PASSWORD 'courier_licenses_pw';


query
SELECT c.relkind, n.nspname, c.relnatts
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname = 'serenedb_licenses';
----
relkind	nspname	relnatts
r	pg_catalog	5


query
SELECT attname, format_type(atttypid, atttypmod) AS type, attnotnull
FROM pg_attribute
WHERE attrelid = 'serenedb_licenses'::regclass AND attnum > 0
ORDER BY attnum;
----
attname	type	attnotnull
name	text	f
license	text	f
url	text	f
license_file	text	f
license_text	text	f


query
SELECT name, license, url, license_file
FROM serenedb_licenses
WHERE name IN ('Abseil', 'ALP', 'DuckDB', 'SereneDB')
ORDER BY lower(name), license_file;
----
name	license	url	license_file
Abseil	Apache-2.0	https://abseil.io	third_party/abseil-cpp/LICENSE
ALP	MIT	https://github.com/cwida/ALP	third_party/duckdb/src/include/duckdb/storage/compression/alp/algorithm/LICENSE
DuckDB	MIT	https://duckdb.org	third_party/duckdb/LICENSE
SereneDB	Apache-2.0	https://github.com/serenedb/serenedb	LICENSE
SereneDB	Apache-2.0	https://github.com/serenedb/serenedb	NOTICE.md


query
SELECT license_text LIKE 'Copyright 2018-% Stichting DuckDB Foundation%' AS duckdb,
       (SELECT license_text LIKE '%Apache License%Version 2.0%'
        FROM serenedb_licenses WHERE license_file = 'LICENSE') AS serenedb
FROM serenedb_licenses
WHERE name = 'DuckDB';
----
duckdb	serenedb
t	t


query
SELECT count(*) FILTER (WHERE (license_file IS NULL) <> (license_text IS NULL)) AS mismatched,
       count(*) FILTER (WHERE license_file IS NULL AND license <> 'NOASSERTION') AS unexplained,
       count(*) FILTER (WHERE name IS NULL OR license IS NULL OR url IS NULL) AS incomplete,
       count(*) = count(DISTINCT name || ' ' || coalesce(license_file, '')) AS unique_rows
FROM serenedb_licenses;
----
mismatched	unexplained	incomplete	unique_rows
0	0	0	t


query
SELECT name, license, license_file IS NULL AS no_file
FROM serenedb_licenses
WHERE name IN ('TPC-DS dsdgen', 'TPC-H dbgen')
ORDER BY name;
----
name	license	no_file
TPC-DS dsdgen	LicenseRef-TPC-EULA	f
TPC-H dbgen	LicenseRef-TPC-EULA	f


connection courier_licenses user=courier_licenses_reader password=courier_licenses_pw
query
SELECT count(*) > 0 AS readable
FROM serenedb_licenses
WHERE name = 'SereneDB';
----
readable
t


