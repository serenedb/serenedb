statement ok
CREATE TEXT SEARCH DICTIONARY cdii_words AS
    split_text() | normalize_tokens('en_US.UTF-8', accent := false)
    WITH (frequency, position);


statement ok
CREATE TABLE docs (id INT, body TEXT);


statement ok
INSERT INTO docs VALUES (1, 'pudge goes mid'), (2, 'anchin reads manga'), (3, 'pudge plays again');


statement ok
CREATE INDEX docs_body ON docs USING inverted (id, body cdii_words);


statement ok
USE ${__DATABASE__};


statement ok
