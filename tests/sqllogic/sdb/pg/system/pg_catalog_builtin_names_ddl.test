# A pg_catalog name resolves to a built-in only when pg_catalog has no entry of
# its own, so creating and dropping functions and macros there under built-in
# names still works on the schema's own entries.

statement ok
CREATE FUNCTION pg_catalog.concat_ws(a text) RETURNS text LANGUAGE sql AS 'SELECT a';


statement ok
DROP FUNCTION pg_catalog.concat_ws(text);


statement ok
CREATE FUNCTION pg_catalog.generate_series(a int) RETURNS TABLE (x int) LANGUAGE sql AS 'SELECT a';


statement ok
DROP FUNCTION pg_catalog.generate_series(int);


statement ok
CREATE MACRO pg_catalog.string_agg(a) AS a;


statement ok
DROP MACRO pg_catalog.string_agg;


query
SELECT pg_catalog.concat_ws(', ', 'a', 'b') AS v;
----
v
a, b
