connection c_shd database=shd_sub_db
query
SELECT s.deptype, s.dbid = (SELECT oid FROM pg_database WHERE datname = 'shd_sub_db') AS in_shd_sub_db,
       s.objid = (SELECT oid FROM pg_subscription WHERE subname = 'shd_sub') AS is_shd_sub
FROM pg_shdepend s
JOIN pg_authid a ON a.oid = s.refobjid
WHERE a.rolname = 'shd_sub_owner' AND s.classid = 'pg_subscription'::regclass;
