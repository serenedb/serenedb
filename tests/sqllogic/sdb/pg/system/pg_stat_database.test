connection c_rubick_a database=rubick_stat_db
query
SELECT d.xact_rollback - b.xact_rollback AS rollbacks,
       d.sessions - b.sessions AS new_sessions,
       d.session_time > b.session_time AS session_time_grew,
       d.active_time > b.active_time AS active_time_grew,
       d.idle_in_transaction_time > b.idle_in_transaction_time AS idle_in_transaction_grew,
       d.session_time >= d.active_time + d.idle_in_transaction_time AS session_covers_states
FROM pg_stat_database d, stat_before b
WHERE d.datname = current_database();
----
rollbacks	new_sessions	session_time_grew	active_time_grew	idle_in_transaction_grew	session_covers_states
1	1	t	t	t	t


