SELECT r.name, c.reltype <> 0 AS has_row_type, pg_type_is_visible(c.reltype) AS row_type, pg_type_is_visible(t.typarray) AS row_array FROM reg_oids_rows r LEFT JOIN pg_class c ON c.oid = r.relation LEFT JOIN pg_type t ON t.oid = c.reltype ORDER BY r.name
