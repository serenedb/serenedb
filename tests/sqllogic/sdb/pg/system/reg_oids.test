CREATE TABLE reg_oids_rows AS SELECT name, relation::bigint AS relation FROM (VALUES ('missing', 999999), ('system table', 1259), ('system view', 'pg_stat_activity'::regclass::oid::bigint), ('table', 'reg_oids_t'::regclass::oid::bigint), ('view', 'reg_oids_v'::regclass::oid::bigint), ('key index', 'reg_oids_t_pkey'::regclass::oid::bigint), ('sequence', 'reg_oids_seq'::regclass::oid::bigint), ('composite type', 'reg_oids_pair'::regtype::oid::bigint)) AS v(name, relation)

