CREATE VIEW rs.v AS SELECT a, b FROM rs.t WHERE a > 0;


query
SELECT pg_get_viewdef('rs.v'::regclass) AS by_regclass,
       pg_get_viewdef('rs.v') AS by_name,
       pg_get_viewdef('rs.v', true) AS by_name_pretty,
       pg_get_viewdef('rs.v'::regclass, 80) AS wrapped;
----
by_regclass	by_name	by_name_pretty	wrapped
