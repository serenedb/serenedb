def
CREATE INDEX docs_idx ON rs.docs USING inverted (id, body rs.docs_text, emb ivf (metric=l2), lower(tag)) INCLUDE (j) WITH (row_group_size='122880', refresh_interval='1000', compaction_interval='0', cleanup_interval_step='1', segment_memory_max='268435456', segment_docs_max='0', compaction_max_segments='10', compaction_max_segments_bytes='5368709120', compaction_floor_segment_bytes='2097152') WHERE (id > 0)


