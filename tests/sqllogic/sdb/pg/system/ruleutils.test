CREATE TABLE rs.audit (a integer);


statement ok
CREATE TRIGGER t_ins AFTER INSERT ON rs.t FOR EACH ROW INSERT INTO rs.audit VALUES (NEW.a);


statement ok
CREATE TRIGGER t_upd BEFORE UPDATE OF a, b ON rs.t FOR EACH STATEMENT INSERT INTO rs.audit VALUES (0);


