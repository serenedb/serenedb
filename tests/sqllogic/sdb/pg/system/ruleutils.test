CREATE SCHEMA rs;


statement ok
CREATE TABLE rs.t (
  id integer PRIMARY KEY,
  a integer,
  b integer,
  c text,
  "Odd Col" integer,
  CONSTRAINT t_c_uq UNIQUE (c),
  CONSTRAINT t_ab_check CHECK (a > 0 AND b IS NOT NULL)
);


statement ok
CREATE INDEX t_plain ON rs.t (a, b);


statement ok
CREATE UNIQUE INDEX t_lower ON rs.t (lower(c));


statement ok
CREATE INDEX t_expr ON rs.t ((a + b));


statement ok
CREATE INDEX t_coalesce ON rs.t (coalesce(a, b));


statement ok
CREATE INDEX t_part ON rs.t (a) WHERE a > 10 AND b IS NOT NULL;


statement ok
CREATE INDEX "Odd Idx" ON rs.t ("Odd Col");


statement ok
CREATE UNIQUE INDEX t_incl ON rs.t (b) INCLUDE (c);


query
SELECT c.relname, pg_get_indexdef(c.oid) AS def
FROM pg_class c WHERE c.relnamespace = 'rs'::regnamespace AND c.relkind = 'i' ORDER BY c.relname;
----
relname	def
Odd Idx	CREATE INDEX "Odd Idx" ON rs.t USING secondary ("Odd Col")
t_c_uq	CREATE UNIQUE INDEX t_c_uq ON rs.t USING secondary (c)
t_coalesce	CREATE INDEX t_coalesce ON rs.t USING secondary (COALESCE(a, b))
t_expr	CREATE INDEX t_expr ON rs.t USING secondary (((a + b)))
t_incl	CREATE UNIQUE INDEX t_incl ON rs.t USING secondary (b)
t_lower	CREATE UNIQUE INDEX t_lower ON rs.t USING secondary (lower(c))
t_part	CREATE INDEX t_part ON rs.t USING secondary (a) WHERE ((a > 10) AND (b IS NOT NULL))
t_pkey	CREATE UNIQUE INDEX t_pkey ON rs.t USING secondary (id)
t_plain	CREATE INDEX t_plain ON rs.t USING secondary (a, b)


query
