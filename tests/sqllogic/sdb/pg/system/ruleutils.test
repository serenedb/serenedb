t_upd	CREATE TRIGGER t_upd BEFORE UPDATE OF a, b ON rs.t FOR EACH STATEMENT INSERT INTO rs.audit (VALUES (0))	CREATE TRIGGER t_upd BEFORE UPDATE OF a, b ON rs.t FOR EACH STATEMENT INSERT INTO rs.audit (VALUES (0))


