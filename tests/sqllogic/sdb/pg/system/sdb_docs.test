query
SELECT bool_or(path = 'sql/indexes/inverted/index.md' AND title = 'Creating an inverted index') FROM (
  SELECT path, title, BM25(sections_fts.tableoid) AS score
  FROM sdb_docs.sections_fts
  WHERE title @@ 'inverted index' OR content_text @@ 'inverted index'
  ORDER BY score DESC, path, title
  LIMIT 5
);
----
bool_or
t

query
SELECT count(*) > 0 FROM sdb_docs.sections_fts WHERE content_text @@ ts_phrase('inverted index');
----
?column?
t

query
SELECT list_contains(t, 'the'), list_contains(t, 'a'), list_contains(t, 'is'), list_contains(t, 'index'), list_contains(t, 'structur')
FROM (SELECT ts_lexize('sdb_docs.english', 'The index is a structure') AS t);
----
list_contains	list_contains	list_contains	list_contains	list_contains
f	f	t	t	t
