# Structure of the embedded docs, checked as invariants over every row so that
# adding or editing documentation pages does not touch this file. A path is
# either 'file.md' (a whole-page doc) or 'file.md#Title#Heading...' with the
# chain of headings, one unescaped '#' per level, spaces as '_'.

connection docs database=postgres
query
SELECT count(*) > 100 FROM sdb_docs.docs WHERE length(path) - length(replace(path, '#', '')) <= 1;
----
?column?
t

connection docs database=postgres
query
SELECT count(*) > 1000 FROM sdb_docs.docs WHERE position('#' IN path) > 0;
----
?column?
t

# Both kinds of doc exist.
connection docs database=postgres
query
SELECT count(*) > 10, count(*) FILTER (WHERE position('#' IN path) = 0) > 10 FROM sdb_docs.docs WHERE length(path) - length(replace(path, '#', '')) <= 1;
----
?column?	?column?
t	t

# A heading row's path ends with its own heading segment.
connection docs database=postgres
query
SELECT count(*) FROM sdb_docs.docs
WHERE position('#' IN path) > 0
  AND NOT ends_with(path, '#' || replace(replace(title, '#', '\#'), ' ', '_'));
----
count
0

# Rows without a heading parent (whole pages and title rows) carry no
# breadcrumb, and a split page has no bare file row next to its title row.
connection docs database=postgres
query
WITH rows AS (
  SELECT path, breadcrumb,
         left(path, length(path) - length(replace(replace(title, '#', '\#'), ' ', '_')) - 1) AS parent
  FROM sdb_docs.docs)
SELECT count(*) FILTER (WHERE breadcrumb <> ''),
       count(*) FILTER (WHERE position('#' IN path) > 0 AND EXISTS (SELECT 1 FROM sdb_docs.docs b WHERE b.path = rows.parent))
FROM rows WHERE position('#' IN path) = 0 OR position('#' IN parent) = 0;
----
count	count
0	0

# Every nested heading row has a parent row, its content is contained in the
# parent's (a heading carries everything nested under it), and its breadcrumb
# is the parent's chain.
connection docs database=postgres
query
WITH rows AS (
  SELECT path, title, breadcrumb, content,
         left(path, length(path) - length(replace(replace(title, '#', '\#'), ' ', '_')) - 1) AS parent
  FROM sdb_docs.docs WHERE position('#' IN path) > 0)
SELECT count(*) FILTER (WHERE p.path IS NULL),
       count(*) FILTER (WHERE position(c.content IN p.content) = 0),
       count(*) FILTER (WHERE c.breadcrumb <> CASE WHEN p.breadcrumb = '' THEN p.title ELSE p.breadcrumb || ' / ' || p.title END)
FROM rows c LEFT JOIN sdb_docs.docs p ON p.path = c.parent
WHERE position('#' IN c.parent) > 0;
----
count	count	count
0	0	0

connection docs database=postgres
query
SELECT count(*) FROM sdb_docs.docs WHERE title IS NULL OR title = '' OR content IS NULL OR content_text IS NULL;
----
count
0

connection docs database=postgres
query
SELECT count(*) FROM sdb_docs.docs WHERE content_text <> md_to_text(content);
----
count
0

# Nothing from the MDX source survives: frontmatter, imports, components,
# anchors, comments, formatting inside titles.
connection docs database=postgres
query
SELECT count(*) FROM sdb_docs.docs WHERE content LIKE '---%' OR content LIKE '%import SqlLogicTest%' OR content LIKE '%<SqlLogicTest%' OR content LIKE '%<DocCallout%' OR content LIKE '%{#%' OR content LIKE '%<!--%' OR title LIKE '%`%';
----
count
0

# The breadcrumb is one of the three searched fields: a term carried by an
# ancestor heading reaches the rows nested under it.
connection docs database=postgres
query
SELECT count(*) > 0 FROM sdb_docs.search('copy', 50) WHERE breadcrumb ILIKE '%cop%';
----
?column?
t

# Ranking sanity: a query for a topic surfaces a row of a page about it.
connection docs database=postgres
query
SELECT bool_or(path ILIKE '%inverted%') FROM sdb_docs.search('inverted index', 10);
----
bool_or
t

# The Lucene grammar reaches the index: a quoted phrase, a prefix and a fuzzy
# term all resolve.
connection docs database=postgres
query
SELECT (SELECT count(*) FROM sdb_docs.search('"inverted index"', 5)) > 0 AS phrase,
       (SELECT count(*) FROM sdb_docs.search('tokeniz*', 5)) > 0 AS prefix,
       (SELECT count(*) FROM sdb_docs.search('vacum~1', 5)) > 0 AS fuzzy;
----
phrase	prefix	fuzzy
t	t	t

connection docs database=postgres
query
SELECT (SELECT string_agg(path, ',') FROM sdb_docs.search('path:configuration\/limits.md', 5)) AS term,
       (SELECT string_agg(path, ',') FROM sdb_docs.search('path:"sql/statements/create_table/index.md#CREATE_TABLE"', 5)) AS phrase,
       (SELECT count(*) FROM sdb_docs.search('path:sql', 5)) AS partial,
       (SELECT bool_and(starts_with(path, 'configuration/')) FROM sdb_docs.search('path:configuration*', 500)) AS prefix;
----
term	phrase	partial	prefix
configuration/limits.md	sql/statements/create_table/index.md#CREATE_TABLE	0	t

# Exclusion is refused rather than silently scoped to one field.
connection docs database=postgres
statement error
SELECT count(*) FROM sdb_docs.search('+fox -red', 5);
----
db error: ERROR: sdb_docs.search: exclusion (-term or NOT) is not supported here yet<slt:ignore>


connection docs database=postgres
query
SELECT (SELECT starts_with(path, 'sql/functions/search/scoring.md') FROM sdb_docs.search('Only one scorer function is allowed per inverted index', 1)) AS pasted,
       (SELECT count(*) FROM sdb_docs.search('How do I create an inverted index?', 5)) = 5 AS question,
       (SELECT count(*) FROM sdb_docs.search('SELECT * FROM t WHERE body @@ ''fox''', 5)) > 0 AS unparsed,
       (SELECT count(*) FROM sdb_docs.search('@@', 5)) > 0 AS symbol;
----
pasted	question	unparsed	symbol
t	t	t	t

connection docs database=postgres
query
SELECT (SELECT path FROM sdb_docs.search('date_trunc', 1)) = (SELECT path FROM sdb_docs.object('date_trunc') LIMIT 1) AS named_first,
       (SELECT count(*) FROM sdb_docs.object('date_trunc(ts, ''day'')')) > 0 AS call_syntax;
----
named_first	call_syntax
t	t

# The tokenizer lowercases and keeps an identifier whole, so a name matches
# whatever case it is typed in.
connection docs database=postgres
query
SELECT (SELECT count(*) FROM sdb_docs.search('md_to_text', 5)) = (SELECT count(*) FROM sdb_docs.search('MD_TO_TEXT', 5));
----
?column?
t

# SQL entry points over the same rows and index.
connection docs database=postgres
query
SELECT count(*), bool_and(path <> '' AND snippet <> '' AND score > 0) FROM sdb_docs.search('create search table', 3);
----
count	bool_and
3	t

connection docs database=postgres
query
SELECT (SELECT length(content) FROM sdb_docs.docs WHERE path = 'sql/statements/create_table/index.md#CREATE_TABLE') > 100,
       (SELECT count(*) FROM sdb_docs.docs WHERE path = 'no/such/page.md') = 0;
----
?column?	?column?
t	t

connection docs database=postgres
query
SELECT count(*) > 3, bool_and(starts_with(path, 'sql/statements/create_table/')) FROM sdb_docs.docs WHERE starts_with(path, 'sql/statements/create_table/');
----
?column?	bool_and
t	t

connection docs database=postgres
query
SELECT count(*) > 3, count(*) FILTER (WHERE length(path) - length(replace(path, '#', '')) > 1) FROM sdb_docs.docs WHERE starts_with(path, 'sql/') AND depth <= 1;
----
?column?	count
t	0

connection docs database=postgres
query
SELECT count(*) FILTER (WHERE depth <> length(regexp_replace(path, '\\#|[^#]', '', 'g'))), count(*) > 1000 FROM sdb_docs.docs;
----
count	?column?
0	t

connection docs database=postgres
query
SELECT (SELECT count(*) FROM sdb_docs.docs WHERE path IN ('configuration/limits.md', 'sql/indexes/index.md#Indexes', 'no/such/page.md')),
       (SELECT count(*) FROM sdb_docs.docs WHERE path LIKE 'sql/statements/create_table/%') = (SELECT count(*) FROM sdb_docs.docs WHERE starts_with(path, 'sql/statements/create_table/'));
----
count	?column?
2	t

connection docs database=postgres
query
SELECT count(*), count(d.path) FROM sdb_docs.search('bm25', 3) s LEFT JOIN sdb_docs.docs d USING (path);
----
count	count
3	3

connection docs database=postgres
query
SELECT (length(r) - length(replace(r, 'Metadata Filtering', ''))) / length('Metadata Filtering'),
       starts_with((SELECT sdb_md_to_ansi(markdown, 0, false, path) FROM sdb_docs.docs WHERE path = 'configuration/limits.md'), '# Limits')
FROM (SELECT sdb_md_to_ansi(markdown, 0, false, path) AS r FROM sdb_docs.docs WHERE path = 'clients/langchain-serenedb/filtering.md#Metadata_Filtering');
----
?column?	starts_with
1	t

connection docs database=postgres
query
SELECT count(*) >= 1, bool_and(lower(title) LIKE 'any_value%') FROM sdb_docs.object('ANY_VALUE');
----
?column?	bool_and
t	t

connection docs database=postgres
query
SELECT (SELECT count(*) FROM information_schema.schemata WHERE schema_name = 'sdb_docs'),
       (SELECT count(*) FROM information_schema.tables WHERE table_schema = 'sdb_docs');
----
count	count
0	0

