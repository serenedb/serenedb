query
SELECT count(*) > 100, count(*) = count(DISTINCT split_part(path, '#', 1)) FROM sdb_docs.docs WHERE length(path) - length(replace(path, '#', '')) <= 1;
----
?column?	?column?
t	t

query
SELECT count(*) > 1000 FROM sdb_docs.docs WHERE position('#' IN path) > 0;
----
?column?
t

query
