query
SELECT bool_or(path = 'sql/indexes/inverted/index.md') FROM sdb_docs.docs_fts WHERE content_text @@ 'inverted';
----
bool_or
t

query
SELECT count(*) FROM (
  SELECT path, BM25(docs_fts.tableoid) AS score
  FROM sdb_docs.docs_fts
  WHERE content_text @@ 'inverted index'
  ORDER BY score DESC, path
  LIMIT 5
);
----
count
5

query
SELECT count(*) > 1000, count(DISTINCT path) = (SELECT count(*) FROM sdb_docs.docs) FROM sdb_docs.sections;
----
?column?	?column?
t	t

query
SELECT level, title FROM sdb_docs.sections WHERE path = 'sql/data_types/time.md';
