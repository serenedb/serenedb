control substitution on

statement ok
CREATE SEQUENCE ses_restarted;


query
SELECT nextval('ses_restarted') AS v;
----
v
1


statement ok
ALTER SEQUENCE ses_restarted RESTART WITH 10;


statement ok
EXPORT DATABASE '${__TEST_DIR__}/ses_export';


query
SELECT count(*) AS restarted FROM read_text('${__TEST_DIR__}/ses_export/schema.sql')
WHERE content LIKE '%setval(''%ses_restarted'', 10, false)%';
----
restarted
1


statement ok
DROP SEQUENCE ses_restarted;
