query
SELECT count(*) > 0 AS threads,
       count(*) = count(DISTINCT tid) AS unique_tids,
       bool_and(tid > 0) AS tids,
       bool_and(thread_name <> '') AS names,
       bool_and(symbols IS NULL) AS no_symbols
FROM sdb_stack_trace();
----
threads	unique_tids	tids	names	no_symbols
t	t	t	t	t


statement ok
SET sdb_stack_trace_timeout = 1000;


query
SHOW sdb_stack_trace_timeout;
----
sdb_stack_trace_timeout
1000


query
SELECT bool_or(thread_name = 'sdb_io' AND len(frames) > 0) AS io_stacks,
       bool_or(thread_name IN ('sdb_worker', 'sdb_blocking')) AS workers
FROM sdb_stack_trace();
----
io_stacks	workers
t	t


