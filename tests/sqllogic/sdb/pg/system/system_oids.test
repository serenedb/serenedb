CREATE TABLE system_oids.t(id INTEGER PRIMARY KEY, txt TEXT);


statement ok
CREATE INDEX system_oids_txt ON system_oids.t(txt);


statement ok
CREATE VIEW system_oids.v AS SELECT txt FROM system_oids.t;


statement ok
CREATE SEQUENCE system_oids.s;


statement ok
CREATE TYPE system_oids.mood AS ENUM ('sad', 'ok');


statement ok
CREATE FUNCTION system_oids.f(x INTEGER) RETURNS INTEGER LANGUAGE SQL AS 'SELECT x + 1';


statement ok
CREATE ROLE system_oids_role;


query
SELECT kind, count(*) AS objects, bool_and(oid >= 262144) AS user_range
FROM (SELECT 'relation' AS kind, oid FROM pg_class WHERE relnamespace = 'system_oids'::regnamespace
      UNION ALL SELECT 'type', oid FROM pg_type WHERE typnamespace = 'system_oids'::regnamespace
      UNION ALL SELECT 'function', oid FROM pg_proc WHERE pronamespace = 'system_oids'::regnamespace
      UNION ALL SELECT 'schema', 'system_oids'::regnamespace::oid
      UNION ALL SELECT 'role', oid FROM pg_authid WHERE rolname = 'system_oids_role'
      UNION ALL SELECT 'database', oid FROM pg_database WHERE datname = 'system_oids_other') o
GROUP BY kind ORDER BY kind;
----
kind	objects	user_range
database	1	t
function	1	t
relation	5	t
role	1	t
schema	1	t
type	6	t


