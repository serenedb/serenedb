query
SELECT n.nspname, c.relname, c.oid, c.reltype, t.typarray
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
JOIN pg_type t ON t.oid = c.reltype
WHERE c.oid IN ('pg_roles'::regclass, 'pg_views'::regclass, 'information_schema.views'::regclass,
                'information_schema.columns'::regclass, 'information_schema.sql_sizing'::regclass,
                'information_schema.user_mappings'::regclass)
ORDER BY c.oid;
----
nspname	relname	oid	reltype	typarray
pg_catalog	pg_roles	12000	12002	12001
pg_catalog	pg_views	12018	12020	12019
information_schema	columns	12290	12292	12291
information_schema	sql_sizing	12359	12361	12360
information_schema	views	12407	12409	12408
information_schema	user_mappings	12455	12457	12456


query
SELECT count(*) AS relations,
       count(*) FILTER (WHERE c.reltype <> c.oid + 2) AS row_type_elsewhere,
       count(*) FILTER (WHERE t.typarray <> c.oid + 1) AS array_type_elsewhere,
       min(c.oid) AS first, max(c.oid) AS last
FROM pg_class c JOIN pg_type t ON t.oid = c.reltype
WHERE c.oid >= 12000 AND c.oid < 16384;
----
relations	row_type_elsewhere	array_type_elsewhere	first	last
149	0	0	12000	12455


query
SELECT t.typname, t.oid, t.typarray, b.typname AS base
FROM pg_type t JOIN pg_type b ON b.oid = t.typbasetype
WHERE t.typnamespace = 'information_schema'::regnamespace AND t.typtype = 'd'
ORDER BY t.oid;
