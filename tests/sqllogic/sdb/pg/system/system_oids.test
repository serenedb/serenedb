statement ok
CREATE DATABASE system_oids_other;


connection other database=system_oids_other
statement ok
CREATE TABLE system_oids_procs AS
SELECT oid::int8 AS oid, proname::text AS proname FROM pg_proc WHERE pronamespace IN (11, 13293);


connection other database=system_oids_other
statement ok
CREATE TABLE system_oids_relations AS
SELECT oid::int8 AS oid, relname::text AS relname FROM pg_class WHERE relnamespace IN (11, 13293);


connection other database=system_oids_other
statement ok
CREATE TABLE system_oids_types AS
SELECT oid::int8 AS oid, typname::text AS typname FROM pg_type WHERE typnamespace IN (11, 13293);


connection other database=system_oids_other
statement ok
CREATE TABLE system_oids_collations AS
SELECT oid::int8 AS oid, collname::text AS collname FROM pg_collation;


statement ok
CREATE TEMP TABLE system_oids_here AS
SELECT 'proc' AS kind, oid::int8 AS oid, proname::text AS name FROM pg_proc WHERE pronamespace IN (11, 13293)
UNION ALL SELECT 'relation', oid::int8, relname::text FROM pg_class WHERE relnamespace IN (11, 13293)
UNION ALL SELECT 'type', oid::int8, typname::text FROM pg_type WHERE typnamespace IN (11, 13293)
UNION ALL SELECT 'collation', oid::int8, collname::text FROM pg_collation;


statement ok
CREATE TEMP TABLE system_oids_there AS
SELECT 'proc' AS kind, oid, proname AS name FROM system_oids_other.public.system_oids_procs
UNION ALL SELECT 'relation', oid, relname FROM system_oids_other.public.system_oids_relations
UNION ALL SELECT 'type', oid, typname FROM system_oids_other.public.system_oids_types
UNION ALL SELECT 'collation', oid, collname FROM system_oids_other.public.system_oids_collations;


query
SELECT h.kind, h.objects = t.objects AS same_count, h.objects > 0 AS listed,
       (SELECT count(*) FROM (SELECT oid, name FROM system_oids_here WHERE kind = h.kind
                              EXCEPT SELECT oid, name FROM system_oids_there WHERE kind = h.kind)) AS only_here,
       (SELECT count(*) FROM (SELECT oid, name FROM system_oids_there WHERE kind = h.kind
                              EXCEPT SELECT oid, name FROM system_oids_here WHERE kind = h.kind)) AS only_there
FROM (SELECT kind, count(*) AS objects FROM system_oids_here GROUP BY kind) h
JOIN (SELECT kind, count(*) AS objects FROM system_oids_there GROUP BY kind) t ON t.kind = h.kind
ORDER BY h.kind;
----
kind	same_count	listed	only_here	only_there
collation	t	t	0	0
proc	t	t	0	0
relation	t	t	0	0
type	t	t	0	0


