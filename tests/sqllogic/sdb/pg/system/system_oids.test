query
SELECT count(*) FILTER (WHERE oid < 16384) > 0 AS postgres,
       count(*) FILTER (WHERE oid >= 16384 AND oid < 65536) AS outside,
       count(*) FILTER (WHERE oid >= 65536 AND oid < 131072) > 0 AS serenedb
FROM pg_proc WHERE pronamespace IN (11, 13293);
----
postgres	outside	serenedb
t	0	t


